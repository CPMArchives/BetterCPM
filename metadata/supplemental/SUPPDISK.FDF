# Supplemental BetterCP/M formats. See docs/engineering/evidence/2026-11-05-cpc/.
# Original definitions: GPL-2.0-or-later.

FDF_VERSION 1

FORMAT
ID CPCSYS
DESCRIPTION "Amstrad CPC System"
CYLINDERS 40
SIDES 1
ENCODING MFM
PSECTORS 9
SECSIZE 512
SECTOR_IDS 65,66,67,68,69,70,71,72,73
LOGICAL_TRACK SURFACE
SPT 36
OFF 2
BSH 3
BLM 7
EXM 0
DSM 170
DRM 63
AL0 0xC0
AL1 0
CKS 16
END

FORMAT
ID CPCDATA
DESCRIPTION "Amstrad CPC Data"
CYLINDERS 40
SIDES 1
ENCODING MFM
PSECTORS 9
SECSIZE 512
SECTOR_IDS 193,194,195,196,197,198,199,200,201
LOGICAL_TRACK SURFACE
SPT 36
OFF 0
BSH 3
BLM 7
EXM 0
DSM 179
DRM 63
AL0 0xC0
AL1 0
CKS 16
END

FORMAT
ID PCW
DESCRIPTION "Amstrad PCW 180K"
CYLINDERS 40
SIDES 1
ENCODING MFM
PSECTORS 9
SECSIZE 512
SECTOR_IDS 1,2,3,4,5,6,7,8,9
LOGICAL_TRACK SURFACE
SPT 36
OFF 1
BSH 3
BLM 7
EXM 0
DSM 174
DRM 63
AL0 0xC0
AL1 0
CKS 16
END
