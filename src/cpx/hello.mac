        INCLUDE layout.inc

; ********************************************************************************
; *                         BetterCP/M HELLO CPX                                 *
; *                                                                              *
; * Second proof command-processor extension. Recognizes the HELLO command,      *
; * prints its response, echoes any trailing argument, and declines all other    *
; * commands so dispatch can continue through the CPX chain.                     *
; ********************************************************************************

CPXBASE         EQU     08000H
BDOS            EQU     00005H

        CSEG
        .PHASE  CPXBASE

; -------------------------------------------------------------------------------
; CPX Descriptor
; -------------------------------------------------------------------------------

HC_NEXT:        DW      0               ; next CPX descriptor pointer
HC_ENTRY:       DW      HC_COMMAND      ; CPX command entry pointer

; ================================================================================
; =                            HELLO Command Handler                             =
; =                                                                              =
; = Matches the HELLO keyword, validates the command boundary, emits the HELLO   =
; = response and optional argument, and reports whether the command was handled. =
; ================================================================================

; -------------------------------------------------------------------------------
; Command Recognition and Response
; -------------------------------------------------------------------------------

HC_COMMAND:                             ; recognize and handle HELLO command
        LD      A,B
        CP      5
        JR      C,HC_DECLINE
        SUB     5
        LD      (HC_ARGLEN),A
        LD      B,5
        LD      HL,HC_KEY

HC_MATCH:                               ; compare HELLO command keyword
        LD      A,(DE)
        CP      (HL)
        JR      NZ,HC_DECLINE
        INC     DE
        INC     HL
        DJNZ    HC_MATCH
        LD      A,(HC_ARGLEN)
        OR      A
        JR      Z,HC_HANDLE
        LD      A,(DE)
        CP      ' '
        JR      NZ,HC_DECLINE           ; HELLOX is not the HELLO command

HC_HANDLE:                              ; handle recognized HELLO command
        LD      (HC_ARGPTR),DE
        LD      DE,HC_MESSAGE
        LD      C,9
        CALL    BDOS
        LD      HL,(HC_ARGPTR)
        LD      A,(HC_ARGLEN)
        LD      B,A

HC_SKIP:                                ; skip spaces before HELLO argument
        LD      A,B
        OR      A
        JR      Z,HC_DONE
        LD      A,(HL)
        CP      ' '
        JR      NZ,HC_ARG
        INC     HL
        DEC     B
        JR      HC_SKIP

HC_ARG:                                 ; emit separator before HELLO argument
        PUSH    HL
        PUSH    BC
        LD      E,' '
        LD      C,2
        CALL    BDOS
        POP     BC
        POP     HL

HC_ARGLOOP:                             ; echo HELLO argument
        LD      A,(HL)
        INC     HL
        PUSH    HL
        PUSH    BC
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     BC
        POP     HL
        DJNZ    HC_ARGLOOP

HC_DONE:                                ; finish HELLO response
        LD      DE,HC_NEWLINE
        LD      C,9
        CALL    BDOS
        SCF
        RET

HC_DECLINE:                             ; decline unmatched command
        OR      A
        RET

; -------------------------------------------------------------------------------
; Command Data and State
; -------------------------------------------------------------------------------

HC_KEY:         DB      'HELLO'         ; HELLO command keyword
HC_MESSAGE:     DB      13,10,'Hello from HELLO.CPX','$' ; HELLO response text
HC_NEWLINE:     DB      13,10,'$'       ; response newline
HC_ARGPTR:      DW      0               ; HELLO argument pointer
HC_ARGLEN:      DB      0               ; HELLO argument length

        .DEPHASE
        END
