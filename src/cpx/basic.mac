; BetterCP/M proof-of-concept Basic Commands CPX.
; Exports DIR, ERA, TYPE, REN, SAVE, USER, CLR, and VER through the common CPX
; command entry.

CPXBASE         EQU     08000H
BDOS            EQU     0C100H

        CSEG
        .PHASE  CPXBASE

; Required CPX header: WBOOT supplies NEXT and relocates ENTRY.
BC_NEXT:        DW      0
BC_ENTRY:       DW      BC_COMMAND

BC_COMMAND:
        LD      (BC_CMDPTR),DE
        LD      A,B
        LD      (BC_CMDLEN),A
        LD      HL,BC_KDIR
        LD      C,3
        CALL    BC_MATCH
        JR      NC,BC_TRYERA
        CALL    BC_DIR
        SCF
        RET
BC_TRYERA:
        LD      HL,BC_KERA
        LD      C,3
        CALL    BC_MATCH
        JR      NC,BC_TRYTYP
        CALL    BC_ERA
        SCF
        RET
BC_TRYTYP:
        LD      HL,BC_KTYPE
        LD      C,4
        CALL    BC_MATCH
        JR      NC,BC_TRYREN
        CALL    BC_TYPE
        SCF
        RET
BC_TRYREN:
        LD      HL,BC_KREN
        LD      C,3
        CALL    BC_MATCH
        JR      NC,BC_TRYSAV
        CALL    BC_REN
        SCF
        RET
BC_TRYSAV:
        LD      HL,BC_KSAVE
        LD      C,4
        CALL    BC_MATCH
        JR      NC,BC_TRYCLR
        CALL    BC_SAVE
        SCF
        RET
BC_TRYCLR:
        LD      HL,BC_KCLR
        LD      C,3
        CALL    BC_MATCH
        JR      NC,BC_TRYUSER
        CALL    BC_CLR
        SCF
        RET
BC_TRYUSER:
        LD      HL,BC_KUSER
        LD      C,4
        CALL    BC_MATCH
        JR      NC,BC_TRYVER
        CALL    BC_USER
        SCF
        RET
BC_TRYVER:
        LD      HL,BC_KVER
        LD      C,3
        CALL    BC_MATCH
        RET     NC
        CALL    BC_VER
        SCF
        RET

; Match keyword HL/C. On success carry is set and HL/B describe arguments.
BC_MATCH:
        LD      A,C
        LD      (BC_KEYLEN),A
        LD      A,(BC_CMDLEN)
        CP      C
        JR      NC,BC_MLENOK
        OR      A               ; too short is a decline, not a handled call
        RET
BC_MLENOK:
; Keep the proof module on the exercised 8080-compatible instruction floor.
; Subtract the short keyword length without depending on SUB C.
BC_MSUB:
        DEC     A
        DEC     C
        JR      NZ,BC_MSUB
        LD      (BC_ARGLEN),A
        LD      DE,(BC_CMDPTR)
        LD      A,(BC_KEYLEN)
        LD      C,A
BC_MLOOP:
        LD      A,(DE)
        CP      (HL)
        JR      NZ,BC_MFAIL
        INC     DE
        INC     HL
        DEC     C
        JR      NZ,BC_MLOOP
        LD      A,(BC_ARGLEN)
        OR      A
        JR      Z,BC_MOK0
        LD      A,(DE)
        CP      ' '
        JR      NZ,BC_MFAIL
        LD      A,(BC_ARGLEN)
        LD      B,A
BC_MSKIP:
        LD      A,B
        OR      A
        JR      Z,BC_MOK
        LD      A,(DE)
        CP      ' '
        JR      NZ,BC_MOK
        INC     DE
        DEC     B
        JR      BC_MSKIP
BC_MOK0:
        LD      B,0
BC_MOK:
        EX      DE,HL
        SCF
        RET
BC_MFAIL:
        OR      A
        RET

; Parse HL/B into a 36-byte FCB at DE. Supports drive prefixes and * / ?.
BC_PFCB:
        LD      (BC_INPTR),HL
        LD      A,B
        LD      (BC_INLEN),A
        LD      (BC_FCBPTR),DE
        PUSH    DE
        XOR     A
        LD      C,36
BC_PZERO:
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,BC_PZERO
        POP     DE
        INC     DE
        LD      A,' '
        LD      C,11
BC_PSPACE:
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,BC_PSPACE
        LD      HL,(BC_INPTR)
        LD      A,(BC_INLEN)
        LD      B,A
        LD      DE,(BC_FCBPTR)
        LD      A,B
        CP      2
        JR      C,BC_PNAME
        LD      A,(HL)
        SUB     'A'-1
        CP      17
        JR      NC,BC_PNAME
        LD      C,A
        INC     HL
        LD      A,(HL)
        DEC     HL
        CP      ':'
        JR      NZ,BC_PNAME
        LD      A,C
        LD      (DE),A
        INC     HL
        INC     HL
        DEC     B
        DEC     B
BC_PNAME:
        INC     DE
        LD      C,8
BC_PNLOOP:
        LD      A,B
        OR      A
        JR      Z,BC_PDOK
        LD      A,(HL)
        CP      '.'
        JR      Z,BC_PDOT
        CP      '*'
        JR      Z,BC_PNSTAR
        CP      ' '
        JR      Z,BC_PDOK
        LD      (DE),A
        INC     DE
        INC     HL
        DEC     B
        DEC     C
        JR      NZ,BC_PNLOOP
        JR      BC_PSKIPN
BC_PNSTAR:
        LD      A,'?'
BC_PNSLP:
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,BC_PNSLP
BC_PSKIPN:
        LD      A,B
        OR      A
        JR      Z,BC_PDOK
        LD      A,(HL)
        INC     HL
        DEC     B
        CP      '.'
        JR      NZ,BC_PSKIPN
        JR      BC_PEXT0
BC_PDOT:
        INC     HL
        DEC     B
BC_PEXT0:
        LD      DE,(BC_FCBPTR)
        LD      A,E
        ADD     A,9
        LD      E,A
        JR      NC,BC_PEXT
        INC     D
BC_PEXT:
        LD      C,3
BC_PELOOP:
        LD      A,B
        OR      A
        JR      Z,BC_PDOK
        LD      A,(HL)
        CP      '*'
        JR      Z,BC_PESTAR
        CP      ' '
        JR      Z,BC_PDOK
        LD      (DE),A
        INC     DE
        INC     HL
        DEC     B
        DEC     C
        JR      NZ,BC_PELOOP
        JR      BC_PDOK
BC_PESTAR:
        LD      A,'?'
BC_PESLP:
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,BC_PESLP
BC_PDOK:
        LD      A,(BC_INLEN)
        OR      A
        RET

BC_DIR:
        CALL    BC_DUSEL
        LD      C,31            ; selected drive's DPB supplies EXM
        CALL    BDOS
        LD      DE,4
        ADD     HL,DE
        LD      A,(HL)
        CPL
        LD      (BC_EXMASK),A
        XOR     A
        LD      (BC_DCOL),A
        LD      (BC_DFOUND),A
        LD      HL,(BC_DARGP)   ; Function 31 does not preserve arguments
        LD      A,(BC_DARGL)
        LD      B,A
        LD      A,B
        OR      A
        JR      NZ,BC_DPARSE
        LD      HL,BC_ALL
        LD      B,3
BC_DPARSE:
        LD      DE,BC_FCB
        CALL    BC_PFCB
        LD      DE,0080H
        LD      C,26
        CALL    BDOS
        LD      C,17
BC_DNEXT:
        LD      DE,BC_FCB
        CALL    BDOS
        CP      0FFH
        JP      Z,BC_DDONE
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,080H
        LD      L,A
        LD      H,0
        LD      (BC_DIREP),HL
        LD      A,1             ; stock NO FILE depends on search, not display
        LD      (BC_DFOUND),A   ; a matching SYS entry still counts as found
; Patch 2026-09-02: the proof DIR printed one name per line and exposed every
; matching extent. Preserve this old path in history here: stock CCP output is
; a four-column directory of DIR-status filenames, once per physical extent
; group. EXM determines which low EX bits belong to the first group.
        LD      DE,12
        ADD     HL,DE
        LD      A,(HL)
        LD      HL,BC_EXMASK
        AND     (HL)
        JR      NZ,BC_DSKIP
        LD      HL,(BC_DIREP)
        LD      DE,10
        ADD     HL,DE
        LD      A,(HL)
        AND     080H            ; T2 high bit marks a SYS, not DIR, file
        JR      NZ,BC_DSKIP
        LD      A,(BC_DCOL)
        OR      A
        JR      NZ,BC_DSEP
        LD      DE,BC_NL
        LD      C,9
        CALL    BDOS
        LD      A,(BC_DTARG)
        CP      0FFH
        JR      NZ,BC_DDRIVE
        LD      A,(BC_DSAVE)
BC_DDRIVE:
        ADD     A,'A'
        CALL    BC_PCHAR
        LD      A,':'
        CALL    BC_PCHAR
        LD      A,' '
        CALL    BC_PCHAR
        JR      BC_DNAME
BC_DSEP:
        LD      DE,BC_SEP
        LD      C,9
        CALL    BDOS
BC_DNAME:
        LD      HL,(BC_DIREP)
        INC     HL
        LD      B,8
        CALL    BC_FFIX
        LD      A,' '
        CALL    BC_PCHAR
        LD      HL,(BC_DIREP)
        LD      DE,9
        ADD     HL,DE
        LD      B,3
        CALL    BC_FFIX
        LD      A,(BC_DCOL)
        INC     A
        AND     3
        LD      (BC_DCOL),A
BC_DMORE:
BC_DSKIP:
        LD      C,18
        JP      BC_DNEXT
BC_DDONE:
        LD      A,(BC_DFOUND)
        OR      A
        JR      Z,BC_DNOFILE
        LD      DE,BC_NL
        LD      C,9
        CALL    BDOS
        JP      BC_DURST
BC_DNOFILE:
        LD      DE,BC_NOFILE
        LD      C,9
        CALL    BDOS
        JP      BC_DURST

BC_FFIX:
        LD      A,(HL)
        AND     07FH
        PUSH    HL
        PUSH    BC
        CALL    BC_PCHAR
        POP     BC
        POP     HL
        INC     HL
        DJNZ    BC_FFIX
        RET
BC_PCHAR:
        LD      E,A
        LD      C,2
        JP      BDOS

; DIR accepts the CCP's complete DU selector before an optional filespec:
; A:, 5:, or C3:.  The selected DU is deliberately temporary; this preserves
; the historical distinction between "DIR B:" and the navigation command B:.
BC_DUSEL:
        LD      (BC_DARGP),HL
        LD      A,B
        LD      (BC_DARGL),A
        LD      C,25
        CALL    BDOS
        LD      (BC_DSAVE),A
        LD      E,0FFH
        LD      C,32
        CALL    BDOS
        LD      (BC_USAVE),A
        LD      A,0FFH
        LD      (BC_DTARG),A
        LD      (BC_UTARG),A
        LD      HL,(BC_DARGP)
        LD      A,(BC_DARGL)
        LD      B,A
        OR      A
        RET     Z
        LD      A,(HL)
        CP      'A'
        JR      C,BC_DUNUM
        CP      'P'+1
        JP      NC,BC_DUNONE
        SUB     'A'
        LD      (BC_DTARG),A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JP      Z,BC_DUNONE
        LD      A,(HL)
        CP      ':'
        JR      Z,BC_DUCOL
; BetterCP/M's combined DU form is an additive extension to CP/M's D: form.
; After a drive letter, accept one or two decimal user digits before the colon.
        CP      '0'
        JP      C,BC_DUNONE
        CP      '9'+1
        JP      NC,BC_DUNONE
        SUB     '0'
        LD      C,A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JP      Z,BC_DUNONE
        LD      A,(HL)
        CP      ':'
        JR      Z,BC_DUDONE
        CP      '0'
        JP      C,BC_DUNONE
        CP      '9'+1
        JP      NC,BC_DUNONE
        LD      A,C
        ADD     A,A
        LD      D,A
        ADD     A,A
        ADD     A,A
        ADD     A,D
        LD      C,A
        LD      A,(HL)
        SUB     '0'
        ADD     A,C
        CP      32
        JR      NC,BC_DUNONE
        LD      C,A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JR      Z,BC_DUNONE
        LD      A,(HL)
        CP      ':'
        JR      NZ,BC_DUNONE
BC_DUDONE:
        LD      A,C
        LD      (BC_UTARG),A
        JR      BC_DUCOL
BC_DUNUM:
        LD      A,B
        OR      A
        JR      Z,BC_DUNONE
        LD      A,(HL)
        CP      '0'
        JR      C,BC_DUNONE
        CP      '9'+1
        JR      NC,BC_DUNONE
        SUB     '0'
        LD      C,A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JR      Z,BC_DUNONE
        LD      A,(HL)
        CP      '0'
        JR      C,BC_DUONE
        CP      '9'+1
        JR      NC,BC_DUONE
        LD      A,C
        ADD     A,A
        LD      D,A
        ADD     A,A
        ADD     A,A
        ADD     A,D
        LD      C,A
        LD      A,(HL)
        SUB     '0'
        ADD     A,C
        CP      32
        JR      NC,BC_DUNONE
        LD      C,A
        INC     HL
        DEC     B
BC_DUONE:
        LD      A,(HL)
        CP      ':'
        JR      NZ,BC_DUNONE
        LD      A,C
        LD      (BC_UTARG),A
BC_DUCOL:
        INC     HL
        DEC     B
        LD      (BC_DARGP),HL
        LD      A,B
        LD      (BC_DARGL),A
        LD      A,(BC_DTARG)
        CP      0FFH
        JR      Z,BC_DUUSER
        LD      E,A
        LD      C,14
        CALL    BDOS
BC_DUUSER:
        LD      A,(BC_UTARG)
        CP      0FFH
        JR      Z,BC_DUOUT
        LD      E,A
        LD      C,32
        CALL    BDOS
BC_DUOUT:
        LD      HL,(BC_DARGP)
        LD      A,(BC_DARGL)
        LD      B,A
        RET
BC_DUNONE:
        LD      HL,(BC_DARGP)
        LD      A,(BC_DARGL)
        LD      B,A
        RET

BC_DURST:
        LD      A,(BC_DSAVE)
        LD      E,A
        LD      C,14
        CALL    BDOS
        LD      A,(BC_USAVE)
        LD      E,A
        LD      C,32
        JP      BDOS
BC_FIELD:
        LD      A,(HL)
        AND     07FH
        CP      ' '
        JR      Z,BC_DFSKIP
        PUSH    HL
        PUSH    BC
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     BC
        POP     HL
BC_DFSKIP:
        INC     HL
        DJNZ    BC_FIELD
        RET

BC_ERA:
        CALL    BC_DUSEL
        LD      A,B
        OR      A
        JR      Z,BC_ENOFILE
        LD      DE,BC_FCB
        CALL    BC_PFCB
        LD      HL,BC_FCB+1
        LD      B,11
BC_EALLQ:
        LD      A,(HL)
        CP      '?'
        JR      NZ,BC_EDELETE
        INC     HL
        DJNZ    BC_EALLQ
; Stock CP/M asks before an all-wildcard erase. Its buffered reply must contain
; exactly one Y; extra characters cancel just as an N or empty line does.
        LD      DE,BC_ECONF
        LD      C,9
        CALL    BDOS
        XOR     A
        LD      (BC_EBUFFER+1),A
        LD      DE,BC_EBUFFER
        LD      C,10
        CALL    BDOS
        LD      A,(BC_EBUFFER+1)
        CP      1
        JR      NZ,BC_ERET
        LD      A,(BC_EBUFFER+2)
        AND     05FH
        CP      'Y'
        JR      NZ,BC_ERET
BC_EDELETE:
        LD      DE,BC_FCB
        LD      C,19
        CALL    BDOS
        CP      0FFH
        JR      NZ,BC_ERET
BC_ENOFILE:
        LD      DE,BC_NOFILE
        LD      C,9
        CALL    BDOS
BC_ERET:
        JP      BC_DURST

BC_TYPE:
        CALL    BC_DUSEL
        LD      A,B
        OR      A
        JP      Z,BC_TSYNTAX
; Separate the exact filename from the optional /P extension.
        LD      (BC_INPTR),HL
        LD      C,0
BC_TSCAN:
        LD      A,(HL)
        CP      ' '
        JR      Z,BC_TOPTION
        INC     HL
        INC     C
        DJNZ    BC_TSCAN
        XOR     A
        LD      (BC_TPAGE),A
        JR      BC_TPARSE
BC_TOPTION:
        PUSH    BC
BC_TOSKIP:
        INC     HL
        DEC     B
        JR      Z,BC_TSYPOP
        LD      A,(HL)
        CP      ' '
        JR      Z,BC_TOSKIP
        LD      A,B
        CP      2
        JR      NZ,BC_TSYPOP
        LD      A,(HL)
        CP      '/'
        JR      NZ,BC_TSYPOP
        INC     HL
        LD      A,(HL)
        CP      'P'
        JR      NZ,BC_TSYPOP
        POP     BC
        LD      A,1
        LD      (BC_TPAGE),A
        JR      BC_TPARSE
BC_TSYPOP:
        POP     BC
        JP      BC_TSYNTAX
BC_TPARSE:
        LD      HL,(BC_INPTR)
        LD      B,C
        LD      DE,BC_FCB
        CALL    BC_PFCB
        LD      HL,BC_FCB+1
        CALL    BC_RNOQ
        JP      Z,BC_TSYNTAX
        LD      DE,BC_FCB
        LD      C,15
        CALL    BDOS
        INC     A
        JP      Z,BC_TSYNTAX
        LD      DE,BC_DMA
        LD      C,26
        CALL    BDOS
        XOR     A
        LD      (BC_TLCNT),A
        LD      DE,BC_NL
        LD      C,9
        CALL    BDOS
BC_TREAD:
        LD      DE,BC_FCB
        LD      C,20
        CALL    BDOS
        OR      A
        JR      Z,BC_TBLOCK
        CP      1
        JP      Z,BC_DURST
        LD      DE,BC_READERR
        JR      BC_TERROR
BC_TBLOCK:
        LD      HL,BC_DMA
        LD      B,128
BC_TCHAR:
        LD      A,(HL)
        CP      01AH
        JP      Z,BC_DURST
        PUSH    HL
        PUSH    BC
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     BC
        POP     HL
        LD      A,(HL)
        CP      10
        JR      NZ,BC_TNEXT
        PUSH    HL
        CALL    BC_TLINE
        POP     HL
BC_TNEXT:
        INC     HL
        DJNZ    BC_TCHAR
        JR      BC_TREAD

BC_TLINE:
        LD      A,(BC_TPAGE)
        OR      A
        RET     Z
        LD      HL,BC_TLCNT
        INC     (HL)
        LD      A,(HL)
        CP      23
        RET     C
        XOR     A
        LD      (HL),A
        PUSH    BC
        PUSH    DE
        LD      DE,BC_MORE
        LD      C,9
        CALL    BDOS
BC_TWAIT:
        LD      E,0FFH
        LD      C,6
        CALL    BDOS
        OR      A
        JR      Z,BC_TWAIT
        CP      3
        JR      Z,BC_TABORT
        CP      ' '
        JR      NZ,BC_TWAIT
        LD      DE,BC_MERASE
        LD      C,9
        CALL    BDOS
        POP     DE
        POP     BC
        RET
BC_TABORT:
        LD      C,0
        JP      BDOS
BC_TSYNTAX:
        LD      DE,BC_RQMARK
BC_TERROR:
        LD      C,9
        CALL    BDOS
        JP      BC_DURST

BC_REN:
        CALL    BC_DUSEL
        LD      A,B
        OR      A
        JP      Z,BC_RSYNTAX
        LD      (BC_INPTR),HL
        LD      A,B
        LD      (BC_INLEN),A
        LD      C,0
BC_RFIND:
        LD      A,(HL)
        CP      '='
        JR      Z,BC_RFOUND
        CP      '_'
        JR      Z,BC_RFOUND
        INC     HL
        INC     C
        DJNZ    BC_RFIND
        JP      BC_RSYNTAX
BC_RFOUND:
        LD      A,C
        OR      A
        JP      Z,BC_RSYNTAX
        PUSH    HL
        PUSH    BC
        LD      HL,(BC_INPTR)
        LD      B,C
        LD      DE,BC_NEWFCB
        CALL    BC_PFCB
        POP     BC
        POP     HL
        INC     HL
        LD      A,(BC_INLEN)
        SUB     C
        DEC     A
        JP      Z,BC_RSYNTAX
        LD      B,A
BC_RSKIP:
        LD      A,(HL)
        CP      ' '
        JR      NZ,BC_ROLD
        INC     HL
        DJNZ    BC_RSKIP
        JP      BC_RSYNTAX
BC_ROLD:
; The old name is the final operand. Stock CCP rejects another token rather
; than silently ignoring it, so trim only trailing blanks.
        PUSH    HL
        PUSH    BC
BC_RTAIL:
        LD      A,(HL)
        CP      ' '
        JR      Z,BC_RZ1
        INC     HL
        DJNZ    BC_RTAIL
        JR      BC_RZ3
BC_RZ1:
        LD      A,B
        LD      C,A
        INC     HL
        DEC     C
BC_RZ2:
        LD      A,C
        OR      A
        JR      Z,BC_RZ3
        LD      A,(HL)
        CP      ' '
        JP      NZ,BC_RZ4
        INC     HL
        DEC     C
        JR      BC_RZ2
BC_RZ4:
        POP     BC
        POP     HL
        JP      BC_RSYNTAX
BC_RZ3:
        POP     BC
        POP     HL
        LD      DE,BC_FCB
        CALL    BC_PFCB
        LD      A,(BC_NEWFCB+1)
        CP      ' '
        JP      Z,BC_RSYNTAX
        LD      A,(BC_FCB+1)
        CP      ' '
        JP      Z,BC_RSYNTAX
; Neither half of a CP/M rename FCB may be ambiguous.
        LD      HL,BC_NEWFCB+1
        CALL    BC_RNOQ
        JP      Z,BC_RSYNTAX
        LD      HL,BC_FCB+1
        CALL    BC_RNOQ
        JP      Z,BC_RSYNTAX
; An explicit drive on the old name must denote the already selected drive.
        LD      A,(BC_FCB)
        OR      A
        JR      Z,BC_RSAME
        LD      (BC_RDRIVE),A
        LD      C,25
        CALL    BDOS
        INC     A
        LD      HL,BC_RDRIVE
        CP      (HL)
        JP      NZ,BC_RSYNTAX
        XOR     A
        LD      (BC_FCB),A
BC_RSAME:
; Stock REN checks the destination before checking the source.
        LD      DE,BC_NEWFCB
        LD      C,17
        CALL    BDOS
        CP      0FFH
        JR      NZ,BC_REXISTS
        LD      DE,BC_FCB
        LD      C,17
        CALL    BDOS
        CP      0FFH
        JR      Z,BC_RNOFILE
        LD      HL,BC_NEWFCB
        LD      DE,BC_FCB+16
        LD      BC,12
        LDIR
        LD      DE,BC_FCB
        LD      C,23
        CALL    BDOS
        CP      0FFH
        JP      NZ,BC_DURST
BC_RNOFILE:
        LD      DE,BC_NOFILE
        JR      BC_RPRINT
BC_REXISTS:
        LD      DE,BC_REXMSG
        JR      BC_RPRINT
BC_RSYNTAX:
        LD      DE,BC_RQMARK
BC_RPRINT:
        LD      C,9
        CALL    BDOS
        JP      BC_DURST

; Return NZ when the eleven-byte 8.3 field at HL contains no question mark.
BC_RNOQ:
        LD      B,11
BC_RNQL:
        LD      A,(HL)
        CP      '?'
        RET     Z
        INC     HL
        DJNZ    BC_RNQL
        LD      A,1
        OR      A
        RET

; SAVE n file -- copy n 256-byte pages beginning at 0100H.  SAVE remains a
; resident command deliberately: a transient SAVE.COM would destroy the low
; TPA image merely by being loaded.  This follows the original CCP's 0..255
; decimal range and destructive replacement semantics.
BC_SAVE:
        LD      A,B
        OR      A
        JP      Z,BC_SSYNTAX
        LD      C,0
        LD      D,0
BC_SNUM:
        LD      A,B
        OR      A
        JP      Z,BC_SSYNTAX
        LD      A,(HL)
        CP      ' '
        JR      Z,BC_SNAME
        CP      '0'
        JP      C,BC_SSYNTAX
        CP      '9'+1
        JP      NC,BC_SSYNTAX
        SUB     '0'
        LD      E,A
        LD      A,C
        CP      25
        JR      C,BC_SMUL
        JP      NZ,BC_SSYNTAX
        LD      A,E
        CP      6
        JP      NC,BC_SSYNTAX
BC_SMUL:
        LD      A,C
        ADD     A,A
        LD      C,A
        ADD     A,A
        ADD     A,A
        ADD     A,C
        ADD     A,E
        LD      C,A
        LD      D,1
        INC     HL
        DEC     B
        JR      BC_SNUM
BC_SNAME:
        LD      A,D
        OR      A
        JP      Z,BC_SSYNTAX
        LD      A,C
        LD      (BC_SPAGES),A
BC_SNSKIP:
        INC     HL
        DEC     B
        JP      Z,BC_SSYNTAX
        LD      A,(HL)
        CP      ' '
        JR      Z,BC_SNSKIP
        CALL    BC_DUSEL
        LD      A,B
        OR      A
        JP      Z,BC_SSYNTAX
        PUSH    HL
        PUSH    BC
BC_STOKEN:
        LD      A,(HL)
        CP      ' '
        JR      Z,BC_STAIL
        INC     HL
        DJNZ    BC_STOKEN
        JR      BC_SPARSE
BC_STAIL:
        INC     HL
        DEC     B
BC_SRL1:
        LD      A,B
        OR      A
        JR      Z,BC_SPARSE
        LD      A,(HL)
        CP      ' '
        JR      NZ,BC_SBADPOP
        INC     HL
        DJNZ    BC_SRL1
BC_SPARSE:
        POP     BC
        POP     HL
        LD      DE,BC_FCB
        CALL    BC_PFCB
        LD      A,(BC_FCB+1)
        CP      ' '
        JR      Z,BC_SSYNTAX
        LD      HL,BC_FCB+1
        CALL    BC_RNOQ
        JR      Z,BC_SSYNTAX
        LD      DE,BC_FCB
        LD      C,19
        CALL    BDOS
        LD      DE,BC_FCB
        LD      C,22
        CALL    BDOS
        CP      0FFH
        JR      Z,BC_SSPACE
        LD      HL,0100H
        LD      (BC_SDMA),HL
        LD      A,(BC_SPAGES)
        LD      L,A
        LD      H,0
        ADD     HL,HL
        LD      (BC_SRECS),HL
BC_SWLOOP:
        LD      HL,(BC_SRECS)
        LD      A,H
        OR      L
        JR      Z,BC_SCLOSE
        LD      DE,(BC_SDMA)
        LD      C,26
        CALL    BDOS
        LD      DE,BC_FCB
        LD      C,21
        CALL    BDOS
        OR      A
        JR      NZ,BC_SSPACE
        LD      HL,(BC_SDMA)
        LD      DE,128
        ADD     HL,DE
        LD      (BC_SDMA),HL
        LD      HL,(BC_SRECS)
        DEC     HL
        LD      (BC_SRECS),HL
        JR      BC_SWLOOP
BC_SCLOSE:
        LD      DE,BC_FCB
        LD      C,16
        CALL    BDOS
        CP      0FFH
        JR      Z,BC_SSPACE
        JR      BC_SDONE
BC_SBADPOP:
        POP     BC
        POP     HL
BC_SSYNTAX:
        LD      DE,BC_RQMARK
        JR      BC_SPRINT
BC_SSPACE:
        LD      DE,BC_NOSPACE
BC_SPRINT:
        LD      C,9
        CALL    BDOS
BC_SDONE:
        LD      DE,0080H
        LD      C,26
        CALL    BDOS
        JP      BC_DURST

; CLR is currently expressed through the Model 4 console's 1CH clear-screen
; byte. Preserve this platform fact visibly until BetterCP/M defines a
; portable terminal-capability service for CPXs.
BC_CLR:
        LD      A,B
        OR      A
        JR      NZ,BC_CLRBAD
        LD      E,01CH
        LD      C,2
        JP      BDOS
BC_CLRBAD:
        LD      DE,BC_RQMARK
        JP      BC_PRINT

; USER remains a stock command even though direct 5: and C3: navigation makes
; it optional for interactive use. Function 32 is the sole owner of user state.
BC_USER:
        LD      A,B
        OR      A
        JR      Z,BC_USERBAD
        LD      A,(HL)
        SUB     '0'
        JR      C,BC_USERBAD
        CP      10
        JR      NC,BC_USERBAD
        LD      E,A
        DEC     B
        JR      Z,BC_USERSET
        LD      A,E
        ADD     A,A
        LD      D,A
        ADD     A,A
        ADD     A,A
        ADD     A,D
        LD      E,A
        INC     HL
        LD      A,(HL)
        SUB     '0'
        JR      C,BC_USERBAD
        CP      10
        JR      NC,BC_USERBAD
        ADD     A,E
        CP      32
        JR      NC,BC_USERBAD
        LD      E,A
        DEC     B
        JR      NZ,BC_USERBAD
BC_USERSET:
        LD      C,32
        JP      BDOS
BC_USERBAD:
        LD      DE,BC_RQMARK
        JP      BC_PRINT

; VER is a BetterCP/M default command rather than a DRI compatibility command.
; Keep its CPX and transient presentations byte-for-byte shared for now.
BC_VER:
        LD      A,B
        OR      A
        JR      NZ,BC_VERBAD
        LD      DE,BC_VERSION
        JP      BC_PRINT
BC_VERBAD:
        LD      DE,BC_RQMARK
        JP      BC_PRINT
BC_PRINT:
        LD      C,9
        JP      BDOS

BC_KDIR:       DB      'DIR'
BC_KERA:       DB      'ERA'
BC_KTYPE:      DB      'TYPE'
BC_KREN:       DB      'REN'
BC_KSAVE:      DB      'SAVE'
BC_KCLR:       DB      'CLR'
BC_KUSER:      DB      'USER'
BC_KVER:       DB      'VER'
BC_ALL:        DB      '*.*'
BC_NL:         DB      13,10,'$'
BC_SEP:        DB      ' : ','$'
BC_NOFILE:     DB      13,10,'NO FILE',13,10,'$'
BC_ECONF:      DB      13,10,'ALL (Y/N)? $'
BC_READERR:    DB      13,10,'READ ERROR',13,10,'$'
BC_MORE:       DB      '--More--$'
BC_MERASE:     DB      8,' ',8,8,' ',8,8,' ',8,8,' ',8
                DB      8,' ',8,8,' ',8,8,' ',8,8,' ',8,'$'
BC_REXMSG:     DB      13,10,'FILE EXISTS',13,10,'$'
BC_RQMARK:     DB      13,10,'?',13,10,'$'
BC_NOSPACE:    DB      13,10,'NO SPACE',13,10,'$'
BC_VERSION:    DB      13,10,'BetterCP/M 0.3',13,10,'$'
BC_CMDPTR:     DW      0
BC_CMDLEN:     DB      0
BC_KEYLEN:     DB      0
BC_ARGLEN:     DB      0
BC_INPTR:      DW      0
BC_INLEN:      DB      0
BC_FCBPTR:     DW      0
BC_DIREP:      DW      0080H
BC_DARGP:      DW      0
BC_DARGL:      DB      0
BC_DSAVE:      DB      0
BC_USAVE:      DB      0
BC_DTARG:      DB      0FFH
BC_UTARG:      DB      0FFH
BC_EXMASK:     DB      0FFH
BC_DCOL:       DB      0
BC_DFOUND:     DB      0
BC_EBUFFER:    DB      2,0,0,0
BC_RDRIVE:     DB      0
BC_TPAGE:      DB      0
BC_TLCNT:      DB      0
BC_SPAGES:     DB      0
BC_SDMA:       DW      0100H
BC_SRECS:      DW      0
BC_FCB:
        REPT    36
        DB      0
        ENDM
BC_NEWFCB:
        REPT    36
        DB      0
        ENDM
BC_DMA:
        REPT    128
        DB      0
        ENDM

        .DEPHASE
        END
