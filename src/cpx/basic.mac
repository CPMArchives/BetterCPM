; BetterCP/M proof-of-concept Basic Commands CPX.
; Exports DIR, ERA, TYPE, and REN through the common CPX command entry.

CPXBASE         EQU     08000H
BDOS            EQU     0C100H

        CSEG
        .PHASE  CPXBASE

; Required CPX header: WBOOT supplies NEXT and relocates ENTRY.
BC_NEXT:        DW      0
BC_ENTRY:       DW      BC_COMMAND

BC_COMMAND:
        LD      (BC_CMDPTR),DE
        LD      A,B
        LD      (BC_CMDLEN),A
        LD      HL,BC_KDIR
        LD      C,3
        CALL    BC_MATCH
        JR      NC,BC_TRYERA
        CALL    BC_DIR
        SCF
        RET
BC_TRYERA:
        LD      HL,BC_KERA
        LD      C,3
        CALL    BC_MATCH
        JR      NC,BC_TRYTYP
        CALL    BC_ERA
        SCF
        RET
BC_TRYTYP:
        LD      HL,BC_KTYPE
        LD      C,4
        CALL    BC_MATCH
        JR      NC,BC_TRYREN
        CALL    BC_TYPE
        SCF
        RET
BC_TRYREN:
        LD      HL,BC_KREN
        LD      C,3
        CALL    BC_MATCH
        RET     NC
        CALL    BC_REN
        SCF
        RET

; Match keyword HL/C. On success carry is set and HL/B describe arguments.
BC_MATCH:
        LD      A,C
        LD      (BC_KEYLEN),A
        LD      A,(BC_CMDLEN)
        CP      C
        JR      NC,BC_MLENOK
        OR      A               ; too short is a decline, not a handled call
        RET
BC_MLENOK:
; Keep the proof module on the exercised 8080-compatible instruction floor.
; Subtract the short keyword length without depending on SUB C.
BC_MSUB:
        DEC     A
        DEC     C
        JR      NZ,BC_MSUB
        LD      (BC_ARGLEN),A
        LD      DE,(BC_CMDPTR)
        LD      A,(BC_KEYLEN)
        LD      C,A
BC_MLOOP:
        LD      A,(DE)
        CP      (HL)
        JR      NZ,BC_MFAIL
        INC     DE
        INC     HL
        DEC     C
        JR      NZ,BC_MLOOP
        LD      A,(BC_ARGLEN)
        OR      A
        JR      Z,BC_MOK0
        LD      A,(DE)
        CP      ' '
        JR      NZ,BC_MFAIL
        LD      A,(BC_ARGLEN)
        LD      B,A
BC_MSKIP:
        LD      A,B
        OR      A
        JR      Z,BC_MOK
        LD      A,(DE)
        CP      ' '
        JR      NZ,BC_MOK
        INC     DE
        DEC     B
        JR      BC_MSKIP
BC_MOK0:
        LD      B,0
BC_MOK:
        EX      DE,HL
        SCF
        RET
BC_MFAIL:
        OR      A
        RET

; Parse HL/B into a 36-byte FCB at DE. Supports drive prefixes and * / ?.
BC_PFCB:
        LD      (BC_INPTR),HL
        LD      A,B
        LD      (BC_INLEN),A
        LD      (BC_FCBPTR),DE
        PUSH    DE
        XOR     A
        LD      C,36
BC_PZERO:
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,BC_PZERO
        POP     DE
        INC     DE
        LD      A,' '
        LD      C,11
BC_PSPACE:
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,BC_PSPACE
        LD      HL,(BC_INPTR)
        LD      A,(BC_INLEN)
        LD      B,A
        LD      DE,(BC_FCBPTR)
        LD      A,B
        CP      2
        JR      C,BC_PNAME
        LD      A,(HL)
        SUB     'A'-1
        CP      17
        JR      NC,BC_PNAME
        LD      C,A
        INC     HL
        LD      A,(HL)
        DEC     HL
        CP      ':'
        JR      NZ,BC_PNAME
        LD      A,C
        LD      (DE),A
        INC     HL
        INC     HL
        DEC     B
        DEC     B
BC_PNAME:
        INC     DE
        LD      C,8
BC_PNLOOP:
        LD      A,B
        OR      A
        JR      Z,BC_PDOK
        LD      A,(HL)
        CP      '.'
        JR      Z,BC_PDOT
        CP      '*'
        JR      Z,BC_PNSTAR
        CP      ' '
        JR      Z,BC_PDOK
        LD      (DE),A
        INC     DE
        INC     HL
        DEC     B
        DEC     C
        JR      NZ,BC_PNLOOP
        JR      BC_PSKIPN
BC_PNSTAR:
        LD      A,'?'
BC_PNSLP:
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,BC_PNSLP
BC_PSKIPN:
        LD      A,B
        OR      A
        JR      Z,BC_PDOK
        LD      A,(HL)
        INC     HL
        DEC     B
        CP      '.'
        JR      NZ,BC_PSKIPN
        JR      BC_PEXT0
BC_PDOT:
        INC     HL
        DEC     B
BC_PEXT0:
        LD      DE,(BC_FCBPTR)
        LD      A,E
        ADD     A,9
        LD      E,A
        JR      NC,BC_PEXT
        INC     D
BC_PEXT:
        LD      C,3
BC_PELOOP:
        LD      A,B
        OR      A
        JR      Z,BC_PDOK
        LD      A,(HL)
        CP      '*'
        JR      Z,BC_PESTAR
        CP      ' '
        JR      Z,BC_PDOK
        LD      (DE),A
        INC     DE
        INC     HL
        DEC     B
        DEC     C
        JR      NZ,BC_PELOOP
        JR      BC_PDOK
BC_PESTAR:
        LD      A,'?'
BC_PESLP:
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,BC_PESLP
BC_PDOK:
        LD      A,(BC_INLEN)
        OR      A
        RET

BC_DIR:
        LD      A,B
        OR      A
        JR      NZ,BC_DPARSE
        LD      HL,BC_ALL
        LD      B,3
BC_DPARSE:
        LD      DE,BC_FCB
        CALL    BC_PFCB
        LD      DE,0080H
        LD      C,26
        CALL    BDOS
        LD      C,17
BC_DNEXT:
        LD      DE,BC_FCB
        CALL    BDOS
        CP      0FFH
        RET     Z
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,080H
        LD      L,A
        LD      H,0
        LD      (BC_DIREP),HL
        LD      DE,BC_NL
        LD      C,9
        CALL    BDOS
        LD      HL,(BC_DIREP)
        INC     HL
        LD      B,8
        CALL    BC_FIELD
        LD      HL,(BC_DIREP)
        LD      DE,9
        ADD     HL,DE
        LD      A,(HL)
        CP      ' '
        JR      Z,BC_DMORE
        LD      E,'.'
        LD      C,2
        CALL    BDOS
        LD      HL,(BC_DIREP)
        LD      DE,9
        ADD     HL,DE
        LD      B,3
        CALL    BC_FIELD
BC_DMORE:
        LD      C,18
        JR      BC_DNEXT
BC_FIELD:
        LD      A,(HL)
        AND     07FH
        CP      ' '
        JR      Z,BC_DFSKIP
        PUSH    HL
        PUSH    BC
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     BC
        POP     HL
BC_DFSKIP:
        INC     HL
        DJNZ    BC_FIELD
        RET

BC_ERA:
        LD      A,B
        OR      A
        JR      Z,BC_USEERA
        LD      DE,BC_FCB
        CALL    BC_PFCB
        LD      DE,BC_FCB
        LD      C,19
        CALL    BDOS
        CP      0FFH
        RET     NZ
        LD      DE,BC_NOFILE
        JP      BC_PRINT
BC_USEERA:
        LD      DE,BC_UERA
        JP      BC_PRINT

BC_TYPE:
        LD      A,B
        OR      A
        JR      Z,BC_USETYP
        LD      DE,BC_FCB
        CALL    BC_PFCB
        LD      DE,BC_FCB
        LD      C,15
        CALL    BDOS
        INC     A
        JR      Z,BC_TNOFILE
        LD      DE,BC_DMA
        LD      C,26
        CALL    BDOS
BC_TREAD:
        LD      DE,BC_FCB
        LD      C,20
        CALL    BDOS
        OR      A
        RET     NZ
        LD      HL,BC_DMA
        LD      B,128
BC_TCHAR:
        LD      A,(HL)
        CP      01AH
        RET     Z
        PUSH    HL
        PUSH    BC
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     BC
        POP     HL
        INC     HL
        DJNZ    BC_TCHAR
        JR      BC_TREAD
BC_TNOFILE:
        LD      DE,BC_NOFILE
        JR      BC_PRINT
BC_USETYP:
        LD      DE,BC_UTYPE
        JR      BC_PRINT

BC_REN:
        LD      A,B
        OR      A
        JR      Z,BC_USEREN
        LD      (BC_INPTR),HL
        LD      A,B
        LD      (BC_INLEN),A
        LD      C,0
BC_RFIND:
        LD      A,(HL)
        CP      '='
        JR      Z,BC_RFOUND
        CP      ' '
        JR      Z,BC_RFOUND
        INC     HL
        INC     C
        DJNZ    BC_RFIND
        JR      BC_USEREN
BC_RFOUND:
        LD      A,C
        OR      A
        JR      Z,BC_USEREN
        PUSH    HL
        PUSH    BC
        LD      HL,(BC_INPTR)
        LD      B,C
        LD      DE,BC_NEWFCB
        CALL    BC_PFCB
        POP     BC
        POP     HL
        INC     HL
        LD      A,(BC_INLEN)
        SUB     C
        DEC     A
        JR      Z,BC_USEREN
        LD      B,A
        LD      DE,BC_FCB
        CALL    BC_PFCB
        LD      HL,BC_NEWFCB
        LD      DE,BC_FCB+16
        LD      BC,12
        LDIR
        LD      DE,BC_FCB
        LD      C,23
        CALL    BDOS
        CP      0FFH
        RET     NZ
        LD      DE,BC_NOFILE
        JR      BC_PRINT
BC_USEREN:
        LD      DE,BC_UREN
BC_PRINT:
        LD      C,9
        JP      BDOS

BC_KDIR:       DB      'DIR'
BC_KERA:       DB      'ERA'
BC_KTYPE:      DB      'TYPE'
BC_KREN:       DB      'REN'
BC_ALL:        DB      '*.*'
BC_NL:         DB      13,10,'$'
BC_NOFILE:     DB      13,10,'NO FILE',13,10,'$'
BC_UERA:       DB      13,10,'ERA filename',13,10,'$'
BC_UTYPE:      DB      13,10,'TYPE filename',13,10,'$'
BC_UREN:       DB      13,10,'REN new=old or REN new old',13,10,'$'
BC_CMDPTR:     DW      0
BC_CMDLEN:     DB      0
BC_KEYLEN:     DB      0
BC_ARGLEN:     DB      0
BC_INPTR:      DW      0
BC_INLEN:      DB      0
BC_FCBPTR:     DW      0
BC_DIREP:      DW      0080H
BC_FCB:
        REPT    36
        DB      0
        ENDM
BC_NEWFCB:
        REPT    36
        DB      0
        ENDM
BC_DMA:
        REPT    128
        DB      0
        ENDM

        .DEPHASE
        END
