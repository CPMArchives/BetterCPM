; BetterCP/M proof-of-concept Basic Commands CPX.
; Exports DIR, ERA, TYPE, and REN through the common CPX command entry.

CPXBASE         EQU     08000H
BDOS            EQU     0C100H

        CSEG
        .PHASE  CPXBASE

; Required CPX header: WBOOT supplies NEXT and relocates ENTRY.
BC_NEXT:        DW      0
BC_ENTRY:       DW      BC_COMMAND

BC_COMMAND:
        LD      (BC_CMDPTR),DE
        LD      A,B
        LD      (BC_CMDLEN),A
        LD      HL,BC_KDIR
        LD      C,3
        CALL    BC_MATCH
        JR      NC,BC_TRYERA
        CALL    BC_DIR
        SCF
        RET
BC_TRYERA:
        LD      HL,BC_KERA
        LD      C,3
        CALL    BC_MATCH
        JR      NC,BC_TRYTYP
        CALL    BC_ERA
        SCF
        RET
BC_TRYTYP:
        LD      HL,BC_KTYPE
        LD      C,4
        CALL    BC_MATCH
        JR      NC,BC_TRYREN
        CALL    BC_TYPE
        SCF
        RET
BC_TRYREN:
        LD      HL,BC_KREN
        LD      C,3
        CALL    BC_MATCH
        RET     NC
        CALL    BC_REN
        SCF
        RET

; Match keyword HL/C. On success carry is set and HL/B describe arguments.
BC_MATCH:
        LD      A,C
        LD      (BC_KEYLEN),A
        LD      A,(BC_CMDLEN)
        CP      C
        JR      NC,BC_MLENOK
        OR      A               ; too short is a decline, not a handled call
        RET
BC_MLENOK:
; Keep the proof module on the exercised 8080-compatible instruction floor.
; Subtract the short keyword length without depending on SUB C.
BC_MSUB:
        DEC     A
        DEC     C
        JR      NZ,BC_MSUB
        LD      (BC_ARGLEN),A
        LD      DE,(BC_CMDPTR)
        LD      A,(BC_KEYLEN)
        LD      C,A
BC_MLOOP:
        LD      A,(DE)
        CP      (HL)
        JR      NZ,BC_MFAIL
        INC     DE
        INC     HL
        DEC     C
        JR      NZ,BC_MLOOP
        LD      A,(BC_ARGLEN)
        OR      A
        JR      Z,BC_MOK0
        LD      A,(DE)
        CP      ' '
        JR      NZ,BC_MFAIL
        LD      A,(BC_ARGLEN)
        LD      B,A
BC_MSKIP:
        LD      A,B
        OR      A
        JR      Z,BC_MOK
        LD      A,(DE)
        CP      ' '
        JR      NZ,BC_MOK
        INC     DE
        DEC     B
        JR      BC_MSKIP
BC_MOK0:
        LD      B,0
BC_MOK:
        EX      DE,HL
        SCF
        RET
BC_MFAIL:
        OR      A
        RET

; Parse HL/B into a 36-byte FCB at DE. Supports drive prefixes and * / ?.
BC_PFCB:
        LD      (BC_INPTR),HL
        LD      A,B
        LD      (BC_INLEN),A
        LD      (BC_FCBPTR),DE
        PUSH    DE
        XOR     A
        LD      C,36
BC_PZERO:
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,BC_PZERO
        POP     DE
        INC     DE
        LD      A,' '
        LD      C,11
BC_PSPACE:
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,BC_PSPACE
        LD      HL,(BC_INPTR)
        LD      A,(BC_INLEN)
        LD      B,A
        LD      DE,(BC_FCBPTR)
        LD      A,B
        CP      2
        JR      C,BC_PNAME
        LD      A,(HL)
        SUB     'A'-1
        CP      17
        JR      NC,BC_PNAME
        LD      C,A
        INC     HL
        LD      A,(HL)
        DEC     HL
        CP      ':'
        JR      NZ,BC_PNAME
        LD      A,C
        LD      (DE),A
        INC     HL
        INC     HL
        DEC     B
        DEC     B
BC_PNAME:
        INC     DE
        LD      C,8
BC_PNLOOP:
        LD      A,B
        OR      A
        JR      Z,BC_PDOK
        LD      A,(HL)
        CP      '.'
        JR      Z,BC_PDOT
        CP      '*'
        JR      Z,BC_PNSTAR
        CP      ' '
        JR      Z,BC_PDOK
        LD      (DE),A
        INC     DE
        INC     HL
        DEC     B
        DEC     C
        JR      NZ,BC_PNLOOP
        JR      BC_PSKIPN
BC_PNSTAR:
        LD      A,'?'
BC_PNSLP:
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,BC_PNSLP
BC_PSKIPN:
        LD      A,B
        OR      A
        JR      Z,BC_PDOK
        LD      A,(HL)
        INC     HL
        DEC     B
        CP      '.'
        JR      NZ,BC_PSKIPN
        JR      BC_PEXT0
BC_PDOT:
        INC     HL
        DEC     B
BC_PEXT0:
        LD      DE,(BC_FCBPTR)
        LD      A,E
        ADD     A,9
        LD      E,A
        JR      NC,BC_PEXT
        INC     D
BC_PEXT:
        LD      C,3
BC_PELOOP:
        LD      A,B
        OR      A
        JR      Z,BC_PDOK
        LD      A,(HL)
        CP      '*'
        JR      Z,BC_PESTAR
        CP      ' '
        JR      Z,BC_PDOK
        LD      (DE),A
        INC     DE
        INC     HL
        DEC     B
        DEC     C
        JR      NZ,BC_PELOOP
        JR      BC_PDOK
BC_PESTAR:
        LD      A,'?'
BC_PESLP:
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,BC_PESLP
BC_PDOK:
        LD      A,(BC_INLEN)
        OR      A
        RET

BC_DIR:
        CALL    BC_DUSEL
        LD      C,31            ; selected drive's DPB supplies EXM
        CALL    BDOS
        LD      DE,4
        ADD     HL,DE
        LD      A,(HL)
        CPL
        LD      (BC_EXMASK),A
        XOR     A
        LD      (BC_DCOL),A
        LD      (BC_DFOUND),A
        LD      HL,(BC_DARGP)   ; Function 31 does not preserve arguments
        LD      A,(BC_DARGL)
        LD      B,A
        LD      A,B
        OR      A
        JR      NZ,BC_DPARSE
        LD      HL,BC_ALL
        LD      B,3
BC_DPARSE:
        LD      DE,BC_FCB
        CALL    BC_PFCB
        LD      DE,0080H
        LD      C,26
        CALL    BDOS
        LD      C,17
BC_DNEXT:
        LD      DE,BC_FCB
        CALL    BDOS
        CP      0FFH
        JP      Z,BC_DDONE
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,080H
        LD      L,A
        LD      H,0
        LD      (BC_DIREP),HL
        LD      A,1             ; stock NO FILE depends on search, not display
        LD      (BC_DFOUND),A   ; a matching SYS entry still counts as found
; Patch 2026-09-02: the proof DIR printed one name per line and exposed every
; matching extent. Preserve this old path in history here: stock CCP output is
; a four-column directory of DIR-status filenames, once per physical extent
; group. EXM determines which low EX bits belong to the first group.
        LD      DE,12
        ADD     HL,DE
        LD      A,(HL)
        LD      HL,BC_EXMASK
        AND     (HL)
        JR      NZ,BC_DSKIP
        LD      HL,(BC_DIREP)
        LD      DE,10
        ADD     HL,DE
        LD      A,(HL)
        AND     080H            ; T2 high bit marks a SYS, not DIR, file
        JR      NZ,BC_DSKIP
        LD      A,(BC_DCOL)
        OR      A
        JR      NZ,BC_DSEP
        LD      DE,BC_NL
        LD      C,9
        CALL    BDOS
        LD      A,(BC_DTARG)
        CP      0FFH
        JR      NZ,BC_DDRIVE
        LD      A,(BC_DSAVE)
BC_DDRIVE:
        ADD     A,'A'
        CALL    BC_PCHAR
        LD      A,':'
        CALL    BC_PCHAR
        LD      A,' '
        CALL    BC_PCHAR
        JR      BC_DNAME
BC_DSEP:
        LD      DE,BC_SEP
        LD      C,9
        CALL    BDOS
BC_DNAME:
        LD      HL,(BC_DIREP)
        INC     HL
        LD      B,8
        CALL    BC_FFIX
        LD      A,' '
        CALL    BC_PCHAR
        LD      HL,(BC_DIREP)
        LD      DE,9
        ADD     HL,DE
        LD      B,3
        CALL    BC_FFIX
        LD      A,(BC_DCOL)
        INC     A
        AND     3
        LD      (BC_DCOL),A
BC_DMORE:
BC_DSKIP:
        LD      C,18
        JP      BC_DNEXT
BC_DDONE:
        LD      A,(BC_DFOUND)
        OR      A
        JR      Z,BC_DNOFILE
        LD      DE,BC_NL
        LD      C,9
        CALL    BDOS
        JP      BC_DURST
BC_DNOFILE:
        LD      DE,BC_NOFILE
        LD      C,9
        CALL    BDOS
        JP      BC_DURST

BC_FFIX:
        LD      A,(HL)
        AND     07FH
        PUSH    HL
        PUSH    BC
        CALL    BC_PCHAR
        POP     BC
        POP     HL
        INC     HL
        DJNZ    BC_FFIX
        RET
BC_PCHAR:
        LD      E,A
        LD      C,2
        JP      BDOS

; DIR accepts the CCP's complete DU selector before an optional filespec:
; A:, 5:, or C3:.  The selected DU is deliberately temporary; this preserves
; the historical distinction between "DIR B:" and the navigation command B:.
BC_DUSEL:
        LD      (BC_DARGP),HL
        LD      A,B
        LD      (BC_DARGL),A
        LD      C,25
        CALL    BDOS
        LD      (BC_DSAVE),A
        LD      E,0FFH
        LD      C,32
        CALL    BDOS
        LD      (BC_USAVE),A
        LD      A,0FFH
        LD      (BC_DTARG),A
        LD      (BC_UTARG),A
        LD      HL,(BC_DARGP)
        LD      A,(BC_DARGL)
        LD      B,A
        OR      A
        RET     Z
        LD      A,(HL)
        CP      'A'
        JR      C,BC_DUNUM
        CP      'P'+1
        JP      NC,BC_DUNONE
        SUB     'A'
        LD      (BC_DTARG),A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JP      Z,BC_DUNONE
        LD      A,(HL)
        CP      ':'
        JR      Z,BC_DUCOL
; BetterCP/M's combined DU form is an additive extension to CP/M's D: form.
; After a drive letter, accept one or two decimal user digits before the colon.
        CP      '0'
        JP      C,BC_DUNONE
        CP      '9'+1
        JP      NC,BC_DUNONE
        SUB     '0'
        LD      C,A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JP      Z,BC_DUNONE
        LD      A,(HL)
        CP      ':'
        JR      Z,BC_DUDONE
        CP      '0'
        JP      C,BC_DUNONE
        CP      '9'+1
        JP      NC,BC_DUNONE
        LD      A,C
        ADD     A,A
        LD      D,A
        ADD     A,A
        ADD     A,A
        ADD     A,D
        LD      C,A
        LD      A,(HL)
        SUB     '0'
        ADD     A,C
        CP      32
        JR      NC,BC_DUNONE
        LD      C,A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JR      Z,BC_DUNONE
        LD      A,(HL)
        CP      ':'
        JR      NZ,BC_DUNONE
BC_DUDONE:
        LD      A,C
        LD      (BC_UTARG),A
        JR      BC_DUCOL
BC_DUNUM:
        LD      A,B
        OR      A
        JR      Z,BC_DUNONE
        LD      A,(HL)
        CP      '0'
        JR      C,BC_DUNONE
        CP      '9'+1
        JR      NC,BC_DUNONE
        SUB     '0'
        LD      C,A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JR      Z,BC_DUNONE
        LD      A,(HL)
        CP      '0'
        JR      C,BC_DUONE
        CP      '9'+1
        JR      NC,BC_DUONE
        LD      A,C
        ADD     A,A
        LD      D,A
        ADD     A,A
        ADD     A,A
        ADD     A,D
        LD      C,A
        LD      A,(HL)
        SUB     '0'
        ADD     A,C
        CP      32
        JR      NC,BC_DUNONE
        LD      C,A
        INC     HL
        DEC     B
BC_DUONE:
        LD      A,(HL)
        CP      ':'
        JR      NZ,BC_DUNONE
        LD      A,C
        LD      (BC_UTARG),A
BC_DUCOL:
        INC     HL
        DEC     B
        LD      (BC_DARGP),HL
        LD      A,B
        LD      (BC_DARGL),A
        LD      A,(BC_DTARG)
        CP      0FFH
        JR      Z,BC_DUUSER
        LD      E,A
        LD      C,14
        CALL    BDOS
BC_DUUSER:
        LD      A,(BC_UTARG)
        CP      0FFH
        JR      Z,BC_DUOUT
        LD      E,A
        LD      C,32
        CALL    BDOS
BC_DUOUT:
        LD      HL,(BC_DARGP)
        LD      A,(BC_DARGL)
        LD      B,A
        RET
BC_DUNONE:
        LD      HL,(BC_DARGP)
        LD      A,(BC_DARGL)
        LD      B,A
        RET

BC_DURST:
        LD      A,(BC_DSAVE)
        LD      E,A
        LD      C,14
        CALL    BDOS
        LD      A,(BC_USAVE)
        LD      E,A
        LD      C,32
        JP      BDOS
BC_FIELD:
        LD      A,(HL)
        AND     07FH
        CP      ' '
        JR      Z,BC_DFSKIP
        PUSH    HL
        PUSH    BC
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     BC
        POP     HL
BC_DFSKIP:
        INC     HL
        DJNZ    BC_FIELD
        RET

BC_ERA:
        LD      A,B
        OR      A
        JR      Z,BC_USEERA
        LD      DE,BC_FCB
        CALL    BC_PFCB
        LD      DE,BC_FCB
        LD      C,19
        CALL    BDOS
        CP      0FFH
        RET     NZ
        LD      DE,BC_NOFILE
        JP      BC_PRINT
BC_USEERA:
        LD      DE,BC_UERA
        JP      BC_PRINT

BC_TYPE:
        LD      A,B
        OR      A
        JR      Z,BC_USETYP
        LD      DE,BC_FCB
        CALL    BC_PFCB
        LD      DE,BC_FCB
        LD      C,15
        CALL    BDOS
        INC     A
        JR      Z,BC_TNOFILE
        LD      DE,BC_DMA
        LD      C,26
        CALL    BDOS
BC_TREAD:
        LD      DE,BC_FCB
        LD      C,20
        CALL    BDOS
        OR      A
        RET     NZ
        LD      HL,BC_DMA
        LD      B,128
BC_TCHAR:
        LD      A,(HL)
        CP      01AH
        RET     Z
        PUSH    HL
        PUSH    BC
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     BC
        POP     HL
        INC     HL
        DJNZ    BC_TCHAR
        JR      BC_TREAD
BC_TNOFILE:
        LD      DE,BC_NOFILE
        JR      BC_PRINT
BC_USETYP:
        LD      DE,BC_UTYPE
        JR      BC_PRINT

BC_REN:
        LD      A,B
        OR      A
        JR      Z,BC_USEREN
        LD      (BC_INPTR),HL
        LD      A,B
        LD      (BC_INLEN),A
        LD      C,0
BC_RFIND:
        LD      A,(HL)
        CP      '='
        JR      Z,BC_RFOUND
        CP      ' '
        JR      Z,BC_RFOUND
        INC     HL
        INC     C
        DJNZ    BC_RFIND
        JR      BC_USEREN
BC_RFOUND:
        LD      A,C
        OR      A
        JR      Z,BC_USEREN
        PUSH    HL
        PUSH    BC
        LD      HL,(BC_INPTR)
        LD      B,C
        LD      DE,BC_NEWFCB
        CALL    BC_PFCB
        POP     BC
        POP     HL
        INC     HL
        LD      A,(BC_INLEN)
        SUB     C
        DEC     A
        JR      Z,BC_USEREN
        LD      B,A
        LD      DE,BC_FCB
        CALL    BC_PFCB
        LD      HL,BC_NEWFCB
        LD      DE,BC_FCB+16
        LD      BC,12
        LDIR
        LD      DE,BC_FCB
        LD      C,23
        CALL    BDOS
        CP      0FFH
        RET     NZ
        LD      DE,BC_NOFILE
        JR      BC_PRINT
BC_USEREN:
        LD      DE,BC_UREN
BC_PRINT:
        LD      C,9
        JP      BDOS

BC_KDIR:       DB      'DIR'
BC_KERA:       DB      'ERA'
BC_KTYPE:      DB      'TYPE'
BC_KREN:       DB      'REN'
BC_ALL:        DB      '*.*'
BC_NL:         DB      13,10,'$'
BC_SEP:        DB      ' : ','$'
BC_NOFILE:     DB      13,10,'NO FILE',13,10,'$'
BC_UERA:       DB      13,10,'ERA filename',13,10,'$'
BC_UTYPE:      DB      13,10,'TYPE filename',13,10,'$'
BC_UREN:       DB      13,10,'REN new=old or REN new old',13,10,'$'
BC_CMDPTR:     DW      0
BC_CMDLEN:     DB      0
BC_KEYLEN:     DB      0
BC_ARGLEN:     DB      0
BC_INPTR:      DW      0
BC_INLEN:      DB      0
BC_FCBPTR:     DW      0
BC_DIREP:      DW      0080H
BC_DARGP:      DW      0
BC_DARGL:      DB      0
BC_DSAVE:      DB      0
BC_USAVE:      DB      0
BC_DTARG:      DB      0FFH
BC_UTARG:      DB      0FFH
BC_EXMASK:     DB      0FFH
BC_DCOL:       DB      0
BC_DFOUND:     DB      0
BC_FCB:
        REPT    36
        DB      0
        ENDM
BC_NEWFCB:
        REPT    36
        DB      0
        ENDM
BC_DMA:
        REPT    128
        DB      0
        ENDM

        .DEPHASE
        END
