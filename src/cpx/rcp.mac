        INCLUDE layout.inc
; BetterCP/M resident command package (RCP).
; Exports DIR, ERA, TYPE, REN, USER, CLS, VER, COPY, and MOVE through the common CPX
; command entry.

CPXBASE         EQU     08000H
BDOS            EQU     00005H

        CSEG
        .PHASE  CPXBASE

; Required CPX header: WBOOT supplies NEXT and relocates ENTRY.
BC_NEXT:        DW      0
BC_ENTRY:       DW      BC_COMMAND

BC_COMMAND:
        LD      (BC_CMDPTR),DE
        LD      A,B
        LD      (BC_CMDLEN),A
        LD      HL,BC_KDIR
        LD      C,3
        CALL    BC_MATCH
        JR      NC,BC_TRYERA
        CALL    BC_DIR
        SCF
        RET
BC_TRYERA:
        LD      HL,BC_KERA
        LD      C,3
        CALL    BC_MATCH
        JR      NC,BC_TRYTYP
        CALL    BC_ERA
        SCF
        RET
BC_TRYTYP:
        LD      HL,BC_KTYPE
        LD      C,4
        CALL    BC_MATCH
        JR      NC,BC_TRYREN
        CALL    BC_TYPE
        SCF
        RET
BC_TRYREN:
        LD      HL,BC_KREN
        LD      C,3
        CALL    BC_MATCH
        JR      NC,BC_TRYCLS
        CALL    BC_REN
        SCF
        RET
BC_TRYCLS:
        LD      HL,BC_KCLS
        LD      C,3
        CALL    BC_MATCH
        JR      NC,BC_TRYUSER
        CALL    BC_CLR
        SCF
        RET
BC_TRYUSER:
        LD      HL,BC_KUSER
        LD      C,4
        CALL    BC_MATCH
        JR      NC,BC_TRYVER
        CALL    BC_USER
        SCF
        RET
BC_TRYVER:
        LD      HL,BC_KVER
        LD      C,3
        CALL    BC_MATCH
        JR      NC,BC_TRYCOPY
        CALL    BC_VER
        SCF
        RET
BC_TRYCOPY:
        LD      HL,BC_KCOPY
        LD      C,4
        CALL    BC_MATCH
        JR      NC,BC_TRYMOVE
        XOR     A
        LD      (BC_MVFLAG),A
        CALL    BC_COPY
        SCF
        RET
BC_TRYMOVE:
        LD      HL,BC_KMOVE
        LD      C,4
        CALL    BC_MATCH
        RET     NC
        CALL    BC_MOVE
        SCF
        RET

; Match keyword HL/C. On success carry is set and HL/B describe arguments.
BC_MATCH:
        LD      A,C
        LD      (BC_KEYLEN),A
        LD      A,(BC_CMDLEN)
        CP      C
        JR      NC,BC_MLENOK
        OR      A               ; too short is a decline, not a handled call
        RET
BC_MLENOK:
; Keep the proof module on the exercised 8080-compatible instruction floor.
; Subtract the short keyword length without depending on SUB C.
BC_MSUB:
        DEC     A
        DEC     C
        JR      NZ,BC_MSUB
        LD      (BC_ARGLEN),A
        LD      DE,(BC_CMDPTR)
        LD      A,(BC_KEYLEN)
        LD      C,A
BC_MLOOP:
        LD      A,(DE)
        CP      (HL)
        JR      NZ,BC_MFAIL
        INC     DE
        INC     HL
        DEC     C
        JR      NZ,BC_MLOOP
        LD      A,(BC_ARGLEN)
        OR      A
        JR      Z,BC_MOK0
        LD      A,(DE)
        CP      ' '
        JR      NZ,BC_MFAIL
        LD      A,(BC_ARGLEN)
        LD      B,A
BC_MSKIP:
        LD      A,B
        OR      A
        JR      Z,BC_MOK
        LD      A,(DE)
        CP      ' '
        JR      NZ,BC_MOK
        INC     DE
        DEC     B
        JR      BC_MSKIP
BC_MOK0:
        LD      B,0
BC_MOK:
        EX      DE,HL
        SCF
        RET
BC_MFAIL:
        OR      A
        RET

; Parse HL/B into a 36-byte FCB at DE. Supports drive prefixes and * / ?.
BC_PFCB:
        LD      (BC_INPTR),HL
        LD      A,B
        LD      (BC_INLEN),A
        LD      (BC_FCBPTR),DE
        PUSH    DE
        XOR     A
        LD      C,36
BC_PZERO:
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,BC_PZERO
        POP     DE
        INC     DE
        LD      A,' '
        LD      C,11
BC_PSPACE:
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,BC_PSPACE
        LD      HL,(BC_INPTR)
        LD      A,(BC_INLEN)
        LD      B,A
        LD      DE,(BC_FCBPTR)
        LD      A,B
        CP      2
        JR      C,BC_PNAME
        LD      A,(HL)
        SUB     'A'-1
        CP      17
        JR      NC,BC_PNAME
        LD      C,A
        INC     HL
        LD      A,(HL)
        DEC     HL
        CP      ':'
        JR      NZ,BC_PNAME
        LD      A,C
        LD      (DE),A
        INC     HL
        INC     HL
        DEC     B
        DEC     B
BC_PNAME:
        INC     DE
        LD      C,8
BC_PNLOOP:
        LD      A,B
        OR      A
        JR      Z,BC_PDOK
        LD      A,(HL)
        CP      '.'
        JR      Z,BC_PDOT
        CP      '*'
        JR      Z,BC_PNSTAR
        CP      ' '
        JR      Z,BC_PDOK
        LD      (DE),A
        INC     DE
        INC     HL
        DEC     B
        DEC     C
        JR      NZ,BC_PNLOOP
        JR      BC_PSKIPN
BC_PNSTAR:
        LD      A,'?'
BC_PNSLP:
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,BC_PNSLP
BC_PSKIPN:
        LD      A,B
        OR      A
        JR      Z,BC_PDOK
        LD      A,(HL)
        INC     HL
        DEC     B
        CP      '.'
        JR      NZ,BC_PSKIPN
        JR      BC_PEXT0
BC_PDOT:
        INC     HL
        DEC     B
BC_PEXT0:
        LD      DE,(BC_FCBPTR)
        LD      A,E
        ADD     A,9
        LD      E,A
        JR      NC,BC_PEXT
        INC     D
BC_PEXT:
        LD      C,3
BC_PELOOP:
        LD      A,B
        OR      A
        JR      Z,BC_PDOK
        LD      A,(HL)
        CP      '*'
        JR      Z,BC_PESTAR
        CP      ' '
        JR      Z,BC_PDOK
        LD      (DE),A
        INC     DE
        INC     HL
        DEC     B
        DEC     C
        JR      NZ,BC_PELOOP
        JR      BC_PDOK
BC_PESTAR:
        LD      A,'?'
BC_PESLP:
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,BC_PESLP
BC_PDOK:
        LD      A,(BC_INLEN)
        OR      A
        RET

BC_DIR:
        CALL    BC_DUSEL
        LD      C,31            ; selected drive's DPB supplies EXM
        CALL    BDOS
        LD      DE,4
        ADD     HL,DE
        LD      A,(HL)
        CPL
        LD      (BC_EXMASK),A
        XOR     A
        LD      (BC_DCOL),A
        LD      (BC_DFOUND),A
        LD      HL,(BC_DARGP)   ; Function 31 does not preserve arguments
        LD      A,(BC_DARGL)
        LD      B,A
        LD      A,B
        OR      A
        JR      NZ,BC_DPARSE
        LD      HL,BC_ALL
        LD      B,3
BC_DPARSE:
        LD      DE,BC_FCB
        CALL    BC_PFCB
        LD      DE,0080H
        LD      C,26
        CALL    BDOS
        LD      C,17
BC_DNEXT:
        LD      DE,BC_FCB
        CALL    BDOS
        CP      0FFH
        JP      Z,BC_DDONE
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,080H
        LD      L,A
        LD      H,0
        LD      (BC_DIREP),HL
        LD      A,1             ; stock NO FILE depends on search, not display
        LD      (BC_DFOUND),A   ; a matching SYS entry still counts as found
; Patch 2026-09-02: the proof DIR printed one name per line and exposed every
; matching extent. Preserve this old path in history here: stock CCP output is
; a four-column directory of DIR-status filenames, once per physical extent
; group. EXM determines which low EX bits belong to the first group.
        LD      DE,12
        ADD     HL,DE
        LD      A,(HL)
        LD      HL,BC_EXMASK
        AND     (HL)
        JR      NZ,BC_DSKIP
        LD      HL,(BC_DIREP)
        LD      DE,10
        ADD     HL,DE
        LD      A,(HL)
        AND     080H            ; T2 high bit marks a SYS, not DIR, file
        JR      NZ,BC_DSKIP
        LD      A,(BC_DCOL)
        OR      A
        JR      NZ,BC_DSEP
        LD      DE,BC_NL
        LD      C,9
        CALL    BDOS
; Patch 2026-09-07: print the drive BDOS is actually searching.  The old
; tentative-prefix value made DIR ONE.TXT on B: print O:.  A filename can
; start with a drive letter without being a drive-qualified filespec.
        LD      C,25
        CALL    BDOS
BC_DDRIVE:
        ADD     A,'A'
        CALL    BC_PCHAR
        LD      A,':'
        CALL    BC_PCHAR
        LD      A,' '
        CALL    BC_PCHAR
        JR      BC_DNAME
BC_DSEP:
        LD      DE,BC_SEP
        LD      C,9
        CALL    BDOS
BC_DNAME:
        LD      HL,(BC_DIREP)
        INC     HL
        LD      B,8
        CALL    BC_FFIX
        LD      A,' '
        CALL    BC_PCHAR
        LD      HL,(BC_DIREP)
        LD      DE,9
        ADD     HL,DE
        LD      B,3
        CALL    BC_FFIX
        LD      A,(BC_DCOL)
        INC     A
        AND     3
        LD      (BC_DCOL),A
BC_DMORE:
BC_DSKIP:
        LD      C,18
        JP      BC_DNEXT
BC_DDONE:
        LD      A,(BC_DFOUND)
        OR      A
        JR      Z,BC_DNOFILE
        LD      DE,BC_NL
        LD      C,9
        CALL    BDOS
        JP      BC_DURST
BC_DNOFILE:
        LD      DE,BC_NOFILE
        LD      C,9
        CALL    BDOS
        JP      BC_DURST

BC_FFIX:
        LD      A,(HL)
        AND     07FH
        PUSH    HL
        PUSH    BC
        CALL    BC_PCHAR
        POP     BC
        POP     HL
        INC     HL
        DJNZ    BC_FFIX
        RET
BC_PCHAR:
        LD      E,A
        LD      C,2
        JP      BDOS

; DIR accepts the CCP's complete DU selector before an optional filespec:
; A:, 5:, or C3:.  The selected DU is deliberately temporary; this preserves
; the historical distinction between "DIR B:" and the navigation command B:.
BC_DUSEL:
        LD      (BC_DARGP),HL
        LD      A,B
        LD      (BC_DARGL),A
        LD      C,25
        CALL    BDOS
        LD      (BC_DSAVE),A
        LD      E,0FFH
        LD      C,32
        CALL    BDOS
        LD      (BC_USAVE),A
        LD      A,0FFH
        LD      (BC_DTARG),A
        LD      (BC_UTARG),A
        LD      HL,(BC_DARGP)
        LD      A,(BC_DARGL)
        LD      B,A
        OR      A
        RET     Z
        LD      A,(HL)
        CP      'A'
        JR      C,BC_DUNUM
        CP      'P'+1
        JP      NC,BC_DUNONE
        SUB     'A'
        LD      (BC_DTARG),A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JP      Z,BC_DUNONE
        LD      A,(HL)
        CP      ':'
        JR      Z,BC_DUCOL
; BetterCP/M's combined DU form is an additive extension to CP/M's D: form.
; After a drive letter, accept one or two decimal user digits before the colon.
        CP      '0'
        JP      C,BC_DUNONE
        CP      '9'+1
        JP      NC,BC_DUNONE
        SUB     '0'
        LD      C,A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JP      Z,BC_DUNONE
        LD      A,(HL)
        CP      ':'
        JR      Z,BC_DUDONE
        CP      '0'
        JP      C,BC_DUNONE
        CP      '9'+1
        JP      NC,BC_DUNONE
        LD      A,C
        ADD     A,A
        LD      D,A
        ADD     A,A
        ADD     A,A
        ADD     A,D
        LD      C,A
        LD      A,(HL)
        SUB     '0'
        ADD     A,C
        CP      32
        JR      NC,BC_DUNONE
        LD      C,A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JR      Z,BC_DUNONE
        LD      A,(HL)
        CP      ':'
        JR      NZ,BC_DUNONE
BC_DUDONE:
        LD      A,C
        LD      (BC_UTARG),A
        JR      BC_DUCOL
BC_DUNUM:
        LD      A,B
        OR      A
        JR      Z,BC_DUNONE
        LD      A,(HL)
        CP      '0'
        JR      C,BC_DUNONE
        CP      '9'+1
        JR      NC,BC_DUNONE
        SUB     '0'
        LD      C,A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JR      Z,BC_DUNONE
        LD      A,(HL)
        CP      '0'
        JR      C,BC_DUONE
        CP      '9'+1
        JR      NC,BC_DUONE
        LD      A,C
        ADD     A,A
        LD      D,A
        ADD     A,A
        ADD     A,A
        ADD     A,D
        LD      C,A
        LD      A,(HL)
        SUB     '0'
        ADD     A,C
        CP      32
        JR      NC,BC_DUNONE
        LD      C,A
        INC     HL
        DEC     B
BC_DUONE:
        LD      A,(HL)
        CP      ':'
        JR      NZ,BC_DUNONE
        LD      A,C
        LD      (BC_UTARG),A
BC_DUCOL:
        INC     HL
        DEC     B
        LD      (BC_DARGP),HL
        LD      A,B
        LD      (BC_DARGL),A
        LD      A,(BC_DTARG)
        CP      0FFH
        JR      Z,BC_DUUSER
        LD      E,A
        LD      C,14
        CALL    BDOS
BC_DUUSER:
        LD      A,(BC_UTARG)
        CP      0FFH
        JR      Z,BC_DUOUT
        LD      E,A
        LD      C,32
        CALL    BDOS
BC_DUOUT:
        LD      HL,(BC_DARGP)
        LD      A,(BC_DARGL)
        LD      B,A
        RET
BC_DUNONE:
        LD      HL,(BC_DARGP)
        LD      A,(BC_DARGL)
        LD      B,A
        RET

BC_DURST:
        LD      A,(BC_DSAVE)
        LD      E,A
        LD      C,14
        CALL    BDOS
        LD      A,(BC_USAVE)
        LD      E,A
        LD      C,32
        JP      BDOS
BC_FIELD:
        LD      A,(HL)
        AND     07FH
        CP      ' '
        JR      Z,BC_DFSKIP
        PUSH    HL
        PUSH    BC
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     BC
        POP     HL
BC_DFSKIP:
        INC     HL
        DJNZ    BC_FIELD
        RET

BC_ERA:
        CALL    BC_DUSEL
        LD      A,B
        OR      A
        JR      Z,BC_ENOFILE
        LD      DE,BC_FCB
        CALL    BC_PFCB
        LD      HL,BC_FCB+1
        LD      B,11
BC_EALLQ:
        LD      A,(HL)
        CP      '?'
        JR      NZ,BC_EDELETE
        INC     HL
        DJNZ    BC_EALLQ
; Stock CP/M asks before an all-wildcard erase. Its buffered reply must contain
; exactly one Y; extra characters cancel just as an N or empty line does.
        LD      DE,BC_ECONF
        LD      C,9
        CALL    BDOS
        XOR     A
        LD      (BC_EBUFFER+1),A
        LD      DE,BC_EBUFFER
        LD      C,10
        CALL    BDOS
        LD      A,(BC_EBUFFER+1)
        CP      1
        JR      NZ,BC_ERET
        LD      A,(BC_EBUFFER+2)
        AND     05FH
        CP      'Y'
        JR      NZ,BC_ERET
BC_EDELETE:
        LD      DE,BC_FCB
        LD      C,19
        CALL    BDOS
        CP      0FFH
        JR      NZ,BC_ERET
BC_ENOFILE:
        LD      DE,BC_NOFILE
        LD      C,9
        CALL    BDOS
BC_ERET:
        JP      BC_DURST

BC_TYPE:
        CALL    BC_DUSEL
        LD      A,B
        OR      A
        JP      Z,BC_TSYNTAX
; Separate the exact filename from the optional /P extension.
        LD      (BC_INPTR),HL
        LD      C,0
BC_TSCAN:
        LD      A,(HL)
        CP      ' '
        JR      Z,BC_TOPTION
        INC     HL
        INC     C
        DJNZ    BC_TSCAN
        XOR     A
        LD      (BC_TPAGE),A
        JR      BC_TPARSE
BC_TOPTION:
        PUSH    BC
BC_TOSKIP:
        INC     HL
        DEC     B
        JR      Z,BC_TSYPOP
        LD      A,(HL)
        CP      ' '
        JR      Z,BC_TOSKIP
        LD      A,B
        CP      2
        JR      NZ,BC_TSYPOP
        LD      A,(HL)
        CP      '/'
        JR      NZ,BC_TSYPOP
        INC     HL
        LD      A,(HL)
        CP      'P'
        JR      NZ,BC_TSYPOP
        POP     BC
        LD      A,1
        LD      (BC_TPAGE),A
        JR      BC_TPARSE
BC_TSYPOP:
        POP     BC
        JP      BC_TSYNTAX
BC_TPARSE:
        LD      HL,(BC_INPTR)
        LD      B,C
        LD      DE,BC_FCB
        CALL    BC_PFCB
        LD      HL,BC_FCB+1
        CALL    BC_RNOQ
        JP      Z,BC_TSYNTAX
        LD      DE,BC_FCB
        LD      C,15
        CALL    BDOS
        INC     A
        JP      Z,BC_TSYNTAX
        LD      DE,BC_DMA
        LD      C,26
        CALL    BDOS
        XOR     A
        LD      (BC_TLCNT),A
        LD      DE,BC_NL
        LD      C,9
        CALL    BDOS
BC_TREAD:
        LD      DE,BC_FCB
        LD      C,20
        CALL    BDOS
        OR      A
        JR      Z,BC_TBLOCK
        CP      1
        JP      Z,BC_DURST
        LD      DE,BC_READERR
        JR      BC_TERROR
BC_TBLOCK:
        LD      HL,BC_DMA
        LD      B,128
BC_TCHAR:
        LD      A,(HL)
        CP      01AH
        JP      Z,BC_DURST
        PUSH    HL
        PUSH    BC
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     BC
        POP     HL
        LD      A,(HL)
        CP      10
        JR      NZ,BC_TNEXT
        PUSH    HL
        CALL    BC_TLINE
        POP     HL
BC_TNEXT:
        INC     HL
        DJNZ    BC_TCHAR
        JR      BC_TREAD

BC_TLINE:
        LD      A,(BC_TPAGE)
        OR      A
        RET     Z
        LD      HL,BC_TLCNT
        INC     (HL)
        LD      A,(HL)
        CP      23
        RET     C
        XOR     A
        LD      (HL),A
        PUSH    BC
        PUSH    DE
        LD      DE,BC_MORE
        LD      C,9
        CALL    BDOS
BC_TWAIT:
        LD      E,0FFH
        LD      C,6
        CALL    BDOS
        OR      A
        JR      Z,BC_TWAIT
        CP      3
        JR      Z,BC_TABORT
        CP      ' '
        JR      NZ,BC_TWAIT
        LD      DE,BC_MERASE
        LD      C,9
        CALL    BDOS
        POP     DE
        POP     BC
        RET
BC_TABORT:
        LD      C,0
        JP      BDOS
BC_TSYNTAX:
        LD      DE,BC_RQMARK
BC_TERROR:
        LD      C,9
        CALL    BDOS
        JP      BC_DURST

BC_REN:
        CALL    BC_DUSEL
        LD      A,B
        OR      A
        JP      Z,BC_RSYNTAX
        LD      (BC_INPTR),HL
        LD      A,B
        LD      (BC_INLEN),A
        LD      C,0
BC_RFIND:
        LD      A,(HL)
        CP      '='
        JR      Z,BC_RFOUND
        CP      '_'
        JR      Z,BC_RFOUND
        INC     HL
        INC     C
        DJNZ    BC_RFIND
        JP      BC_RSYNTAX
BC_RFOUND:
        LD      A,C
        OR      A
        JP      Z,BC_RSYNTAX
        PUSH    HL
        PUSH    BC
        LD      HL,(BC_INPTR)
        LD      B,C
        LD      DE,BC_NEWFCB
        CALL    BC_PFCB
        POP     BC
        POP     HL
        INC     HL
        LD      A,(BC_INLEN)
        SUB     C
        DEC     A
        JP      Z,BC_RSYNTAX
        LD      B,A
BC_RSKIP:
        LD      A,(HL)
        CP      ' '
        JR      NZ,BC_ROLD
        INC     HL
        DJNZ    BC_RSKIP
        JP      BC_RSYNTAX
BC_ROLD:
; The old name is the final operand. Stock CCP rejects another token rather
; than silently ignoring it, so trim only trailing blanks.
        PUSH    HL
        PUSH    BC
BC_RTAIL:
        LD      A,(HL)
        CP      ' '
        JR      Z,BC_RZ1
        INC     HL
        DJNZ    BC_RTAIL
        JR      BC_RZ3
BC_RZ1:
        LD      A,B
        LD      C,A
        INC     HL
        DEC     C
BC_RZ2:
        LD      A,C
        OR      A
        JR      Z,BC_RZ3
        LD      A,(HL)
        CP      ' '
        JP      NZ,BC_RZ4
        INC     HL
        DEC     C
        JR      BC_RZ2
BC_RZ4:
        POP     BC
        POP     HL
        JP      BC_RSYNTAX
BC_RZ3:
        POP     BC
        POP     HL
        LD      DE,BC_FCB
        CALL    BC_PFCB
        LD      A,(BC_NEWFCB+1)
        CP      ' '
        JP      Z,BC_RSYNTAX
        LD      A,(BC_FCB+1)
        CP      ' '
        JP      Z,BC_RSYNTAX
; Neither half of a CP/M rename FCB may be ambiguous.
        LD      HL,BC_NEWFCB+1
        CALL    BC_RNOQ
        JP      Z,BC_RSYNTAX
        LD      HL,BC_FCB+1
        CALL    BC_RNOQ
        JP      Z,BC_RSYNTAX
; An explicit drive on the old name must denote the already selected drive.
        LD      A,(BC_FCB)
        OR      A
        JR      Z,BC_RSAME
        LD      (BC_RDRIVE),A
        LD      C,25
        CALL    BDOS
        INC     A
        LD      HL,BC_RDRIVE
        CP      (HL)
        JP      NZ,BC_RSYNTAX
        XOR     A
        LD      (BC_FCB),A
BC_RSAME:
; Stock REN checks the destination before checking the source.
        LD      DE,BC_NEWFCB
        LD      C,17
        CALL    BDOS
        CP      0FFH
        JR      NZ,BC_REXISTS
        LD      DE,BC_FCB
        LD      C,17
        CALL    BDOS
        CP      0FFH
        JR      Z,BC_RNOFILE
        LD      HL,BC_NEWFCB
        LD      DE,BC_FCB+16
        LD      BC,12
        LDIR
        LD      DE,BC_FCB
        LD      C,23
        CALL    BDOS
        CP      0FFH
        JP      NZ,BC_DURST
BC_RNOFILE:
        LD      DE,BC_NOFILE
        JR      BC_RPRINT
BC_REXISTS:
        LD      DE,BC_REXMSG
        JR      BC_RPRINT
BC_RSYNTAX:
        LD      DE,BC_RQMARK
BC_RPRINT:
        LD      C,9
        CALL    BDOS
        JP      BC_DURST

; Return NZ when the eleven-byte 8.3 field at HL contains no question mark.
BC_RNOQ:
        LD      B,11
BC_RNQL:
        LD      A,(HL)
        CP      '?'
        RET     Z
        INC     HL
        DJNZ    BC_RNQL
        LD      A,1
        OR      A
        RET

; COPY and MOVE share one record-copy engine.  Both accepted spellings are
; normalized before either disk is touched:
;
;       COPY source destination
;       COPY destination:=source
;
; MOVE erases its source only after the new file has closed successfully.
BC_MOVE:
        LD      A,1
        LD      (BC_MVFLAG),A
        JR      BC_COPY
BC_COPY:
        LD      A,(BC_MVFLAG)
        AND     1
        LD      (BC_MVFLAG),A
        XOR     A
        LD      (BC_CMADE),A
; Save the command cursor before asking BDOS for the caller's DU.  Function
; calls own the ordinary registers; the first draft accidentally tried to
; parse whatever HL and B happened to contain after Function 32.
        LD      (BC_CBASE),HL
        LD      A,B
        LD      (BC_CBLEN),A
        LD      C,25
        CALL    BDOS
        LD      (BC_CDSAV),A
        LD      E,0FFH
        LD      C,32
        CALL    BDOS
        LD      (BC_CUSAV),A
        LD      HL,(BC_CBASE)
        LD      A,(BC_CBLEN)
        LD      B,A
        LD      A,B
        OR      A
        JP      Z,BC_CSYNT
        LD      C,0
BC_CFIND:
        LD      A,B
        CP      2
        JR      C,BC_CSPACE
        LD      A,(HL)
        CP      ':'
        JR      NZ,BC_CFNXT
        INC     HL
        LD      A,(HL)
        DEC     HL
        CP      '='
        JR      Z,BC_CASSIGN
BC_CFNXT:
        INC     HL
        INC     C
        DEC     B
        JR      BC_CFIND
BC_CASSIGN:
        LD      A,C
        OR      A
        JP      Z,BC_CSYNT
        LD      HL,(BC_CBASE)
        LD      (BC_CDPTR),HL
        LD      (BC_CDLEN),A
        LD      E,A
        LD      D,0
        ADD     HL,DE
        INC     HL
        INC     HL
        LD      A,(BC_CBLEN)
        SUB     C
        SUB     2
        JP      Z,BC_CSYNT
        LD      (BC_CSPTR),HL
        LD      (BC_CSLEN),A
        JR      BC_CPARSE
BC_CSPACE:
        LD      HL,(BC_CBASE)
        LD      A,(BC_CBLEN)
        LD      B,A
        LD      C,0
BC_CSWORD:
        LD      A,B
        OR      A
        JP      Z,BC_CSYNT
        LD      A,(HL)
        CP      ' '
        JR      Z,BC_CSSEP
        INC     HL
        INC     C
        DEC     B
        JR      BC_CSWORD
BC_CSSEP:
        LD      A,C
        OR      A
        JP      Z,BC_CSYNT
        LD      DE,(BC_CBASE)
        LD      (BC_CSPTR),DE
        LD      (BC_CSLEN),A
BC_CSSKIP:
        INC     HL
        DEC     B
        JP      Z,BC_CSYNT
        LD      A,(HL)
        CP      ' '
        JR      Z,BC_CSSKIP
        LD      (BC_CDPTR),HL
        LD      C,0
BC_CDWORD:
        LD      A,B
        OR      A
        JR      Z,BC_CDEND
        LD      A,(HL)
        CP      ' '
        JR      Z,BC_CDTAIL
        INC     HL
        INC     C
        DEC     B
        JR      BC_CDWORD
BC_CDTAIL:
        INC     HL
        DEC     B
BC_CDTRIM:
        LD      A,B
        OR      A
        JR      Z,BC_CDEND
        LD      A,(HL)
        CP      ' '
        JP      NZ,BC_CSYNT
        INC     HL
        DEC     B
        JR      BC_CDTRIM
BC_CDEND:
        LD      A,C
        OR      A
        JP      Z,BC_CSYNT
        LD      (BC_CDLEN),A
BC_CPARSE:
        LD      HL,(BC_CSPTR)
        LD      A,(BC_CSLEN)
        LD      B,A
        LD      DE,BC_FCB
        CALL    BC_COPAR
        JP      NC,BC_CSYNT
        LD      A,(BC_CODRV)
        LD      (BC_CSDRV),A
        LD      A,(BC_COUSE)
        LD      (BC_CSUSR),A
        LD      HL,(BC_CDPTR)
        LD      A,(BC_CDLEN)
        LD      B,A
        LD      DE,BC_NEWFCB
        CALL    BC_COPAR
        JP      NC,BC_CSYNT
        LD      A,(BC_CODRV)
        LD      (BC_CDDRV),A
        LD      A,(BC_COUSE)
        LD      (BC_CDUSR),A
; Refuse an exact self-copy.  Apart from being useless, deleting it during a
; failed MOVE cleanup would destroy the source.
        LD      A,(BC_CSDRV)
        LD      HL,BC_CDDRV
        CP      (HL)
        JR      NZ,BC_COPEN
        LD      A,(BC_CSUSR)
        LD      HL,BC_CDUSR
        CP      (HL)
        JR      NZ,BC_COPEN
        LD      HL,BC_FCB+1
        LD      DE,BC_NEWFCB+1
        LD      B,11
BC_CSAME:
        LD      A,(DE)
        CP      (HL)
        JR      NZ,BC_COPEN
        INC     DE
        INC     HL
        DJNZ    BC_CSAME
        JP      BC_CEXIST
BC_COPEN:
        CALL    BC_CSELS
        LD      DE,BC_FCB
        LD      C,15
        CALL    BDOS
        INC     A
        JP      Z,BC_CNOFILE
        CALL    BC_CSELD
        LD      DE,BC_NEWFCB
        LD      C,17
        CALL    BDOS
        CP      0FFH
        JP      NZ,BC_CEXIST
        LD      DE,BC_NEWFCB
        LD      C,22
        CALL    BDOS
        CP      0FFH
        JP      Z,BCNOSPC
        LD      A,1
        LD      (BC_CMADE),A
BC_CLOOP:
        CALL    BC_CSELS
        LD      DE,BC_DMA
        LD      C,26
        CALL    BDOS
        LD      DE,BC_FCB
        LD      C,20
        CALL    BDOS
        OR      A
        JR      Z,BC_CWRITE
        CP      1
        JR      Z,BC_CCLOSE
        LD      DE,BC_READERR
        JR      BC_CFAIL
BC_CWRITE:
        CALL    BC_CSELD
        LD      DE,BC_DMA
        LD      C,26
        CALL    BDOS
        LD      DE,BC_NEWFCB
        LD      C,21
        CALL    BDOS
        OR      A
        JR      Z,BC_CLOOP
        LD      DE,BC_NOSPACE
        JR      BC_CFAIL
BC_CCLOSE:
        CALL    BC_CSELD
        LD      DE,BC_NEWFCB
        LD      C,16
        CALL    BDOS
        CP      0FFH
        JR      Z,BCCLERR
        XOR     A
        LD      (BC_CMADE),A
        LD      A,(BC_MVFLAG)
        OR      A
        JR      Z,BC_COK
        CALL    BC_CSELS
        LD      DE,BC_FCB
        LD      C,19
        CALL    BDOS
        CP      0FFH
        JR      NZ,BC_COK
        LD      DE,BC_MVERR
        JR      BC_CPRINT
BCCLERR:
        LD      DE,BC_WRITEERR
        JR      BC_CFAIL
BCNOSPC:
        LD      DE,BC_NOSPACE
        JR      BC_CFAIL
BC_CNOFILE:
        LD      DE,BC_NOFILE
        JR      BC_CPRINT
BC_CEXIST:
        LD      DE,BC_REXMSG
        JR      BC_CPRINT
BC_CSYNT:
        LD      DE,BC_CUSAGE
        JR      BC_CPRINT
BC_CFAIL:
        PUSH    DE
        LD      A,(BC_CMADE)
        OR      A
        JR      Z,BC_CFP
        CALL    BC_CSELD
        LD      DE,BC_NEWFCB
        LD      C,19
        CALL    BDOS
        XOR     A
        LD      (BC_CMADE),A
BC_CFP:
        POP     DE
BC_CPRINT:
        LD      C,9
        CALL    BDOS
BC_COK:
        LD      DE,0080H
        LD      C,26
        CALL    BDOS
        LD      A,(BC_CDSAV)
        LD      E,A
        LD      C,14
        CALL    BDOS
        LD      A,(BC_CUSAV)
        LD      E,A
        LD      C,32
        JP      BDOS

; Parse one exact DU-qualified operand into the supplied FCB, while capturing
; the effective drive and user selected by the qualifier.
BC_COPAR:
        LD      (BC_COFCP),DE
        CALL    BC_DUSEL
        LD      (BC_COPTR),HL
        LD      A,B
        LD      (BC_COLEN),A
        OR      A
        JR      Z,BC_COPBAD
        LD      C,25
        CALL    BDOS
        LD      (BC_CODRV),A
        LD      E,0FFH
        LD      C,32
        CALL    BDOS
        LD      (BC_COUSE),A
        LD      HL,(BC_COPTR)
        LD      A,(BC_COLEN)
        LD      B,A
        LD      DE,(BC_COFCP)
        CALL    BC_PFCB
        LD      DE,(BC_COFCP)
        INC     DE
        LD      A,(DE)
        CP      ' '
        JR      Z,BC_COPBAD
        EX      DE,HL
        CALL    BC_RNOQ
        JR      Z,BC_COPBAD
        CALL    BC_DURST
        SCF
        RET
BC_COPBAD:
        CALL    BC_DURST
        OR      A
        RET

BC_CSELS:
        LD      A,(BC_CSDRV)
        LD      B,A
        LD      A,(BC_CSUSR)
        LD      E,A
        JR      BC_CSETDU
BC_CSELD:
        LD      A,(BC_CDDRV)
        LD      B,A
        LD      A,(BC_CDUSR)
        LD      E,A
BC_CSETDU:
        LD      A,E
        LD      (BC_CUTMP),A
        LD      E,B
        LD      C,14
        CALL    BDOS
        LD      A,(BC_CUTMP)
        LD      E,A
        LD      C,32
        JP      BDOS

; CLS is currently expressed through the Model 4 console's 1CH clear-screen
; byte. Preserve this platform fact visibly until BetterCP/M defines a
; portable terminal-capability service for CPXs.
BC_CLR:
        LD      A,B
        OR      A
        JR      NZ,BC_CLRBAD
        LD      E,01CH
        LD      C,2
        JP      BDOS
BC_CLRBAD:
        LD      DE,BC_RQMARK
        JP      BC_PRINT

; USER remains a stock command even though direct 5: and C3: navigation makes
; it optional for interactive use. Function 32 is the sole owner of user state.
BC_USER:
        LD      A,B
        OR      A
        JR      Z,BC_USERBAD
        LD      A,(HL)
        SUB     '0'
        JR      C,BC_USERBAD
        CP      10
        JR      NC,BC_USERBAD
        LD      E,A
        DEC     B
        JR      Z,BC_USERSET
        LD      A,E
        ADD     A,A
        LD      D,A
        ADD     A,A
        ADD     A,A
        ADD     A,D
        LD      E,A
        INC     HL
        LD      A,(HL)
        SUB     '0'
        JR      C,BC_USERBAD
        CP      10
        JR      NC,BC_USERBAD
        ADD     A,E
        CP      32
        JR      NC,BC_USERBAD
        LD      E,A
        DEC     B
        JR      NZ,BC_USERBAD
BC_USERSET:
        LD      C,32
        JP      BDOS
BC_USERBAD:
        LD      DE,BC_RQMARK
        JP      BC_PRINT

; VER is a BetterCP/M default command rather than a DRI compatibility command.
; Keep its CPX and transient presentations byte-for-byte shared for now.
BC_VER:
        LD      A,B
        OR      A
        JR      NZ,BC_VERLONG
BC_VERSHORT:
        LD      DE,BC_VERSION
        JP      BC_PRINT
BC_VERLONG:
        CP      2
        JR      Z,BC_VERCHECK
BC_VERBAD:
        LD      DE,BC_RQMARK
        JP      BC_PRINT
BC_VERCHECK:
        LD      A,(HL)
        CP      '/'
        JR      NZ,BC_VERBAD
        INC     HL
        LD      A,(HL)
        CP      'V'
        JR      NZ,BC_VERBAD
        LD      C,206
        CALL    BDOS
        LD      A,(HL)
        CP      'B'
        JR      NZ,BC_VERBAD
        INC     HL
        LD      A,(HL)
        CP      'V'
        JR      NZ,BC_VERBAD
        INC     HL
        LD      A,(HL)
        CP      1
        JR      NZ,BC_VERBAD
        INC     HL
        LD      A,(HL)
        INC     HL
        INC     HL              ; system identity is already in concise banner
        INC     HL
        INC     HL
        INC     HL              ; skip system release pointer
        PUSH    AF              ; count and cursor survive public BDOS calls
        PUSH    HL
        LD      DE,BC_VERSION
        LD      C,9
        CALL    BDOS
        POP     HL
        POP     AF
BC_VLOOP:
        OR      A
        RET     Z
        DEC     A
        PUSH    AF
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     HL
        PUSH    HL
        LD      C,9
        CALL    BDOS
        POP     HL
        LD      DE,BC_VAPI
        PUSH    HL
        LD      C,9
        CALL    BDOS
        POP     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     HL
        PUSH    HL
        LD      C,9
        CALL    BDOS
        POP     HL
        LD      DE,BC_VIMPL
        PUSH    HL
        LD      C,9
        CALL    BDOS
        POP     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     HL
        PUSH    HL
        LD      C,9
        CALL    BDOS
        POP     HL
        PUSH    HL
        LD      E,13
        LD      C,2
        CALL    BDOS
        LD      E,10
        LD      C,2
        CALL    BDOS
        POP     HL
        POP     AF
        JR      BC_VLOOP
BC_PRINT:
        LD      C,9
        JP      BDOS

BC_KDIR:       DB      'DIR'
BC_KERA:       DB      'ERA'
BC_KTYPE:      DB      'TYPE'
BC_KREN:       DB      'REN'
BC_KCLS:       DB      'CLS'
BC_KUSER:      DB      'USER'
BC_KVER:       DB      'VER'
BC_KCOPY:      DB      'COPY'
BC_KMOVE:      DB      'MOVE'
BC_ALL:        DB      '*.*'
BC_NL:         DB      13,10,'$'
BC_SEP:        DB      ' : ','$'
BC_NOFILE:     DB      13,10,'NO FILE',13,10,'$'
BC_ECONF:      DB      13,10,'ALL (Y/N)? $'
BC_READERR:    DB      13,10,'READ ERROR',13,10,'$'
BC_MORE:       DB      '--More--$'
BC_MERASE:     DB      8,' ',8,8,' ',8,8,' ',8,8,' ',8
                DB      8,' ',8,8,' ',8,8,' ',8,8,' ',8,'$'
BC_REXMSG:     DB      13,10,'FILE EXISTS',13,10,'$'
BC_WRITEERR:   DB      13,10,'WRITE ERROR',13,10,'$'
BC_MVERR:      DB      13,10,'COPY MADE; SOURCE NOT ERASED',13,10,'$'
BC_CUSAGE:     DB      13,10,'COPY source destination OR destination:=source',13,10,'$'
BC_RQMARK:     DB      13,10,'?',13,10,'$'
BC_NOSPACE:    DB      13,10,'NO SPACE',13,10,'$'
BC_VERSION:    DB      13,10,'BetterCP/M 0.3',13,10,'$'
BC_VAPI:       DB      ': API ','$'
BC_VIMPL:      DB      '; implementation ','$'
BC_CMDPTR:     DW      0
BC_CMDLEN:     DB      0
BC_KEYLEN:     DB      0
BC_ARGLEN:     DB      0
BC_INPTR:      DW      0
BC_INLEN:      DB      0
BC_FCBPTR:     DW      0
BC_DIREP:      DW      0080H
BC_DARGP:      DW      0
BC_DARGL:      DB      0
BC_DSAVE:      DB      0
BC_USAVE:      DB      0
BC_DTARG:      DB      0FFH
BC_UTARG:      DB      0FFH
BC_EXMASK:     DB      0FFH
BC_DCOL:       DB      0
BC_DFOUND:     DB      0
BC_EBUFFER:    DB      2,0,0,0
BC_RDRIVE:     DB      0
BC_TPAGE:      DB      0
BC_TLCNT:      DB      0
BC_MVFLAG:     DB      0
BC_CDSAV:      DB      0
BC_CUSAV:      DB      0
BC_CBASE:      DW      0
BC_CBLEN:      DB      0
BC_CSPTR:      DW      0
BC_CSLEN:      DB      0
BC_CDPTR:      DW      0
BC_CDLEN:      DB      0
BC_CSDRV:      DB      0
BC_CSUSR:      DB      0
BC_CDDRV:      DB      0
BC_CDUSR:      DB      0
BC_CODRV:      DB      0
BC_COUSE:      DB      0
BC_COPTR:      DW      0
BC_COLEN:      DB      0
BC_COFCP:      DW      0
BC_CUTMP:      DB      0
BC_CMADE:      DB      0
BC_FCB:
        REPT    36
        DB      0
        ENDM
BC_NEWFCB:
        REPT    36
        DB      0
        ENDM
BC_DMA:
        REPT    128
        DB      0
        ENDM

        .DEPHASE
        END
