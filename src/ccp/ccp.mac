; BetterCP/M initial resident command processor.
;
; The original EA40H placement left too little room for resident commands.
; Patch 2026-09-01: move the CCP into the unused E940H..ECFFH region so DIR
; can remain resident without taking space from transient programs.

CCPBASE         EQU     0E940H
BDOS            EQU     0C100H

        CSEG
        .PHASE  CCPBASE

CCP_ENTRY:
        LD      SP,CCP_STKTOP
CCP_LOOP:
        LD      DE,CCP_PROMPT
        LD      C,9
        CALL    BDOS
        LD      C,25
        CALL    BDOS
        ADD     A,'A'
        LD      E,A
        LD      C,2
        CALL    BDOS
        LD      E,'>'
        LD      C,2
        CALL    BDOS
        LD      DE,CCP_BUFFER
        LD      C,10
        CALL    BDOS
        LD      A,(CCP_COUNT)
        OR      A
        JR      Z,CCP_LOOP
        CALL    CCP_UPPER
        LD      A,(CCP_COUNT)
        CP      3
        JR      Z,CCP_TRYVER
        CP      4
        JR      Z,CCP_TRYWARM
CCP_BAD:
        CALL    CCP_LOAD
        JR      NC,CCP_LOOP     ; successful program exits only via warm start
        LD      DE,CCP_UNKNOWN
        LD      C,9
        CALL    BDOS
        JR      CCP_LOOP
CCP_TRYVER:
        LD      HL,CCP_DATA
        LD      DE,CCP_VERKEY
        LD      B,3
        CALL    CCP_EQUAL
        JR      NZ,CCP_TRYDIR
        LD      DE,CCP_VERSION
        LD      C,9
        CALL    BDOS
        JR      CCP_LOOP
CCP_TRYDIR:
        LD      HL,CCP_DATA
        LD      DE,CCP_DIRKEY
        LD      B,3
        CALL    CCP_EQUAL
        JR      NZ,CCP_BAD
        CALL    CCP_DIR
        JR      CCP_LOOP
CCP_TRYWARM:
        LD      HL,CCP_DATA
        LD      DE,CCP_WARMKEY
        LD      B,4
        CALL    CCP_EQUAL
        JR      NZ,CCP_BAD
        LD      C,0
        JP      BDOS

CCP_UPPER:
        LD      HL,CCP_DATA
        LD      A,(CCP_COUNT)
        LD      B,A
CCP_UPLOOP:
        LD      A,(HL)
        CP      'a'
        JR      C,CCP_UPNEXT
        CP      'z'+1
        JR      NC,CCP_UPNEXT
        AND     05FH
        LD      (HL),A
CCP_UPNEXT:
        INC     HL
        DJNZ    CCP_UPLOOP
        RET

CCP_EQUAL:
        LD      A,(DE)
        CP      (HL)
        RET     NZ
        INC     DE
        INC     HL
        DJNZ    CCP_EQUAL
        RET

; First transient loader: a command containing one bare 1..8-character name
; selects NAME.COM. Arguments and explicit extensions are later milestones.
CCP_LOAD:
        LD      HL,CCP_FCB
        LD      B,36
        XOR     A
CCP_FCLR:
        LD      (HL),A
        INC     HL
        DJNZ    CCP_FCLR
        LD      HL,CCP_FCB+1
        LD      B,11
        LD      A,' '
CCP_FSPC:
        LD      (HL),A
        INC     HL
        DJNZ    CCP_FSPC
        LD      HL,CCP_COM
        LD      DE,CCP_FCB+9
        LD      BC,3
        LDIR
        LD      A,(CCP_COUNT)
        OR      A
        SCF
        RET     Z
        CP      9
        CCF
        RET     C               ; reject names longer than eight characters
        LD      B,A
        LD      HL,CCP_DATA
        LD      DE,CCP_FCB+1
CCP_FNCPY:
        LD      A,(HL)
        CP      '!'
        JR      C,CCP_LFAIL
        CP      '.'
        JR      Z,CCP_LFAIL
        LD      (DE),A
        INC     HL
        INC     DE
        DJNZ    CCP_FNCPY
        LD      DE,CCP_FCB
        LD      C,15
        CALL    BDOS
        INC     A
        JR      Z,CCP_LFAIL
        LD      HL,0100H
        LD      (CLDPTR),HL
CCP_LNEXT:
        LD      DE,(CLDPTR)
        LD      C,26
        CALL    BDOS
        LD      DE,CCP_FCB
        LD      C,20
        CALL    BDOS
        OR      A
        JR      NZ,CCP_LEOF
        LD      HL,(CLDPTR)
        LD      DE,128
        ADD     HL,DE
        LD      A,H
        CP      0C1H
        JR      NC,CCP_LFAIL
        LD      (CLDPTR),HL
        JR      CCP_LNEXT
CCP_LEOF:
        CP      1
        JR      NZ,CCP_LFAIL
        LD      DE,0080H
        LD      C,26
        CALL    BDOS
        LD      HL,005CH
        LD      B,32
        XOR     A
CCP_ZPAGE:
        LD      (HL),A
        INC     HL
        DJNZ    CCP_ZPAGE
        LD      (0080H),A
        LD      A,13
        LD      (0081H),A
        LD      SP,CCP_RET
        JP      0100H
CCP_LFAIL:
        SCF
        RET

; Resident DIR deliberately uses only the public BDOS search interface.  This
; keeps the CCP independent of the directory implementation and exercises the
; same contract available to transient CP/M programs.
CCP_DIR:
        LD      HL,CCP_DIRFCB
        LD      B,36
        XOR     A
CCP_DCLR:
        LD      (HL),A
        INC     HL
        DJNZ    CCP_DCLR
        LD      HL,CCP_DIRFCB+1
        LD      B,11
        LD      A,'?'
CCP_DWILD:
        LD      (HL),A
        INC     HL
        DJNZ    CCP_DWILD
        LD      DE,0080H
        LD      C,26
        CALL    BDOS
        XOR     A
        LD      (CCP_DFOUND),A
        LD      C,17
CCP_DNEXT:
        LD      DE,CCP_DIRFCB
        CALL    BDOS
        CP      0FFH
        JR      Z,CCP_DDONE
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,080H
        LD      L,A
        LD      H,0
        LD      (CCP_DIREP),HL
        LD      DE,12
        ADD     HL,DE
        LD      A,(HL)
        AND     01FH
        JR      NZ,CCP_DMORE
        INC     HL
        INC     HL
        LD      A,(HL)
        AND     03FH
        JR      NZ,CCP_DMORE
        LD      A,1
        LD      (CCP_DFOUND),A
        LD      DE,CCP_DIRNL
        LD      C,9
        CALL    BDOS
        LD      HL,(CCP_DIREP)
        INC     HL
        LD      B,8
        CALL    CCP_DFIELD
        LD      HL,(CCP_DIREP)
        LD      DE,9
        ADD     HL,DE
        LD      A,(HL)
        CP      ' '
        JR      Z,CCP_DMORE
        LD      E,'.'
        LD      C,2
        CALL    BDOS
        LD      HL,(CCP_DIREP)
        LD      DE,9
        ADD     HL,DE
        LD      B,3
        CALL    CCP_DFIELD
CCP_DMORE:
        LD      C,18
        JR      CCP_DNEXT
CCP_DDONE:
        LD      A,(CCP_DFOUND)
        OR      A
        RET     NZ
        LD      DE,CCP_NOFILE
        LD      C,9
        JP      BDOS

CCP_DFIELD:
        LD      (CCP_DFPTR),HL
        LD      A,B
        LD      (CCP_DFCNT),A
CCP_DFLOOP:
        LD      HL,(CCP_DFPTR)
        LD      A,(HL)
        INC     HL
        LD      (CCP_DFPTR),HL
        AND     07FH
        CP      ' '
        JR      Z,CCP_DFSKIP
        LD      E,A
        LD      C,2
        CALL    BDOS
CCP_DFSKIP:
        LD      HL,CCP_DFCNT
        DEC     (HL)
        JR      NZ,CCP_DFLOOP
        RET

CCP_PROMPT:
        DB      13,10,'$'
CCP_UNKNOWN:
        DB      10,'?','$'
CCP_VERSION:
        DB      10,'BetterCP/M 0.1','$'
CCP_VERKEY:
        DB      'VER'
CCP_DIRKEY:
        DB      'DIR'
CCP_WARMKEY:
        DB      'WARM'
CCP_COM:
        DB      'COM'

CCP_BUFFER:
        DB      127
CCP_COUNT:
        DB      0
CCP_DATA:
        REPT    127
        DB      0
        ENDM

CCP_FCB:
        REPT    36
        DB      0
        ENDM
CLDPTR:
        DW      0100H
CCP_DIREP:
        DW      0080H
CCP_DFPTR:
        DW      0080H
CCP_DFCNT:
        DB      0
CCP_DFOUND:
        DB      0
CCP_DIRNL:
        DB      10,'$'
CCP_NOFILE:
        DB      10,'NO FILE','$'
CCP_DIRFCB:
        REPT    36
        DB      0
        ENDM
CCP_RET:
        DW      0000H

CCP_STACK:
        REPT    64
        DB      0
        ENDM
CCP_STKTOP:

        .DEPHASE
        END
