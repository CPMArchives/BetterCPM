; BetterCP/M initial command processor.
;
; The original EA40H placement left too little room for resident commands.
; Patch 2026-09-01: move the CCP into the unused E940H..ECFFH region so DIR
; can remain resident without taking space from transient programs.
; Patch 2026-09-02: USER exhausted that exact-fit region.  Move the base down
; into the verified gap after Directory Services; ED00H remains untouched.
; Patch 2026-09-02: public SECTRAN calls grew Directory Services through
; E8C0H. Advance the CCP by 16 bytes, retaining a guard before E8D0H.
; Patch 2026-09-02: live-DPB refresh extended Directory Services through
; E8D5H. Advance another 16 bytes, preserving a ten-byte guard.
; Patch 2026-09-02: CPX support ended the exact-fit provisional placement at
; E8D6H and temporarily protected B000H..BFFFH.  Specification 96 introduces
; the quantitative memory model: the no-extension CCP is page-rounded and
; ends immediately below the C000H fixed-system boundary.  BB00H is therefore
; this configuration's calculated base, not a permanent ABI address.

CCPBASE         EQU     0BB00H
BDOS            EQU     0C100H
CPXHEAD         EQU     0C086H  ; active head in fixed extension descriptor
TPATOP          EQU     0C090H  ; exclusive upper bound for transient loads

        CSEG
        .PHASE  CCPBASE

CCP_ENTRY:
        LD      SP,CCP_STKTOP
CCP_LOOP:
        LD      DE,CCP_PROMPT
        LD      C,9
        CALL    BDOS
        CALL    CCP_DUPROMPT
        LD      E,'>'
        LD      C,2
        CALL    BDOS
        LD      DE,CCP_BUFFER
        LD      C,10
        CALL    BDOS
        LD      A,(CCP_COUNT)
        OR      A
        JR      Z,CCP_LOOP
        CALL    CCP_UPPER
; Patch 2026-09-02: direct drive/user navigation is command-processor syntax,
; not a resident command.  Keep BDOS as the sole owner of both values so the
; prompt, FCB operations, transient programs, and warm-start reconstruction
; all observe one coherent state.  Accepted forms are B:, 5:, and C3:.
        CALL    CCP_NAVIGATE
        JR      C,CCP_LOOP
; Patch 2026-09-02: production CPXs now get first refusal.  During the BASIC
; proof transition, the old resident commands remain below as fallbacks; this
; ordering ensures ordinary DIR actually verifies BASIC.CPX when it is loaded.
        CALL    CPX_DISPATCH
        JR      C,CCP_LOOP
        LD      A,(CCP_COUNT)
        CP      6
        JP      Z,CCP_TRYUSER
        CP      7
        JP      Z,CCP_TRYUSER
        CP      3
        JP      Z,CCP_TRYVER
        CP      4
        JP      Z,CCP_TRYWARM
CCP_BAD:
        CALL    CCP_LOAD
        JR      NC,CCP_LOOP     ; successful program exits only via warm start
        LD      DE,CCP_UNKNOWN
        LD      C,9
        CALL    BDOS
        JP      CCP_LOOP

; Display the live default drive/user pair.  User numbers are deliberately
; unpadded: A0>, A5>, A31>.  The following command-line colon belongs to the
; navigation syntax, not to the prompt itself.
CCP_DUPROMPT:
        LD      C,25
        CALL    BDOS
        ADD     A,'A'
        LD      E,A
        LD      C,2
        CALL    BDOS
        LD      E,0FFH
        LD      C,32
        CALL    BDOS
        CP      10
        JR      C,CCP_DUPONE
        LD      B,0
CCP_DUPTEN:
        SUB     10
        INC     B
        CP      10
        JR      NC,CCP_DUPTEN
        PUSH    AF
        LD      A,B
        ADD     A,'0'
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     AF
CCP_DUPONE:
        ADD     A,'0'
        LD      E,A
        LD      C,2
        JP      BDOS

; Carry set means that the complete input line was navigation syntax, whether
; the requested physical drive exists or not.  This prevents a failed B: from
; falling through into a search for the impossible transient "B:.COM".
CCP_NAVIGATE:
        LD      A,(CCP_COUNT)
        CP      2
        JR      C,CCP_NAVNO
        CP      5
        JR      NC,CCP_NAVNO
        LD      B,A
        LD      HL,CCP_DATA
        LD      E,0FFH          ; FFh means retain current drive
        LD      D,0FFH          ; FFh means retain current user
        LD      A,(HL)
        CP      'A'
        JR      C,CCP_NAVUSER
        CP      'P'+1
        JR      NC,CCP_NAVNO
        SUB     'A'
        LD      E,A
        INC     HL
        DEC     B
        LD      A,B
        CP      1
        JR      Z,CCP_NAVCOLON  ; drive-only form
CCP_NAVUSER:
        LD      A,B
        CP      2
        JR      Z,CCP_NVONE
        CP      3
        JR      NZ,CCP_NAVNO
        LD      A,(HL)
        SUB     '0'
        JR      C,CCP_NAVNO
        CP      4               ; tens digit may only be 0..3
        JR      NC,CCP_NAVNO
        LD      C,A
        ADD     A,A
        LD      D,A
        ADD     A,A
        ADD     A,A
        ADD     A,D             ; ten times first digit
        LD      D,A
        INC     HL
        LD      A,(HL)
        SUB     '0'
        JR      C,CCP_NAVNO
        CP      10
        JR      NC,CCP_NAVNO
        ADD     A,D
        CP      32
        JR      NC,CCP_NAVNO
        LD      D,A
        INC     HL
        JR      CCP_NAVCOLON
CCP_NVONE:
        LD      A,(HL)
        SUB     '0'
        JR      C,CCP_NAVNO
        CP      10
        JR      NC,CCP_NAVNO
        LD      D,A
        INC     HL
CCP_NAVCOLON:
        LD      A,(HL)
        CP      ':'
        JR      NZ,CCP_NAVNO
        LD      A,E
        CP      0FFH
        JR      Z,CCP_NAVSETU
        PUSH    DE
        LD      C,14
        CALL    BDOS
        POP     DE
        CP      0FFH
        JR      Z,CCP_NAVDONE
CCP_NAVSETU:
        LD      A,D
        CP      0FFH
        JR      Z,CCP_NAVDONE
        LD      E,A
        LD      C,32
        CALL    BDOS
CCP_NAVDONE:
        SCF
        RET
CCP_NAVNO:
        OR      A
        RET
CCP_TRYVER:
        LD      HL,CCP_DATA
        LD      DE,CCP_VERKEY
        LD      B,3
        CALL    CCP_EQUAL
        JR      NZ,CCP_TRYDIR
        LD      DE,CCP_VERSION
        LD      C,9
        CALL    BDOS
        JP      CCP_LOOP
CCP_TRYDIR:
        LD      HL,CCP_DATA
        LD      DE,CCP_DIRKEY
        LD      B,3
        CALL    CCP_EQUAL
        JP      NZ,CCP_BAD
        CALL    CCP_DIR
        JP      CCP_LOOP
CCP_TRYWARM:
        LD      HL,CCP_DATA
        LD      DE,CCP_WARMKEY
        LD      B,4
        CALL    CCP_EQUAL
        JP      NZ,CCP_BAD
        LD      C,0
        JP      BDOS

; Patch 2026-09-02: keep the resident USER command deliberately thin.  The
; CCP parses only its decimal operand; BDOS Function 32 remains the owner of
; current-user state, so transient programs and the command environment can
; never acquire divergent copies.
CCP_TRYUSER:
        LD      HL,CCP_DATA
        LD      DE,CU_KEY
        LD      B,5
        CALL    CCP_EQUAL
        JP      NZ,CCP_BAD
        LD      A,(HL)
        SUB     '0'
        JP      C,CCP_BAD
        CP      10
        JP      NC,CCP_BAD
        LD      E,A
        LD      A,(CCP_COUNT)
        CP      6
        JR      Z,CCP_USERSET
        LD      A,E
        ADD     A,A
        LD      D,A             ; D=first digit times two
        ADD     A,A
        ADD     A,A
        ADD     A,D             ; A=first digit times ten
        LD      E,A
        INC     HL
        LD      A,(HL)
        SUB     '0'
        JP      C,CCP_BAD
        CP      10
        JP      NC,CCP_BAD
        ADD     A,E
        CP      32
        JP      NC,CCP_BAD
        LD      E,A
CCP_USERSET:
        LD      C,32
        CALL    BDOS
        JP      CCP_LOOP

; Command Processor Extension (CPX) chain.
;
; Each header contains DW next,entry.  Entry receives DE=upper-case command
; text and B=length.  Carry set means handled; carry clear passes to the next
; CPX.  A CPX may alter ordinary registers but must preserve SP, IX, IY and the
; command buffer. CPXs get first refusal; currently retained core commands are
; transition fallbacks and disappear only after BASIC.CPX is fully verified.
CPX_DISPATCH:
        LD      HL,(CPXHEAD)
CPX_NEXT:
        LD      A,H
        OR      L
        RET     Z
        LD      (CPX_CUR),HL
        INC     HL
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (CPX_CALL+1),DE
        LD      DE,CCP_DATA
        LD      A,(CCP_COUNT)
        LD      B,A
; Patch 2026-09-02: the CCP is reloadable RAM, so patching this CALL provides
; a compact Z80 indirect-call trampoline while preserving a normal return.
CPX_CALL:
        CALL    0000H
CPX_RETURN:
        RET     C
        LD      HL,(CPX_CUR)
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        JR      CPX_NEXT

CCP_UPPER:
        LD      HL,CCP_DATA
        LD      A,(CCP_COUNT)
        LD      B,A
CCP_UPLOOP:
        LD      A,(HL)
        CP      'a'
        JR      C,CCP_UPNEXT
        CP      'z'+1
        JR      NC,CCP_UPNEXT
        AND     05FH
        LD      (HL),A
CCP_UPNEXT:
        INC     HL
        DJNZ    CCP_UPLOOP
        RET

CCP_EQUAL:
        LD      A,(DE)
        CP      (HL)
        RET     NZ
        INC     DE
        INC     HL
        DJNZ    CCP_EQUAL
        RET

; First transient loader: a command containing one bare 1..8-character name
; selects NAME.COM. Arguments and explicit extensions are later milestones.
CCP_LOAD:
        LD      HL,CCP_FCB
        LD      B,36
        XOR     A
CCP_FCLR:
        LD      (HL),A
        INC     HL
        DJNZ    CCP_FCLR
        LD      HL,CCP_FCB+1
        LD      B,11
        LD      A,' '
CCP_FSPC:
        LD      (HL),A
        INC     HL
        DJNZ    CCP_FSPC
        LD      HL,CCP_COM
        LD      DE,CCP_FCB+9
        LD      BC,3
        LDIR
        LD      A,(CCP_COUNT)
        OR      A
        SCF
        RET     Z
        LD      B,A
        LD      HL,CCP_DATA
        XOR     A
CCP_LNSCAN:
        LD      C,A
        LD      A,(HL)
        CP      ' '
        LD      A,C
        JR      Z,CCP_LNFOUND
        CP      8
        JP      NC,CCP_LFAIL
        INC     A
        INC     HL
        DJNZ    CCP_LNSCAN
        JR      CCP_LNFOUND
CCP_LNFOUND:
        OR      A               ; do not retain Z from the separating-space CP
        JP      Z,CCP_LFAIL
        LD      (CCP_NAMEL),A
        LD      B,A
        LD      HL,CCP_DATA
        LD      DE,CCP_FCB+1
CCP_FNCPY:
        LD      A,(HL)
        CP      '!'
        JP      C,CCP_LFAIL
        CP      '.'
        JP      Z,CCP_LFAIL
        LD      (DE),A
        INC     HL
        INC     DE
        DJNZ    CCP_FNCPY
        LD      DE,CCP_FCB
        LD      C,15
        CALL    BDOS
        INC     A
        JP      Z,CCP_LFAIL
        LD      HL,0100H
        LD      (CLDPTR),HL
CCP_LNEXT:
        LD      DE,(CLDPTR)
        LD      C,26
        CALL    BDOS
        LD      DE,CCP_FCB
        LD      C,20
        CALL    BDOS
        OR      A
        JR      NZ,CCP_LEOF
        LD      HL,(CLDPTR)
        LD      DE,128
        ADD     HL,DE
; Patch 2026-09-02: the transient ceiling is an active-layout value, not a
; compiled CCP address. Preserve the candidate pointer while comparing it
; with the exclusive ceiling published by the system gateway.
        PUSH    HL
        LD      DE,(TPATOP)
        OR      A
        SBC     HL,DE
        POP     HL
        JR      NC,CCP_LFAIL
        LD      (CLDPTR),HL
        JR      CCP_LNEXT
CCP_LEOF:
        CP      1
        JR      NZ,CCP_LFAIL
        LD      DE,0080H
        LD      C,26
        CALL    BDOS
        LD      HL,005CH
        LD      B,36
        XOR     A
CCP_ZPAGE:
        LD      (HL),A
        INC     HL
        DJNZ    CCP_ZPAGE
        LD      A,(CCP_COUNT)
        LD      HL,CCP_NAMEL
        SUB     (HL)
        LD      (0080H),A
        LD      B,A
        LD      A,(CCP_NAMEL)
        LD      E,A
        LD      D,0
        LD      HL,CCP_DATA
        ADD     HL,DE
        LD      DE,0081H
        LD      A,B
        OR      A
        JR      Z,CCP_LTAIL0
        LD      C,A
        LD      B,0
        LDIR
CCP_LTAIL0:
        LD      A,13
        LD      (DE),A
        LD      A,(CCP_COUNT)
        LD      HL,CCP_NAMEL
        SUB     (HL)
        LD      B,A
        LD      A,(CCP_NAMEL)
        LD      E,A
        LD      D,0
        LD      HL,CCP_DATA
        ADD     HL,DE
        CALL    CCP_PSKIP
        LD      DE,005CH
        CALL    CCP_PFCB
        CALL    CCP_PSKIP
        LD      DE,006CH
        CALL    CCP_PFCB
        LD      SP,CCP_RET
        JP      0100H
CCP_LFAIL:
        SCF
        RET

CCP_PSKIP:
        LD      A,B
        OR      A
        RET     Z
        LD      A,(HL)
        CP      ' '
        RET     NZ
        INC     HL
        DEC     B
        JR      CCP_PSKIP

; Build one ordinary space-padded 8.3 default FCB while leaving HL/B at the
; following separator.
CCP_PFCB:
        PUSH    HL
        PUSH    BC
        PUSH    DE
        XOR     A
        LD      (DE),A
        INC     DE
        LD      B,11
        LD      A,' '
PFCLRL:
        LD      (DE),A
        INC     DE
        DJNZ    PFCLRL
        POP     DE
        POP     BC
        POP     HL
        PUSH    DE
; Patch 2026-09-02: the original parser deliberately deferred drive prefixes,
; causing an argument such as B: to become the filename "B:" on drive zero.
; This compact A:..P: prefix recognizer occupies the final 21 bytes below the
; fixed ED00h physical-sector buffer; CCP_STKTOP now ends exactly at ED00h.
        LD      A,(HL)
        SUB     'A'-1
        CP      17
        JR      NC,PFNODRV
        LD      C,A
        INC     HL
        LD      A,(HL)
        DEC     HL
        CP      ':'
        JR      NZ,PFNODRV
        LD      A,C
        LD      (DE),A
        INC     HL
        INC     HL
        DEC     B
        DEC     B
PFNODRV:
        INC     DE
        LD      C,8
PFNAMEL:
        LD      A,B
        OR      A
        JR      Z,PFDONE
        LD      A,(HL)
        CP      ' '
        JR      Z,PFDONE
        CP      '.'
        JR      Z,PFDOT
        CP      '*'
        JR      Z,PFNSTAR
        LD      (DE),A
        INC     DE
        INC     HL
        DEC     B
        DEC     C
        JR      NZ,PFNAMEL
        JR      PFSKPN
PFNSTAR:
        LD      A,'?'
PFNSTLP:
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,PFNSTLP
PFSKPN:
        LD      A,B
        OR      A
        JR      Z,PFDONE
        LD      A,(HL)
        CP      ' '
        JR      Z,PFDONE
        INC     HL
        DEC     B
        CP      '.'
        JR      NZ,PFSKPN
        JR      PFEXT0
PFDOT:
        INC     HL
        DEC     B
PFEXT0:
        POP     DE
        PUSH    DE
        LD      A,E
        ADD     A,9
        LD      E,A
        LD      C,3
PFEXTL:
        LD      A,B
        OR      A
        JR      Z,PFDONE
        LD      A,(HL)
        CP      ' '
        JR      Z,PFDONE
        CP      '*'
        JR      Z,PFESTAR
        LD      (DE),A
        INC     DE
        INC     HL
        DEC     B
        DEC     C
        JR      NZ,PFEXTL
        JR      PFSKPE
PFESTAR:
        LD      A,'?'
PFESTLP:
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,PFESTLP
PFSKPE:
        LD      A,B
        OR      A
        JR      Z,PFDONE
        LD      A,(HL)
        CP      ' '
        JR      Z,PFDONE
        INC     HL
        DEC     B
        JR      PFSKPE
PFDONE:
        POP     DE
        RET

; Resident DIR deliberately uses only the public BDOS search interface.  This
; keeps the CCP independent of the directory implementation and exercises the
; same contract available to transient CP/M programs.
CCP_DIR:
        LD      HL,CCP_DIRFCB
        LD      B,36
        XOR     A
CCP_DCLR:
        LD      (HL),A
        INC     HL
        DJNZ    CCP_DCLR
        LD      HL,CCP_DIRFCB+1
        LD      B,11
        LD      A,'?'
CCP_DWILD:
        LD      (HL),A
        INC     HL
        DJNZ    CCP_DWILD
        LD      DE,0080H
        LD      C,26
        CALL    BDOS
        XOR     A
        LD      (CCP_DFOUND),A
        LD      C,17
CCP_DNEXT:
        LD      DE,CCP_DIRFCB
        CALL    BDOS
        CP      0FFH
        JR      Z,CCP_DDONE
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,080H
        LD      L,A
        LD      H,0
        LD      (CCP_DIREP),HL
        LD      DE,12
        ADD     HL,DE
        LD      A,(HL)
        AND     01FH
        JR      NZ,CCP_DMORE
        INC     HL
        INC     HL
        LD      A,(HL)
        AND     03FH
        JR      NZ,CCP_DMORE
        LD      A,1
        LD      (CCP_DFOUND),A
        LD      DE,CCP_DIRNL
        LD      C,9
        CALL    BDOS
        LD      HL,(CCP_DIREP)
        INC     HL
        LD      B,8
        CALL    CCP_DFIELD
        LD      HL,(CCP_DIREP)
        LD      DE,9
        ADD     HL,DE
        LD      A,(HL)
        CP      ' '
        JR      Z,CCP_DMORE
        LD      E,'.'
        LD      C,2
        CALL    BDOS
        LD      HL,(CCP_DIREP)
        LD      DE,9
        ADD     HL,DE
        LD      B,3
        CALL    CCP_DFIELD
CCP_DMORE:
        LD      C,18
        JR      CCP_DNEXT
CCP_DDONE:
        RET

CCP_DFIELD:
        LD      (CCP_DFPTR),HL
        LD      A,B
        LD      (CCP_DFCNT),A
CCP_DFLOOP:
        LD      HL,(CCP_DFPTR)
        LD      A,(HL)
        INC     HL
        LD      (CCP_DFPTR),HL
        AND     07FH
        CP      ' '
        JR      Z,CCP_DFSKIP
        LD      E,A
        LD      C,2
        CALL    BDOS
CCP_DFSKIP:
        LD      HL,CCP_DFCNT
        DEC     (HL)
        JR      NZ,CCP_DFLOOP
        RET

CCP_PROMPT:
        DB      13,10,'$'
CCP_UNKNOWN:
        DB      10,'?','$'
CCP_VERSION:
        DB      10,'BetterCP/M 0.1','$'
CCP_VERKEY:
        DB      'VER'
CCP_DIRKEY:
        DB      'DIR'
CCP_WARMKEY:
        DB      'WARM'
CU_KEY:
        DB      'USER '
CCP_COM:
        DB      'COM'

CCP_BUFFER:
        DB      127
CCP_COUNT:
        DB      0
CCP_DATA:
        REPT    127
        DB      0
        ENDM

CCP_FCB:
        REPT    36
        DB      0
        ENDM
CLDPTR:
        DW      0100H
CCP_NAMEL:
        DB      0
CCP_DIREP:
        DW      0080H
CCP_DFPTR:
        DW      0080H
CCP_DFCNT:
        DB      0
CCP_DFOUND:
        DB      0
CPX_CUR:
        DW      0
; Patch 2026-09-02: the first resident DIR used LF alone. The Model 4 console
; correctly preserves the horizontal cursor position on LF, which made each
; successive filename march diagonally across the screen. CP/M text output
; needs an explicit carriage return before line feed.
CCP_DIRNL:
        DB      13,10,'$'
CCP_DIRFCB:
        REPT    36
        DB      0
        ENDM
CCP_RET:
        DW      0000H

; Patch 2026-09-02: wildcard completion needed the final bytes below ED00h.
; The private stack does not need to travel with CCP code; reserve the top of
; the otherwise unused BDOS growth gap immediately below Directory Services.
CCP_STACK       EQU     0D5F0H
CCP_STKTOP      EQU     0D600H

        .DEPHASE
        END
