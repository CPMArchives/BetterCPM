        INCLUDE layout.inc

; ************************************************************************
; *               BetterCP/M initial command processor
; *               ------------------------------------
; *
; *
;   - The original EA40H placement left too little room for resident commands.
;   - Patch 2026-09-01: move the CCP into the unused E940H..ECFFH region so DIR
;     can remain resident without taking space from transient programs.
;   - Patch 2026-09-02: USER exhausted that exact-fit region.  Move the base down
;     into the verified gap after Directory Services; ED00H remains untouched.
;   - Patch 2026-09-02: public SECTRAN calls grew Directory Services through
;     E8C0H. Advance the CCP by 16 bytes, retaining a guard before E8D0H.
;   - Patch 2026-09-02: live-DPB refresh extended Directory Services through
;     E8D5H. Advance another 16 bytes, preserving a ten-byte guard.
;   - Patch 2026-09-02: CPX support ended the exact-fit provisional placement at
;     E8D6H and temporarily protected B000H..BFFFH.  Specification 96 introduces
;     the quantitative memory model: the no-extension CCP is page-rounded and
;     originally ended below C000H. BB00H is now only the link origin; WBOOT
;     relocates this image beneath CPXs and the live compatibility gateway.

CCPBASE         EQU     0BB00H
BDOS            EQU     LY_BDOS
CPXHEAD         EQU     LY_SYS+086H     ; active head in fixed extension descriptor
TPATOP          EQU     LY_SYS+090H     ; exclusive upper bound for transient loads
HISTBASE        EQU     LY_HIST         ; protected warm-boot-persistent history
CCP_HPOS        EQU     HISTBASE+6
CCP_HTMP        EQU     HISTBASE+7
CCP_HSKIP       EQU     HISTBASE+8
CCP_EDOLD       EQU     HISTBASE+9
HISTDATA        EQU     HISTBASE+10
HISTCAP         EQU     LY_SYS-LY_HIST-10

        CSEG
        .PHASE  CCPBASE

; ================================================================================
; =                     CCP Initialization and Command Loop                      =
; =                                                                              =
; = Initializes the command processor, displays the prompt, acquires commands,   =
; = and drives the top-level resident, extension, and transient dispatch path.   =
; ================================================================================
; -------------------------------------------------------------------------------
; Initialization
; -------------------------------------------------------------------------------

CCP_ENTRY:                              ; initialize CCP stack
        LD      HL,(LY_SYS+08CH)
        LD      DE,CCP_STKTOP-CCPBASE
        ADD     HL,DE
        LD      SP,HL

; -------------------------------------------------------------------------------
; Main Command Loop
; -------------------------------------------------------------------------------

CCP_LOOP:                               ; prompt for and dispatch next command
        LD      DE,CCP_PROMPT
        LD      C,9
        CALL    BDOS
        CALL    CCP_DUPROMPT
        LD      E,'>'
        LD      C,2
        CALL    BDOS
        CALL    CCP_READLN
        LD      A,(CCP_COUNT)
        OR      A
        JR      Z,CCP_LOOP
        CALL    CCP_UPPER
        JR      Z,CCP_LOOP              ; SPACE-only input is an empty command

  ; Patch 2026-09-02: direct drive/user navigation is command-processor syntax,
  ; not a resident command.  Keep BDOS as the sole owner of both values so the
  ; prompt, FCB operations, transient programs, and warm-start reconstruction
  ; all observe one coherent state.  Accepted forms are B:, 5:, and C3:.

        CALL    CCP_NAVIGATE
        JR      C,CCP_LOOP

  ; The little monitor commands must be present even on a bare system disk.
  ; Try them before the extension chain so a CPX cannot accidentally replace
  ; GET, JUMP, PEEK, POKE, GO, or SAVE with a namesake of its own.

        CALL    CCP_CORE
        JR      C,CCP_LOOP

  ; Ordinary commands belong to the RCP and other command extensions.

        CALL    CPX_DISPATCH
        JR      C,CCP_LOOP
        LD      A,(CCP_COUNT)
        CP      6
        JP      Z,CCP_TRYUSER
        CP      7
        JP      Z,CCP_TRYUSER
        CP      3
        JP      Z,CCP_TRYVER
        CP      4
        JP      Z,CCP_TRYWARM

CCP_BAD:                                ; fall through to transient command load
        CALL    CCP_LOAD
        JR      NC,CCP_LOOP             ; successful program exits only via warm start
        CALL    CS_CANCEL               ; a bad submitted command aborts the whole stream
        LD      DE,CCP_UNKNOWN
        LD      C,9
        CALL    BDOS
        JP      CCP_LOOP

  ; Display the live default drive/user pair.  User numbers are deliberately
  ; unpadded: A0>, A5>, A31>.  The following command-line colon belongs to the
  ; navigation syntax, not to the prompt itself.

; -------------------------------------------------------------------------------
; Prompt Display
; -------------------------------------------------------------------------------

CCP_DUPROMPT:                           ; print current drive and user
        LD      C,25
        CALL    BDOS
        ADD     A,'A'
        LD      E,A
        LD      C,2
        CALL    BDOS
        LD      E,0FFH
        LD      C,32
        CALL    BDOS
        CP      10
        JR      C,CCP_DUPONE
        LD      B,0

CCP_DUPTEN:                             ; convert user-number tens digit
        SUB     10
        INC     B
        CP      10
        JR      NC,CCP_DUPTEN
        PUSH    AF
        LD      A,B
        ADD     A,'0'
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     AF

CCP_DUPONE:                             ; print user-number units digit
        ADD     A,'0'
        LD      E,A
        LD      C,2
        JP      BDOS

  ; Enhanced CCP-only command-line editor.  BDOS Function 10 deliberately keeps
  ; its CP/M 2.2 contract for transient software; the command processor uses
  ; direct console input so cursor motion and insert/overwrite policy do not
  ; leak into the compatibility interface.

; ================================================================================
; =                  Command Acquisition and SUBMIT Processing                   =
; =                                                                              =
; = Selects interactive or submitted command input and manages the CP/M          =
; = A:$$$.SUB command stream without changing the transient BDOS interface.      =
; ================================================================================
; -------------------------------------------------------------------------------
; Input Selection
; -------------------------------------------------------------------------------

CCP_READLN:                             ; acquire next command line

  ; CP/M 2.2 SUBMIT is a command-acquisition path, not a resident command.
  ; Prefer one protected-disk stack record before entering the interactive editor.

        XOR     A
        LD      (CCP_SUBACTIVE),A
        JR      CS_READ

CR_INTER:                               ; initialize interactive editor
        CALL    CCP_HINIT
        XOR     A
        LD      (CCP_COUNT),A
        LD      (CCP_EDCUR),A
        LD      (CCP_HPOS),A
        LD      (CCP_EDOLD),A
        INC     A                       ; each new line starts in insert mode
        LD      (CCP_EDINS),A
        JP      CCP_EDDRAW              ; publish the initial visible cursor

  ; Read the last remaining A:$$$.SUB record, publish its decremented RC, and
  ; echo it as though typed.  Nothing here must survive a transient: the file is
  ; the stock persistent queue and WBOOT reconstructs this CCP before each read.

; -------------------------------------------------------------------------------
; SUBMIT Record Processing
; -------------------------------------------------------------------------------

CS_READ:                                ; read next SUBMIT record
        CALL    CS_PREP
        LD      DE,0080H
        LD      C,26
        CALL    BDOS
        LD      DE,LY_FCB
        LD      C,15
        CALL    BDOS
        INC     A
        JR      NZ,CS_OPEN
        LD      DE,0080H
        LD      C,26
        CALL    BDOS
        JR      CR_INTER

CS_OPEN:                                ; process open SUBMIT stream
        LD      A,(LY_FCB+15)
        OR      A
        JR      Z,CS_DROP
        DEC     A
        LD      (LY_FCB+32),A
        LD      DE,LY_FCB
        LD      C,20
        CALL    BDOS
        OR      A
        JR      Z,CS_DATA

CS_DROP:                                ; delete exhausted or invalid SUBMIT stream
        LD      DE,LY_FCB
        LD      C,19
        CALL    BDOS
        LD      DE,0080H
        LD      C,26
        CALL    BDOS
        XOR     A
        LD      (CCP_COUNT),A
        SCF
        RET

CS_DATA:                                ; accept SUBMIT record data
        LD      A,(0080H)
        CP      126                     ; stock SUBMIT never emits more than 125 bytes
        JR      NC,CS_DROP
        LD      C,A
        LD      B,0
        LD      HL,0081H
        LD      DE,CCP_DATA
        LDIR
        XOR     A
        LD      (LY_FCB+14),A           ; mark RC/S2 state dirty for BetterCP/M Close
        LD      A,(LY_FCB+15)
        DEC     A
        LD      (LY_FCB+15),A
        LD      C,16
        OR      A
        JR      NZ,CS_FILE
        LD      C,19

CS_FILE:                                ; close or delete updated SUBMIT stream
        LD      DE,LY_FCB
        CALL    BDOS
        INC     A
        JR      Z,CS_DROP
        LD      DE,0080H
        LD      C,26
        CALL    BDOS
        LD      A,1
        LD      (CCP_SUBACTIVE),A
        LD      A,(0080H)
        LD      B,A
        LD      HL,0081H

CS_ECHO:                                ; echo submitted command
        LD      A,B
        OR      A
        JR      Z,CS_CR
        PUSH    BC
        PUSH    HL
        LD      E,(HL)
        LD      C,2
        CALL    BDOS
        POP     HL
        POP     BC
        INC     HL
        DJNZ    CS_ECHO

CS_CR:                                  ; terminate submitted command echo
        LD      E,13
        LD      C,2
        CALL    BDOS
        LD      E,10
        LD      C,2
        CALL    BDOS

  ; DRI CCP treats any pending console byte as cancellation after echoing a
  ; submitted command.  Delete the unread tail before consuming the byte, so a
  ; Ctrl-C warm start cannot resurrect the command stream.

        LD      C,11
        CALL    BDOS
        OR      A
        JR      Z,CS_OK
        LD      DE,LY_FCB               ; the consumed stream FCB still names $$$.SUB
        LD      C,19
        CALL    BDOS
        XOR     A
        LD      (CCP_SUBACTIVE),A
        LD      E,0FFH
        LD      C,6
        CALL    BDOS
        XOR     A
        LD      (0080H),A

CS_OK:                                  ; publish submitted command
        LD      A,(0080H)
        LD      (CCP_COUNT),A
        SCF
        RET

; -------------------------------------------------------------------------------
; SUBMIT Setup and Cancellation
; -------------------------------------------------------------------------------

CS_PREP:                                ; build A:$$$.SUB FCB
        LD      HL,LY_FCB
        LD      B,36
        XOR     A

CS_ZERO:                                ; clear SUBMIT FCB
        LD      (HL),A
        INC     HL
        DJNZ    CS_ZERO
        LD      A,1                     ; only A:$$$.SUB is an active stock stream
        LD      (LY_FCB),A
        LD      HL,02424H               ; '$$'
        LD      (LY_FCB+1),HL
        LD      HL,02024H               ; '$ '
        LD      (LY_FCB+3),HL
        LD      HL,02020H
        LD      (LY_FCB+5),HL
        LD      (LY_FCB+7),HL
        LD      HL,05553H               ; 'SU'
        LD      (LY_FCB+9),HL
        LD      A,'B'
        LD      (LY_FCB+11),A
        RET

CS_CANCEL:                              ; cancel active SUBMIT stream
        LD      A,(CCP_SUBACTIVE)
        OR      A
        RET     Z
        CALL    CS_PREP
        LD      DE,LY_FCB
        LD      C,19
        CALL    BDOS
        XOR     A
        LD      (CCP_SUBACTIVE),A
        RET

; ================================================================================
; =                       Interactive Command-Line Editor                        =
; =                                                                              =
; = Provides CCP-local line editing, cursor motion, insertion, deletion,         =
; = history navigation, and display redraw for interactive command input.        =
; ================================================================================
; -------------------------------------------------------------------------------
; Key Dispatch
; -------------------------------------------------------------------------------

CCP_EDGET:                              ; read and decode editor keystroke
        LD      E,0FFH
        LD      C,6
        CALL    BDOS
        OR      A
        JR      Z,CCP_EDGET
        AND     07FH
        CP      13
        JP      Z,CCP_EDFIN
        CP      3                       ; ^C: CP/M warm boot
        JR      Z,CCP_EDWBOOT
        CP      19                      ; ^S / physical Left: character left
        JP      Z,CCP_EDLEFT
        CP      28
        JP      Z,CCP_EDLEFT
        CP      4                       ; ^D / physical Right: character right
        JP      Z,CCP_EDRIGHT
        CP      29
        JP      Z,CCP_EDRIGHT
        CP      1                       ; ^A: word left
        JP      Z,CCP_EDWLEFT
        CP      6                       ; ^F: word right
        JP      Z,CCP_EDWRIGHT
        CP      20                      ; ^T: delete through next word
        JP      Z,CCP_EDDWORD
        CP      5                       ; ^E: physical new line, retain command
        JR      Z,CCP_EDNEW
        CP      11                      ; physical Up remains an alias
        JP      Z,CCP_EDUP
        CP      10                      ; physical Down remains an alias
        JP      Z,CCP_EDDOWN
        CP      16                      ; ^P: toggle cooked-console printer echo
        JR      Z,CCP_EDPRINT
        CP      21                      ; ^U: discard the current instruction queue
        JR      Z,CCP_EDCLEAR
        CP      24                      ; ^X: alternate CP/M line discard
        JR      Z,CCP_EDCLEAR
        CP      22                      ; ^V: Insert/overwrite toggle
        JP      Z,CCP_EDTOG
        CP      31                      ; Model 4 CLEAR remains an alias
        JP      Z,CCP_EDTOG
        CP      7                       ; ^G: delete character under cursor
        JP      Z,CCP_EDDEL
        CP      8                       ; ^H: delete character left of cursor
        JP      Z,CCP_EDBS
        CP      127                     ; Shift-Left / DEL
        JP      Z,CCP_EDBS
        CP      32
        JR      C,CCP_EDGET
        CP      127
        JR      NC,CCP_EDGET
        JR      CCP_EDGRAPH

  ; Keep compatibility-control handlers beside the input decoder. Besides
  ; making the policy legible, relative dispatch avoids exhausting the compact
  ; one-sector relocation directory as the reloadable CCP grows.

CCP_EDWBOOT:                            ; handle command-line warm boot

  ; Patch 2026-09-03: CP/M visibly acknowledges a command-line warm boot.
  ; Preserve that useful feedback instead of silently replacing one prompt with
  ; another: echo ^C and terminate the abandoned instruction line before the
  ; normal Function 0 path resets disk state and reconstructs the environment.

        LD      E,'^'
        LD      C,2
        CALL    BDOS
        LD      E,'C'
        LD      C,2
        CALL    BDOS
        LD      E,13
        LD      C,2
        CALL    BDOS
        LD      E,10
        LD      C,2
        CALL    BDOS
        LD      C,0
        JP      BDOS

CCP_EDNEW:                              ; start physical continuation line
        LD      E,13
        LD      C,2
        CALL    BDOS
        LD      E,10
        LD      C,2
        CALL    BDOS
        XOR     A
        LD      (CCP_EDOLD),A
        JP      CCP_EDDRAW

CCP_EDPRINT:                            ; toggle printer echo
        LD      C,179                   ; private command-environment console control
        CALL    BDOS
        JP      CCP_EDGET

CCP_EDCLEAR:                            ; discard current command line
        JP      CCP_HCLEAR

; -------------------------------------------------------------------------------
; Character Insertion and Overwrite
; -------------------------------------------------------------------------------

CCP_EDGRAPH:                            ; insert or overwrite graphic character
        LD      (CCP_EDCHR),A
        LD      A,(CCP_COUNT)
        CP      127
        JP      Z,CCP_EDGET
        LD      B,A
        LD      A,(CCP_EDCUR)
        LD      HL,CCP_COUNT
        CP      (HL)
        JR      Z,CCP_EDAPP
        LD      A,(CCP_EDINS)
        OR      A
        JR      Z,CCP_EDOVER
  ; Insert before the cursor by moving the tail one byte to the right.
        LD      A,(CCP_COUNT)
        LD      C,A
        LD      A,(CCP_EDCUR)
        LD      E,A
        LD      A,C
        SUB     E
        LD      C,A
        LD      B,0
        LD      HL,CCP_DATA
        LD      A,(CCP_COUNT)
        LD      E,A
        LD      D,0
        ADD     HL,DE
        DEC     HL
        LD      D,H
        LD      E,L
        INC     DE
        LDDR
        LD      HL,CCP_DATA             ; LDDR finishes before the insertion point
        LD      A,(CCP_EDCUR)
        LD      E,A
        LD      D,0
        ADD     HL,DE
        JR      CCP_EDPUT

CCP_EDOVER:                             ; overwrite character at cursor
        LD      HL,CCP_DATA
        LD      A,(CCP_EDCUR)
        LD      E,A
        LD      D,0
        ADD     HL,DE
        LD      A,(CCP_EDCHR)
        LD      (HL),A
        LD      HL,CCP_EDCUR
        INC     (HL)
        JP      CCP_EDDRAW

CCP_EDAPP:                              ; append character at end of line
        LD      HL,CCP_DATA
        LD      A,(CCP_COUNT)
        LD      E,A
        LD      D,0
        ADD     HL,DE

CCP_EDPUT:                              ; store edited character
        LD      A,(CCP_EDCHR)
        LD      (HL),A
        LD      HL,CCP_COUNT
        INC     (HL)
        LD      HL,CCP_EDCUR
        INC     (HL)
        JP      CCP_EDDRAW

; -------------------------------------------------------------------------------
; Cursor Movement
; -------------------------------------------------------------------------------

CCP_EDLEFT:                             ; move cursor one character left
        LD      A,(CCP_EDCUR)
        OR      A
        JP      Z,CCP_EDGET
        DEC     A
        LD      (CCP_EDCUR),A
        JP      CCP_EDDRAW

CCP_EDRIGHT:                            ; move cursor one character right
        LD      A,(CCP_EDCUR)
        LD      B,A
        LD      A,(CCP_COUNT)
        LD      HL,CCP_EDCUR
        CP      (HL)
        JP      Z,CCP_EDGET
        INC     B
        LD      A,B
        LD      (CCP_EDCUR),A
        JP      CCP_EDDRAW

CCP_EDWLEFT:                            ; move cursor one word left
        LD      A,(CCP_EDCUR)
        OR      A
        JP      Z,CCP_EDGET
        LD      E,A
        LD      D,0

CCP_WLSpace:                            ; scan left across spaces
        DEC     E
        LD      HL,CCP_DATA
        ADD     HL,DE
        LD      A,(HL)
        CP      ' '
        JR      NZ,CCP_WLWORD
        LD      A,E
        OR      A
        JR      NZ,CCP_WLSpace
        JR      CCP_WLDONE

CCP_WLWORD:                             ; scan left across word
        LD      A,E
        OR      A
        JR      Z,CCP_WLDONE
        DEC     E
        LD      HL,CCP_DATA
        ADD     HL,DE
        LD      A,(HL)
        CP      ' '
        JR      NZ,CCP_WLWORD
        INC     E

CCP_WLDONE:                             ; finish word-left motion
        LD      A,E
        LD      (CCP_EDCUR),A
        JP      CCP_EDDRAW

CCP_EDWRIGHT:                           ; move cursor one word right
        LD      A,(CCP_EDCUR)
        LD      E,A
        LD      A,(CCP_COUNT)
        CP      E
        JP      Z,CCP_EDGET

CCP_WRWORD:                             ; scan right across word
        LD      D,0
        LD      HL,CCP_DATA
        ADD     HL,DE
        LD      A,(HL)
        CP      ' '
        JR      Z,CCP_WRSPACE
        INC     E
        LD      A,(CCP_COUNT)
        CP      E
        JR      NZ,CCP_WRWORD
        JR      CCP_WRDONE

CCP_WRSPACE:                            ; scan right across spaces
        INC     E
        LD      A,(CCP_COUNT)
        CP      E
        JR      Z,CCP_WRDONE
        LD      D,0
        LD      HL,CCP_DATA
        ADD     HL,DE
        LD      A,(HL)
        CP      ' '
        JR      Z,CCP_WRSPACE

CCP_WRDONE:                             ; finish word-right motion
        LD      A,E
        LD      (CCP_EDCUR),A
        JP      CCP_EDDRAW

CCP_EDTOG:                              ; toggle insert/overwrite mode
        LD      A,(CCP_EDINS)
        XOR     1
        LD      (CCP_EDINS),A
        JP      CCP_EDGET

; -------------------------------------------------------------------------------
; Character and Word Deletion
; -------------------------------------------------------------------------------

CCP_EDDEL:                              ; delete character at cursor
        LD      A,(CCP_EDCUR)
        LD      HL,CCP_COUNT
        CP      (HL)
        JP      Z,CCP_EDGET
        LD      E,A
        LD      D,0
        LD      HL,CCP_DATA
        ADD     HL,DE
        LD      D,H
        LD      E,L
        INC     HL
        LD      A,(CCP_COUNT)
        LD      C,A
        LD      A,(CCP_EDCUR)
        CPL
        INC     A
        ADD     A,C
        DEC     A
        JR      Z,CCP_DELDONE
        LD      C,A
        LD      B,0
        LDIR

CCP_DELDONE:                            ; finish character deletion
        LD      HL,CCP_COUNT
        DEC     (HL)
        JP      CCP_EDDRAW

CCP_EDDWORD:                            ; delete through next word
        LD      A,(CCP_EDCUR)
        LD      E,A
        LD      A,(CCP_COUNT)
        CP      E
        JP      Z,CCP_EDGET             ; skip leading spaces, the next word, and trailing spaces

CCP_DWLEAD:                             ; skip leading spaces for word delete
        LD      D,0
        LD      HL,CCP_DATA
        ADD     HL,DE
        LD      A,(HL)
        CP      ' '
        JR      NZ,CCP_DWWORD
        INC     E
        LD      A,(CCP_COUNT)
        CP      E
        JR      NZ,CCP_DWLEAD
        JR      CCP_DWMOVE

CCP_DWWORD:                             ; scan word for deletion
        INC     E
        LD      A,(CCP_COUNT)
        CP      E
        JR      Z,CCP_DWMOVE
        LD      D,0
        LD      HL,CCP_DATA
        ADD     HL,DE
        LD      A,(HL)
        CP      ' '
        JR      NZ,CCP_DWWORD

CCP_DWTAIL:                             ; skip trailing spaces for word delete
        INC     E
        LD      A,(CCP_COUNT)
        CP      E
        JR      Z,CCP_DWMOVE
        LD      D,0
        LD      HL,CCP_DATA
        ADD     HL,DE
        LD      A,(HL)
        CP      ' '
        JR      Z,CCP_DWTAIL

CCP_DWMOVE:                             ; compact line after word delete
        LD      A,E
        LD      (CCP_HTMP),A            ; end of deleted range
        LD      A,(CCP_EDCUR)
        LD      C,A
        LD      A,(CCP_HTMP)
        SUB     C
        LD      (CCP_HSKIP),A           ; number of bytes removed
        LD      A,(CCP_COUNT)
        SUB     E
        LD      C,A
        LD      B,0
        LD      D,0
        LD      HL,CCP_DATA
        ADD     HL,DE                   ; source = data + end
        LD      A,(CCP_EDCUR)
        LD      E,A
        LD      D,0
        PUSH    HL
        LD      HL,CCP_DATA
        ADD     HL,DE
        EX      DE,HL                   ; destination
        POP     HL
        LD      A,B
        OR      C
        JR      Z,CCP_DWNOCOPY
        LDIR

CCP_DWNOCOPY:                           ; finish word deletion without copy
        LD      A,(CCP_COUNT)
        LD      HL,CCP_HSKIP
        SUB     (HL)
        LD      (CCP_COUNT),A
        JP      CCP_EDDRAW

CCP_EDBS:                               ; delete character left of cursor
        LD      A,(CCP_EDCUR)
        OR      A
        JP      Z,CCP_EDGET
        DEC     A
        LD      (CCP_EDCUR),A
        LD      E,A
        LD      D,0
        LD      HL,CCP_DATA
        ADD     HL,DE
        LD      D,H
        LD      E,L
        INC     HL                      ; HL source, DE destination
        LD      A,(CCP_COUNT)
        LD      C,A
        LD      A,(CCP_EDCUR)
        CPL
        INC     A
        ADD     A,C                     ; old count - new cursor - 1
        DEC     A
        JR      Z,CCP_BSEND             ; LDIR with BC=0 would copy 65536 bytes
        LD      C,A
        LD      B,0
        LDIR

CCP_BSEND:                              ; finish backspace deletion
        LD      HL,CCP_COUNT
        DEC     (HL)
        JR      CCP_EDDRAW

; -------------------------------------------------------------------------------
; History Navigation
; -------------------------------------------------------------------------------

CCP_EDUP:                               ; recall previous history entry
        CALL    CCP_HINIT
        LD      A,(HISTBASE+3)
        LD      HL,CCP_HPOS
        CP      (HL)
        JP      Z,CCP_EDGET
        INC     (HL)
        SUB     (HL)                    ; zero-based oldest-to-newest record index
        CALL    CCP_HGET
        JP      CCP_EDDRAW

CCP_EDDOWN:                             ; recall next history entry
        LD      A,(CCP_HPOS)
        OR      A
        JP      Z,CCP_EDGET
        DEC     A
        LD      (CCP_HPOS),A
        JR      Z,CCP_HCLEAR
        LD      B,A
        LD      A,(HISTBASE+3)
        SUB     B
        CALL    CCP_HGET
        JP      CCP_EDDRAW

CCP_HCLEAR:                             ; restore live line after history
        XOR     A
        LD      (CCP_COUNT),A
        LD      (CCP_EDCUR),A
        LD      (CCP_HPOS),A
        JP      CCP_EDDRAW

  ; Redraw the whole logical line with the character under the cursor in the
  ; platform cursor presentation. Unsupported platforms get an inserted visible
  ; underscore. Erase one stale trailing cell, return to the left margin, then
  ; print only through the logical cursor; no terminal escapes are required.

; -------------------------------------------------------------------------------
; Display and Redraw
; -------------------------------------------------------------------------------

CCP_EDDRAW:                             ; redraw edited command line
        LD      E,13
        LD      C,2
        CALL    BDOS
        CALL    CCP_DUPROMPT
        LD      E,'>'
        LD      C,2
        CALL    BDOS
        LD      A,(CCP_EDCUR)
        LD      B,A
        LD      HL,CCP_DATA
        CALL    CCP_EDTEXT
        CALL    CCP_CSHOW

  ; Console services do not preserve HL. Reconstruct the tail pointer explicitly.
  ; A is one only when reverse video consumed the character under the cursor;
  ; an end-of-line cursor and the underscore fallback consume no command byte.

        LD      C,A
        LD      HL,CCP_DATA
        LD      A,(CCP_EDCUR)
        ADD     A,C
        LD      E,A
        LD      D,0
        ADD     HL,DE
        LD      A,(CCP_COUNT)
        PUSH    HL
        LD      HL,CCP_EDCUR
        SUB     (HL)
        LD      B,A
        LD      A,C
        OR      A
        LD      A,B
        JR      Z,CCP_CSLEN
        DEC     A

CCP_CSLEN:                              ; measure visible command length
        LD      B,A
        POP     HL
        CALL    CCP_EDTEXT

  ; Clear every cell retained from a previously longer rendering, plus one guard
  ; cell. The former single-space cleanup left recalled text visible when ^X
  ; returned from history to the empty live command line.

        LD      A,(CCP_EDOLD)
        LD      B,A
        LD      A,(CCP_COUNT)
        LD      (CCP_EDOLD),A
        LD      C,A
        LD      A,B
        SUB     C
        JR      NC,CCP_CLCNT
        XOR     A

CCP_CLCNT:                              ; clear stale display cells
        INC     A
        LD      B,A

CCP_CLLOOP:                             ; clear one stale display cell
        PUSH    BC
        LD      E,' '
        LD      C,2
        CALL    BDOS
        POP     BC
        DJNZ    CCP_CLLOOP
        LD      E,13
        LD      C,2
        CALL    BDOS
        CALL    CCP_DUPROMPT
        LD      E,'>'
        LD      C,2
        CALL    BDOS
        LD      A,(CCP_EDCUR)
        LD      B,A
        LD      HL,CCP_DATA
        CALL    CCP_EDTEXT
        JP      CCP_EDGET

CCP_CSHOW:                              ; render command line and cursor
        LD      E,0
        LD      C,178
        CALL    BDOS
        OR      A
        JR      Z,CCP_CSFALL
        LD      A,(CCP_EDCUR)
        LD      HL,CCP_COUNT
        CP      (HL)
        JR      NC,CCP_CSEND
        LD      E,A
        LD      D,0
        LD      HL,CCP_DATA
        ADD     HL,DE
        LD      E,(HL)
        LD      C,178
        CALL    BDOS
        LD      A,1                     ; cursor output consumed this command byte
        RET

CCP_CSEND:                              ; finish cursor rendering
        LD      E,' '                   ; reverse blank is the end-of-line cursor
        LD      C,178
        CALL    BDOS
        XOR     A
        RET

CCP_CSFALL:                             ; render fallback visible cursor
        LD      E,'_'
        LD      C,2
        CALL    BDOS
        XOR     A
        RET

CCP_EDTEXT:                             ; print text through logical cursor
        LD      A,B
        OR      A
        RET     Z

CCP_EDTXLP:                             ; print one edited-line character
        PUSH    BC
        PUSH    HL
        LD      E,(HL)
        LD      C,2
        CALL    BDOS
        POP     HL
        POP     BC
        INC     HL
        DJNZ    CCP_EDTXLP
        RET

; -------------------------------------------------------------------------------
; Line Completion
; -------------------------------------------------------------------------------

CCP_EDFIN:                              ; finish command-line editing

  ; Remove the visual cursor before command execution, then preserve CP/M's
  ; final-carriage-return presentation.

        LD      E,13
        LD      C,2
        CALL    BDOS
        CALL    CCP_DUPROMPT
        LD      E,'>'
        LD      C,2
        CALL    BDOS
        LD      A,(CCP_COUNT)
        LD      B,A
        LD      HL,CCP_DATA
        CALL    CCP_EDTEXT
        LD      E,' '
        LD      C,2
        CALL    BDOS
        LD      E,13
        LD      C,2
        CALL    BDOS
        LD      A,(CCP_COUNT)
        OR      A
        RET     Z
        JP      CCP_HADD

  ; Persistent packed command history. The protected history region contains a
  ; nine-byte control header followed by length-prefixed complete command lines. New
  ; records evict the oldest whole records only when space is required.

; ================================================================================
; =                          Persistent Command History                          =
; =                                                                              =
; = Maintains the warm-boot-persistent packed command history, including         =
; = validation, retrieval, eviction, and insertion of command records.           =
; ================================================================================
; -------------------------------------------------------------------------------
; History Initialization
; -------------------------------------------------------------------------------

CCP_HINIT:                              ; validate persistent history header
        LD      A,(HISTBASE)
        CP      'B'
        JR      NZ,CCP_HRESET
        LD      A,(HISTBASE+1)
        CP      'H'
        JR      NZ,CCP_HRESET
        LD      A,(HISTBASE+2)
        CP      1
        RET     Z

CCP_HRESET:                             ; reset persistent history
        LD      HL,HISTBASE
        LD      (HL),'B'
        INC     HL
        LD      (HL),'H'
        INC     HL
        LD      (HL),1
        INC     HL
        XOR     A
        LD      (HL),A                  ; record count
        INC     HL
        LD      (HL),A                  ; used byte count, little endian
        INC     HL
        LD      (HL),A
        RET

  ; A selects a zero-based record from oldest to newest. Copy the complete line
  ; into the reloadable CCP edit buffer and place the logical cursor at its end.

; -------------------------------------------------------------------------------
; History Retrieval
; -------------------------------------------------------------------------------

CCP_HGET:                               ; fetch selected history entry
        LD      B,A
        LD      HL,HISTDATA

CCP_HGLOOP:                             ; scan packed history records
        LD      A,B
        OR      A
        JR      Z,CCP_HGFOUND
        LD      E,(HL)
        LD      D,0
        INC     DE
        ADD     HL,DE
        DJNZ    CCP_HGLOOP

CCP_HGFOUND:                            ; copy selected history record
        LD      A,(HL)
        LD      (CCP_COUNT),A
        LD      (CCP_EDCUR),A
        LD      C,A
        LD      B,0
        INC     HL
        LD      DE,CCP_DATA
        LDIR
        RET

; -------------------------------------------------------------------------------
; History Insertion and Space Management
; -------------------------------------------------------------------------------

CCP_HADD:                               ; append command to history
        CALL    CCP_HINIT
        LD      A,(CCP_COUNT)
        INC     A
        LD      (CCP_HTMP),A            ; required length byte plus command data

CCP_HROOM:                              ; make room for history record
        LD      HL,(HISTBASE+4)
        LD      A,(CCP_HTMP)
        LD      E,A
        LD      D,0
        ADD     HL,DE
        LD      DE,HISTCAP+1
        OR      A
        SBC     HL,DE
        JR      C,CCP_HAPPEND
  ; Evict the oldest record and compact the packed region toward HISTDATA.
        LD      A,(HISTDATA)
        INC     A
        LD      (CCP_HSKIP),A
        LD      E,A
        LD      D,0
        LD      HL,(HISTBASE+4)
        OR      A
        SBC     HL,DE
        LD      (HISTBASE+4),HL
        LD      B,H
        LD      C,L
        LD      HL,HISTDATA
        ADD     HL,DE
        LD      DE,HISTDATA
        LD      A,B
        OR      C
        JR      Z,CCP_HEMPTY
        LDIR

CCP_HEMPTY:                             ; reset empty history area
        LD      HL,HISTBASE+3
        DEC     (HL)
        JR      CCP_HROOM

CCP_HAPPEND:                            ; append packed history record
        LD      HL,HISTDATA
        LD      DE,(HISTBASE+4)
        ADD     HL,DE
        LD      A,(CCP_COUNT)
        LD      (HL),A
        INC     HL
        EX      DE,HL
        LD      HL,CCP_DATA
        LD      C,A
        LD      B,0
        LDIR
        LD      HL,(HISTBASE+4)
        LD      A,(CCP_HTMP)
        LD      E,A
        LD      D,0
        ADD     HL,DE
        LD      (HISTBASE+4),HL
        LD      HL,HISTBASE+3
        INC     (HL)
        XOR     A
        LD      (CCP_HPOS),A
        RET

  ; Carry set means that the complete input line was navigation syntax, whether
  ; the requested physical drive exists or not.  This prevents a failed B: from
  ; falling through into a search for the impossible transient "B:.COM".

; ================================================================================
; =                     CCP Command Recognition and Dispatch                     =
; =                                                                              =
; = Recognizes CCP syntax and built-in commands before command extensions        =
; = or transient-program loading are attempted.                                  =
; ================================================================================
; -------------------------------------------------------------------------------
; Drive/User Navigation
; -------------------------------------------------------------------------------

CCP_NAVIGATE:                           ; recognize direct drive/user navigation
        LD      A,(CCP_COUNT)
        CP      2
        JR      C,CCP_NAVNO
        CP      5
        JR      NC,CCP_NAVNO
        LD      B,A
        LD      HL,CCP_DATA
        LD      E,0FFH                  ; FFh means retain current drive
        LD      D,0FFH                  ; FFh means retain current user
        LD      A,(HL)
        CP      'A'
        JR      C,CCP_NAVUSER
        CP      'P'+1
        JR      NC,CCP_NAVNO
        SUB     'A'
        LD      E,A
        INC     HL
        DEC     B
        LD      A,B
        CP      1
        JR      Z,CCP_NAVCOLON          ; drive-only form

CCP_NAVUSER:                            ; parse user-only navigation
        LD      A,B
        CP      2
        JR      Z,CCP_NVONE
        CP      3
        JR      NZ,CCP_NAVNO
        LD      A,(HL)
        SUB     '0'
        JR      C,CCP_NAVNO
        CP      4                       ; tens digit may only be 0..3
        JR      NC,CCP_NAVNO
        LD      C,A
        ADD     A,A
        LD      D,A
        ADD     A,A
        ADD     A,A
        ADD     A,D                     ; ten times first digit
        LD      D,A
        INC     HL
        LD      A,(HL)
        SUB     '0'
        JR      C,CCP_NAVNO
        CP      10
        JR      NC,CCP_NAVNO
        ADD     A,D
        CP      32
        JR      NC,CCP_NAVNO
        LD      D,A
        INC     HL
        JR      CCP_NAVCOLON

CCP_NVONE:                              ; finish one-digit user parse
        LD      A,(HL)
        SUB     '0'
        JR      C,CCP_NAVNO
        CP      10
        JR      NC,CCP_NAVNO
        LD      D,A
        INC     HL

CCP_NAVCOLON:                           ; require navigation colon
        LD      A,(HL)
        CP      ':'
        JR      NZ,CCP_NAVNO
        LD      A,E
        CP      0FFH
        JR      Z,CCP_NAVSETU
        PUSH    DE
        LD      C,14
        CALL    BDOS
        POP     DE
        CP      0FFH
        JR      Z,CCP_NAVDONE

CCP_NAVSETU:                            ; set requested user number
        LD      A,D
        CP      0FFH
        JR      Z,CCP_NAVDONE
        LD      E,A
        LD      C,32
        CALL    BDOS

CCP_NAVDONE:                            ; report navigation handled
        SCF
        RET

CCP_NAVNO:                              ; report non-navigation command
        OR      A
        RET

; -------------------------------------------------------------------------------
; Built-In Command Recognition
; -------------------------------------------------------------------------------

CCP_TRYVER:                             ; recognize VERSION command
        LD      HL,CCP_DATA
        LD      DE,CCP_VERKEY
        LD      B,3
        CALL    CCP_EQUAL
        JR      NZ,CCP_TRYDIR
        LD      DE,CCP_VERSION
        LD      C,9
        CALL    BDOS
        JP      CCP_LOOP

CCP_TRYDIR:                             ; recognize DIR command
        LD      HL,CCP_DATA
        LD      DE,CCP_DIRKEY
        LD      B,3
        CALL    CCP_EQUAL
        JP      NZ,CCP_BAD
        CALL    CCP_DIR
        JP      CCP_LOOP

CCP_TRYWARM:                            ; recognize WARM command
        LD      HL,CCP_DATA
        LD      DE,CCP_WARMKEY
        LD      B,4
        CALL    CCP_EQUAL
        JP      NZ,CCP_BAD
        LD      C,0
        JP      BDOS

  ; Patch 2026-09-02: keep the resident USER command deliberately thin.  The
  ; CCP parses only its decimal operand; BDOS Function 32 remains the owner of
  ; current-user state, so transient programs and the command environment can
  ; never acquire divergent copies.

CCP_TRYUSER:                            ; recognize USER command
        LD      HL,CCP_DATA
        LD      DE,CU_KEY
        LD      B,5
        CALL    CCP_EQUAL
        JP      NZ,CCP_BAD
        LD      A,(HL)
        SUB     '0'
        JP      C,CCP_BAD
        CP      10
        JP      NC,CCP_BAD
        LD      E,A
        LD      A,(CCP_COUNT)
        CP      6
        JR      Z,CCP_USERSET
        LD      A,E
        ADD     A,A
        LD      D,A                     ; D=first digit times two
        ADD     A,A
        ADD     A,A
        ADD     A,D                     ; A=first digit times ten
        LD      E,A
        INC     HL
        LD      A,(HL)
        SUB     '0'
        JP      C,CCP_BAD
        CP      10
        JP      NC,CCP_BAD
        ADD     A,E
        CP      32
        JP      NC,CCP_BAD
        LD      E,A

CCP_USERSET:                            ; apply USER command selection
        LD      C,32
        CALL    BDOS
        JP      CCP_LOOP

  ; The resident monitor is intentionally small, but it is always available.
  ; A successful keyword match leaves HL/B at its first argument.  Carry set
  ; tells the caller that the line belonged to the monitor, even when the
  ; command itself had to print a syntax error.

; -------------------------------------------------------------------------------
; Core Command Dispatch
; -------------------------------------------------------------------------------

CCP_CORE:                               ; dispatch resident monitor command
        LD      HL,CCP_KGET
        LD      C,3
        CALL    CCP_MATCH
        JR      NC,CCP_CJUMP
        CALL    CCP_GET
        SCF
        RET

CCP_CJUMP:                              ; recognize JUMP command
        LD      HL,CCP_KJUMP
        LD      C,4
        CALL    CCP_MATCH
        JR      NC,CCP_CPEEK
        CALL    CCP_JUMP
        SCF
        RET

CCP_CPEEK:                              ; recognize PEEK command
        LD      HL,CCP_KPEEK
        LD      C,4
        CALL    CCP_MATCH
        JR      C,CCP_CPDISP
        LD      HL,CCP_KP
        LD      C,1
        CALL    CCP_MATCH
        JR      NC,CCP_CPOKE

CCP_CPDISP:                             ; recognize P abbreviation
        CALL    CCP_PEEK
        SCF
        RET

CCP_CPOKE:                              ; recognize POKE command
        LD      HL,CCP_KPOKE
        LD      C,4
        CALL    CCP_MATCH
        JR      NC,CCP_CGO
        CALL    CCP_POKE
        SCF
        RET

CCP_CGO:                                ; recognize GO command
        LD      HL,CCP_KSAVE
        LD      C,4
        CALL    CCP_MATCH
        JR      NC,CCP_CGOTRY
        CALL    CCP_SAVE
        SCF
        RET

CCP_CGOTRY:                             ; dispatch GO or SAVE command
        LD      HL,CCP_KGO
        LD      C,2
        CALL    CCP_MATCH
        RET     NC
        CALL    CCP_GO
        SCF
        RET

  ; Compare a keyword and require either end of line or a following blank.
  ; This prevents P from stealing PIP and GET from stealing GETFILE.

; ================================================================================
; =                          Command Parsing Utilities                           =
; =                                                                              =
; = Provides shared keyword, numeric, argument, command-tail, and default-FCB    =
; = parsing services used by resident CCP commands.                              =
; ================================================================================
; -------------------------------------------------------------------------------
; Keyword Matching
; -------------------------------------------------------------------------------

CCP_MATCH:                              ; match command keyword
        LD      A,(CCP_COUNT)
        CP      C
        JR      NC,CCP_MLENOK
        OR      A                       ; a short command is a miss, never a match
        RET

CCP_MLENOK:                             ; keyword length can match
        LD      DE,CCP_DATA
        PUSH    BC

CCP_MLOOP:                              ; compare keyword characters
        LD      A,(DE)
        CP      (HL)
        JR      NZ,CCP_MNO
        INC     DE
        INC     HL
        DEC     C
        JR      NZ,CCP_MLOOP
        POP     BC
        LD      A,(CCP_COUNT)
        SUB     C
        LD      B,A
        JR      Z,CCP_MYES
        LD      A,(DE)
        CP      ' '
        JR      NZ,CCP_MRETNO

CCP_MSKIP:                              ; skip matched keyword
        INC     DE
        DJNZ    CCP_MSPMORE
        EX      DE,HL
        SCF
        RET

CCP_MSPMORE:                            ; skip spaces after keyword
        LD      A,(DE)
        CP      ' '
        JR      Z,CCP_MSKIP
        EX      DE,HL
        SCF
        RET

CCP_MYES:                               ; report keyword match
        EX      DE,HL
        SCF
        RET

CCP_MNO:                                ; report keyword mismatch
        POP     BC
CCP_MRETNO:                             ; return keyword mismatch
        OR      A
        RET

  ; Read one hexadecimal token.  HL/B advance to its separator or the end;
  ; DE receives the sixteen-bit value.  Carry is clear for an empty or bad
  ; token.  All address-taking commands share this one set of rules.

; -------------------------------------------------------------------------------
; Hexadecimal Arguments
; -------------------------------------------------------------------------------

CCP_HEX:                                ; parse hexadecimal token
        LD      DE,0
        LD      C,0

CCP_HXLOOP:                             ; accumulate hexadecimal digits
        LD      A,B
        OR      A
        JR      Z,CCP_HXDONE
        LD      A,(HL)
        CP      ' '
        JR      Z,CCP_HXDONE
        SUB     '0'
        JR      C,CCP_HXBAD
        CP      10
        JR      C,CCP_HXDIG
        SUB     7
        CP      10
        JR      C,CCP_HXBAD
        CP      16
        JR      NC,CCP_HXBAD

CCP_HXDIG:                              ; convert one hexadecimal digit
        LD      (CCP_HEXDIG),A
        SLA     E
        RL      D
        SLA     E
        RL      D
        SLA     E
        RL      D
        SLA     E
        RL      D
        LD      A,(CCP_HEXDIG)
        OR      E
        LD      E,A
        INC     C
        LD      A,C
        CP      5                       ; more than four digits cannot name an address
        JR      NC,CCP_HXBAD
        INC     HL
        DEC     B
        JR      CCP_HXLOOP

CCP_HXDONE:                             ; finish hexadecimal parse
        LD      A,C
        OR      A
        RET     Z
        SCF
        RET

CCP_HXBAD:                              ; report invalid hexadecimal token
        OR      A
        RET

; -------------------------------------------------------------------------------
; Argument and Command-Tail Preparation
; -------------------------------------------------------------------------------

CCP_ARGSKIP:                            ; skip spaces before argument
        LD      A,B
        OR      A
        RET     Z
        LD      A,(HL)
        CP      ' '
        RET     NZ
        INC     HL
        DEC     B
        JR      CCP_ARGSKIP

  ; Make a fresh command tail and its two conventional default FCBs.  GO and
  ; JUMP deliberately do not inherit the tail left by the last transient.

CCP_MKTAIL:                             ; build transient command tail and FCBs
        LD      (CCP_APTR),HL
        LD      A,B
        LD      (CCP_ALEN),A
        LD      HL,005CH
        LD      B,36
        XOR     A

CCP_MTZERO:                             ; clear default FCB area
        LD      (HL),A
        INC     HL
        DJNZ    CCP_MTZERO
        LD      A,(CCP_ALEN)
        LD      (0080H),A
        LD      C,A
        LD      B,0
        LD      HL,(CCP_APTR)
        LD      DE,0081H
        LD      A,C
        OR      A
        JR      Z,CCP_MTCR
        LDIR

CCP_MTCR:                               ; terminate transient command tail
        LD      A,13
        LD      (DE),A
        LD      HL,(CCP_APTR)
        LD      A,(CCP_ALEN)
        LD      B,A
        CALL    CCP_PSKIP
        LD      DE,005CH
        CALL    CCP_PFCB
        CALL    CCP_PSKIP
        LD      DE,006CH
        CALL    CCP_PFCB
        LD      DE,0080H
        LD      C,26
        JP      BDOS

; ================================================================================
; =                          Resident Monitor Commands                           =
; =                                                                              =
; = Implements the small resident monitor command set retained in the CCP so     =
; = it remains available independently of CPXs and transient disk files.         =
; ================================================================================
; -------------------------------------------------------------------------------
; JUMP and GO
; -------------------------------------------------------------------------------

CCP_JUMP:                               ; execute JUMP command
        LD      A,B
        OR      A
        JR      Z,CCP_ADDRERR
        CALL    CCP_HEX
        JR      NC,CCP_ADDRERR
        LD      (CCP_TADDR),DE
        CALL    CCP_ARGSKIP
        CALL    CCP_MKTAIL
        LD      HL,(0001H)              ; a returning image performs a normal WBOOT
        PUSH    HL
        LD      HL,(CCP_TADDR)
        JP      (HL)

CCP_GO:                                 ; execute GO command
        CALL    CCP_MKTAIL
        LD      HL,(0001H)
        PUSH    HL
        LD      HL,0100H
        JP      (HL)

CCP_ADDRERR:                            ; report missing or invalid address
        LD      DE,CCP_MADDR
        LD      C,9
        JP      BDOS

  ; GET loads a raw file and leaves it in memory for PEEK, POKE, SAVE, GO, or
  ; JUMP.  With two operands the first is the address; with one, even a name
  ; made solely of hex digits denotes a file and the destination is 0100H.

; -------------------------------------------------------------------------------
; GET
; -------------------------------------------------------------------------------

CCP_GET:                                ; execute GET command
        LD      A,B
        OR      A
        JP      Z,CCP_GSYNTAX
        LD      (CCP_APTR),HL
        LD      A,B
        LD      (CCP_ALEN),A

CCP_GSCAN:                              ; scan GET operands
        LD      A,B
        OR      A
        JR      Z,CCP_GONE
        LD      A,(HL)
        CP      ' '
        JR      Z,CCP_GTWO
        INC     HL
        DEC     B
        JR      CCP_GSCAN

CCP_GONE:                               ; handle one-operand GET form
        LD      HL,0100H
        LD      (CCP_TADDR),HL
        LD      HL,(CCP_APTR)
        LD      A,(CCP_ALEN)
        LD      B,A
        JR      CCP_GFILE

CCP_GTWO:                               ; handle two-operand GET form
        LD      HL,(CCP_APTR)
        LD      A,(CCP_ALEN)
        LD      B,A
        CALL    CCP_HEX
        JP      NC,CCP_GSYNTAX
        LD      (CCP_TADDR),DE
        CALL    CCP_ARGSKIP
        LD      A,B
        OR      A
        JP      Z,CCP_GSYNTAX

CCP_GFILE:                              ; prepare GET filename
        LD      A,B
        LD      (CCP_ALEN),A
        LD      (CCP_APTR),HL
  ; A filename is one token.  Reject a hidden third operand before touching RAM.

CCP_GFSN:                               ; skip spaces before GET filename
        LD      A,B
        OR      A
        JR      Z,CCP_GPARSE
        LD      A,(HL)
        CP      ' '
        JP      Z,CCP_GSYNTAX
        INC     HL
        DEC     B
        JR      CCP_GFSN

CCP_GPARSE:                             ; parse GET file specification
        LD      HL,(CCP_TADDR)
        LD      A,H
        OR      A
        JP      Z,CCP_GPROTECT          ; page zero belongs to the system
        LD      HL,(CCP_APTR)
        LD      A,(CCP_ALEN)
        LD      B,A
        LD      DE,CCP_FCB
        CALL    CCP_PFCB
        LD      A,(CCP_FCB+1)
        CP      ' '
        JP      Z,CCP_GSYNTAX
        LD      HL,CCP_FCB+1
        LD      B,11

CCP_GWILD:                              ; reject wildcard GET filename
        LD      A,(HL)
        CP      '?'
        JP      Z,CCP_GSYNTAX
        INC     HL
        DJNZ    CCP_GWILD
        LD      DE,CCP_FCB
        LD      C,35
        CALL    BDOS
        CP      0FFH
        JP      Z,CCP_GNOFILE
        LD      A,(CCP_FCB+35)
        OR      A
        JP      NZ,CCP_GBIG
        LD      A,(CCP_FCB+34)
        CP      2
        JP      NC,CCP_GBIG
        LD      HL,(CCP_FCB+33)
        LD      (CCP_GRECS),HL
        LD      B,7

CCP_GMUL:                               ; compute GET load extent
        ADD     HL,HL
        JP      C,CCP_GBIG
        DJNZ    CCP_GMUL
        LD      DE,(CCP_TADDR)
        ADD     HL,DE
        JP      C,CCP_GBIG
        EX      DE,HL
        LD      HL,(LY_SYS+08CH)        ; live bottom of the reconstructible CCP
        OR      A
        SBC     HL,DE
        JP      C,CCP_GBIG
        LD      DE,CCP_FCB
        LD      C,15
        CALL    BDOS
        INC     A
        JR      Z,CCP_GNOFILE
        LD      HL,(CCP_TADDR)
        LD      (CCP_GDMA),HL

CCP_GRLOOP:                             ; read GET file records
        LD      HL,(CCP_GRECS)
        LD      A,H
        OR      L
        JR      Z,CCP_GDONE
        LD      DE,(CCP_GDMA)
        LD      C,26
        CALL    BDOS
        LD      DE,CCP_FCB
        LD      C,20
        CALL    BDOS
        OR      A
        JR      NZ,CCP_GREAD
        LD      HL,(CCP_GDMA)
        LD      DE,128
        ADD     HL,DE
        LD      (CCP_GDMA),HL
        LD      HL,(CCP_GRECS)
        DEC     HL
        LD      (CCP_GRECS),HL
        JR      CCP_GRLOOP

CCP_GDONE:                              ; report successful GET
        LD      DE,CCP_MLOADED
        JR      CCP_GPRINT

CCP_GSYNTAX:                            ; report GET syntax error
        LD      DE,CCP_MGET
        JR      CCP_GPRINT

CCP_GPROTECT:                           ; report protected-memory overlap
        LD      DE,CCP_MPROTECT
        JR      CCP_GPRINT

CCP_GBIG:                               ; report oversized GET file
        LD      DE,CCP_MTOOBIG
        JR      CCP_GPRINT

CCP_GNOFILE:                            ; report missing GET file
        LD      DE,CCP_MNOFILE
        JR      CCP_GPRINT
CCP_GREAD:                              ; report GET read error
        LD      DE,CCP_MREAD

CCP_GPRINT:                             ; print GET status message
        PUSH    DE
        LD      DE,0080H
        LD      C,26
        CALL    BDOS
        POP     DE
        LD      C,9
        JP      BDOS

  ; PEEK's page is sixteen rows of sixteen bytes.  Unlike a file pager, moving
  ; backward costs only one subtraction, so the old monitor-style comma and
  ; period controls are kept along with the printed angle-bracket mnemonics.

; -------------------------------------------------------------------------------
; PEEK
; -------------------------------------------------------------------------------

CCP_PEEK:                               ; execute PEEK command
        XOR     A
        LD      (CCP_PBOUND),A
        LD      A,B
        OR      A
        JR      NZ,CCP_PKFIRST
        LD      HL,(CLDPTR)
        LD      (CCP_PPAGE),HL
        JR      CCP_PKSHOW

CCP_PKFIRST:                            ; establish first PEEK page
        CALL    CCP_HEX
        JP      NC,CCP_ADDRERR
        LD      (CCP_PLOW),DE
        LD      (CCP_PPAGE),DE
        CALL    CCP_ARGSKIP
        LD      A,B
        OR      A
        JR      Z,CCP_PKSHOW
        CALL    CCP_HEX
        JP      NC,CCP_ADDRERR
        CALL    CCP_ARGSKIP
        LD      A,B
        OR      A
        JP      NZ,CCP_ADDRERR
        LD      (CCP_PHIGH),DE
        LD      HL,(CCP_PLOW)
        OR      A
        SBC     HL,DE
        JR      C,CCP_PKORDER
        JR      Z,CCP_PKORDER
        JP      CCP_ADDRERR

CCP_PKORDER:                            ; normalize PEEK bounds
        LD      A,1
        LD      (CCP_PBOUND),A

CCP_PKSHOW:                             ; display current PEEK page
        LD      HL,(CCP_PPAGE)
        LD      (CCP_PPTR),HL
        LD      HL,256
        LD      (CCP_PCNT),HL

CCP_PKLINE:                             ; display one PEEK row
        LD      DE,CCP_DIRNL
        LD      C,9
        CALL    BDOS
        LD      HL,(CCP_PPTR)
        LD      A,H
        CALL    CCP_HEX8
        LD      HL,(CCP_PPTR)
        LD      A,L
        CALL    CCP_HEX8
        LD      E,':'
        LD      C,2
        CALL    BDOS
        LD      A,16
        LD      (CCP_PCOL),A

CCP_PKBYTE:                             ; display one PEEK byte
        LD      E,' '
        LD      C,2
        CALL    BDOS
        LD      HL,(CCP_PPTR)
        LD      A,(HL)
        CALL    CCP_HEX8
        LD      HL,(CCP_PCNT)
        DEC     HL
        LD      (CCP_PCNT),HL
        LD      A,H
        OR      L
        JR      Z,CCP_PKPAGE
        LD      HL,(CCP_PPTR)
        LD      A,H
        CP      0FFH
        JR      NZ,CCP_PKINC
        LD      A,L
        CP      0FFH
        JR      Z,CCP_PKPAGE

CCP_PKINC:                              ; advance PEEK address
        INC     HL
        LD      (CCP_PPTR),HL
        LD      A,(CCP_PBOUND)
        OR      A
        JR      Z,CCP_PKCOL
        LD      DE,(CCP_PHIGH)
        OR      A
        SBC     HL,DE
        JR      C,CCP_PKCOL
        JR      Z,CCP_PKCOL
        JR      CCP_PKPAGE

CCP_PKCOL:                              ; finish PEEK row
        LD      HL,CCP_PCOL
        DEC     (HL)
        JR      NZ,CCP_PKBYTE
        JR      CCP_PKLINE

CCP_PKPAGE:                             ; finish PEEK page

  ; Remember the byte following the display whenever one exists.  PEEK with no
  ; argument resumes here after the CCP itself has been reloaded by WBOOT.

        LD      HL,(CCP_PPTR)
        LD      A,H
        AND     L
        CP      0FFH
        JR      Z,CCP_PKWAIT
        INC     HL
        LD      (CLDPTR),HL

CCP_PKWAIT:                             ; prompt for PEEK navigation
        LD      DE,CCP_MPAGER
        LD      C,9
        CALL    BDOS

CCP_PKKEY:                              ; decode PEEK navigation key
        LD      E,0FFH
        LD      C,6
        CALL    BDOS
        OR      A
        JR      Z,CCP_PKKEY
        AND     07FH
        CP      3
        RET     Z
        CP      ','
        JR      Z,CCP_PKPREV
        CP      '<'
        JR      Z,CCP_PKPREV
        CP      ' '
        JR      Z,CCP_PKNEXT
        CP      '.'
        JR      Z,CCP_PKNEXT
        CP      '>'
        JR      NZ,CCP_PKKEY

CCP_PKNEXT:                             ; advance to next PEEK page
        LD      HL,(CCP_PPAGE)
        LD      DE,0100H
        ADD     HL,DE
        JR      C,CCP_PKRET
        LD      A,(CCP_PBOUND)
        OR      A
        JR      Z,CCP_PKSETP
        LD      DE,(CCP_PHIGH)
        PUSH    HL
        OR      A
        SBC     HL,DE
        POP     HL
        JR      C,CCP_PKSETP
        JR      Z,CCP_PKSETP
        JR      CCP_PKRET

CCP_PKPREV:                             ; move to previous PEEK page
        LD      HL,(CCP_PPAGE)
        LD      DE,0100H
        OR      A
        SBC     HL,DE
        JR      NC,CCP_PKPVOK
        LD      HL,0

CCP_PKPVOK:                             ; accept previous PEEK page
        LD      A,(CCP_PBOUND)
        OR      A
        JR      Z,CCP_PKSETP
        LD      DE,(CCP_PLOW)
        PUSH    HL
        OR      A
        SBC     HL,DE
        POP     HL
        JR      NC,CCP_PKSETP
        EX      DE,HL

CCP_PKSETP:                             ; store resumable PEEK position
        LD      (CCP_PPAGE),HL
        JP      CCP_PKSHOW

CCP_PKRET:                              ; return from PEEK
        RET

CCP_HEX8:                               ; print byte in hexadecimal
        PUSH    AF
        RRCA
        RRCA
        RRCA
        RRCA
        CALL    CCP_HEXNIB
        POP     AF

CCP_HEXNIB:                             ; print hexadecimal nibble
        AND     0FH
        ADD     A,'0'
        CP      '9'+1
        JR      C,CCP_HXOUT
        ADD     A,7

CCP_HXOUT:                              ; emit hexadecimal digit
        LD      E,A
        LD      C,2
        JP      BDOS

  ; POKE first converts every operand into a private byte string.  Only after
  ; the complete line and its end address have been checked do we alter memory;
  ; a typo in the last operand can therefore never leave a half-applied patch.

; -------------------------------------------------------------------------------
; POKE
; -------------------------------------------------------------------------------

CCP_POKE:                               ; execute POKE command
        LD      A,B
        OR      A
        JP      Z,CCP_ADDRERR
        CALL    CCP_HEX
        JP      NC,CCP_ADDRERR
        LD      (CCP_TADDR),DE
        CALL    CCP_ARGSKIP
        LD      A,B
        OR      A
        JR      Z,CCP_POSYNTAX
        LD      DE,CCP_PBUF
        XOR     A
        LD      (CCP_PLEN),A

CCP_PONEXT:                             ; parse next POKE byte
        CALL    CCP_ARGSKIP
        LD      A,B
        OR      A
        JR      Z,CCP_POCHECK
        LD      A,(HL)
        CP      '"'
        JR      Z,CCP_POTEXT
        PUSH    DE
        CALL    CCP_HEX
        LD      A,E
        LD      (CCP_HEXDIG),A
        LD      A,D
        OR      A
        JR      NZ,CCP_POFAIL
        LD      A,(CCP_PLEN)
        INC     A
        LD      (CCP_PLEN),A
        POP     DE
        LD      A,(CCP_HEXDIG)
        LD      (DE),A
        INC     DE
        JR      CCP_PONEXT

CCP_POFAIL:                             ; reject invalid POKE command
        POP     DE
        JR      CCP_POSYNTAX

CCP_POTEXT:                             ; apply validated POKE bytes
        INC     HL
        DEC     B

CCP_POTLOOP:                            ; write next POKE byte
        LD      A,B
        OR      A
        JR      Z,CCP_POCHECK
        LD      A,(HL)
        LD      (DE),A
        INC     HL
        INC     DE
        LD      A,(CCP_PLEN)
        INC     A
        LD      (CCP_PLEN),A
        DEC     B
        JR      CCP_POTLOOP

CCP_POCHECK:                            ; validate POKE target range
        LD      A,(CCP_PLEN)
        OR      A
        JR      Z,CCP_POSYNTAX
        DEC     A
        LD      E,A
        LD      D,0
        LD      HL,(CCP_TADDR)
        ADD     HL,DE
        JR      C,CCP_POSYNTAX
        LD      HL,CCP_PBUF
        LD      DE,(CCP_TADDR)
        LD      A,(CCP_PLEN)
        LD      C,A
        LD      B,0
        LDIR
        RET

CCP_POSYNTAX:                           ; report POKE syntax error
        LD      DE,CCP_MPOKE
        LD      C,9
        JP      BDOS

  ; SAVE n file -- copy n 256-byte pages beginning at 0100H.  This belongs in
  ; the CCP because loading SAVE.COM would first destroy the very low-memory
  ; image the command is meant to preserve.

; -------------------------------------------------------------------------------
; SAVE
; -------------------------------------------------------------------------------

CCP_SAVE:                               ; execute SAVE command
        XOR     A
        LD      (CCP_DUACT),A
        LD      A,B
        OR      A
        JP      Z,CSVSYN
        LD      C,0
        LD      D,0

CSVNUM:                                 ; parse SAVE page count
        LD      A,B
        OR      A
        JP      Z,CSVSYN
        LD      A,(HL)
        CP      ' '
        JR      Z,CSVNAME
        CP      '0'
        JP      C,CSVSYN
        CP      '9'+1
        JP      NC,CSVSYN
        SUB     '0'
        LD      E,A
        LD      A,C
        CP      25
        JR      C,CSVMUL
        JP      NZ,CSVSYN
        LD      A,E
        CP      6
        JP      NC,CSVSYN

CSVMUL:                                 ; convert SAVE pages to records
        LD      A,C
        ADD     A,A
        LD      C,A
        ADD     A,A
        ADD     A,A
        ADD     A,C
        ADD     A,E
        LD      C,A
        LD      D,1
        INC     HL
        DEC     B
        JR      CSVNUM

CSVNAME:                                ; locate SAVE filename
        LD      A,D
        OR      A
        JP      Z,CSVSYN
        LD      A,C
        LD      (CCP_SPAGES),A

CSVNSKP:                                ; skip spaces before SAVE filename
        INC     HL
        DEC     B
        JP      Z,CSVSYN
        LD      A,(HL)
        CP      ' '
        JR      Z,CSVNSKP
        CALL    CCP_DUSEL
        LD      A,B
        OR      A
        JP      Z,CSVSYN
        PUSH    HL
        PUSH    BC

CSVTLEN:                                ; measure SAVE filename token
        LD      A,(HL)
        CP      ' '
        JR      Z,CSVTAIL
        INC     HL
        DJNZ    CSVTLEN
        JR      CSVPAR

CSVTAIL:                                ; reject trailing SAVE operands
        INC     HL
        DEC     B

CSVTRL:                                 ; scan SAVE command tail
        LD      A,B
        OR      A
        JR      Z,CSVPAR
        LD      A,(HL)
        CP      ' '
        JR      NZ,CSVPOP
        INC     HL
        DJNZ    CSVTRL

CSVPAR:                                 ; parse SAVE file specification
        POP     BC
        POP     HL
        LD      DE,CCP_FCB
        CALL    CCP_PFCB
        LD      A,(CCP_FCB+1)
        CP      ' '
        JR      Z,CSVSYN
        LD      HL,CCP_FCB+1
        LD      B,11

CSVNOQ:                                 ; reject wildcard SAVE filename
        LD      A,(HL)
        CP      '?'
        JR      Z,CSVSYN
        INC     HL
        DJNZ    CSVNOQ
        LD      DE,CCP_FCB
        LD      C,19
        CALL    BDOS
        LD      DE,CCP_FCB
        LD      C,22
        CALL    BDOS
        CP      0FFH
        JR      Z,CSVSPACE
        LD      HL,0100H
        LD      (CCP_SDMA),HL
        LD      A,(CCP_SPAGES)
        LD      L,A
        LD      H,0
        ADD     HL,HL
        LD      (CCP_SRECS),HL

CSVWRITE:                               ; write SAVE records
        LD      HL,(CCP_SRECS)
        LD      A,H
        OR      L
        JR      Z,CSVCLOSE
        LD      DE,(CCP_SDMA)
        LD      C,26
        CALL    BDOS
        LD      DE,CCP_FCB
        LD      C,21
        CALL    BDOS
        OR      A
        JR      NZ,CSVSPACE
        LD      HL,(CCP_SDMA)
        LD      DE,128
        ADD     HL,DE
        LD      (CCP_SDMA),HL
        LD      HL,(CCP_SRECS)
        DEC     HL
        LD      (CCP_SRECS),HL
        JR      CSVWRITE

CSVCLOSE:                               ; close SAVE output file
        LD      DE,CCP_FCB
        LD      C,16
        CALL    BDOS
        CP      0FFH
        JR      Z,CSVSPACE
        JR      CSVDONE

CSVPOP:                                 ; restore SAVE working registers
        POP     BC
        POP     HL

CSVSYN:                                 ; report SAVE syntax error
        LD      DE,CCP_MSAVE
        JR      CSVPRINT
CSVSPACE:                               ; report SAVE disk-full error
        LD      DE,CCP_MSPACE
CSVPRINT:                               ; print SAVE status message
        LD      C,9
        CALL    BDOS

CSVDONE:                                ; return from SAVE
        LD      DE,0080H
        LD      C,26
        CALL    BDOS
        JP      CCP_DURST

  ; Temporarily select the optional A:, 5:, or C3: qualifier which prefixes a
  ; resident command filename.  The caller's drive and user are always restored
  ; before the monitor returns to its prompt.

; ================================================================================
; =                        Drive/User Selection Services                         =
; =                                                                              =
; = Parses temporary drive/user qualifiers for resident commands and restores    =
; = the caller's default drive and user context afterward.                       =
; ================================================================================
; -------------------------------------------------------------------------------
; Drive/User Qualifier Parsing
; -------------------------------------------------------------------------------

CCP_DUSEL:                              ; parse drive/user-qualified command
        LD      (CCP_DARGP),HL
        LD      A,B
        LD      (CCP_DLEN),A
        LD      C,25
        CALL    BDOS
        LD      (CCP_DSAVE),A
        LD      E,0FFH
        LD      C,32
        CALL    BDOS
        LD      (CCP_USAVE),A
        LD      A,1
        LD      (CCP_DUACT),A
        LD      A,0FFH
        LD      (CCP_DTARG),A
        LD      (CCP_UTARG),A
        LD      HL,(CCP_DARGP)
        LD      A,(CCP_DLEN)
        LD      B,A
        OR      A
        RET     Z
        LD      A,(HL)
        CP      'A'
        JR      C,CDUNUM
        CP      'P'+1
        JP      NC,CDUNONE
        SUB     'A'
        LD      (CCP_DTARG),A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JP      Z,CDUNONE
        LD      A,(HL)
        CP      ':'
        JR      Z,CDUCOL
        CP      '0'
        JP      C,CDUNONE
        CP      '9'+1
        JP      NC,CDUNONE
        SUB     '0'
        LD      C,A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JP      Z,CDUNONE
        LD      A,(HL)
        CP      ':'
        JR      Z,CDUSET
        CP      '0'
        JP      C,CDUNONE
        CP      '9'+1
        JP      NC,CDUNONE
        LD      A,C
        ADD     A,A
        LD      D,A
        ADD     A,A
        ADD     A,A
        ADD     A,D
        LD      C,A
        LD      A,(HL)
        SUB     '0'
        ADD     A,C
        CP      32
        JR      NC,CDUNONE
        LD      C,A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JR      Z,CDUNONE
        LD      A,(HL)
        CP      ':'
        JR      NZ,CDUNONE

CDUSET:                                 ; apply parsed drive selection
        LD      A,C
        LD      (CCP_UTARG),A
        JR      CDUCOL

CDUNUM:                                 ; parse decimal user number
        LD      A,(HL)
        CP      '0'
        JR      C,CDUNONE
        CP      '9'+1
        JR      NC,CDUNONE
        SUB     '0'
        LD      C,A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JR      Z,CDUNONE
        LD      A,(HL)
        CP      '0'
        JR      C,CDUONE
        CP      '9'+1
        JR      NC,CDUONE
        LD      A,C
        ADD     A,A
        LD      D,A
        ADD     A,A
        ADD     A,A
        ADD     A,D
        LD      C,A
        LD      A,(HL)
        SUB     '0'
        ADD     A,C
        CP      32
        JR      NC,CDUNONE
        LD      C,A
        INC     HL
        DEC     B

CDUONE:                                 ; finish one-digit user number
        LD      A,(HL)
        CP      ':'
        JR      NZ,CDUNONE
        LD      A,C
        LD      (CCP_UTARG),A

CDUCOL:                                 ; accept drive/user qualifier colon
        INC     HL
        DEC     B
        LD      (CCP_DARGP),HL
        LD      A,B
        LD      (CCP_DLEN),A
        LD      A,(CCP_DTARG)
        CP      0FFH
        JR      Z,CDUUSER
        LD      E,A
        LD      C,14
        CALL    BDOS

CDUUSER:                                ; apply parsed user selection
        LD      A,(CCP_UTARG)
        CP      0FFH
        JR      Z,CDUOUT
        LD      E,A
        LD      C,32
        CALL    BDOS

CDUOUT:                                 ; finish drive/user selection
        LD      HL,(CCP_DARGP)
        LD      A,(CCP_DLEN)
        LD      B,A
        RET

CDUNONE:                                ; report no drive/user qualifier
        LD      HL,(CCP_DARGP)
        LD      A,(CCP_DLEN)
        LD      B,A
        RET

; -------------------------------------------------------------------------------
; Drive/User Restoration
; -------------------------------------------------------------------------------

CCP_DURST:                              ; restore saved drive/user state
        LD      A,(CCP_DUACT)
        OR      A
        RET     Z
        XOR     A
        LD      (CCP_DUACT),A
        LD      A,(CCP_DSAVE)
        LD      E,A
        LD      C,14
        CALL    BDOS
        LD      A,(CCP_USAVE)
        LD      E,A
        LD      C,32
        JP      BDOS

  ; Command Processor Extension (CPX) chain.
  ;
  ; Each header contains DW next,entry.  Entry receives DE=upper-case command
  ; text and B=length.  Carry set means handled; carry clear passes to the next
  ; CPX.  A CPX may alter ordinary registers but must preserve SP, IX, IY and the
  ; command buffer. CPXs get first refusal; currently retained core commands are
  ; transition fallbacks and disappear only after RCP.CPX is fully verified.

; ================================================================================
; =                         Command Processor Extensions                         =
; =                                                                              =
; = Traverses the active CPX chain, matches extension command names, and         =
; = invokes the corresponding extension handlers.                                =
; ================================================================================

CPX_DISPATCH:                           ; dispatch command through CPX chain
        LD      HL,(CPXHEAD)

CPX_NEXT:                               ; test next CPX descriptor
        LD      A,H
        OR      L
        RET     Z
        LD      (CPX_CUR),HL
        INC     HL
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (CPX_CALL+1),DE
        LD      DE,CCP_DATA
        LD      A,(CCP_COUNT)
        LD      B,A

  ; Patch 2026-09-02: the CCP is reloadable RAM, so patching this CALL provides
  ; a compact Z80 indirect-call trampoline while preserving a normal return.

CPX_CALL:                               ; call matching CPX command handler
        CALL    0000H

CPX_RETURN:                             ; return from CPX handler
        RET     C
        LD      HL,(CPX_CUR)
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        JR      CPX_NEXT

  ; Patch 2026-09-07: count nonblank characters while folding case.  Formerly
  ; a SPACE-only command reached the loader and printed a question mark.
  ; Sharing this walk also avoids another pointer in the relocation table.

CCP_UPPER:                              ; uppercase command line
        LD      C,0
        LD      HL,CCP_DATA
        LD      A,(CCP_COUNT)
        LD      B,A

CCP_UPLOOP:                             ; uppercase next command character
        LD      A,(HL)
        CP      ' '
        JR      Z,CCP_UPNEXT
        INC     C
        CP      'a'
        JR      C,CCP_UPNEXT
        CP      'z'+1
        JR      NC,CCP_UPNEXT
        AND     05FH
        LD      (HL),A

CCP_UPNEXT:                             ; advance uppercase scan
        INC     HL
        DJNZ    CCP_UPLOOP
        LD      A,C
        OR      A
        RET

CCP_EQUAL:                              ; compare command text
        LD      A,(DE)
        CP      (HL)
        RET     NZ
        INC     DE
        INC     HL
        DJNZ    CCP_EQUAL
        RET

  ; First transient loader: a command containing one bare 1..8-character name
  ; selects NAME.COM. Arguments and explicit extensions are later milestones.

; ================================================================================
; =                           Transient Program Loader                           =
; =                                                                              =
; = Builds and loads .COM commands, handles qualified drive/user contexts,       =
; = prepares the transient environment, and transfers control to the program.    =
; ================================================================================
; -------------------------------------------------------------------------------
; Command Name and Program Loading
; -------------------------------------------------------------------------------

CCP_LOAD:                               ; load transient command
        LD      HL,CCP_FCB
        LD      B,36
        XOR     A

CCP_FCLR:                               ; clear transient-command FCB
        LD      (HL),A
        INC     HL
        DJNZ    CCP_FCLR
        LD      HL,CCP_FCB+1
        LD      B,11
        LD      A,' '

CCP_FSPC:                               ; initialize FCB name fields
        LD      (HL),A
        INC     HL
        DJNZ    CCP_FSPC
        LD      HL,CCP_COM
        LD      DE,CCP_FCB+9
        LD      BC,3
        LDIR
        CALL    CCP_LQUAL
        LD      A,(CCP_LREML)
        OR      A
        SCF
        RET     Z
        LD      A,(CCP_LREML)
        LD      B,A
        LD      HL,(CCP_LPTR)
        XOR     A

CCP_LNSCAN:                             ; scan transient command name
        LD      C,A
        LD      A,(HL)
        CP      ' '
        LD      A,C
        JR      Z,CCP_LNFOUND
        CP      8
        JP      NC,CCP_LFAIL
        INC     A
        INC     HL
        DJNZ    CCP_LNSCAN
        JR      CCP_LNFOUND

CCP_LNFOUND:                            ; finish transient command name
        OR      A                       ; do not retain Z from the separating-space CP
        JP      Z,CCP_LFAIL
        LD      (CCP_NAMEL),A
        LD      C,A
        LD      A,(CCP_QLEN)
        ADD     A,C
        LD      (CCP_CMDLEN),A
        LD      B,A
        LD      A,(CCP_NAMEL)
        LD      B,A
        LD      HL,(CCP_LPTR)
        LD      DE,CCP_FCB+1

CCP_FNCPY:                              ; copy transient filename into FCB
        LD      A,(HL)
        CP      '!'
        JP      C,CCP_LFAIL
        CP      '.'
        JP      Z,CCP_LFAIL
        LD      (DE),A
        INC     HL
        INC     DE
        DJNZ    CCP_FNCPY
        LD      DE,CCP_FCB
        LD      C,15
        CALL    BDOS
        INC     A
        JP      Z,CCP_LFAIL
                                        ; Build the transient arguments while the command line still exists.
  ; The protected reader now owns EOF/error handling and the final jump.

CCP_LEOF:                               ; finish transient filename parse
        LD      HL,005CH
        LD      B,36
        XOR     A

CCP_ZPAGE:                              ; clear transient base page
        LD      (HL),A
        INC     HL
        DJNZ    CCP_ZPAGE
        LD      A,(CCP_CMDLEN)
        LD      C,A
        LD      A,(CCP_COUNT)
        SUB     C
        LD      (0080H),A
        LD      B,A
        LD      A,(CCP_CMDLEN)
        LD      E,A
        LD      D,0
        LD      HL,CCP_DATA
        ADD     HL,DE
        LD      DE,0081H
        LD      A,B
        OR      A
        JR      Z,CCP_LTAIL0
        LD      C,A
        LD      B,0
        LDIR

CCP_LTAIL0:                             ; build transient command tail
        LD      A,13
        LD      (DE),A
        LD      A,(CCP_CMDLEN)
        LD      C,A
        LD      A,(CCP_COUNT)
        SUB     C
        LD      B,A
        LD      A,(CCP_CMDLEN)
        LD      E,A
        LD      D,0
        LD      HL,CCP_DATA
        ADD     HL,DE
        CALL    CCP_PSKIP
        LD      DE,005CH
        CALL    CCP_PFCB
        CALL    CCP_PSKIP
        LD      DE,006CH
        CALL    CCP_PFCB
        LD      HL,CCP_FCB
        LD      DE,LY_FCB               ; protected module-reader FCB, idle during COM load
        LD      BC,36
        LDIR
        LD      DE,LY_BUF               ; stage each record outside the full TPA
        LD      C,26
        CALL    BDOS
        LD      A,(CCP_LUACT)
        OR      A
        LD      A,(CCP_LUSAV)
        JP      NZ,LY_COMSTART
        LD      E,0FFH
        LD      C,32
        CALL    BDOS
        JP      LY_COMSTART

CCP_LFAIL:                              ; report transient load failure
        CALL    CCP_LURST
        SCF
        RET

  ; Parse an optional DU qualifier on a transient command: A:NAME, 5:NAME, or
  ; C3:NAME.  The drive is encoded in the loader FCB; a user selection is made
  ; only while locating/reading the image and restored before execution.  Thus
  ; B0>A:CPX LIST runs A0:CPX.COM but CPX.COM still observes B0 as its caller DU.

; -------------------------------------------------------------------------------
; Qualified Drive/User Handling
; -------------------------------------------------------------------------------

CCP_LQUAL:                              ; parse transient drive/user qualifier
        LD      HL,CCP_DATA
        LD      (CCP_LPTR),HL
        LD      A,(CCP_COUNT)
        LD      (CCP_LREML),A
        XOR     A
        LD      (CCP_QLEN),A
        LD      (CCP_LUACT),A
        DEC     A
        LD      (CCP_LDRV),A
        LD      B,A
        LD      A,(CCP_COUNT)
        CP      3
        RET     C
        LD      B,A
        LD      A,(HL)
        CP      'A'
        JR      C,CCP_LQNUM
        CP      'P'+1
        RET     NC
        SUB     'A'-1
        LD      (CCP_LDRV),A
        INC     HL
        DEC     B
        LD      A,(HL)
        CP      ':'
        JR      Z,CCP_LQCOL

CCP_LQNUM:                              ; parse qualified user number
        LD      A,(HL)
        CP      '0'
        RET     C
        CP      '9'+1
        RET     NC
        SUB     '0'
        LD      C,A
        INC     HL
        DEC     B
        LD      A,(HL)
        CP      '0'
        JR      C,CCP_LQONE
        CP      '9'+1
        JR      NC,CCP_LQONE
        LD      A,C
        ADD     A,A
        LD      D,A
        ADD     A,A
        ADD     A,A
        ADD     A,D
        LD      C,A
        LD      A,(HL)
        SUB     '0'
        ADD     A,C
        CP      32
        RET     NC
        LD      C,A
        INC     HL
        DEC     B

CCP_LQONE:                              ; finish one-digit qualified user
        LD      A,(HL)
        CP      ':'
        RET     NZ
        LD      A,C
        LD      (CCP_LUTRG),A
        PUSH    HL
        PUSH    BC
        LD      E,0FFH
        LD      C,32
        CALL    BDOS
        LD      (CCP_LUSAV),A
        LD      A,(CCP_LUTRG)
        LD      E,A
        LD      C,32
        CALL    BDOS
        POP     BC
        POP     HL
        LD      A,1
        LD      (CCP_LUACT),A

CCP_LQCOL:                              ; accept transient qualifier colon
        LD      A,(CCP_LDRV)
        CP      0FFH
        JR      Z,CCP_LQSTRP
        LD      (CCP_FCB),A

CCP_LQSTRP:                             ; strip qualifier from command line
        INC     HL
        DEC     B
        LD      (CCP_LPTR),HL
        LD      A,B
        LD      (CCP_LREML),A
        LD      A,(CCP_COUNT)
        LD      HL,CCP_LREML
        SUB     (HL)
        LD      (CCP_QLEN),A
        RET

CCP_LURST:                              ; restore caller drive/user state
        LD      A,(CCP_LUACT)
        OR      A
        RET     Z
        XOR     A
        LD      (CCP_LUACT),A
        LD      A,(CCP_LUSAV)
        LD      E,A
        LD      C,32
        JP      BDOS

; ================================================================================
; =                          File-Specification Parser                           =
; =                                                                              =
; = Parses CP/M file specifications into FCB form, including drive prefixes,     =
; = filenames, extensions, and wildcard expansion.                               =
; ================================================================================
; -------------------------------------------------------------------------------
; Parser Entry and FCB Initialization
; -------------------------------------------------------------------------------

CCP_PSKIP:                              ; skip spaces in command parser
        LD      A,B
        OR      A
        RET     Z
        LD      A,(HL)
        CP      ' '
        RET     NZ
        INC     HL
        DEC     B
        JR      CCP_PSKIP

  ; Build one ordinary space-padded 8.3 default FCB while leaving HL/B at the
  ; following separator.

CCP_PFCB:                               ; parse command token into FCB
        PUSH    HL
        PUSH    BC
        PUSH    DE
        XOR     A
        LD      (DE),A
        INC     DE
        LD      B,11
        LD      A,' '

PFCLRL:                                 ; clear parsed FCB fields
        LD      (DE),A
        INC     DE
        DJNZ    PFCLRL
        POP     DE
        POP     BC
        POP     HL
        PUSH    DE

  ; Patch 2026-09-02: the original parser deliberately deferred drive prefixes,
  ; causing an argument such as B: to become the filename "B:" on drive zero.
  ; This compact A:..P: prefix recognizer occupies the final 21 bytes below the
  ; fixed ED00h physical-sector buffer; CCP_STKTOP now ends exactly at ED00h.

        LD      A,(HL)
        SUB     'A'-1
        CP      17
        JR      NC,PFNODRV
        LD      C,A
        INC     HL
        LD      A,(HL)
        DEC     HL
        CP      ':'
        JR      NZ,PFNODRV
        LD      A,C
        LD      (DE),A
        INC     HL
        INC     HL
        DEC     B
        DEC     B

; -------------------------------------------------------------------------------
; Filename Parsing
; -------------------------------------------------------------------------------

PFNODRV:                                ; parse filename without drive prefix
        INC     DE
        LD      C,8

PFNAMEL:                                ; parse filename characters
        LD      A,B
        OR      A
        JR      Z,PFDONE
        LD      A,(HL)
        CP      ' '
        JR      Z,PFDONE
        CP      '.'
        JR      Z,PFDOT
        CP      '*'
        JR      Z,PFNSTAR
        LD      (DE),A
        INC     DE
        INC     HL
        DEC     B
        DEC     C
        JR      NZ,PFNAMEL
        JR      PFSKPN
PFNSTAR:                                ; expand wildcard filename
        LD      A,'?'

PFNSTLP:                                ; fill wildcard filename field
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,PFNSTLP

PFSKPN:                                 ; skip excess filename characters
        LD      A,B
        OR      A
        JR      Z,PFDONE
        LD      A,(HL)
        CP      ' '
        JR      Z,PFDONE
        INC     HL
        DEC     B
        CP      '.'
        JR      NZ,PFSKPN
        JR      PFEXT0

; -------------------------------------------------------------------------------
; Extension Parsing
; -------------------------------------------------------------------------------

PFDOT:                                  ; parse filename extension
        INC     HL
        DEC     B

PFEXT0:                                 ; initialize extension parse
        POP     DE
        PUSH    DE
        LD      A,E
        ADD     A,9
        LD      E,A
        LD      C,3

PFEXTL:                                 ; parse extension characters
        LD      A,B
        OR      A
        JR      Z,PFDONE
        LD      A,(HL)
        CP      ' '
        JR      Z,PFDONE
        CP      '*'
        JR      Z,PFESTAR
        LD      (DE),A
        INC     DE
        INC     HL
        DEC     B
        DEC     C
        JR      NZ,PFEXTL
        JR      PFSKPE
PFESTAR:                                ; expand wildcard extension
        LD      A,'?'

PFESTLP:                                ; fill wildcard extension field
        LD      (DE),A
        INC     DE
        DEC     C
        JR      NZ,PFESTLP

PFSKPE:                                 ; skip excess extension characters
        LD      A,B
        OR      A
        JR      Z,PFDONE
        LD      A,(HL)
        CP      ' '
        JR      Z,PFDONE
        INC     HL
        DEC     B
        JR      PFSKPE

PFDONE:                                 ; finish FCB parse
        POP     DE
        RET

  ; Resident DIR deliberately uses only the public BDOS search interface.  This
  ; keeps the CCP independent of the directory implementation and exercises the
  ; same contract available to transient CP/M programs.

; ================================================================================
; =                             Resident DIR Command                             =
; =                                                                              =
; = Implements the resident directory command, including file-specification      =
; = setup, directory search, and formatted entry display.                        =
; ================================================================================
; -------------------------------------------------------------------------------
; Argument and FCB Setup
; -------------------------------------------------------------------------------

CCP_DIR:                                ; execute resident DIR command
        LD      HL,CCP_DIRFCB
        LD      B,36
        XOR     A

CCP_DCLR:                               ; clear DIR work FCB
        LD      (HL),A
        INC     HL
        DJNZ    CCP_DCLR
        LD      HL,CCP_DIRFCB+1
        LD      B,11
        LD      A,'?'

CCP_DWILD:                              ; supply default DIR wildcard
        LD      (HL),A
        INC     HL
        DJNZ    CCP_DWILD
        LD      DE,0080H
        LD      C,26
        CALL    BDOS
        XOR     A
        LD      (CCP_DFOUND),A
        LD      C,17

; -------------------------------------------------------------------------------
; Directory Search
; -------------------------------------------------------------------------------

CCP_DNEXT:                              ; process next directory match
        LD      DE,CCP_DIRFCB
        CALL    BDOS
        CP      0FFH
        JR      Z,CCP_DDONE
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,080H
        LD      L,A
        LD      H,0
        LD      (CCP_DIREP),HL
        LD      DE,12
        ADD     HL,DE
        LD      A,(HL)
        AND     01FH
        JR      NZ,CCP_DMORE
        INC     HL
        INC     HL
        LD      A,(HL)
        AND     03FH
        JR      NZ,CCP_DMORE
        LD      A,1
        LD      (CCP_DFOUND),A
        LD      DE,CCP_DIRNL
        LD      C,9
        CALL    BDOS
        LD      HL,(CCP_DIREP)
        INC     HL
        LD      B,8
        CALL    CCP_DFIELD
        LD      HL,(CCP_DIREP)
        LD      DE,9
        ADD     HL,DE
        LD      A,(HL)
        CP      ' '
        JR      Z,CCP_DMORE
        LD      E,'.'
        LD      C,2
        CALL    BDOS
        LD      HL,(CCP_DIREP)
        LD      DE,9
        ADD     HL,DE
        LD      B,3
        CALL    CCP_DFIELD

CCP_DMORE:                              ; continue directory search
        LD      C,18
        JR      CCP_DNEXT

CCP_DDONE:                              ; finish DIR command
        RET

; -------------------------------------------------------------------------------
; Entry Formatting
; -------------------------------------------------------------------------------

CCP_DFIELD:                             ; print fixed-width directory field
        LD      (CCP_DFPTR),HL
        LD      A,B
        LD      (CCP_DFCNT),A

CCP_DFLOOP:                             ; print directory field characters
        LD      HL,(CCP_DFPTR)
        LD      A,(HL)
        INC     HL
        LD      (CCP_DFPTR),HL
        AND     07FH
        CP      ' '
        JR      Z,CCP_DFSKIP
        LD      E,A
        LD      C,2
        CALL    BDOS

CCP_DFSKIP:                             ; skip padding in directory field
        LD      HL,CCP_DFCNT
        DEC     (HL)
        JR      NZ,CCP_DFLOOP
        RET

; ================================================================================
; =                         CCP Data and Working Storage                         =
; =                                                                              =
; = Defines command strings, messages, buffers, FCBs, working state,             =
; = persistent interfaces, and stack storage used by the CCP.                    =
; ================================================================================
; -------------------------------------------------------------------------------
; Command Strings and Keywords
; -------------------------------------------------------------------------------

CCP_PROMPT:                             ; prompt prefix string
        DB      13,10,'$'
CCP_UNKNOWN:                            ; unknown-command message
        DB      10,'?','$'
CCP_VERSION:                            ; version string
        DB      10,'BetterCP/M 0.3','$'
CCP_VERKEY:                             ; VERSION command keyword
        DB      'VER'
CCP_DIRKEY:                             ; DIR command keyword
        DB      'DIR'
CCP_WARMKEY:                            ; WARM command keyword
        DB      'WARM'
CU_KEY:                                 ; USER command keyword
        DB      'USER '
CCP_KGET:      DB      'GET'            ; GET command keyword
CCP_KJUMP:     DB      'JUMP'           ; JUMP command keyword
CCP_KPEEK:     DB      'PEEK'           ; PEEK command keyword
CCP_KP:        DB      'P'              ; PEEK abbreviation keyword
CCP_KPOKE:     DB      'POKE'           ; POKE command keyword
CCP_KGO:       DB      'GO'             ; GO command keyword
CCP_KSAVE:     DB      'SAVE'           ; SAVE command keyword
CCP_COM:                                ; .COM extension text
        DB      'COM'

; -------------------------------------------------------------------------------
; Messages
; -------------------------------------------------------------------------------

CCP_MADDR:     DB      13,10,'ADDRESS REQUIRED',13,10,'$' ; address-error message
CCP_MGET:      DB      13,10,'GET filename OR GET address filename',13,10,'$' ; GET usage message
CCP_MPOKE:     DB      13,10,'POKE address byte [byte ...]',13,10,'$' ; POKE usage message
CCP_MPROTECT:  DB      13,10,'PROTECTED MEMORY',13,10,'$' ; protected-memory message
CCP_MTOOBIG:   DB      13,10,'FILE WILL NOT FIT',13,10,'$' ; file-too-large message
CCP_MNOFILE:   DB      13,10,'NO FILE',13,10,'$' ; file-not-found message
CCP_MREAD:     DB      13,10,'READ ERROR',13,10,'$' ; read-error message
CCP_MLOADED:   DB      13,10,'LOADED',13,10,'$' ; GET success message
CCP_MPAGER:    DB      13,10,'< previous  > next  ^C quit $' ; PEEK pager prompt
CCP_MSAVE:     DB      13,10,'? SAVE pages filename',13,10,'$' ; SAVE usage message
CCP_MSPACE:    DB      13,10,'NO SPACE',13,10,'$' ; disk-full message

; -------------------------------------------------------------------------------
; Command and Editor Storage
; -------------------------------------------------------------------------------

CCP_BUFFER:                             ; command buffer base
        DB      127
CCP_COUNT:                              ; command-line length
        DB      0
CCP_DATA:                               ; command-line text
        REPT    127
        DB      0
        ENDM
CCP_EDCUR:                              ; logical editor cursor position
        DB      0
CCP_EDINS:                              ; editor insert-mode flag
        DB      1
CCP_EDCHR:                              ; editor character scratch byte
        DB      0
CCP_FCB:                                ; CCP working FCB
        REPT    36
        DB      0
        ENDM
CLDPTR:                                 ; transient load pointer
        DW      0100H

; -------------------------------------------------------------------------------
; Monitor Command State
; -------------------------------------------------------------------------------

CCP_TADDR:     DW      0100H            ; monitor target address
CCP_APTR:      DW      0                ; argument pointer
CCP_ALEN:      DB      0                ; argument length
CCP_HEXDIG:    DB      0                ; hexadecimal parser digit count
CCP_GRECS:     DW      0                ; GET record count
CCP_GDMA:      DW      0100H            ; GET DMA address
CCP_PLOW:      DW      0                ; PEEK lower bound
CCP_PHIGH:     DW      0FFFFH           ; PEEK upper bound
CCP_PPAGE:     DW      0100H            ; PEEK current page
CCP_PPTR:      DW      0100H            ; PEEK display pointer
CCP_PCNT:      DW      0                ; PEEK byte count
CCP_PBOUND:    DB      0                ; PEEK bound flag
CCP_PCOL:      DB      0                ; PEEK column counter
CCP_PLEN:      DB      0                ; PEEK line length
CCP_SPAGES:    DB      0                ; SAVE page count
CCP_SDMA:      DW      0100H            ; SAVE DMA address
CCP_SRECS:     DW      0                ; SAVE record count
CCP_DARGP:     DW      0                ; DIR argument pointer
CCP_DLEN:      DB      0                ; DIR argument length

; -------------------------------------------------------------------------------
; Drive/User State
; -------------------------------------------------------------------------------

CCP_DSAVE:     DB      0                ; saved default drive
CCP_USAVE:     DB      0                ; saved default user
CCP_DTARG:     DB      0FFH             ; target drive
CCP_UTARG:     DB      0FFH             ; target user
CCP_DUACT:     DB      0                ; drive/user selection flags
CCP_PBUF:                               ; validated POKE byte buffer
        REPT    127
        DB      0
        ENDM

  ; CCP-only loader scratch occupies the otherwise unused compatibility-page
  ; workspace below the default FCBs.  Using fixed page-zero bytes here also
  ; avoids spending scarce relocation-directory entries on ephemeral state.

CCP_NAMEL      EQU     0040H
CCP_CMDLEN     EQU     0041H
CCP_QLEN       EQU     0042H
CCP_LPTR       EQU     0043H
CCP_LREML      EQU     0045H
CCP_LUSAV      EQU     0046H
CCP_LUTRG      EQU     0047H
CCP_LUACT      EQU     0048H
CCP_LDRV       EQU     0049H
CCP_SUBACTIVE  EQU     004AH

; -------------------------------------------------------------------------------
; DIR State
; -------------------------------------------------------------------------------

CCP_DIREP:                              ; DIR entries-per-line count
        DW      0080H
CCP_DFPTR:                              ; DIR field pointer
        DW      0080H
CCP_DFCNT:                              ; DIR field character count
        DB      0
CCP_DFOUND:                             ; DIR match-found flag
        DB      0
CPX_CUR:                                ; current CPX descriptor pointer
        DW      0

  ; Patch 2026-09-02: the first resident DIR used LF alone. The Model 4 console
  ; correctly preserves the horizontal cursor position on LF, which made each
  ; successive filename march diagonally across the screen. CP/M text output
  ; needs an explicit carriage return before line feed.

CCP_DIRNL:                              ; DIR newline string
        DB      13,10,'$'
CCP_DIRFCB:                             ; DIR working FCB
        REPT    36
        DB      0
        ENDM
CCP_RET:                                ; shared return instruction
        DW      0000H

  ; Command execution owns its stack inside the reconstructible CCP allocation.

; -------------------------------------------------------------------------------
; Stack Storage
; -------------------------------------------------------------------------------

CCP_STACK:      DS      128             ; CCP stack storage
CCP_STKTOP:                             ; top of CCP stack

        .DEPHASE
        END
