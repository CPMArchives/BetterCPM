        INCLUDE layout.inc

; ********************************************************************************
; *                     BetterCP/M BRSX Chain Rebuilder                         *
; *                                                                              *
; * BRSX v1/v2 ordered resident-chain manager. Owns one K only while an RSX      *
; * profile is active, loads modules below itself, and returns all manager/module *
; * RAM to the TPA when the final RSX is removed.                                *
; ********************************************************************************

  ; Function 202 passes DE -> request:
  ;   +0 version (1), +1 operation (0 enumerate, 1 load, 2 unload, 3 query,
  ;                                4 retire without rebuilding),
  ;   +2 enumeration index, +3 reserved, +4..+11 space-padded filename stem,
  ;   +12..+13 returned primary service number.


RLBASE          EQU     LY_RSX
FLOPEN          EQU     LY_FILE
FLNEXT          EQU     LY_FILE+3
FLRESET         EQU     LY_FILE+6
MODBUF          EQU     LY_BUF
HISTBASE        EQU     LY_HIST
BASEGATE        EQU     HISTBASE-3
COREBDOS        EQU     LY_BDOS
ECB_RSXHEAD     EQU     LY_SYS+084H
ECB_RSXLOW      EQU     LY_PDSF
ECB_TPATOP      EQU     LY_SYS+090H
RSTCOUNT        EQU     LY_RSTA
RSTABLE         EQU     LY_RSTA+1       ; four ordered eight-byte stems
RSTSERV         EQU     LY_RSTA+021H    ; four primary-service words

        CSEG
        .PHASE  RLBASE

; ================================================================================
; =                          Manager Entry and Control                           =
; =                                                                              =
; = Provides the Function-202 manager boundary, validates the persistent profile count, =
; = and dispatches enumerate, load, unload, query, and retire operations.        =
; ================================================================================
; -------------------------------------------------------------------------------
; Manager Entry
; -------------------------------------------------------------------------------

RL_ENTRY:                               ; enter RSX chain manager
        JP      RL_CONTROL

RL_CHAIN:                               ; chain unhandled BDOS request
        POP     DE
        PUSH    DE
        CALL    RL_CONTROL
        POP     DE
        OR      A
        RET     NZ
        PUSH    DE
        LD      HL,LY_RSX+3
        PUSH    HL
        LD      A,2                     ; overlay two: descriptor materializer
        JP      LY_BIOS+60

; -------------------------------------------------------------------------------
; Function-202 Dispatch
; -------------------------------------------------------------------------------

RL_CONTROL:                             ; dispatch Function-202 control request
        LD      (RL_REQ),DE
        LD      A,(RSTCOUNT)
        CP      5
        JR      C,RL_COUNTOK
        ; Cold-load history: this state originally lived in an implicit gap.
        ; Treat any impossible count as an uninitialized empty active profile.
        XOR     A
        LD      (RSTCOUNT),A

RL_COUNTOK:                             ; accept active-profile count
        LD      A,(DE)
        DEC     A
        CP      2
        RET     NC
        INC     DE
        LD      A,(DE)
        OR      A
        JR      Z,RL_ENUM
        CP      1
        JR      Z,RL_ADD
        CP      2
        JP      Z,RL_REMOVE
        CP      3
        JR      Z,RL_QUERY
        CP      4
        JP      Z,RL_RETIRE
        JP      RL_BAD

; ================================================================================
; =                        Ordered RSX Profile Management                        =
; =                                                                              =
; = Enumerates, queries, adds, removes, retires, finds, and compacts the persistent =
; = ordered RSX reconstruction records.                                          =
; ================================================================================
; -------------------------------------------------------------------------------
; Enumerate and Query
; -------------------------------------------------------------------------------

RL_ENUM:                                ; enumerate configured RSX
        LD      HL,(RL_REQ)
        INC     HL
        INC     HL
        LD      A,(HL)
        LD      B,A
        LD      A,(RSTCOUNT)
        CP      B
        JP      Z,RL_ZERO
        JP      C,RL_ZERO
        LD      A,B
        CALL    RL_TABPTR
        LD      DE,(RL_REQ)
        INC     DE
        INC     DE
        INC     DE
        INC     DE
        LD      BC,8
        LDIR
        LD      HL,(RL_REQ)
        INC     HL
        INC     HL
        LD      A,(HL)
        ADD     A,A
        LD      E,A
        LD      D,0
        LD      HL,RSTSERV
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      HL,(RL_REQ)
        LD      BC,12
        ADD     HL,BC
        LD      (HL),E
        INC     HL
        LD      (HL),D
        LD      A,1
        RET

RL_QUERY:                               ; query configured RSX
        CALL    RL_FIND
        JP      C,RL_ZERO
        LD      A,1
        RET

; -------------------------------------------------------------------------------
; Load Profile Record
; -------------------------------------------------------------------------------

RL_ADD:                                 ; add RSX to ordered profile
        CALL    RL_FIND
        JP      NC,RL_ZERO              ; already active is an idempotent success
        LD      A,(RSTCOUNT)
        CP      4
        JP      NC,RL_BAD
        PUSH    AF
        CALL    RL_TABPTR
        EX      DE,HL
        LD      HL,(RL_REQ)
        LD      BC,4
        ADD     HL,BC
        LD      BC,8
        LDIR
        POP     AF
        INC     A
        LD      (RSTCOUNT),A
        CALL    RL_REBUILD
        RET     Z
        LD      HL,RSTCOUNT
        DEC     (HL)
        JP      RL_BAD

; -------------------------------------------------------------------------------
; Unload Profile Record
; -------------------------------------------------------------------------------

RL_REMOVE:                              ; remove RSX from ordered profile
        CALL    RL_FIND
        JP      C,RL_ZERO               ; absent is an idempotent success
        CALL    RL_SHIFT
        CALL    RL_REBUILD
        RET     Z
        JP      RL_BAD

  ; A running module cannot safely ask the manager to rebuild over its own code.
  ; Operation four removes its reconstruction record only; WBOOT then performs
  ; the ordinary rebuild on the protected system stack.

; -------------------------------------------------------------------------------
; Retire Without Rebuild
; -------------------------------------------------------------------------------

RL_RETIRE:                              ; retire running RSX record
        CALL    RL_FIND
        JP      C,RL_ZERO
        CALL    RL_SHIFT
        JP      RL_ZERO

RL_SHIFT:                               ; compact ordered profile table
        LD      (RL_INDEX),A

RL_SHLOOP:                              ; shift next profile record
        LD      A,(RL_INDEX)
        INC     A
        LD      B,A
        LD      A,(RSTCOUNT)
        CP      B
        JR      Z,RL_SHDONE
        JR      C,RL_SHDONE
        LD      A,B
        CALL    RL_TABPTR
        PUSH    HL
        LD      A,(RL_INDEX)
        CALL    RL_TABPTR
        EX      DE,HL
        POP     HL
        LD      BC,8
        LDIR
        LD      HL,RL_INDEX
        INC     (HL)
        JR      RL_SHLOOP

RL_SHDONE:                              ; finish profile compaction
        LD      HL,RSTCOUNT
        DEC     (HL)
        RET

  ; Find request name. Return carry clear and A=index, or carry set.

; -------------------------------------------------------------------------------
; Profile Name Lookup
; -------------------------------------------------------------------------------

RL_FIND:                                ; find RSX name in profile
        LD      A,(RSTCOUNT)
        LD      B,A
        XOR     A

RL_FLOOP:                               ; scan next profile record
        LD      C,A
        LD      A,B
        OR      A
        JR      Z,RL_FMISS
        LD      A,C
        CALL    RL_TABPTR
        LD      DE,(RL_REQ)
        INC     DE
        INC     DE
        INC     DE
        INC     DE
        PUSH    BC
        LD      B,8

RL_FCMP:                                ; compare profile name
        LD      A,(DE)
        CP      (HL)
        JR      NZ,RL_FNXT
        INC     DE
        INC     HL
        DJNZ    RL_FCMP
        POP     BC
        LD      A,C
        OR      A
        RET

RL_FNXT:                                ; advance profile scan
        POP     BC
        DEC     B
        LD      A,C
        INC     A
        JR      RL_FLOOP

RL_FMISS:                               ; report missing profile name
        SCF
        RET

  ; A=index -> HL=ordered name record.

RL_TABPTR:                              ; locate profile table record
        ADD     A,A
        ADD     A,A
        ADD     A,A
        LD      L,A
        LD      H,0
        LD      DE,RSTABLE
        ADD     HL,DE
        RET

  ; Validate every named carrier before changing the published chain, then load.

; ================================================================================
; =                           RSX Chain Reconstruction                           =
; =                                                                              =
; = Validates every configured carrier before publication, loads the ordered modules, =
; = and atomically publishes either the rebuilt chain or an empty profile.       =
; ================================================================================
; -------------------------------------------------------------------------------
; Preflight Validation
; -------------------------------------------------------------------------------

RL_REBUILD:                             ; rebuild active RSX chain
        XOR     A
        LD      (RL_INDEX),A

RL_VLOOP:                               ; validate next configured carrier
        LD      A,(RL_INDEX)
        LD      B,A
        LD      A,(RSTCOUNT)
        CP      B
        JR      Z,RL_BUILD
        LD      A,B
        CALL    RL_TABPTR
        LD      A,1
        CALL    FLOPEN
        RET     NZ
        LD      HL,MODBUF
        CALL    FLNEXT
        RET     NZ
        CALL    RL_VALID
        RET     NZ
        LD      A,(RL_INDEX)
        ADD     A,A
        LD      E,A
        LD      D,0
        LD      HL,RSTSERV
        ADD     HL,DE
        LD      DE,(MODBUF+46)
        LD      (HL),E
        INC     HL
        LD      (HL),D
        LD      HL,RL_INDEX
        INC     (HL)
        JR      RL_VLOOP

; -------------------------------------------------------------------------------
; Ordered Chain Build
; -------------------------------------------------------------------------------

RL_BUILD:                               ; build validated RSX chain
        LD      HL,LY_RSX
        LD      (RL_LOW),HL
        LD      HL,0
        LD      (ECB_RSXHEAD),HL
        LD      (RL_PREV),HL
        XOR     A
        LD      (RL_INDEX),A

RL_BLOOP:                               ; load next configured carrier
        LD      A,(RL_INDEX)
        LD      B,A
        LD      A,(RSTCOUNT)
        CP      B
        JR      Z,RL_PUBLISH
        LD      A,B
        CALL    RL_TABPTR
        CALL    RL_LOAD
        RET     NZ
        LD      HL,RL_INDEX
        INC     (HL)
        JR      RL_BLOOP

; -------------------------------------------------------------------------------
; Chain Publication
; -------------------------------------------------------------------------------

RL_PUBLISH:                             ; publish rebuilt RSX chain
        LD      HL,(RL_LOW)
        LD      (ECB_RSXLOW),HL
        LD      A,(RSTCOUNT)
        OR      A
        JR      NZ,RL_PGATE
        LD      HL,HISTBASE

RL_PGATE:                               ; publish gateway state
        DEC     HL
        DEC     HL
        DEC     HL
        LD      (ECB_TPATOP),HL

RL_ZERO:                                ; publish empty RSX chain
        XOR     A
        RET

; ================================================================================
; =                       RSX Carrier Load and Relocation                        =
; =                                                                              =
; = Loads one protected RSX carrier below the current boundary, verifies its payload, =
; = applies relocation entries, and links the relocated module into the chain.   =
; ================================================================================
; -------------------------------------------------------------------------------
; Carrier Payload Load
; -------------------------------------------------------------------------------

RL_LOAD:                                ; load RSX carrier
        LD      A,1
        CALL    FLOPEN
        RET     NZ
        LD      HL,MODBUF
        CALL    FLNEXT
        RET     NZ
        CALL    RL_VALID
        RET     NZ
        LD      HL,(RL_LOW)
        LD      DE,(MODBUF+14)
        OR      A
        SBC     HL,DE
        RET     C
        PUSH    HL
        LD      DE,0103H                ; retain at least the CP/M page and gateway
        OR      A
        SBC     HL,DE
        POP     HL
        RET     C
        LD      (RL_BASE),HL
        LD      (RL_LOW),HL
        LD      (RL_DEST),HL
        LD      HL,(MODBUF+12)
        LD      (RL_LEFT),HL

RL_PAY:                                 ; load RSX payload
        LD      HL,(RL_LEFT)
        LD      A,H
        OR      L
        JR      Z,RL_RELOC
        LD      A,H
        CP      2
        JR      C,RL_LAST
        LD      HL,(RL_DEST)
        CALL    FLNEXT
        RET     NZ
        LD      (RL_DEST),HL
        LD      HL,(RL_LEFT)
        LD      DE,0200H
        OR      A
        SBC     HL,DE
        LD      (RL_LEFT),HL
        JR      RL_PAY

RL_LAST:                                ; handle final partial payload
        LD      HL,MODBUF
        CALL    FLNEXT
        RET     NZ
        LD      HL,MODBUF
        LD      DE,(RL_DEST)
        LD      BC,(RL_LEFT)
        LDIR
        LD      HL,0
        LD      (RL_LEFT),HL
        JR      RL_PAY

; -------------------------------------------------------------------------------
; Relocation and Checksum
; -------------------------------------------------------------------------------

RL_RELOC:                               ; prepare RSX relocation
        CALL    FLRESET
        RET     NZ
        LD      HL,MODBUF
        CALL    FLNEXT
        RET     NZ
        LD      HL,(RL_BASE)
        LD      DE,(MODBUF+12)
        LD      BC,0

RL_SUM:                                 ; checksum loaded module
        LD      A,D
        OR      E
        JR      Z,RL_SUMDONE
        LD      A,(HL)
        ADD     A,C
        LD      C,A
        JR      NC,RL_SUMNC
        INC     B

RL_SUMNC:                               ; accumulate checksum without carry
        INC     HL
        DEC     DE
        JR      RL_SUM

RL_SUMDONE:                             ; finish module checksum
        LD      HL,(MODBUF+44)
        LD      A,L
        CP      C
        RET     NZ
        LD      A,H
        CP      B
        RET     NZ
        LD      HL,(RL_BASE)
        LD      DE,(MODBUF+10)
        OR      A
        SBC     HL,DE
        LD      (RL_DELTA),HL
        LD      BC,(MODBUF+22)
        LD      HL,MODBUF+48

RL_RLOOP:                               ; apply next relocation entry
        LD      A,B
        OR      C
        JR      Z,RL_LINK
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     HL
        PUSH    HL
        LD      HL,(MODBUF+12)
        DEC     HL                      ; a relocated word needs two code bytes
        OR      A
        SBC     HL,DE
        JP      Z,RL_ROFFBAD
        JP      C,RL_ROFFBAD
        POP     HL
        PUSH    HL
        PUSH    BC
        LD      HL,(RL_BASE)
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        LD      BC,(RL_DELTA)
        ADD     HL,BC
        EX      DE,HL
        LD      (HL),D
        DEC     HL
        LD      (HL),E
        POP     BC
        POP     HL
        DEC     BC
        JR      RL_RLOOP

RL_ROFFBAD:                             ; reject invalid relocation offset
        POP     HL
        JP      RL_BAD

; -------------------------------------------------------------------------------
; RSX Chain Linkage
; -------------------------------------------------------------------------------

RL_LINK:                                ; link relocated RSX
        LD      DE,(MODBUF+16)
        LD      HL,(RL_BASE)
        ADD     HL,DE
        LD      (RL_DISPATCH),HL
        EX      DE,HL
        LD      HL,(RL_BASE)
        INC     HL
        INC     HL
        LD      (HL),E
        INC     HL
        LD      (HL),D
        LD      HL,(RL_BASE)
        LD      (HL),LOW COREBDOS
        INC     HL
        LD      (HL),HIGH COREBDOS      ; default next dispatch is the fixed core
        LD      HL,(RL_PREV)
        LD      A,H
        OR      L
        JR      NZ,RL_LPREV
        LD      HL,(RL_BASE)
        LD      (ECB_RSXHEAD),HL
        JR      RL_LDONE

RL_LPREV:                               ; update previous RSX link
        LD      DE,(RL_DISPATCH)
        LD      (HL),E
        INC     HL
        LD      (HL),D

RL_LDONE:                               ; finish RSX link
        LD      HL,(RL_BASE)
        LD      (RL_PREV),HL
        XOR     A
        RET

; ================================================================================
; =                            RSX Carrier Validation                            =
; =                                                                              =
; = Validates carrier magic, ABI metadata, module size, and structural constraints =
; = before any published chain is changed.                                       =
; ================================================================================
; -------------------------------------------------------------------------------
; Carrier Structure Validation
; -------------------------------------------------------------------------------

RL_VALID:                               ; validate RSX carrier
        LD      HL,MODBUF
        LD      DE,RL_MAGIC
        LD      B,4

RL_MLOOP:                               ; match carrier magic
        LD      A,(DE)
        CP      (HL)
        JR      Z,RL_MOK
        JP      RL_BAD

RL_MOK:                                 ; accept carrier magic
        INC     DE
        INC     HL
        DJNZ    RL_MLOOP
        LD      A,(HL)
        CP      1
        JR      Z,RL_VOK
        CP      2
        JP      NZ,RL_BAD

RL_VOK:                                 ; accept validated carrier
        INC     HL
        LD      DE,RL_ABI
        LD      B,3

RL_ALOOP:                               ; validate ABI metadata
        LD      A,(DE)
        CP      (HL)
        JP      NZ,RL_BAD
        INC     DE
        INC     HL
        DJNZ    RL_ALOOP
        LD      HL,(MODBUF+8)           ; flags must be zero
        LD      A,H
        OR      L
        JR      NZ,RL_BAD
        LD      HL,(MODBUF+12)
        LD      A,H
        OR      L
        JR      Z,RL_BAD
        LD      DE,(MODBUF+14)
        OR      A
        SBC     HL,DE
        JR      C,RL_VSIZE
        JR      Z,RL_VSIZE
        JR      RL_BAD

RL_VSIZE:                               ; validate module size
        LD      HL,(MODBUF+14)
        LD      A,H
        OR      A
        JR      Z,RL_BAD
        LD      A,L
        OR      A
        JR      NZ,RL_BAD               ; whole-page allocation
        LD      HL,(MODBUF+16)
        LD      DE,(MODBUF+12)
        OR      A
        SBC     HL,DE
        JR      NC,RL_BAD
        LD      HL,(MODBUF+22)
        LD      A,H
        OR      A
        JR      NZ,RL_BAD
        LD      A,L
        CP      233
        JR      NC,RL_BAD
        LD      HL,(MODBUF+24)
        LD      DE,0200H
        OR      A
        SBC     HL,DE
        JR      NZ,RL_BAD
        LD      HL,(MODBUF+26)
        LD      DE,0200H
        OR      A
        SBC     HL,DE
        JR      NZ,RL_BAD
        LD      HL,(MODBUF+28)
        LD      DE,48
        OR      A
        SBC     HL,DE
        JR      NZ,RL_BAD
        LD      HL,(MODBUF+12)
        LD      DE,0200H
        ADD     HL,DE
        LD      DE,(MODBUF+30)
        OR      A
        SBC     HL,DE
        JR      NZ,RL_BAD
        LD      A,(RL_INDEX)
        CALL    RL_TABPTR
        LD      DE,MODBUF+32
        LD      B,8

RL_NMCMP:                               ; compare requested RSX name
        LD      A,(DE)
        CP      (HL)
        JR      NZ,RL_BAD
        INC     DE
        INC     HL
        DJNZ    RL_NMCMP
        XOR     A
        RET

RL_BAD:                                 ; return manager failure
        LD      A,0FFH
        OR      A
        RET

; ================================================================================
; =                            Manager Working State                             =
; =                                                                              =
; = Defines carrier constants and the private request, placement, linkage, relocation, =
; = and profile-index state used by the chain manager.                           =
; ================================================================================
; -------------------------------------------------------------------------------
; Manager State
; -------------------------------------------------------------------------------

RL_MAGIC:       DB      'B','R','S','X' ; RSX carrier magic
RL_ABI:         DB      2,1,0           ; supported RSX ABI version
RL_REQ:         DW      0               ; active control request pointer
RL_LOW:         DW      0               ; current RSX lower boundary
RL_BASE:        DW      0               ; current module runtime base
RL_PREV:        DW      0               ; previous RSX descriptor
RL_DISPATCH:    DW      0               ; current module dispatch entry
RL_DEST:        DW      0               ; module load destination
RL_LEFT:        DW      0               ; module bytes remaining
RL_DELTA:       DW      0               ; module relocation delta
RL_INDEX:       DB      0               ; profile-table index
        .DEPHASE
        END
