; ********************************************************************************
; *                    BetterCP/M RSX Move Scheduler                             *
; *                                                                              *
; * Phase-3 scheduler for validated STATEFUL movement plans. Validates plan       *
; * classes, ranges, repair-slot capacity, and one common movement direction     *
; * before invoking the live-allocation mover for any module.                    *
; ********************************************************************************

  ; DE -> request:
  ;   +0 plan records, +2 slot descriptors, +4 count, +5 reserved
  ;   +6 mover-request scratch, +8 scratch bytes, +10 mover entry
  ;   +12 returned move count (written only on success)

  ; Plan records are the eight-byte records from RSXPLAN. Slot descriptors are
  ; three bytes per record: union address word and union count byte.


RSBASE          EQU     07800H

        CSEG
        .PHASE  RSBASE

; ================================================================================
; =                             Schedule Validation                              =
; =                                                                              =
; = Validates the RSXPLAN records and repair-slot descriptors, establishes a common =
; = safe movement direction, and rejects the complete schedule before any move if invalid. =
; ================================================================================
; -------------------------------------------------------------------------------
; Plan Validation
; -------------------------------------------------------------------------------

RS_ENTRY:                               ; enter stateful move scheduler
        LD      (RS_REQ),DE
        EX      DE,HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (RS_PLAN),DE
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (RS_DESC),DE
        INC     HL
        LD      A,(HL)
        CP      5
        JP      NC,RS_BAD
        LD      (RS_COUNT),A
        INC     HL
        LD      A,(HL)
        OR      A
        JP      NZ,RS_BAD
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (RS_SCRATCH),DE
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (RS_CAP),DE
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (RS_MOVER),DE

  ; Validate plan classes, ranges, slot scratch capacity, and one common move
  ; direction before invoking the first mover.
        XOR     A
        LD      (RS_DIRECTION),A
        LD      (RS_INDEX),A

RS_VLOOP:                               ; validate next movement-plan record
        LD      A,(RS_INDEX)
        LD      B,A
        LD      A,(RS_COUNT)
        CP      B
        JP      Z,RS_PREPARE
        LD      A,(RS_INDEX)
        CALL    RS_RECORD
        PUSH    HL
        LD      DE,6
        ADD     HL,DE
        LD      A,(HL)
        POP     HL
        CP      4
        JP      NC,RS_BAD
        CP      1
        JR      NZ,RS_VNEXT
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      A,D
        OR      E
        JR      Z,RS_VNEXT
        LD      (RS_OLD),DE
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (RS_NEW),DE
        INC     HL
        LD      C,(HL)
        INC     HL
        LD      B,(HL)
        LD      A,B
        OR      C
        JP      Z,RS_BAD
        PUSH    BC
        LD      HL,(RS_OLD)
        ADD     HL,BC
        JP      C,RS_BADPOP
        LD      HL,(RS_NEW)
        ADD     HL,BC
        JP      C,RS_BADPOP
        POP     BC
        LD      HL,(RS_OLD)
        LD      DE,(RS_NEW)
        OR      A
        SBC     HL,DE
        JR      Z,RS_VNEXT
        LD      A,1                     ; new > old: upward, profile order
        JR      C,RS_VDIR
        INC     A                       ; new < old: downward, reverse profile order

; -------------------------------------------------------------------------------
; Movement Direction Validation
; -------------------------------------------------------------------------------

RS_VDIR:                                ; validate common move direction
        LD      B,A
        LD      A,(RS_DIRECTION)
        OR      A
        JR      Z,RS_VFIRST
        CP      B
        JP      NZ,RS_BAD
        JR      RS_VSLOTS

RS_VFIRST:                              ; accept first movement direction
        LD      A,B
        LD      (RS_DIRECTION),A

; -------------------------------------------------------------------------------
; Repair-Slot Capacity
; -------------------------------------------------------------------------------

RS_VSLOTS:                              ; validate repair-slot capacity
        LD      A,(RS_INDEX)
        CALL    RS_DESCRIPTOR
        INC     HL
        INC     HL
        LD      A,(HL)
        ADD     A,A
        LD      E,A
        LD      D,0
        LD      HL,8
        ADD     HL,DE
        LD      DE,(RS_CAP)
        OR      A
        SBC     HL,DE
        JP      C,RS_VNEXT
        JP      Z,RS_VNEXT
        JP      RS_BAD

RS_BADPOP:                              ; reject invalid stateful population
        POP     BC
        JP      RS_BAD

RS_VNEXT:                               ; advance validation scan
        LD      HL,RS_INDEX
        INC     (HL)
        JP      RS_VLOOP

; ================================================================================
; =                           Stateful Move Execution                            =
; =                                                                              =
; = Executes validated stateful moves in forward or reverse order as required by the =
; = common direction, preparing one guarded mover request per module.            =
; ================================================================================
; -------------------------------------------------------------------------------
; Execution Setup
; -------------------------------------------------------------------------------

RS_PREPARE:                             ; prepare movement execution
        XOR     A
        LD      (RS_MOVES),A
        LD      A,(RS_COUNT)
        OR      A
        JP      Z,RS_DONE
        LD      B,A
        LD      A,(RS_DIRECTION)
        CP      2
        JR      NZ,RS_FORWARD
        LD      A,B
        DEC     A
        LD      (RS_INDEX),A
        JR      RS_EXEC

; -------------------------------------------------------------------------------
; Forward Schedule
; -------------------------------------------------------------------------------

RS_FORWARD:                             ; execute forward-order schedule
        XOR     A
        LD      (RS_INDEX),A

; -------------------------------------------------------------------------------
; Mover Invocation
; -------------------------------------------------------------------------------

RS_EXEC:                                ; execute one stateful move
        LD      A,(RS_INDEX)
        CALL    RS_RECORD
        PUSH    HL
        LD      DE,6
        ADD     HL,DE
        LD      A,(HL)
        POP     HL
        CP      1
        JR      NZ,RS_NEXT
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      A,D
        OR      E
        JR      Z,RS_NEXT
        LD      (RS_OLD),DE
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (RS_NEW),DE
        LD      HL,(RS_OLD)
        OR      A
        SBC     HL,DE
        JR      Z,RS_NEXT
        LD      A,(RS_INDEX)
        CALL    RS_RECORD
        LD      DE,4
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (RS_SIZE),DE
        LD      A,(RS_INDEX)
        CALL    RS_DESCRIPTOR
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     HL
        LD      A,(HL)
        LD      (RS_SCOUNT),A
        EX      DE,HL
        LD      DE,(RS_SCRATCH)
        PUSH    HL
        LD      HL,(RS_OLD)
        EX      DE,HL
        LD      (HL),E
        INC     HL
        LD      (HL),D
        INC     HL
        LD      DE,(RS_NEW)
        LD      (HL),E
        INC     HL
        LD      (HL),D
        INC     HL
        LD      DE,(RS_SIZE)
        LD      (HL),E
        INC     HL
        LD      (HL),D
        INC     HL
        LD      A,(RS_SCOUNT)
        LD      (HL),A
        INC     HL
        LD      (HL),0
        INC     HL
        EX      DE,HL                   ; DE=scratch+8
        POP     HL                      ; HL=slot union
        LD      A,(RS_SCOUNT)
        ADD     A,A
        LD      C,A
        LD      B,0
        LDIR
        LD      DE,(RS_SCRATCH)
        LD      HL,(RS_MOVER)
        LD      BC,RS_RETURN
        PUSH    BC
        JP      (HL)

RS_RETURN:                              ; finish mover invocation
        OR      A
        JP      NZ,RS_BAD
        LD      HL,RS_MOVES
        INC     (HL)

RS_NEXT:                                ; advance scheduled move
        LD      A,(RS_DIRECTION)
        CP      2
        JR      Z,RS_REVERSE
        LD      HL,RS_INDEX
        INC     (HL)
        LD      A,(HL)
        LD      B,A
        LD      A,(RS_COUNT)
        CP      B
        JP      NZ,RS_EXEC
        JP      RS_DONE

; -------------------------------------------------------------------------------
; Reverse Schedule
; -------------------------------------------------------------------------------

RS_REVERSE:                             ; execute reverse-order schedule
        LD      A,(RS_INDEX)
        OR      A
        JR      Z,RS_DONE
        DEC     A
        LD      (RS_INDEX),A
        JP      RS_EXEC

RS_DONE:                                ; finish successful schedule
        LD      HL,(RS_REQ)
        LD      DE,12
        ADD     HL,DE
        LD      A,(RS_MOVES)
        LD      (HL),A
        XOR     A
        RET

  ; A=index -> HL=plan record.

; ================================================================================
; =                          Plan and Descriptor Lookup                          =
; =                                                                              =
; = Locates the fixed-size movement-plan records and their corresponding repair-slot =
; = descriptors by schedule index.                                               =
; ================================================================================
; -------------------------------------------------------------------------------
; Plan Record Lookup
; -------------------------------------------------------------------------------

RS_RECORD:                              ; locate movement-plan record
        ADD     A,A
        ADD     A,A
        ADD     A,A
        LD      E,A
        LD      D,0
        LD      HL,(RS_PLAN)
        ADD     HL,DE
        RET
  ; A=index -> HL=three-byte slot descriptor.

; -------------------------------------------------------------------------------
; Slot Descriptor Lookup
; -------------------------------------------------------------------------------

RS_DESCRIPTOR:                          ; locate repair-slot descriptor
        LD      E,A
        ADD     A,A
        ADD     A,E
        LD      E,A
        LD      D,0
        LD      HL,(RS_DESC)
        ADD     HL,DE
        RET

RS_BAD:                                 ; return scheduling failure
        LD      A,0FFH
        OR      A
        RET

; ================================================================================
; =                           Scheduler Working State                            =
; =                                                                              =
; = Defines request, plan, descriptor, mover, direction, index, scratch-capacity, and =
; = completed-move state used by the scheduler.                                  =
; ================================================================================
; -------------------------------------------------------------------------------
; Scheduler State
; -------------------------------------------------------------------------------

RS_REQ:         DW      0               ; scheduler request pointer
RS_PLAN:        DW      0               ; movement-plan pointer
RS_DESC:        DW      0               ; slot-descriptor pointer
RS_SCRATCH:     DW      0               ; mover scratch pointer
RS_CAP:         DW      0               ; scratch capacity
RS_MOVER:       DW      0               ; mover entry address
RS_OLD:         DW      0               ; current old base
RS_NEW:         DW      0               ; current new base
RS_SIZE:        DW      0               ; current allocation size
RS_COUNT:       DB      0               ; plan record count
RS_INDEX:       DB      0               ; current plan index
RS_DIRECTION:   DB      0               ; common movement direction
RS_SCOUNT:      DB      0               ; repair-slot count
RS_MOVES:       DB      0               ; completed move count

        .DEPHASE
        END
