        INCLUDE layout.inc

; ********************************************************************************
; *                     BetterCP/M BRSX Profile Validator                       *
; *                                                                              *
; * BRSX v2 LOAD-carrier validator. Function 202 passes the candidate request in *
; * DE; this overlay validates the carrier and its metadata before reconstruction*
; * and never changes the published RSX profile itself.                          *
; ********************************************************************************


RVBASE          EQU     LY_RSX
FLOPEN          EQU     LY_FILE
FLNEXT          EQU     LY_FILE+3
MODBUF          EQU     LY_BUF
ECB_RSXHEAD     EQU     LY_SYS+084H
COREBDOS        EQU     LY_BDOS

        CSEG
        .PHASE  RVBASE

; ================================================================================
; =                      Validator Entry and Carrier Header                      =
; =                                                                              =
; = Dispatches the validation request and checks carrier magic, ABI/version fields, =
; = legacy-v1 compatibility, and the candidate's basic structural bounds.        =
; ================================================================================
; -------------------------------------------------------------------------------
; Request and Header Validation
; -------------------------------------------------------------------------------

RV_ENTRY:                               ; enter BRSX profile validator
        JP      RV_CONTROL

RV_CONTROL:                             ; dispatch validator request
        LD      (RV_REQ),DE
        LD      A,(DE)
        DEC     A
        CP      2
        RET     NC
        INC     DE
        LD      A,(DE)
        CP      1                       ; only LOAD introduces a new carrier
        JR      Z,RV_LOAD
        CP      5                       ; known enumerate/load/unload/query/retire
        JP      NC,RV_BAD
        JP      RV_OK

RV_LOAD:                                ; validate LOAD carrier
        LD      HL,(RV_REQ)
        LD      DE,4
        ADD     HL,DE
        LD      A,1
        CALL    FLOPEN
        JP      NZ,RV_BAD
        LD      HL,MODBUF
        CALL    FLNEXT
        JP      NZ,RV_BAD
        LD      HL,MODBUF
        LD      DE,RVMAGIC
        LD      B,4

RV_MAGLP:                               ; match carrier magic
        LD      A,(DE)
        CP      (HL)
        JP      NZ,RV_BAD
        INC     DE
        INC     HL
        DJNZ    RV_MAGLP
        LD      A,(HL)
        CP      1
        JR      Z,RV_V1
        CP      2
        JP      NZ,RV_BAD
        INC     HL
        LD      DE,RV_ABI
        LD      B,3

RV_ABILP:                               ; validate carrier ABI fields
        LD      A,(DE)
        CP      (HL)
        JP      NZ,RV_BAD
        INC     DE
        INC     HL
        DJNZ    RV_ABILP
        LD      HL,(MODBUF+8)
        LD      A,H
        OR      L                       ; Stage 2 accepts STATELESS and no reserved bits
        JP      NZ,RV_BAD
        LD      HL,(MODBUF+12)
        LD      A,H
        OR      L
        JP      Z,RV_BAD
        LD      (RV_LEFT),HL
        LD      (RV_CODE),HL
        LD      DE,(MODBUF+14)
        LD      (RV_ALLOC),DE
        OR      A
        SBC     HL,DE
        JP      NC,RV_BAD               ; payload must be smaller than allocation
        LD      A,E
        OR      A
        JP      NZ,RV_BAD               ; allocation is page-rounded
        LD      HL,(MODBUF+16)
        LD      DE,8
        OR      A
        SBC     HL,DE
        JP      C,RV_BAD
        LD      HL,(RV_CODE)
        LD      DE,(MODBUF+16)
        OR      A
        SBC     HL,DE
        JP      C,RV_BAD
        JP      Z,RV_BAD
        LD      HL,(MODBUF+30)
        LD      DE,0200H
        OR      A
        SBC     HL,DE
        LD      DE,(MODBUF+12)
        OR      A
        SBC     HL,DE
        JP      NZ,RV_BAD               ; metadata follows payload exactly
        CALL    RV_FINDMETA
        JP      NZ,RV_BAD
        CALL    RV_METADATA
        JP      NZ,RV_BAD
        JP      RV_OK

; -------------------------------------------------------------------------------
; Legacy v1 Validation
; -------------------------------------------------------------------------------

RV_V1:                                  ; validate legacy v1 carrier
        INC     HL
        LD      DE,RV_ABI
        LD      B,3

RV_V1ABI:                               ; validate legacy ABI metadata
        LD      A,(DE)
        CP      (HL)
        JP      NZ,RV_BAD
        INC     DE
        INC     HL
        DJNZ    RV_V1ABI
        LD      HL,(MODBUF+8)
        LD      A,H
        OR      L
        JP      NZ,RV_BAD
        JP      RV_OK

  ; Request byte +3 is reserved publicly. The isolated test sets it nonzero to
  ; request an ordinary return; production zero chains into the rebuilder.

RV_OK:                                  ; finish successful validation
        LD      HL,(RV_REQ)
        INC     HL
        INC     HL
        INC     HL
        LD      A,(HL)
        OR      A
        JR      Z,RV_CHAIN
        XOR     A
        RET

; -------------------------------------------------------------------------------
; Validated Load Handoff
; -------------------------------------------------------------------------------

RV_CHAIN:                               ; chain validated load to rebuilder
        LD      (HL),0A5H               ; private phase-chain marker
        LD      DE,(RV_REQ)
        PUSH    DE
        LD      HL,LY_RSX+3
        PUSH    HL
        XOR     A                       ; overlay zero: rebuilder
        JP      LY_BIOS+60

  ; Position RV_META at the metadata bytes. FLNEXT advances 512 bytes per call.

; ================================================================================
; =                    Metadata Location and Base Validation                     =
; =                                                                              =
; = Locates metadata across carrier blocks and validates the v2 base metadata before =
; = processing typed metadata records.                                           =
; ================================================================================
; -------------------------------------------------------------------------------
; Metadata Positioning
; -------------------------------------------------------------------------------

RV_FINDMETA:                            ; locate carrier metadata
        LD      HL,(RV_LEFT)
        LD      A,H
        CP      2
        JR      C,RV_MLAST
        LD      HL,MODBUF
        CALL    FLNEXT
        RET     NZ
        LD      HL,(RV_LEFT)
        LD      DE,0200H
        OR      A
        SBC     HL,DE
        LD      (RV_LEFT),HL
        JR      RV_FINDMETA

RV_MLAST:                               ; handle final metadata block
        LD      A,H
        OR      L
        JR      Z,RV_MEXACT
        PUSH    HL
        LD      HL,MODBUF
        CALL    FLNEXT
        POP     DE
        RET     NZ
        LD      HL,MODBUF
        ADD     HL,DE
        LD      (RV_META),HL
        XOR     A
        RET

RV_MEXACT:                              ; accept exact metadata location
        LD      HL,MODBUF
        CALL    FLNEXT
        RET     NZ
        LD      HL,MODBUF
        LD      (RV_META),HL
        XOR     A
        RET

; -------------------------------------------------------------------------------
; Base Metadata
; -------------------------------------------------------------------------------

RV_METADATA:                            ; validate v2 metadata
        LD      HL,(RV_META)
        LD      (RV_START),HL
        LD      DE,RV_BMET
        LD      B,4

RV_BMETLP:                              ; validate base metadata
        LD      A,(DE)
        CP      (HL)
        JP      NZ,RV_BAD
        INC     DE
        INC     HL
        DJNZ    RV_BMETLP
        LD      A,(HL)
        CP      1
        JP      NZ,RV_BAD
        INC     HL
        LD      A,(HL)
        OR      A
        JP      NZ,RV_BAD
        INC     HL
        LD      A,(HL)
        CP      12
        JP      NZ,RV_BAD
        INC     HL
        LD      A,(HL)
        LD      (RV_NREC),A
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      A,D
        CP      2
        JP      NC,RV_BAD               ; metadata must fit this 512-byte window
        LD      A,E
        CP      12
        JP      C,RV_BAD
        LD      HL,(RV_START)
        ADD     HL,DE
        LD      (RV_END),HL
        LD      DE,MODBUF+0200H
        OR      A
        SBC     HL,DE
        JR      C,RV_ENDFITS
        JP      NZ,RV_BAD

RV_ENDFITS:                             ; accept metadata end bound
        LD      HL,(RV_START)
        LD      DE,10
        ADD     HL,DE
        LD      A,(HL)
        INC     HL
        OR      (HL)                    ; reserved word
        JP      NZ,RV_BAD
        INC     HL
        XOR     A
        LD      (RV_NSVC),A

; ================================================================================
; =                          Metadata Record Validation                          =
; =                                                                              =
; = Walks typed metadata records, validates record bounds and service definitions, =
; = and rejects malformed or conflicting callable metadata.                      =
; ================================================================================
; -------------------------------------------------------------------------------
; Typed Record Walk
; -------------------------------------------------------------------------------

RV_RLOOP:                               ; validate next metadata record
        LD      A,(RV_NREC)
        OR      A
        JP      Z,RV_RECDONE
        DEC     A
        LD      (RV_NREC),A
        CALL    RV_ROOM2
        JR      C,RV_ROOMOK
        JP      NZ,RV_BAD

RV_ROOMOK:                              ; accept record bounds
        LD      A,(HL)
        INC     HL
        LD      B,(HL)
        INC     HL
        LD      A,B
        OR      A
        JP      Z,RV_BAD
        PUSH    HL
        LD      E,B
        LD      D,0
        ADD     HL,DE
        LD      DE,(RV_END)
        OR      A
        SBC     HL,DE
        POP     HL
        JP      C,RV_RTYPE
        JP      NZ,RV_BAD

RV_RTYPE:                               ; dispatch metadata record type
        DEC     HL
        DEC     HL
        LD      A,(HL)
        INC     HL
        INC     HL
        CP      1
        JR      Z,RV_NUMERIC
        CP      2
        JR      Z,RV_CALLABLE
        CP      3
        JP      Z,RV_POINTERS
        JP      RV_BAD                  ; metadata 1.0 has no optional types

RV_NUMERIC:                             ; validate numeric service record
        JP      RV_SKIP                 ; any nonempty byte vector is valid

; -------------------------------------------------------------------------------
; Callable Service Record
; -------------------------------------------------------------------------------

RV_CALLABLE:                            ; validate callable service record
        LD      A,B
        CP      10
        JP      NZ,RV_BAD
        LD      A,(RV_NSVC)
        INC     A
        CP      3
        JP      NC,RV_BAD
        LD      (RV_NSVC),A
        PUSH    HL
        PUSH    BC
        CALL    RV_ID
        POP     BC
        POP     HL
        JP      NZ,RV_BAD
        PUSH    HL
        PUSH    BC
        CALL    RV_ACTIVEID
        POP     BC
        POP     HL
        JP      NZ,RV_BAD
        LD      A,(RV_NSVC)
        CP      1
        JR      NZ,RV_IDSECOND
        PUSH    HL
        PUSH    BC
        LD      DE,RV_IDONE
        LD      BC,4
        LDIR
        POP     BC
        POP     HL
        JR      RV_IDENTRY

RV_IDSECOND:                            ; check second service ID
        PUSH    HL
        PUSH    BC
        LD      DE,RV_IDONE
        LD      B,4

RV_IDCMP:                               ; compare service identifiers
        LD      A,(DE)
        CP      (HL)
        JR      NZ,RV_IDDIFF
        INC     DE
        INC     HL
        DJNZ    RV_IDCMP
        POP     BC
        POP     HL
        JP      RV_BAD                  ; duplicate within one provider

RV_IDDIFF:                              ; accept distinct service ID
        POP     BC
        POP     HL

RV_IDENTRY:                             ; validate callable entry offset
        PUSH    HL
        LD      DE,6
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      HL,(RV_CODE)
        OR      A
        SBC     HL,DE
        POP     HL
        JP      C,RV_BAD
        JP      Z,RV_BAD
        LD      A,D
        OR      A
        JP      NZ,RV_SKIP
        LD      A,E
        CP      8
        JP      C,RV_BAD
        JP      RV_SKIP

  ; Reject an ID already published by the live profile. Legacy providers are
  ; skipped; their numeric-service headers contain no callable descriptors.

; ================================================================================
; =                       Active Service-ID Conflict Check                       =
; =                                                                              =
; = Scans the currently published BRSX-v2 providers to reject a callable service ID =
; = already present in the live profile.                                         =
; ================================================================================
; -------------------------------------------------------------------------------
; Published-ID Scan
; -------------------------------------------------------------------------------

RV_ACTIVEID:                            ; check service ID against active profile
        LD      (RV_CAND),HL
        LD      HL,(ECB_RSXHEAD)
        LD      B,4

RV_ALOOP:                               ; scan active providers
        LD      A,H
        OR      L
        RET     Z
        LD      (RV_LBASE),HL
        INC     HL
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (RV_LDISP),DE
        LD      HL,(RV_LBASE)
        LD      DE,8
        ADD     HL,DE
        LD      DE,(RV_LDISP)
        OR      A
        SBC     HL,DE
        JR      NZ,RV_ANEXT
        LD      HL,(RV_LBASE)
        LD      DE,4
        ADD     HL,DE
        LD      C,(HL)
        INC     HL
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      HL,(RV_LBASE)
        ADD     HL,DE

RV_AIDLP:                               ; scan active service IDs
        LD      A,C
        OR      A
        JR      Z,RV_ANEXT
        PUSH    BC
        PUSH    HL
        LD      DE,(RV_CAND)
        LD      B,4

RV_AIDCMP:                              ; compare active service ID
        LD      A,(DE)
        CP      (HL)
        JR      NZ,RV_AIDIFF
        INC     DE
        INC     HL
        DJNZ    RV_AIDCMP
        POP     HL
        POP     BC
        LD      A,1
        OR      A
        RET

RV_AIDIFF:                              ; continue active-ID scan
        POP     HL
        LD      DE,10
        ADD     HL,DE
        POP     BC
        DEC     C
        JR      RV_AIDLP

RV_ANEXT:                               ; advance active provider
        LD      HL,(RV_LBASE)
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      HL,COREBDOS
        OR      A
        SBC     HL,DE
        RET     Z
        LD      (RV_LDISP),DE
        EX      DE,HL
        LD      DE,8
        OR      A
        SBC     HL,DE
        PUSH    HL
        INC     HL
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      HL,(RV_LDISP)
        OR      A
        SBC     HL,DE
        POP     HL
        JR      Z,RV_ABASE
        LD      HL,(RV_LDISP)
        LD      DE,4
        OR      A
        SBC     HL,DE

RV_ABASE:                               ; accept active provider base
        DEC     B
        JP      NZ,RV_ALOOP
        XOR     A
        RET

; ================================================================================
; =                       Pointer-Slot Metadata Validation                       =
; =                                                                              =
; = Validates sorted, unique pointer-slot offsets and their bounds within the    =
; = candidate allocation.                                                        =
; ================================================================================
; -------------------------------------------------------------------------------
; Pointer-Slot List
; -------------------------------------------------------------------------------

RV_POINTERS:                            ; validate pointer-slot metadata
        LD      A,B
        AND     1
        JP      NZ,RV_BAD
        PUSH    HL
        PUSH    BC
        LD      C,B
        LD      B,0
        XOR     A
        LD      (RV_PSEEN),A

RV_PTRLOOP:                             ; validate next pointer offset
        LD      A,C
        OR      A
        JR      Z,RV_PTROK
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     HL
        DEC     C
        DEC     C
        LD      A,D
        OR      E
        JR      Z,RV_PTRBAD
        LD      A,D
        OR      A
        JR      NZ,RV_PTRNZ
        LD      A,E
        CP      8
        JR      C,RV_PTRBAD

RV_PTRNZ:                               ; validate nonzero pointer offset
        PUSH    HL
        LD      HL,(RV_ALLOC)
        DEC     HL
        OR      A
        SBC     HL,DE
        POP     HL
        JR      C,RV_PTRBAD
        LD      A,(RV_PSEEN)
        OR      A
        JR      Z,RV_PTRFIRST
        PUSH    HL
        LD      HL,(RV_PREV)
        OR      A
        SBC     HL,DE
        POP     HL
        JR      NC,RV_PTRBAD

RV_PTRFIRST:                            ; accept first pointer offset
        LD      (RV_PREV),DE
        LD      A,1
        LD      (RV_PSEEN),A
        JR      RV_PTRLOOP

RV_PTRBAD:                              ; reject invalid pointer list
        POP     BC
        POP     HL
        JP      RV_BAD

RV_PTROK:                               ; accept pointer list
        POP     BC
        POP     HL

RV_SKIP:                                ; finish accepted metadata record
        LD      E,B
        LD      D,0
        ADD     HL,DE
        JP      RV_RLOOP

RV_RECDONE:                             ; finish metadata record
        LD      DE,(RV_END)
        OR      A
        SBC     HL,DE
        JP      NZ,RV_BAD
        XOR     A
        RET

RV_ROOM2:                               ; accept remaining metadata room
        PUSH    HL
        INC     HL
        INC     HL
        LD      DE,(RV_END)
        OR      A
        SBC     HL,DE
        POP     HL
        RET

  ; Validate a nonblank uppercase/space-padded four-byte service ID.

; ================================================================================
; =                        Service Identifier Validation                         =
; =                                                                              =
; = Validates nonblank uppercase/space-padded four-byte service identifiers used by =
; = callable service metadata.                                                   =
; ================================================================================
; -------------------------------------------------------------------------------
; Service-ID Syntax
; -------------------------------------------------------------------------------

RV_ID:                                  ; validate service identifier
        LD      B,4
        LD      C,0

RV_IDLP:                                ; scan service-ID character
        LD      A,(HL)
        CP      ' '
        JR      Z,RV_IDNEXT
        CP      'A'
        JR      C,RV_IDBAD
        CP      'Z'+1
        JR      NC,RV_IDBAD
        LD      C,1

RV_IDNEXT:                              ; advance service-ID scan
        INC     HL
        DJNZ    RV_IDLP
        LD      A,C
        OR      A
        JR      Z,RV_IDBAD
        XOR     A
        RET

RV_IDBAD:                               ; reject invalid service ID
        LD      A,1
        OR      A
        RET

RV_BAD:                                 ; return validation failure
        LD      A,0FFH
        OR      A
        RET

; ================================================================================
; =                           Validator Working State                            =
; =                                                                              =
; = Defines carrier constants and the candidate, metadata, service, pointer-list, and =
; = active-profile scratch state used during validation.                         =
; ================================================================================
; -------------------------------------------------------------------------------
; Validator State
; -------------------------------------------------------------------------------

RVMAGIC:       DB      'B','R','S','X'  ; BRSX carrier magic
RV_ABI:        DB      2,1,0            ; supported BRSX ABI version
RV_BMET:       DB      'B','M','E','T'  ; base metadata type
RV_REQ:        DW      0                ; validation request pointer
RV_CAND:       DW      0                ; candidate carrier pointer
RV_LBASE:      DW      0                ; candidate link base
RV_LDISP:      DW      0                ; candidate dispatch offset
RV_LEFT:       DW      0                ; carrier bytes remaining
RV_CODE:       DW      0                ; candidate code size
RV_ALLOC:      DW      0                ; candidate allocation size
RV_META:       DW      0                ; metadata pointer
RV_START:      DW      0                ; metadata start
RV_END:        DW      0                ; metadata end
RV_NREC:       DB      0                ; metadata record count
RV_NSVC:       DB      0                ; callable service count
RV_IDONE:      DS      4                ; first service-ID present flag
RV_PREV:       DW      0                ; previous pointer offset
RV_PSEEN:      DB      0                ; pointer-list seen flag
        .DEPHASE
        END
