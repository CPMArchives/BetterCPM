; Phase-3 overlap-safe live-allocation mover and guarded pointer repair.
;
; DE -> request:
;   +0 old base, +2 new base, +4 allocation size
;   +6 slot count, +7 reserved zero, +8 sorted unique word offsets
; Return A=0 on success, FFh on validation failure.  Every slot is validated
; before the first byte is moved.  A word is adjusted by new-old only when its
; current value lies in [old,old+allocation).

RMBASE          EQU     07000H

        CSEG
        .PHASE  RMBASE
RM_ENTRY:
        LD      (RM_REQ),DE
        EX      DE,HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (RM_OLD),DE
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (RM_NEW),DE
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (RM_SIZE),DE
        LD      A,D
        OR      E
        JP      Z,RM_BAD
        INC     HL
        LD      A,(HL)
        LD      (RM_COUNT),A
        INC     HL
        LD      A,(HL)
        OR      A
        JP      NZ,RM_BAD
        INC     HL
        LD      (RM_SLOTS),HL

        LD      HL,(RM_OLD)
        LD      DE,(RM_SIZE)
        ADD     HL,DE
        JP      C,RM_BAD
        LD      (RM_OLDEND),HL
        LD      HL,(RM_NEW)
        ADD     HL,DE
        JP      C,RM_BAD
        LD      (RM_NEWEND),HL
        LD      HL,(RM_NEW)
        LD      DE,(RM_OLD)
        OR      A
        SBC     HL,DE
        LD      (RM_DELTA),HL

; Validate the complete sorted slot list before changing the live image.
        LD      HL,(RM_SLOTS)
        XOR     A
        LD      (RM_SEEN),A
        LD      A,(RM_COUNT)
        LD      B,A
RM_VLOOP:
        LD      A,B
        OR      A
        JR      Z,RM_COPY
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     HL
        PUSH    HL
        LD      HL,(RM_SIZE)
        DEC     HL
        OR      A
        SBC     HL,DE
        POP     HL
        JP      C,RM_BAD
        JP      Z,RM_BAD
        LD      A,(RM_SEEN)
        OR      A
        JR      Z,RM_VFIRST
        PUSH    HL
        LD      HL,(RM_PREV)
        OR      A
        SBC     HL,DE
        POP     HL
        JP      NC,RM_BAD
RM_VFIRST:
        LD      (RM_PREV),DE
        LD      A,1
        LD      (RM_SEEN),A
        DJNZ    RM_VLOOP

RM_COPY:
        LD      HL,(RM_OLD)
        LD      DE,(RM_NEW)
        OR      A
        SBC     HL,DE
        JR      Z,RM_REPAIR
        JR      C,RM_BACK       ; old < new: copy from the high end
        LD      HL,(RM_OLD)
        LD      BC,(RM_SIZE)
        LDIR
        JR      RM_REPAIR
RM_BACK:
        LD      HL,(RM_OLDEND)
        DEC     HL
        LD      DE,(RM_NEWEND)
        DEC     DE
        LD      BC,(RM_SIZE)
RM_BLOOP:
        LD      A,(HL)
        LD      (DE),A
        DEC     HL
        DEC     DE
        DEC     BC
        LD      A,B
        OR      C
        JR      NZ,RM_BLOOP

RM_REPAIR:
        LD      HL,(RM_SLOTS)
        LD      A,(RM_COUNT)
        LD      B,A
RM_RLOOP:
        LD      A,B
        OR      A
        JR      Z,RM_OK
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     HL
        PUSH    HL
        PUSH    BC
        LD      HL,(RM_NEW)
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        PUSH    HL              ; high-byte address in the new image
        EX      DE,HL           ; HL=current pointer value
        LD      DE,(RM_OLD)
        OR      A
        SBC     HL,DE
        JR      C,RM_RSKIP
        LD      DE,(RM_SIZE)
        OR      A
        SBC     HL,DE
        JR      NC,RM_RSKIP
        ADD     HL,DE           ; restore value-old
        LD      DE,(RM_NEW)
        ADD     HL,DE
        EX      DE,HL
        POP     HL
        LD      (HL),D
        DEC     HL
        LD      (HL),E
        JR      RM_RNEXT
RM_RSKIP:
        POP     HL
RM_RNEXT:
        POP     BC
        POP     HL
        DJNZ    RM_RLOOP
RM_OK:
        XOR     A
        RET
RM_BAD:
        LD      A,0FFH
        OR      A
        RET

RM_REQ:         DW      0
RM_OLD:         DW      0
RM_NEW:         DW      0
RM_SIZE:        DW      0
RM_OLDEND:      DW      0
RM_NEWEND:      DW      0
RM_DELTA:       DW      0
RM_SLOTS:       DW      0
RM_PREV:        DW      0
RM_COUNT:       DB      0
RM_SEEN:        DB      0

        .DEPHASE
        END
