        INCLUDE layout.inc

; ********************************************************************************
; *                    BetterCP/M BRSX Descriptor Materializer                   *
; *                                                                              *
; * BRSX v2 post-reconstruction publisher. Runs after the RSX chain has been     *
; * rebuilt and before the disk-free resolver is installed, converting carrier  *
; * metadata into the live descriptors and service records owned by the loader. *
; ********************************************************************************


RPBASE          EQU     LY_RSX
FLOPEN          EQU     LY_FILE
FLNEXT          EQU     LY_FILE+3
MODBUF          EQU     LY_BUF
RSTCOUNT        EQU     LY_RSTA
RSTABLE         EQU     LY_RSTA+1
ECB_RSXHEAD     EQU     LY_SYS+084H

        CSEG
        .PHASE  RPBASE

; ================================================================================
; =                        Materializer Entry and Control                        =
; =                                                                              =
; = Provides the post-reconstruction control boundary and walks the rebuilt RSX  =
; = profile while chaining unrelated requests through the resident stack.        =
; ================================================================================
; -------------------------------------------------------------------------------
; Entry and Module Walk
; -------------------------------------------------------------------------------

RP_ENTRY:                               ; enter descriptor materializer
        JP      RP_CONTROL

RP_CHAIN:                               ; chain unhandled BDOS request
        POP     DE
        LD      (RP_REQ),DE
        CALL    RP_CONTROL
        PUSH    AF
        LD      HL,(RP_REQ)
        INC     HL
        INC     HL
        INC     HL
        LD      (HL),0                  ; do not expose the private chain marker
        POP     AF
        RET     NZ
        LD      A,3                     ; overlay three: disk-free resolver
        JP      LY_BIOS+60

; -------------------------------------------------------------------------------
; Materialization Request
; -------------------------------------------------------------------------------

RP_CONTROL:                             ; dispatch materialization request
        XOR     A
        LD      (RP_INDEX),A
        LD      HL,(ECB_RSXHEAD)
        LD      (RP_BASE),HL

RP_LOOP:                                ; process next reconstructed RSX
        LD      A,(RP_INDEX)
        LD      B,A
        LD      A,(RSTCOUNT)
        CP      B
        JR      Z,RP_GOOD
        LD      A,B
        CALL    RP_TABPTR
        LD      A,1
        CALL    FLOPEN
        JP      NZ,RP_BAD
        LD      HL,MODBUF
        CALL    FLNEXT
        JP      NZ,RP_BAD
        LD      A,(MODBUF+4)
        CP      1
        JR      Z,RP_HAVEBASE
        CP      2
        JP      NZ,RP_BAD

RP_HAVEBASE:                            ; accept located module base
        LD      (RP_FMT),A
        LD      A,(RP_INDEX)
        OR      A
        JR      Z,RP_BASEOK
        LD      HL,(RP_NDISP)
        LD      DE,(MODBUF+16)
        OR      A
        SBC     HL,DE
        LD      (RP_BASE),HL

RP_BASEOK:                              ; accept validated module base
        LD      HL,(RP_BASE)
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (RP_NDISP),DE
        LD      A,(RP_FMT)
        CP      2
        JR      NZ,RP_NEXT
        LD      HL,(MODBUF+12)
        LD      (RP_LEFT),HL
        LD      (RP_CODE),HL
        LD      HL,(MODBUF+14)
        LD      (RP_ALLOC),HL
        CALL    RP_FINDMETA
        JP      NZ,RP_BAD
        CALL    RP_CLEAR
        CALL    RP_META
        JP      NZ,RP_BAD

RP_NEXT:                                ; advance reconstructed-module scan
        LD      HL,RP_INDEX
        INC     (HL)
        JR      RP_LOOP

RP_REQ: DW      0                       ; materialization request pointer

RP_GOOD:                                ; return materialization success
        XOR     A
        RET

RP_BAD:                                 ; return materialization failure
        LD      A,0FFH
        OR      A
        RET

; ================================================================================
; =                         Reconstruction Record Lookup                         =
; =                                                                              =
; = Locates each module's reconstruction record and corresponding carrier metadata =
; = needed to build its live BRSX-v2 descriptor.                                 =
; ================================================================================
; -------------------------------------------------------------------------------
; Profile Record Lookup
; -------------------------------------------------------------------------------

RP_TABPTR:                              ; locate reconstruction table record
        ADD     A,A
        ADD     A,A
        ADD     A,A
        LD      L,A
        LD      H,0
        LD      DE,RSTABLE
        ADD     HL,DE
        RET

; -------------------------------------------------------------------------------
; Carrier Metadata Lookup
; -------------------------------------------------------------------------------

RP_FINDMETA:                            ; locate module metadata
        LD      HL,(RP_LEFT)
        LD      A,H
        CP      2
        JR      C,RP_LAST
        LD      HL,MODBUF
        CALL    FLNEXT
        RET     NZ
        LD      HL,(RP_LEFT)
        LD      DE,0200H
        OR      A
        SBC     HL,DE
        LD      (RP_LEFT),HL
        JR      RP_FINDMETA

RP_LAST:                                ; handle final metadata record
        LD      A,H
        OR      L
        JR      Z,RP_EXACT
        PUSH    HL
        LD      HL,MODBUF
        CALL    FLNEXT
        POP     DE
        RET     NZ
        LD      HL,MODBUF
        ADD     HL,DE
        LD      (RP_METAP),HL
        XOR     A
        RET

RP_EXACT:                               ; accept exact metadata layout
        LD      HL,MODBUF
        CALL    FLNEXT
        RET     NZ
        LD      HL,MODBUF
        LD      (RP_METAP),HL
        XOR     A
        RET

  ; Clear payload tail before writing loader-owned descriptors.

; ================================================================================
; =                            Descriptor Publication                            =
; =                                                                              =
; = Clears loader-owned descriptor space, copies normalized module metadata, and emits =
; = the published resident-service records into the reconstructed module.        =
; ================================================================================
; -------------------------------------------------------------------------------
; Descriptor Tail Initialization
; -------------------------------------------------------------------------------

RP_CLEAR:                               ; clear descriptor payload tail
        LD      HL,(RP_BASE)
        LD      DE,(RP_CODE)
        ADD     HL,DE
        PUSH    HL
        LD      HL,(RP_ALLOC)
        LD      DE,(RP_CODE)
        OR      A
        SBC     HL,DE
        LD      B,H
        LD      C,L
        POP     HL
        LD      A,B
        OR      C
        RET     Z
        LD      (HL),0
        DEC     BC
        LD      A,B
        OR      C
        RET     Z
        LD      D,H
        LD      E,L
        INC     DE
        LDIR
        RET

; -------------------------------------------------------------------------------
; Metadata Materialization
; -------------------------------------------------------------------------------

RP_META:                                ; materialize module metadata
        LD      HL,(RP_METAP)
        LD      DE,RP_BMET
        LD      B,4

RP_BMLOOP:                              ; copy base metadata
        LD      A,(DE)
        CP      (HL)
        JP      NZ,RP_BAD
        INC     DE
        INC     HL
        DJNZ    RP_BMLOOP
        LD      DE,3
        ADD     HL,DE
        LD      A,(HL)                  ; record count at envelope +7
        LD      (RP_NREC),A
        LD      DE,5
        ADD     HL,DE                   ; first record at envelope +12
        LD      DE,(RP_BASE)
        EX      DE,HL
        LD      BC,(RP_ALLOC)
        ADD     HL,BC
        LD      (RP_DPTR),HL
        EX      DE,HL
        XOR     A
        LD      (RP_NSVC),A

; -------------------------------------------------------------------------------
; Service Record Publication
; -------------------------------------------------------------------------------

RP_RECLOOP:                             ; emit service records
        LD      A,(RP_NREC)
        OR      A
        JR      Z,RP_DONE
        DEC     A
        LD      (RP_NREC),A
        LD      A,(HL)
        INC     HL
        LD      B,(HL)
        INC     HL
        CP      2
        JR      NZ,RP_SKIP
        LD      A,B
        CP      10
        JP      NZ,RP_BAD
        LD      (RP_MPTR),HL
        LD      HL,(RP_DPTR)
        LD      DE,10
        OR      A
        SBC     HL,DE
        LD      (RP_DPTR),HL
        EX      DE,HL
        LD      HL,(RP_MPTR)
        LD      BC,10
        LDIR
        LD      HL,(RP_MPTR)
        LD      DE,10
        ADD     HL,DE
        LD      A,(RP_NSVC)
        INC     A
        LD      (RP_NSVC),A
        JR      RP_RECLOOP

RP_SKIP:                                ; skip unsupported metadata record
        LD      E,B
        LD      D,0
        ADD     HL,DE
        JR      RP_RECLOOP

RP_DONE:                                ; finish descriptor materialization
        LD      HL,(RP_DPTR)
        LD      DE,(RP_BASE)
        OR      A
        SBC     HL,DE
        LD      (RP_OFF),HL
        LD      HL,(RP_BASE)
        LD      DE,4
        ADD     HL,DE
        LD      A,(RP_NSVC)
        LD      (HL),A
        INC     HL
        LD      (HL),0
        INC     HL
        LD      DE,(RP_OFF)
        LD      (HL),E
        INC     HL
        LD      (HL),D
        XOR     A
        RET

; ================================================================================
; =                          Materializer Working State                          =
; =                                                                              =
; = Defines module base, metadata, descriptor, service-record, format, and count state =
; = used while publishing the rebuilt RSX descriptors.                           =
; ================================================================================
; -------------------------------------------------------------------------------
; Publisher State
; -------------------------------------------------------------------------------

RP_BMET:       DB      'B','M','E','T'  ; base-metadata pointer
RP_BASE:       DW      0                ; module runtime base
RP_NDISP:      DW      0                ; module dispatch entry
RP_LEFT:       DW      0                ; metadata bytes remaining
RP_CODE:       DW      0                ; module code-size scratch
RP_ALLOC:      DW      0                ; module allocation size
RP_METAP:      DW      0                ; metadata source pointer
RP_DPTR:       DW      0                ; descriptor destination pointer
RP_MPTR:       DW      0                ; service-metadata pointer
RP_OFF:        DW      0                ; current service offset
RP_INDEX:      DB      0                ; module index
RP_FMT:        DB      0                ; metadata format
RP_NREC:       DB      0                ; metadata record count
RP_NSVC:       DB      0                ; published service count
        .DEPHASE
        END
