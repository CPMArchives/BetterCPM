; BetterCP/M initial resident-system initialization and page-zero gateway.
;
; Provisional placement. This component establishes the standard CP/M entry
; addresses only after the default drive has logged in successfully.

; Patch 2026-09-01: the E500/E600/E800 bring-up map proved its boundaries by
; catching two workspace collisions. Specification 29 relocates components
; into explicit growth regions while leaving page-zero ABI addresses intact.
SYSBASE         EQU     0C000H
BDOS            EQU     0C100H
CPMGATE         EQU     SYSBASE-3
DIRLOGIN        EQU     0D60CH
BIOWBOOT        EQU     0EF03H

        CSEG
        .PHASE  SYSBASE

SYS_INIT:
        JP      SINIBODY

        REPT    SYSBASE+020H-$  ; explicit bytes keep native/cross images equal
        DB      0
        ENDM

; Stable targets used by the BIOS BOOT and WBOOT implementations.
SYS_BOOT:
        JP      SYS_COLD
SYS_WBOOT:
        JP      SYS_WARM
SYS_COLD:
SYS_WARM:
; Patch 2026-09-01: Function 0 arrives on the BDOS private stack. Calling BDOS
; again during reconstruction reused that stack and destroyed WBOOT's return
; frames. Establish a distinct system stack before invoking any service.
        LD      SP,SYS_STKTOP
        CALL    SYS_INIT
        JR      NZ,SYS_STOP
        LD      C,13            ; default drive A, DMA 0080h, fresh disk state
        CALL    BDOS
; The CCP address is configuration state. A stable gateway must consult the
; descriptor rather than embed a direct jump to the current default address.
        LD      HL,(ECB_CCPBASE)
        PUSH    HL
        RET
SYS_STOP:
        JR      SYS_STOP

SYS_STACK:
        REPT    32
        DB      0
        ENDM
SYS_STKTOP:

        REPT    SYSBASE+080H-$
        DB      0
        ENDM

; Extension Control Block, version 1. This fixed descriptor publishes the
; active calculated layout while RSX, CPX, and CCP addresses remain movable.
ECB_MAGIC:
        DB      'B','M'
ECB_VERSION:
        DB      1
ECB_FLAGS:
        DB      0
ECB_RSXHEAD:
        DW      0
ECB_CPXHEAD:
        DW      0
ECB_RSXLOW:
        DW      SYSBASE
ECB_CPXLOW:
        DW      CPMGATE
ECB_CCPBASE:
        DW      0               ; calculated and published by WBOOT reloader
ECB_CCPSIZE:
        DW      0               ; calculated from the command module
ECB_TPATOP:
        DW      CPMGATE         ; movable gateway is the exclusive TPA ceiling
ECB_GENERATION:
        DW      1

; Persistent command-environment reconstruction state.  The current profile
; is deliberately empty; later CPX installation records ordered module
; sources here.  Unlike the runtime CPX chain, this table survives WBOOT.
CPTCOUNT:
        DB      1               ; default proof profile loads BASIC.CPX
CPTFLAGS:
        DB      0
CPTABLE:
        DB      4               ; first module slot after four-slot CCP image
        REPT    8*8-1
        DB      0
        ENDM

; Patch 2026-09-02: the movable gateway setup no longer fits before the stable
; C020h BOOT/WBOOT vectors.  Preserve those public addresses and keep the old
; entry as a short branch into the unused tail of the fixed gateway page.
SINIBODY:
        LD      C,0             ; initial default drive A
        CALL    DIRLOGIN
        RET     NZ              ; do not publish a half-initialized system
        LD      HL,(ECB_TPATOP)
        LD      (HL),0C3H
        INC     HL
        LD      DE,BDOS
        LD      (HL),E
        INC     HL
        LD      (HL),D
        LD      A,0C3H          ; JP opcode
        LD      (0000H),A
        LD      (0005H),A
        LD      HL,BIOWBOOT
        LD      (0001H),HL
        LD      HL,(ECB_TPATOP)
        LD      (0006H),HL
        XOR     A
        RET

        .DEPHASE
        END
