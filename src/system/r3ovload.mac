        INCLUDE layout.inc

; ********************************************************************************
; *                    BetterCP/M Overlay Handoff Trampoline                      *
; ********************************************************************************

  ; Disk IO executes in reserved caller RAM because physical reads may
  ; overwrite every byte of LY_CFG. DE points to the six-byte request.
ROBASE          EQU     LY_CFG+0310H
        CSEG
        .PHASE  ROBASE
RO_ENTRY:                               ; transfer overlay reading to caller scratch
        PUSH    DE
        EX      DE,HL
        INC     HL
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        LD      BC,0400H
        ADD     HL,BC
        POP     DE
        LD      A,1
        JP      (HL)
        DS      ROBASE+0020H-$
; Called only by the production extended request after all validation/movement.
; Legacy mode-one publishers remain at +38F and never read +37/+39.
RO_BIND:
        PUSH    DE
        EX      DE,HL
        LD      DE,37
        ADD     HL,DE
        LD      C,(HL)
        INC     HL
        LD      B,(HL)
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      A,B
        OR      C
        JR      Z,RO_BOUND
        LD      H,B
        LD      L,C
        LD      (HL),E
        INC     HL
        LD      (HL),D
RO_BOUND:
        POP     DE
        JP      LY_CFG+038FH           ; publish personality, then generation
        .DEPHASE
        END
