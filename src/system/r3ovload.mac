        INCLUDE layout.inc

; ********************************************************************************
; *                    BetterCP/M Overlay Handoff Trampoline                      *
; ********************************************************************************

  ; Disk IO executes in reserved caller RAM because physical reads may
  ; overwrite every byte of LY_CFG. DE points to the six-byte request.
ROBASE          EQU     LY_CFG+0310H
        CSEG
        .PHASE  ROBASE
RO_ENTRY:                               ; transfer overlay reading to caller scratch
        PUSH    DE
        EX      DE,HL
        INC     HL
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        LD      BC,0400H
        ADD     HL,BC
        POP     DE
        LD      A,1
        JP      (HL)
        .DEPHASE
        END
