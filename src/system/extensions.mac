        INCLUDE layout.inc
; Protected extension controls and adapters to the single unified filesystem.
; The extension entry is called BEFORE the core takes its private stack: RSX loading
; calls standard BDOS recursively, using its own on-demand manager stack.
        CSEG
        .PHASE  LY_EXT
        JP      EX_ENTRY
        JP      AD_LOGIN
        JP      AD_OPEN
        JP      AD_READ
        JP      CL_NEXT

        INCLUDE core.inc
CPTCOUNT        EQU     LY_SYS+094H
CPTFLAGS        EQU     LY_SYS+095H
CPTABLE         EQU     LY_SYS+096H
RSXCONTROL      EQU     LY_RSX
BIOCURSOR       EQU     LY_BIOS+54
COREBDOS        EQU     LY_BDOS

EX_ENTRY:
        LD A,C
        CP 207
        JP Z,LY_DISK
        LD      (EX_OLDSP),SP
        PUSH    IX
        LD      A,C
        CP      200
        JR      Z,BF_CPXCTL
        CP      202
        JR      Z,BF_RSXCTL
        CP      204
        JP      Z,BF_CURSOR
        CP      205
        JP      Z,BF_CCPPRN
        CP      206
        JP      Z,BF_VERSION
        CP      208
        JR      Z,BF_RSXSVC
        XOR     A
EX_RETURN:
        LD      L,A
        LD      H,0
EX_RETHL:
        LD      A,L
        LD      B,H
        POP     IX
        LD      SP,(EX_OLDSP)
        RET

EX_RET208:
        POP     IX
        LD      SP,(EX_OLDSP)
        RET

BF_CPXCTL:
        PUSH    DE
        CALL    LY_BIOS+57
        POP     DE
        OR      A
        JR      NZ,EX_RETURN
        JP      LY_CFG+9

BF_RSXCTL:
        LD      A,(LY_RSTA)
        OR      A
        JR      NZ,EX_RLOAD
        LD      A,(DE)
        CP      1
        JR      NZ,EX_RBAD
        INC     DE
        LD      A,(DE)
        DEC     DE
        CP      1
        JR      Z,EX_RLOAD
        CP      4
        JR      NC,EX_RBAD
        XOR     A               ; empty enumerate/query/unload needs no manager
        JR      EX_RETURN
EX_RLOAD:
        PUSH    DE
        LD      A,1             ; validator starts the reconstruction pipeline
        CALL    LY_BIOS+60
        POP     DE
; Each control overlay is padded with the fixed BDOS jump at HIST-3.
; The former stack top was:
;       LD      SP,LY_RSX+0400H
; A CALL there pushed its return address over the jump.  Leave those
; three bytes alone; the manager stack must end immediately below it.
        OR      A
        JR      NZ,EX_RBAD
        POP     IX              ; move the saved register to the manager's stack
        LD      SP,LY_RSX+03FDH
        PUSH    IX
        CALL    RSXCONTROL
        OR      A
        JR      Z,EX_RETURN
        PUSH    AF
        LD      A,(LY_RSTA)
        OR      A
        JR      Z,EX_RFAIL
        LD      A,3             ; restore the old disk-free resolver on failure
        CALL    LY_BIOS+60
EX_RFAIL:
        POP     AF
        JR      EX_RETURN
EX_RBAD:
        LD      A,0FFH
        JR      EX_RETURN

BF_RSXSVC:
        LD      A,(LY_RSTA)
        OR      A
        JR      Z,BF_RSNONE
        CALL    RSXCONTROL
        JR      EX_RET208
BF_RSNONE:
        PUSH    DE
        LD      H,D
        LD      L,E
        LD      BC,12
        ADD     HL,BC
        XOR     A
        LD      B,7
BF_RSCLR:
        LD      (HL),A
        INC     HL
        DJNZ    BF_RSCLR
        INC     A
        LD      (HL),A
        LD      HL,0
        POP     DE
        JR      EX_RET208

; BetterCP/M Function 206 returns the protected, versioned descriptor generated
; from the normative subsystem matrix. Consumers must validate BV/version 1.
BF_VERSION:
        LD      HL,BCV_DESC
        JP      EX_RETHL


BF_CURSOR:
        LD      A,E
        LD      C,A
        CALL    BIOCURSOR
        OR      A
        JP      Z,EX_RETURN
        LD      A,E
        OR      A
        LD      A,1
        JP      Z,EX_RETURN
        LD      HL,UB_COLUMN
        INC     (HL)
        JP      EX_RETURN
BF_CCPPRN:
        LD      A,(UB_LISTE)
        CPL
        LD      (UB_LISTE),A
        JP      EX_RETURN

; These compatibility entry points contain no filesystem engine. Module
; files use user zero, preserving the caller's drive, user and DMA selections.
AD_LOGIN:
        LD      E,C
        LD      C,14
        JR      AD_CALL
AD_OPEN:
        LD      C,15
        JR      AD_CALL
AD_READ:
        LD      (AD_DMA),BC
        LD      C,20
AD_CALL:
        LD      HL,(UB_DMA)
        PUSH    HL
        LD      A,(UB_DRIVE)
        PUSH    AF
        LD      A,(UB_USERNO)
        PUSH    AF
        XOR     A
        LD      (UB_USERNO),A
        LD      A,C
        CP      20
        JR      NZ,AD_INVOKE
        LD      HL,(AD_DMA)
        LD      (UB_DMA),HL
AD_INVOKE:
        CALL    COREBDOS
        LD      C,A
        POP     AF
        LD      (UB_USERNO),A
        POP     AF
        LD      (UB_DRIVE),A
        POP     HL
        LD      (UB_DMA),HL
        LD      A,C
        OR      A
        RET

 ; COM READER -- the CCP and CPXs may be overwritten after this point.
; The module reader's idle FCB is borrowed, not its executable code.
CL_NEXT:
        PUSH HL
        LD DE,LY_FCB
        LD C,20
        CALL COREBDOS
        OR A
        JR NZ,CL_END
        POP HL
        PUSH HL
        LD DE,127
        ADD HL,DE
        LD DE,(LY_SYS+090H)
        OR A
        SBC HL,DE
        JR NC,CL_BIG
        POP DE
        LD HL,LY_BUF
        LD BC,128
        LDIR
        EX DE,HL
        JR CL_NEXT
CL_END:
        POP HL
        DEC A               ; EOF=1 is success; other errors stay nonzero
        JP LY_COMDONE
CL_BIG:
        POP HL
        LD A,1
        JP LY_COMDONE

EX_OLDSP:       DW      0
BCX_MVAL:       DB      0
AD_DMA:         DW      0
        INCLUDE versions.inc
        .DEPHASE
        END
