        INCLUDE layout.inc
; Protected extension controls and adapters to the single unified filesystem.
; The extension entry is called BEFORE the core takes its private stack: RSX loading
; calls standard BDOS recursively, using its own on-demand manager stack.
        CSEG
        .PHASE  LY_EXT
        JP      EX_ENTRY
        REPT    LY_EXT+00CH-$
        DB      0
        ENDM
        JP      AD_LOGIN
        DB      0,0,0
        JP      AD_OPEN
        REPT    LY_EXT+024H-$
        DB      0
        ENDM
        JP      AD_READ

        INCLUDE core.inc
CPTCOUNT        EQU     LY_SYS+094H
CPTFLAGS        EQU     LY_SYS+095H
CPTABLE         EQU     LY_SYS+096H
RSXCONTROL      EQU     LY_RSX
BIOCURSOR       EQU     LY_BIOS+54
COREBDOS        EQU     LY_BDOS

EX_ENTRY:
        LD A,C
        CP 207
        JP Z,LY_DISK
        LD      (EX_OLDSP),SP
        PUSH    IX
        LD      A,C
        CP      200
        JR      Z,BF_CPXCTL
        CP      202
        JR      Z,BF_RSXCTL
        CP      204
        JR      Z,BF_CURSOR
        CP      205
        JR      Z,BF_CCPPRN
        CP      206
        JR      Z,BF_VERSION
        XOR     A
EX_RETURN:
        LD      L,A
        LD      H,0
EX_RETHL:
        LD      A,L
        LD      B,H
        POP     IX
        LD      SP,(EX_OLDSP)
        RET

BF_CPXCTL:
        PUSH    DE
        CALL    LY_BIOS+57
        POP     DE
        OR      A
        JR      NZ,EX_RETURN
        JP      LY_CFG+9

BF_RSXCTL:
        LD      A,(LY_RSTA)
        OR      A
        JR      NZ,EX_RLOAD
        LD      A,(DE)
        CP      1
        JR      NZ,EX_RBAD
        INC     DE
        LD      A,(DE)
        DEC     DE
        CP      1
        JR      Z,EX_RLOAD
        CP      4
        JR      NC,EX_RBAD
        XOR     A               ; empty enumerate/query/unload needs no manager
        JR      EX_RETURN
EX_RLOAD:
        PUSH    DE
        CALL    LY_BIOS+60
        POP     DE
; 07-Sep-2026 -- RSX LOAD / WARM BOOT PATCH
; The two-sector carrier also covers the fixed BDOS jump at HIST-3.
; Put the jump back even on a read error, before any further CALL 5.
; The former stack top was:
;       LD      SP,LY_RSX+0400H
; A CALL there pushed its return address over the jump.  Leave those
; three bytes alone; the manager stack must end immediately below it.
        LD      HL,LY_TPA
        LD      (HL),0C3H
        INC     HL
        LD      (HL),LOW COREBDOS
        INC     HL
        LD      (HL),HIGH COREBDOS
        OR      A
        JR      NZ,EX_RBAD
        POP     IX              ; move the saved register to the manager's stack
        LD      SP,LY_RSX+03FDH
        PUSH    IX
        CALL    RSXCONTROL
        JR      EX_RETURN
EX_RBAD:
        LD      A,0FFH
        JR      EX_RETURN

; BetterCP/M Function 206 returns the protected, versioned descriptor generated
; from the normative subsystem matrix. Consumers must validate BV/version 1.
BF_VERSION:
        LD      HL,BCV_DESC
        JR      EX_RETHL


BF_CURSOR:
        LD      A,E
        LD      C,A
        CALL    BIOCURSOR
        OR      A
        JR      Z,EX_RETURN
        LD      A,E
        OR      A
        LD      A,1
        JR      Z,EX_RETURN
        LD      HL,UB_COLUMN
        INC     (HL)
        JR      EX_RETURN
BF_CCPPRN:
        LD      A,(UB_LISTE)
        CPL
        LD      (UB_LISTE),A
        JR      EX_RETURN

; These compatibility entry points contain no filesystem engine. Module
; files use user zero, preserving the caller's drive, user and DMA selections.
AD_LOGIN:
        LD      E,C
        LD      C,14
        JR      AD_CALL
AD_OPEN:
        LD      C,15
        JR      AD_CALL
AD_READ:
        LD      (AD_DMA),BC
        LD      C,20
AD_CALL:
        LD      HL,(UB_DMA)
        PUSH    HL
        LD      A,(UB_DRIVE)
        PUSH    AF
        LD      A,(UB_USERNO)
        PUSH    AF
        XOR     A
        LD      (UB_USERNO),A
        LD      A,C
        CP      20
        JR      NZ,AD_INVOKE
        LD      HL,(AD_DMA)
        LD      (UB_DMA),HL
AD_INVOKE:
        CALL    COREBDOS
        LD      C,A
        POP     AF
        LD      (UB_USERNO),A
        POP     AF
        LD      (UB_DRIVE),A
        POP     HL
        LD      (UB_DMA),HL
        LD      A,C
        OR      A
        RET

EX_OLDSP:       DW      0
BCX_MVAL:       DB      0
AD_DMA:         DW      0
        INCLUDE versions.inc
        .DEPHASE
        END
