        INCLUDE layout.inc

; ********************************************************************************
; *                      BetterCP/M CPX/RSX File Stream                          *
; *                                                                              *
; * Shared one-cursor, one-FCB reader for CPX and RSX carrier files. OPEN selects*
; * the carrier type and name; NEXT reads up to four 128-byte records; RESET     *
; * reopens the same FCB without maintaining a redundant filename copy.           *
; ********************************************************************************

DIROPEN EQU LY_EXT+006H
DIRREAD EQU LY_EXT+009H
        CSEG
        .PHASE  LY_FILE

; ================================================================================
; =                            File Stream Interface                             =
; =                                                                              =
; = Provides OPEN, NEXT, and RESET entry points over one retained FCB and cursor for =
; = protected CPX/RSX carrier loading.                                           =
; ================================================================================
; -------------------------------------------------------------------------------
; Public Entry Points
; -------------------------------------------------------------------------------

FL_OPEN: JP FL_OPBODY                   ; open CPX or RSX file stream

FL_NEXT: JP FL_NXBODY                   ; read next file-stream block

FL_RESET: JP FL_REOPEN                  ; reopen current file stream

; ================================================================================
; =                           Carrier Open and Reopen                            =
; =                                                                              =
; = Builds the carrier FCB, selects the CPX or RSX extension, opens the stream, and =
; = reopens the retained name when the caller resets the stream.                 =
; ================================================================================
; -------------------------------------------------------------------------------
; Open Carrier
; -------------------------------------------------------------------------------

FL_OPBODY:                              ; build and open stream FCB
        LD DE,FL_FCB+1
        LD BC,8
        LDIR
        LD HL,FL_CPXEXT
        OR A
        JR Z,FL_EXT
        LD HL,FL_RSXEXT

FL_EXT:                                 ; select CPX or RSX extension
        LD BC,3
        LDIR

; -------------------------------------------------------------------------------
; Reset Stream
; -------------------------------------------------------------------------------

FL_REOPEN:                              ; reopen saved stream name
        LD A,1
        LD (FL_FCB),A
        LD HL,FL_FCB+12
        LD DE,FL_FCB+13
        LD BC,23
        LD (HL),0
        LDIR
        LD DE,FL_FCB
        CALL DIROPEN
        CP 0FFH
        JR Z,FL_BAD
        XOR A
        RET

; ================================================================================
; =                                 Block Input                                  =
; =                                                                              =
; = Reads up to four CP/M records into the caller destination and pads a short final =
; = block while distinguishing normal EOF from stream failure.                   =
; ================================================================================
; -------------------------------------------------------------------------------
; Read Block
; -------------------------------------------------------------------------------

FL_NXBODY:                              ; begin next-block read
        LD B,4

FL_RLOOP:                               ; read next 128-byte record
        PUSH BC
        PUSH HL
        LD B,H
        LD C,L
        LD DE,FL_FCB
        CALL DIRREAD
        POP HL
        POP BC
        OR A
        JR NZ,FL_EOF
        LD DE,128
        ADD HL,DE
        DJNZ FL_RLOOP
        XOR A
        RET

; -------------------------------------------------------------------------------
; EOF and Padding
; -------------------------------------------------------------------------------

FL_EOF:                                 ; finish short final block
        LD A,B
        CP 4
        JR Z,FL_BAD                     ; no input at all is EOF; a partial carrier is valid
        LD DE,128

FL_PAD:                                 ; pad unread block bytes
        ADD HL,DE
        DJNZ FL_PAD
        XOR A
        RET

FL_BAD:                                 ; return file-stream failure
        LD A,1
        OR A
        RET

; ================================================================================
; =                              File Stream State                               =
; =                                                                              =
; = Defines the carrier extensions and the single retained FCB used by the stream. =
; ================================================================================
; -------------------------------------------------------------------------------
; Extensions and FCB
; -------------------------------------------------------------------------------

FL_CPXEXT: DB 'CPX'                     ; CPX filename extension
FL_RSXEXT: DB 'RSX'                     ; RSX filename extension
FL_FCB: DS 36                           ; shared file-stream FCB
        .DEPHASE
        END
