        INCLUDE layout.inc
; CPX/RSX FILE STREAM -- one cursor, one FCB.
; OPEN: A=0 for CPX, nonzero for RSX; HL -> eight-byte name.
; NEXT: HL -> destination; read up to four 128-byte records.
; RESET reopens the same name.  Keep name/type in the FCB; a second
; copy wastes RAM and can get out of step with the file being read.
DIROPEN EQU LY_EXT+006H
DIRREAD EQU LY_EXT+009H
        CSEG
        .PHASE  LY_FILE
FL_OPEN: JP FL_OPBODY
FL_NEXT: JP FL_NXBODY
FL_RESET: JP FL_REOPEN
FL_OPBODY:
        LD DE,FL_FCB+1
        LD BC,8
        LDIR
        LD HL,FL_CPXEXT
        OR A
        JR Z,FL_EXT
        LD HL,FL_RSXEXT
FL_EXT:
        LD BC,3
        LDIR
FL_REOPEN:
        LD A,1
        LD (FL_FCB),A
        LD HL,FL_FCB+12
        LD DE,FL_FCB+13
        LD BC,23
        LD (HL),0
        LDIR
        LD DE,FL_FCB
        CALL DIROPEN
        CP 0FFH
        JR Z,FL_BAD
        XOR A
        RET
FL_NXBODY:
        LD B,4
FL_RLOOP:
        PUSH BC
        PUSH HL
        LD B,H
        LD C,L
        LD DE,FL_FCB
        CALL DIRREAD
        POP HL
        POP BC
        OR A
        JR NZ,FL_EOF
        LD DE,128
        ADD HL,DE
        DJNZ FL_RLOOP
        XOR A
        RET
FL_EOF:
        LD A,B
        CP 4
        JR Z,FL_BAD          ; no input at all is EOF; a partial carrier is valid
        LD DE,128
FL_PAD:
        ADD HL,DE
        DJNZ FL_PAD
        XOR A
        RET
FL_BAD:
        LD A,1
        OR A
        RET
FL_CPXEXT: DB 'CPX'
FL_RSXEXT: DB 'RSX'
FL_FCB: DS 36
        .DEPHASE
        END
