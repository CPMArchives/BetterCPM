        INCLUDE layout.inc
        INCLUDE profile.inc
        ASEG
        ORG 0100H
; The checked resident gate admits this first-stage carrier before entry.
; COMMAND_STAGE2_CRC is supplied as a generated assembler constant.
        LD SP,0500H
        LD HL,0500H
        LD DE,84
        LD B,16
        CALL LY_DISK+15
        JR NZ,P9_HALT
        LD HL,0500H+2024
        LD DE,LY_CID
        CALL LY_CCMP
        JR NZ,P9_HALT
        LD DE,0500H
        LD BC,2048
        CALL LY_CCRC
P9_EXPECT: LD DE,COMMAND_STAGE2_CRC
        OR A
        SBC HL,DE
        JR NZ,P9_HALT
        JP 0500H
P9_HALT:
        LD A,'!'
        OUT (1),A
        HALT
        JR P9_HALT
        END
