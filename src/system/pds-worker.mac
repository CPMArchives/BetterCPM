; Cold composition and warm validation; fetched into finished transient memory.
        INCLUDE layout.inc
        INCLUDE profile.inc
        ASEG
        ORG PW_BASE
        JP PW_ENTER
        JP PC_VALIDATE
        JP PW_BIND

        INCLUDE command-record.inc

PW_ENTER:
        LD A,(LY_SYS+095H)
        BIT 1,A
        JP NZ,PW_WARM
        LD C,13
        CALL LY_BDOS
; Cold image defaults, never a fallback for a corrupt live directory.
        LD HL,192
        LD (LY_PD2+4),HL
        LD HL,0
        LD (LY_PD2+6),HL
        LD (LY_PD2+8),HL
; BIOS logical records 1 and 2; stack and work buffer do not overlap code.
        LD BC,0
        LD E,C
        CALL LY_BIOS+27
        LD A,H
        OR L
        JR Z,PW_DEFAULT
        LD BC,0
        CALL LY_BIOS+30
        LD BC,1
        LD DE,01000H
        CALL PW_READ
        JR NZ,PW_DEFAULT
        LD BC,2
        LD DE,01080H
        CALL PW_READ
        JR NZ,PW_DEFAULT
        LD IX,01000H
        CALL PC_VALIDATE
        JR NZ,PW_DEFAULT
        LD A,(01004H)
        CP 2
        JR NZ,PW_COMPOSE
        LD A,(01091H)                   ; CE history choice, offset 145
        LD HL,PW_HSIZES
        CALL PW_SIZE
        LD (LY_PD2+4),HL
        LD A,(01092H)
        LD HL,0
        OR A
        JR Z,PW_NO_MCL
        LD L,128
PW_NO_MCL:
        LD (LY_PD2+6),HL
        LD A,(01093H)
        LD HL,PW_VSIZES
        CALL PW_SIZE
        LD (LY_PD2+8),HL
        JR PW_COMPOSE
PW_DEFAULT:
        LD DE,PW_FALLBACK
        LD C,9
        CALL LY_BDOS
PW_COMPOSE:
        LD HL,0                        ; keep signature invalid until owner storage is cleared
        LD (LY_PD2),HL
        LD HL,00C02H                   ; ABI 2, twelve-byte header
        LD (LY_PD2+2),HL
        LD HL,LY_PD2
        LD B,5
        CALL PW_SUM
        LD HL,-04450H                  ; checksum includes the signature published last
        OR A
        SBC HL,DE
        LD (LY_PD2+10),HL
        LD HL,LY_PD2
        LD DE,(LY_PD2+4)
        OR A
        SBC HL,DE
        LD DE,(LY_PD2+6)
        SBC HL,DE
        LD DE,(LY_PD2+8)
        SBC HL,DE
        LD DE,LY_PD2
        LD A,H
        CP D
        JR NZ,PW_CLEAR
        LD A,L
        CP E
        JR Z,PW_READY
PW_CLEAR:
        LD (HL),0
        INC HL
        LD A,H
        CP D
        JR NZ,PW_CLEAR
        LD A,L
        CP E
        JR NZ,PW_CLEAR
PW_READY:
        LD HL,04450H
        LD (LY_PD2),HL
        CALL PH_VALIDATE
        RET NZ
        PUSH HL
        LD DE,-1024
        ADD HL,DE
        LD (RX_BASE),HL
        IF BP_CHECKED EQ 0
        LD (RX_CALL),HL
        ENDIF
        LD DE,03FDH
        ADD HL,DE
        LD (RX_STACK),HL
        POP HL
        LD (LY_SYS+088H),HL            ; empty RSX boundary = actual PDS low
        DEC HL
        DEC HL
        DEC HL
        LD (LY_SYS+090H),HL
        LD (6),HL
        LD (HL),0C3H
        INC HL
        LD (HL),LY_BDOS AND 255
        INC HL
        LD (HL),LY_BDOS/256
        LD A,(LY_SYS+095H)
        SET 1,A
        LD (LY_SYS+095H),A
PW_WARM:
        CALL PH_VALIDATE
        JR NZ,PW_HBAD
        PUSH HL
        LD DE,(LY_PD2+4)
        LD A,D
        OR E
        CALL NZ,PW_HIST
        POP HL
        RET
PW_HBAD:
        LD DE,PW_CORRUPT
        LD C,9
        CALL LY_BDOS
        JP PC_BAD
PW_CORRUPT: DB 'PDS invalid; cold boot required.',13,10,'$'

PW_READ:
        PUSH DE
        CALL LY_BIOS+33
        POP BC
        CALL LY_BIOS+36
        CALL LY_BIOS+39
        OR A
        RET
PW_SIZE:
        ADD A,A
        LD E,A
        LD D,0
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        EX DE,HL
        RET
PW_FALLBACK: DB 'PDS: invalid saved settings; using defaults.',13,10,'$'

        INCLUDE pds-directory.inc

; IX=CCP owner-operand offsets; HL=editor scratch for disabled HISTORY.
PW_BIND:
        LD (PW_RAW),HL
        LD C,(IX+0)
        LD B,(IX+1)
        INC IX
        INC IX
        LD HL,(LY_SYS+08CH)
        ADD HL,BC
        PUSH HL
        LD HL,(LY_PD2+4)
        LD DE,-9
        ADD HL,DE
        EX DE,HL
        POP HL
        LD (HL),E
        INC HL
        LD (HL),D
        PUSH IX
        CALL PH_VALIDATE
        POP IX
        RET NZ
        LD DE,LY_HIST
        OR A
        SBC HL,DE
        EX DE,HL
        CALL H_PATCH
        LD A,(LY_PD2+4)
        OR A
        JR NZ,PB_WORK
        LD HL,(PW_RAW)
        LD BC,LY_HIST+6
        OR A
        SBC HL,BC
        EX DE,HL
PB_WORK:
H_PATCH:
        LD A,(IX+0)
        INC IX
HP_LOOP:
        PUSH AF
        LD C,(IX+0)
        LD B,(IX+1)
        LD HL,(LY_SYS+08CH)
        ADD HL,BC
        LD C,(HL)
        INC HL
        LD B,(HL)
        PUSH HL
        LD H,B
        LD L,C
        ADD HL,DE
        LD B,H
        LD C,L
        POP HL
        LD (HL),B
        DEC HL
        LD (HL),C
        INC IX
        INC IX
        POP AF
        DEC A
        JR NZ,HP_LOOP
        RET
; HISTORY v1: validate the entire packed record span before command code sees it.
PW_HIST:
        PUSH HL
        POP IX
        LD A,(IX+0)
        CP 'B'
        JR NZ,PH_RESET
        LD A,(IX+1)
        CP 'H'
        JR NZ,PH_RESET
        LD A,(IX+2)
        CP 1
        JR NZ,PH_RESET
        LD E,(IX+4)
        LD D,(IX+5)
        PUSH DE
        LD HL,(LY_PD2+4)
        LD DE,-10
        ADD HL,DE
        POP DE
        OR A
        SBC HL,DE
        JR C,PH_RESET
        LD B,D
        LD C,E
        PUSH IX
        POP HL
        LD DE,10
        ADD HL,DE
        LD D,(IX+3)
        LD A,D
        OR A
        JR Z,PH_END
PH_RECORD:
        LD A,B
        OR C
        JR Z,PH_RESET
        LD A,(HL)
        OR A
        JR Z,PH_RESET
        CP 128
        JR NC,PH_RESET
        INC A
        LD E,A
        LD A,B
        OR A
        JR NZ,PH_BYTES
        LD A,C
        CP E
        JR C,PH_RESET
PH_BYTES:
        INC HL
        DEC BC
        DEC E
        JR NZ,PH_BYTES
        LD A,D
        DEC A
        LD D,A
        JR NZ,PH_RECORD
PH_END:
        LD A,B
        OR C
        RET Z
PH_RESET:
        LD A,(IX+0)
        PUSH AF
        PUSH IX
        POP HL
        LD (HL),'B'
        INC HL
        LD (HL),'H'
        INC HL
        LD (HL),1
        INC HL
        XOR A
        LD (HL),A
        INC HL
        LD (HL),A
        INC HL
        LD (HL),A
        POP AF
        OR A
        RET Z                           ; cold zeroed storage is ordinary initialization
        LD DE,PH_NOTICE
        LD C,9
        CALL LY_BDOS
        XOR A
        RET
PH_NOTICE: DB 'History reset.',13,10,'$'
PW_RAW: DW 0
        END
