        INCLUDE layout.inc

; ********************************************************************************
; *                   BetterCP/M Protected Extension Services                    *
; *                                                                              *
; * Protected extension controls and compatibility adapters surrounding the unified *
; * filesystem. The entry runs before the core adopts its private stack because  *
; * RSX management may recursively invoke ordinary BDOS services.                *
; ********************************************************************************

        CSEG
        .PHASE  LY_EXT
        JP      EX_ENTRY
        JP      AD_LOGIN
        JP      AD_OPEN
        JP      AD_READ
        JP      CL_NEXT

        INCLUDE core.inc
CPTCOUNT        EQU     LY_SYS+094H
CPTFLAGS        EQU     LY_SYS+095H
CPTABLE         EQU     LY_SYS+096H
RSXCONTROL      EQU     LY_RSX
BIOCURSOR       EQU     LY_BIOS+54
COREBDOS        EQU     LY_BDOS

; ================================================================================
; =                          Protected Extension Entry                           =
; =                                                                              =
; = Provides the pre-core extension boundary and return conventions used before the =
; = unified BDOS switches to its private stack.                                  =
; ================================================================================
; -------------------------------------------------------------------------------
; Entry and Return
; -------------------------------------------------------------------------------

EX_ENTRY:                               ; enter protected extension layer
        LD A,C
        CP 181
        JP Z,LY_DISK
        LD      (EX_OLDSP),SP
        PUSH    IX
        LD      A,C
        CP      176
        JR      Z,BF_CPXCTL
        CP      177
        JR      Z,BF_RSXCTL
        CP      178
        JP      Z,BF_CURSOR
        CP      179
        JP      Z,BF_CCPPRN
        CP      180
        JP      Z,BF_VERSION
        CP      182
        JR      Z,BF_RSXSVC
        CP      200
        JR      C,EX_UNHANDLED
  ; Functions 200/201 belong to the optional P2DOS frontend. Reaching this
  ; fixed layer proves no RSX claimed the call, so return the frozen absence
  ; result rather than the ordinary unsupported-function zero.
        LD      A,0FFH
        JR      EX_RETURN

EX_UNHANDLED:                           ; reject unsupported extension selector
        XOR     A

EX_RETURN:                              ; return extension status
        LD      L,A
        LD      H,0

EX_RETHL:                               ; return extension value in HL
        LD      A,L
        LD      B,H
        POP     IX
        LD      SP,(EX_OLDSP)
        RET

EX_RET182:                              ; return Function-182 result
        POP     IX
        LD      SP,(EX_OLDSP)
        RET

; ================================================================================
; =                          Extension Control Services                          =
; =                                                                              =
; = Implements protected CPX/RSX control calls, including on-demand RSX manager  =
; = loading and registry/service operations.                                     =
; ================================================================================
; -------------------------------------------------------------------------------
; CPX Control
; -------------------------------------------------------------------------------

BF_CPXCTL:                              ; control CPX profile
        PUSH    DE
        CALL    LY_BIOS+57
        POP     DE
        OR      A
        JR      NZ,EX_RETURN
        JP      LY_CFG+9

; -------------------------------------------------------------------------------
; RSX Control
; -------------------------------------------------------------------------------

BF_RSXCTL:                              ; control RSX profile
                                        ; all v2 operations share one production entry

; -------------------------------------------------------------------------------
; RSX Manager Load
; -------------------------------------------------------------------------------

EX_RLOAD:                               ; load RSX manager overlay
        PUSH    DE
        XOR     A                       ; production transaction entry
        CALL    LY_BIOS+60
        POP     DE
  ; Each control overlay is padded with the fixed BDOS jump at HIST-3.
  ; The former stack top was:
  ;       LD      SP,LY_RSX+0400H
  ; A CALL there pushed its return address over the jump.  Leave those
  ; three bytes alone; the manager stack must end immediately below it.
        OR      A
        JR      NZ,EX_RBAD
        POP     IX                      ; move the saved register to the manager's stack
        LD      SP,LY_RSX+03FDH
        PUSH    IX
        PUSH    DE                      ; preserve the public request for result pickup
        CALL    RSXCONTROL
        POP     DE
        OR      A
        JR      NZ,EX_RMFAIL
        LD      H,D
        LD      L,E
        INC     HL
        INC     HL
        INC     HL
        LD      A,(HL)
        BIT     7,A                     ; direct operation left a private result marker
        JR      Z,EX_RETURN
        LD      (HL),0
        AND     1
        JR      EX_RETURN
EX_RMFAIL:
        POP     IX                      ; leave memory that raw restore overwrites
        LD      SP,(EX_OLDSP)
        PUSH    IX
        PUSH    AF
        LD      A,(LY_RSTA)
        OR      A
        JR      Z,EX_RFAIL
        LD      A,3                     ; restore the old disk-free resolver on failure
        CALL    LY_BIOS+60

EX_RFAIL:                               ; handle RSX manager load failure
        POP     AF
        JR      EX_RETURN

EX_RBAD:                                ; reject invalid RSX request
        LD      A,0FFH
        JR      EX_RETURN

; -------------------------------------------------------------------------------
; RSX Service Lookup
; -------------------------------------------------------------------------------

BF_RSXSVC:                              ; locate RSX-published service
        LD      A,(LY_RSTA)
        OR      A
        JR      Z,BF_RSNONE
        CALL    RSXCONTROL
        JR      EX_RET182

BF_RSNONE:                              ; report missing RSX service
        PUSH    DE
        LD      H,D
        LD      L,E
        LD      BC,12
        ADD     HL,BC
        XOR     A
        LD      B,7

; -------------------------------------------------------------------------------
; RSX Registry Clear
; -------------------------------------------------------------------------------

BF_RSCLR:                               ; clear RSX registry
        LD      (HL),A
        INC     HL
        DJNZ    BF_RSCLR
        INC     A
        LD      (HL),A
        LD      HL,0
        POP     DE
        JR      EX_RET182

  ; BetterCP/M Function 180 returns the protected, versioned descriptor generated
  ; from the normative subsystem matrix. Consumers must validate BV/version 1.

; ================================================================================
; =                          Protected System Services                           =
; =                                                                              =
; = Implements BetterCP/M version and cursor services exported from protected system =
; = code independently of the unified filesystem core.                           =
; ================================================================================
; -------------------------------------------------------------------------------
; Version Descriptor
; -------------------------------------------------------------------------------

BF_VERSION:                             ; return protected version descriptor
        LD      HL,BCV_DESC
        JP      EX_RETHL

; -------------------------------------------------------------------------------
; Cursor Service
; -------------------------------------------------------------------------------

BF_CURSOR:                              ; perform platform cursor service
        LD      A,E
        LD      C,A
        CALL    BIOCURSOR
        OR      A
        JP      Z,EX_RETURN
        LD      A,E
        OR      A
        LD      A,1
        JP      Z,EX_RETURN
        LD      HL,UB_COLUMN
        INC     (HL)
        JP      EX_RETURN

BF_CCPPRN:                              ; print CCP character
        LD      A,(UB_LISTE)
        CPL
        LD      (UB_LISTE),A
        JP      EX_RETURN

  ; These compatibility entry points contain no filesystem engine. Module
  ; files use user zero, preserving the caller's drive, user and DMA selections.

; ================================================================================
; =                      Filesystem Compatibility Adapters                       =
; =                                                                              =
; = Provides thin compatibility entry points into the unified filesystem while   =
; = preserving the caller's drive, user, and DMA selections.                     =
; ================================================================================
; -------------------------------------------------------------------------------
; Compatibility Entry Points
; -------------------------------------------------------------------------------

AD_LOGIN:                               ; adapter drive login
        LD      E,C
        LD      C,14
        JR      AD_CALL

AD_OPEN:                                ; adapter file open
        LD      C,15
        JR      AD_CALL

AD_READ:                                ; adapter sequential read
        LD      (AD_DMA),BC
        LD      C,20

; -------------------------------------------------------------------------------
; Preserved Filesystem Call
; -------------------------------------------------------------------------------

AD_CALL:                                ; call unified filesystem
        LD      HL,(UB_DMA)
        PUSH    HL
        LD      A,(UB_DRIVE)
        PUSH    AF
        LD      A,(UB_USERNO)
        PUSH    AF
        XOR     A
        LD      (UB_USERNO),A
        LD      A,C
        CP      20
        JR      NZ,AD_INVOKE
        LD      HL,(AD_DMA)
        LD      (UB_DMA),HL

AD_INVOKE:                              ; invoke filesystem adapter
        CALL    COREBDOS
        LD      C,A
        POP     AF
        LD      (UB_USERNO),A
        POP     AF
        LD      (UB_DRIVE),A
        POP     HL
        LD      (UB_DMA),HL
        LD      A,C
        OR      A
        RET

 ; COM READER -- the CCP and CPXs may be overwritten after this point.
  ; The module reader's idle FCB is borrowed, not its executable code.

; ================================================================================
; =                            Command Module Reader                             =
; =                                                                              =
; = Reads command-module carriers after the CCP and CPXs may be overwritten, borrowing =
; = only the module reader's idle FCB rather than its executable code.           =
; ================================================================================
; -------------------------------------------------------------------------------
; Module Record Input
; -------------------------------------------------------------------------------

CL_NEXT:                                ; read next command-module record
        PUSH HL
        LD DE,LY_FCB
        LD C,20
        CALL COREBDOS
        OR A
        JR NZ,CL_END
        POP HL
        PUSH HL
        LD DE,127
        ADD HL,DE
        LD DE,(LY_SYS+090H)
        OR A
        SBC HL,DE
        JR NC,CL_BIG
        POP DE
        LD HL,LY_BUF
        LD BC,128
        LDIR
        EX DE,HL
        JR CL_NEXT

CL_END:                                 ; finish module read
        POP HL
        DEC A                           ; EOF=1 is success; other errors stay nonzero
        JP LY_COMDONE

CL_BIG:                                 ; reject oversized module
        POP HL
        LD A,1
        JP LY_COMDONE

; ================================================================================
; =                           Extension Working State                            =
; =                                                                              =
; = Defines saved stack, CPX selector, and adapter DMA state used by protected   =
; = extension services.                                                          =
; ================================================================================
; -------------------------------------------------------------------------------
; Extension State
; -------------------------------------------------------------------------------

EX_OLDSP:       DW      0               ; saved extension stack pointer
BCX_MVAL:       DB      0               ; selected CPX mask
AD_DMA:         DW      0               ; adapter DMA address
        INCLUDE versions.inc
        .DEPHASE
        END
