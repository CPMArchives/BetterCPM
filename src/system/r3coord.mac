        INCLUDE layout.inc
        INCLUDE profile.inc
; @rsx-container-slots@
; Stage-3 bounded carrier-loading coordinator.
;
; DE points to the public Function 177 version-2 request. This phase accepts
; LOAD only, streams the named carrier into the caller-owned workspace, derives
; its framed length, and invokes R3CARR then R3META in LY_CFG. The authoritative
; validator accepts only BRSX v2. Normalized facts then pass to R3PROF for
; general append planning. Failure returns FFh without changing the live RSX
; profile.

; Every disk read occurs during preparation. Later phases replace one another
; in the same overlay slots, so durable facts and handoff roots live in bounded
; caller-owned RAM rather than in the phase that produced them.

RCBASE          EQU     LY_RSX
FLOPEN          EQU     LY_RSX-0400H
FLNEXT          EQU     LY_RSX-0400H+3
CFGB            EQU     LY_CFG

        CSEG
        .PHASE  RCBASE
RC_ENTRY:
        LD      (RC_REQ),DE
        EX      DE,HL
        LD      A,(HL)
        CP      2
        JR      Z,RC_VERSION
        CP      3
        JP      NZ,RC_BAD
RC_VERSION:
        INC     HL
        LD      A,(HL)
        CP      1
        JP      NZ,RC_BAD
        INC     HL
        INC     HL
        LD      A,(HL)
        OR      A
        JP      NZ,RC_BAD
        CALL    RC_CLOCK
        JP      NZ,RC_BAD
        LD      HL,(RC_REQ)
        LD      DE,14
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (RC_LOW),DE
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        IF BP_CHECKED EQ 1
        LD      DE,1000H                ; overlay workspace plus manager stack band
        ELSE
        LD      DE,0F00H                ; overlay workspace plus manager stack band
        ENDIF
        OR      A
        SBC     HL,DE
        JP      C,RC_BAD
        LD      (RC_HIGH),HL             ; reserve one sector for safe handoffs
        LD      HL,(RC_LOW)
        LD      DE,0103H
        OR      A
        SBC     HL,DE
        JP      C,RC_BAD
        LD      HL,(RC_LOW)
        LD      DE,(RC_HIGH)
        OR      A
        SBC     HL,DE
        JP      NC,RC_BAD

        LD A,(LY_RSTA)
        OR A
        JR NZ,RCC_READY
        LD HL,RCC_NAME
        LD A,1
        CALL LY_FILE
        JP NZ,RC_BAD
        LD HL,LY_RSX-0400H
        CALL LY_FILE+3
        JP NZ,RC_BAD
        CALL LY_FILE+3
        JP NZ,RC_BAD
        IF BP_CHECKED EQ 1
        LD HL,LY_RSX-0400H+1000
        LD DE,LY_CID
        CALL LY_CCMP
        JP NZ,RC_BAD
        LD DE,LY_RSX-0400H
        LD BC,1024
        CALL LY_CCRC
        LD DE,BP_CACHE_CRC
        OR A
        SBC HL,DE
        JP NZ,RC_BAD
        ENDIF
RCC_READY:
; Read the fixed 512-byte header after proving that complete transfer fits.
        LD      HL,(RC_LOW)
        LD      (RC_DEST),HL
        CALL    RC_ROOM
        JP      NZ,RC_BAD
        LD      HL,(RC_REQ)
        LD      DE,4
        ADD     HL,DE
        PUSH HL
        LD HL,(RC_REQ)
        LD A,(HL)
        LD BC,0
        CP 3
        JR NZ,RC_OLDSOURCE
        LD DE,18
        ADD HL,DE
        LD C,(HL)
        INC HL
        LD B,(HL)
RC_OLDSOURCE:
        POP HL
        LD A,2
        CALL FLOPEN
        JR Z,RCC_OPEN
        LD HL,(RC_REQ)
        LD A,(HL)
        CP 3
        JP NZ,RC_BAD
        INC HL
        INC HL
        LD A,(HL)
        CP 1
        JP NZ,RC_BAD
        LD HL,(RC_REQ)
        LD DE,4
        ADD HL,DE
        LD BC,0
        LD A,2
        CALL FLOPEN
        JP NZ,RC_BAD
RCC_OPEN:
        LD HL,(RC_REQ)
        LD A,(HL)
        CP 3
        JR NZ,RCC_BEGIN
        PUSH HL
        CALL LY_RSX-0400H+15
        POP HL
        LD DE,18
        ADD HL,DE
        LD (HL),C
        INC HL
        LD (HL),B
RCC_BEGIN:
        CALL    RC_NEXT
        JP      NZ,RC_BAD

; Read only the framing fields needed to discover the exact carrier length.
; R3CARR remains authoritative for the complete fixed-header validation.
        LD      HL,(RC_LOW)
        LD      DE,RC_MAGIC
        LD      B,4
RC_MLOOP:
        LD      A,(DE)
        CP      (HL)
        JP      NZ,RC_BAD
        INC     DE
        INC     HL
        DJNZ    RC_MLOOP
        LD      A,(HL)
        CP      1
        JR      Z,RC_V1
        IF BP_CHECKED EQ 1
        CP      3
        ELSE
        CP      2
        ENDIF
        JP      NZ,RC_BAD
        LD      (RC_FMT),A
        LD      HL,(RC_LOW)
        LD      DE,30
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (RC_MOFF),DE
        LD      HL,0200H
        OR      A
        SBC     HL,DE
        JP      NC,RC_BAD       ; metadata follows a nonempty payload
        LD      HL,(RC_LOW)
        OR      A
        ADD     HL,DE
        JP      C,RC_BAD
        LD      DE,12
        OR      A
        ADD     HL,DE
        JP      C,RC_BAD
        LD      (RC_NEED),HL
        CALL    RC_FILL
        JP      NZ,RC_BAD
        LD      HL,(RC_LOW)
        LD      DE,(RC_MOFF)
        OR      A
        ADD     HL,DE
        JP      C,RC_BAD
        LD      DE,RC_BMET
        LD      B,4
RC_BLOOP:
        LD      A,(DE)
        CP      (HL)
        JP      NZ,RC_BAD
        INC     DE
        INC     HL
        DJNZ    RC_BLOOP
        LD      HL,(RC_LOW)
        LD      DE,(RC_MOFF)
        ADD     HL,DE
        LD      DE,8
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      A,D
        OR      E
        JP      Z,RC_BAD
        LD      HL,(RC_MOFF)
        OR      A
        ADD     HL,DE
        JP      C,RC_BAD
        JR      RC_LENGTH

RC_V1:
        LD      (RC_FMT),A
        LD      HL,(RC_LOW)
        LD      DE,30
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (RC_MOFF),DE
        LD      HL,(RC_LOW)
        LD      DE,42
        ADD     HL,DE
        LD      E,(HL)
        LD      D,0
        LD      HL,(RC_MOFF)
        OR      A
        ADD     HL,DE
        JP      C,RC_BAD

RC_LENGTH:
        LD      (RC_LENVAL),HL
        LD      DE,(RC_LOW)
        OR      A
        ADD     HL,DE
        JP      C,RC_BAD
        LD      (RC_NEED),HL
        CALL    RC_FILL
        JP      NZ,RC_BAD

; Facts and the maximum two packed descriptors occupy 46 bytes after the
; padded carrier stream.  Equality with high is valid because high is exclusive.
        LD      HL,(RC_DEST)
        LD      (RC_FACTS),HL
        LD      DE,46
        OR      A
        ADD     HL,DE
        JP      C,RC_BAD
        LD      DE,(RC_HIGH)
        OR      A
        SBC     HL,DE
        JP      C,RC_SPACE
        JP      NZ,RC_BAD
RC_SPACE:
        LD      HL,(RC_FACTS)
        LD      DE,26
        ADD     HL,DE
        LD      (RC_CURSOR),HL

; Validate the fixed carrier and publish fixed facts.
        LD      HL,RC_NCARR
        CALL    RC_OVER
        JP      NZ,RC_BAD
        LD      HL,(RC_LOW)
        LD      (RC_CREQ),HL
        LD      HL,(RC_LENVAL)
        LD      (RC_CREQ+2),HL
        LD      HL,(RC_REQ)
        LD      DE,4
        ADD     HL,DE
        LD      (RC_CREQ+4),HL
        LD      HL,(RC_CURSOR)
        LD      (RC_CREQ+6),HL
        LD      HL,(RC_HIGH)
        LD      (RC_CREQ+8),HL
        LD      HL,(RC_FACTS)
        LD      (RC_CREQ+10),HL
        LD      A,0CCH
        LD      (RC_CREQ+12),A
        LD      DE,RC_CREQ
        CALL    CFGB
        OR      A
        JP      NZ,RC_BAD
        LD      A,(RC_CREQ+12)
        CP      1
        JP      NZ,RC_BAD

; Validate typed metadata and publish its normalized facts.
        LD      HL,RC_NMETA
        CALL    RC_OVER
        JP      NZ,RC_BAD
        LD      HL,(RC_LOW)
        LD      (RC_MREQ),HL
        LD      HL,(RC_LENVAL)
        LD      (RC_MREQ+2),HL
        LD      HL,(RC_CURSOR)
        LD      (RC_MREQ+4),HL
        LD      HL,(RC_HIGH)
        LD      (RC_MREQ+6),HL
        LD      HL,(RC_FACTS)
        LD      (RC_MREQ+8),HL
        LD      A,0CCH
        LD      (RC_MREQ+10),A
        LD      DE,RC_MREQ
        CALL    CFGB
        OR      A
        JP      NZ,RC_BAD
        LD      A,(RC_MREQ+10)
        CP      1
        JP      NZ,RC_BAD

        LD HL,(RC_LOW)
        LD DE,(RC_FACTS)
        CALL LY_RSX-0400H+9
        JP NZ,RC_BAD
  ; Pass the public request and normalized candidate facts through caller-owned
  ; memory before the profile phase replaces this coordinator.
        LD      HL,(RC_FACTS)
        LD      DE,46
        ADD     HL,DE
        LD      (RC_CONTEXT),HL
        EX      DE,HL
        LD      HL,(RC_REQ)
        EX      DE,HL
        LD      (HL),E
        INC     HL
        LD      (HL),D
        INC     HL
        LD      DE,(RC_FACTS)
        LD      (HL),E
        INC     HL
        LD      (HL),D
        INC     HL
        LD      DE,(RC_HIGH)
        LD      (HL),E
        INC     HL
        LD      (HL),D

  ; R3MOVE supplies the safe code path that replaces LY_RSX with R3PROF.
        LD      HL,RC_NMOVE
        CALL    RC_OVER
        JP      NZ,RC_BAD
        LD      HL,RC_NPROF
        LD      (RC_HREQ),HL
        LD      HL,(RC_HIGH)
        LD      (RC_HREQ+2),HL
        LD      HL,(RC_CONTEXT)
        LD      (RC_HREQ+4),HL
        LD      DE,RC_HREQ
        JP      CFGB+0310H

; Fill through absolute exclusive RC_NEED in complete 512-byte transfers.
RC_FILL:
        LD      HL,(RC_DEST)
        LD      DE,(RC_NEED)
        OR      A
        SBC     HL,DE
        JR      NC,RC_OK
        CALL    RC_ROOM
        RET     NZ
        CALL    RC_NEXT
        RET     NZ
        JR      RC_FILL

RC_NEXT:
        LD      HL,(RC_DEST)
        CALL    FLNEXT
        RET     NZ
        LD      (RC_DEST),HL
RC_OK:
        XOR     A
        RET

; Prove that one more complete stream transfer ends at or below high.
RC_ROOM:
        LD      HL,(RC_DEST)
        LD      DE,0200H
        OR      A
        ADD     HL,DE
        JR      C,RC_NOROOM
        LD      DE,(RC_HIGH)
        OR      A
        SBC     HL,DE
        JR      C,RC_OK
        JR      Z,RC_OK
RC_NOROOM:
        LD      A,0FFH
        OR      A
        RET

; Load a complete private 1 KiB phase into the CONFIG slot.
RC_OVER:                                ; stage outside physical disk workspace
        PUSH    HL
        LD      HL,(RC_HIGH)
        LD      BC,0400H
        ADD     HL,BC
        POP     DE
        XOR     A
        JP      (HL)

; -------------------------------------------------------------------------------
; Optional Clock Profile Exclusion
; -------------------------------------------------------------------------------
; Four-byte and five-byte 104/105 callers cannot identify their buffer width.
; Reject the opposite exact stem before file I/O or live-profile mutation. This
; check belongs in the shared LOAD path, not merely the RSX command utility.
; Ordinary duplicate names remain the prospective builder's responsibility.

RC_CLOCK:                               ; select the conflicting clock stem
        LD      HL,(RC_REQ)
        LD      DE,4
        ADD     HL,DE
        PUSH    HL
        LD      DE,RC_C3
        CALL    RC_MATCH
        POP     HL
        LD      DE,RC_Z8
        JR      Z,RC_CSCAN
        PUSH    HL
        CALL    RC_MATCH
        POP     HL
        JR      NZ,RC_COK
        LD      DE,RC_C3

RC_CSCAN:                               ; inspect bounded persistent name list
        LD      A,(LY_RSTA)
        CP      5
        JR      NC,RC_CBAD
        OR      A
        JR      Z,RC_COK
        LD      C,A
        LD      HL,LY_RSTA+1

RC_CLOOP:                               ; compare one complete eight-byte name
        PUSH    HL
        PUSH    DE
        CALL    RC_MATCH
        POP     DE
        POP     HL
        JR      Z,RC_CBAD
        PUSH    DE
        LD      DE,8
        ADD     HL,DE
        POP     DE
        DEC     C
        JR      NZ,RC_CLOOP

RC_COK:                                 ; allow unrelated or compatible profile
        XOR     A
        RET
RC_CBAD:                                ; claimed clock profile conflicts
        LD      A,0FFH
        OR      A
        RET
RC_MATCH:                               ; exact canonical padded stem equality
        LD      B,8
RC_CMATCH:
        LD      A,(DE)
        CP      (HL)
        RET     NZ
        INC     DE
        INC     HL
        DJNZ    RC_CMATCH
        XOR     A
        RET

RC_C3:          DB      'T104C3  '
RC_Z8:          DB      'T104Z8  '

RC_BAD:
        LD      A,0FFH
        OR      A
        RET

RC_MAGIC:       DB      'B','R','S','X'
RCC_NAME: DB 'R3CACHE '
RC_BMET:        DB      'B','M','E','T'
RC_NCARR:       DB      R3CARR_RECORD
RC_NMETA:       DB      R3META_RECORD
RC_NMOVE:       DB      R3MOVE_RECORD
RC_NPROF:       DB      R3PROF_RECORD
RC_REQ:         DW      0
RC_LOW:         DW      0
RC_HIGH:        DW      0
RC_DEST:        DW      0
RC_NEED:        DW      0
RC_LENVAL:      DW      0
RC_MOFF:        DW      0
RC_FACTS:       DW      0
RC_CURSOR:      DW      0
RC_CONTEXT:     DW      0
RC_FMT:         DB      0
RC_CREQ:        DS      13
RC_MREQ:        DS      11
RC_HREQ:        DS      6

        .DEPHASE
        END
