        INCLUDE layout.inc
        INCLUDE profile.inc
; @rsx-container-slots@

; ********************************************************************************
; *                    BetterCP/M RSX Transaction Entry                          *
; ********************************************************************************

; Function 177 is the sole production gateway for resident-profile mutation.
; LOAD and UNLOAD first build a complete prospective profile in caller-owned
; transaction RAM. The live chain is unchanged until every fallible read,
; normalization, layout, snapshot, and pointer-repair preparation has passed.
; Commit then consists only of bounded memory operations and final publication.

        IF BP_CHECKED EQ 1
RVBASE          EQU     LY_CFG
        ELSE
RVBASE          EQU     LY_RSX
        ENDIF
RV_WORKHIGH     EQU     07000H          ; transaction RAM stays below resident moves
RSTCOUNT        EQU     LY_RSTA
RSTABLE         EQU     LY_RSTA+1
RSTSERV         EQU     LY_RSTA+021H
        CSEG
        .PHASE  RVBASE

  ; Production Function 177 entry for BRSX-v2 profile control. LOAD and UNLOAD
  ; use the prepared transaction; LIST and QUERY read the persistent profile.
  ; Version 1 carriers are deliberately excluded: they cannot declare the
  ; reconstruction class and runtime pointer slots required for safe movement.

RV_ENTRY:                               ; enter production profile selector
        LD      (RV_REQ),DE
        LD      A,(DE)
        CP      2
        JR Z,RV_VERSION
        CP 3
        JP NZ,RV_BAD
        PUSH DE
        EX DE,HL
        LD DE,18
        ADD HL,DE
        LD A,(HL)
        CP 16
        JR NC,RV_BADSOURCE
        INC HL
        LD A,(HL)
        CP 32
RV_BADSOURCE:
        POP DE
        JP NC,RV_BAD
RV_VERSION:
        LD      A,(RSTCOUNT)
        CP      5
        JP      NC,RV_BAD
        INC     DE
        LD      A,(DE)
        OR      A
        JR      Z,RV_ENUM
        CP      1
        JR      Z,RV_LOAD
        CP      2
        JR      Z,RV_UNLOAD
        CP      3
        JR      Z,RV_QUERY
        CP      4
        JR      Z,RV_RETIRE
        JP      RV_BAD

RV_ENUM:                                ; enumerate one persistent profile member
        LD      HL,(RV_REQ)
        INC     HL
        INC     HL
        LD      A,(HL)
        LD      B,A
        LD      A,(RSTCOUNT)
        CP      B
        JP      Z,RV_ZERO
        JP      C,RV_ZERO
        LD      A,B
        PUSH    AF
        CALL    RV_TABPTR
        PUSH    HL
        LD      HL,(RV_REQ)
        LD      BC,4
        ADD     HL,BC
        EX      DE,HL
        POP     HL
        LD      BC,8
        LDIR
        POP     AF
        CALL    RV_SERVPTR
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      HL,(RV_REQ)
        LD      BC,12
        ADD     HL,BC
        LD      (HL),E
        INC     HL
        LD      (HL),D
        CALL RV_LOCATION
        LD      A,1
        JP      RV_RESTORE

RV_QUERY:                               ; query one persistent profile member
        CALL    RV_FIND
        JP      C,RV_ZERO
        CALL RV_LOCATION
        LD      A,1
        JP      RV_RESTORE

RV_LOAD:                                ; select append transaction
        LD HL,(RV_REQ)
        LD A,(HL)
        CP 3
        JR NZ,RV_LFLAGS
        INC HL
        INC HL
        LD A,(HL)
        CP 2
        JP NC,RV_BAD
RV_LFLAGS:
        CALL    RV_FIND
        JP      NC,RV_ZERO              ; an existing load is idempotent
        LD      A,(RSTCOUNT)
        CP      4
        JP      NC,RV_BAD
        LD      HL,RV_NLOAD
        JR      RV_START

RV_UNLOAD:                              ; select removal transaction
        CALL    RV_FIND
        JP      C,RV_ZERO               ; an absent unload is idempotent
        LD      HL,RV_NDROP
        JR      RV_START

RV_RETIRE:                              ; remove the calling provider, then WBOOT
        CALL    RV_FIND
        JP      C,RV_ZERO
        LD      HL,(RV_REQ)
        LD      DE,14
        ADD     HL,DE
        LD      DE,0103H                ; command environment is disposable now
        LD      (HL),E
        INC     HL
        LD      (HL),D
        INC     HL
        LD      DE,(0006H)
        LD      (HL),E
        INC     HL
        LD      (HL),D
        LD      HL,RV_NDROP

RV_START:                               ; load the safe overlay handoff
        LD      (RV_HREQ),HL
        LD      HL,(RV_REQ)
        LD      (RV_HREQ+4),HL
        LD      DE,16
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      HL,(0006H)              ; reject a ceiling above the active TPA
        OR      A
        SBC     HL,DE
        JP      C,RV_BAD
  ; A caller's TPA/stack ceiling can overlap both this temporary manager and
  ; prospective resident destinations. Keep transaction RAM in the lower TPA
  ; and publish that effective ceiling to every later preparation phase.
        LD      HL,RV_WORKHIGH
        OR      A
        SBC     HL,DE
        JR      NC,RV_HIGHOK
        LD      DE,RV_WORKHIGH
        LD      HL,(RV_REQ)
        LD      BC,16
        ADD     HL,BC
        LD      (HL),E
        INC     HL
        LD      (HL),D

RV_HIGHOK:                              ; use the effective workspace ceiling
        EX      DE,HL
        LD      D,H                     ; retain the effective caller ceiling
        LD      E,L
        IF BP_CHECKED EQ 1
        LD      BC,1000H                ; overlay workspace plus manager stack band
        ELSE
        LD      BC,0F00H                ; overlay workspace plus manager stack band
        ENDIF
        OR      A
        SBC     HL,BC
        JP      C,RV_BAD
        LD      (RV_HREQ+2),HL
        EX      DE,HL                    ; HL = effective caller ceiling
  ; Move the fixed EX_RLOAD frame (return, request, saved IX) to the isolated
  ; 256-byte band above all disk/overlay scratch. EX_RETURN ultimately restores
  ; the original extension stack recorded before the transaction began.
        LD      BC,6
        OR      A
        SBC     HL,BC
        EX      DE,HL                    ; DE = relocated frame destination
        LD      HL,0
        ADD     HL,SP                    ; HL = current three-word frame
        LD      BC,6
        LDIR
        EX      DE,HL                    ; HL = private manager-stack top
        LD      BC,6
        OR      A
        SBC     HL,BC
        LD      SP,HL
        LD      HL,(RV_HREQ+2)
        PUSH    HL                      ; scratch must remain above workspace low
        LD      HL,(RV_REQ)
        LD      DE,14
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        POP     DE
        PUSH    HL
        LD      BC,0103H
        OR      A
        SBC     HL,BC
        POP     HL
        JP      C,RV_BAD
        OR      A
        SBC     HL,DE
        JP      NC,RV_BAD
        CALL PX_STAGE
        JP NZ,RV_BAD
        IF BP_CHECKED EQ 1
        LD      A,(RSTCOUNT)
        OR      A
        JR      Z,RV_NOBACK
        LD      HL,(RV_HREQ+2)
        LD      DE,0B00H
        ADD     HL,DE
        LD      (LY_CBACK),HL
        EX      DE,HL
        LD      HL,LY_RSX
        LD      BC,03F4H
        LDIR
RV_NOBACK:
        ENDIF
        LD      HL,(RV_HREQ+2)
        LD      BC,0400H
        ADD     HL,BC
        PUSH    HL
        EX      DE,HL
        LD      HL,(PX_HEADER)
        LD      BC,0800H
        ADD     HL,BC
        LD      BC,0200H
        LDIR
        POP     HL
        LD      DE,RV_HREQ
        LD      A,1
        JP      (HL)

        IF BP_CHECKED EQ 1
; Checked entry executes in CFG. Stage from caller RAM and restore CFG before
; returning: physical reads are allowed to overwrite the complete entry image.
PX_STAGE:
        PUSH IX
        PUSH IY
        LD HL,(RV_HREQ+2)
        PUSH HL
        EX DE,HL
        LD HL,LY_CFG
        LD BC,0400H
        LDIR
        POP HL
        PUSH HL
        LD DE,0400H
        ADD HL,DE
        PUSH HL
        EX DE,HL
        LD HL,PX_CODE
        LD BC,PX_END-PX_CODE
        LDIR
        POP HL
        PUSH HL
        LD DE,PX_EXIT-PX_CODE
        ADD HL,DE
        PUSH HL
        POP IY
        POP HL
        LD DE,0200H
        ADD HL,DE
        PUSH HL
        POP IX
        POP DE
        LD (IX+2),E
        LD (IX+3),D
        LD HL,(RV_REQ)
        LD (IX+0),L
        LD (IX+1),H
        PUSH IX
        POP DE
        LD HL,12
        ADD HL,DE
        EX DE,HL
        LD HL,PX_DATA
        LD BC,12
        LDIR
        PUSH IX
        POP HL
        LD DE,0200H
        OR A
        SBC HL,DE
        LD DE,PX_BACK
        PUSH DE
        JP (HL)
PX_BACK:
        POP IY
        POP IX
        RET
PX_DATA: DB 'R3DCR3CACHE '
PX_HEADER: DW 0
PX_CODE:
        LD L,(IX+0)
        LD H,(IX+1)
        LD DE,14
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        EX DE,HL
        LD DE,255
        ADD HL,DE
        JR NC,CK_01
        LD A,255
        JP (IY)
CK_01:  LD L,0
        LD (IX+4),L
        LD (IX+5),H
        LD DE,0A00H
        ADD HL,DE
        JR NC,CK_02
        LD A,255
        JP (IY)
CK_02:  PUSH HL
        LD E,(IX+2)
        LD D,(IX+3)
        OR A
        SBC HL,DE
        POP HL
        JR C,CK_03
        LD A,255
        JP (IY)
CK_03:  EX DE,HL
        LD L,(IX+0)
        LD H,(IX+1)
        LD BC,14
        ADD HL,BC
        LD (HL),E
        INC HL
        LD (HL),D
        PUSH IX
        POP HL
        LD DE,16
        ADD HL,DE
        LD A,1
        CALL LY_FILE
        JR Z,CK_04
        LD A,255
        JP (IY)
CK_04:  LD L,(IX+4)
        LD H,(IX+5)
        LD B,5
CK_READ:
        PUSH BC
        CALL LY_FILE+3
        POP BC
        JR Z,CK_05
        LD A,255
        JP (IY)
CK_05:  DJNZ CK_READ
        ; Authenticate the whole matched private worker before using its
        ; relocation metadata; unlike the unchecked path no signature scan
        ; is needed in addition to the identity and expected CRC.
        LD L,(IX+4)
        LD H,(IX+5)
        LD DE,8
        ADD HL,DE
        LD DE,LY_CID
        CALL LY_CCMP
        JR Z,CK_08
        LD A,255
        JP (IY)
CK_08:  LD E,(IX+4)
        LD D,(IX+5)
        LD BC,2560
        CALL LY_CCRC
        LD DE,BP_CACHE_CRC
        OR A
        SBC HL,DE
        JR Z,CK_09
        LD A,255
        JP (IY)
CK_09:  LD L,(IX+4)
        LD H,(IX+5)
        LD DE,4
        ADD HL,DE
        LD A,(HL)
        LD (IX+10),A
        LD L,(IX+4)
        LD H,(IX+5)
        LD DE,512
        ADD HL,DE
        LD (IX+6),L
        LD (IX+7),H
        LD DE,01000H
        OR A
        SBC HL,DE
        LD (IX+8),L
        LD (IX+9),H
        LD L,(IX+4)
        LD H,(IX+5)
        LD DE,32
        ADD HL,DE
CK_LOOP:
        LD A,(IX+10)
        OR A
        JR Z,CK_DONE
        LD E,(HL)
        INC HL
        LD D,(HL)
        INC HL
        PUSH HL
        LD HL,1535
        OR A
        SBC HL,DE
        POP HL
        JR C,CK_BAD
        JR Z,CK_BAD
        PUSH HL
        LD L,(IX+6)
        LD H,(IX+7)
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        PUSH HL
        EX DE,HL
        LD C,(IX+8)
        LD B,(IX+9)
        ADD HL,BC
        EX DE,HL
        POP HL
        LD (HL),D
        DEC HL
        LD (HL),E
        POP HL
        DEC (IX+10)
        JR CK_LOOP
CK_BAD: LD A,255
        JP (IY)
CK_DONE:
        LD L,(IX+6)
        LD H,(IX+7)
        LD DE,33
        ADD HL,DE
        LD (LY_FCB+34),HL
        LD A,0C3H
        LD (LY_FCB+33),A
        CALL LY_FCB+33
        DB 27
PX_EXIT:
        PUSH AF
        LD L,(IX+2)
        LD H,(IX+3)
        LD DE,LY_CFG
        LD BC,0400H
        LDIR
        LD L,(IX+4)
        LD H,(IX+5)
        LD (PX_HEADER),HL
        POP AF
        OR A
        RET
PX_END:
        ELSE
; Reserve a page-aligned, caller-owned 2.5KiB worker below overlay scratch.
PX_STAGE:
        LD HL,(RV_REQ)
        LD DE,14
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        EX DE,HL
        LD DE,255
        ADD HL,DE
        JP C,PX_BAD
        LD L,0
        LD (PX_HEADER),HL
        LD DE,0A00H
        ADD HL,DE
        JP C,PX_BAD
        PUSH HL
        LD DE,(RV_HREQ+2)
        OR A
        SBC HL,DE
        POP HL
        JP NC,PX_BAD
        EX DE,HL
        LD HL,(RV_REQ)
        LD BC,14
        ADD HL,BC
        LD (HL),E
        INC HL
        LD (HL),D
        LD HL,PX_FILE
        LD A,1
        CALL LY_FILE
        JP NZ,PX_BAD
        LD HL,(PX_HEADER)
        LD B,5
PX_READ:
        PUSH BC
        CALL LY_FILE+3
        POP BC
        JP NZ,PX_BAD
        DJNZ PX_READ
        LD HL,(PX_HEADER)
        LD DE,PX_MAGIC
        LD B,4
PX_CHECK:
        LD A,(DE)
        CP (HL)
        JP NZ,PX_BAD
        INC HL
        INC DE
        DJNZ PX_CHECK
        LD A,(HL)
        CP 241
        JP NC,PX_BAD
        LD (PX_COUNT),A
        IF BP_CHECKED EQ 1
        LD HL,(PX_HEADER)
        LD DE,8
        ADD HL,DE
        LD DE,LY_CID
        CALL LY_CCMP
        JP NZ,PX_BAD
        LD DE,(PX_HEADER)
        LD BC,2560
        CALL LY_CCRC
        LD DE,BP_CACHE_CRC
        OR A
        SBC HL,DE
        JP NZ,PX_BAD
        ENDIF
        LD HL,(PX_HEADER)
        LD DE,512
        ADD HL,DE
        LD (PX_BASE),HL
        LD DE,01000H
        OR A
        SBC HL,DE
        LD (PX_DELTA),HL
        LD HL,(PX_HEADER)
        LD DE,32
        ADD HL,DE
PX_RELOC:
        LD A,(PX_COUNT)
        OR A
        JR Z,PX_READY
        LD E,(HL)
        INC HL
        LD D,(HL)
        INC HL
        PUSH HL
        LD HL,1535
        OR A
        SBC HL,DE
        POP HL
        JP C,PX_BAD
        JP Z,PX_BAD
        PUSH HL
        LD HL,(PX_BASE)
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        PUSH HL
        EX DE,HL
        LD DE,(PX_DELTA)
        ADD HL,DE
        EX DE,HL
        POP HL
        LD (HL),D
        DEC HL
        LD (HL),E
        POP HL
        LD A,(PX_COUNT)
        DEC A
        LD (PX_COUNT),A
        JR PX_RELOC
PX_READY:
        LD HL,(PX_BASE)
        LD DE,33
        ADD HL,DE
        LD (LY_FCB+34),HL
        LD A,0C3H
        LD (LY_FCB+33),A
        CALL LY_FCB+33
        DB 27                           ; cleanup before candidate preparation
        RET
PX_BAD: LD A,255
        OR A
        RET
PX_FILE: DB 'R3CACHE '
PX_MAGIC: DB 'R3DC'
PX_HEADER: DW 0
PX_BASE: DW 0
PX_DELTA: DW 0
PX_COUNT: DB 0
        ENDIF
RV_ZERO:                                ; return an idempotent miss or no-op
        XOR     A

RV_RESTORE:                             ; restore the resolver after a direct result
        LD      B,A
        LD      A,(RSTCOUNT)
        OR      A
        LD      A,B
        RET     Z                       ; an empty profile has no resolver to restore
        AND     1
        OR      080H
        LD      HL,(RV_REQ)
        INC     HL
        INC     HL
        INC     HL
        LD      (HL),A                  ; private result consumed by extensions
        LD      A,3                     ; restore the disk-free resolver
        JP      LY_BIOS+60

RV_FIND:                                ; locate the requested persistent name
        LD      A,(RSTCOUNT)
        LD      B,A
        XOR     A
RV_FINDLP:                              ; compare another profile member
        LD      C,A
        LD      A,B
        OR      A
        JR      Z,RV_MISS
        LD      A,C
        CALL    RV_TABPTR
        LD      DE,(RV_REQ)
        INC     DE
        INC     DE
        INC     DE
        INC     DE
        PUSH    BC
        LD      B,8
RV_COMPARE:                             ; compare the eight-byte filename stem
        LD      A,(DE)
        CP      (HL)
        JR      NZ,RV_DIFFER
        INC     DE
        INC     HL
        DJNZ    RV_COMPARE
        POP     BC
        LD      A,C
        OR      A                       ; clear carry while retaining index
        RET
RV_DIFFER:                              ; advance to the next profile member
        POP     BC
        LD      A,C
        INC     A
        DEC     B
        JR      RV_FINDLP
RV_MISS:                                ; report an absent filename
        SCF
        RET

RV_TABPTR:                              ; locate one persistent filename record
        ADD     A,A
        ADD     A,A
        ADD     A,A
        LD      L,A
        LD      H,0
        LD      DE,RSTABLE
        ADD     HL,DE
        RET

RV_SERVPTR:                             ; locate one primary-service record
        ADD     A,A
        LD      L,A
        LD      H,0
        LD      DE,RSTSERV
        ADD     HL,DE
        RET

RV_LOCATION:
        LD HL,(RV_REQ)
        LD A,(HL)
        CP 3
        RET NZ
        PUSH HL
        LD DE,4
        ADD HL,DE
        LD A,1
        CALL RV_FIND
        LD B,A
        LD HL,(LY_SYS+084H)
PX_CHAIN:
        LD A,B
        OR A
        JR Z,PX_FOUND
        LD E,(HL)
        INC HL
        LD D,(HL)
        EX DE,HL
        LD DE,8
        OR A
        SBC HL,DE
        DJNZ PX_CHAIN
PX_FOUND:
        PUSH HL
        LD DE,6
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        POP HL
        ADD HL,DE
        LD DE,4
        OR A
        SBC HL,DE
        LD C,(HL)
        INC HL
        LD B,(HL)
        POP HL
        LD DE,18
        ADD HL,DE
        LD (HL),C
        INC HL
        LD (HL),B
        RET

RV_BAD:                                 ; reject an unavailable transaction phase
        LD      A,0FFH
        OR      A
        RET

RV_NLOAD:       DB      R3COORD_RECORD      ; append transaction coordinator
RV_NDROP:       DB      R3DROP_RECORD      ; removal transaction coordinator
RV_REQ:         DW      0               ; public Function-177 request
RV_HREQ:                                ; replacement-overlay handoff request
        REPT    6
        DB      0
        ENDM


; Position-independent overlay reader copied to scratch+0400H. HL is its
; runtime entry address, DE is a slot descriptor (A=0) or handoff request (A=1).
; Scratch holds a complete image, code, private state/stack, and a saved CFG.
        IF 0                            ; built into the staged worker file
RI_ENTRY:                               ; enter position-independent staged reader
        PUSH    IX
        POP     BC
        PUSH    DE
        IF BP_CHECKED EQ 1
        LD      DE,0200H
        ELSE
        LD      DE,0100H
        ENDIF
        ADD     HL,DE
        PUSH    HL
        POP     IX
        POP     DE
        LD      (IX+16),C
        LD      (IX+17),B
        LD      (IX+0),A
        LD      HL,0
        ADD     HL,SP
        LD      (IX+2),L
        LD      (IX+3),H
        PUSH    IX
        POP     HL
        LD      BC,0100H
        ADD     HL,BC
        LD      SP,HL
        OR      A
        JR      Z,RI_NAME
        EX      DE,HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     HL
        INC     HL
        INC     HL
        LD      A,(HL)
        LD      (IX+4),A
        INC     HL
        LD      A,(HL)
        LD      (IX+5),A
        PUSH    DE
        PUSH    IX
        POP     DE
        LD      HL,0100H
        ADD     HL,DE
        EX      DE,HL
        LD      HL,LY_CFG
        LD      BC,0400H
        LDIR
        POP     DE
RI_NAME:                                ; open the container at selected record
        LD      A,(DE)
        LD      (IX+18),A
        PUSH    IX
        POP     HL
        IF BP_CHECKED EQ 1
        LD      DE,RI_PACK-RI_ENTRY-0200H
        ELSE
        LD      DE,RI_PACK-RI_ENTRY-0100H
        ENDIF
        ADD     HL,DE
        LD      A,1
        CALL    LY_FILE
        IF BP_CHECKED EQ 1
        JR Z,RIX1
        LD HL,RI_FAIL-RI_ENTRY-0200H
        PUSH IX
        POP DE
        ADD HL,DE
        JP (HL)
RIX1:
        ELSE
        JR      NZ,RI_FAIL
        ENDIF
        LD      A,(LY_FCB+15)
        IF BP_CHECKED EQ 1
        CP      124                     ; exact packed length within extent zero
        JR Z,RIX2
        LD HL,RI_FAIL-RI_ENTRY-0200H
        PUSH IX
        POP DE
        ADD HL,DE
        JP (HL)
RIX2:
        ELSE
        CP      120                     ; exact packed length within extent zero
        JR      NZ,RI_FAIL
        ENDIF
        LD      A,(IX+18)
        CP      113
        IF BP_CHECKED EQ 1
        JR C,RIX3
        LD HL,RI_FAIL-RI_ENTRY-0200H
        PUSH IX
        POP DE
        ADD HL,DE
        JP (HL)
RIX3:
        ELSE
        JR      NC,RI_FAIL
        ENDIF
        AND     7
        IF BP_CHECKED EQ 1
        JR Z,RIX4
        LD HL,RI_FAIL-RI_ENTRY-0200H
        PUSH IX
        POP DE
        ADD HL,DE
        JP (HL)
RIX4:
        ELSE
        JR      NZ,RI_FAIL
        LD      A,(IX+18)
        LD      (LY_FCB+32),A
        ENDIF
        PUSH    IX
        POP     HL
        IF BP_CHECKED EQ 1
        LD      DE,0600H
        ELSE
        LD      DE,0500H
        ENDIF
        OR      A
        SBC     HL,DE
        PUSH    HL
        CALL    LY_FILE+3
        IF BP_CHECKED EQ 1
        JR Z,RIX5
        LD HL,RI_READFAIL-RI_ENTRY-0200H
        PUSH IX
        POP DE
        ADD HL,DE
        JP (HL)
RIX5:
        LD      A,(LY_FCB+32)
        CP      4
        JR Z,RIX6
        LD HL,RI_READFAIL-RI_ENTRY-0200H
        PUSH IX
        POP DE
        ADD HL,DE
        JP (HL)
RIX6:
        POP     DE
        PUSH    DE
        LD      BC,0200H
        CALL    LY_CCRC
RI_EXPECT: LD DE,BP_PACK_CRC
        OR      A
        SBC     HL,DE
        JR Z,RIX7
        LD HL,RI_READFAIL-RI_ENTRY-0200H
        PUSH IX
        POP DE
        ADD HL,DE
        JP (HL)
RIX7:
        POP     HL
        PUSH    HL
        LD      DE,8
        ADD     HL,DE
        PUSH    IX
        POP     DE
        EX      DE,HL
        LD      BC,RI_ID-RI_ENTRY-0200H
        ADD     HL,BC
        EX      DE,HL
        LD      B,16
RI_IDENT:
        LD      A,(DE)
        CP      (HL)
        JR Z,RIX8
        LD HL,RI_READFAIL-RI_ENTRY-0200H
        PUSH IX
        POP DE
        ADD HL,DE
        JP (HL)
RIX8:
        INC     DE
        INC     HL
        DJNZ    RI_IDENT
        POP     HL
        PUSH    HL
        LD      A,(IX+18)
        ADD     A,40
        LD      E,A
        LD      D,0
        ADD     HL,DE
        LD      A,(HL)
        LD      (IX+19),A
        INC     HL
        LD      A,(HL)
        LD      (IX+20),A
        LD      A,(IX+18)
        ADD     A,4
        LD      (LY_FCB+32),A
        POP     HL
        PUSH    HL
        ELSE
        JR      NZ,RI_READFAIL
        ENDIF
        CALL    LY_FILE+3
        IF BP_CHECKED EQ 1
        JR Z,RIX9
        LD HL,RI_READFAIL-RI_ENTRY-0200H
        PUSH IX
        POP DE
        ADD HL,DE
        JP (HL)
RIX9:
        CALL    LY_FILE+3
        JR Z,RIX10
        LD HL,RI_READFAIL-RI_ENTRY-0200H
        PUSH IX
        POP DE
        ADD HL,DE
        JP (HL)
RIX10:
        ELSE
        JR      NZ,RI_READFAIL
        ENDIF
        LD      A,(IX+18)
        IF BP_CHECKED EQ 1
        ADD     A,12
        ELSE
        ADD     A,8
        ENDIF
        LD      C,A
        LD      A,(LY_FCB+32)
        CP      C
        IF BP_CHECKED EQ 1
        JR Z,RIX11
        LD HL,RI_READFAIL-RI_ENTRY-0200H
        PUSH IX
        POP DE
        ADD HL,DE
        JP (HL)
RIX11:
        POP     DE
        PUSH    DE
        LD      BC,0400H
        CALL    LY_CCRC
        LD      E,(IX+19)
        LD      D,(IX+20)
        OR      A
        SBC     HL,DE
        JR Z,RIX12
        LD HL,RI_READFAIL-RI_ENTRY-0200H
        PUSH IX
        POP DE
        ADD HL,DE
        JP (HL)
RIX12:
        ELSE
        JR      NZ,RI_READFAIL           ; reject a partially padded block
        ENDIF
        POP     HL
        LD      A,(IX+0)
        OR      A
        LD      DE,LY_CFG
        LD      BC,0400H
        JR      Z,RI_COPY
        LD      DE,LY_RSX
        LD      BC,03F4H
RI_COPY:                                ; install the complete staged image
        LDIR
        LD      A,(IX+0)
        OR      A
        JR      Z,RI_OK
        PUSH    IX
        POP     HL
        LD      DE,0100H
        ADD     HL,DE
        LD      DE,LY_CFG
        LD      BC,0400H
        LDIR
RI_OK:                                  ; report successful replacement
        XOR     A
        JR      RI_RETURN
RI_READFAIL:                            ; unwind the staged destination
        POP     HL
RI_FAIL:                                ; report overlay read failure
        LD      A,0FFH
RI_RETURN:                              ; restore the caller frame and dispatch
        LD      L,(IX+2)
        LD      H,(IX+3)
        LD      SP,HL
        LD      E,(IX+4)
        LD      D,(IX+5)
        LD      B,(IX+0)
        LD      L,(IX+16)
        LD      H,(IX+17)
        PUSH    HL
        POP     IX
        OR      A
        RET     NZ
        LD      A,B
        OR      A
        RET     Z
        LD      A,D
        OR      E
        RET     Z
        JP      LY_RSX
RI_PACK: DB 'R3PACK  '
        IF BP_CHECKED EQ 1
RI_ID: DB BP_ID0,BP_ID1,BP_ID2,BP_ID3,BP_ID4,BP_ID5,BP_ID6,BP_ID7,BP_ID8,BP_ID9,BP_ID10,BP_ID11,BP_ID12,BP_ID13,BP_ID14,BP_ID15
        ENDIF
RI_END:                                 ; end the copied reader code
        ENDIF

        .DEPHASE
        END
