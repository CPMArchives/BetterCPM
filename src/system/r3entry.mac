        INCLUDE layout.inc

; ********************************************************************************
; *                    BetterCP/M RSX Transaction Entry                          *
; ********************************************************************************

RVBASE          EQU     LY_RSX
RV_WORKHIGH     EQU     07000H          ; transaction RAM stays below resident moves
RSTCOUNT        EQU     LY_RSTA
RSTABLE         EQU     LY_RSTA+1
RSTSERV         EQU     LY_RSTA+021H
        CSEG
        .PHASE  RVBASE

  ; Production Function 202 entry for BRSX-v2 profile control. LOAD and UNLOAD
  ; use the prepared transaction; LIST and QUERY read the persistent profile.

RV_ENTRY:                               ; enter production profile selector
        LD      (RV_REQ),DE
        LD      A,(DE)
        CP      2
        JP      NZ,RV_BAD
        LD      A,(RSTCOUNT)
        CP      5
        JP      NC,RV_BAD
        INC     DE
        LD      A,(DE)
        OR      A
        JR      Z,RV_ENUM
        CP      1
        JR      Z,RV_LOAD
        CP      2
        JR      Z,RV_UNLOAD
        CP      3
        JR      Z,RV_QUERY
        CP      4
        JR      Z,RV_RETIRE
        JP      RV_BAD

RV_ENUM:                                ; enumerate one persistent profile member
        LD      HL,(RV_REQ)
        INC     HL
        INC     HL
        LD      A,(HL)
        LD      B,A
        LD      A,(RSTCOUNT)
        CP      B
        JP      Z,RV_ZERO
        JP      C,RV_ZERO
        LD      A,B
        PUSH    AF
        CALL    RV_TABPTR
        PUSH    HL
        LD      HL,(RV_REQ)
        LD      BC,4
        ADD     HL,BC
        EX      DE,HL
        POP     HL
        LD      BC,8
        LDIR
        POP     AF
        CALL    RV_SERVPTR
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      HL,(RV_REQ)
        LD      BC,12
        ADD     HL,BC
        LD      (HL),E
        INC     HL
        LD      (HL),D
        LD      A,1
        JP      RV_RESTORE

RV_QUERY:                               ; query one persistent profile member
        CALL    RV_FIND
        JP      C,RV_ZERO
        LD      A,1
        JP      RV_RESTORE

RV_LOAD:                                ; select append transaction
        CALL    RV_FIND
        JP      NC,RV_ZERO              ; an existing load is idempotent
        LD      A,(RSTCOUNT)
        CP      4
        JP      NC,RV_BAD
        LD      HL,RV_NLOAD
        JR      RV_START

RV_UNLOAD:                              ; select removal transaction
        CALL    RV_FIND
        JP      C,RV_ZERO               ; an absent unload is idempotent
        LD      HL,RV_NDROP
        JR      RV_START

RV_RETIRE:                              ; remove the calling provider, then WBOOT
        CALL    RV_FIND
        JP      C,RV_ZERO
        LD      HL,(RV_REQ)
        LD      DE,14
        ADD     HL,DE
        LD      DE,0103H                ; command environment is disposable now
        LD      (HL),E
        INC     HL
        LD      (HL),D
        INC     HL
        LD      DE,(0006H)
        LD      (HL),E
        INC     HL
        LD      (HL),D
        LD      HL,RV_NDROP

RV_START:                               ; load the safe overlay handoff
        LD      (RV_HREQ),HL
        LD      HL,(RV_REQ)
        LD      (RV_HREQ+4),HL
        LD      DE,16
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      HL,(0006H)              ; reject a ceiling above the active TPA
        OR      A
        SBC     HL,DE
        JP      C,RV_BAD
  ; A caller's TPA/stack ceiling can overlap both this temporary manager and
  ; prospective resident destinations. Keep transaction RAM in the lower TPA
  ; and publish that effective ceiling to every later preparation phase.
        LD      HL,RV_WORKHIGH
        OR      A
        SBC     HL,DE
        JR      NC,RV_HIGHOK
        LD      DE,RV_WORKHIGH
        LD      HL,(RV_REQ)
        LD      BC,16
        ADD     HL,BC
        LD      (HL),E
        INC     HL
        LD      (HL),D

RV_HIGHOK:                              ; use the effective workspace ceiling
        EX      DE,HL
        LD      D,H                     ; retain the effective caller ceiling
        LD      E,L
        LD      BC,0F00H                ; overlay workspace plus manager stack band
        OR      A
        SBC     HL,BC
        JP      C,RV_BAD
        LD      (RV_HREQ+2),HL
        EX      DE,HL                    ; HL = effective caller ceiling
  ; Move the fixed EX_RLOAD frame (return, request, saved IX) to the isolated
  ; 256-byte band above all disk/overlay scratch. EX_RETURN ultimately restores
  ; the original extension stack recorded before the transaction began.
        LD      BC,6
        OR      A
        SBC     HL,BC
        EX      DE,HL                    ; DE = relocated frame destination
        LD      HL,0
        ADD     HL,SP                    ; HL = current three-word frame
        LD      BC,6
        LDIR
        EX      DE,HL                    ; HL = private manager-stack top
        LD      BC,6
        OR      A
        SBC     HL,BC
        LD      SP,HL
        LD      HL,(RV_HREQ+2)
        PUSH    HL                      ; scratch must remain above workspace low
        LD      HL,(RV_REQ)
        LD      DE,14
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        POP     DE
        PUSH    HL
        LD      BC,0103H
        OR      A
        SBC     HL,BC
        POP     HL
        JP      C,RV_BAD
        OR      A
        SBC     HL,DE
        JP      NC,RV_BAD
        LD      HL,(RV_HREQ+2)
        LD      BC,0400H
        ADD     HL,BC
        PUSH    HL
        EX      DE,HL
        LD      HL,RI_ENTRY
        LD      BC,RI_END-RI_ENTRY
        LDIR
        POP     HL
        LD      DE,RV_HREQ
        LD      A,1
        JP      (HL)

RV_ZERO:                                ; return an idempotent miss or no-op
        XOR     A

RV_RESTORE:                             ; restore the resolver after a direct result
        LD      B,A
        LD      A,(RSTCOUNT)
        OR      A
        LD      A,B
        RET     Z                       ; an empty profile has no resolver to restore
        AND     1
        OR      080H
        LD      HL,(RV_REQ)
        INC     HL
        INC     HL
        INC     HL
        LD      (HL),A                  ; private result consumed by extensions
        LD      A,3                     ; restore the disk-free resolver
        JP      LY_BIOS+60

RV_FIND:                                ; locate the requested persistent name
        LD      A,(RSTCOUNT)
        LD      B,A
        XOR     A
RV_FINDLP:                              ; compare another profile member
        LD      C,A
        LD      A,B
        OR      A
        JR      Z,RV_MISS
        LD      A,C
        CALL    RV_TABPTR
        LD      DE,(RV_REQ)
        INC     DE
        INC     DE
        INC     DE
        INC     DE
        PUSH    BC
        LD      B,8
RV_COMPARE:                             ; compare the eight-byte filename stem
        LD      A,(DE)
        CP      (HL)
        JR      NZ,RV_DIFFER
        INC     DE
        INC     HL
        DJNZ    RV_COMPARE
        POP     BC
        LD      A,C
        OR      A                       ; clear carry while retaining index
        RET
RV_DIFFER:                              ; advance to the next profile member
        POP     BC
        LD      A,C
        INC     A
        DEC     B
        JR      RV_FINDLP
RV_MISS:                                ; report an absent filename
        SCF
        RET

RV_TABPTR:                              ; locate one persistent filename record
        ADD     A,A
        ADD     A,A
        ADD     A,A
        LD      L,A
        LD      H,0
        LD      DE,RSTABLE
        ADD     HL,DE
        RET

RV_SERVPTR:                             ; locate one primary-service record
        ADD     A,A
        LD      L,A
        LD      H,0
        LD      DE,RSTSERV
        ADD     HL,DE
        RET

RV_BAD:                                 ; reject an unavailable transaction phase
        LD      A,0FFH
        OR      A
        RET

RV_NLOAD:       DB      'R3COORD '      ; append transaction coordinator
RV_NDROP:       DB      'R3DROP  '      ; removal transaction coordinator
RV_REQ:         DW      0               ; public Function-202 request
RV_HREQ:        DS      6               ; replacement-overlay handoff request


; Position-independent overlay reader copied to scratch+0400H. HL is its
; runtime entry address, DE is a filename (A=0) or handoff request (A=1).
; Scratch holds a complete image, code, private state/stack, and a saved CFG.
RI_ENTRY:                               ; enter position-independent staged reader
        PUSH    IX
        POP     BC
        PUSH    DE
        LD      DE,0100H
        ADD     HL,DE
        PUSH    HL
        POP     IX
        POP     DE
        LD      (IX+16),C
        LD      (IX+17),B
        LD      (IX+0),A
        LD      HL,0
        ADD     HL,SP
        LD      (IX+2),L
        LD      (IX+3),H
        PUSH    IX
        POP     HL
        LD      BC,0100H
        ADD     HL,BC
        LD      SP,HL
        OR      A
        JR      Z,RI_NAME
        EX      DE,HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     HL
        INC     HL
        INC     HL
        LD      A,(HL)
        LD      (IX+4),A
        INC     HL
        LD      A,(HL)
        LD      (IX+5),A
        PUSH    DE
        PUSH    IX
        POP     DE
        LD      HL,0100H
        ADD     HL,DE
        EX      DE,HL
        LD      HL,LY_CFG
        LD      BC,0400H
        LDIR
        POP     DE
RI_NAME:                                ; open the selected overlay
        EX      DE,HL
        LD      A,1
        CALL    LY_FILE
        JR      NZ,RI_FAIL
        PUSH    IX
        POP     HL
        LD      DE,0500H
        OR      A
        SBC     HL,DE
        PUSH    HL
        CALL    LY_FILE+3
        JR      NZ,RI_READFAIL
        CALL    LY_FILE+3
        JR      NZ,RI_READFAIL
        POP     HL
        LD      A,(IX+0)
        OR      A
        LD      DE,LY_CFG
        LD      BC,0400H
        JR      Z,RI_COPY
        LD      DE,LY_RSX
        LD      BC,03F4H
RI_COPY:                                ; install the complete staged image
        LDIR
        LD      A,(IX+0)
        OR      A
        JR      Z,RI_OK
        PUSH    IX
        POP     HL
        LD      DE,0100H
        ADD     HL,DE
        LD      DE,LY_CFG
        LD      BC,0400H
        LDIR
RI_OK:                                  ; report successful replacement
        XOR     A
        JR      RI_RETURN
RI_READFAIL:                            ; unwind the staged destination
        POP     HL
RI_FAIL:                                ; report overlay read failure
        LD      A,0FFH
RI_RETURN:                              ; restore the caller frame and dispatch
        LD      L,(IX+2)
        LD      H,(IX+3)
        LD      SP,HL
        LD      E,(IX+4)
        LD      D,(IX+5)
        LD      B,(IX+0)
        LD      L,(IX+16)
        LD      H,(IX+17)
        PUSH    HL
        POP     IX
        OR      A
        RET     NZ
        LD      A,B
        OR      A
        RET     Z
        LD      A,D
        OR      E
        RET     Z
        JP      LY_RSX
RI_END:                                 ; end the copied reader code

        .DEPHASE
        END
