; ********************************************************************************
; *                    BetterCP/M RSX Pointer-Slot Union                         *
; *                                                                              *
; * Phase-3 preparer for the union of static and runtime pointer-repair slots.    *
; * Validates both sorted unique offset lists completely before writing their    *
; * sorted, duplicate-free union to the caller's output buffer.                  *
; ********************************************************************************

  ; DE -> request:
  ;   +0 allocation size
  ;   +2 static count, +3 runtime count
  ;   +4 static-list address, +6 runtime-list address, +8 output address
  ;   +10 output capacity in words, +11 reserved zero
  ;   +12 returned union count (written only on success)

  ; Both input lists contain little-endian word offsets and must independently be
  ; sorted and unique.  The output is their sorted, duplicate-free union.


SUBASE          EQU     07200H

        CSEG
        .PHASE  SUBASE

; ================================================================================
; =                           Union Request Validation                           =
; =                                                                              =
; = Decodes the request, validates allocation and output capacity, and validates both =
; = input slot lists before permitting any output writes.                        =
; ================================================================================
; -------------------------------------------------------------------------------
; Request Decode and Capacity
; -------------------------------------------------------------------------------

SU_ENTRY: JP SU_UNION
SU_MONITOR: JP MS_ENTRY                  ; +3, six-byte monitor preparation request
SU_UNION:                               ; enter pointer-slot union preparer
        LD      (SU_REQ),DE
        EX      DE,HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (SU_ALLOC),DE
        LD      A,D
        OR      E
        JP      Z,SU_BAD
        INC     HL
        LD      A,(HL)
        LD      (SU_SCNT),A
        INC     HL
        LD      A,(HL)
        LD      (SU_RCNT),A
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (SU_SPTR),DE
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (SU_RPTR),DE
        INC     HL
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (SU_OUT),DE
        INC     HL
        LD      A,(HL)
        LD      (SU_CAP),A
        INC     HL
        LD      A,(HL)
        OR      A
        JP      NZ,SU_BAD

  ; Reserve the maximum possible union before writing anything.
        LD      A,(SU_SCNT)
        LD      B,A
        LD      A,(SU_RCNT)
        ADD     A,B
        JP      C,SU_BAD
        LD      B,A
        LD      A,(SU_CAP)
        CP      B
        JP      C,SU_BAD

        LD      HL,(SU_SPTR)
        LD      A,(SU_SCNT)
        CALL    SU_VALID
        JP      NZ,SU_BAD
        LD      HL,(SU_RPTR)
        LD      A,(SU_RCNT)
        CALL    SU_VALID
        JP      NZ,SU_BAD

        XOR     A
        LD      (SU_NOUT),A

; ================================================================================
; =                            Sorted Slot-List Merge                            =
; =                                                                              =
; = Merges the validated static and runtime offset lists in ascending order while =
; = suppressing duplicate offsets and respecting the reserved output capacity.   =
; ================================================================================
; -------------------------------------------------------------------------------
; Two-Way Merge
; -------------------------------------------------------------------------------

SU_MERGE:                               ; merge static and runtime slot lists
        LD      A,(SU_SCNT)
        OR      A
        JR      Z,SU_RREST
        LD      A,(SU_RCNT)
        OR      A
        JR      Z,SU_SREST
        LD      HL,(SU_SPTR)
        LD      E,(HL)
        INC     HL
        LD      D,(HL)                  ; DE=static value
        LD      HL,(SU_RPTR)
        LD      C,(HL)
        INC     HL
        LD      B,(HL)                  ; BC=runtime value
        EX      DE,HL                   ; HL=static value
        PUSH    BC
        LD      D,B
        LD      E,C
        OR      A
        SBC     HL,DE
        POP     BC
        JR      C,SU_TAKESTATIC
        JR      NZ,SU_TAKERUNTIME
        LD      H,B
        LD      L,C
        CALL    SU_EMIT
        CALL    SU_ADVS
        CALL    SU_ADVR
        JR      SU_MERGE

SU_TAKESTATIC:                          ; emit next static slot
        ADD     HL,BC                   ; restore static value
        CALL    SU_EMIT
        CALL    SU_ADVS
        JR      SU_MERGE

SU_TAKERUNTIME:                         ; emit next runtime slot
        LD      H,B
        LD      L,C
        CALL    SU_EMIT
        CALL    SU_ADVR
        JR      SU_MERGE

; -------------------------------------------------------------------------------
; Static Remainder
; -------------------------------------------------------------------------------

SU_SREST:                               ; emit remaining static slots
        LD      HL,(SU_SPTR)
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        CALL    SU_EMIT
        CALL    SU_ADVS
        JR      SU_MERGE

; -------------------------------------------------------------------------------
; Runtime Remainder
; -------------------------------------------------------------------------------

SU_RREST:                               ; emit remaining runtime slots
        LD      A,(SU_RCNT)
        OR      A
        JR      Z,SU_DONE
        LD      HL,(SU_RPTR)
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        CALL    SU_EMIT
        CALL    SU_ADVR
        JR      SU_MERGE

SU_DONE:                                ; finish successful slot union
        LD      HL,(SU_REQ)
        LD      DE,12
        ADD     HL,DE
        LD      A,(SU_NOUT)
        LD      (HL),A
        XOR     A
        RET

  ; HL=list, A=count.  Validate complete two-byte bounds and strict ordering.

; ================================================================================
; =                             Slot-List Validation                             =
; =                                                                              =
; = Validates complete two-byte allocation bounds and strict ascending uniqueness for =
; = one input pointer-slot list.                                                 =
; ================================================================================
; -------------------------------------------------------------------------------
; Input List Validation
; -------------------------------------------------------------------------------

SU_VALID:                               ; validate one slot list
        LD      B,A
        XOR     A
        LD      (SU_SEEN),A

SU_VLOOP:                               ; validate next slot offset
        LD      A,B
        OR      A
        RET     Z
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     HL
        PUSH    HL
        LD      HL,(SU_ALLOC)
        DEC     HL
        OR      A
        SBC     HL,DE
        POP     HL
        JR      C,SU_VBAD
        JR      Z,SU_VBAD
        LD      A,(SU_SEEN)
        OR      A
        JR      Z,SU_VFIRST
        PUSH    HL
        LD      HL,(SU_PREV)
        OR      A
        SBC     HL,DE
        POP     HL
        JR      NC,SU_VBAD

SU_VFIRST:                              ; accept first slot offset
        LD      (SU_PREV),DE
        LD      A,1
        LD      (SU_SEEN),A
        DJNZ    SU_VLOOP
        XOR     A
        RET

SU_VBAD:                                ; reject invalid slot list
        LD      A,0FFH
        OR      A
        RET

; -------------------------------------------------------------------------------
; Union Output
; -------------------------------------------------------------------------------

SU_EMIT:                                ; emit union slot offset
        EX      DE,HL
        LD      HL,(SU_OUT)
        LD      (HL),E
        INC     HL
        LD      (HL),D
        INC     HL
        LD      (SU_OUT),HL
        LD      HL,SU_NOUT
        INC     (HL)
        RET

SU_ADVS:                                ; advance static-list cursor
        LD      HL,(SU_SPTR)
        INC     HL
        INC     HL
        LD      (SU_SPTR),HL
        LD      HL,SU_SCNT
        DEC     (HL)
        RET

SU_ADVR:                                ; advance runtime-list cursor
        LD      HL,(SU_RPTR)
        INC     HL
        INC     HL
        LD      (SU_RPTR),HL
        LD      HL,SU_RCNT
        DEC     (HL)
        RET

SU_BAD:                                 ; return union failure
        LD      A,0FFH
        OR      A
        RET

; ================================================================================
; =                             Union Working State                              =
; =                                                                              =
; = Defines request, allocation, input/output cursors, counts, capacity, and validation =
; = state used while preparing the repair-slot union.                            =
; ================================================================================
; -------------------------------------------------------------------------------
; Union State
; -------------------------------------------------------------------------------

SU_REQ:         DW      0               ; union request pointer
SU_ALLOC:       DW      0               ; allocation size
SU_SPTR:        DW      0               ; static-list pointer
SU_RPTR:        DW      0               ; runtime-list pointer
SU_OUT:         DW      0               ; union output pointer
SU_PREV:        DW      0               ; previous validated offset
SU_SCNT:        DB      0               ; static slots remaining
SU_RCNT:        DB      0               ; runtime slots remaining
SU_CAP:         DB      0               ; output capacity
SU_NOUT:        DB      0               ; union entries emitted
SU_SEEN:        DB      0               ; slot-validation flag


; Shared monitor-selection preparation, reached at overlay+3.
; DE -> {normalized facts, eight-byte plan record, durable selection state}.
; State = {monitor entry, portable link-word address, backend entry}; legacy
; monitors touch only the first word. MCON 1.1 owns payload word +12; dispatch remains at +8.
; Every retained callable descriptor must still match its validated carrier.
; No live mutation or callback; publish the durable target only on success.
MS_ENTRY:
        EX DE,HL
        LD E,(HL)
        INC HL
        LD D,(HL)
        LD (MS_FACTS),DE
        INC HL
        LD E,(HL)
        INC HL
        LD D,(HL)
        LD (MS_PLAN),DE
        INC HL
        LD E,(HL)
        INC HL
        LD D,(HL)
        LD (MS_TARGET),DE
        LD HL,0
        LD (MS_PENDING),HL
        LD (MS_SLOT),HL
        LD (MS_LINK),HL
        LD HL,(MS_TARGET)
        LD (MS_DEST),HL
        LD HL,(MS_FACTS)
        LD DE,17
        ADD HL,DE
        LD A,(HL)
        CP 3
        JP NC,MS_BAD
        LD (MS_COUNT),A
        LD (MS_LEFT),A
        INC HL
        LD E,(HL)
        INC HL
        LD D,(HL)
        LD (MS_SOURCE),DE
        LD HL,(MS_PLAN)
        LD E,(HL)
        INC HL
        LD D,(HL)
        LD (MS_OLD),DE
        LD A,D
        OR E
        JR Z,MS_LOOP
        EX DE,HL
        LD DE,4
        ADD HL,DE
        LD A,(MS_COUNT)
        CP (HL)
        JP NZ,MS_BAD
        INC HL
        LD A,(HL)
        OR A
        JP NZ,MS_BAD
        INC HL
        LD E,(HL)
        INC HL
        LD D,(HL)
        LD (MS_OFFSET),DE
        ; Descriptors occupy exactly the allocation tail, as R3SNAP emits.
        LD A,(MS_COUNT)
        LD L,A
        LD H,0
        ADD HL,HL
        LD B,H
        LD C,L
        ADD HL,HL
        ADD HL,HL
        ADD HL,BC                      ; count * 10
        ADD HL,DE
        JP C,MS_BAD
        EX DE,HL
        LD HL,(MS_PLAN)
        LD BC,4
        ADD HL,BC
        LD C,(HL)
        INC HL
        LD B,(HL)
        EX DE,HL
        OR A
        SBC HL,BC
        JP NZ,MS_BAD
        LD HL,(MS_OFFSET)
        LD DE,8
        OR A
        SBC HL,DE
        JP C,MS_BAD
MS_LOOP:
        LD A,(MS_LEFT)
        OR A
        JP Z,MS_FINISH
        LD HL,(MS_OLD)
        LD A,H
        OR L
        JR Z,MS_ID
        LD DE,(MS_OFFSET)
        ADD HL,DE
        LD (MS_LIVE),HL
        LD A,(MS_COUNT)
        LD (MS_TRIES),A
MS_FIND:
        LD HL,(MS_SOURCE)
        LD DE,(MS_LIVE)
        LD B,10
MS_COMPARE:
        LD A,(DE)
        CP (HL)
        JR NZ,MS_NEXTLIVE
        INC DE
        INC HL
        DJNZ MS_COMPARE
        JR MS_ID
MS_NEXTLIVE:
        LD HL,MS_TRIES
        DEC (HL)
        JP Z,MS_BAD
        LD HL,(MS_LIVE)
        LD DE,10
        ADD HL,DE
        LD (MS_LIVE),HL
        JR MS_FIND
MS_ID:
        LD HL,(MS_SOURCE)
        LD DE,MS_MCON
        CALL MS_ISID
        JR Z,MS_FRONT
        LD HL,(MS_SOURCE)
        LD DE,MS_SCRN
        CALL MS_ISID
        JP NZ,MS_NEXT
        LD HL,(MS_TARGET)
        LD DE,4
        ADD HL,DE
        LD (MS_DEST),HL                ; backend destination in durable context
        JR MS_ADDRESS
MS_FRONT:
        INC HL                         ; ABI minor
        LD A,(HL)
        OR A
        JR Z,MS_ADDRESS                ; legacy monitor has no external link
        INC HL                         ; portable callback offset
        CALL MS_BODY
        OR A
        JP NZ,MS_BAD
        LD HL,(MS_FACTS)
        LD DE,8                        ; normal BDOS dispatch offset
        ADD HL,DE
        CALL MS_CHAIN
        OR A
        JP NZ,MS_BAD
        LD DE,12                       ; MCON 1.1 private binding word
        LD (MS_LINK),DE
        ; Cross-module words may not overlap self-relative repair words.
        LD HL,(MS_FACTS)
        LD DE,10
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        INC HL
        LD B,(HL)
        EX DE,HL
        CALL MS_NOFIX
        OR A
        JP NZ,MS_BAD
        LD HL,(MS_FACTS)
        LD DE,14
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        INC HL
        LD B,(HL)
        EX DE,HL
        CALL MS_NOFIX
        OR A
        JP NZ,MS_BAD
        LD HL,(MS_PLAN)
        INC HL
        INC HL
        LD E,(HL)
        INC HL
        LD D,(HL)
        LD HL,(MS_LINK)
        ADD HL,DE
        JP C,MS_BAD
        LD (MS_SLOT),HL
MS_ADDRESS:
        LD HL,(MS_PENDING)
        LD A,H
        OR L
        JP NZ,MS_BAD                   ; one role per carrier; reject dual-role modules
        LD HL,(MS_SOURCE)
        LD DE,6
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        PUSH DE
        LD HL,(MS_PLAN)
        INC HL
        INC HL
        LD E,(HL)
        INC HL
        LD D,(HL)
        POP HL
        ADD HL,DE
        JP C,MS_BAD
        LD (MS_PENDING),HL
        LD HL,(MS_DEST)
        LD A,(HL)
        INC HL
        OR (HL)
        JP NZ,MS_BAD                   ; duplicate role before any live change
MS_NEXT:
        LD HL,(MS_SOURCE)
        LD DE,10
        ADD HL,DE
        LD (MS_SOURCE),HL
        LD HL,MS_LEFT
        DEC (HL)
        JP MS_LOOP
MS_FINISH:
        LD DE,(MS_PENDING)
        LD A,D
        OR E
        JR Z,MS_OK
        LD HL,(MS_DEST)
        LD (HL),E
        INC HL
        LD (HL),D
        LD DE,(MS_SLOT)
        LD A,D
        OR E
        JR Z,MS_OK
        LD HL,(MS_TARGET)
        INC HL
        INC HL
        LD (HL),E
        INC HL
        LD (HL),D                     ; final frontend-owned backend word
MS_OK:
        XOR A
        RET
MS_BAD:
        LD A,0FFH
        OR A
        RET
MS_ISID:
        LD B,4
MS_IDLOOP:
        LD A,(DE)
        CP (HL)
        RET NZ
        INC DE
        INC HL
        DJNZ MS_IDLOOP
        RET
MS_BODY:
        LD B,(HL)
        INC HL
        LD A,(HL)
        OR A
        JR NZ,MS_BODYOK
        LD A,B
        CP 14
        JR C,MS_BODYBAD
MS_BODYOK:
        XOR A
        RET
MS_BODYBAD:
        LD A,255
        RET
MS_CHAIN:
        LD B,(HL)
        INC HL
        LD A,(HL)
        OR A
        RET NZ
        LD A,B
        CP 8                           ; preserve canonical registry-chain offset
        JR NZ,MS_BODYBAD
        XOR A
        RET
MS_NOFIX:
        LD A,B
        OR A
        RET Z
MS_FIXLP:
        LD E,(HL)
        INC HL
        LD D,(HL)
        INC HL
        PUSH HL
        LD HL,(MS_LINK)
        OR A
        SBC HL,DE
        INC HL                        ; differences -1,0,+1 overlap the word
        LD A,H
        OR A
        JR NZ,MS_FIXOK
        LD A,L
        CP 3
        JR C,MS_FIXBAD
MS_FIXOK:
        POP HL
        DJNZ MS_FIXLP
        XOR A
        RET
MS_FIXBAD:
        POP HL
        LD A,255
        RET
MS_SLOT: DW 0
MS_LINK: DW 0
MS_DEST: DW 0
MS_SCRN: DB 'SCRN'
MS_MCON: DB 'MCON'
MS_FACTS: DW 0
MS_PLAN: DW 0
MS_TARGET: DW 0
MS_PENDING: DW 0
MS_SOURCE: DW 0
MS_OLD: DW 0
MS_LIVE: DW 0
MS_OFFSET: DW 0
MS_COUNT: DB 0
MS_LEFT: DB 0
MS_TRIES: DB 0

        .DEPHASE
        END
