; Audit-only backend: abstract screen primitives to an ANSI 80x24 endpoint.
; The hardware/transport choice is in this module, never in a personality.
        ASEG
        ORG 08000H
B_NEXT: DW 5
B_DISP: DW B_CHAIN
        DW 0,0
B_CHAIN:
        LD HL,(B_NEXT)
        JP (HL)
SB_ENTRY:
        CP 6
        JP C,B_RAW
        SUB 6
        CP 7
        JR NC,B_BAD
        ADD A,A
        LD E,A
        LD D,0
        LD HL,B_TABLE
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        EX DE,HL
        JP (HL)
B_BAD:
        LD A,255
        RET
B_RAW:
        LD HL,(1)
        LD DE,66
        ADD HL,DE
        JP (HL)
B_EMIT:
        PUSH BC
        PUSH DE
        PUSH HL
        XOR A
        CALL B_RAW
        POP HL
        POP DE
        POP BC
        RET
B_STR:
        LD C,(HL)
        INC HL
        LD A,C
        OR A
        RET Z
        CALL B_EMIT
        JR B_STR
B_TABLE:
        DW B_POS,B_PUT,B_EOL,B_EOS,B_UP,B_DOWN,B_QUERY
B_QUERY:
        LD HL,B_DESC
        RET
B_DESC: DB 'SCR',1,24,80,63
B_POS:
        LD A,B
        CP 24
        JR NC,B_BAD
        LD A,C
        CP 80
        JR NC,B_BAD
        LD (B_COL),A
        LD A,B
        LD (B_ROW),A
B_POSITION:
        LD HL,B_CSI
        CALL B_STR
        LD A,(B_ROW)
        INC A
        CALL B_DEC
        LD C,';'
        CALL B_EMIT
        LD A,(B_COL)
        INC A
        CALL B_DEC
        LD C,'H'
        JP B_EMIT
B_DEC:
        LD B,0
B_TENS:
        CP 10
        JR C,B_UNIT
        SUB 10
        INC B
        JR B_TENS
B_UNIT:
        PUSH AF
        LD A,B
        OR A
        JR Z,B_LAST
        ADD A,'0'
        LD C,A
        CALL B_EMIT
B_LAST:
        POP AF
        ADD A,'0'
        LD C,A
        JP B_EMIT
B_PUT:
        PUSH BC
        LD A,C
        AND 128
        LD HL,B_NORMAL
        JR Z,B_ATTRIBUTE
        LD HL,B_REVERSE
B_ATTRIBUTE:
        CALL B_STR
        POP BC
        LD A,C
        AND 127
        LD C,A
        CALL B_EMIT
        ; Backend put holds position, including an ANSI delayed-wrap margin.
        JP B_POSITION
B_EOL:
        LD HL,B_K
        JP B_STR
B_EOS:
        LD HL,B_J
        JP B_STR
B_UP:
        CALL B_AREA
        LD C,10
        CALL B_EMIT
        JR B_RESTORE
B_DOWN:
        CALL B_AREA
        LD HL,B_RI
        CALL B_STR
B_RESTORE:
        LD HL,B_ALL
        CALL B_STR
        JP B_POSITION
B_AREA:
        LD HL,B_MARGIN
        CALL B_STR
        JP B_POSITION
B_CSI: DB 27,'[',0
B_NORMAL: DB 27,'[0m',0
B_REVERSE: DB 27,'[7m',0
B_K: DB 27,'[0m',27,'[0K',0
B_J: DB 27,'[0m',27,'[0J',0
B_RI: DB 27,'M',0
B_MARGIN: DB 27,'[1;24r',0
B_ALL: DB 27,'[r',0
B_ROW: DB 0
B_COL: DB 0
        END
