        INCLUDE layout.inc
        INCLUDE bioslinks.inc
        INCLUDE hardware.inc
; BDOS 207: B=operation, DE=request in TPA. See BIOS-DISK-CONFIG.md.
        CSEG
        .PHASE  LY_DISK
        JP DC_ENTRY
        JP DC_MAP
        JP DC_SELECT
        JP DC_READ
        JP DC_WRITE
        JP DC_RAW

DC_RAW:
        LD A,0FFH
        LD (DC_LAST),A
        RET

DC_ENTRY:
        LD A,B
        OR A
        JR NZ,DC_REQUEST
        LD HL,DC_INFO
        RET
DC_REQUEST:
        PUSH IX
        PUSH DE
        POP IX
        LD A,D
        OR A
        JP Z,DC_INVALID
        LD HL,80
        ADD HL,DE
        JP C,DC_INVALID
        LD DE,LY_TPA
        OR A
        SBC HL,DE
        JP NC,DC_INVALID
        LD A,B
        CP 1
        JP Z,DC_GETPH
        CP 2
        JP Z,DC_SETPH
        CP 3
        JP Z,DC_GETLOG
        CP 4
        JP Z,DC_SETLOG
        CP 5
        JP Z,DC_FORMAT
DC_INVALID:
        LD A,1
        JR DC_RETURN
DC_UNSUPPORTED:
        LD A,2
DC_RETURN:
        LD L,A
        LD H,0
        POP IX
        RET
DC_OK:
        XOR A
        JR DC_RETURN

; Physical records: size in inches, cylinders, sides, WD step code,
; motor spin-up in 1/4 seconds, head settle in milliseconds.
DC_PHY:
        CP 4
        RET NC
        LD HL,DC_PHYS
        LD DE,6
        OR A
        JR NZ,DC_PHYL
        SCF
        RET
DC_PHYL:
        ADD HL,DE
        DEC A
        JR NZ,DC_PHYL
        SCF
        RET
DC_GETPH:
        LD A,(IX+0)
        CALL DC_PHY
        JP NC,DC_INVALID
        PUSH IX
        POP DE
        INC DE
        LD BC,6
        LDIR
        JP DC_OK
DC_SETPH:
        LD A,(IX+0)
        CALL DC_PHY
        JP NC,DC_INVALID
        LD (DC_DEST),HL
        LD A,(IX+1)
        CP 5
        JP NZ,DC_UNSUPPORTED
        LD A,(IX+2)
        OR A
        JP Z,DC_INVALID
        CP 81
        JP NC,DC_INVALID
        LD A,(IX+3)
        DEC A
        CP 2
        JP NC,DC_INVALID
        LD A,(IX+4)
        CP 4
        JP NC,DC_INVALID
        LD A,(IX+5)
        CP 17
        JP NC,DC_INVALID
        ; Reject a hardware reduction that invalidates an attached format.
        LD HL,LY_TAB+16
        LD B,16
DC_PHCHK:
        LD A,(IX+0)
        CP (HL)
        JR NZ,DC_PHNEXT
        PUSH HL
        LD DE,16
        ADD HL,DE
        LD A,(IX+2)
        CP (HL)
        POP HL
        JP C,DC_UNSUPPORTED
        PUSH HL
        LD DE,19
        ADD HL,DE
        BIT 6,(HL)
        POP HL
        JR Z,DC_PHNEXT
        LD A,(IX+3)
        CP 2
        JP NZ,DC_UNSUPPORTED
DC_PHNEXT:
        LD DE,240
        ADD HL,DE
        DJNZ DC_PHCHK
        PUSH IX
        POP HL
        INC HL
        LD DE,(DC_DEST)
        LD BC,6
        LDIR
        CALL DC_RESET
        JP DC_OK

; Sixteen independent logical records, 240 bytes each. DPH first,
; then 64-byte binding/format, 128-byte ALV and 32-byte CSV.
DC_LOG:
        CP 16
        RET NC
        LD HL,LY_TAB
        LD DE,240
        OR A
        JR NZ,DC_LOGL
        SCF
        RET
DC_LOGL:
        ADD HL,DE
        DEC A
        JR NZ,DC_LOGL
        SCF
        RET
DC_GETLOG:
        LD A,(IX+0)
        CALL DC_LOG
        JP NC,DC_INVALID
        LD DE,16
        ADD HL,DE
        PUSH IX
        POP DE
        INC DE
        LD BC,64
        LDIR
        JP DC_OK
DC_SETLOG:
        LD A,(IX+0)
        CALL DC_LOG
        JP NC,DC_INVALID
        LD DE,16
        ADD HL,DE
        LD (DC_DEST),HL
        LD A,(IX+1)
        CP 0FFH
        JR NZ,DC_VALIDATE
        LD A,(IX+0)
        OR A
        JP Z,DC_UNSUPPORTED
        LD HL,(DC_DEST)
        LD (HL),0FFH
        CALL DC_RESET
        JP DC_OK
DC_VALIDATE:
        CALL DC_PHY
        JP NC,DC_INVALID
        LD (DC_PHYADDR),HL
        ; A is the fixed bootstrap filesystem until system-disk migration exists.
        LD A,(IX+0)
        OR A
        JP Z,DC_UNSUPPORTED
        LD A,(IX+17)
        OR A
        JP Z,DC_INVALID
        CP 81
        JP NC,DC_INVALID
        INC HL
        LD A,(HL)
        CP (IX+17)
        JP C,DC_UNSUPPORTED
        INC HL
        LD A,(IX+20)
        AND 060H
        CP 060H
        JP Z,DC_UNSUPPORTED
        BIT 6,(IX+20)
        JR Z,DC_ONESIDE
        LD A,(HL)
        CP 2
        JP NZ,DC_UNSUPPORTED
DC_ONESIDE:
        LD A,(IX+20)
        AND 02FH             ; nonstandard side order/numbering unsupported v1
        JP NZ,DC_UNSUPPORTED
        LD A,(IX+18)
        OR A
        JP Z,DC_INVALID
        CP 33
        JP NC,DC_UNSUPPORTED
        LD B,A
        LD A,(IX+19)
        CP 4
        JP NC,DC_UNSUPPORTED
        LD C,A
        LD HL,0
        LD L,B
        OR A
        JR Z,DC_SPT
DC_SPTSHIFT:
        ADD HL,HL
        DEC A
        JR NZ,DC_SPTSHIFT
DC_SPT:
        LD A,(IX+3)
        CP H
        JP NZ,DC_INVALID
        LD A,(IX+2)
        CP L
        JP NZ,DC_INVALID
        ; 128-byte CSV / directory limits inherited from current BDOS iterator.
        LD A,(IX+10)
        OR A
        JP NZ,DC_UNSUPPORTED
        LD A,(IX+9)
        CP 128
        JP NC,DC_UNSUPPORTED
        LD A,(IX+8)
        CP 4
        JP NC,DC_UNSUPPORTED
        LD A,(IX+14)
        OR A
        JP NZ,DC_INVALID
        LD A,(IX+13)
        CP 33
        JP NC,DC_UNSUPPORTED
        LD A,(IX+4)
        CP 3
        JP C,DC_INVALID
        CP 8
        JP NC,DC_INVALID
        LD B,A
        LD A,1
DC_BLMSH:
        ADD A,A
        DJNZ DC_BLMSH
        DEC A
        CP (IX+5)
        JP NZ,DC_INVALID
        ; Directory records occupy the first allocation blocks.
        LD A,(IX+9)
        SRL A
        SRL A
        INC A
        LD C,A
        LD A,(IX+5)
        INC A
        LD B,A
        LD A,C
        LD C,0
DC_DIRBL:
        SET 7,C
        SUB B
        JR C,DC_DIRMASK
        JR Z,DC_DIRMASK
        SRL C
        JR DC_DIRBL
DC_DIRMASK:
        LD A,(IX+11)
        AND C
        CP C
        JP NZ,DC_INVALID
        ; EXM follows allocation-entry width and block size.
        LD A,(IX+4)
        SUB 3
        LD B,A
        LD A,(IX+8)
        OR A
        LD A,B
        JR Z,DC_EXMSZ
        OR A
        JP Z,DC_INVALID
        DEC A
DC_EXMSZ:
        LD B,A
        LD A,1
        INC B
DC_EXMSH:
        DJNZ DC_EXMADD
        JR DC_EXMDONE
DC_EXMADD:
        ADD A,A
        JR DC_EXMSH
DC_EXMDONE:
        DEC A
        CP (IX+6)
        JP NZ,DC_INVALID
        ; Allocation cannot extend past the available logical records.
        LD L,(IX+17)
        LD H,0
        BIT 6,(IX+20)
        JR Z,DC_CAPTRK
        ADD HL,HL
DC_CAPTRK:
        LD E,(IX+15)
        LD D,(IX+16)
        OR A
        SBC HL,DE
        JP C,DC_INVALID
        LD A,H
        OR L
        JP Z,DC_INVALID
        LD B,L
        LD E,(IX+2)
        LD D,(IX+3)
        LD HL,0
DC_CAPMUL:
        ADD HL,DE
        DJNZ DC_CAPMUL
        LD (DC_CAP),HL
        LD L,(IX+7)
        LD H,(IX+8)
        INC HL
        LD B,(IX+4)
DC_ALSHIFT:
        ADD HL,HL
        JP C,DC_INVALID
        DJNZ DC_ALSHIFT
        LD DE,(DC_CAP)
        OR A
        SBC HL,DE
        JR Z,DC_CAPOK
        JP NC,DC_INVALID
DC_CAPOK:
        ; Validate sector IDs are unique (arbitrary bases are supported).
        PUSH IX
        POP HL
        LD DE,21
        ADD HL,DE
        LD B,(IX+18)
DC_SKEW:
        LD A,(HL)
        PUSH BC
        PUSH HL
        INC HL
        DEC B
        JR Z,DC_SKDONE
DC_SKCMP:
        CP (HL)
        JP Z,DC_SKBAD
        INC HL
        DJNZ DC_SKCMP
DC_SKDONE:
        POP HL
        POP BC
        INC HL
        DJNZ DC_SKEW
        PUSH IX
        POP HL
        INC HL
        LD DE,(DC_DEST)
        LD BC,64
        LDIR
        CALL DC_RESET
        JP DC_OK
DC_SKBAD:
        POP HL
        POP BC
        JP DC_INVALID
DC_RESET:
        ; Conservatively invalidate every alias and active BDOS disk context.
        PUSH IX
        LD DE,0FFFFH
        LD C,37
        CALL LY_BDOS
        POP IX
        RET

DC_SELECT:
        LD A,C
        LD (BIO_DRIVE),A
        CALL DC_LOG
        JR NC,DC_NOLOG
        PUSH HL
        LD DE,16
        ADD HL,DE
        LD A,(HL)
        CP 4
        POP HL
        RET C
DC_NOLOG:
        LD HL,0
        RET
DC_MAP:
        PUSH IX
        LD A,(BIO_DRIVE)
        CALL DC_LOG
        JP NC,DC_MAPBAD
        LD DE,16
        ADD HL,DE
        PUSH HL
        POP IX
        LD A,(IX+0)
        CALL DC_PHY
        JP NC,DC_MAPBAD
        LD (DC_PHYADDR),HL
        LD A,(IX+0)
        LD B,A
        LD A,1
        INC B
DC_MASK:
        DJNZ DC_MASKSHIFT
        JR DC_MASKDONE
DC_MASKSHIFT:
        ADD A,A
        JR DC_MASK
DC_MASKDONE:
        LD (B_PDrive),A
        LD HL,(BIO_SECTOR)
        LD E,(IX+1)
        LD D,(IX+2)
        OR A
        SBC HL,DE
        JP NC,DC_MAPBAD
        LD HL,(BIO_TRACK)
        LD A,H
        OR A
        JP NZ,DC_MAPBAD
        LD A,(IX+19)
        AND 040H
        LD B,A
        XOR A
        LD (B_PSide),A
        LD A,(BIO_TRACK)
        BIT 5,(IX+19)        ; built-in cylinder-track 790K profile
        JR NZ,DC_CYL
        BIT 6,(IX+19)
        JR Z,DC_CYL
        SRL A
        PUSH AF
        LD A,0
        ADC A,0
        LD (B_PSide),A
        POP AF
DC_CYL:
        CP (IX+16)
        JP NC,DC_MAPBAD
        LD (BIO_PCYL),A
        LD HL,(BIO_SECTOR)
        LD B,(IX+18)
        LD A,1
        INC B
DC_QMASK:
        DJNZ DC_QSHIFT
        JR DC_QDONE
DC_QSHIFT:
        ADD A,A
        JR DC_QMASK
DC_QDONE:
        DEC A
        AND L
        LD (BIO_QUART),A
        LD B,(IX+18)
        INC B
DC_DIV:
        DJNZ DC_DIVSHIFT
        JR DC_DIVDONE
DC_DIVSHIFT:
        SRL H
        RR L
        JR DC_DIV
DC_DIVDONE:
        LD A,L
        CP (IX+17)
        JR C,DC_SECOK
        SUB (IX+17)
        LD B,A
        LD A,1
        LD (B_PSide),A
        LD A,B
DC_SECOK:
        LD E,A
        LD D,0
        PUSH IX
        POP HL
        ADD HL,DE
        LD DE,20
        ADD HL,DE
        LD A,(HL)
        LD (BIO_PSEC),A
        LD A,(IX+18)
        LD (DC_SIZE),A
        LD A,(IX+19)
        LD (DC_FLAGS),A
        POP IX
        XOR A
        RET
DC_MAPBAD:
        POP IX
        LD A,1
        OR A
        RET

; Physical transfer using selected runtime geometry; BOOT raw reader remains
; separate with its fixed system-media geometry.
DC_READ:
        LD A,080H
        JR DC_IO
DC_WRITE:
        LD A,0A0H
DC_IO:
        PUSH AF
        XOR A
        LD (DC_FAILED),A
        POP AF
        LD (DC_COMMAND),A
        LD (DC_BUFFER),HL
        CALL DC_SEEK
        RET NZ
        LD A,(DC_COMMAND)
        CP 0A0H
        CALL Z,DC_INVBUF
        LD A,(BIO_PSEC)
        OUT (FDCSECTOR),A
        LD A,(DC_COMMAND)
        OUT (FDCCOMMAND),A
        LD HL,(DC_BUFFER)
        LD A,(DC_SIZE)
        OR A
        LD A,1
        JR Z,DC_BSET
        LD A,(DC_SIZE)
        DEC A
        LD B,A
        LD A,1
        JR Z,DC_BSET
DC_BLSH:
        ADD A,A
        DJNZ DC_BLSH
DC_BSET:
        LD (DC_NBLK),A
DC_BLOCK:
        LD B,0
        LD A,(DC_SIZE)
        OR A
        JR NZ,DC_BLGO
        LD B,128
DC_BLGO:
        LD C,FDCDATA
        LD A,(DC_COMMAND)
        CP 080H
        CALL Z,DC_RBYTE
        LD A,(DC_COMMAND)
        CP 080H
        CALL NZ,DC_WBYTE
        ; Each helper returns status in A; command comparison above would
        ; discard it, so helpers record failures separately.
        LD A,(DC_FAILED)
        OR A
        RET NZ
        CALL DC_WAIT
        RET NZ
        IN A,(FDCSTATUS)
        AND 09CH
        RET NZ
        LD A,(DC_COMMAND)
        CP 080H
        JR NZ,DC_IODONE
        CALL DC_INVBUF
DC_IODONE:
        XOR A
        RET
DC_INVBUF:
        LD A,(DC_FLAGS)
        AND 010H
        RET Z
        LD HL,(DC_BUFFER)
        LD DE,128
        LD A,(DC_SIZE)
        OR A
        JR Z,DC_INVERT
DC_INVSH:
        SLA E
        RL D
        DEC A
        JR NZ,DC_INVSH
DC_INVERT:
        LD A,(HL)
        CPL
        LD (HL),A
        INC HL
        DEC DE
        LD A,D
        OR E
        JR NZ,DC_INVERT
        RET
DC_RBYTE:
        LD DE,0
DC_RPOLL:
        IN A,(FDCSTATUS)
        AND 2
        JR NZ,DC_RDATA
        DEC DE
        LD A,D
        OR E
        JR NZ,DC_RPOLL
        JR DC_IOFAIL
DC_RDATA:
        INI
        JR NZ,DC_RBYTE
        LD A,(DC_NBLK)
        DEC A
        LD (DC_NBLK),A
        RET Z
        JR DC_RBYTE
DC_WBYTE:
        LD DE,0
DC_WPOLL:
        IN A,(FDCSTATUS)
        AND 2
        JR NZ,DC_WDATA
        DEC DE
        LD A,D
        OR E
        JR NZ,DC_WPOLL
DC_IOFAIL:
        CALL DC_ERR
        LD (DC_FAILED),A
        RET
DC_WDATA:
        OUTI
        JR NZ,DC_WBYTE
        LD A,(DC_NBLK)
        DEC A
        LD (DC_NBLK),A
        RET Z
        JR DC_WBYTE
DC_DRQ:
        LD BC,0
DC_DRQL:
        IN A,(FDCSTATUS)
        BIT 1,A
        JR NZ,DC_ZERO
        BIT 0,A
        JR Z,DC_ERR
        DEC BC
        LD A,B
        OR C
        JR NZ,DC_DRQL
        JR DC_ERR
DC_WAIT:
        LD BC,0
DC_WAITL:
        IN A,(FDCSTATUS)
        BIT 0,A
        JR Z,DC_ZERO
        DEC BC
        LD A,B
        OR C
        JR NZ,DC_WAITL
DC_ERR:
        LD A,0D0H
        OUT (FDCCOMMAND),A
        LD A,1
        OR A
        RET
DC_ZERO:
        XOR A
        RET
DC_SEEK:
        CALL DC_WAIT
        RET NZ
        LD A,(B_PSide)
        RLCA
        RLCA
        RLCA
        RLCA
        LD B,A
        LD A,(DC_FLAGS)
        AND 080H
        OR B
        LD B,A
        LD A,(B_PDrive)
        OR B
        OUT (FDCSELECT),A
        LD A,(B_PDrive)
        LD B,A
        LD A,(DC_LAST)
        CP B
        JR Z,DC_SEEKTO
        LD A,B
        LD (DC_LAST),A
        ; Restore on a drive change because the WD track register is shared.
        LD HL,(DC_PHYADDR)
        LD DE,4
        ADD HL,DE
        LD A,(HL)
        OR A
        JR Z,DC_RESTORE
DC_SPIN:
        PUSH AF
        LD A,250
        CALL DC_DELAY
        POP AF
        DEC A
        JR NZ,DC_SPIN
DC_RESTORE:
        LD HL,(DC_PHYADDR)
        LD DE,3
        ADD HL,DE
        LD A,(HL)
        OR 008H
        OUT (FDCCOMMAND),A
        CALL DC_WAIT
        RET NZ
        IN A,(FDCSTATUS)
        AND 010H
        JR NZ,DC_ERR
DC_SEEKTO:
        LD A,(BIO_PCYL)
        OUT (FDCDATA),A
        LD HL,(DC_PHYADDR)
        LD DE,3
        ADD HL,DE
        LD A,(HL)
        OR 018H
        OUT (FDCCOMMAND),A
        CALL DC_WAIT
        RET NZ
        IN A,(FDCSTATUS)
        AND 010H
        JR NZ,DC_ERR
        LD HL,(DC_PHYADDR)
        LD DE,5
        ADD HL,DE
        LD A,(HL)
        CALL DC_DELAY
        XOR A
        RET
; Approximately 1ms at Model 4 4MHz. All waits are bounded.
DC_DELAY:
        OR A
        RET Z
DC_DMS:
        LD BC,117
DC_DLOOP:
        DEC BC
        LD D,A
        LD A,B
        OR C
        LD A,D
        JR NZ,DC_DLOOP
        DEC A
        JR NZ,DC_DMS
        RET

; Format one physical track with caller-supplied WD write-track stream.
; request: logical,cylinder,side,length word,buffer word.
DC_FORMAT:
        CALL DC_RESET         ; even a rejected request must clear cached context
        LD A,(IX+0)
        OR A
        JP Z,DC_UNSUPPORTED
        LD (BIO_DRIVE),A
        LD HL,0
        LD (BIO_TRACK),HL
        LD (BIO_SECTOR),HL
        CALL DC_MAP
        OR A
        JP NZ,DC_INVALID
        LD A,(B_PDrive)
        CP 1                ; never format bootstrap physical drive through alias
        JP Z,DC_UNSUPPORTED
        LD A,(IX+1)
        LD (BIO_PCYL),A
        LD A,(IX+0)
        CALL DC_LOG
        LD DE,32
        ADD HL,DE
        LD A,(IX+1)
        CP (HL)
        JP NC,DC_INVALID
        LD A,(IX+2)
        CP 2
        JP NC,DC_INVALID
        LD (B_PSide),A
        OR A
        JR Z,DC_FBUFFER
        LD A,(DC_FLAGS)
        AND 060H
        JP Z,DC_INVALID
DC_FBUFFER:
        LD L,(IX+5)
        LD H,(IX+6)
        LD A,H
        OR A
        JP Z,DC_INVALID
        LD (DC_BUFFER),HL
        LD E,(IX+3)
        LD D,(IX+4)
        LD A,D
        OR E
        JP Z,DC_INVALID
        ADD HL,DE
        JP C,DC_INVALID
        LD DE,LY_TPA
        OR A
        SBC HL,DE
        JP NC,DC_INVALID
        CALL DC_SEEK
        OR A
        JP NZ,DC_RETURN
        LD HL,(DC_BUFFER)
        LD B,(IX+3)
        LD A,(IX+4)
        LD C,A
        LD A,B
        OR A
        LD A,C
        JR Z,DC_FCOUNT
        INC A
DC_FCOUNT:
        LD (DC_NBLK),A
        LD C,FDCDATA
        LD A,0F0H
        OUT (FDCCOMMAND),A
DC_FBYTE:
        LD DE,0
DC_FPOLL:
        IN A,(FDCSTATUS)
        AND 2
        JR NZ,DC_FDATA
        DEC DE
        LD A,D
        OR E
        JR NZ,DC_FPOLL
        IN A,(FDCSTATUS)
        AND 1
        JR Z,DC_FSTATUS
        CALL DC_ERR
        JP DC_RETURN
DC_FDATA:
        OUTI
        JR NZ,DC_FBYTE
        LD A,(DC_NBLK)
        DEC A
        LD (DC_NBLK),A
        JR NZ,DC_FBYTE
        ; The index pulse must complete before the stream is exhausted.
        CALL DC_ERR
        JP DC_RETURN
DC_FSTATUS:
        IN A,(FDCSTATUS)
        AND 0FCH
        JP DC_RETURN

DC_INFO:
        DB 'B','D','C','F',1,16,4,64
        DW DC_PHYS,LY_TAB
DC_PHYS:
        REPT 4
        DB 5,80,2,0,2,15
        ENDM
DC_CAP: DW 0
DC_LAST: DB 0FFH
DC_DEST: DW 0
DC_PHYADDR: DW DC_PHYS
DC_NBLK: DB 0
DC_FAILED: DB 0
DC_COMMAND: DB 0
DC_BUFFER: DW 0
DC_SIZE: DB 2
DC_FLAGS: DB 080H
        .DEPHASE
        END
