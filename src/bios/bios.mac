        INCLUDE layout.inc
; BetterCP/M initial CP/M 2.2 compatibility BIOS scaffold
;
; Independently buildable BIOS, placed by the shared production memory map.

BIOSBASE        EQU     LY_BIOS+0
BIO_PHYBF       EQU     LY_BUF  ; 512-byte buffer below the resident BIOS
BIO_DIRBF       EQU     LY_DIR
; BIOS-owned descriptors are linked separately in the shared packed map.
BIO_DPH0        EQU     LY_TAB+0
BIO_DPH1        EQU     LY_TAB+16
BIO_DPH2        EQU     LY_TAB+32
BIO_DPH3        EQU     LY_TAB+48
SYS_BOOT        EQU     LY_SYS+020H
CCP_RELOAD      EQU     LY_LOAD

        CSEG
        .PHASE  BIOSBASE

; Patch 2026-09-01: retain the complete historical 17-entry vector even
; while several services are stubs.  Existing software derives this base
; from JMP WBOOT at page zero and indexes fixed three-byte JMP entries.
BIOS:
        JP      BIOBOOT
        JP      BIOWBOOT
        JP      BIOCONST
        JP      BIOCONIN
        JP      BIOCONOT
        JP      BIOLIST
        JP      BIOPUNCH
        JP      BIOREADR
        JP      BIOHOME
        JP      BIOSELDS
        JP      BIOSETTR
        JP      BIOSETSE
        JP      BIOSETDM
        JP      BIOREAD
        JP      BIOWRITE
        JP      BIOLSTST
        JP      BIOSECTR

; BetterCP/M-private platform vector immediately after the public 17-vector
; BIOS table. The fixed WBOOT reloader reads raw system-track sectors through
; this entry without importing Model 4 controller code into the portable core.
BIOPHREAD:
        JP      BIO_PHRD
BIOCURSOR:
        JP      BIO_CUROUT
BIO_PHRD:
        PUSH    AF
        CALL    LY_DISK+15
        LD      A,1
        LD      (B_PDrive),A
        LD      A,0FFH
        LD      (M4R_DRIVE),A
        POP     AF
        JP      M4_READ
BIO_CUROUT:
        JP      PL_CURSOR

; BOOT and WBOOT enter portable system reconstruction before the CCP.
BIOBOOT:
        CALL    M4_INIT
; Patch 2026-09-02: the CCP is no longer part of the stage-one resident image.
; Cold and warm entry both reconstruct the calculated command environment
; from the system tracks before entering the portable WBOOT path.
        JP      CCP_RELOAD
BIOWBOOT:
        JP      CCP_RELOAD

; CONST must return exactly 00h or FFh and must not consume the character.
BIOCONST:
        CALL    PL_CONST
        OR      A
        RET     Z
        LD      A,0FFH
        RET

BIOCONIN:
        CALL    PL_CONIN
        AND     07FH
        RET

BIOCONOT:
        JP      PL_CONOT

; Optional logical devices are explicitly unassigned in the scaffold.
BIOLIST:
BIOPUNCH:
        RET
BIOREADR:
        LD      A,01AH
        RET

BIOHOME:
        LD      BC,0
BIOSETTR:
        LD      (BIO_TRACK),BC
        RET
BIOSETSE:
        LD      (BIO_SECTOR),BC
        RET
BIOSETDM:
        LD      (BIO_DMA),BC
        RET

; Patch 2026-09-01: A: through D: are separate Model 4 floppy drives. They share
; the temporary MM Extended 790K geometry, but never BDOS scratch workspace.
BIOSELDS:
        JP LY_DISK+6

BIOREAD:
        CALL    BIO_MAP
        RET     NZ
        LD      A,(BIO_PCYL)
        PUSH    AF
        LD      A,(B_PSide)
        LD      B,A
        LD      A,(BIO_PSEC)
        LD      C,A
        POP     AF
        LD      HL,BIO_PHYBF
        CALL    LY_DISK+9
        RET     NZ
        LD      A,(BIO_QUART)
        LD      HL,BIO_PHYBF
        OR      A
        JR      Z,BIO_RDCOP
        LD      DE,128
BIO_RDADD:
        ADD     HL,DE
        DEC     A
        JR      NZ,BIO_RDADD
BIO_RDCOP:
        LD      DE,(BIO_DMA)
        LD      BC,128
        LDIR
        XOR     A
        RET

BIOWRITE:
        CALL    BIO_MAP
        RET     NZ
        LD      A,(BIO_PCYL)
        PUSH    AF
        LD      A,(B_PSide)
        LD      B,A
        LD      A,(BIO_PSEC)
        LD      C,A
        POP     AF
        LD      HL,BIO_PHYBF
        CALL    LY_DISK+9
        RET     NZ
        LD      A,(BIO_QUART)
        LD      DE,BIO_PHYBF
        OR      A
        JR      Z,BIO_WRCOP
        LD      HL,128
BIO_WRADD:
        EX      DE,HL
        ADD     HL,DE
        EX      DE,HL
        DEC     A
        JR      NZ,BIO_WRADD
BIO_WRCOP:
        LD      HL,(BIO_DMA)
        LD      BC,128
        LDIR
        LD      A,(BIO_PCYL)
        PUSH    AF
        LD      A,(B_PSide)
        LD      B,A
        LD      A,(BIO_PSEC)
        LD      C,A
        POP     AF
        LD      HL,BIO_PHYBF
        JP      LY_DISK+12

BIO_MAP:
        JP LY_DISK+3

BIO_RDERR:
        LD      A,1
        RET

; LISTST encoding remains policy-pending; an unassigned list device is not
; ready in this scaffold.
BIOLSTST:
        XOR     A
        RET

; BC is the zero-based logical sector; DE is XLT or zero.  Return HL.
BIOSECTR:
        LD      H,B
        LD      L,C
        LD      A,D
        OR      E
        RET     Z
        EX      DE,HL
        ADD     HL,BC
        LD      L,(HL)
        LD      H,0
        RET

; Persistent single-context disk state required by the CP/M BIOS boundary.
BIO_DRIVE:
        DB      0
BIO_TRACK:
        DW      0
BIO_SECTOR:
        DW      0
BIO_DMA:
        DW      0080H
BIO_QUART:
        DB      0
BIO_PCYL:
        DB      0
B_PSide:
        DB      0
B_PDrive:
        DB      1
BIO_PSEC:
        DB      1
BIO_ORDER:
        DB      1,3,5,7,9,2,4,6,8,10
BIO_DRMASK:
        DB      1,2,4,8

        INCLUDE biosplat.inc

        .DEPHASE
        END
