        INCLUDE layout.inc
        INCLUDE profile.inc

; ********************************************************************************
; *                    BetterCP/M CP/M 2.2 Compatibility BIOS                    *
; *                                                                              *
; * Portable BIOS core placed by the shared production memory map. Public CP/M   *
; * vectors remain platform-neutral; Model 4 controller details stay behind the  *
; * private platform interface.                                                  *
; ********************************************************************************


; IOBYTE_ROUTING_V1: qualified compact CRT router and capability query.
BIOSBASE        EQU     LY_BIOS+0
BIO_PHYBF       EQU     LY_BUF          ; 1024-byte shared physical-sector buffer
BIO_DIRBF       EQU     LY_DIR
  ; BIOS-owned descriptors are linked separately in the shared packed map.
BIO_DPH0        EQU     LY_TAB+0
BIO_DPH1        EQU     LY_TAB+16
BIO_DPH2        EQU     LY_TAB+32
BIO_DPH3        EQU     LY_TAB+48
SYS_BOOT        EQU     LY_SYS+020H
CCP_RELOAD      EQU     LY_LOAD

        CSEG
        .PHASE  BIOSBASE

  ; Patch 2026-09-01: retain the complete historical 17-entry vector even
  ; while several services are stubs.  Existing software derives this base
  ; from JMP WBOOT at page zero and indexes fixed three-byte JMP entries.

; ================================================================================
; =                              BIOS Entry Vectors                              =
; =                                                                              =
; = Defines the public CP/M 2.2 BIOS jump table and the adjacent BetterCP/M-private =
; = platform vectors used by portable system reconstruction.                     =
; ================================================================================
; -------------------------------------------------------------------------------
; Public CP/M Vector
; -------------------------------------------------------------------------------

BIOS:                                   ; public BIOS jump table
        JP      BIOBOOT
        JP      BIOWBOOT
        JP      BIOCONST
        JP      BIOCONIN
        JP      BIOCONOT
        JP      BIOLIST
        JP      BIOPUNCH
        JP      BIOREADR
        JP      BIOHOME
        JP      LY_DISK+6
        JP      BIOSETTR
        JP      BIOSETSE
        JP      BIOSETDM
        JP      BIOREAD
        JP      BIOWRITE
        JP      BIOLSTST
        JP      BIOSECTR

  ; BetterCP/M-private platform vector immediately after the public 17-vector
  ; BIOS table. The fixed WBOOT reloader reads raw system-track sectors through
  ; this entry without importing Model 4 controller code into the portable core.

; -------------------------------------------------------------------------------
; BetterCP/M Private Platform Vectors
; -------------------------------------------------------------------------------

BIOPHREAD:                              ; platform physical-read vector
        JP      LY_DISK+15

BIOCURSOR:                              ; platform cursor vector
        JP      MH_CUR

BIOOVLOAD:                              ; platform overlay-load vector
        JP      PL_OVLOAD

BIORLOAD:                               ; platform reloader-load vector
        JP      PL_RSXLOAD

  ; Direct vectors replace the former redundant second jumps.

  ; BOOT and WBOOT enter portable system reconstruction before the CCP.

; ================================================================================
; =                      System Entry and Console Services                       =
; =                                                                              =
; = Implements cold/warm system entry and the portable console, list, punch, and =
; = reader services exposed through the CP/M BIOS interface.                     =
; ================================================================================
; -------------------------------------------------------------------------------
; Cold and Warm Entry
; -------------------------------------------------------------------------------

BIOCHCAP:                               ; private character capability query, BIOS+63
        JP IO_CAPS

MONCALL: JP MC_CALL
MONRAW: JP MC_RAW
MONBASE: JP MC_BASE

BIOBOOT:                                ; cold boot entry
        CALL MC_BASE
        CALL    PL_INIT
  ; 08-Sep-2026: BOOT must begin on A even when called from another drive.
  ; WBOOT preserves the caller's drive; reset it only on this cold entry.
        LD      C,13
        CALL    LY_BDOS
  ; Patch 2026-09-02: the CCP is no longer part of the stage-one resident image.
  ; Cold and warm entry both reconstruct the calculated command environment
  ; from the system tracks before entering the portable WBOOT path.

BIOWBOOT:                               ; warm boot entry
  ; 07-Sep-2026 -- reclaim the command reloader's permanent storage.
  ;       JP      CCP_RELOAD      ; old, permanently resident reloader
  ; The transient is finished.  Fetch the reloader into its old TPA,
  ; then rebuild the command environment.  PL_RELOAD does not return.
        JP      PL_RELOAD

  ; CONST must return exactly 00h or FFh and must not consume the character.

; -------------------------------------------------------------------------------
; Console Input
; -------------------------------------------------------------------------------

  ; Keep these small monitor adapters near their console callers so the
  ; dispatches below can use relative jumps. MONCALL still begins with the
  ; published JP to MC_CALL, whose first instruction remains LD HL,(MP_MON).
MH_OUT:
        XOR A
        JR MC_CALL
MH_CUR:
        LD A,3
MC_CALL:
        LD HL,(MP_MON)
        JP (HL)

BIOCONST:
        CALL IO_CON
        JR NZ,BIO_ZERO
IO_STAT:
        LD A,1
        CALL MC_CALL
        OR A
        RET Z
IO_READY:
        LD A,0FFH
        RET
BIOCONIN:
        CALL IO_CON
        JR NZ,BIOREADR
IO_INPUT:
        LD A,2
        CALL MC_CALL
        AND 07FH
        RET
BIOCONOT:
        CALL IO_CON
        JR Z,MH_OUT
        DEC A
        RET NZ
        JR BIOLIST
IO_CON:
        LD A,(0003H)
        AND 3
        DEC A
        RET
BIOLIST:
        CALL BIOLSTST
        RET Z
        JR MH_OUT
BIOREADR:
        LD A,01AH
BIOPUNCH:                               ; output sink shares the reader's RET only
        RET

; ================================================================================
; =                     Disk Selection and Transfer Services                     =
; =                                                                              =
; = Maintains the current CP/M disk address, selects Model 4 floppy profiles, and =
; = performs buffered sector reads and writes through the platform layer.        =
; ================================================================================
; -------------------------------------------------------------------------------
; Disk Address Selection
; -------------------------------------------------------------------------------

BIOHOME:                                ; home current drive
        LD      BC,0

BIOSETTR:                               ; set logical track
        LD      (BIO_TRACK),BC
        RET

BIOSETSE:                               ; set logical sector
        LD      (BIO_SECTOR),BC
        RET

BIOSETDM:                               ; set DMA address
        LD      (BIO_DMA),BC
        RET

  ; Patch 2026-09-01: A: through D: are separate Model 4 floppy drives. They share
  ; one sector buffer, but never saved allocation ownership. A uses the
  ; 780K system profile; B-D use unreserved 800K data profiles.

; -------------------------------------------------------------------------------
; Sector Read
; -------------------------------------------------------------------------------

BIOREAD:                                ; read logical sector
        CALL    BIO_PREP
        RET     NZ

BIO_RDCOP:                              ; copy sector buffer to DMA
        LD      DE,(BIO_DMA)
        LDIR
BIO_ZERO:                               ; shared exact A=0/Z return, no other effects
        XOR     A
        RET

; -------------------------------------------------------------------------------
; Sector Write
; -------------------------------------------------------------------------------

BIOWRITE:                               ; write logical sector
        CALL    BIO_PREP
        RET     NZ
        EX      DE,HL

BIO_WRCOP:                              ; copy DMA to sector buffer
        LD      HL,(BIO_DMA)
        LDIR
        LD      HL,BIO_PHYBF
        JP      LY_DISK+12

 ; One address calculation for both directions, not two walking loops.
  ; 07-Sep-2026: recovered these bytes for the optional FDF dispatch.
  ; Shared preparation pays for the console fix without taking TPA.

; -------------------------------------------------------------------------------
; Physical Transfer Preparation
; -------------------------------------------------------------------------------

BIO_PREP:                               ; prepare physical sector transfer
        CALL    LY_DISK+3
        RET     NZ
        LD      HL,BIO_PHYBF
        CALL    LY_DISK+9
        RET     NZ

BIO_SLOT:                               ; select quarter-sector slot
  ; BIO_QUART is 0..7, including all eight records in a 1024-byte sector.
  ; RRCA retains q>>1 in A and q bit 0 in carry; RR L forms the low byte.
        LD      A,(BIO_QUART)
        RRCA
        LD      L,0
        RR      L
        OR      HIGH BIO_PHYBF          ; buffer is aligned to 1024 bytes
        LD      H,A
        LD      BC,128                  ; common count for both copy directions
        XOR     A                       ; successful preparation for either caller
        RET

  ; LISTST encoding remains policy-pending; an unassigned list device is not
  ; ready in this scaffold.

; ================================================================================
; =                            BIOS Utility Services                             =
; =                                                                              =
; = Implements list-device status and CP/M sector translation independently of   =
; = the platform-specific floppy controller implementation.                      =
; ================================================================================
; -------------------------------------------------------------------------------
; List Status
; -------------------------------------------------------------------------------

BIOLSTST:
        LD A,(0003H)
        AND 0C0H
        SUB 040H
        CP 1
        SBC A,A                         ; FFh/NZ only for CRT list, else 00h/Z
        RET

  ; BC is the zero-based logical sector; DE is XLT or zero.  Return HL.

; -------------------------------------------------------------------------------
; Sector Translation
; -------------------------------------------------------------------------------

BIOSECTR:                               ; translate logical sector
        LD      H,B
        LD      L,C
        LD      A,D
        OR      E
        RET     Z
        EX      DE,HL
        ADD     HL,BC
        LD      L,(HL)
        LD      H,0
        RET

MC_BASE:
        LD HL,MC_RAW
        LD (MP_MON),HL
        RET

  ; Persistent single-context disk state required by the CP/M BIOS boundary.

; ================================================================================
; =                              BIOS Working State                              =
; =                                                                              =
; = Defines the persistent drive, track, sector, DMA, and physical-transfer state =
; = required by the single-context CP/M BIOS boundary.                           =
; ================================================================================
; -------------------------------------------------------------------------------
; Logical Disk State
; -------------------------------------------------------------------------------

BIO_DRIVE:                              ; current logical drive
        DB      0

BIO_TRACK:                              ; current logical track
        DW      0

BIO_SECTOR:                             ; current logical sector
        DW      0

BIO_DMA:                                ; current DMA address
        DW      0080H

; -------------------------------------------------------------------------------
; Physical Transfer State
; -------------------------------------------------------------------------------

BIO_QUART:                              ; quarter-sector index
        DB      0

BIO_PCYL:                               ; physical cylinder
        DB      0

B_PSide:                                ; physical side
        DB      0

B_PDrive:                               ; physical drive
        DB      1

BIO_PSEC:                               ; physical sector
        DB      1
        INCLUDE biosplat.inc

IO_CAPS:
        LD HL,02002H                    ; CRT console and CRT list only
        RET


MC_RAW:
        OR A
        JP Z,PL_CONOT
        DEC A
        JP Z,PL_CONST
        DEC A
        JP Z,PL_CONIN
        DEC A
        IF BP_CHECKED EQ 1
        JP Z,PL_CURSOR                  ; checked cpmsim carrier loader exceeds JR reach
        ELSE
        JR Z,PL_CURSOR
        ENDIF
        DEC A
        JR Z,MC_CLEAR
        DEC A
        RET Z
        LD A,0FFH
        RET
MC_CLEAR:
        LD C,01CH
        JP PL_CONOT
; BIOS-owned binding: only cold initialization and validated manager publication
; may store this word. No production provider is bound until lifecycle commit
; integration is qualified. MONRAW must never re-enter IOBYTE or MC_CALL.
        DB 0                            ; retain the published binding at EC84h
MP_MON: DW 0
MP_MON_END:
        IF BP_CHECKED EQ 1
        DS LY_CCRC-$
        INCLUDE checked-crc.inc
        ENDIF
        .DEPHASE
        END
