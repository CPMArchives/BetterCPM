; BetterCP/M initial CP/M 2.2 compatibility BIOS scaffold
;
; This artifact is independently buildable and is not yet loaded by stage zero.
; BIOSBASE is a test placement, not a final resident-memory decision.

BIOSBASE        EQU     0EF00H
BIO_PHYBF       EQU     0ED00H  ; 512-byte buffer below the resident BIOS
BIO_DIRBF       EQU     0F300H
BIO_DPH0        EQU     0C900H
BIO_DPH1        EQU     0C910H
BIO_DPH2        EQU     0C920H
BIO_DPH3        EQU     0C930H
BIO_DPB0        EQU     0C940H
SYS_BOOT        EQU     0C020H
SYS_WBOOT       EQU     0C023H

        CSEG
        .PHASE  BIOSBASE

; Patch 2026-09-01: retain the complete historical 17-entry vector even
; while several services are stubs.  Existing software derives this base
; from JMP WBOOT at page zero and indexes fixed three-byte JMP entries.
BIOS:
        JP      BIOBOOT
        JP      BIOWBOOT
        JP      BIOCONST
        JP      BIOCONIN
        JP      BIOCONOT
        JP      BIOLIST
        JP      BIOPUNCH
        JP      BIOREADR
        JP      BIOHOME
        JP      BIOSELDS
        JP      BIOSETTR
        JP      BIOSETSE
        JP      BIOSETDM
        JP      BIOREAD
        JP      BIOWRITE
        JP      BIOLSTST
        JP      BIOSECTR

; BOOT and WBOOT enter portable system reconstruction before the CCP.
BIOBOOT:
        CALL    M4_INIT
        JP      SYS_BOOT
BIOWBOOT:
        JP      SYS_WBOOT

; CONST must return exactly 00h or FFh and must not consume the character.
BIOCONST:
        CALL    PL_CONST
        OR      A
        RET     Z
        LD      A,0FFH
        RET

BIOCONIN:
        CALL    PL_CONIN
        AND     07FH
        RET

BIOCONOT:
        JP      PL_CONOT

; Optional logical devices are explicitly unassigned in the scaffold.
BIOLIST:
BIOPUNCH:
        RET
BIOREADR:
        LD      A,01AH
        RET

BIOHOME:
        LD      BC,0
BIOSETTR:
        LD      (BIO_TRACK),BC
        RET
BIOSETSE:
        LD      (BIO_SECTOR),BC
        RET
BIOSETDM:
        LD      (BIO_DMA),BC
        RET

; Patch 2026-09-01: A: through D: are separate Model 4 floppy drives. They share
; the temporary MM Extended 790K geometry, but never BDOS scratch workspace.
BIOSELDS:
        LD      A,C
        LD      (BIO_DRIVE),A
        CP      4
        JR      NC,BIO_NODSK
        OR      A
        LD      HL,BIO_DPH0
        RET     Z
        CP      2
        LD      HL,BIO_DPH1
        RET     C
        LD      HL,BIO_DPH2
        RET     Z
        LD      HL,BIO_DPH3
        RET
BIO_NODSK:
        LD      HL,0
        RET

BIOREAD:
        CALL    BIO_MAP
        RET     NZ
        LD      A,(BIO_PCYL)
        PUSH    AF
        LD      A,(B_PSide)
        LD      B,A
        LD      A,(BIO_PSEC)
        LD      C,A
        POP     AF
        LD      HL,BIO_PHYBF
        CALL    PL_READ
        RET     NZ
        LD      A,(BIO_QUART)
        LD      HL,BIO_PHYBF
        OR      A
        JR      Z,BIO_RDCOP
        LD      DE,128
BIO_RDADD:
        ADD     HL,DE
        DEC     A
        JR      NZ,BIO_RDADD
BIO_RDCOP:
        LD      DE,(BIO_DMA)
        LD      BC,128
        LDIR
        XOR     A
        RET

BIOWRITE:
        CALL    BIO_MAP
        RET     NZ
        LD      A,(BIO_PCYL)
        PUSH    AF
        LD      A,(B_PSide)
        LD      B,A
        LD      A,(BIO_PSEC)
        LD      C,A
        POP     AF
        LD      HL,BIO_PHYBF
        CALL    PL_READ
        RET     NZ
        LD      A,(BIO_QUART)
        LD      DE,BIO_PHYBF
        OR      A
        JR      Z,BIO_WRCOP
        LD      HL,128
BIO_WRADD:
        EX      DE,HL
        ADD     HL,DE
        EX      DE,HL
        DEC     A
        JR      NZ,BIO_WRADD
BIO_WRCOP:
        LD      HL,(BIO_DMA)
        LD      BC,128
        LDIR
        LD      A,(BIO_PCYL)
        PUSH    AF
        LD      A,(B_PSide)
        LD      B,A
        LD      A,(BIO_PSEC)
        LD      C,A
        POP     AF
        LD      HL,BIO_PHYBF
        JP      PL_WRITE

BIO_MAP:
        LD      A,(BIO_DRIVE)
        CP      4
        JR      NC,BIO_RDERR
        LD      E,A
        LD      D,0
        LD      HL,BIO_DRMASK
        ADD     HL,DE
        LD      A,(HL)
        LD      (B_PDrive),A
        LD      A,(BIO_TRACK+1)
        OR      A
        JR      NZ,BIO_RDERR
        LD      A,(BIO_TRACK)
        CP      80
        JR      NC,BIO_RDERR
        LD      A,(BIO_SECTOR+1)
        OR      A
        JR      NZ,BIO_RDERR
        LD      A,(BIO_SECTOR)
        CP      80
        JR      NC,BIO_RDERR
        LD      E,A
        AND     3
        LD      (BIO_QUART),A
        LD      A,E
        SRL     A
        SRL     A
        LD      B,0
        CP      10
        JR      C,BIO_SIDE0
        SUB     10
        INC     B
BIO_SIDE0:
        LD      E,A
        LD      D,0
        LD      HL,BIO_ORDER
        ADD     HL,DE
        LD      C,(HL)
        LD      A,B
        LD      (B_PSide),A
        LD      A,C
        LD      (BIO_PSEC),A
        LD      A,(BIO_TRACK)
        LD      (BIO_PCYL),A
        XOR     A
        RET
BIO_RDERR:
        LD      A,1
        RET

; LISTST encoding remains policy-pending; an unassigned list device is not
; ready in this scaffold.
BIOLSTST:
        XOR     A
        RET

; BC is the zero-based logical sector; DE is XLT or zero.  Return HL.
BIOSECTR:
        LD      H,B
        LD      L,C
        LD      A,D
        OR      E
        RET     Z
        EX      DE,HL
        ADD     HL,BC
        LD      L,(HL)
        LD      H,0
        RET

; Persistent single-context disk state required by the CP/M BIOS boundary.
BIO_DRIVE:
        DB      0
BIO_TRACK:
        DW      0
BIO_SECTOR:
        DW      0
BIO_DMA:
        DW      0080H
BIO_QUART:
        DB      0
BIO_PCYL:
        DB      0
B_PSide:
        DB      0
B_PDrive:
        DB      1
BIO_PSEC:
        DB      1
BIO_ORDER:
        DB      1,3,5,7,9,2,4,6,8,10
BIO_DRMASK:
        DB      1,2,4,8

        INCLUDE biosplat.inc

        .DEPHASE
        END
