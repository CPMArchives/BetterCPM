        INCLUDE layout.inc
; Four DPHs, each followed by its own 64-byte disk binding.
; ALV is shared workspace. Each drive retains its own 32-byte CSV.
; Directory checksums must survive selection of another logical disk.
; BDOS must rebuild allocation ownership when changing logical disks.
; In particular A/B/A must not reuse B's allocated-block map for A.
        CSEG
        .PHASE  LY_TAB
; Default A: 780K SYSTEM on MM Extended physical geometry. B-D: MM standard DATA 800K.
; Data disks reserve no system cylinders; all four use 512-byte sectors.
; These installed defaults survive warm boot. SYSGEN will replace them
; in the system image when that utility is implemented.
DPH0:
        DW 0,0,0,0,LY_DIR,DPH0+17,CSV+0,ALV
        DB 0
        DW 80
        DB 4,15,0
        DW 389,127
        DB 0C0H,0
        DW 32,2
        DB 80,10,2,0E0H
        DB 1,3,5,7,9,2,4,6,8,10
        REPT 34
        DB 0
        ENDM
DPH1:
        DW 0,0,0,0,LY_DIR,DPH1+17,CSV+32,ALV
        DB 1
        DW 40
        DB 4,15,0
        DW 399,127
        DB 0C0H,0
        DW 32,0
        DB 80,10,2,0C0H
        DB 1,3,5,7,9,2,4,6,8,10
        REPT 34
        DB 0
        ENDM
DPH2:
        DW 0,0,0,0,LY_DIR,DPH2+17,CSV+64,ALV
        DB 2
        DW 40
        DB 4,15,0
        DW 399,127
        DB 0C0H,0
        DW 32,0
        DB 80,10,2,0C0H
        DB 1,3,5,7,9,2,4,6,8,10
        REPT 34
        DB 0
        ENDM
DPH3:
        DW 0,0,0,0,LY_DIR,DPH3+17,CSV+96,ALV
        DB 3
        DW 40
        DB 4,15,0
        DW 399,127
        DB 0C0H,0
        DW 32,0
        DB 80,10,2,0C0H
        DB 1,3,5,7,9,2,4,6,8,10
        REPT 34
        DB 0
        ENDM
ALV:    DS 128
CSV:    DS 128
        .DEPHASE
        END
