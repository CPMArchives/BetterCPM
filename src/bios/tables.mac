        INCLUDE layout.inc

; ********************************************************************************
; *                     BetterCP/M Resident Disk Tables                          *
; *                                                                              *
; * Defines the four installed DPH/disk-binding records plus shared allocation   *
; * workspace and per-drive directory checksum storage. The defaults describe    *
; * the initial system/data disk profiles and may later be replaced by SYSGEN.   *
; ********************************************************************************

        CSEG
        .PHASE  LY_TAB

; ================================================================================
; =                        Installed Drive Descriptors                           =
; =                                                                              =
; = Each DPH is followed by its 64-byte logical-disk binding. Drive A defaults   =
; = to the 780K system profile; B-D default to unreserved 800K data profiles.    =
; ================================================================================

DPH0:                                   ; drive A DPH and disk binding
        DW 0,0,0,0,LY_DIR,DPH0+17,CSV+0,ALV
        DB 0
        DW 80
        DB 4,15,0
        DW 389,127
        DB 0C0H,0
        DW 32,2
        DB 80,10,2,0E0H
        DB 1,3,5,7,9,2,4,6,8,10
        REPT 34
        DB 0
        ENDM

DPH1:                                   ; drive B DPH and disk binding
        DW 0,0,0,0,LY_DIR,DPH1+17,CSV+32,ALV
        DB 1
        DW 40
        DB 4,15,0
        DW 399,127
        DB 0C0H,0
        DW 32,0
        DB 80,10,2,0C0H
        DB 1,3,5,7,9,2,4,6,8,10
        REPT 34
        DB 0
        ENDM

DPH2:                                   ; drive C DPH and disk binding
        DW 0,0,0,0,LY_DIR,DPH2+17,CSV+64,ALV
        DB 2
        DW 40
        DB 4,15,0
        DW 399,127
        DB 0C0H,0
        DW 32,0
        DB 80,10,2,0C0H
        DB 1,3,5,7,9,2,4,6,8,10
        REPT 34
        DB 0
        ENDM

DPH3:                                   ; drive D DPH and disk binding
        DW 0,0,0,0,LY_DIR,DPH3+17,CSV+96,ALV
        DB 3
        DW 40
        DB 4,15,0
        DW 399,127
        DB 0C0H,0
        DW 32,0
        DB 80,10,2,0C0H
        DB 1,3,5,7,9,2,4,6,8,10
        REPT 34
        DB 0
        ENDM

; -------------------------------------------------------------------------------
; Shared Allocation and Checksum Workspace
; -------------------------------------------------------------------------------

ALV:    DS 128                          ; shared allocation-vector workspace
CSV:    DS 128                          ; per-drive directory checksum vectors
        .DEPHASE
        END
