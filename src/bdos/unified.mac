; BetterCP/M compact unified BDOS -- replacement implementation in progress.
;
; This component is built and tested beside the historical dispatch.mac plus
; directory.mac pair. It does not enter the boot image until functions 0..40
; pass the same public contract within the 3.5K release ceiling.

UB_BASE         EQU     0C100H
BIO_WBOOT       EQU     0EF03H
BIO_SELDSK      EQU     0EF1BH
BIO_SETTRK      EQU     0EF1EH
BIO_SETSEC      EQU     0EF21H
BIO_SETDMA      EQU     0EF24H
BIO_READ        EQU     0EF27H
BIO_WRITE       EQU     0EF2AH
BIO_SECTRAN     EQU     0EF30H

        CSEG
        .PHASE  UB_BASE

; U01 -- one public call frame and one 0..40 dispatch convention.
UB_ENTRY:
        LD      (UB_PARM),DE
        LD      (UB_OLDSP),SP
        LD      SP,UB_STKTOP
        LD      A,C
        CP      41
        JR      NC,UB_ZERO
        LD      L,A
        LD      H,0
        ADD     HL,HL
        LD      DE,UB_TABLE
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        PUSH    DE
        LD      DE,(UB_PARM)
        RET

UB_TABLE:
        DW      BIO_WBOOT       ; 0
        DW      UB_MISSING,UB_MISSING,UB_MISSING,UB_MISSING,UB_MISSING
        DW      UB_MISSING,UB_MISSING,UB_MISSING,UB_MISSING,UB_MISSING
        DW      UB_MISSING,UB_VERSION
        DW      UB_RESET,UB_SELECT
        DW      UB_OPEN,UB_CLOSE,UB_SFIRST,UB_SNEXT,UB_DELETE
        DW      UB_READ,UB_WRITE,UB_MAKE,UB_RENAME
        DW      UB_LOGINV,UB_CURDSK,UB_SETDMA,UB_GETALV,UB_WRPROT
        DW      UB_ROVEC,UB_ATTR,UB_GETDPB,UB_USER
        DW      UB_RREAD,UB_RWRITE,UB_SIZE,UB_SETRR,UB_RSTDRV
        DW      UB_ZERO,UB_ZERO,UB_RZERO

UB_MISSING:
        LD      A,0FFH          ; replacement slice not implemented yet
        JP      UB_RETA
UB_ZERO:
        XOR     A
UB_RETA:
        LD      L,A
        LD      H,0
UB_RETHL:
        LD      A,L             ; CP/M normal-return aliases A=L, B=H
        LD      B,H
        LD      SP,(UB_OLDSP)
        RET

UB_VERSION:
        LD      HL,0022H
        JP      UB_RETHL

; U03 -- authoritative disk/user/DMA state.
UB_RESET:
        LD      HL,0080H
        LD      (UB_DMA),HL
        XOR     A
        LD      (UB_DRIVE),A
        LD      (UB_VALID),A
        LD      (UBS_LOGIN),A
        LD      (UBS_LOGIN+1),A
        LD      (UB_RDONLY),A
        LD      (UB_RDONLY+1),A
        LD      C,A
        CALL    UB_CONTEXT
        JP      NZ,UB_BAD
        XOR     A
        JP      UB_RETA

UB_SELECT:
        LD      A,E
        CP      16
        JP      NC,UB_BAD
        LD      C,A
        CALL    UB_CONTEXT
        JP      NZ,UB_BAD
        LD      A,C
        LD      (UB_DRIVE),A
        XOR     A
        JP      UB_RETA

UB_LOGINV:
        LD      HL,(UBS_LOGIN)
        JP      UB_RETHL

UB_CURDSK:
        LD      A,(UB_DRIVE)
        JP      UB_RETA

UB_SETDMA:
        LD      (UB_DMA),DE
        XOR     A
        JP      UB_RETA

UB_GETALV:
        CALL    UB_CURRENT
        JR      NZ,UB_PTRBAD
        LD      HL,(UB_DPH)
        LD      DE,14
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        JP      UB_RETHL

UB_WRPROT:
        LD      A,(UB_DRIVE)
        LD      C,A
        LD      HL,UB_RDONLY
        CALL    UB_SETBIT
        XOR     A
        JP      UB_RETA

UB_ROVEC:
        LD      HL,(UB_RDONLY)
        JP      UB_RETHL

UB_GETDPB:
        CALL    UB_CURRENT
        JR      NZ,UB_PTRBAD
        LD      HL,(UB_DPH)
        LD      DE,10
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        JP      UB_RETHL

UB_PTRBAD:
        LD      HL,0
        JP      UB_RETHL

UB_USER:
        LD      A,E
        CP      0FFH
        JR      Z,UB_GETUSR
        CP      16
        JP      NC,UB_BAD
        LD      (UB_USERNO),A
UB_GETUSR:
        LD      A,(UB_USERNO)
        JP      UB_RETA

UB_RSTDRV:
        LD      A,D             ; retain caller's reset mask
        LD      B,A
        LD      A,E
        LD      C,A
        LD      HL,(UBS_LOGIN)
        LD      A,C
        CPL
        LD      C,A
        LD      A,L
        AND     C
        LD      L,A
        LD      A,B
        CPL
        LD      B,A
        LD      A,H
        AND     B
        LD      H,A
        LD      (UBS_LOGIN),HL
        LD      HL,(UB_RDONLY)
        LD      A,L
        AND     C
        LD      L,A
        LD      A,H
        AND     B
        LD      H,A
        LD      (UB_RDONLY),HL
        XOR     A
        LD      (UB_VALID),A    ; next file/pointer call reselects as needed
        JP      UB_RETA

UB_BAD:
        LD      A,0FFH
        JP      UB_RETA

; U02 -- the sole drive resolver and active DPH context.
UB_CURRENT:
        LD      A,(UB_DRIVE)
        LD      C,A
UB_CONTEXT:
        LD      A,C
        CP      16
        JR      NC,UB_CTXBAD
        LD      A,(UB_VALID)
        OR      A
        JR      Z,UB_CTXLOAD
        LD      A,(UB_CTXDRV)
        CP      C
        RET     Z
UB_CTXLOAD:
        XOR     A
        LD      (UB_VALID),A    ; a failed BIOS selection leaves no context
        LD      (UBS_COK),A
        PUSH    BC
        CALL    BIO_SELDSK
        POP     BC
        LD      A,H
        OR      L
        JR      Z,UB_CTXBAD
        LD      (UB_DPH),HL
        LD      A,C
        LD      (UB_CTXDRV),A
        LD      A,1
        LD      (UB_VALID),A
        XOR     A
        LD      (UBS_COK),A
        PUSH    BC
        CALL    UB_ALLOGIN
        POP     BC
        JR      NZ,UB_CTXBAD
        LD      HL,UBS_LOGIN
        CALL    UB_SETBIT
        XOR     A
        RET
UB_CTXBAD:
        XOR     A
        LD      (UB_VALID),A
        LD      (UBS_COK),A
        LD      A,1
        OR      A
        RET

; Set bit C (0..15) in the two-byte vector at HL.
UB_SETBIT:
        LD      A,C
        CP      8
        JR      C,UB_BTLOW
        INC     HL
        SUB     8
UB_BTLOW:
        LD      E,A
        LD      D,0
        PUSH    HL
        LD      HL,UB_BITS
        ADD     HL,DE
        LD      A,(HL)
        POP     HL
        OR      (HL)
        LD      (HL),A
        RET

; Return NZ when bit C is set in the two-byte vector at HL.
UB_TESTBIT:
        LD      A,C
        CP      8
        JR      C,UB_TBLOW
        INC     HL
        SUB     8
UB_TBLOW:
        LD      E,A
        LD      D,0
        PUSH    HL
        LD      HL,UB_BITS
        ADD     HL,DE
        LD      A,(HL)
        POP     HL
        AND     (HL)
        RET

UB_BITS:
        DB      1,2,4,8,16,32,64,128

; U04 -- common FCB drive view. More accessors join this block as file calls
; move in; no public operation receives a private FCB decoder.
; DE=FCB. Return C=zero-based drive, carry set for an invalid drive byte.
UB_FCBDRV:
        LD      A,(DE)
        OR      A
        JR      Z,UB_FCBCUR
        CP      '?'
        JR      NZ,UB_FCBEXP
UB_FCBCUR:
        LD      A,(UB_DRIVE)
        LD      C,A
        OR      A               ; clear carry
        RET
UB_FCBEXP:
        DEC     A
        CP      16
        JR      NC,UB_FCBBAD
        LD      C,A
        OR      A
        RET
UB_FCBBAD:
        SCF
        RET

; U05 -- one directory iterator. Search First/Next are the first public users;
; Open, mutation, allocation reconstruction, and Size will configure this same
; state instead of acquiring private scan loops.
UB_SFIRST:
        LD      (UB_ITFCB),DE
        CALL    UB_FCBDRV
        JP      C,UB_BAD
        CALL    UB_CONTEXT
        JP      NZ,UB_BAD
        LD      DE,(UB_ITFCB)
        LD      A,(DE)
        CP      '?'
        JR      Z,UB_SFALL
        LD      A,(UB_USERNO)
        LD      (UB_ITUSER),A
        XOR     A
        LD      (UB_ITALL),A
        LD      HL,(UB_ITFCB)
        LD      DE,14
        ADD     HL,DE
        LD      (HL),0          ; CP/M Search First clears S2
        JR      UB_SFINIT
UB_SFALL:
        LD      A,0FFH
        LD      (UB_ITALL),A
UB_SFINIT:
        XOR     A
        LD      (UB_ITMODE),A
        LD      A,12
        LD      (UB_ITLEN),A
        LD      A,1
        LD      (UB_ITWILD),A
        XOR     A
        LD      (UB_ITREC),A
        LD      (UB_ITSLOT),A
        LD      A,1
        LD      (UB_ITLIVE),A
        JR      UB_SEARCH

UB_SNEXT:
        LD      A,(UB_ITLIVE)
        OR      A
        JP      Z,UB_BAD
UB_SEARCH:
        CALL    UB_ITER
        JP      C,UB_BAD
        LD      (UB_ITRET),A
        LD      HL,(UB_DIRBUF)
        LD      DE,(UB_DMA)
        LD      BC,128
        LDIR
        LD      A,(UB_ITRET)
        JP      UB_RETA

; Return A=slot and HL=entry for the next configured match. NZ means end/error.
UB_ITER:
        LD      A,(UB_ITREC)
        CALL    UB_DIRLOAD
        JP      NZ,UB_ITDONE
        LD      A,(UB_ITSLOT)
        LD      E,A
        LD      D,0
        SLA     E
        SLA     E
        SLA     E
        SLA     E
        SLA     E
        ADD     HL,DE
        LD      A,(UB_ITMODE)
        OR      A
        JR      Z,UB_IUSED
        CP      2
        JR      Z,UB_IALIVE
        LD      A,(HL)
        CP      0E5H
        JR      Z,UB_ITFOUND
        JR      UB_ITADV
UB_IUSED:
        LD      A,(HL)
        CP      16
        JR      NC,UB_ITADV
        LD      A,(UB_ITALL)
        OR      A
        JR      NZ,UB_ITNAME
        LD      A,(UB_ITUSER)
        CP      (HL)
        JR      NZ,UB_ITADV
UB_ITNAME:
        PUSH    HL
        INC     HL
        LD      DE,(UB_ITFCB)
        INC     DE
        LD      A,(UB_ITLEN)
        LD      B,A
UB_ITCMP:
        LD      A,(DE)
        AND     07FH
        CP      '?'
        JR      NZ,UB_ITLIT
        LD      A,(UB_ITWILD)
        OR      A
        JR      NZ,UB_ITCHAR
UB_ITLIT:
        LD      A,(DE)
        AND     07FH
        LD      C,A
        LD      A,(UB_ITLEN)
        CP      12
        JR      NZ,UB_ITBASE
        LD      A,B
        CP      1
        JR      NZ,UB_ITBASE
        LD      A,(HL)
        AND     01FH
        JR      UB_ITEQ
UB_ITBASE:
        LD      A,(HL)
        AND     07FH
UB_ITEQ:
        CP      C
        JR      NZ,UB_ITMISS
UB_ITCHAR:
        INC     HL
        INC     DE
        DJNZ    UB_ITCMP
        POP     HL
UB_ITFOUND:
        LD      A,(UB_ITSLOT)
        LD      (UB_ITRET),A
        CALL    UB_ITSTEP
        LD      A,(UB_ITRET)
        OR      A               ; preserve slot and clear carry
        RET
UB_IALIVE:
        LD      A,(HL)
        CP      16
        JR      C,UB_ITFOUND
        JR      UB_ITADV
UB_ITMISS:
        POP     HL
UB_ITADV:
        CALL    UB_ITSTEP
        JP      UB_ITER
UB_ITDONE:
        XOR     A
        LD      (UB_ITLIVE),A
        LD      A,0FFH
        OR      A
        SCF
        RET

UB_ITSTEP:
        LD      A,(UB_ITSLOT)
        INC     A
        CP      4
        JR      C,UB_ITSAVE
        XOR     A
        LD      (UB_ITSLOT),A
        PUSH    HL
        LD      HL,UB_ITREC
        INC     (HL)
        POP     HL
        RET
UB_ITSAVE:
        LD      (UB_ITSLOT),A
        RET

; Function 15 configures the same iterator for an exact 8.3 name, then filters
; by the EXM-grouped logical extent. On success directory bytes 1..31 activate
; the caller FCB while its drive byte and current-record byte remain private.
UB_OPEN:
        CALL    UB_OPENCORE
        JP      UB_RETA
UB_OPENCORE:
        LD      (UB_ITFCB),DE
        CALL    UB_FCBDRV
        JP      C,UB_BAD
        CALL    UB_CONTEXT
        JP      NZ,UB_BAD
        LD      A,(UB_USERNO)
        LD      (UB_ITUSER),A
        XOR     A
        LD      (UB_ITMODE),A
        LD      (UB_ITALL),A
        LD      (UB_ITWILD),A
        LD      (UB_ITREC),A
        LD      (UB_ITSLOT),A
        LD      A,11
        LD      (UB_ITLEN),A
UB_OPNEXT:
        CALL    UB_ITER
        JP      C,UB_BAD
        LD      (UB_ITRET),A
        PUSH    HL
        LD      DE,12
        ADD     HL,DE
        LD      A,(HL)
        AND     01FH
        LD      C,A
        LD      HL,(UB_DPH)
        LD      DE,10
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        LD      DE,4
        ADD     HL,DE
        LD      A,(HL)          ; EXM
        CPL
        AND     01FH
        LD      B,A
        LD      A,C
        AND     B
        LD      C,A
        LD      HL,(UB_ITFCB)
        LD      DE,12
        ADD     HL,DE
        LD      A,(HL)
        AND     B
        CP      C
        JR      NZ,UB_OPMISS
        INC     HL
        INC     HL
        LD      C,(HL)          ; requested S2
        POP     HL
        PUSH    HL
        LD      DE,14
        ADD     HL,DE
        LD      A,(HL)
        AND     03FH
        CP      C
        JR      NZ,UB_OPMISS
        INC     HL
        LD      A,(HL)          ; RC must remain within one 128-record extent
        CP      129
        JR      NC,UB_OPMISS
        POP     HL
        LD      (UB_OPENENT),HL
        INC     HL
        LD      DE,(UB_ITFCB)
        INC     DE
        LD      BC,31
        LDIR
        LD      A,(UB_ITRET)
        RET
UB_OPMISS:
        POP     HL
        JR      UB_OPNEXT

; Function 16 currently commits RC only. It deliberately rejects allocation-
; map changes until U09 can authenticate them as products of the allocator.
UB_CLOSE:
        LD      (UB_ITFCB),DE
        LD      HL,1
        ADD     HL,DE
        LD      DE,UB_CSAVE
        LD      BC,31
        LDIR
        LD      DE,(UB_ITFCB)
        CALL    UB_OPENCORE     ; activates the canonical extent in the FCB
        LD      (UB_ITRET),A
        LD      HL,(UB_ITFCB)
        LD      DE,16
        ADD     HL,DE           ; HL=FCB+16
        LD      DE,UB_CSAVE+15  ; saved allocation map (FCB bytes 16..31)
        LD      B,16
UB_CLCMP:
        LD      A,(DE)
        CP      (HL)
        JR      NZ,UB_CLBAD
        INC     DE
        INC     HL
        DJNZ    UB_CLCMP
        LD      HL,(UB_ITFCB)
        LD      DE,15
        ADD     HL,DE
        LD      A,(UB_CSAVE+14)
        CP      129
        JR      NC,UB_CLBAD
        CP      (HL)
        JR      Z,UB_CLOK
        LD      C,A
        LD      A,(UB_CTXDRV)
        PUSH    BC
        LD      C,A
        LD      HL,UB_RDONLY
        CALL    UB_TESTBIT
        POP     BC
        JR      NZ,UB_CLBAD
        LD      HL,(UB_OPENENT)
        LD      DE,9
        ADD     HL,DE
        LD      A,(HL)
        AND     080H
        JR      NZ,UB_CLBAD
        LD      HL,(UB_OPENENT)
        LD      DE,15
        ADD     HL,DE
        LD      (HL),C
        LD      A,1
        LD      (UB_DIRTY),A
        CALL    UB_DIRFLUSH
        JR      NZ,UB_CLBAD
UB_CLOK:
        CALL    UB_CLREST
        LD      A,(UB_ITRET)
        JP      UB_RETA
UB_CLBAD:
        CALL    UB_CLREST
        JP      UB_BAD
UB_CLREST:
        LD      HL,UB_CSAVE
        LD      DE,(UB_ITFCB)
        INC     DE
        LD      BC,31
        LDIR
        RET

; Function 22 uses the common exact-name scan to reject duplicates, then the
; same iterator in free-entry mode. The loaded cache entry is the mutation
; target; one dirty flush publishes the initialized extent.
UB_MAKE:
        LD      (UB_ITFCB),DE
        CALL    UB_FCBDRV
        JP      C,UB_BAD
        CALL    UB_CONTEXT
        JP      NZ,UB_BAD
        LD      HL,UB_RDONLY
        CALL    UB_TESTBIT
        JP      NZ,UB_BAD
        LD      HL,(UB_ITFCB)
        INC     HL
        LD      B,11
UB_MKNAME:
        LD      A,(HL)
        AND     07FH
        CP      '?'
        JP      Z,UB_BAD
        INC     HL
        DJNZ    UB_MKNAME
        LD      A,(UB_USERNO)
        LD      (UB_ITUSER),A
        XOR     A
        LD      (UB_ITMODE),A
        LD      (UB_ITALL),A
        LD      (UB_ITWILD),A
        LD      (UB_ITREC),A
        LD      (UB_ITSLOT),A
        LD      A,11
        LD      (UB_ITLEN),A
        CALL    UB_ITER
        JP      NC,UB_BAD       ; any existing extent makes the name duplicate
        LD      A,1
        LD      (UB_ITMODE),A
        XOR     A
        LD      (UB_ITREC),A
        LD      (UB_ITSLOT),A
        CALL    UB_ITER
        JP      C,UB_BAD        ; directory full or physical read failure
        LD      (UB_ITRET),A
        LD      A,(UB_USERNO)
        LD      (HL),A
        INC     HL
        EX      DE,HL
        LD      HL,(UB_ITFCB)
        INC     HL
        LD      BC,31
        LDIR                    ; name, extent state, allocation map
        LD      A,1
        LD      (UB_DIRTY),A
        CALL    UB_DIRFLUSH
        JP      NZ,UB_BAD
        LD      A,(UB_ITRET)
        JP      UB_RETA

; Function 19 uses two passes over the same wildcard iterator. The first
; proves that every matching extent is mutable; the second marks matches E5.
; This prevents partial deletion when a later extent carries the R/O bit.
UB_DELETE:
        LD      (UB_ITFCB),DE
        CALL    UB_FCBDRV
        JP      C,UB_BAD
        CALL    UB_CONTEXT
        JP      NZ,UB_BAD
        LD      HL,UB_RDONLY
        CALL    UB_TESTBIT
        JP      NZ,UB_BAD
        CALL    UB_DSETUP
        XOR     A
        LD      (UB_FOUND),A
UB_DPRE:
        CALL    UB_ITER
        JR      C,UB_DPREOK
        LD      A,1
        LD      (UB_FOUND),A
        PUSH    HL
        LD      DE,9
        ADD     HL,DE
        LD      A,(HL)
        POP     HL
        AND     080H
        JP      NZ,UB_BAD
        JR      UB_DPRE
UB_DPREOK:
        LD      A,(UB_FOUND)
        OR      A
        JP      Z,UB_BAD
        CALL    UB_DSETUP
UB_DPASS:
        CALL    UB_ITER
        JR      C,UB_DDONE
        LD      (HL),0E5H
        LD      A,1
        LD      (UB_DIRTY),A
        JR      UB_DPASS
UB_DDONE:
        CALL    UB_DIRFLUSH
        JP      NZ,UB_BAD
        XOR     A
        JP      UB_RETA

; Configure an all-extent, wildcard-name scan for the caller's current user.
UB_DSETUP:
        LD      A,(UB_USERNO)
        LD      (UB_ITUSER),A
        XOR     A
        LD      (UB_ITMODE),A
        LD      (UB_ITALL),A
        LD      (UB_ITREC),A
        LD      (UB_ITSLOT),A
        LD      A,1
        LD      (UB_ITWILD),A
        LD      A,11
        LD      (UB_ITLEN),A
        RET

; Function 23 uses the shared iterator for target-existence, source preflight,
; and mutation. Only the eleven name/type bytes change; their attribute bits
; and every extent/allocation field remain attached to the original entry.
UB_RENAME:
        LD      (UB_RENFCB),DE
        CALL    UB_FCBDRV
        JP      C,UB_BAD
        CALL    UB_CONTEXT
        JP      NZ,UB_BAD
        LD      HL,UB_RDONLY
        CALL    UB_TESTBIT
        JP      NZ,UB_BAD
        LD      A,C
        LD      (UB_TMPDRV),A
        LD      HL,(UB_RENFCB)
        LD      DE,16
        ADD     HL,DE
        LD      A,(HL)          ; new-name drive must be default or same drive
        OR      A
        JR      Z,UB_RNAMES
        DEC     A
        LD      C,A
        LD      A,(UB_TMPDRV)
        CP      C
        JP      NZ,UB_BAD
UB_RNAMES:
        LD      HL,(UB_RENFCB)
        INC     HL
        LD      DE,16
        LD      B,11
UB_RNCHK:
        LD      A,(HL)
        AND     07FH
        CP      '?'
        JP      Z,UB_BAD
        ADD     HL,DE
        LD      A,(HL)
        AND     07FH
        CP      '?'
        JP      Z,UB_BAD
        OR      A
        SBC     HL,DE
        INC     HL
        DJNZ    UB_RNCHK
        LD      HL,(UB_RENFCB)
        LD      DE,16
        ADD     HL,DE
        LD      (UB_ITFCB),HL   ; reject an already-existing target name
        LD      A,(UB_USERNO)
        LD      (UB_ITUSER),A
        XOR     A
        LD      (UB_ITMODE),A
        LD      (UB_ITALL),A
        LD      (UB_ITWILD),A
        LD      (UB_ITREC),A
        LD      (UB_ITSLOT),A
        LD      A,11
        LD      (UB_ITLEN),A
        CALL    UB_ITER
        JP      NC,UB_BAD
        LD      HL,(UB_RENFCB)
        LD      (UB_ITFCB),HL
        CALL    UB_DSETUP
        XOR     A
        LD      (UB_FOUND),A
UB_RNPRE:
        CALL    UB_ITER
        JR      C,UB_RNPOK
        LD      A,1
        LD      (UB_FOUND),A
        PUSH    HL
        LD      DE,9
        ADD     HL,DE
        LD      A,(HL)
        POP     HL
        AND     080H
        JP      NZ,UB_BAD
        JR      UB_RNPRE
UB_RNPOK:
        LD      A,(UB_FOUND)
        OR      A
        JP      Z,UB_BAD
        CALL    UB_DSETUP
UB_RNPASS:
        CALL    UB_ITER
        JR      C,UB_RNDONE
        PUSH    HL
        INC     HL
        LD      DE,(UB_RENFCB)
        LD      BC,17
        EX      DE,HL
        ADD     HL,BC
        EX      DE,HL
        LD      B,11
UB_RNCOPY:
        LD      A,(HL)
        AND     080H
        LD      C,A
        LD      A,(DE)
        AND     07FH
        OR      C
        LD      (HL),A
        INC     HL
        INC     DE
        DJNZ    UB_RNCOPY
        POP     HL
        LD      A,1
        LD      (UB_DIRTY),A
        JR      UB_RNPASS
UB_RNDONE:
        CALL    UB_DIRFLUSH
        JP      NZ,UB_BAD
        XOR     A
        JP      UB_RETA

; Function 30 applies only the FCB's high attribute bits to all matching
; extents. Low seven-bit name/type characters and bytes 12..31 are untouched.
UB_ATTR:
        LD      (UB_ITFCB),DE
        CALL    UB_FCBDRV
        JP      C,UB_BAD
        CALL    UB_CONTEXT
        JP      NZ,UB_BAD
        LD      HL,UB_RDONLY
        CALL    UB_TESTBIT
        JP      NZ,UB_BAD
        CALL    UB_DSETUP
        XOR     A
        LD      (UB_FOUND),A
UB_ATPASS:
        CALL    UB_ITER
        JR      C,UB_ATDONE
        PUSH    HL
        INC     HL
        LD      DE,(UB_ITFCB)
        INC     DE
        LD      B,11
UB_ATCOPY:
        LD      A,(HL)
        AND     07FH
        LD      C,A
        LD      A,(DE)
        AND     080H
        OR      C
        LD      (HL),A
        INC     HL
        INC     DE
        DJNZ    UB_ATCOPY
        POP     HL
        LD      A,1
        LD      (UB_FOUND),A
        LD      (UB_DIRTY),A
        JR      UB_ATPASS
UB_ATDONE:
        LD      A,(UB_FOUND)
        OR      A
        JP      Z,UB_BAD
        CALL    UB_DIRFLUSH
        JP      NZ,UB_BAD
        XOR     A
        JP      UB_RETA

; Function 35 reduces every exact-name extent to its exclusive logical end
; record: ((S2*32 + EX)*128 + RC). The largest candidate becomes FCB R0..R2.
UB_SIZE:
        LD      (UB_ITFCB),DE
        CALL    UB_FCBDRV
        JP      C,UB_BAD
        CALL    UB_CONTEXT
        JP      NZ,UB_BAD
        LD      HL,(UB_ITFCB)
        INC     HL
        LD      B,11
UB_SZNAME:
        LD      A,(HL)
        AND     07FH
        CP      '?'
        JP      Z,UB_BAD
        INC     HL
        DJNZ    UB_SZNAME
        CALL    UB_DSETUP
        XOR     A
        LD      (UB_ITWILD),A
        LD      (UB_FOUND),A
        LD      (UB_MAXREC),A
        LD      (UB_MAXREC+1),A
        LD      (UB_MAXREC+2),A
UB_SZPASS:
        CALL    UB_ITER
        JR      C,UB_SZDONE
        LD      A,1
        LD      (UB_FOUND),A
        LD      C,15            ; directory RC supplies the end-record offset
        CALL    UB_EXTREC
        CALL    UB_MAXIMUM
        JR      UB_SZPASS
UB_SZDONE:
        LD      A,(UB_FOUND)
        OR      A
        JP      Z,UB_BAD
        LD      HL,UB_MAXREC
        LD      DE,(UB_ITFCB)
        LD      BC,33
        EX      DE,HL
        ADD     HL,BC
        EX      DE,HL
        LD      BC,3
        LDIR
        XOR     A
        JP      UB_RETA

; Function 36 and Size share this conversion from S2:EX plus an 8-bit record
; field into the 24-bit random-record form. HL=FCB/entry and C=record offset.
UB_EXTREC:
        PUSH    HL
        LD      DE,12
        ADD     HL,DE
        LD      A,(HL)
        AND     01FH
        LD      E,A
        INC     HL
        INC     HL
        LD      A,(HL)
        AND     03FH
        LD      H,0
        LD      L,A
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        LD      D,0
        ADD     HL,DE
        LD      A,L
        AND     1
        JR      Z,UB_EXLOW
        LD      A,080H
UB_EXLOW:
        LD      B,A
        EX      (SP),HL
        LD      E,C
        LD      D,0
        ADD     HL,DE
        LD      A,(HL)
        EX      (SP),HL
        ADD     A,B
        LD      (UB_CANREC),A
        LD      D,0
        JR      NC,UB_EXNC0
        INC     D
UB_EXNC0:
        SRL     H
        RR      L
        LD      A,L
        ADD     A,D
        LD      (UB_CANREC+1),A
        LD      A,H
        ADC     A,0
        LD      (UB_CANREC+2),A
        POP     HL
        RET

UB_SETRR:
        EX      DE,HL
        LD      C,32
        CALL    UB_EXTREC
        LD      HL,UB_CANREC
        LD      DE,(UB_PARM)
        LD      BC,33
        EX      DE,HL
        ADD     HL,BC
        EX      DE,HL
        LD      BC,3
        LDIR
        XOR     A
        JP      UB_RETA

; Function 20 is the first U09 client. EOF is an ordinary result (1); invalid
; mapping or physical failure uses the provisional FF error result.
UB_READ:
        CALL    UB_READCORE
        JP      UB_RETA
UB_READCORE:
        LD      (UB_RFCB),DE
        CALL    UB_FCBDRV
        JP      C,UB_BAD
        CALL    UB_CONTEXT
        JP      NZ,UB_BAD
        LD      HL,(UB_RFCB)
        LD      DE,32
        ADD     HL,DE
        LD      A,(HL)
        LD      C,A
        LD      HL,(UB_RFCB)
        LD      DE,15
        ADD     HL,DE
        LD      A,C
        CP      (HL)
        JR      NC,UB_REOF
        CALL    UB_RECMAP
        JP      C,UB_BAD
        LD      BC,(UB_DMA)
        CALL    BIO_SETDMA
        CALL    BIO_READ
        OR      A
        JP      NZ,UB_BAD
        LD      HL,(UB_RFCB)
        LD      DE,32
        ADD     HL,DE
        INC     (HL)
        XOR     A
        RET
UB_REOF:
        LD      A,1
        RET

; Function 21 shares U09 with Read.  A missing allocation-map element is
; satisfied through U07, installed in the caller FCB, and then mapped again.
; Close remains the single directory commit point for the changed RC/map.
UB_WRITE:
        XOR     A
        LD      (UB_ZMODE),A
        CALL    UB_WCORE
        JP      UB_RETA
UB_WCORE:
        LD      (UB_RFCB),DE
        CALL    UB_FCBDRV
        JP      C,UB_BAD
        CALL    UB_CONTEXT
        JP      NZ,UB_BAD
        LD      HL,UB_RDONLY
        CALL    UB_TESTBIT
        JP      NZ,UB_BAD
        LD      HL,(UB_RFCB)
        LD      DE,9
        ADD     HL,DE
        LD      A,(HL)
        AND     080H
        JP      NZ,UB_BAD
        CALL    UB_RECMAP
        JR      NC,UB_WMAPPED
        JP      NZ,UB_BAD       ; only an empty allocation element is repairable
        LD      A,(UB_DSM+1)
        OR      A
        LD      A,(UB_RBNO)
        JR      Z,UB_WCHK8
        CP      8
        JP      NC,UB_BAD
        JR      UB_WALLOC
UB_WCHK8:
        CP      16
        JP      NC,UB_BAD
UB_WALLOC:
        CALL    UB_ALFREE
        JP      NZ,UB_BAD
        PUSH    DE
        CALL    UB_ALMARK
        POP     DE
        JP      NZ,UB_BAD
        LD      HL,(UB_RFCB)
        LD      BC,16
        ADD     HL,BC
        LD      A,(UB_DSM+1)
        OR      A
        LD      A,(UB_RBNO)
        JR      Z,UB_WPUT8
        ADD     A,A
        LD      C,A
        LD      B,0
        ADD     HL,BC
        LD      (HL),E
        INC     HL
        LD      (HL),D
        JR      UB_WREMAP
UB_WPUT8:
        LD      C,A
        LD      B,0
        ADD     HL,BC
        LD      (HL),E
UB_WREMAP:
        CALL    UB_RECMAP
        JP      C,UB_BAD
        LD      A,(UB_ZMODE)
        OR      A
        JR      Z,UB_WMAPPED
        CALL    UB_ZBLOCK
        JP      NZ,UB_BAD
UB_WMAPPED:
        LD      BC,(UB_DMA)
        CALL    BIO_SETDMA
        LD      C,0
        CALL    BIO_WRITE
        OR      A
        JP      NZ,UB_BAD
        LD      HL,(UB_RFCB)
        LD      DE,32
        ADD     HL,DE
        INC     (HL)
        LD      A,(HL)
        LD      DE,-17
        ADD     HL,DE
        CP      (HL)
        JR      C,UB_WDONE
        LD      (HL),A
UB_WDONE:
        XOR     A
        RET

; Function 33 decodes R0..R2 into the ordinary extent position, activates
; that extent, and then enters the exact same read core as Function 20.
UB_RREAD:
        CALL    UB_RDECODE
        LD      DE,(UB_RFCB)
        CALL    UB_OPENCORE
        LD      DE,(UB_RFCB)
        CALL    UB_READCORE
        JP      UB_RETA

; Function 34 differs only in its final shared transfer core.
UB_RWRITE:
        XOR     A
        LD      (UB_ZMODE),A
UB_RWCOMMON:
        CALL    UB_RDECODE
        LD      DE,(UB_RFCB)
        CALL    UB_OPENCORE
        LD      DE,(UB_RFCB)
        CALL    UB_WCORE
        JP      UB_RETA

; Function 40 zeroes every record of a newly allocated block before the
; requested random write.  The flushed directory buffer is reusable scratch,
; avoiding another permanent 128-byte buffer in the fixed core.
UB_RZERO:
        LD      A,1
        LD      (UB_ZMODE),A
        JR      UB_RWCOMMON

UB_ZBLOCK:
        CALL    UB_DIRFLUSH
        RET     NZ
        XOR     A
        LD      (UBS_COK),A
        LD      HL,(UB_DIRBUF)
        LD      B,128
UB_ZCLEAR:
        LD      (HL),A
        INC     HL
        DJNZ    UB_ZCLEAR
        LD      HL,(UB_RFCB)
        LD      DE,32
        ADD     HL,DE
        LD      A,(HL)
        LD      (UB_RRCR),A
        LD      HL,(UB_DPB)
        INC     HL
        INC     HL
        INC     HL
        LD      C,(HL)          ; BLM
        LD      A,C
        CPL
        LD      HL,(UB_RFCB)
        LD      DE,32
        ADD     HL,DE
        AND     (HL)
        LD      (HL),A          ; first record in the allocated block
        LD      A,C
        INC     A
        LD      C,A
UB_ZLOOP:
        PUSH    BC
        CALL    UB_RECMAP
        JR      C,UB_ZFAIL
        LD      BC,(UB_DIRBUF)
        CALL    BIO_SETDMA
        LD      C,0
        CALL    BIO_WRITE
        OR      A
        JR      NZ,UB_ZFAIL
        LD      HL,(UB_RFCB)
        LD      DE,32
        ADD     HL,DE
        INC     (HL)
        POP     BC
        DEC     C
        JR      NZ,UB_ZLOOP
        LD      A,(UB_RRCR)
        LD      (HL),A
        CALL    UB_RECMAP
        RET
UB_ZFAIL:
        POP     BC
        LD      A,1
        OR      A
        RET

UB_RDECODE:
        LD      (UB_RFCB),DE
        LD      HL,35
        ADD     HL,DE
        LD      A,(HL)          ; CP/M 2.2 uses only low two bits of R2
        CP      4
        JP      NC,UB_BAD
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,A
        LD      B,A
        DEC     HL
        LD      A,(HL)          ; R1
        LD      C,A
        RRCA
        RRCA
        RRCA
        RRCA
        AND     0FH
        OR      B
        LD      B,A             ; decoded S2
        LD      A,C
        AND     0FH
        ADD     A,A
        LD      C,A             ; EX bits 1..4
        DEC     HL
        LD      A,(HL)          ; R0
        AND     07FH
        LD      (UB_RRCR),A
        LD      A,(HL)
        AND     080H
        JR      Z,UB_RRLOW
        LD      A,C
        OR      1
        LD      C,A
UB_RRLOW:
        LD      HL,(UB_RFCB)
        LD      DE,12
        ADD     HL,DE
        LD      (HL),C
        INC     HL
        INC     HL
        LD      (HL),B
        LD      HL,(UB_RFCB)
        LD      DE,32
        ADD     HL,DE
        LD      A,(UB_RRCR)
        LD      (HL),A
        RET

; Map the current sequential record in UB_RFCB through EXM, BSH/BLM, the
; 8/16-bit allocation map, SPT/OFF, and BIOS sector translation.
UB_RECMAP:
        LD      HL,(UB_RFCB)
        LD      DE,12
        ADD     HL,DE
        LD      C,(HL)          ; EX
        LD      HL,(UB_DPB)
        LD      DE,4
        ADD     HL,DE
        LD      A,(HL)          ; EXM
        AND     C
        LD      H,A
        LD      L,0
        SRL     H
        RR      L               ; grouped subextent * 128
        LD      DE,(UB_RFCB)
        EX      DE,HL
        LD      BC,32
        ADD     HL,BC
        LD      C,(HL)          ; CR
        EX      DE,HL
        LD      B,0
        ADD     HL,BC
        LD      C,L
        LD      (UB_RLOG),HL
        LD      HL,(UB_DPB)
        INC     HL
        INC     HL               ; DPB+2 BSH
        LD      B,(HL)
        INC     HL               ; DPB+3 BLM
        LD      A,(HL)
        AND     C
        LD      (UB_RREM),A
        LD      HL,(UB_RLOG)
        LD      A,B
UB_RBSH:
        OR      A
        JR      Z,UB_RBIX
        SRL     H
        RR      L
        DEC     A
        JR      UB_RBSH
UB_RBIX:
        LD      A,H
        OR      A
        JP      NZ,UB_RMBAD
        LD      A,L
        LD      (UB_RBNO),A
        LD      HL,(UB_RFCB)
        LD      DE,16
        ADD     HL,DE
        LD      A,(UB_DSM+1)
        OR      A
        LD      A,(UB_RBNO)
        JR      Z,UB_RGET8
        ADD     A,A
        LD      E,A
        LD      D,0
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        JR      UB_RBLOCK
UB_RGET8:
        LD      E,A
        LD      D,0
        ADD     HL,DE
        LD      E,(HL)
        LD      D,0
UB_RBLOCK:
        LD      A,D
        OR      E
        JR      Z,UB_RMBAD
        EX      DE,HL
        LD      DE,(UB_DSM)
        OR      A
        SBC     HL,DE
        JR      C,UB_RMVALID
        JR      NZ,UB_RMBAD
UB_RMVALID:
        ADD     HL,DE
        LD      DE,(UB_DPB)
        INC     DE
        INC     DE
        LD      A,(DE)
UB_RMSH:
        OR      A
        JR      Z,UB_RMREM
        ADD     HL,HL
        DEC     A
        JR      UB_RMSH
UB_RMREM:
        LD      A,(UB_RREM)
        LD      E,A
        LD      D,0
        ADD     HL,DE
        PUSH    HL
        LD      HL,(UB_DPB)
        LD      E,(HL)           ; SPT low; supported geometry is below 256
        LD      D,0
        POP     HL
        LD      BC,0
UB_RMDIV:
        OR      A
        SBC     HL,DE
        JR      C,UB_RMDONE
        INC     BC
        JR      UB_RMDIV
UB_RMDONE:
        ADD     HL,DE
        PUSH    HL
        LD      HL,(UB_DPB)
        LD      DE,13
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      H,B
        LD      L,C
        ADD     HL,DE
        LD      B,H
        LD      C,L
        CALL    BIO_SETTRK
        POP     BC
        LD      DE,0
        CALL    BIO_SECTRAN
        LD      B,H
        LD      C,L
        CALL    BIO_SETSEC
        OR      A
        RET
UB_RMBAD:
        SCF
        RET

UB_MAXIMUM:
        LD      HL,UB_MAXREC+2
        LD      DE,UB_CANREC+2
        LD      B,3
UB_MXCMP:
        LD      A,(DE)
        CP      (HL)
        JR      C,UB_MXNO
        JR      NZ,UB_MXTAKE
        DEC     DE
        DEC     HL
        DJNZ    UB_MXCMP
UB_MXNO:
        RET
UB_MXTAKE:
        LD      HL,UB_CANREC
        LD      DE,UB_MAXREC
        LD      BC,3
        LDIR
        RET

; U07 -- reconstruct the active allocation vector from DPB reserved blocks and
; every live directory entry. The iterator's all-live mode is also available
; to later allocation repair and diagnostic clients.
UB_ALLOGIN:
        LD      HL,(UB_DPH)
        LD      DE,10
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (UB_DPB),DE
        EX      DE,HL
        LD      DE,5
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (UB_DSM),DE
        LD      HL,(UB_DPH)
        LD      DE,14
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (UB_ALVP),DE
        LD      HL,(UB_DSM)
        LD      DE,8
        ADD     HL,DE
        SRL     H
        RR      L
        SRL     H
        RR      L
        SRL     H
        RR      L
        LD      B,L
        LD      HL,(UB_ALVP)
        XOR     A
UB_ALCLR:
        LD      (HL),A
        INC     HL
        DJNZ    UB_ALCLR
        LD      HL,(UB_DPB)
        LD      DE,9
        ADD     HL,DE
        LD      A,(HL)          ; AL0/AL1 reserve directory blocks
        LD      DE,(UB_ALVP)
        LD      (DE),A
        INC     HL
        INC     DE
        LD      A,(HL)
        LD      (DE),A
        LD      A,2
        LD      (UB_ITMODE),A
        XOR     A
        LD      (UB_ITREC),A
        LD      (UB_ITSLOT),A
UB_ALSCAN:
        CALL    UB_ITER
        JR      C,UB_ALDONE
        LD      DE,16
        ADD     HL,DE
        LD      A,(UB_DSM+1)
        OR      A
        JR      Z,UB_AL8
        LD      B,8
UB_AL16LP:
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     HL
        LD      A,D
        OR      E
        JR      Z,UB_AL16NX
        CALL    UB_ALMARK
        RET     NZ
UB_AL16NX:
        DJNZ    UB_AL16LP
        JR      UB_ALSCAN
UB_AL8:
        LD      B,16
UB_AL8LP:
        LD      E,(HL)
        INC     HL
        LD      D,0
        LD      A,E
        OR      A
        JR      Z,UB_AL8NX
        CALL    UB_ALMARK
        RET     NZ
UB_AL8NX:
        DJNZ    UB_AL8LP
        JR      UB_ALSCAN
UB_ALDONE:
        XOR     A
        RET

; Mark allocation block DE, rejecting any nonzero block beyond DSM.
UB_ALMARK:
        PUSH    BC
        PUSH    DE
        PUSH    HL
        CALL    UB_ALADDR
        JR      C,UB_ALMERR
        OR      (HL)
        LD      (HL),A
        XOR     A
        JR      UB_ALRET
UB_ALMERR:
        LD      A,1
        OR      A
UB_ALRET:
        POP     HL
        POP     DE
        POP     BC
        RET

; Clear allocation block DE. This is the inverse used after committed Delete
; and by extent rollback; block zero is a normal unused allocation-map value.
UB_ALCLEAR:
        PUSH    BC
        PUSH    DE
        PUSH    HL
        CALL    UB_ALADDR
        JR      C,UB_ALCERR
        CPL
        AND     (HL)
        LD      (HL),A
        XOR     A
        JR      UB_ALCRET
UB_ALCERR:
        LD      A,1
        OR      A
UB_ALCRET:
        POP     HL
        POP     DE
        POP     BC
        RET

; Return DE=the first free block. Reserved directory blocks are already set.
UB_ALFREE:
        LD      HL,(UB_ALVP)
        LD      DE,0
        LD      C,080H
UB_AFLP:
        LD      A,(HL)
        AND     C
        JR      Z,UB_AFOUND
        INC     DE
        PUSH    HL
        LD      HL,(UB_DSM)
        LD      A,D
        CP      H
        JR      C,UB_AFCONT
        JR      NZ,UB_AFFULL
        LD      A,E
        CP      L
        JR      C,UB_AFCONT
        JR      Z,UB_AFCONT
UB_AFFULL:
        POP     HL
        LD      A,1
        OR      A
        RET
UB_AFCONT:
        POP     HL
        SRL     C
        JR      NZ,UB_AFLP
        LD      C,080H
        INC     HL
        JR      UB_AFLP
UB_AFOUND:
        XOR     A
        RET

; Translate block DE into allocation-vector byte HL and high-first mask A.
UB_ALADDR:
        LD      HL,(UB_DSM)
        LD      A,D
        CP      H
        JR      C,UB_AAVAL
        JR      NZ,UB_AABAD
        LD      A,E
        CP      L
        JR      C,UB_AAVAL
        JR      NZ,UB_AABAD
UB_AAVAL:
        LD      A,E
        AND     7
        LD      C,A
        LD      H,D
        LD      L,E
        SRL     H
        RR      L
        SRL     H
        RR      L
        SRL     H
        RR      L
        LD      DE,(UB_ALVP)
        ADD     HL,DE
        PUSH    HL
        LD      B,0
        LD      HL,UB_ALBITS
        ADD     HL,BC
        LD      A,(HL)
        POP     HL
        OR      A               ; mask is nonzero and carry is clear
        RET
UB_AABAD:
        SCF
        RET

UB_ALBITS:
        DB      128,64,32,16,8,4,2,1

; U06 -- a single cache backed by the DPH-published directory buffer. Caching
; state names the directory record currently represented; mutation clients
; will set UB_DIRTY and commit through UB_DIRFLUSH.
UB_DIRLOAD:
        LD      C,A
        CALL    UB_DIRCOUNT
        LD      A,C
        CP      B
        JR      NC,UB_DIRBAD
        LD      A,(UBS_COK)
        OR      A
        JR      Z,UB_DIRMISS
        LD      A,(UBS_CREC)
        CP      C
        JR      Z,UB_DIRHIT
        CALL    UB_DIRFLUSH
        RET     NZ
UB_DIRMISS:
        LD      A,C
        LD      (UBS_CREC),A
        LD      HL,(UB_DPH)
        LD      DE,8
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (UB_DIRBUF),DE
        CALL    UB_DIRPOS
        LD      BC,(UB_DIRBUF)
        CALL    BIO_SETDMA
        CALL    BIO_READ
        OR      A
        RET     NZ
        LD      A,1
        LD      (UBS_COK),A
UB_DIRHIT:
        LD      HL,(UB_DIRBUF)
        XOR     A
        RET
UB_DIRBAD:
        LD      A,1
        OR      A
        RET

; B=ceil((DRM+1)/4), constrained to the CP/M 2.2 8-bit search continuation.
UB_DIRCOUNT:
        LD      HL,(UB_DPH)
        LD      DE,10
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)          ; DE=DPB
        EX      DE,HL
        LD      DE,7
        ADD     HL,DE
        LD      A,(HL)
        ADD     A,4
        SRL     A
        SRL     A
        LD      B,A
        RET

; Position BIOS at directory record C using live SPT and OFF from the DPB.
UB_DIRPOS:
        LD      HL,(UB_DPH)
        LD      DE,10
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL           ; HL=DPB
        LD      E,(HL)
        INC     HL
        LD      D,(HL)          ; DE=SPT
        LD      A,C
        LD      C,E             ; supported format has SPT below 256
        LD      B,0
UB_DIRDIV:
        CP      C
        JR      C,UB_DIRREM
        SUB     C
        INC     B
        JR      UB_DIRDIV
UB_DIRREM:
        PUSH    AF
        PUSH    DE
        LD      HL,(UB_DPH)
        LD      DE,10
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        LD      DE,13
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)          ; DE=OFF
        LD      H,B
        LD      L,0
        LD      A,H
        OR      A
        JR      Z,UB_DIROFF
        LD      L,H
        LD      H,0
UB_DIROFF:
        ADD     HL,DE
        LD      B,H
        LD      C,L
        CALL    BIO_SETTRK
        POP     DE
        POP     AF
        LD      C,A
        LD      B,0
        LD      DE,0
        CALL    BIO_SECTRAN
        LD      B,H
        LD      C,L
        JP      BIO_SETSEC

UB_DIRFLUSH:
        LD      A,(UB_DIRTY)
        OR      A
        RET     Z
        LD      A,(UBS_CREC)
        LD      C,A
        CALL    UB_DIRPOS
        LD      BC,(UB_DIRBUF)
        CALL    BIO_SETDMA
        LD      C,1
        CALL    BIO_WRITE
        OR      A
        RET     NZ
        XOR     A
        LD      (UB_DIRTY),A
        RET

UB_PARM:        DW      0
UB_OLDSP:       DW      0
UB_DRIVE:       DB      0
UB_USERNO:      DB      0
UB_DMA:         DW      0080H
UBS_LOGIN:      DW      0
UB_RDONLY:      DW      0
UB_VALID:       DB      0
UB_CTXDRV:      DB      0
UB_DPH:         DW      0
UB_ITFCB:       DW      0
UB_ITUSER:      DB      0
UB_ITALL:       DB      0
UB_ITREC:       DB      0
UB_ITSLOT:      DB      0
UB_ITLIVE:      DB      0
UB_ITRET:       DB      0
UB_ITLEN:       DB      0
UB_ITWILD:      DB      0
UB_ITMODE:      DB      0       ; zero=used match, one=deleted/free entry
UB_DIRBUF:      DW      0
UBS_CREC:       DB      0
UBS_COK:        DB      0
UB_DIRTY:       DB      0
UB_FOUND:       DB      0
UB_RENFCB:      DW      0
UB_TMPDRV:      DB      0
UB_CANREC:      DB      0,0,0
UB_MAXREC:      DB      0,0,0
UB_DPB:         DW      0
UB_DSM:         DW      0
UB_ALVP:        DW      0
UB_OPENENT:     DW      0
UB_CSAVE:
        REPT    31
        DB      0
        ENDM
UB_RFCB:        DW      0
UB_RREM:        DB      0
UB_RLOG:        DW      0
UB_RBNO:        DB      0
UB_RRCR:        DB      0
UB_ZMODE:       DB      0

UB_STACK:
        REPT    48
        DB      0
        ENDM
UB_STKTOP:

        .DEPHASE
        END
