; BetterCP/M first filesystem-facing directory reader.
;
; This is an independently buildable System Services component, not a BIOS
; extension.  Its placement and the BIOS address are provisional bring-up
; values.  It deliberately reaches disk only through the CP/M BIOS vectors.

DIRBASE         EQU     0E800H
; Patch 2026-09-01: DIRBUF was E900H through specification 14, EA00H for
; specification 15, EC00H through specification 25, and ED00H for
; specifications 26-27. Dirty Close grew across ED00H, so the intact buffer
; moved below the resident code. Retaining the old placements records why the
; provisional map evolved and flags the need for a broader layout revision.
DIRBUF          EQU     0E400H
BIOSBASE        EQU     0F000H
BIOSELDS        EQU     BIOSBASE+27
BIOSETTR        EQU     BIOSBASE+30
BIOSETSE        EQU     BIOSBASE+33
BIOSETDM        EQU     BIOSBASE+36
BIOREAD         EQU     BIOSBASE+39
BIOWRITE        EQU     BIOSBASE+42

        CSEG
        .PHASE  DIRBASE

; Provisional internal service vectors keep callers independent of routine size.
DIRSERV:
        JP      DIR_LD0
        JP      DIR_FIRST
        JP      DIR_LOAD
        JP      DIR_FIND
        JP      DIR_LOGIN
        JP      DIR_INVAL
        JP      DIR_OPEN
        JP      DIR_GALV
        JP      DIR_GDPB
        JP      DIR_SFIR
        JP      DIR_SNXT
        JP      DIR_CLOSE

; Close an activated FCB. B is nonzero when the current disk is software
; protected. This first commit path permits RC-only metadata changes; allocation
; map mutation remains rejected until write functions own validated blocks.
DIR_CLOSE:
        LD      (DIR_CFP),DE
        LD      A,B
        LD      (DIR_CPRO),A
        PUSH    AF
        LD      HL,1
        ADD     HL,DE
        LD      DE,DIR_CSAV
        LD      BC,31
        LDIR
        LD      DE,(DIR_CFP)
        POP     AF
        CALL    DIR_OPEN
        RET     C
        CP      0FFH
        RET     Z
        LD      (DIR_CRET),A
        LD      HL,(DIR_CFP)
        INC     HL
        LD      DE,DIR_CSAV
        LD      B,14            ; identity through S2 must remain canonical
C_CMPA:
        LD      A,(DE)
        CP      (HL)
        JP      NZ,DIR_CNOMR
        INC     DE
        INC     HL
        DJNZ    C_CMPA
        LD      A,(DE)          ; saved FCB RC
        CP      129
        JP      NC,DIR_CNOMR
        LD      (DIR_CNRC),A
        LD      C,A
        LD      A,(HL)          ; canonical on-disk RC
        CP      C
        LD      A,0
        JR      Z,DIR_CRCEQ
        DEC     A               ; FFh marks the permitted dirty-RC case
DIR_CRCEQ:
        LD      (DIR_CDIR),A
        INC     DE
        INC     HL
        LD      B,16            ; allocation map must remain unchanged for now
C_CMPB:
        LD      A,(DE)
        CP      (HL)
        JP      NZ,DIR_CNOMR
        INC     DE
        INC     HL
        DJNZ    C_CMPB
        LD      A,(DIR_CDIR)
        OR      A
        JR      NZ,DIR_CWRITE
        LD      A,(DIR_CRET)
        OR      A
        RET

DIR_CWRITE:
        CALL    DIR_CREST       ; caller retains its dirty FCB exactly
        LD      A,(DIR_CPRO)
        OR      A
        JR      NZ,C_NOWR
        CALL    DIR_CENT
        PUSH    HL
        LD      DE,DIR_COLD
        LD      BC,32
        LDIR                    ; preserve buffer state for failed writeback
        POP     HL
        INC     HL
        LD      DE,DIR_CSAV
        EX      DE,HL
        LD      BC,31
        LDIR                    ; merge validated FCB fields into directory
        LD      C,1             ; BIOS directory-write type
        CALL    BIOWRITE
        JR      NZ,DIR_CWERR
        CALL    DIR_INVAL       ; rebuild allocation/login state on next use
        LD      A,(DIR_CRET)
        OR      A
        RET
DIR_CWERR:
        PUSH    AF
        CALL    DIR_CENT
        EX      DE,HL
        LD      HL,DIR_COLD
        LD      BC,32
        LDIR
        CALL    DIR_INVAL       ; media state is uncertain after failed write
        POP     AF
        SCF
        RET

DIR_CNOMR:
        CALL    DIR_CREST
C_NOWR:
        LD      A,0FFH          ; unsupported dirty state or protected disk
        OR      A
        RET

DIR_CREST:
        LD      HL,DIR_CSAV
        LD      DE,(DIR_CFP)
        INC     DE
        LD      BC,31
        LDIR
        RET

DIR_CENT:
        LD      HL,DIRBUF
        LD      A,(DIR_CRET)
        OR      A
        RET     Z
        LD      DE,32
DIR_CEADD:
        ADD     HL,DE
        DEC     A
        JR      NZ,DIR_CEADD
        RET

; Begin/continue a CP/M directory enumeration. Search First receives current
; user in A, FCB in DE, and DMA in BC. Search Next receives the current DMA in
; BC and uses the retained FCB/cursor. Successful calls copy all 128 bytes of
; the containing directory record to DMA and return its slot in A.
DIR_SFIR:
        LD      (DIR_USER),A
        LD      (DIR_FCBP),DE
        LD      (DIR_SDMA),BC
        LD      A,(DE)
        CP      '?'
        JR      Z,DIR_SALL
        CP      2
        JP      NC,DIR_SNONE
        XOR     A
        LD      (S_ALLUSR),A
        LD      HL,(DIR_FCBP)
        LD      DE,14
        ADD     HL,DE
        LD      (HL),0          ; ordinary Search First clears S2
        JR      DIR_SINIT
DIR_SALL:
        LD      A,0FFH
        LD      (S_ALLUSR),A
DIR_SINIT:
        XOR     A
        LD      (DIR_RECORD),A
        LD      (DIR_SLOT),A
        LD      A,0FFH
        LD      (DIR_SACT),A
        JR      DIR_SSCAN

DIR_SNXT:
        LD      (DIR_SDMA),BC
        LD      A,(DIR_SACT)
        OR      A
        JP      Z,DIR_SNONE

DIR_SSCAN:
        LD      A,(DIR_RECORD)
        LD      HL,DIR_RECS
        CP      (HL)
        JP      NC,DIR_SNONE
        LD      C,A
        CALL    DIR_LOAD
        JR      Z,DIR_SLOK
        SCF
        RET
DIR_SLOK:
        LD      A,(DIR_SLOT)
        OR      A
        JR      Z,DIR_SENT
        LD      DE,32
DIR_SSKIP:
        ADD     HL,DE
        DEC     A
        JR      NZ,DIR_SSKIP
DIR_SENT:
        LD      A,(HL)
        CP      32              ; deleted and reserved metadata never match
        JR      NC,DIR_SADV
        LD      A,(S_ALLUSR)
        OR      A
        JR      NZ,DIR_SNAME
        LD      A,(DIR_USER)
        CP      (HL)
        JR      NZ,DIR_SADV
DIR_SNAME:
        PUSH    HL
        INC     HL
        LD      DE,(DIR_FCBP)
        INC     DE
        LD      B,12            ; filename, type, and EX
DIR_SCMP:
        LD      A,(DE)
        CP      '?'
        JR      Z,DIR_SCNXT
        AND     07FH
        LD      C,A
        LD      A,B
        CP      1               ; final compared byte is five-bit EX
        JR      NZ,DIR_SBASE
        LD      A,C
        AND     01FH
        LD      C,A
        LD      A,(HL)
        AND     01FH
        JR      DIR_SCOMP
DIR_SBASE:
        LD      A,(HL)
        AND     07FH
DIR_SCOMP:
        CP      C
        JR      NZ,DIR_SMISS
DIR_SCNXT:
        INC     DE
        INC     HL
        DJNZ    DIR_SCMP
        POP     HL
        LD      A,(DIR_SLOT)
        LD      (DIR_SRET),A
        CALL    S_ADV0          ; continuation begins after this match
        LD      HL,DIRBUF
        LD      DE,(DIR_SDMA)
        LD      BC,128
        LDIR
        LD      A,(DIR_SRET)
        OR      A               ; clear carry; slot zero remains Z
        RET
DIR_SMISS:
        POP     HL
DIR_SADV:
        CALL    S_ADV0
        JR      DIR_SSCAN

S_ADV0:
        LD      A,(DIR_SLOT)
        INC     A
        CP      4
        JR      C,DIR_SSLOT
        XOR     A
        LD      (DIR_SLOT),A
        LD      A,(DIR_RECORD)
        INC     A
        LD      (DIR_RECORD),A
        RET
DIR_SSLOT:
        LD      (DIR_SLOT),A
        RET

DIR_SNONE:
        XOR     A
        LD      (DIR_SACT),A
        LD      A,0FFH
        OR      A
        RET

; Return live current-drive state for BDOS pointer-query functions. A stale or
; invalidated login is rebuilt before its private pointers become public.
DIR_GALV:
        LD      A,(DIR_VALID)
        OR      A
        JR      NZ,DIR_AGOK
        LD      A,(DIR_DRIVE)
        LD      C,A
        CALL    DIR_LOGIN
        RET     NZ
DIR_AGOK:
        LD      HL,(DIR_ALVP)
        XOR     A
        RET

DIR_GDPB:
        CALL    DIR_GALV
        RET     NZ
        LD      HL,(DIR_DPB)
        XOR     A
        RET

; Establish drive state from its DPH and DPB. Input C=drive.
; The allocation vector is cleared, seeded from AL0/AL1, and reconstructed
; from every live ordinary directory extent before login becomes valid.
DIR_LOGIN:
        XOR     A
        LD      (DIR_VALID),A
        LD      A,C
        LD      (DIR_DRIVE),A
        CALL    BIOSELDS
        LD      A,H
        OR      L
        JP      Z,DIR_NODRV
        LD      (DIR_DPH),HL
        LD      DE,10
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (DIR_DPB),DE
        EX      DE,HL
        LD      E,(HL)          ; SPT
        INC     HL
        LD      D,(HL)
        LD      (DIR_SPT),DE
        LD      A,D             ; current divider requires 1..255 records/track
        OR      A
        JP      NZ,DIR_BADFMT
        LD      A,E
        OR      A
        JP      Z,DIR_BADFMT
        LD      DE,3
        ADD     HL,DE           ; EXM at DPB+4
        LD      A,(HL)
        LD      (DIR_EXM),A
        CP      16
        JP      NC,DIR_BADFMT
        INC     HL              ; DSM at DPB+5
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (DIR_DSM),DE
        INC     HL              ; DRM at DPB+7
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (DIR_DRM),DE
        INC     HL              ; AL0/AL1 at DPB+9
        LD      A,(HL)
        LD      (DIR_AL0),A
        INC     HL
        LD      A,(HL)
        LD      (DIR_AL1),A
        LD      DE,3
        ADD     HL,DE           ; OFF at DPB+13
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (DIR_OFF),DE

        LD      HL,(DIR_DRM)    ; ceil((DRM+1)/4) directory records
        LD      DE,4
        ADD     HL,DE
        SRL     H
        RR      L
        SRL     H
        RR      L
        LD      (DIR_RECS),HL
        LD      A,H             ; current scanner uses an 8-bit record index
        OR      A
        JR      NZ,DIR_BADFMT

        LD      HL,(DIR_DPH)
        LD      DE,14
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (DIR_ALVP),DE
        LD      HL,(DIR_DSM)    ; ceil((DSM+1)/8) allocation bytes
        LD      DE,8
        ADD     HL,DE
        SRL     H
        RR      L
        SRL     H
        RR      L
        SRL     H
        RR      L
        LD      A,H
        OR      A
        JR      NZ,DIR_BADFMT
        LD      B,L
        LD      HL,(DIR_ALVP)
        XOR     A
DIR_ACLR:
        LD      (HL),A
        INC     HL
        DJNZ    DIR_ACLR
        LD      HL,(DIR_ALVP)
        LD      A,(DIR_AL0)
        LD      (HL),A
        INC     HL
        LD      A,(DIR_AL1)
        LD      (HL),A
        CALL    DIR_ALSCN
        RET     NZ
        LD      A,0FFH
        LD      (DIR_VALID),A
        XOR     A
        RET
DIR_BADFMT:
        LD      A,1
        OR      A
        RET

DIR_INVAL:
        XOR     A
        LD      (DIR_VALID),A
        RET

; Read the first 128-byte directory record for drive A.
; Returns A=0/Z and HL=DIRBUF, or the BIOS/nonexistent-drive error in A/NZ.
DIR_LD0:
        LD      C,0
        JP      DIR_LOAD

; Read directory record C (0..31) for the current 128-entry MM 790K format.
; The format-specific bounds belong here, above the geometry-neutral BIOS.
DIR_LOAD:
        LD      A,(DIR_VALID)
        OR      A
        JR      NZ,DIR_LDOK
        PUSH    BC
        LD      C,0
        CALL    DIR_LOGIN
        POP     BC
        RET     NZ
DIR_LDOK:
        LD      A,C
        LD      HL,DIR_RECS
        CP      (HL)
        JR      NC,DIR_NODRV
        LD      (DIR_RECORD),A
        LD      A,(DIR_DRIVE)
        LD      C,A
        CALL    BIOSELDS
        LD      A,H
        OR      L
        JR      Z,DIR_NODRV
        LD      BC,(DIR_OFF)
        LD      A,(DIR_RECORD)
DIR_DIVSP:
        LD      HL,DIR_SPT
        CP      (HL)
        JR      C,DIR_DIVDN
        SUB     (HL)
        INC     BC
        JR      DIR_DIVSP
DIR_DIVDN:
        PUSH    AF
        CALL    BIOSETTR
        POP     AF
        LD      C,A
        LD      B,0
        CALL    BIOSETSE
        LD      BC,DIRBUF
        CALL    BIOSETDM
        CALL    BIOREAD
        RET     NZ
        LD      HL,DIRBUF
        XOR     A
        RET
DIR_NODRV:
        LD      A,1
        OR      A
        RET

; Return the first ordinary CP/M entry in the loaded record.
; Users 0..15 are ordinary entries. E5h is deleted; other user-byte values
; are reserved metadata and are skipped rather than rejected.
; Returns A=0/Z with HL at the 32-byte entry, or A=FFh/NZ if none exists.
DIR_FIRST:
        CALL    DIR_LD0
        RET     NZ
        LD      B,4
DIR_SCAN:
        LD      A,(HL)
        CP      16
        JR      C,DIR_FOUND
        LD      DE,32
        ADD     HL,DE
        DJNZ    DIR_SCAN
        LD      A,0FFH
        OR      A
        RET
DIR_FOUND:
        XOR     A
        RET

; Find an exact user/name match across all 128 directory entries.
; Input: A=user 0..15, DE=11-byte blank-padded CP/M name and extension.
; Attribute bits (bit 7) do not participate in the comparison.
; Return: A=0/Z and HL=entry, FFh/NZ if absent, or BIOS error/NZ.
DIR_FIND:
        CP      16
        JR      NC,DIR_NOTF
        LD      (DIR_USER),A
        LD      A,E
        LD      (DIR_NAMP),A
        LD      A,D
        LD      (DIR_NAMP+1),A
        XOR     A
        LD      (DIR_RECORD),A
DIR_FRECD:
        LD      A,(DIR_RECORD)
        LD      HL,DIR_RECS
        CP      (HL)
        JR      NC,DIR_NOTF
        LD      C,A
        CALL    DIR_LOAD
        RET     NZ
        LD      B,4
DIR_FENT:
        LD      A,(DIR_USER)
        CP      (HL)
        JR      NZ,DIR_FNEXT
        PUSH    BC
        PUSH    HL
        INC     HL
        LD      A,(DIR_NAMP)
        LD      E,A
        LD      A,(DIR_NAMP+1)
        LD      D,A
        LD      B,11
DIR_FCHAR:
        LD      A,(DE)
        AND     07FH
        LD      C,A
        LD      A,(HL)
        AND     07FH
        CP      C
        JR      NZ,DIR_FMISS
        INC     DE
        INC     HL
        DJNZ    DIR_FCHAR
        POP     HL
        POP     BC
        XOR     A
        RET
DIR_FMISS:
        POP     HL
        POP     BC
DIR_FNEXT:
        LD      DE,32
        ADD     HL,DE
        DJNZ    DIR_FENT
        LD      HL,DIR_RECORD
        INC     (HL)
        JR      DIR_FRECD
DIR_NOTF:
        LD      A,0FFH
        OR      A
        RET

; Activate an exact existing extent in a 33-byte sequential FCB.
; Input: A=user, DE=FCB. Return directory slot 0..3 or FFh if absent.
; This read-only slice supports EXM grouping and drive A/current-drive only.
DIR_OPEN:
        LD      (DIR_USER),A
        LD      (DIR_FCBP),DE
        LD      A,(DE)
        CP      2
        JP      NC,DIR_ONOTF
        LD      HL,(DIR_FCBP)
        LD      DE,12
        ADD     HL,DE
        LD      A,(HL)
        LD      (DIR_OEX),A
        INC     HL
        INC     HL
        LD      A,(HL)
        AND     03FH
        LD      (DIR_OS2),A
        LD      A,(DIR_EXM)
        CPL
        AND     01FH
        LD      (DIR_OMSK),A
        XOR     A
        LD      (DIR_RECORD),A
DIR_ORECD:
        LD      A,(DIR_RECORD)
        LD      HL,DIR_RECS
        CP      (HL)
        JP      NC,DIR_ONOTF
        LD      C,A
        CALL    DIR_LOAD
        JR      Z,DIR_OLOK
        SCF                     ; internal storage failure, not a slot result
        RET
DIR_OLOK:
        LD      B,4
        XOR     A
        LD      (DIR_SLOT),A
DIR_OENT:
        LD      A,(DIR_USER)
        CP      (HL)
        JP      NZ,DIR_ONEXT
        PUSH    BC
        PUSH    HL
        INC     HL
        LD      DE,(DIR_FCBP)
        INC     DE
        LD      B,11
DIR_OCHAR:
        LD      A,(DE)
        AND     07FH
        CP      '?'
        JR      Z,DIR_OCNEXT
        LD      C,A
        LD      A,(HL)
        AND     07FH
        CP      C
        JR      NZ,DIR_OMISS
DIR_OCNEXT:
        INC     DE
        INC     HL
        DJNZ    DIR_OCHAR
        POP     HL
        POP     BC
        PUSH    HL
        LD      DE,12
        ADD     HL,DE
        LD      A,(HL)
        AND     01FH
        LD      (DIR_ODX),A
        LD      C,A
        LD      A,(DIR_OMSK)
        AND     C
        LD      (DIR_ODG),A
        LD      C,A
        LD      A,(DIR_OMSK)
        LD      C,A
        LD      A,(DIR_OEX)
        AND     C
        LD      C,A
        LD      A,(DIR_ODG)
        CP      C
        JR      NZ,DIR_OCTLN
        INC     HL
        INC     HL
        LD      A,(HL)
        AND     03FH
        LD      C,A
        LD      A,(DIR_OS2)
        CP      C
        JR      NZ,DIR_OCTLN
        INC     HL              ; RC must remain in the documented 0..128 range
        LD      A,(HL)
        CP      129
        JR      NC,DIR_OCTLN
        LD      (DIR_ORC),A
        JR      DIR_OFOUND
DIR_OCTLN:
        POP     HL
        JR      DIR_ONEXT
DIR_OMISS:
        POP     HL
        POP     BC
        JR      DIR_ONEXT
DIR_OFOUND:
        POP     HL
        INC     HL              ; directory user byte is not FCB drive byte
        LD      DE,(DIR_FCBP)
        INC     DE
        LD      BC,31
        LDIR                    ; FCB CR at byte 32 remains caller-owned
        LD      HL,(DIR_FCBP)
        LD      DE,12
        ADD     HL,DE
        LD      A,(DIR_OEX)
        LD      (HL),A          ; restore the caller's requested logical extent
        LD      A,(DIR_ODX)
        LD      C,A
        LD      A,(DIR_OEX)
        AND     01FH
        CP      C
        JR      Z,DIR_ORCDR
        JR      C,DIR_ORCFU
        XOR     A               ; requested subextent is beyond directory end
        JR      DIR_ORCST
DIR_ORCFU:
        LD      A,128           ; an earlier subextent in the group is full
        JR      DIR_ORCST
DIR_ORCDR:
        LD      A,(DIR_ORC)
DIR_ORCST:
        LD      DE,3
        ADD     HL,DE           ; FCB RC at byte 15
        LD      (HL),A
        LD      A,(DIR_SLOT)
        OR      A
        RET
DIR_ONEXT:
        LD      DE,32
        ADD     HL,DE
        LD      A,(DIR_SLOT)
        INC     A
        LD      (DIR_SLOT),A
        DEC     B
        JP      NZ,DIR_OENT
        LD      HL,DIR_RECORD
        INC     (HL)
        JP      DIR_ORECD
DIR_ONOTF:
        LD      A,0FFH
        OR      A
        RET

; Reconstruct file-owned allocation bits from all live ordinary extents.
; MM 790K has DSM>255, hence eight 16-bit block numbers at entry bytes 16..31.
DIR_ALSCN:
        XOR     A
        LD      (DIR_RECORD),A
DIR_ARECD:
        LD      A,(DIR_RECORD)
        LD      HL,DIR_RECS
        CP      (HL)
        JR      NC,DIR_ADONE
        LD      C,A
        CALL    DIR_LDOK
        RET     NZ
        LD      B,4
DIR_AENT:
        LD      A,(HL)
        CP      16
        JR      NC,DIR_ANEXT
        PUSH    BC
        PUSH    HL
        LD      DE,16
        ADD     HL,DE
        LD      A,(DIR_DSM+1)
        OR      A
        JR      Z,DIR_8BIT
        LD      B,8
DIR_ABLOCK:
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     HL
        LD      A,D
        OR      E
        JR      Z,DIR_ABNEXT
        CALL    DIR_AMARK
        JR      NZ,DIR_ABAD
DIR_ABNEXT:
        DJNZ    DIR_ABLOCK
        JR      DIR_AUNW
DIR_8BIT:
        LD      B,16
DIR_8LOOP:
        LD      E,(HL)
        INC     HL
        LD      D,0
        LD      A,E
        OR      A
        JR      Z,DIR_8NEXT
        CALL    DIR_AMARK
        JR      NZ,DIR_ABAD
DIR_8NEXT:
        DJNZ    DIR_8LOOP
DIR_AUNW:
        POP     HL
        POP     BC
DIR_ANEXT:
        LD      DE,32
        ADD     HL,DE
        DJNZ    DIR_AENT
        LD      HL,DIR_RECORD
        INC     (HL)
        JR      DIR_ARECD
DIR_ABAD:
        POP     HL
        POP     BC
        RET
DIR_ADONE:
        XOR     A
        RET

; Mark 16-bit allocation block DE. Zero is an unused slot. Out-of-range block
; numbers fail login instead of indexing beyond the BIOS allocation vector.
DIR_AMARK:
        PUSH    BC
        PUSH    DE
        PUSH    HL
        LD      HL,(DIR_DSM)
        LD      A,D
        CP      H
        JR      C,DIR_AMVAL
        JR      NZ,DIR_AMBAD
        LD      A,E
        CP      L
        JR      C,DIR_AMVAL
        JR      Z,DIR_AMVAL
DIR_AMBAD:
        LD      A,1
        OR      A
        JR      DIR_AMRET
DIR_AMVAL:
        LD      A,E
        AND     7
        LD      C,A
        LD      H,D
        LD      L,E
        SRL     H
        RR      L
        SRL     H
        RR      L
        SRL     H
        RR      L
        LD      DE,(DIR_ALVP)
        ADD     HL,DE
        PUSH    HL
        LD      B,0
        LD      HL,DIR_AMASK
        ADD     HL,BC
        LD      A,(HL)
        POP     HL
        OR      (HL)
        LD      (HL),A
        XOR     A
DIR_AMRET:
        POP     HL
        POP     DE
        POP     BC
        RET

DIR_AMASK:
        DB      080H,040H,020H,010H,008H,004H,002H,001H

DIR_USER:
        DB      0
DIR_RECORD:
        DB      0
DIR_NAMP:
        DW      0
DIR_VALID:
        DB      0
DIR_DRIVE:
        DB      0
DIR_DPH:
        DW      0
DIR_DPB:
        DW      0
DIR_SPT:
        DW      0
DIR_DSM:
        DW      0
DIR_EXM:
        DB      0
DIR_DRM:
        DW      0
DIR_OFF:
        DW      0
DIR_RECS:
        DW      0
DIR_ALVP:
        DW      0
DIR_AL0:
        DB      0
DIR_AL1:
        DB      0
DIR_FCBP:
        DW      0
DIR_OEX:
        DB      0
DIR_OMSK:
        DB      0
DIR_ODX:
        DB      0
DIR_ODG:
        DB      0
DIR_ORC:
        DB      0
DIR_OS2:
        DB      0
DIR_SLOT:
        DB      0
DIR_SDMA:
        DW      0
