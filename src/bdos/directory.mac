; BetterCP/M first filesystem-facing directory reader.
;
; This is an independently buildable System Services component, not a BIOS
; extension.  Its placement and the BIOS address are provisional bring-up
; values.  It deliberately reaches disk only through the CP/M BIOS vectors.

DIRBASE         EQU     0E800H
; Patch 2026-09-01: DIRBUF was E900H through specification 14, then EA00H
; for specification 15. Allocation reconstruction moved it intact again;
; the old placements remain recorded rather than hidden by the patch.
DIRBUF          EQU     0EC00H
BIOSBASE        EQU     0F000H
BIOSELDS        EQU     BIOSBASE+27
BIOSETTR        EQU     BIOSBASE+30
BIOSETSE        EQU     BIOSBASE+33
BIOSETDM        EQU     BIOSBASE+36
BIOREAD         EQU     BIOSBASE+39

        CSEG
        .PHASE  DIRBASE

; Provisional internal service vectors keep callers independent of routine size.
DIRSERV:
        JP      DIR_LD0
        JP      DIR_FIRST
        JP      DIR_LOAD
        JP      DIR_FIND
        JP      DIR_LOGIN
        JP      DIR_INVAL
        JP      DIR_OPEN

; Establish drive state from its DPH and DPB. Input C=drive.
; The allocation vector is cleared, seeded from AL0/AL1, and reconstructed
; from every live ordinary directory extent before login becomes valid.
DIR_LOGIN:
        XOR     A
        LD      (DIR_VALID),A
        LD      A,C
        LD      (DIR_DRIVE),A
        CALL    BIOSELDS
        LD      A,H
        OR      L
        JP      Z,DIR_NODRV
        LD      (DIR_DPH),HL
        LD      DE,10
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (DIR_DPB),DE
        EX      DE,HL
        LD      E,(HL)          ; SPT
        INC     HL
        LD      D,(HL)
        LD      (DIR_SPT),DE
        LD      A,D             ; current divider requires 1..255 records/track
        OR      A
        JP      NZ,DIR_BADFMT
        LD      A,E
        OR      A
        JP      Z,DIR_BADFMT
        LD      DE,3
        ADD     HL,DE           ; EXM at DPB+4
        LD      A,(HL)
        LD      (DIR_EXM),A
        INC     HL              ; DSM at DPB+5
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (DIR_DSM),DE
        INC     HL              ; DRM at DPB+7
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (DIR_DRM),DE
        INC     HL              ; AL0/AL1 at DPB+9
        LD      A,(HL)
        LD      (DIR_AL0),A
        INC     HL
        LD      A,(HL)
        LD      (DIR_AL1),A
        LD      DE,3
        ADD     HL,DE           ; OFF at DPB+13
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (DIR_OFF),DE

        LD      HL,(DIR_DRM)    ; ceil((DRM+1)/4) directory records
        LD      DE,4
        ADD     HL,DE
        SRL     H
        RR      L
        SRL     H
        RR      L
        LD      (DIR_RECS),HL
        LD      A,H             ; current scanner uses an 8-bit record index
        OR      A
        JR      NZ,DIR_BADFMT

        LD      HL,(DIR_DPH)
        LD      DE,14
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        LD      (DIR_ALVP),DE
        LD      HL,(DIR_DSM)    ; ceil((DSM+1)/8) allocation bytes
        LD      DE,8
        ADD     HL,DE
        SRL     H
        RR      L
        SRL     H
        RR      L
        SRL     H
        RR      L
        LD      A,H
        OR      A
        JR      NZ,DIR_BADFMT
        LD      B,L
        LD      HL,(DIR_ALVP)
        XOR     A
DIR_ACLR:
        LD      (HL),A
        INC     HL
        DJNZ    DIR_ACLR
        LD      HL,(DIR_ALVP)
        LD      A,(DIR_AL0)
        LD      (HL),A
        INC     HL
        LD      A,(DIR_AL1)
        LD      (HL),A
        CALL    DIR_ALSCN
        RET     NZ
        LD      A,0FFH
        LD      (DIR_VALID),A
        XOR     A
        RET
DIR_BADFMT:
        LD      A,1
        OR      A
        RET

DIR_INVAL:
        XOR     A
        LD      (DIR_VALID),A
        RET

; Read the first 128-byte directory record for drive A.
; Returns A=0/Z and HL=DIRBUF, or the BIOS/nonexistent-drive error in A/NZ.
DIR_LD0:
        LD      C,0
        JP      DIR_LOAD

; Read directory record C (0..31) for the current 128-entry MM 790K format.
; The format-specific bounds belong here, above the geometry-neutral BIOS.
DIR_LOAD:
        LD      A,(DIR_VALID)
        OR      A
        JR      NZ,DIR_LDOK
        PUSH    BC
        LD      C,0
        CALL    DIR_LOGIN
        POP     BC
        RET     NZ
DIR_LDOK:
        LD      A,C
        LD      HL,DIR_RECS
        CP      (HL)
        JR      NC,DIR_NODRV
        LD      (DIR_RECORD),A
        LD      A,(DIR_DRIVE)
        LD      C,A
        CALL    BIOSELDS
        LD      A,H
        OR      L
        JR      Z,DIR_NODRV
        LD      BC,(DIR_OFF)
        LD      A,(DIR_RECORD)
DIR_DIVSP:
        LD      HL,DIR_SPT
        CP      (HL)
        JR      C,DIR_DIVDN
        SUB     (HL)
        INC     BC
        JR      DIR_DIVSP
DIR_DIVDN:
        PUSH    AF
        CALL    BIOSETTR
        POP     AF
        LD      C,A
        LD      B,0
        CALL    BIOSETSE
        LD      BC,DIRBUF
        CALL    BIOSETDM
        CALL    BIOREAD
        RET     NZ
        LD      HL,DIRBUF
        XOR     A
        RET
DIR_NODRV:
        LD      A,1
        OR      A
        RET

; Return the first ordinary CP/M entry in the loaded record.
; Users 0..15 are ordinary entries. E5h is deleted; other user-byte values
; are reserved metadata and are skipped rather than rejected.
; Returns A=0/Z with HL at the 32-byte entry, or A=FFh/NZ if none exists.
DIR_FIRST:
        CALL    DIR_LD0
        RET     NZ
        LD      B,4
DIR_SCAN:
        LD      A,(HL)
        CP      16
        JR      C,DIR_FOUND
        LD      DE,32
        ADD     HL,DE
        DJNZ    DIR_SCAN
        LD      A,0FFH
        OR      A
        RET
DIR_FOUND:
        XOR     A
        RET

; Find an exact user/name match across all 128 directory entries.
; Input: A=user 0..15, DE=11-byte blank-padded CP/M name and extension.
; Attribute bits (bit 7) do not participate in the comparison.
; Return: A=0/Z and HL=entry, FFh/NZ if absent, or BIOS error/NZ.
DIR_FIND:
        CP      16
        JR      NC,DIR_NOTF
        LD      (DIR_USER),A
        LD      A,E
        LD      (DIR_NAMP),A
        LD      A,D
        LD      (DIR_NAMP+1),A
        XOR     A
        LD      (DIR_RECORD),A
DIR_FRECD:
        LD      A,(DIR_RECORD)
        LD      HL,DIR_RECS
        CP      (HL)
        JR      NC,DIR_NOTF
        LD      C,A
        CALL    DIR_LOAD
        RET     NZ
        LD      B,4
DIR_FENT:
        LD      A,(DIR_USER)
        CP      (HL)
        JR      NZ,DIR_FNEXT
        PUSH    BC
        PUSH    HL
        INC     HL
        LD      A,(DIR_NAMP)
        LD      E,A
        LD      A,(DIR_NAMP+1)
        LD      D,A
        LD      B,11
DIR_FCHAR:
        LD      A,(DE)
        AND     07FH
        LD      C,A
        LD      A,(HL)
        AND     07FH
        CP      C
        JR      NZ,DIR_FMISS
        INC     DE
        INC     HL
        DJNZ    DIR_FCHAR
        POP     HL
        POP     BC
        XOR     A
        RET
DIR_FMISS:
        POP     HL
        POP     BC
DIR_FNEXT:
        LD      DE,32
        ADD     HL,DE
        DJNZ    DIR_FENT
        LD      HL,DIR_RECORD
        INC     (HL)
        JR      DIR_FRECD
DIR_NOTF:
        LD      A,0FFH
        OR      A
        RET

; Activate an exact existing extent in a 33-byte sequential FCB.
; Input: A=user, DE=FCB. Return directory slot 0..3 or FFh if absent.
; This first read-only slice supports EXM=0 and drive A/current-drive only.
DIR_OPEN:
        LD      (DIR_USER),A
        LD      (DIR_FCBP),DE
        LD      A,(DE)
        CP      2
        JP      NC,DIR_ONOTF
        LD      HL,(DIR_FCBP)
        LD      DE,12
        ADD     HL,DE
        LD      A,(HL)
        AND     01FH
        LD      (DIR_OEX),A
        INC     HL
        INC     HL
        LD      A,(HL)
        AND     03FH
        LD      (DIR_OS2),A
        LD      A,(DIR_EXM)
        OR      A
        JP      NZ,DIR_ONOTF
        XOR     A
        LD      (DIR_RECORD),A
DIR_ORECD:
        LD      A,(DIR_RECORD)
        LD      HL,DIR_RECS
        CP      (HL)
        JP      NC,DIR_ONOTF
        LD      C,A
        CALL    DIR_LOAD
        RET     NZ
        LD      B,4
        XOR     A
        LD      (DIR_SLOT),A
DIR_OENT:
        LD      A,(DIR_USER)
        CP      (HL)
        JR      NZ,DIR_ONEXT
        PUSH    BC
        PUSH    HL
        INC     HL
        LD      DE,(DIR_FCBP)
        INC     DE
        LD      B,11
DIR_OCHAR:
        LD      A,(DE)
        AND     07FH
        LD      C,A
        LD      A,(HL)
        AND     07FH
        CP      C
        JR      NZ,DIR_OMISS
        INC     DE
        INC     HL
        DJNZ    DIR_OCHAR
        POP     HL
        POP     BC
        PUSH    HL
        LD      DE,12
        ADD     HL,DE
        LD      A,(HL)
        AND     01FH
        LD      C,A
        LD      A,(DIR_OEX)
        CP      C
        JR      NZ,DIR_OCTLN
        INC     HL
        INC     HL
        LD      A,(HL)
        AND     03FH
        LD      C,A
        LD      A,(DIR_OS2)
        CP      C
        JR      NZ,DIR_OCTLN
        INC     HL              ; RC must remain in the documented 0..128 range
        LD      A,(HL)
        CP      129
        JR      C,DIR_OFOUND
DIR_OCTLN:
        POP     HL
        JR      DIR_ONEXT
DIR_OMISS:
        POP     HL
        POP     BC
        JR      DIR_ONEXT
DIR_OFOUND:
        POP     HL
        INC     HL              ; directory user byte is not FCB drive byte
        LD      DE,(DIR_FCBP)
        INC     DE
        LD      BC,31
        LDIR                    ; FCB CR at byte 32 remains caller-owned
        LD      A,(DIR_SLOT)
        OR      A
        RET
DIR_ONEXT:
        LD      DE,32
        ADD     HL,DE
        LD      A,(DIR_SLOT)
        INC     A
        LD      (DIR_SLOT),A
        DJNZ    DIR_OENT
        LD      HL,DIR_RECORD
        INC     (HL)
        JP      DIR_ORECD
DIR_ONOTF:
        LD      A,0FFH
        OR      A
        RET

; Reconstruct file-owned allocation bits from all live ordinary extents.
; MM 790K has DSM>255, hence eight 16-bit block numbers at entry bytes 16..31.
DIR_ALSCN:
        XOR     A
        LD      (DIR_RECORD),A
DIR_ARECD:
        LD      A,(DIR_RECORD)
        LD      HL,DIR_RECS
        CP      (HL)
        JR      NC,DIR_ADONE
        LD      C,A
        CALL    DIR_LDOK
        RET     NZ
        LD      B,4
DIR_AENT:
        LD      A,(HL)
        CP      16
        JR      NC,DIR_ANEXT
        PUSH    BC
        PUSH    HL
        LD      DE,16
        ADD     HL,DE
        LD      A,(DIR_DSM+1)
        OR      A
        JR      Z,DIR_8BIT
        LD      B,8
DIR_ABLOCK:
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     HL
        LD      A,D
        OR      E
        JR      Z,DIR_ABNEXT
        CALL    DIR_AMARK
        JR      NZ,DIR_ABAD
DIR_ABNEXT:
        DJNZ    DIR_ABLOCK
        JR      DIR_AUNW
DIR_8BIT:
        LD      B,16
DIR_8LOOP:
        LD      E,(HL)
        INC     HL
        LD      D,0
        LD      A,E
        OR      A
        JR      Z,DIR_8NEXT
        CALL    DIR_AMARK
        JR      NZ,DIR_ABAD
DIR_8NEXT:
        DJNZ    DIR_8LOOP
DIR_AUNW:
        POP     HL
        POP     BC
DIR_ANEXT:
        LD      DE,32
        ADD     HL,DE
        DJNZ    DIR_AENT
        LD      HL,DIR_RECORD
        INC     (HL)
        JR      DIR_ARECD
DIR_ABAD:
        POP     HL
        POP     BC
        RET
DIR_ADONE:
        XOR     A
        RET

; Mark 16-bit allocation block DE. Zero is an unused slot. Out-of-range block
; numbers fail login instead of indexing beyond the BIOS allocation vector.
DIR_AMARK:
        PUSH    BC
        PUSH    DE
        PUSH    HL
        LD      HL,(DIR_DSM)
        LD      A,D
        CP      H
        JR      C,DIR_AMVAL
        JR      NZ,DIR_AMBAD
        LD      A,E
        CP      L
        JR      C,DIR_AMVAL
        JR      Z,DIR_AMVAL
DIR_AMBAD:
        LD      A,1
        OR      A
        JR      DIR_AMRET
DIR_AMVAL:
        LD      A,E
        AND     7
        LD      C,A
        LD      H,D
        LD      L,E
        SRL     H
        RR      L
        SRL     H
        RR      L
        SRL     H
        RR      L
        LD      DE,(DIR_ALVP)
        ADD     HL,DE
        PUSH    HL
        LD      B,0
        LD      HL,DIR_AMASK
        ADD     HL,BC
        LD      A,(HL)
        POP     HL
        OR      (HL)
        LD      (HL),A
        XOR     A
DIR_AMRET:
        POP     HL
        POP     DE
        POP     BC
        RET

DIR_AMASK:
        DB      080H,040H,020H,010H,008H,004H,002H,001H

DIR_USER:
        DB      0
DIR_RECORD:
        DB      0
DIR_NAMP:
        DW      0
DIR_VALID:
        DB      0
DIR_DRIVE:
        DB      0
DIR_DPH:
        DW      0
DIR_DPB:
        DW      0
DIR_SPT:
        DW      0
DIR_DSM:
        DW      0
DIR_EXM:
        DB      0
DIR_DRM:
        DW      0
DIR_OFF:
        DW      0
DIR_RECS:
        DW      0
DIR_ALVP:
        DW      0
DIR_AL0:
        DB      0
DIR_AL1:
        DB      0
DIR_FCBP:
        DW      0
DIR_OEX:
        DB      0
DIR_OS2:
        DB      0
DIR_SLOT:
        DB      0

        .DEPHASE
        END
