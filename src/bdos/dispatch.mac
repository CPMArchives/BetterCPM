; BetterCP/M initial CP/M-compatible BDOS dispatcher.
;
; Provisional resident placement. Page-zero address 0005h is not installed yet.

BDOSBASE        EQU     0E600H
DIROPEN         EQU     0E812H  ; seventh directory-service vector
DIRLOGIN        EQU     0E80CH  ; fifth directory-service vector
DIRGALV         EQU     0E815H  ; eighth directory-service vector
DIRGDPB         EQU     0E818H  ; ninth directory-service vector
DIRSFIR         EQU     0E81BH  ; tenth directory-service vector
DIRSNXT         EQU     0E81EH  ; eleventh directory-service vector
DIRCLOS         EQU     0E821H  ; twelfth directory-service vector

        CSEG
        .PHASE  BDOSBASE

BDOS:
        LD      A,C
        LD      (BDOS_FUNC),A
        LD      (BDOS_PARM),DE
        LD      (BDOS_OLDSP),SP
        LD      SP,BDOS_STKTOP
        CP      12
        JP      Z,BDOS_VERS
        CP      13
        JP      Z,BDOS_RESET
        CP      14
        JP      Z,BDOS_SELDR
        CP      15
        JP      Z,BDOS_OPEN
        CP      16
        JP      Z,BDOS_CLOSE
        CP      17
        JP      Z,BDOS_SFIR
        CP      18
        JP      Z,BDOS_SNXT
        CP      24
        JP      Z,BDOS_LOGV
        CP      25
        JP      Z,BDOS_GETDR
        CP      26
        JP      Z,BDOS_STDMA
        CP      27
        JP      Z,BDOS_ALVP
        CP      28
        JP      Z,BDOS_WRPRO
        CP      29
        JP      Z,BDOS_ROV
        CP      31
        JP      Z,BDOS_DPBP
        CP      32
        JP      Z,BF_USER
        LD      A,0FFH          ; unsupported returning function
        JP      BDOS_RETURN

BDOS_VERS:
        LD      A,022H          ; CP/M 2.2 identity, returned as HL=0022h
        JP      BDOS_RETURN

BDOS_RESET:
        LD      C,0
        CALL    DIRLOGIN
        JR      NZ,BDOS_BADRV
        XOR     A
        LD      (BDOS_DRIVE),A  ; reset selects A but preserves current user
        LD      HL,0080H
        LD      (BDOS_DMA),HL
        LD      HL,0001H        ; after reset, only drive A is logged
        LD      (STATE_LV),HL
        LD      HL,0000H        ; reset clears software write protection
        LD      (STATE_RO),HL
        XOR     A               ; function 13 has no specified result
        JP      BDOS_RETURN

BDOS_SELDR:
        LD      A,E
        CP      1               ; current provisional BIOS exposes A only
        JR      NC,BDOS_BADRV
        LD      C,A
        CALL    DIRLOGIN        ; commit BDOS state only after valid login
        JR      NZ,BDOS_BADRV
        LD      HL,(BDOS_PARM)
        LD      A,L
        LD      (BDOS_DRIVE),A
        LD      HL,0001H        ; only A exists in this provisional BIOS
        LD      (STATE_LV),HL
        XOR     A               ; function 14 has no defined normal result
        JP      BDOS_RETURN
BDOS_BADRV:
        LD      A,0FFH          ; deliberate provisional failure result
        JP      BDOS_RETURN

BDOS_GETDR:
        LD      A,(BDOS_DRIVE)
        JP      BDOS_RETURN

BDOS_LOGV:
        LD      HL,(STATE_LV)
        JP      RET_HL

BDOS_STDMA:
        LD      HL,(BDOS_PARM)
        LD      (BDOS_DMA),HL
        XOR     A               ; function 26 has no specified result
        JP      BDOS_RETURN

BDOS_ALVP:
        CALL    DIRGALV
        JR      NZ,BDOS_PTRER
        JP      RET_HL

BDOS_DPBP:
        CALL    DIRGDPB
        JR      NZ,BDOS_PTRER
        JP      RET_HL
BDOS_PTRER:
        LD      A,0FFH
        JP      BDOS_RETURN

BDOS_WRPRO:
        LD      A,(STATE_RO)    ; only current drive A is available today
        OR      01H
        LD      (STATE_RO),A
        XOR     A               ; function 28 has no specified result
        JR      BDOS_RETURN

BDOS_ROV:
        LD      HL,(STATE_RO)
        JR      RET_HL

BF_USER:
        LD      A,E
        CP      0FFH
        JR      Z,BF_GETU
        AND     01FH            ; required CP/M 2.2 modulo-32 selection
        LD      (BDOS_USER),A
        XOR     A               ; set-form result is not guaranteed
        JR      BDOS_RETURN
BF_GETU:
        LD      A,(BDOS_USER)
        JR      BDOS_RETURN

BDOS_OPEN:
        LD      DE,(BDOS_PARM)
        LD      HL,14
        ADD     HL,DE
        LD      (HL),0          ; CP/M caller supplies S2 zero on Open
        LD      A,(BDOS_USER)
        CALL    DIROPEN
        JR      NC,BDOS_RETURN
        LD      A,0FFH          ; provisional storage-error presentation
; Patch 2026-09-01: RET_HL was inserted below for function 24. Keep this
; explicit branch so Open errors cannot fall into the new 16-bit return path.
        JR      BDOS_RETURN

BDOS_CLOSE:
        LD      DE,(BDOS_PARM)
        LD      A,(STATE_RO)
        AND     01H             ; current implementation has drive A only
        LD      B,A
        LD      A,(BDOS_USER)
        CALL    DIRCLOS
        JR      NC,BDOS_RETURN
        LD      A,0FFH          ; provisional storage-error presentation
        JP      BDOS_RETURN

BDOS_SFIR:
        LD      DE,(BDOS_PARM)
        LD      BC,(BDOS_DMA)
        LD      A,(BDOS_USER)
        CALL    DIRSFIR
        JR      BF_SRET

BDOS_SNXT:
        LD      BC,(BDOS_DMA)
        CALL    DIRSNXT
BF_SRET:
        JR      NC,BDOS_RETURN
        LD      A,0FFH          ; provisional storage-error presentation
        JP      BDOS_RETURN

; CP/M normal-return aliases: A=L and B=H.
RET_HL:
        LD      A,L
        LD      B,H
        JR      RET_SP
BDOS_RETURN:
        LD      L,A
        LD      H,0
        LD      B,H
        LD      A,L
RET_SP:
        LD      SP,(BDOS_OLDSP)
        RET

BDOS_FUNC:
        DB      0
BDOS_PARM:
        DW      0
BDOS_OLDSP:
        DW      0
BDOS_USER:
        DB      0               ; initial current user
BDOS_DRIVE:
        DB      0               ; initial current/default drive A
BDOS_DMA:
        DW      0080H           ; CP/M startup DMA selection
STATE_LV:
        DW      0001H           ; gateway publishes BDOS only after A login
STATE_RO:
        DW      0000H           ; transient software read-only drive vector

; Patch 2026-09-01: the first public-call boundary receives its own stack now,
; before more BDOS functions deepen the call graph. The exact size and address
; remain provisional; only balanced restoration is compatibility-visible.
BDOS_STACK:
        REPT    64
        DB      0
        ENDM
BDOS_STKTOP:

        .DEPHASE
        END
