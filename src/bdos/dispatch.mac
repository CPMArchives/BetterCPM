; BetterCP/M initial CP/M-compatible BDOS dispatcher.
;
; Provisional resident placement. Page-zero address 0005h is not installed yet.

BDOSBASE        EQU     0C100H
BIOCONST        EQU     0EF06H  ; CP/M BIOS console-status vector
BIOCONIN        EQU     0EF09H  ; CP/M BIOS console-input vector
BIOCONOT        EQU     0EF0CH  ; CP/M BIOS console-output vector
BIOCURSOR       EQU     0EF36H  ; BetterCP/M private cursor-character vector
BIOLIST         EQU     0EF0FH  ; CP/M BIOS list-output vector
BIOPUNCH        EQU     0EF12H  ; CP/M BIOS punch-output vector
BIOREADR        EQU     0EF15H  ; CP/M BIOS reader-input vector
BIOWBOOT        EQU     0EF03H  ; CP/M BIOS warm-boot vector
DIROPEN         EQU     0D612H  ; seventh directory-service vector
DIRINVAL        EQU     0D60FH  ; sixth directory-service vector
DIRLOGIN        EQU     0D60CH  ; fifth directory-service vector
DIRGALV         EQU     0D615H  ; eighth directory-service vector
DIRGDPB         EQU     0D618H  ; ninth directory-service vector
DIRSFIR         EQU     0D61BH  ; tenth directory-service vector
DIRSNXT         EQU     0D61EH  ; eleventh directory-service vector
DIRCLOS         EQU     0D621H  ; twelfth directory-service vector
DIRREAD         EQU     0D624H  ; thirteenth directory-service vector
DIRWRITE        EQU     0D627H  ; fourteenth directory-service vector
DIRMAKE         EQU     0D62AH  ; fifteenth directory-service vector
DIRDELETE       EQU     0D62DH  ; sixteenth directory-service vector
DIRRENAME       EQU     0D630H  ; seventeenth directory-service vector
DIRATTR         EQU     0D633H  ; eighteenth directory-service vector
DIRSIZE         EQU     0D636H  ; nineteenth directory-service vector
DIRRREAD        EQU     0D639H  ; twentieth directory-service vector
DIRRWRIT        EQU     0D63CH  ; twenty-first directory-service vector
DIRRZERO        EQU     0D63FH  ; twenty-second directory-service vector
DIRSELECT       EQU     0D642H  ; select/reuse a logical drive context
CPTCOUNT        EQU     0C094H  ; active CPX reconstruction profile
CPTFLAGS        EQU     0C095H  ; known-module membership bits
CPTABLE         EQU     0C096H
RSXCONTROL      EQU     0D100H

        CSEG
        .PHASE  BDOSBASE

BDOS:
        LD      A,C
        LD      (BDOS_FUNC),A
        LD      (BDOS_PARM),DE
        LD      (BDOS_OLDSP),SP
        LD      SP,BDOS_STKTOP
        OR      A
        JP      Z,BIOWBOOT      ; Function 0 terminates through warm start
        CP      1
        JP      Z,BF_CONIN
        CP      2
        JP      Z,BF_CONOUT
        CP      3
        JP      Z,BF_READER
        CP      4
        JP      Z,BF_PUNCH
        CP      5
        JP      Z,BF_LIST
        CP      6
        JP      Z,BF_DCIO
        CP      7
        JP      Z,BF_GETIO
        CP      8
        JP      Z,BF_SETIO
        CP      9
        JP      Z,BF_PRINT
        CP      10
        JP      Z,BF_READLN
        CP      11
        JP      Z,BF_CONST
        CP      12
        JP      Z,BDOS_VERS
        CP      13
        JP      Z,BDOS_RESET
        CP      14
        JP      Z,BDOS_SELDR
        CP      15
        JP      Z,BDOS_OPEN
        CP      16
        JP      Z,BDOS_CLOSE
        CP      17
        JP      Z,BDOS_SFIR
        CP      18
        JP      Z,BDOS_SNXT
        CP      19
        JP      Z,BDOS_DELETE
        CP      20
        JP      Z,BDOS_READ
        CP      21
        JP      Z,BDOS_WRITE
        CP      22
        JP      Z,BDOS_MAKE
        CP      23
        JP      Z,BDOS_RENAME
        CP      24
        JP      Z,BDOS_LOGV
        CP      25
        JP      Z,BDOS_GETDR
        CP      26
        JP      Z,BDOS_STDMA
        CP      27
        JP      Z,BDOS_ALVP
        CP      28
        JP      Z,BDOS_WRPRO
        CP      29
        JP      Z,BDOS_ROV
        CP      30
        JP      Z,BDOS_ATTR
        CP      31
        JP      Z,BDOS_DPBP
        CP      32
        JP      Z,BF_USER
        CP      33
        JP      Z,BF_RREAD
        CP      34
        JP      Z,BF_RWRIT
        CP      35
        JP      Z,BDOS_SIZE
        CP      36
        JP      Z,BDOS_SETRR
        CP      37
        JP      Z,BF_RSTDR
        CP      40
        JP      Z,BF_RZERO
        CP      200             ; provisional BetterCP/M CPX control service
        JP      Z,BF_CPXCTL
        CP      202             ; provisional BetterCP/M RSX control service
        JP      Z,BF_RSXCTL
        CP      204             ; optional reverse-video cursor character
        JP      Z,BF_CURSOR
        CP      205             ; CCP access to shared printer-echo toggle
        JP      Z,BF_CCPPRN
        CP      206             ; immutable subsystem-version descriptor
        JP      Z,BF_VERSION
; Patch 2026-09-01: selectors above Function 40 conventionally return zero.
        XOR     A
        JP      BDOS_RETURN

BF_READER:
        CALL    BIOREADR
        JP      BDOS_RETURN
BF_PUNCH:
        LD      A,E
        LD      C,A
        CALL    BIOPUNCH
        XOR     A
        JP      BDOS_RETURN
BF_LIST:
        LD      A,E
        LD      C,A
        CALL    BIOLIST
        XOR     A
        JP      BDOS_RETURN
BF_GETIO:
        LD      A,(0003H)       ; conventional CP/M page-zero I/O byte
        JP      BDOS_RETURN
BF_SETIO:
        LD      A,E
        LD      (0003H),A       ; keep direct and BDOS access to IOBYTE coherent
        XOR     A               ; deterministic result for an output operation
        JP      BDOS_RETURN

; BetterCP/M Function 200, provisional CPX profile control. D selects the
; known module (1 BASIC, 2 HELLO); E=0 queries it, E=1 loads it, and E=2
; unloads it. Canonical reconstruction order is BASIC followed by HELLO.
BF_CPXCTL:
        LD      A,D
        CP      1
        JR      Z,BCX_BASIC
        CP      2
        JR      NZ,BCX_BAD
        LD      A,2
        JR      BCX_MADE
BCX_BASIC:
        LD      A,1
BCX_MADE:
        LD      (BCX_MVAL),A
        LD      A,E
        OR      A
        JR      Z,BCX_QUERY
        CP      1
        JR      Z,BCX_LOAD
        CP      2
        JR      Z,BCX_UNLOAD
        LD      A,0FFH
        JP      BDOS_RETURN
BCX_QUERY:
        LD      A,(BCX_MVAL)
        LD      B,A
        LD      A,(CPTFLAGS)
        AND     B
        JP      Z,BDOS_RETURN
        LD      A,1
        JP      BDOS_RETURN
BCX_LOAD:
        LD      A,(BCX_MVAL)
        LD      B,A
        LD      A,(CPTFLAGS)
        OR      B
        LD      (CPTFLAGS),A
        JR      BCX_REBUILD
BCX_UNLOAD:
        LD      A,(BCX_MVAL)
        CPL
        LD      B,A
        LD      A,(CPTFLAGS)
        AND     B
        LD      (CPTFLAGS),A
BCX_REBUILD:
        XOR     A
        LD      (CPTCOUNT),A
        LD      DE,CPTABLE
        LD      A,(CPTFLAGS)
        AND     1
        JR      Z,BCX_RHELLO
        LD      HL,BCX_NBASIC
        LD      BC,8
        LDIR
        LD      A,(CPTCOUNT)
        INC     A
        LD      (CPTCOUNT),A
BCX_RHELLO:
        LD      A,(CPTFLAGS)
        AND     2
        JR      Z,BCX_RDONE
        LD      HL,BCX_NHELLO
        LD      BC,8
        LDIR
        LD      A,(CPTCOUNT)
        INC     A
        LD      (CPTCOUNT),A
BCX_RDONE:
        XOR     A
        JP      BDOS_RETURN
BCX_BAD:
        LD      A,0FFH
        JP      BDOS_RETURN

BCX_NBASIC:    DB      'BASIC   '
BCX_NHELLO:    DB      'HELLO   '

BF_RSXCTL:
        LD      DE,(BDOS_PARM)
        CALL    RSXCONTROL
        JP      BDOS_RETURN

; BetterCP/M Function 206 returns the protected, versioned descriptor generated
; from the normative subsystem matrix. Consumers must validate BV/version 1.
BF_VERSION:
        LD      HL,BCV_DESC
        JP      RET_HL

; Print the $-terminated string at DE through the same cooked path as
; Function 2. Preserve the scan pointer because tab expansion uses HL.
BF_PRINT:
        LD      HL,(BDOS_PARM)
BF_PRLOOP:
        LD      A,(HL)
        CP      '$'
        JR      Z,BF_PREND
        INC     HL
        PUSH    HL
        CALL    BF_COCHAR
        POP     HL
        JR      BF_PRLOOP
BF_PREND:
        XOR     A
        JP      BDOS_RETURN

; Counted-buffer line editor. The buffer is [maximum][count][data...].
; Editing is relative to the logical column at which the caller entered.
BF_READLN:
        LD      HL,(BDOS_PARM)
        LD      A,(HL)
        LD      (BDL_MAX),A
        INC     HL
        XOR     A
        LD      (HL),A
        LD      (BDL_COUNT),A
        INC     HL
        LD      (BDL_BASE),HL
        LD      (BDL_PTR),HL
        LD      A,(BDOS_COLUMN)
        LD      (BDL_START),A
BF_RLLOOP:
        LD      A,(BDL_COUNT)
        LD      HL,BDL_MAX
        CP      (HL)
        JP      Z,BF_RLDONE
        CALL    BF_GETIN
        AND     07FH
        CP      13
        JP      Z,BF_RLDONE
        CP      10
        JP      Z,BF_RLDONE
        CP      8
        JR      Z,BF_RLBS
        CP      127
        JR      Z,BF_RLBS
        CP      3
        JR      Z,BF_RLCTRL
        CP      5
        JR      Z,BF_RLE
        CP      18
        JR      Z,BF_RLR
        CP      21
        JR      Z,BF_RLU
        CP      24
        JR      Z,BF_RLX
        CP      16
        JR      Z,BF_RLP
BF_RLSTORE:
        LD      HL,(BDL_PTR)
        LD      (HL),A
        INC     HL
        LD      (BDL_PTR),HL
        LD      HL,BDL_COUNT
        INC     (HL)
        CALL    BF_CLECHO
        JR      BF_RLLOOP
BF_RLCTRL:
        LD      A,(BDL_COUNT)
        OR      A
        JP      Z,BIOWBOOT
        LD      A,3
        JR      BF_RLSTORE
BF_RLP:
        LD      A,(BDOS_LISTE)
        CPL
        LD      (BDOS_LISTE),A
        JR      BF_RLLOOP
BF_RLE:
        CALL    BF_RLNEW
        XOR     A
        LD      (BDL_START),A
        JR      BF_RLLOOP
BF_RLR:
        CALL    BF_RLHASH
        CALL    BF_RLIND
        CALL    BF_RLREPLAY
        JR      BF_RLLOOP
BF_RLU:
        CALL    BF_RLHASH
        CALL    BF_RLIND
        CALL    BF_RLCLEAR
        JR      BF_RLLOOP
BF_RLX:
        LD      A,(BDL_COUNT)
        OR      A
        JP      Z,BF_RLLOOP
BF_RLXLP:
        CALL    BF_RLERASE
        LD      A,(BDL_COUNT)
        DEC     A
        LD      (BDL_COUNT),A
        JR      NZ,BF_RLXLP
        LD      HL,(BDL_BASE)
        LD      (BDL_PTR),HL
        JP      BF_RLLOOP
BF_RLBS:
        LD      A,(BDL_COUNT)
        OR      A
        JP      Z,BF_RLLOOP
        DEC     A
        LD      (BDL_COUNT),A
        LD      HL,(BDL_PTR)
        DEC     HL
        LD      (BDL_PTR),HL
        CALL    BF_RLERASE
        JP      BF_RLLOOP
BF_RLDONE:
        LD      HL,(BDOS_PARM)
        INC     HL
        LD      A,(BDL_COUNT)
        LD      (HL),A
        LD      A,13
        CALL    BF_COCHAR
        XOR     A
        JP      BDOS_RETURN

BF_RLERASE:
        LD      A,8
        CALL    BF_COCHAR
        LD      A,' '
        CALL    BF_COCHAR
        LD      A,8
        JP      BF_COCHAR
BF_RLHASH:
        LD      A,'#'
        CALL    BF_COCHAR
BF_RLNEW:
        LD      A,13
        CALL    BF_COCHAR
        LD      A,10
        JP      BF_COCHAR
BF_RLIND:
        LD      A,(BDL_START)
        OR      A
        RET     Z
        LD      B,A
BF_RLILP:
        PUSH    BC
        LD      A,' '
        CALL    BF_COCHAR
        POP     BC
        DJNZ    BF_RLILP
        RET
BF_RLREPLAY:
        LD      HL,(BDL_BASE)
        LD      A,(BDL_COUNT)
        OR      A
        RET     Z
        LD      B,A
BF_RLRPLP:
        LD      A,(HL)
        INC     HL
        PUSH    HL
        PUSH    BC
        CALL    BF_CLECHO
        POP     BC
        POP     HL
        DJNZ    BF_RLRPLP
        RET
BF_RLCLEAR:
        XOR     A
        LD      (BDL_COUNT),A
        LD      HL,(BDL_BASE)
        LD      (BDL_PTR),HL
        RET

; Accepted controls not assigned an editing action use caret notation.
BF_CLECHO:
        LD      (BDOS_CHAR),A
        CP      9
        JP      Z,BF_COCHAR
        CP      32
        JP      NC,BF_COCHAR
        PUSH    AF
        LD      A,'^'
        CALL    BF_COCHAR
        POP     AF
        ADD     A,'@'
        JP      BF_COCHAR

; Cooked, blocking console input. CP/M flow/printer controls are consumed;
; ordinary control bytes are returned without echo.
BF_CONIN:
BF_CINLP:
        CALL    BF_GETIN
        CP      013H            ; ^S pauses until the next key
        JP      Z,BF_PAUSE
        CP      011H            ; stray ^Q is invisible
        JR      Z,BF_CINLP
        CP      010H            ; ^P toggles printer echo
        JR      Z,BF_TOGPR
        CP      003H            ; ^C aborts to the CCP through warm boot
        JP      Z,BIOWBOOT
        LD      (BDOS_CHAR),A
        CALL    BF_ECHO
        LD      A,(BDOS_CHAR)
        JP      BDOS_RETURN
BF_GETIN:
        LD      A,(BDP_VALID)
        OR      A
        JR      Z,BF_GIBIOS
        XOR     A
        LD      (BDP_VALID),A
        LD      A,(BDP_CHAR)
        RET
BF_GIBIOS:
        JP      BIOCONIN

; Cooked console output shares tab and column rules with echoed input.
BF_CONOUT:
        LD      A,E
        CALL    BF_COCHAR
        XOR     A
        JP      BDOS_RETURN

; BetterCP/M Function 204. E=0 queries the platform capability. A nonzero E
; writes that character in the platform's cursor presentation and advances
; the tracked console column. Unsupported platforms return zero and perform
; no output, allowing the CCP to retain a plain-character fallback.
BF_CURSOR:
        LD      A,E
        LD      C,A
        CALL    BIOCURSOR
        OR      A
        JP      Z,BDOS_RETURN
        LD      A,E
        OR      A
        LD      A,1
        JP      Z,BDOS_RETURN
        LD      HL,BDOS_COLUMN
        INC     (HL)
        JP      BDOS_RETURN
BF_CCPPRN:
        LD      A,(BDOS_LISTE)
        CPL
        LD      (BDOS_LISTE),A
        JP      BDOS_RETURN
BF_COCHAR:
        LD      (BDOS_CHAR),A
        CP      9
        JR      Z,BF_COTAB
        CP      13
        JR      Z,BF_COCR
        CP      8
        JR      Z,BF_COBS
        LD      C,A
        CALL    BF_CPUT
        CP      10
        JR      Z,BF_COEND
        LD      HL,BDOS_COLUMN
        INC     (HL)
BF_COEND:
        RET
BF_COTAB:
        CALL    BF_TAB
        JR      BF_COEND
BF_COCR:
        CALL    BF_CR
        JR      BF_COEND
BF_COBS:
        CALL    BF_BS
        JR      BF_COEND
BF_TOGPR:
        LD      A,(BDOS_LISTE)
        CPL
        LD      (BDOS_LISTE),A
        JP      BF_CINLP
BF_PAUSE:
        CALL    BIOCONIN
        CP      003H
        JP      Z,BIOWBOOT
        CP      010H
        JP      NZ,BF_CINLP     ; CP/M resumes after any key
BF_PTOG:
        LD      A,(BDOS_LISTE)
        CPL
        LD      (BDOS_LISTE),A
        JP      BF_CINLP

; Echo the saved character using CP/M's cooked single-character rules.
BF_ECHO:
        LD      A,(BDOS_CHAR)
        CP      9
        JR      Z,BF_TAB
        CP      13
        JR      Z,BF_CR
        CP      10
        JR      Z,BF_EPLAIN
        CP      8
        JR      Z,BF_BS
        CP      32
        RET     C
        CP      127
        RET     NC
        LD      C,A
        CALL    BF_PUTCH
        LD      HL,BDOS_COLUMN
        INC     (HL)
        RET
BF_CR:
        XOR     A
        LD      (BDOS_COLUMN),A
        LD      C,13
        JP      BF_PUTCH
BF_BS:
        LD      HL,BDOS_COLUMN
        LD      A,(HL)
        OR      A
        JR      Z,BF_EPLAIN
        DEC     (HL)
BF_EPLAIN:
        LD      A,(BDOS_CHAR)
        LD      C,A
        JP      BF_CPUT
BF_TAB:
        LD      A,(BDOS_COLUMN)
        CPL
        AND     7
        INC     A
        LD      B,A
BF_TABLOP:
        PUSH    BC
        LD      C,' '
        CALL    BF_CPUT
        POP     BC
        LD      HL,BDOS_COLUMN
        INC     (HL)
        DJNZ    BF_TABLOP
        RET

; Poll CP/M output controls. If polling encounters ordinary input, retain it
; for the next cooked or direct input call rather than discarding the key.
BF_CPUT:
        LD      A,C
        LD      (BDO_CHAR),A
BF_FLPOLL:
        LD      A,(BDP_VALID)
        OR      A
        JR      NZ,BF_FLREADY
        CALL    BIOCONST
        OR      A
        JR      Z,BF_FLREADY
        CALL    BIOCONIN
        CP      013H
        JR      Z,BF_FLPAUS
        CP      011H
        JR      Z,BF_FLPOLL
        CP      010H
        JR      Z,BF_FLTOG
        CP      003H
        JP      Z,BIOWBOOT
        LD      (BDP_CHAR),A
        LD      A,0FFH
        LD      (BDP_VALID),A
        JR      BF_FLREADY
BF_FLTOG:
        LD      A,(BDOS_LISTE)
        CPL
        LD      (BDOS_LISTE),A
        JR      BF_FLPOLL
BF_FLPAUS:
        CALL    BIOCONIN
        CP      003H
        JP      Z,BIOWBOOT
        CP      010H
        JR      NZ,BF_FLREADY   ; consume any key and resume output
BP_TOG:
        LD      A,(BDOS_LISTE)
        CPL
        LD      (BDOS_LISTE),A
        JR      BF_FLREADY
BF_FLREADY:
        LD      A,(BDO_CHAR)
        LD      C,A
        JP      BF_PUTCH

BF_PUTCH:
        PUSH    BC
        CALL    BIOCONOT
        POP     BC
        LD      A,(BDOS_LISTE)
        OR      A
        RET     Z
        JP      BIOLIST

; Direct console I/O bypasses echo and all cooked-console interpretation.
; E=FFh polls for one input byte; every other value is output directly.
BF_DCIO:
        LD      A,E
        CP      0FFH
        JR      Z,BF_DCIN
        LD      C,A
        CALL    BIOCONOT
        XOR     A               ; output-form return is not otherwise defined
        JP      BDOS_RETURN
BF_DCIN:
        LD      A,(BDP_VALID)
        OR      A
        JR      NZ,BF_DCREAD
        CALL    BIOCONST
        OR      A
        JP      Z,BDOS_RETURN   ; nonblocking empty result
BF_DCREAD:
        CALL    BF_GETIN
        JP      BDOS_RETURN

BF_CONST:
        LD      A,(BDP_VALID)
        OR      A
        JR      NZ,BF_CREADY
        CALL    BIOCONST        ; BIOS already guarantees exactly 00h or FFh
        JP      BDOS_RETURN
BF_CREADY:
        LD      A,0FFH
        JP      BDOS_RETURN

BDOS_VERS:
        LD      A,022H          ; CP/M 2.2 identity, returned as HL=0022h
        JP      BDOS_RETURN

BDOS_RESET:
        LD      C,0
        CALL    DIRLOGIN
        JR      NZ,BDOS_BADRV
        XOR     A
        LD      (BDOS_DRIVE),A  ; reset selects A but preserves current user
        LD      HL,0080H
        LD      (BDOS_DMA),HL
        LD      HL,0001H        ; after reset, only drive A is logged
        LD      (STATE_LV),HL
        LD      HL,0000H        ; reset clears software write protection
        LD      (STATE_RO),HL
        XOR     A               ; function 13 has no specified result
        JP      BDOS_RETURN

BDOS_SELDR:
        LD      A,E
        CP      4               ; Model 4 development system exposes A through D
        JR      NC,BDOS_BADRV
        LD      (BDOS_TDRIVE),A
        LD      C,A
        CALL    DIRSELECT       ; commit BDOS state only after valid login
        JR      NZ,BDOS_BADRV
        LD      HL,(BDOS_PARM)
        LD      A,L
        LD      (BDOS_DRIVE),A
        CALL    BF_LOGCUR        ; login vector is cumulative
        XOR     A               ; function 14 has no defined normal result
        JP      BDOS_RETURN
BDOS_BADRV:
        LD      A,0FFH          ; deliberate provisional failure result
        JP      BDOS_RETURN

BDOS_GETDR:
        LD      A,(BDOS_DRIVE)
        JP      BDOS_RETURN

BDOS_LOGV:
        LD      HL,(STATE_LV)
        JP      RET_HL

BDOS_STDMA:
        LD      HL,(BDOS_PARM)
        LD      (BDOS_DMA),HL
        XOR     A               ; function 26 has no specified result
        JP      BDOS_RETURN

BDOS_ALVP:
        CALL    DIRGALV
        JR      NZ,BDOS_PTRER
        JP      RET_HL

BDOS_DPBP:
        CALL    DIRGDPB
        JR      NZ,BDOS_PTRER
        JP      RET_HL
BDOS_PTRER:
        LD      A,0FFH
        JP      BDOS_RETURN

BDOS_WRPRO:
        LD      A,(BDOS_DRIVE)
        LD      E,A
        LD      D,0
        LD      HL,BF_DMASK
        ADD     HL,DE
        LD      A,(HL)
        LD      HL,STATE_RO
        OR      (HL)
        LD      (HL),A
        XOR     A               ; function 28 has no specified result
        JP      BDOS_RETURN

BDOS_ROV:
        LD      HL,(STATE_RO)
        JP      RET_HL

BF_USER:
        LD      A,E
        CP      0FFH
        JR      Z,BF_GETU
        AND     01FH            ; required CP/M 2.2 modulo-32 selection
        LD      (BDOS_USER),A
        XOR     A               ; set-form result is not guaranteed
        JP      BDOS_RETURN
BF_GETU:
        LD      A,(BDOS_USER)
        JP      BDOS_RETURN

; CP/M 2.2 abandons the transient after an attempted write through an FCB
; carrying the file read-only attribute. Earlier BetterCP/M revisions safely
; returned FFh here; retain that behavior in the directory layer, but
; interpose the compatibility-visible resident error before write dispatch.
BF_CHFRO:
        PUSH    DE
        LD      HL,(BDOS_PARM)
        LD      DE,9
        ADD     HL,DE
        LD      A,(HL)
        AND     080H
        JR      NZ,BF_FROERR
        POP     DE
        RET
BF_FROERR:
        POP     DE
        LD      HL,BF_MSGFRO
BF_FROLP:
        LD      A,(HL)
        CP      '$'
        JP      Z,BIOWBOOT
        INC     HL
        PUSH    HL
        CALL    BF_COCHAR
        POP     HL
        JR      BF_FROLP

BF_MSGFRO:
        DB      13,10,'File R/O',13,10,'$'

BF_RREAD:
        LD      DE,(BDOS_PARM)
        CALL    BF_FSEL
        JP      NZ,BDOS_BADRV
        LD      BC,(BDOS_DMA)
        LD      A,(BDOS_USER)
        CALL    DIRRREAD
        JP      NC,BDOS_RETURN
        LD      A,0FFH          ; provisional physical-storage presentation
        JP      BDOS_RETURN

BF_RWRIT:
        LD      DE,(BDOS_PARM)
        CALL    BF_FSEL
        JP      NZ,BDOS_BADRV
        CALL    BF_CHFRO
        LD      BC,(BDOS_DMA)
        CALL    BF_ISRO
        LD      H,A
        LD      A,(BDOS_USER)
        CALL    DIRRWRIT
        JP      NC,BDOS_RETURN
        LD      A,0FFH          ; protection or physical-storage failure
        JP      BDOS_RETURN

BF_RZERO:
        LD      DE,(BDOS_PARM)
        CALL    BF_FSEL
        JP      NZ,BDOS_BADRV
        CALL    BF_CHFRO
        LD      BC,(BDOS_DMA)
        CALL    BF_ISRO
        LD      H,A
        LD      A,(BDOS_USER)
        CALL    DIRRZERO
        JP      NC,BDOS_RETURN
        LD      A,0FFH
        JP      BDOS_RETURN

; Selectively return the implemented drives to not-logged-in/read-write state.
BF_RSTDR:
        LD      HL,(BDOS_PARM)
        LD      A,L
        AND     0FH
        LD      E,A
        AND     1
        JR      Z,BF_RSTB
        LD      A,(STATE_LV)
        AND     0FEH
        LD      (STATE_LV),A
        LD      A,(STATE_RO)
        AND     0FEH
        LD      (STATE_RO),A
BF_RSTB:
        LD      A,E
        AND     2
        JR      Z,BF_RSTINV
        LD      A,(STATE_LV)
        AND     0FDH
        LD      (STATE_LV),A
        LD      A,(STATE_RO)
        AND     0FDH
        LD      (STATE_RO),A
BF_RSTC:
        LD      A,E
        AND     4
        JR      Z,BF_RSTD
        LD      A,(STATE_LV)
        AND     0FBH
        LD      (STATE_LV),A
        LD      A,(STATE_RO)
        AND     0FBH
        LD      (STATE_RO),A
BF_RSTD:
        LD      A,E
        AND     8
        JR      Z,BF_RSTINV
        LD      A,(STATE_LV)
        AND     0F7H
        LD      (STATE_LV),A
        LD      A,(STATE_RO)
        AND     0F7H
        LD      (STATE_RO),A
BF_RSTINV:
        LD      A,E
        OR      A
        JR      Z,BF_RSTDONE
        CALL    DIRINVAL
BF_RSTDONE:
        XOR     A               ; required for CP/M/MP/M compatibility
        JP      BDOS_RETURN

; Patch 2026-09-01: resolve FCB byte zero (0=current, 1=A, 2=B) before every
; file operation. Explicit selection changes the directory context and login
; vector, but deliberately does not change Function 25's default drive.
BF_FSEL:
        PUSH    BC
        PUSH    DE
        LD      A,(DE)
        CP      '?'
        JR      Z,BF_FCUR
        OR      A
        JR      NZ,BF_FEXPL
BF_FCUR:
        LD      A,(BDOS_DRIVE)
        JR      BF_FGOT
BF_FEXPL:
        DEC     A
BF_FGOT:
        CP      4
        JR      NC,BF_FBAD
        LD      (BDOS_TDRIVE),A
        LD      C,A
        CALL    DIRSELECT
        JR      NZ,BF_FDONE
        CALL    BF_LOGCUR
        XOR     A
BF_FDONE:
        POP     DE
        POP     BC
        RET
BF_FBAD:
        LD      A,1
        OR      A
        JR      BF_FDONE

BF_LOGCUR:
        LD      A,(BDOS_TDRIVE)
        LD      E,A
        LD      D,0
        LD      HL,BF_DMASK
        ADD     HL,DE
        LD      A,(HL)
        LD      HL,STATE_LV
        OR      (HL)
        LD      (HL),A
        RET

BF_ISRO:
        PUSH    BC
        LD      A,(BDOS_TDRIVE)
        LD      B,A
        LD      A,(STATE_RO)
BF_ROSHIFT:
        INC     B
        DEC     B
        JR      Z,BF_ROBIT
        RRCA
        DEC     B
        JR      BF_ROSHIFT
BF_ROBIT:
        AND     1
        POP     BC
        RET

BF_DMASK:
        DB      1,2,4,8

BDOS_OPEN:
        LD      DE,(BDOS_PARM)
        CALL    BF_FSEL
        JP      NZ,BDOS_BADRV
        LD      HL,14
        ADD     HL,DE
        LD      (HL),0          ; CP/M caller supplies S2 zero on Open
        LD      A,(BDOS_USER)
        CALL    DIROPEN
        JP      NC,BDOS_RETURN
        LD      A,0FFH          ; provisional storage-error presentation
; Patch 2026-09-01: RET_HL was inserted below for function 24. Keep this
; explicit branch so Open errors cannot fall into the new 16-bit return path.
        JP      BDOS_RETURN

BDOS_CLOSE:
        LD      DE,(BDOS_PARM)
        CALL    BF_FSEL
        JP      NZ,BDOS_BADRV
        CALL    BF_ISRO
        LD      B,A
        LD      A,(BDOS_USER)
        CALL    DIRCLOS
        JP      NC,BDOS_RETURN
        LD      A,0FFH          ; provisional storage-error presentation
        JP      BDOS_RETURN

BDOS_SFIR:
        LD      DE,(BDOS_PARM)
        ; Drive '?' changes the user-matching policy, not the selected disk.
        ; BF_FSEL already resolves it to the public current drive.  Always
        ; reselect that drive so an earlier explicit-drive operation cannot
        ; leave Directory Services scanning its private stale context.
        CALL    BF_FSEL
        JP      NZ,BDOS_BADRV
BF_SALL:
        LD      BC,(BDOS_DMA)
        LD      A,(BDOS_USER)
        CALL    DIRSFIR
        JR      BF_SRET

BDOS_SNXT:
        LD      BC,(BDOS_DMA)
        CALL    DIRSNXT
BF_SRET:
        JP      NC,BDOS_RETURN
        LD      A,0FFH          ; provisional storage-error presentation
        JP      BDOS_RETURN

BDOS_DELETE:
        LD      DE,(BDOS_PARM)
        CALL    BF_FSEL
        JP      NZ,BDOS_BADRV
        CALL    BF_ISRO
        LD      B,A
        LD      A,(BDOS_USER)
        CALL    DIRDELETE
        JP      NC,BDOS_RETURN
        LD      A,0FFH
        JP      BDOS_RETURN

BDOS_READ:
        LD      DE,(BDOS_PARM)
        CALL    BF_FSEL
        JP      NZ,BDOS_BADRV
        LD      BC,(BDOS_DMA)
        LD      A,(BDOS_USER)
        CALL    DIRREAD
        JP      NC,BDOS_RETURN  ; zero success or nonzero EOF
        LD      A,0FFH          ; provisional storage-error presentation
        JP      BDOS_RETURN

BDOS_WRITE:
        LD      DE,(BDOS_PARM)
        CALL    BF_FSEL
        JP      NZ,BDOS_BADRV
        CALL    BF_CHFRO
        LD      BC,(BDOS_DMA)
        CALL    BF_ISRO
        LD      H,A             ; H=software-protected flag
        LD      A,(BDOS_USER)
        CALL    DIRWRITE
        JP      NC,BDOS_RETURN
        LD      A,0FFH          ; protection or physical-storage failure
        JP      BDOS_RETURN

BDOS_MAKE:
        LD      DE,(BDOS_PARM)
        CALL    BF_FSEL
        JP      NZ,BDOS_BADRV
        CALL    BF_ISRO
        LD      B,A
        LD      A,(BDOS_USER)
        CALL    DIRMAKE
        JP      NC,BDOS_RETURN
        LD      A,0FFH
        JP      BDOS_RETURN

BDOS_ATTR:
        LD      DE,(BDOS_PARM)
        CALL    BF_FSEL
        JP      NZ,BDOS_BADRV
        CALL    BF_ISRO
        LD      B,A
        LD      A,(BDOS_USER)
        CALL    DIRATTR
        JP      NC,BDOS_RETURN
        LD      A,0FFH
        JP      BDOS_RETURN

BDOS_SIZE:
        LD      DE,(BDOS_PARM)
        CALL    BF_FSEL
        JP      NZ,BDOS_BADRV
        LD      A,(BDOS_USER)
        CALL    DIRSIZE
        JR      NC,BDOS_RETURN
        LD      A,0FFH
        JP      BDOS_RETURN

; Convert S2:EX:CR to the 24-bit random-record field at FCB bytes 33..35.
BDOS_SETRR:
        LD      HL,(BDOS_PARM)
        LD      DE,12
        ADD     HL,DE
        LD      A,(HL)
        AND     01FH
        LD      E,A
        INC     HL
        INC     HL
        LD      A,(HL)
        AND     03FH
        LD      H,0
        LD      L,A
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        LD      D,0
        ADD     HL,DE
        LD      (BDOS_RREX),HL
        LD      A,L
        AND     1
        LD      C,0
        JR      Z,BR_LOW
        LD      C,080H
BR_LOW:
        LD      HL,(BDOS_PARM)
        LD      DE,32
        ADD     HL,DE
        LD      A,(HL)
        ADD     A,C
        INC     HL
        LD      (BDOS_RRP),HL
        LD      (HL),A
        LD      D,0
        JR      NC,BR_NC0
        INC     D
BR_NC0:
        LD      HL,(BDOS_RREX)
        SRL     H
        RR      L
        LD      A,L
        ADD     A,D
        LD      HL,(BDOS_RRP)
        INC     HL
        LD      (HL),A
        LD      C,0
        JR      NC,BR_NC1
        INC     C
BR_NC1:
        LD      DE,(BDOS_RREX)
        SRL     D
        LD      A,D
        ADD     A,C
        INC     HL
        LD      (HL),A
        XOR     A
        JP      BDOS_RETURN

BDOS_RENAME:
        LD      DE,(BDOS_PARM)
        CALL    BF_FSEL
        JP      NZ,BDOS_BADRV
        CALL    BF_ISRO
        LD      B,A
        LD      A,(BDOS_USER)
        CALL    DIRRENAME
        JR      NC,BDOS_RETURN
        LD      A,0FFH
        JP      BDOS_RETURN

; CP/M normal-return aliases: A=L and B=H.
RET_HL:
        LD      A,L
        LD      B,H
        JR      RET_SP
BDOS_RETURN:
        LD      L,A
        LD      H,0
        LD      B,H
        LD      A,L
RET_SP:
        LD      SP,(BDOS_OLDSP)
        RET

BDOS_FUNC:
        DB      0
BCX_MVAL:
        DB      0
BDOS_CHAR:
        DB      0
BDOS_COLUMN:
        DB      0
BDOS_LISTE:
        DB      0
BDP_VALID:
        DB      0
BDP_CHAR:
        DB      0
BDO_CHAR:
        DB      0
BDL_MAX:
        DB      0
BDL_COUNT:
        DB      0
BDL_START:
        DB      0
BDL_BASE:
        DW      0
BDL_PTR:
        DW      0
BDOS_PARM:
        DW      0
BDOS_OLDSP:
        DW      0
BDOS_USER:
        DB      0               ; initial current user
BDOS_DRIVE:
        DB      0               ; initial current/default drive A
BDOS_TDRIVE:
        DB      0               ; target selected by the current FCB operation
BDOS_DMA:
        DW      0080H           ; CP/M startup DMA selection
STATE_LV:
        DW      0001H           ; gateway publishes BDOS only after A login
STATE_RO:
        DW      0000H           ; transient software read-only drive vector
BDOS_RREX:
        DW      0000H
BDOS_RRP:
        DW      0000H

        INCLUDE versions.inc

; Patch 2026-09-01: the first public-call boundary receives its own stack now,
; before more BDOS functions deepen the call graph. The exact size and address
; remain provisional; only balanced restoration is compatibility-visible.
BDOS_STACK:
        REPT    64
        DB      0
        ENDM
BDOS_STKTOP:

; Patch 2026-09-02: the original DPH/DPB tables at C080h and CSV/ALV pages
; below C100h were inside the TPA. A large transient could therefore corrupt
; the live disk contract. Keep the historical mistake visible in the gateway
; source, but place every descriptor and workspace above resident BDOS code.
; Patch 2026-09-02: the second CPX profile made the fixed-core dispatcher
; outgrow the old C900h descriptor boundary. The first repair fixed this table
; at CB00h, leaving a 258-byte bring-up hole after the private stack. Patch
; 2026-09-03 removes that artificial boundary: the descriptor unit follows the
; dispatcher immediately and its physical address is now a generated-layout
; concern rather than reserved resident storage.
BIO_DPH0:
        DW      0,0,0,0,0EC80H,BIO_DPB0,BIO_CSV0,BIO_ALV0
BIO_DPH1:
        DW      0,0,0,0,0EC80H,BIO_DPB0,BIO_CSV1,BIO_ALV1
BIO_DPH2:
        DW      0,0,0,0,0EC80H,BIO_DPB0,BIO_CSV2,BIO_ALV2
BIO_DPH3:
        DW      0,0,0,0,0EC80H,BIO_DPB0,BIO_CSV3,BIO_ALV3
BIO_DPB0:
        DW      80
        DB      4,15,0
        DW      394,127
        DB      0C0H,0
        DW      32,2
        DB      0               ; align mutable workspace at CB50h
BIO_CSV0:
        REPT    32
        DB      0
        ENDM
BIO_ALV0:
        REPT    50
        DB      0
        ENDM
BIO_CSV1:
        REPT    32
        DB      0
        ENDM
BIO_ALV1:
        REPT    50
        DB      0
        ENDM
BIO_CSV2:
        REPT    32
        DB      0
        ENDM
BIO_ALV2:
        REPT    50
        DB      0
        ENDM
BIO_CSV3:
        REPT    32
        DB      0
        ENDM
BIO_ALV3:
        REPT    50
        DB      0
        ENDM

        .DEPHASE
        END
