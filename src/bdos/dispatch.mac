; BetterCP/M initial CP/M-compatible BDOS dispatcher.
;
; Provisional resident placement. Page-zero address 0005h is not installed yet.

BDOSBASE        EQU     0C100H
BIOCONST        EQU     0F006H  ; CP/M BIOS console-status vector
BIOCONIN        EQU     0F009H  ; CP/M BIOS console-input vector
BIOCONOT        EQU     0F00CH  ; CP/M BIOS console-output vector
BIOLIST         EQU     0F00FH  ; CP/M BIOS list-output vector
BIOPUNCH        EQU     0F012H  ; CP/M BIOS punch-output vector
BIOREADR        EQU     0F015H  ; CP/M BIOS reader-input vector
BIOWBOOT        EQU     0F003H  ; CP/M BIOS warm-boot vector
DIROPEN         EQU     0D812H  ; seventh directory-service vector
DIRINVAL        EQU     0D80FH  ; sixth directory-service vector
DIRLOGIN        EQU     0D80CH  ; fifth directory-service vector
DIRGALV         EQU     0D815H  ; eighth directory-service vector
DIRGDPB         EQU     0D818H  ; ninth directory-service vector
DIRSFIR         EQU     0D81BH  ; tenth directory-service vector
DIRSNXT         EQU     0D81EH  ; eleventh directory-service vector
DIRCLOS         EQU     0D821H  ; twelfth directory-service vector
DIRREAD         EQU     0D824H  ; thirteenth directory-service vector
DIRWRITE        EQU     0D827H  ; fourteenth directory-service vector
DIRMAKE         EQU     0D82AH  ; fifteenth directory-service vector
DIRDELETE       EQU     0D82DH  ; sixteenth directory-service vector
DIRRENAME       EQU     0D830H  ; seventeenth directory-service vector
DIRATTR         EQU     0D833H  ; eighteenth directory-service vector
DIRSIZE         EQU     0D836H  ; nineteenth directory-service vector
DIRRREAD        EQU     0D839H  ; twentieth directory-service vector
DIRRWRIT        EQU     0D83CH  ; twenty-first directory-service vector
DIRRZERO        EQU     0D83FH  ; twenty-second directory-service vector

        CSEG
        .PHASE  BDOSBASE

BDOS:
        LD      A,C
        LD      (BDOS_FUNC),A
        LD      (BDOS_PARM),DE
        LD      (BDOS_OLDSP),SP
        LD      SP,BDOS_STKTOP
        CP      1
        JP      Z,BF_CONIN
        CP      2
        JP      Z,BF_CONOUT
        CP      3
        JP      Z,BF_READER
        CP      4
        JP      Z,BF_PUNCH
        CP      5
        JP      Z,BF_LIST
        CP      6
        JP      Z,BF_DCIO
        CP      7
        JP      Z,BF_GETIO
        CP      11
        JP      Z,BF_CONST
        CP      12
        JP      Z,BDOS_VERS
        CP      13
        JP      Z,BDOS_RESET
        CP      14
        JP      Z,BDOS_SELDR
        CP      15
        JP      Z,BDOS_OPEN
        CP      16
        JP      Z,BDOS_CLOSE
        CP      17
        JP      Z,BDOS_SFIR
        CP      18
        JP      Z,BDOS_SNXT
        CP      19
        JP      Z,BDOS_DELETE
        CP      20
        JP      Z,BDOS_READ
        CP      21
        JP      Z,BDOS_WRITE
        CP      22
        JP      Z,BDOS_MAKE
        CP      23
        JP      Z,BDOS_RENAME
        CP      24
        JP      Z,BDOS_LOGV
        CP      25
        JP      Z,BDOS_GETDR
        CP      26
        JP      Z,BDOS_STDMA
        CP      27
        JP      Z,BDOS_ALVP
        CP      28
        JP      Z,BDOS_WRPRO
        CP      29
        JP      Z,BDOS_ROV
        CP      30
        JP      Z,BDOS_ATTR
        CP      31
        JP      Z,BDOS_DPBP
        CP      32
        JP      Z,BF_USER
        CP      33
        JP      Z,BF_RREAD
        CP      34
        JP      Z,BF_RWRIT
        CP      35
        JP      Z,BDOS_SIZE
        CP      36
        JP      Z,BDOS_SETRR
        CP      37
        JP      Z,BF_RSTDR
        CP      40
        JP      Z,BF_RZERO
        LD      A,0FFH          ; unsupported returning function
        JP      BDOS_RETURN

BF_READER:
        CALL    BIOREADR
        JP      BDOS_RETURN
BF_PUNCH:
        LD      A,E
        LD      C,A
        CALL    BIOPUNCH
        XOR     A
        JP      BDOS_RETURN
BF_LIST:
        LD      A,E
        LD      C,A
        CALL    BIOLIST
        XOR     A
        JP      BDOS_RETURN
BF_GETIO:
        LD      A,(0003H)       ; conventional CP/M page-zero I/O byte
        JP      BDOS_RETURN

; Cooked, blocking console input. CP/M flow/printer controls are consumed;
; ordinary control bytes are returned without echo.
BF_CONIN:
BF_CINLP:
        CALL    BF_GETIN
        CP      013H            ; ^S pauses until ^Q
        JR      Z,BF_PAUSE
        CP      011H            ; stray ^Q is invisible
        JR      Z,BF_CINLP
        CP      010H            ; ^P toggles printer echo
        JR      Z,BF_TOGPR
        CP      003H            ; ^C aborts to the CCP through warm boot
        JP      Z,BIOWBOOT
        LD      (BDOS_CHAR),A
        CALL    BF_ECHO
        LD      A,(BDOS_CHAR)
        JP      BDOS_RETURN
BF_GETIN:
        LD      A,(BDP_VALID)
        OR      A
        JR      Z,BF_GIBIOS
        XOR     A
        LD      (BDP_VALID),A
        LD      A,(BDP_CHAR)
        RET
BF_GIBIOS:
        JP      BIOCONIN

; Cooked console output shares tab and column rules with echoed input.
BF_CONOUT:
        LD      A,E
        LD      (BDOS_CHAR),A
        CP      9
        JR      Z,BF_COTAB
        CP      13
        JR      Z,BF_COCR
        CP      8
        JR      Z,BF_COBS
        LD      C,A
        CALL    BF_CPUT
        CP      10
        JR      Z,BF_COEND
        LD      HL,BDOS_COLUMN
        INC     (HL)
BF_COEND:
        XOR     A
        JP      BDOS_RETURN
BF_COTAB:
        CALL    BF_TAB
        JR      BF_COEND
BF_COCR:
        CALL    BF_CR
        JR      BF_COEND
BF_COBS:
        CALL    BF_BS
        JR      BF_COEND
BF_TOGPR:
        LD      A,(BDOS_LISTE)
        CPL
        LD      (BDOS_LISTE),A
        JR      BF_CINLP
BF_PAUSE:
        CALL    BIOCONIN
        CP      011H
        JR      Z,BF_CINLP
        CP      003H
        JP      Z,BIOWBOOT
        CP      010H
        JR      Z,BF_PTOG
        LD      C,7             ; reject other paused input with a bell
        CALL    BF_CPUT
        JR      BF_PAUSE
BF_PTOG:
        LD      A,(BDOS_LISTE)
        CPL
        LD      (BDOS_LISTE),A
        JR      BF_PAUSE

; Echo the saved character using CP/M's cooked single-character rules.
BF_ECHO:
        LD      A,(BDOS_CHAR)
        CP      9
        JR      Z,BF_TAB
        CP      13
        JR      Z,BF_CR
        CP      10
        JR      Z,BF_EPLAIN
        CP      8
        JR      Z,BF_BS
        CP      32
        RET     C
        CP      127
        RET     NC
        LD      C,A
        CALL    BF_PUTCH
        LD      HL,BDOS_COLUMN
        INC     (HL)
        RET
BF_CR:
        XOR     A
        LD      (BDOS_COLUMN),A
        LD      C,13
        JP      BF_PUTCH
BF_BS:
        LD      HL,BDOS_COLUMN
        LD      A,(HL)
        OR      A
        JR      Z,BF_EPLAIN
        DEC     (HL)
BF_EPLAIN:
        LD      A,(BDOS_CHAR)
        LD      C,A
        JP      BF_CPUT
BF_TAB:
        LD      A,(BDOS_COLUMN)
        CPL
        AND     7
        INC     A
        LD      B,A
BF_TABLOP:
        PUSH    BC
        LD      C,' '
        CALL    BF_CPUT
        POP     BC
        LD      HL,BDOS_COLUMN
        INC     (HL)
        DJNZ    BF_TABLOP
        RET

; Poll CP/M output controls. If polling encounters ordinary input, retain it
; for the next cooked or direct input call rather than discarding the key.
BF_CPUT:
        LD      A,C
        LD      (BDO_CHAR),A
BF_FLPOLL:
        LD      A,(BDP_VALID)
        OR      A
        JR      NZ,BF_FLREADY
        CALL    BIOCONST
        OR      A
        JR      Z,BF_FLREADY
        CALL    BIOCONIN
        CP      013H
        JR      Z,BF_FLPAUS
        CP      011H
        JR      Z,BF_FLPOLL
        CP      010H
        JR      Z,BF_FLTOG
        CP      003H
        JP      Z,BIOWBOOT
        LD      (BDP_CHAR),A
        LD      A,0FFH
        LD      (BDP_VALID),A
        JR      BF_FLREADY
BF_FLTOG:
        LD      A,(BDOS_LISTE)
        CPL
        LD      (BDOS_LISTE),A
        JR      BF_FLPOLL
BF_FLPAUS:
        CALL    BIOCONIN
        CP      011H
        JR      Z,BF_FLREADY
        CP      003H
        JP      Z,BIOWBOOT
        CP      010H
        JR      Z,BP_TOG
        LD      C,7
        CALL    BF_PUTCH
        JR      BF_FLPAUS
BP_TOG:
        LD      A,(BDOS_LISTE)
        CPL
        LD      (BDOS_LISTE),A
        JR      BF_FLPAUS
BF_FLREADY:
        LD      A,(BDO_CHAR)
        LD      C,A
        JP      BF_PUTCH

BF_PUTCH:
        PUSH    BC
        CALL    BIOCONOT
        POP     BC
        LD      A,(BDOS_LISTE)
        OR      A
        RET     Z
        JP      BIOLIST

; Direct console I/O bypasses echo and all cooked-console interpretation.
; E=FFh polls for one input byte; every other value is output directly.
BF_DCIO:
        LD      A,E
        CP      0FFH
        JR      Z,BF_DCIN
        LD      C,A
        CALL    BIOCONOT
        XOR     A               ; output-form return is not otherwise defined
        JP      BDOS_RETURN
BF_DCIN:
        LD      A,(BDP_VALID)
        OR      A
        JR      NZ,BF_DCREAD
        CALL    BIOCONST
        OR      A
        JP      Z,BDOS_RETURN   ; nonblocking empty result
BF_DCREAD:
        CALL    BF_GETIN
        JP      BDOS_RETURN

BF_CONST:
        LD      A,(BDP_VALID)
        OR      A
        JR      NZ,BF_CREADY
        CALL    BIOCONST        ; BIOS already guarantees exactly 00h or FFh
        JP      BDOS_RETURN
BF_CREADY:
        LD      A,0FFH
        JP      BDOS_RETURN

BDOS_VERS:
        LD      A,022H          ; CP/M 2.2 identity, returned as HL=0022h
        JP      BDOS_RETURN

BDOS_RESET:
        LD      C,0
        CALL    DIRLOGIN
        JR      NZ,BDOS_BADRV
        XOR     A
        LD      (BDOS_DRIVE),A  ; reset selects A but preserves current user
        LD      HL,0080H
        LD      (BDOS_DMA),HL
        LD      HL,0001H        ; after reset, only drive A is logged
        LD      (STATE_LV),HL
        LD      HL,0000H        ; reset clears software write protection
        LD      (STATE_RO),HL
        XOR     A               ; function 13 has no specified result
        JP      BDOS_RETURN

BDOS_SELDR:
        LD      A,E
        CP      1               ; current provisional BIOS exposes A only
        JR      NC,BDOS_BADRV
        LD      C,A
        CALL    DIRLOGIN        ; commit BDOS state only after valid login
        JR      NZ,BDOS_BADRV
        LD      HL,(BDOS_PARM)
        LD      A,L
        LD      (BDOS_DRIVE),A
        LD      HL,0001H        ; only A exists in this provisional BIOS
        LD      (STATE_LV),HL
        XOR     A               ; function 14 has no defined normal result
        JP      BDOS_RETURN
BDOS_BADRV:
        LD      A,0FFH          ; deliberate provisional failure result
        JP      BDOS_RETURN

BDOS_GETDR:
        LD      A,(BDOS_DRIVE)
        JP      BDOS_RETURN

BDOS_LOGV:
        LD      HL,(STATE_LV)
        JP      RET_HL

BDOS_STDMA:
        LD      HL,(BDOS_PARM)
        LD      (BDOS_DMA),HL
        XOR     A               ; function 26 has no specified result
        JP      BDOS_RETURN

BDOS_ALVP:
        CALL    DIRGALV
        JR      NZ,BDOS_PTRER
        JP      RET_HL

BDOS_DPBP:
        CALL    DIRGDPB
        JR      NZ,BDOS_PTRER
        JP      RET_HL
BDOS_PTRER:
        LD      A,0FFH
        JP      BDOS_RETURN

BDOS_WRPRO:
        LD      A,(STATE_RO)    ; only current drive A is available today
        OR      01H
        LD      (STATE_RO),A
        XOR     A               ; function 28 has no specified result
        JP      BDOS_RETURN

BDOS_ROV:
        LD      HL,(STATE_RO)
        JP      RET_HL

BF_USER:
        LD      A,E
        CP      0FFH
        JR      Z,BF_GETU
        AND     01FH            ; required CP/M 2.2 modulo-32 selection
        LD      (BDOS_USER),A
        XOR     A               ; set-form result is not guaranteed
        JP      BDOS_RETURN
BF_GETU:
        LD      A,(BDOS_USER)
        JP      BDOS_RETURN

BF_RREAD:
        LD      DE,(BDOS_PARM)
        LD      BC,(BDOS_DMA)
        LD      A,(BDOS_USER)
        CALL    DIRRREAD
        JP      NC,BDOS_RETURN
        LD      A,0FFH          ; provisional physical-storage presentation
        JP      BDOS_RETURN

BF_RWRIT:
        LD      DE,(BDOS_PARM)
        LD      BC,(BDOS_DMA)
        LD      A,(STATE_RO)
        AND     01H
        LD      H,A
        LD      A,(BDOS_USER)
        CALL    DIRRWRIT
        JP      NC,BDOS_RETURN
        LD      A,0FFH          ; protection or physical-storage failure
        JP      BDOS_RETURN

BF_RZERO:
        LD      DE,(BDOS_PARM)
        LD      BC,(BDOS_DMA)
        LD      A,(STATE_RO)
        AND     01H
        LD      H,A
        LD      A,(BDOS_USER)
        CALL    DIRRZERO
        JP      NC,BDOS_RETURN
        LD      A,0FFH
        JP      BDOS_RETURN

; Selectively return drives to the not-logged-in, read/write state. The
; provisional BIOS exposes only A:, but all other vector bits remain harmless.
BF_RSTDR:
        LD      HL,(BDOS_PARM)
        LD      A,L
        AND     1
        JR      Z,BF_RSTDONE
        LD      A,(STATE_LV)
        AND     0FEH
        LD      (STATE_LV),A
        LD      A,(STATE_RO)
        AND     0FEH
        LD      (STATE_RO),A
        CALL    DIRINVAL
BF_RSTDONE:
        XOR     A               ; required for CP/M/MP/M compatibility
        JP      BDOS_RETURN

BDOS_OPEN:
        LD      DE,(BDOS_PARM)
        LD      HL,14
        ADD     HL,DE
        LD      (HL),0          ; CP/M caller supplies S2 zero on Open
        LD      A,(BDOS_USER)
        CALL    DIROPEN
        JP      NC,BDOS_RETURN
        LD      A,0FFH          ; provisional storage-error presentation
; Patch 2026-09-01: RET_HL was inserted below for function 24. Keep this
; explicit branch so Open errors cannot fall into the new 16-bit return path.
        JP      BDOS_RETURN

BDOS_CLOSE:
        LD      DE,(BDOS_PARM)
        LD      A,(STATE_RO)
        AND     01H             ; current implementation has drive A only
        LD      B,A
        LD      A,(BDOS_USER)
        CALL    DIRCLOS
        JP      NC,BDOS_RETURN
        LD      A,0FFH          ; provisional storage-error presentation
        JP      BDOS_RETURN

BDOS_SFIR:
        LD      DE,(BDOS_PARM)
        LD      BC,(BDOS_DMA)
        LD      A,(BDOS_USER)
        CALL    DIRSFIR
        JR      BF_SRET

BDOS_SNXT:
        LD      BC,(BDOS_DMA)
        CALL    DIRSNXT
BF_SRET:
        JP      NC,BDOS_RETURN
        LD      A,0FFH          ; provisional storage-error presentation
        JP      BDOS_RETURN

BDOS_DELETE:
        LD      DE,(BDOS_PARM)
        LD      A,(STATE_RO)
        AND     01H
        LD      B,A
        LD      A,(BDOS_USER)
        CALL    DIRDELETE
        JP      NC,BDOS_RETURN
        LD      A,0FFH
        JP      BDOS_RETURN

BDOS_READ:
        LD      DE,(BDOS_PARM)
        LD      BC,(BDOS_DMA)
        LD      A,(BDOS_USER)
        CALL    DIRREAD
        JP      NC,BDOS_RETURN  ; zero success or nonzero EOF
        LD      A,0FFH          ; provisional storage-error presentation
        JP      BDOS_RETURN

BDOS_WRITE:
        LD      DE,(BDOS_PARM)
        LD      BC,(BDOS_DMA)
        LD      A,(STATE_RO)
        AND     01H
        LD      H,A             ; H=software-protected flag
        LD      A,(BDOS_USER)
        CALL    DIRWRITE
        JP      NC,BDOS_RETURN
        LD      A,0FFH          ; protection or physical-storage failure
        JP      BDOS_RETURN

BDOS_MAKE:
        LD      DE,(BDOS_PARM)
        LD      A,(STATE_RO)
        AND     01H
        LD      B,A
        LD      A,(BDOS_USER)
        CALL    DIRMAKE
        JP      NC,BDOS_RETURN
        LD      A,0FFH
        JP      BDOS_RETURN

BDOS_ATTR:
        LD      DE,(BDOS_PARM)
        LD      A,(STATE_RO)
        AND     01H
        LD      B,A
        LD      A,(BDOS_USER)
        CALL    DIRATTR
        JP      NC,BDOS_RETURN
        LD      A,0FFH
        JP      BDOS_RETURN

BDOS_SIZE:
        LD      DE,(BDOS_PARM)
        LD      A,(BDOS_USER)
        CALL    DIRSIZE
        JR      NC,BDOS_RETURN
        LD      A,0FFH
        JP      BDOS_RETURN

; Convert S2:EX:CR to the 24-bit random-record field at FCB bytes 33..35.
BDOS_SETRR:
        LD      HL,(BDOS_PARM)
        LD      DE,12
        ADD     HL,DE
        LD      A,(HL)
        AND     01FH
        LD      E,A
        INC     HL
        INC     HL
        LD      A,(HL)
        AND     03FH
        LD      H,0
        LD      L,A
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        LD      D,0
        ADD     HL,DE
        LD      (BDOS_RREX),HL
        LD      A,L
        AND     1
        LD      C,0
        JR      Z,BR_LOW
        LD      C,080H
BR_LOW:
        LD      HL,(BDOS_PARM)
        LD      DE,32
        ADD     HL,DE
        LD      A,(HL)
        ADD     A,C
        INC     HL
        LD      (BDOS_RRP),HL
        LD      (HL),A
        LD      D,0
        JR      NC,BR_NC0
        INC     D
BR_NC0:
        LD      HL,(BDOS_RREX)
        SRL     H
        RR      L
        LD      A,L
        ADD     A,D
        LD      HL,(BDOS_RRP)
        INC     HL
        LD      (HL),A
        LD      C,0
        JR      NC,BR_NC1
        INC     C
BR_NC1:
        LD      DE,(BDOS_RREX)
        SRL     D
        LD      A,D
        ADD     A,C
        INC     HL
        LD      (HL),A
        XOR     A
        JP      BDOS_RETURN

BDOS_RENAME:
        LD      DE,(BDOS_PARM)
        LD      A,(STATE_RO)
        AND     01H
        LD      B,A
        LD      A,(BDOS_USER)
        CALL    DIRRENAME
        JR      NC,BDOS_RETURN
        LD      A,0FFH
        JP      BDOS_RETURN

; CP/M normal-return aliases: A=L and B=H.
RET_HL:
        LD      A,L
        LD      B,H
        JR      RET_SP
BDOS_RETURN:
        LD      L,A
        LD      H,0
        LD      B,H
        LD      A,L
RET_SP:
        LD      SP,(BDOS_OLDSP)
        RET

BDOS_FUNC:
        DB      0
BDOS_CHAR:
        DB      0
BDOS_COLUMN:
        DB      0
BDOS_LISTE:
        DB      0
BDP_VALID:
        DB      0
BDP_CHAR:
        DB      0
BDO_CHAR:
        DB      0
BDOS_PARM:
        DW      0
BDOS_OLDSP:
        DW      0
BDOS_USER:
        DB      0               ; initial current user
BDOS_DRIVE:
        DB      0               ; initial current/default drive A
BDOS_DMA:
        DW      0080H           ; CP/M startup DMA selection
STATE_LV:
        DW      0001H           ; gateway publishes BDOS only after A login
STATE_RO:
        DW      0000H           ; transient software read-only drive vector
BDOS_RREX:
        DW      0000H
BDOS_RRP:
        DW      0000H

; Patch 2026-09-01: the first public-call boundary receives its own stack now,
; before more BDOS functions deepen the call graph. The exact size and address
; remain provisional; only balanced restoration is compatibility-visible.
BDOS_STACK:
        REPT    64
        DB      0
        ENDM
BDOS_STKTOP:

        .DEPHASE
        END
