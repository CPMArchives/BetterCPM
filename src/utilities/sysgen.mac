; SYSGEN -- install a BetterCP/M system package on configured SYSTEM media.
;
; Bare SYSGEN retains the interactive A: to B:-D: workflow. SYSGEN A: B:
; accepts explicit source/destination drives. SYSGEN SYSTEM.SYS B: installs
; a freshly composed package. The destination filesystem is never touched.
        ASEG
        ORG 0100H
BDOS    EQU 5
FCB1    EQU 005CH
FCB2    EQU 006CH
TAIL    EQU 0080H
IMAGE   EQU 04000H
BUFFER  EQU 03000H
VERIFY  EQU 03080H
PKGHEADER EQU 03100H
SYSRECS EQU 160
SYSBASE EQU 0D5C4H

        LD SP,03F00H
        CALL INIT
        LD HL,(1)             ; page zero WBOOT jump follows the BIOS base
        DEC HL
        DEC HL
        DEC HL
        LD (BIOBASE),HL

        LD A,(TAIL)
        OR A
        JR Z,INTERACTIVE
        CALL PARSEARGS
        OR A
        JP Z,INPUTREADY
        CP 1
        JP Z,USAGEBAD
        CP 2
        JP Z,PKGBAD
        JP SOURCEBAD

INTERACTIVE:
        XOR A
        LD (SOURCEDEV),A
AGAIN:  LD HL,TITLE
        CALL HEADER
        LD HL,ASKDRV
        CALL PUTS
        CALL KEY
        CP 3
        JP Z,0
        SUB 'B'
        CP 3
        JR NC,AGAIN
        INC A                 ; B..D become logical numbers 1..3
        LD (DEST),A
        CALL SHOWKEY
        CALL LOADDISK
        JP NZ,IOFAIL
        JP INPUTREADY

; Accept either SYSTEM.SYS <drive>: or <source>: <destination>: using the
; two default FCBs prepared by the CCP.
PARSEARGS:
        LD HL,FCB1+1
        LD DE,SYSNAME
        LD B,11
PANAME: LD A,(DE)
        CP (HL)
        JR NZ,PADRIVES
        INC DE
        INC HL
        DJNZ PANAME
        LD A,(FCB2)
        DEC A
        CP 4
        JR NC,PABAD
        OR A
        JR Z,PABAD
        LD (DEST),A
        LD A,1
        LD (FILEMODE),A
        JP LOADFILE
PADRIVES:
        LD A,(TAIL)
        LD C,A
        LD HL,TAIL+1
        CALL PASKIP
        JR C,PABAD
        LD A,(HL)
        INC HL
        DEC C
        AND 05FH
        SUB 'A'
        CP 4
        JR NC,PABAD
        LD (SOURCEDEV),A
        LD A,C
        OR A
        JR Z,PABAD
        LD A,(HL)
        INC HL
        DEC C
        CP ':'
        JR NZ,PABAD
        CALL PASKIP
        JR C,PABAD
        LD A,(HL)
        INC HL
        DEC C
        AND 05FH
        SUB 'A'
        CP 4
        JR NC,PABAD
        OR A
        JR Z,PABAD
        LD (DEST),A
        LD A,C
        OR A
        JR Z,PABAD
        LD A,(HL)
        INC HL
        DEC C
        CP ':'
        JR NZ,PABAD
        CALL PASKIP
        JR NC,PABAD
        CALL LOADDISK
        RET Z
        LD (STATUS),A
        LD A,3
        OR A
        RET
PABAD:  LD A,1
        OR A
        RET

; Skip spaces in the counted command tail. Carry means end of input.
PASKIP:LD A,C
        OR A
        SCF
        RET Z
        LD A,(HL)
        CP ' '
        JR NZ,PANONSP
        INC HL
        DEC C
        JR PASKIP
PANONSP:OR A                    ; clear carry while input remains
        RET

; Read and validate the version-1, TRS-80 SYSTEM.SYS package.
LOADFILE:
        LD DE,FCB1
        LD C,15
        CALL BDOS
        INC A
        JR Z,LFERR
        LD DE,PKGHEADER
        LD C,26
        CALL BDOS
        LD DE,FCB1
        LD C,20
        CALL BDOS
        OR A
        JR NZ,LFERR
        LD HL,PKGHEADER
        LD DE,PKGMAGIC
        LD B,10
LFCMP:  LD A,(DE)
        CP (HL)
        JR NZ,LFERR
        INC DE
        INC HL
        DJNZ LFCMP
        LD HL,PKGHEADER+16
        LD DE,SOURCE
        LD BC,64
        LDIR
        LD HL,IMAGE
        LD B,SYSRECS
LFRD:   PUSH BC
        PUSH HL
        EX DE,HL
        LD C,26
        CALL BDOS
        LD DE,FCB1
        LD C,20
        CALL BDOS
        POP HL
        POP BC
        OR A
        JR NZ,LFERR
        LD DE,128
        ADD HL,DE
        DJNZ LFRD
        LD DE,FCB1
        LD C,20
        CALL BDOS
        CP 1
        JR NZ,LFERR
        LD DE,FCB1
        LD C,16
        CALL BDOS
        XOR A
        RET
LFERR:  LD A,2
        OR A
        RET

; Buffer the canonical 160-record protected package from a bootable source.
LOADDISK:
        LD HL,0
        LD (RECNO),HL
        LD A,(SOURCEDEV)
        LD (REQ),A
        LD DE,REQ
        LD B,3
        CALL API
        JR NZ,LDAPIBAD
        LD HL,REQ+1
        LD DE,SOURCE
        LD BC,64
        LDIR
        LD BC,(SOURCE+1)
        LD DE,(SOURCE+14)
        CALL RESCOUNT
        JR C,LDSIZEBAD
        LD DE,SYSRECS
        OR A
        SBC HL,DE
        JR NC,LDSIZEOK
        JR C,LDSIZEBAD
LDSIZEOK:
        LD A,1
        LD (NEEDREAD),A
        XOR A
        RET

READSOURCE:
; Start at record one, matching the proven installer path.  This also gives
; real floppy hardware a normal sector transfer before revisiting the boot
; sector at record zero.
        LD HL,1
        LD (RECNO),HL
LDRD:   LD HL,(RECNO)
        LD DE,BUFFER
        XOR A
        CALL DISKIO
        JR NZ,LDIOBAD
        LD HL,(RECNO)
        CALL IMAGEPTR
        LD HL,BUFFER
        LD BC,128
        LDIR
        LD HL,(RECNO)
        INC HL
        LD (RECNO),HL
        LD DE,SYSRECS
        OR A
        SBC HL,DE
        JR C,LDRD
        LD HL,0
        LD (RECNO),HL
        LD DE,BUFFER
        XOR A
        CALL DISKIO
        JR NZ,LDIOBAD
        LD HL,(RECNO)
        CALL IMAGEPTR
        LD HL,BUFFER
        LD BC,128
        LDIR
        XOR A
        RET
LDAPIBAD:LD A,11
        OR A
        RET
LDSIZEBAD:LD A,12
        OR A
        RET
LDIOBAD:ADD A,20
        OR A
        RET

; BC=records/track, DE=reserved tracks. Return HL=records, carry on overflow.
RESCOUNT:
        LD HL,0
RCLP:   LD A,D
        OR E
        RET Z
        ADD HL,BC
        RET C
        DEC DE
        JR RCLP

INPUTREADY:
        LD A,(DEST)
        LD (REQ),A
        LD DE,REQ
        LD B,3
        CALL API
        JP NZ,APIBAD
        LD HL,REQ+1
        LD DE,TARGET
        LD BC,64
        LDIR
        LD A,(TARGET)
        OR A
        JP Z,PROTECT
        CP 4
        JP NC,APIBAD
        LD B,A
        LD A,(SOURCE)
        CP B
        JR NZ,GEOMETRY
        LD A,(FILEMODE)
        OR A
        JP Z,ALIAS

GEOMETRY:
; Bootstrap A: expresses a double-sided cylinder as one logical track.
; CONFIG's ordinary bindings express the same disk as two surface tracks.
; Make a comparison copy in the latter form, as DUP has done since 1.10.
        LD HL,SOURCE
        LD DE,EXPECT
        LD BC,64
        LDIR
        LD A,(EXPECT+19)
        BIT 5,A
        JR Z,CMPFMT
        AND 0DFH
        OR 040H
        LD (EXPECT+19),A
        LD HL,(EXPECT+1)
        SRL H
        RR L
        LD (EXPECT+1),HL
        LD HL,(EXPECT+14)
        ADD HL,HL
        LD (EXPECT+14),HL
CMPFMT:LD HL,EXPECT+16
        LD DE,TARGET+16
        LD B,45               ; compare boot geometry, IDs and size map only
CMPLP:  LD A,(DE)
        CP (HL)
        JP NZ,BOOTFMT
        INC DE
        INC HL
        DJNZ CMPLP

; Destination reserved records = SPT * OFF and must hold the canonical
; payload. A larger reserved area is allowed and is left otherwise untouched.
        LD BC,(TARGET+1)
        LD DE,(TARGET+14)
        LD HL,0
COUNTLP:LD A,D
        OR E
        JR Z,COUNTED
        ADD HL,BC
        JP C,NOSPACE
        DEC DE
        JR COUNTLP
COUNTED:LD A,H
        OR L
        JP Z,NOSPACE
        LD DE,SYSRECS
        OR A
        SBC HL,DE
        JP C,NOSPACE
        LD HL,SYSRECS
        LD (NRECS),HL
        LD HL,SUMMARY
        CALL PUTS
        LD A,(DEST)
        ADD A,'A'
        CALL PUTC
        LD HL,PHYMSG
        CALL PUTS
        LD A,(TARGET)
        CALL DECOUT
        CALL CRLF
        LD HL,RECORDMSG
        CALL PUTS
        LD HL,(NRECS)
        CALL WORDOUT
        CALL CRLF
        LD HL,WARNING
        CALL PUTS
        CALL KEY
        CP 'Y'
        JP NZ,0
        CALL CRLF
        LD A,(NEEDREAD)
        OR A
        JR Z,IMAGEOK
        CALL READSOURCE
        JR Z,IMAGEOK
        LD (STATUS),A
        JP SOURCEBAD
IMAGEOK:
        CALL PATCHTARGET
        JP NZ,PKGBAD
        JP WRIMAGE

; Patch the package's installed physical drive zero and A: binding to the
; destination definition. The disk-facing binding uses one track per surface;
; the bootstrap binding uses one track per cylinder on a double-sided disk.
PATCHTARGET:
        LD A,(TARGET)
        LD (REQ),A
        LD DE,REQ
        LD B,1
        CALL API
        RET NZ
        LD A,(REQ+1)
        CP 5
        JR NZ,PTBAD
        CALL FINDDESC
        RET NZ
        LD (DESCPTR),HL
        LD DE,8
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        EX DE,HL
        CALL ABSTOIMG
        LD DE,REQ+1
        EX DE,HL
        LD BC,6
        LDIR
        LD HL,TARGET
        LD DE,BOOTBIND
        LD BC,64
        LDIR
        XOR A
        LD (BOOTBIND),A
        LD A,(BOOTBIND+19)
        BIT 6,A
        JR Z,PTBIND
        AND 0BFH
        OR 020H
        LD (BOOTBIND+19),A
        LD HL,(BOOTBIND+1)
        ADD HL,HL
        JR C,PTBAD
        LD (BOOTBIND+1),HL
        LD HL,(BOOTBIND+14)
        BIT 0,L
        JR NZ,PTBAD
        SRL H
        RR L
        LD (BOOTBIND+14),HL
PTBIND:LD HL,(DESCPTR)
        LD DE,10
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        EX DE,HL
        CALL ABSTOIMG
        LD DE,16
        ADD HL,DE
        LD DE,BOOTBIND
        EX DE,HL
        LD BC,64
        LDIR
        XOR A
        RET
PTBAD:  LD A,1
        OR A
        RET

ABSTOIMG:
        LD DE,SYSBASE
        OR A
        SBC HL,DE
        LD DE,IMAGE+1024
        ADD HL,DE
        RET

FINDDESC:
        LD HL,IMAGE+1024
        LD BC,52*128-12
FDLOOP:LD A,(HL)
        CP 'B'
        JR NZ,FDNEXT
        INC HL
        LD A,(HL)
        CP 'D'
        JR NZ,FDBACK1
        INC HL
        LD A,(HL)
        CP 'C'
        JR NZ,FDBACK2
        INC HL
        LD A,(HL)
        CP 'F'
        JR NZ,FDBACK3
        DEC HL
        DEC HL
        DEC HL
        XOR A
        RET
FDBACK3:DEC HL
FDBACK2:DEC HL
FDBACK1:DEC HL
FDNEXT: INC HL
        DEC BC
        LD A,B
        OR C
        JR NZ,FDLOOP
        LD A,1
        OR A
        RET

; Copy records 1 through N-1 first.  Record zero, containing stage zero,
; is installed only after the rest has passed immediate read-back checks.
WRIMAGE:
        LD HL,1
        LD (RECNO),HL
        LD HL,0
        LD (TRACKNO),HL
        LD HL,1
        LD (NEXTTRK),HL
COPYLP: CALL BREAKCK
        JP Z,STOPPED
        CALL PROGRESS
        CALL COPYREC
        JP NZ,IOFAIL
        LD HL,(RECNO)
        INC HL
        LD (RECNO),HL
        LD DE,(NRECS)
        OR A
        SBC HL,DE
        JR C,COPYLP
        LD HL,0
        LD (RECNO),HL
        CALL COPYREC
        JP NZ,IOFAIL
        LD DE,0FFFFH          ; discard every logged-drive vector
        LD C,37
        CALL BDOS
        LD HL,COMPLETE
        CALL PUTS
        JP 0

; Write buffered source, read target again, and compare all 128 bytes.
COPYREC:LD HL,(RECNO)
        CALL IMAGEPTR
        EX DE,HL
        LD DE,BUFFER
        LD BC,128
        LDIR
        LD A,1
        LD HL,(RECNO)
        LD DE,BUFFER
        CALL DISKIO
        RET NZ
        LD A,2
        LD HL,(RECNO)
        LD DE,VERIFY
        CALL DISKIO
        RET NZ
        LD HL,BUFFER
        LD DE,VERIFY
        LD B,128
VERIFYLP:LD A,(DE)
        CP (HL)
        JR NZ,VERIFYBAD
        INC DE
        INC HL
        DJNZ VERIFYLP
        XOR A
        RET
VERIFYBAD:LD A,0FEH           ; utility compare error, not controller status
        OR A
        RET

; Convert a logical package record in HL to its transient address in DE.
IMAGEPTR:
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        LD DE,IMAGE
        ADD HL,DE
        EX DE,HL
        RET

; A=0 reads A:.  A=1 writes destination.  A=2 reads destination.
; HL is the 128-byte logical record number and DE is its transfer buffer.
DISKIO: LD (IOMODE),A
        LD (IOREC),HL
        LD (IOBUF),DE
        OR A
        JR NZ,IOTARGET
        LD A,(SOURCEDEV)
        JR IODRIVE
IOTARGET:
        LD A,(DEST)
IODRIVE:LD (IODRV),A
        LD C,A
        LD B,0
        LD E,0
        LD A,27
        CALL BCALL
        LD A,H
        OR L
        JR Z,SELECTBAD
        LD DE,10
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        LD HL,(IOREC)
        LD A,(DE)             ; DPB+0 = logical records per track
        LD C,A
        INC DE
        LD A,(DE)
        LD B,A
        LD DE,0
DIVLP:  OR A
        SBC HL,BC
        JR C,DIVDONE
        INC DE
        JR DIVLP
DIVDONE:ADD HL,BC
        PUSH HL               ; remainder is sector number
        EX DE,HL              ; quotient is track number
        LD B,H
        LD C,L
        LD A,30
        CALL BCALL
        POP BC
        LD A,33
        CALL BCALL
        LD BC,(IOBUF)
        LD A,36
        CALL BCALL
        LD A,(IOMODE)
        CP 1
        LD A,39
        JR NZ,IOGO
        LD BC,0
        LD A,42
IOGO:   CALL BCALL
        OR A
        RET
SELECTBAD:LD A,0FFH
        OR A
        RET

; Show progress once per A: logical track rather than scrolling 160 lines.
PROGRESS:LD HL,(RECNO)
        LD DE,(NEXTTRK)
        OR A
        SBC HL,DE
        RET NZ
        LD HL,INSTALLING
        CALL PUTS
        LD HL,(TRACKNO)
        CALL WORDOUT
        CALL CRLF
        LD HL,(TRACKNO)
        INC HL
        LD (TRACKNO),HL
        LD HL,(NEXTTRK)
        LD DE,(TARGET+1)
        ADD HL,DE
        LD (NEXTTRK),HL
        RET

BREAKCK:LD C,6
        LD E,0FFH
        CALL BDOS
        CP 3
        RET

IOFAIL:LD (STATUS),A
        LD HL,FAILMSG
        CALL PUTS
        LD HL,(RECNO)
        CALL WORDOUT
        LD HL,STATUSMSG
        CALL PUTS
        LD A,(STATUS)
        CALL DECOUT
        CALL CRLF
        LD HL,PARTIAL
        CALL PUTS
        JP 0
STOPPED:LD HL,STOPMSG
        CALL PUTS
        JP 0
BADFMT:LD HL,FMTMSG
        JR REPORT
BOOTFMT:LD HL,BOOTMSG
        JR REPORT
NOSPACE:LD HL,SPACEMSG
        JR REPORT
PKGBAD:LD HL,PKGMSG
        JR REPORT
SOURCEBAD:LD HL,SOURCEMSG
        CALL PUTS
        LD A,(SOURCEDEV)
        ADD A,'A'
        CALL PUTC
        LD A,':'
        CALL PUTC
        LD A,' '
        CALL PUTC
        LD HL,(RECNO)
        CALL WORDOUT
        LD HL,STATUSMSG
        CALL PUTS
        LD A,(STATUS)
        CALL DECOUT
        CALL CRLF
        JP 0
USAGEBAD:LD HL,USAGEMSG
        JR REPORT
PROTECT:LD HL,PROTMSG
        JR REPORT
ALIAS:  LD HL,ALIASMSG
        JR REPORT
APIBAD: LD HL,APIERR
REPORT: CALL PUTS
        JP 0

; The utility ABI keeps SYSGEN independent of the installed BIOS address.
API:    LD C,207
        CALL BDOS
        LD A,L
        OR A
        RET
INIT:   LD B,0
        LD DE,REQ
        CALL API
        LD DE,MAGIC
        LD B,8
ABICMP: LD A,(DE)
        CP (HL)
        JP NZ,NOABI
        INC DE
        INC HL
        DJNZ ABICMP
        LD C,204
        LD E,0
        CALL BDOS
        LD (HASREV),A
        RET
NOABI:  LD HL,ABIMSG
        CALL PUTS
        JP 0
BCALL:  LD HL,(BIOBASE)
        PUSH DE
        LD E,A
        LD D,0
        ADD HL,DE
        POP DE
        JP (HL)

; Plain CP/M console service.  Strings end in zero.
PUTC:   PUSH AF
        PUSH BC
        PUSH DE
        PUSH HL
        LD E,A
        LD C,2
        CALL BDOS
        POP HL
        POP DE
        POP BC
        POP AF
        RET
PUTS:   LD A,(HL)
        INC HL
        OR A
        RET Z
        CALL PUTC
        JR PUTS
CRLF:   LD A,13
        CALL PUTC
        LD A,10
        JP PUTC
KEY:    LD C,6
        LD E,0FFH
        CALL BDOS
        OR A
        JR Z,KEY
        CP 'a'
        RET C
        CP 'z'+1
        RET NC
        AND 05FH
        RET
SHOWKEY:PUSH AF
        LD A,' '
        CALL PUTC
        POP AF
        PUSH AF
        ADD A,'A'
        CALL PUTC
        CALL CRLF
        POP AF
        RET
DECOUT: LD C,0
        LD B,100
        CALL DECDIG
        LD B,10
        CALL DECDIG
        ADD A,'0'
        JP PUTC
DECDIG: LD D,'0'
DECLP:  CP B
        JR C,DECDONE
        SUB B
        INC D
        JR DECLP
DECDONE:PUSH AF
        LD A,D
        CP '0'
        JR NZ,DECSHOW
        LD A,C
        OR A
        JR Z,DECSKIP
        LD A,D
DECSHOW:CALL PUTC
        LD C,1
DECSKIP:POP AF
        RET
WORDOUT:LD C,0
        LD DE,10000
        CALL WDIG
        LD DE,1000
        CALL WDIG
        LD DE,100
        CALL WDIG
        LD DE,10
        CALL WDIG
        LD A,L
        ADD A,'0'
        JP PUTC
WDIG:   LD B,'0'
WDIGLP:OR A
        SBC HL,DE
        JR C,WDIGDONE
        INC B
        JR WDIGLP
WDIGDONE:ADD HL,DE
        LD A,B
        CP '0'
        JR NZ,WDIGSHOW
        LD A,C
        OR A
        RET Z
        LD A,B
WDIGSHOW:PUSH HL
        CALL PUTC
        POP HL
        LD C,1
        RET
HEADER: LD A,28
        CALL PUTC
        LD B,79
HEADLP: LD A,(HL)
        OR A
        JR Z,HEADSP
        INC HL
        JR HEADOUT
HEADSP: LD A,' '
HEADOUT:PUSH AF
        LD A,(HASREV)
        OR A
        JR NZ,HEADREV
        POP AF
        CALL PUTC
        JR HEADNEXT
HEADREV:POP AF
        PUSH AF
        PUSH BC
        PUSH DE
        PUSH HL
        LD E,A
        LD C,204
        CALL BDOS
        POP HL
        POP DE
        POP BC
        POP AF
HEADNEXT:
        DJNZ HEADLP
        CALL CRLF
        JP CRLF

TITLE:  DB 'Install a BetterCP/M system (SYSGEN)',0
ASKDRV: DB 'Destination drive [ B - D ], or BREAK (^C) to exit: ',0
SUMMARY:DB 13,10,'Install the selected BetterCP/M system on drive ',0
PHYMSG: DB ':, physical drive ',0
RECORDMSG:DB 'Reserved system records to copy and verify: ',0
WARNING:DB 13,10,'The destination system area will be replaced.',13,10
        DB 'Files outside the reserved system tracks will be preserved.',13,10
        DB 'Proceed (Y/N)? ',0
INSTALLING:DB 'Installing system track ',0
COMPLETE:DB 13,10,'System installed and verified. The destination is bootable.',13,10,0
FMTMSG: DB 13,10,'The selected system format is invalid.',13,10,0
BOOTMSG:DB 13,10,'Destination bootstrap geometry is not supported by this system package.',13,10,0
SPACEMSG:DB 13,10,'Destination reserved system area is too small (160 records required).',13,10,0
PKGMSG:DB 13,10,'The system package is invalid or cannot represent the destination.',13,10,0
SOURCEMSG:DB 13,10,'Source system read failed at logical record ',0
USAGEMSG:DB 13,10,'Usage: SYSGEN, SYSGEN A: B:, or SYSGEN SYSTEM.SYS B:',13,10,0
PROTMSG:DB 13,10,'Physical drive 0 is protected as the running system disk.',13,10,0
ALIASMSG:DB 13,10,'Source and destination refer to the same physical drive.',13,10,0
APIERR: DB 13,10,'The selected drive is undefined or unavailable.',13,10,0
FAILMSG:DB 13,10,'System installation failed at logical record ',0
STATUSMSG:DB '; status ',0
PARTIAL:DB 'The destination may not boot. Its file area was not changed.',13,10,0
STOPMSG:DB 13,10,'Installation stopped. The destination may not boot.',13,10
        DB 'Its file area was not changed.',13,10,0
ABIMSG:DB 'SYSGEN requires BetterCP/M disk BIOS ABI 5.',13,10,0
MAGIC:  DB 'BDCF',5,4,4,64
SYSNAME:DB 'SYSTEM  SYS'
PKGMAGIC:DB 'BCSY',1,1,160,0,0C4H,0D5H

DEST:   DB 0
SOURCEDEV:DB 0
FILEMODE:DB 0
NEEDREAD:DB 0
STATUS: DB 0
IOMODE: DB 0
IODRV:  DB 0
HASREV: DB 0
BIOBASE:DW 0
NRECS:  DW 0
RECNO:  DW 0
IOREC:  DW 0
IOBUF:  DW 0
TRACKNO:DW 0
NEXTTRK:DW 0
DESCPTR:DW 0
SOURCE: DS 64
TARGET: DS 64
EXPECT: DS 64
BOOTBIND:DS 64
REQ:    DS 80
        END
