; ********************************************************************************
; *                         BetterCP/M XSUB Utility                              *
; *                                                                              *
; * CP/M 2.2 XSUB installer. Loads the protected BATCHIO BRSX, replacing DRI's  *
; * CCP-relative self-relocation with a reconstruction-safe resident input      *
; * provider.                                                                    *
; ********************************************************************************


BDOS            EQU     0005H
RSXFUNC         EQU     177

        CSEG
        .PHASE  0100H

; ================================================================================
; =                             BATCHIO Installation                             =
; =                                                                              =
; = Checks whether the protected XSUB-compatible provider is already active.    =
; = If absent, submits a Function-177 request to load BATCHIO into the ordered   =
; = RSX profile.                                                                =
; ================================================================================
; -------------------------------------------------------------------------------
; Presence Check and Load
; -------------------------------------------------------------------------------

XS_START:                               ; enter XSUB installer
        CALL    UV_CHECK                ; standalone utility identity
        ; Queries have already returned; these commands accept no operands.
        LD      A,(0080H)
        CP      128
        JR      NC,ARG_BAD
        OR      A
        JR      Z,ARG_OK
        LD      B,A
        LD      HL,0081H
ARG_SCAN:
        LD      A,(HL)
        CP      ' '
        JR      Z,ARG_NEXT
        CP      9
        JR      NZ,ARG_BAD
ARG_NEXT:
        INC     HL
        DJNZ    ARG_SCAN
        JR      ARG_OK
ARG_BAD:
        LD      DE,ARG_MSG
        LD      C,9
        JP      BDOS
ARG_OK:
  ; Preserve the CCP's transient return frame. Function 177 temporarily moves
  ; its own manager frame, and the CCP must reconstruct the newly committed
  ; chain before BATCHIO receives another public BDOS call.
        CALL    XS_WORKSPACE
        LD      DE,XS_REQUEST
        LD      C,RSXFUNC
        CALL    BDOS
        CP      1
        JR      Z,XS_PRESENT
        OR      A
        JR      NZ,XS_FAILURE
        LD      A,1
        LD      (XS_REQUEST+1),A
        LD      DE,XS_REQUEST
        LD      C,RSXFUNC
        CALL    BDOS
        OR      A
        JR      NZ,XS_FAILURE

XS_DONE:                                ; finish successful XSUB installation
  ; Returning through the CCP performs WBOOT reconstruction before the fresh
  ; provider can intercept a call. Calling BDOS here would enter BATCHIO while
  ; its prepared live-chain link still awaits reconstruction.
        RET

XS_PRESENT:                             ; report XSUB already active
        LD      DE,XS_ALREADY
        JR      XS_PRINT

XS_FAILURE:                             ; report BATCHIO load failure
        LD      DE,XS_LOADERR

XS_PRINT:                               ; print installer message
        LD      C,9
        CALL    BDOS
        JR      XS_DONE

XS_WORKSPACE:                           ; publish caller-owned transaction space
        LD      HL,XS_END
        LD      (XS_REQUEST+14),HL
        LD      HL,0
        ADD     HL,SP
        LD      BC,64
        OR      A
        SBC     HL,BC
        LD      DE,(0006H)
        PUSH    HL
        OR      A
        SBC     HL,DE
        POP     HL
        JR      C,XS_WHIGH
        EX      DE,HL

XS_WHIGH:                               ; bound scratch below TPA and stack
        LD      (XS_REQUEST+16),HL
        RET

; ================================================================================
; =                           Installer Data and State                           =
; =                                                                              =
; = Defines the BATCHIO load request, transaction bounds, and result messages   =
; = used by the XSUB installer.                                                  =
; ================================================================================
; -------------------------------------------------------------------------------
; Request, Messages, and Stack
; -------------------------------------------------------------------------------

XS_REQUEST:     DB      2,3,0,0,'BATCHIO ',0,0,0,0,0,0 ; Function-177 request
XS_ALREADY:     DB      13,10,'Xsub Already Present','$' ; already-active message
XS_LOADERR:     DB      13,10,'Xsub Load Error','$' ; load-failure message
ARG_MSG: DB 'Invalid usage.',13,10,'Use XSUB /HELP.',13,10,'$'

XS_END:                                 ; end of caller-owned program image
; @utility-version XSUB@

        .DEPHASE
        END
