; ********************************************************************************
; *                         BetterCP/M XSUB Utility                              *
; *                                                                              *
; * CP/M 2.2 XSUB installer. Loads the protected BATCHIO BRSX, replacing DRI's  *
; * CCP-relative self-relocation with a reconstruction-safe resident input      *
; * provider.                                                                    *
; ********************************************************************************


BDOS            EQU     0005H
RSXFUNC         EQU     177

        CSEG
        .PHASE  0100H

; ================================================================================
; =                             BATCHIO Installation                             =
; =                                                                              =
; = Checks whether the protected XSUB-compatible provider is already active.    =
; = If absent, submits a Function-177 request to load BATCHIO into the ordered   =
; = RSX profile.                                                                =
; ================================================================================
; -------------------------------------------------------------------------------
; Presence Check and Load
; -------------------------------------------------------------------------------

XS_START:                               ; enter XSUB installer
        LD      SP,(0006H)              ; own the top-of-TPA transient stack
        CALL    XS_WORKSPACE
        LD      DE,XS_REQUEST
        LD      C,RSXFUNC
        CALL    BDOS
        CP      1
        JR      Z,XS_PRESENT
        OR      A
        JR      NZ,XS_FAILURE
        LD      A,1
        LD      (XS_REQUEST+1),A
        LD      DE,XS_REQUEST
        LD      C,RSXFUNC
        CALL    BDOS
        OR      A
        JR      NZ,XS_FAILURE
        LD      A,3
        LD      (XS_REQUEST+1),A
        LD      C,RSXFUNC               ; suppress only this install-time announcement
        CALL    BDOS                    ; later WBOOT reconstruction starts fresh again

XS_DONE:                                ; finish successful XSUB installation
        LD      C,0
        JP      BDOS

XS_PRESENT:                             ; report XSUB already active
        LD      DE,XS_ALREADY
        JR      XS_PRINT

XS_FAILURE:                             ; report BATCHIO load failure
        LD      DE,XS_LOADERR

XS_PRINT:                               ; print installer message
        LD      C,9
        CALL    BDOS
        JR      XS_DONE

XS_WORKSPACE:                           ; publish caller-owned transaction space
        LD      HL,XS_END
        LD      (XS_REQUEST+14),HL
        LD      HL,0
        ADD     HL,SP
        LD      BC,64
        OR      A
        SBC     HL,BC
        LD      DE,(0006H)
        PUSH    HL
        OR      A
        SBC     HL,DE
        POP     HL
        JR      C,XS_WHIGH
        EX      DE,HL

XS_WHIGH:                               ; bound scratch below TPA and stack
        LD      (XS_REQUEST+16),HL
        RET

; ================================================================================
; =                           Installer Data and State                           =
; =                                                                              =
; = Defines the BATCHIO load request, transaction bounds, and result messages   =
; = used by the XSUB installer.                                                  =
; ================================================================================
; -------------------------------------------------------------------------------
; Request, Messages, and Stack
; -------------------------------------------------------------------------------

XS_REQUEST:     DB      2,3,0,0,'BATCHIO ',0,0,0,0,0,0 ; Function-177 request
XS_ALREADY:     DB      13,10,'Xsub Already Present','$' ; already-active message
XS_LOADERR:     DB      13,10,'Xsub Load Error','$' ; load-failure message
XS_END:                                 ; end of caller-owned program image
        .DEPHASE
        END
