; ********************************************************************************
; *                           BetterCP/M STAT Utility                            *
; *                                                                              *
; * CP/M 2.2 status utility with numeric drive/user syntax and a BetterCP/M MEM  *
; * report. Ordinary operations use documented CP/M BDOS calls; MEM combines     *
; * fixed layout.inc boundaries with the validated live extension descriptor.    *
; ********************************************************************************


        INCLUDE layout.inc

BDOS            EQU     0005H
TAIL            EQU     0080H
DMA             EQU     0080H
ECB             EQU     LY_SYS+080H

        CSEG
        .PHASE  0103H

; ================================================================================
; =                      STAT Command Parsing and Dispatch                       =
; =                                                                              =
; = Parses the STAT command tail, recognizes MEM/VAL/USR/DEV/DSK and filespec forms, =
; = and preserves/restores temporary drive/user selections around each operation. =
; ================================================================================
; -------------------------------------------------------------------------------
; Command Recognition
; -------------------------------------------------------------------------------

START:                                  ; enter STAT utility
        LD      (OLDSP),SP
        LD      SP,STACKTOP
        LD      C,25
        CALL    BDOS
        LD      (SAVEDRV),A
        LD      E,0FFH
        LD      C,32
        CALL    BDOS
        LD      (SAVEUSR),A
        LD      A,(TAIL)
        LD      B,A
        LD      HL,TAIL+1
        CALL    TRIM
        LD      A,B
        OR      A
        JP      Z,DISKSTATUS
        CALL    ISMEM
        JP      Z,MEMREPORT
        CALL    ISVAL
        JP      Z,VALUES
        CALL    ISUSR
        JP      Z,USERSTATUS
        CALL    ISDEV
        JP      Z,DEVSTATUS
        CALL    ISDSK
        JP      Z,DRIVEDETAILS
        CALL    DEVICEASSIGN
        JP      C,FINISH
        CALL    PARSEDU
        JP      C,BADFORM
        CALL    TRIM
        LD      A,B
        OR      A
        JP      Z,SPACEONLY
        CALL    ISDSK
        JP      Z,DRIVEDETAILS
        LD      A,(HL)
        CP      '='
        JP      Z,DISKASSIGN
        CALL    PARSEFCB
        JP      C,BADFORM
        CALL    FILEOPTION
        CALL    FILES
        JP      FINISH

  ; Remove leading spaces. HL/B remain the unconsumed command.

; -------------------------------------------------------------------------------
; Command-Tail Trimming
; -------------------------------------------------------------------------------

TRIM:                                   ; trim leading command spaces
        LD      A,B
        OR      A
        RET     Z
        LD      A,(HL)
        CP      ' '
        RET     NZ
        INC     HL
        DEC     B
        JR      TRIM

  ; Exact-token recognizers leave Z set only for the complete token.

ISMEM:  LD      DE,KMEM                 ; ismem
        LD      C,3
        JR      ISEXACT

ISVAL:  LD      DE,KVAL                 ; isval
        LD      C,4
        JR      ISEXACT

ISUSR:  LD      DE,KUSR                 ; isusr
        LD      C,4
        JR      ISEXACT

ISDEV:  LD      DE,KDEV                 ; isdev
        LD      C,4
        JR      ISEXACT

ISDSK:  LD      DE,KDSK                 ; isdsk
        LD      C,4

; -------------------------------------------------------------------------------
; Exact Keyword Match
; -------------------------------------------------------------------------------

ISEXACT:                                ; isexact
        LD      A,B
        CP      C
        RET     NZ
        PUSH    HL
        PUSH    BC

IXLOOP: LD      A,(DE)                  ; ixloop
        CP      (HL)
        JR      NZ,IXNO
        INC     DE
        INC     HL
        DEC     C
        JR      NZ,IXLOOP
        POP     BC
        POP     HL
        XOR     A
        RET

IXNO:   POP     BC                      ; ixno
        POP     HL
        LD      A,1
        OR      A
        RET

  ; Parse A:, 5:, or C3: at the beginning of an operand. Selection is temporary.
  ; Carry means a colon form was attempted but invalid. No colon means no DU.

; ================================================================================
; =                       Drive/User and Filespec Parsing                        =
; =                                                                              =
; = Parses direct drive/user prefixes and CP/M 8.3 wildcard filespecs used by the disk =
; = and file-status operations.                                                  =
; ================================================================================
; -------------------------------------------------------------------------------
; Drive/User Prefix
; -------------------------------------------------------------------------------

PARSEDU:                                ; parse drive/user prefix
        LD      (ARGPTR),HL
        LD      A,B
        LD      (ARGLEN),A
        LD      A,0FFH
        LD      (NEWDRV),A
        LD      (NEWUSR),A
        LD      C,0
        LD      A,B
        OR      A
        RET     Z
        LD      A,(HL)
        CP      'A'
        JR      C,PDUUSER
        CP      'P'+1
        JR      NC,PDUNONE
        SUB     'A'
        LD      (NEWDRV),A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JR      Z,PDUNONE
        LD      A,(HL)
        CP      ':'
        JR      Z,PDUAPPLY

PDUUSER:                                ; pduuser
        LD      A,(HL)
        CP      '0'
        JR      C,PDUNONE
        CP      '9'+1
        JR      NC,PDUNONE
        SUB     '0'
        LD      C,A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JR      Z,PDUBAD
        LD      A,(HL)
        CP      ':'
        JR      Z,PDUSETU
        CP      '0'
        JR      C,PDUBAD
        CP      '9'+1
        JR      NC,PDUBAD
        LD      A,C
        ADD     A,A
        LD      D,A
        ADD     A,A
        ADD     A,A
        ADD     A,D
        LD      C,A
        LD      A,(HL)
        SUB     '0'
        ADD     A,C
        CP      32
        JR      NC,PDUBAD
        LD      C,A
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        JR      Z,PDUBAD
        LD      A,(HL)
        CP      ':'
        JR      NZ,PDUBAD

PDUSETU:                                ; pdusetu
        LD      A,C
        LD      (NEWUSR),A

PDUAPPLY:                               ; pduapply
        INC     HL
        DEC     B
        LD      A,(NEWDRV)
        CP      0FFH
        JR      Z,PDUAU
        LD      E,A
        LD      C,14
        PUSH    HL
        PUSH    BC
        CALL    BDOS
        POP     BC
        POP     HL
        CP      0FFH
        JR      Z,PDUBAD

PDUAU:  LD      A,(NEWUSR)              ; pduau
        CP      0FFH
        JR      Z,PDUOK
        LD      E,A
        LD      C,32
        PUSH    HL
        PUSH    BC
        CALL    BDOS
        POP     BC
        POP     HL

PDUOK:  OR      A                       ; pduok
        RET

PDUNONE:                                ; pdunone
        LD      HL,(ARGPTR)
        LD      A,(ARGLEN)
        LD      B,A
        OR      A
        RET

PDUBAD: SCF                             ; pdubad
        RET

  ; Parse one CP/M 8.3 wildcard filespec into FCB. Stops before SPACE or '$'.

; -------------------------------------------------------------------------------
; CP/M Filespec Parser
; -------------------------------------------------------------------------------

PARSEFCB:                               ; parse CP/M filespec
        PUSH    HL
        LD      HL,FCB
        LD      C,36
        XOR     A

PFCLR:  LD      (HL),A                  ; pfclr
        INC     HL
        DEC     C
        JR      NZ,PFCLR
        LD      HL,FCB+1
        LD      C,11
        LD      A,' '

PFSPACE:LD      (HL),A                  ; pfspace
        INC     HL
        DEC     C
        JR      NZ,PFSPACE
        POP     HL
        LD      DE,FCB+1
        LD      C,8
        XOR     A
        LD      (NAMECNT),A

PFNAME: LD      A,B                     ; pfname
        OR      A
        JR      Z,PFDONE
        LD      A,(HL)
        CP      ' '
        JR      Z,PFDONE
        CP      '$'
        JR      Z,PFDONE
        CP      '.'
        JR      Z,PFEXT
        CP      '*'
        JR      Z,PFSTAR
        CP      '?'
        JR      Z,PFPUT
        CP      '!'
        JR      C,PFBAD
        CP      ':'
        JR      Z,PFBAD

PFPUT:  LD      (DE),A                  ; pfput
        INC     DE
        INC     HL
        DEC     B
        LD      A,(NAMECNT)
        INC     A
        LD      (NAMECNT),A
        DEC     C
        JR      NZ,PFNAME
        LD      A,B
        OR      A
        JR      Z,PFDONE
        LD      A,(HL)
        CP      '.'
        JR      NZ,PFBAD

PFEXT:  INC     HL                      ; pfext
        DEC     B
        LD      DE,FCB+9
        LD      C,3

PFELP:  LD      A,B                     ; pfelp
        OR      A
        JR      Z,PFDONE
        LD      A,(HL)
        CP      ' '
        JR      Z,PFDONE
        CP      '$'
        JR      Z,PFDONE
        CP      '*'
        JR      Z,PFSTAR
        CP      '?'
        JR      Z,PFEPUT
        CP      '!'
        JR      C,PFBAD
        CP      '.'
        JR      Z,PFBAD
        CP      ':'
        JR      Z,PFBAD

PFEPUT: LD      (DE),A                  ; pfeput
        INC     DE
        INC     HL
        DEC     B
        DEC     C
        JR      NZ,PFELP
        JR      PFDONE

PFSTAR: LD      A,'?'                   ; pfstar

PFSLP:  LD      (DE),A                  ; pfslp
        INC     DE
        DEC     C
        JR      NZ,PFSLP
        INC     HL
        DEC     B

PFDONE: LD      A,(NAMECNT)             ; pfdone
        OR      A
        JR      Z,PFBAD
        LD      (ARGPTR),HL
        LD      A,B
        LD      (ARGLEN),A
        OR      A
        RET

PFBAD:  SCF                             ; pfbad
        RET

  ; Locate and decode the optional stock $S/$R/O/$R/W/$SYS/$DIR indicator.

; ================================================================================
; =                            File Attribute Options                            =
; =                                                                              =
; = Locates and decodes stock STAT attribute suffixes such as $R/O, $R/W, $SYS, and =
; = $DIR before file enumeration or update.                                      =
; ================================================================================
; -------------------------------------------------------------------------------
; Attribute Suffix Parse
; -------------------------------------------------------------------------------

FILEOPTION:                             ; parse file attribute option
        LD      A,0FFH
        LD      (OPTION),A
        LD      HL,(ARGPTR)
        LD      A,(ARGLEN)
        LD      B,A

FOFIND: CALL    TRIM                    ; fofind
        LD      A,B
        OR      A
        RET     Z
        LD      A,(HL)
        CP      '$'
        RET     NZ
        INC     HL
        DEC     B
        LD      A,B
        OR      A
        RET     Z
        LD      A,(HL)
        CP      'S'
        JR      Z,FOS
        CP      'R'
        JR      Z,FORW
        CP      'D'
        JR      Z,FODIR
        CP      'S'
        JR      Z,FOSYS
        RET

FOS:    LD      A,B                     ; fos
        CP      1
        JR      NZ,FOSYS

FOSIZE: XOR     A                       ; fosize
        LD      (OPTION),A
        RET

FORW:   INC     HL                      ; forw
        DEC     B
        LD      A,B
        CP      2
        RET     C
        LD      A,(HL)
        CP      '/'
        RET     NZ
        INC     HL
        LD      A,(HL)
        CP      'O'
        JR      Z,FORO
        CP      'W'
        JR      Z,FORWRITE
        RET

FORO:   LD      A,1                     ; foro
        LD      (OPTION),A
        RET

FORWRITE:LD     A,2                     ; forwrite
        LD      (OPTION),A
        RET

FOSYS:  LD      A,3                     ; fosys
        LD      (OPTION),A
        RET

FODIR:  LD      A,4                     ; fodir
        LD      (OPTION),A
        RET

  ; No operand: status of logged-in drives, matching stock STAT's default form.

; ================================================================================
; =                           Disk Status and Capacity                           =
; =                                                                              =
; = Reports logged-in drive state, computes free KiB from the live DPB/allocation vector, =
; = and prints selected-drive geometry and capacity details.                     =
; ================================================================================
; -------------------------------------------------------------------------------
; Logged-In Drive Status
; -------------------------------------------------------------------------------

DISKSTATUS:                             ; report logged-in drive status
        LD      C,24
        CALL    BDOS
        LD      (LOGIN),HL
        LD      C,29
        CALL    BDOS
        LD      (ROVEC),HL
        XOR     A
        LD      (DRIVE),A

DSLOOP: LD      A,(DRIVE)               ; dsloop
        CP      16
        JP      Z,FINISH
        LD      E,A
        LD      D,0
        LD      HL,1

DSMASK: LD      A,E                     ; dsmask
        OR      A
        JR      Z,DSCHECK
        ADD     HL,HL
        DEC     E
        JR      DSMASK

DSCHECK:EX      DE,HL                   ; dscheck
        LD      HL,(LOGIN)
        LD      A,H
        AND     D
        LD      H,A
        LD      A,L
        AND     E
        OR      H
        JR      Z,DSNEXT
        LD      A,(DRIVE)
        CALL    SELECTA
        CALL    FREEK
        CALL    CRLF
        LD      A,(DRIVE)
        ADD     A,'A'
        CALL    PCHAR
        LD      A,':'
        CALL    PCHAR
        LD      DE,MRSLASH
        CALL    PRINT
        LD      A,(DRIVE)
        CALL    ROMASK
        LD      A,'W'
        JR      Z,DSACC
        LD      A,'O'

DSACC:  CALL    PCHAR                   ; dsacc
        LD      DE,MSPACE
        CALL    PRINT
        LD      HL,(FREEKB)
        CALL    PWORD
        LD      DE,MKFREE
        CALL    PRINT

DSNEXT: LD      HL,DRIVE                ; dsnext
        INC     (HL)
        JR      DSLOOP

ROMASK: LD      E,A                     ; romask
        LD      D,0
        LD      HL,1

ROMLP:  LD      A,E                     ; romlp
        OR      A
        JR      Z,ROMGO
        ADD     HL,HL
        DEC     E
        JR      ROMLP

ROMGO:  EX      DE,HL                   ; romgo
        LD      HL,(ROVEC)
        LD      A,H
        AND     D
        LD      H,A
        LD      A,L
        AND     E
        OR      H
        RET

SELECTA:LD      E,A                     ; selecta
        LD      C,14
        JP      BDOS

SPACEONLY:                              ; spaceonly
        CALL    FREEK
        LD      DE,MBYTES
        CALL    PRINT
        LD      C,25
        CALL    BDOS
        ADD     A,'A'
        CALL    PCHAR
        LD      DE,MCOLSP
        CALL    PRINT
        LD      HL,(FREEKB)
        CALL    PWORD
        LD      DE,MKCRLF
        CALL    PRINT
        JP      FINISH

  ; Calculate free KiB on current disk from DPB and allocation vector.

; -------------------------------------------------------------------------------
; Free-Space Calculation
; -------------------------------------------------------------------------------

FREEK:  LD      C,31                    ; compute free disk KiB
        CALL    BDOS
        LD      (DPB),HL
        LD      DE,2
        ADD     HL,DE
        LD      A,(HL)                  ; BSH
        SUB     3                       ; KiB per block = 2^(BSH-3)
        LD      (KSHIFT),A
        INC     HL
        INC     HL
        INC     HL
        LD      E,(HL)                  ; DSM
        INC     HL
        LD      D,(HL)
        LD      (BLOCKS),DE
        LD      C,27
        CALL    BDOS
        LD      (ALV),HL
        LD      HL,0
        LD      (FREEKB),HL
        LD      HL,0

FKLOOP: LD      DE,(BLOCKS)             ; fkloop
        OR      A
        SBC     HL,DE
        JR      C,FKIN
        JR      Z,FKIN
        RET

FKIN:   ADD     HL,DE                   ; fkin
        PUSH    HL
        CALL    BLOCKFREE
        POP     HL
        JR      NZ,FKNEXT
        PUSH    HL
        LD      HL,1
        LD      A,(KSHIFT)

FKSH:   OR      A                       ; fksh
        JR      Z,FKADD
        ADD     HL,HL
        DEC     A
        JR      FKSH

FKADD:  LD      DE,(FREEKB)             ; fkadd
        ADD     HL,DE
        LD      (FREEKB),HL
        POP     HL

FKNEXT: INC     HL                      ; fknext
        JR      FKLOOP

  ; HL block number; Z if allocation bit is clear.

BLOCKFREE:                              ; blockfree
        PUSH    HL
        SRL     H
        RR      L
        SRL     H
        RR      L
        SRL     H
        RR      L
        LD      DE,(ALV)
        ADD     HL,DE
        LD      A,(HL)
        POP     HL
        LD      C,L
        LD      B,080H
        LD      A,C
        AND     7

BFROT:  OR      A                       ; bfrot
        JR      Z,BFTEST
        SRL     B
        DEC     A
        JR      BFROT

BFTEST: LD      A,B                     ; bftest
        LD      B,A
        ; Recreate allocation byte because HL was restored to the block.
        PUSH    HL
        SRL     H
        RR      L
        SRL     H
        RR      L
        SRL     H
        RR      L
        LD      DE,(ALV)
        ADD     HL,DE
        LD      A,(HL)
        AND     B
        POP     HL
        RET

  ; DSK: reports characteristics of selected disk.

; -------------------------------------------------------------------------------
; Selected Drive Details
; -------------------------------------------------------------------------------

DRIVEDETAILS:                           ; report selected drive details
        LD      C,31
        CALL    BDOS
        LD      (DPB),HL
        CALL    CRLF
        LD      C,25
        CALL    BDOS
        ADD     A,'A'
        CALL    PCHAR
        LD      DE,MDRIVE
        CALL    PRINT
        LD      HL,(DPB)
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        LD      DE,MSPT
        CALL    PLINE
        LD      HL,(DPB)
        LD      DE,5
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     DE
        EX      DE,HL
        LD      DE,MBLOCKCAP
        CALL    PLINE
        LD      HL,(DPB)
        LD      DE,7
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     DE
        EX      DE,HL
        LD      DE,MDIRENTS
        CALL    PLINE
        LD      HL,(DPB)
        LD      DE,13
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        LD      DE,MRESERVED
        CALL    PLINE
        CALL    FREEK
        LD      HL,(FREEKB)
        LD      DE,MKREMAIN
        CALL    PLINE
        JP      FINISH

PLINE:  PUSH    DE                      ; pline
        PUSH    HL
        CALL    CRLF
        POP     HL
        CALL    PWORD
        POP     DE
        JP      PRINT

DISKASSIGN:                             ; diskassign
        INC     HL
        DEC     B
        CALL    TRIM
        LD      A,B
        CP      3
        JP      NZ,BADFORM
        LD      A,(HL)
        CP      'R'
        JP      NZ,BADFORM
        INC     HL
        LD      A,(HL)
        CP      '/'
        JP      NZ,BADFORM
        INC     HL
        LD      A,(HL)
        CP      'O'
        JP      NZ,BADFORM
        LD      C,28
        CALL    BDOS
        JP      FINISH

  ; File enumeration and attribute updates. Physical extents are aggregated into
  ; one 16-byte summary per common filename, as stock STAT requires.

; ================================================================================
; =                       File Enumeration and Aggregation                       =
; =                                                                              =
; = Enumerates matching directory entries and aggregates physical extents into one =
; = stock-style summary per common filename.                                     =
; ================================================================================
; -------------------------------------------------------------------------------
; Directory Enumeration
; -------------------------------------------------------------------------------

FILES:  CALL    FREEK                   ; enumerate matching files
        LD      DE,DMA
        LD      C,26
        CALL    BDOS
        XOR     A
        LD      (FOUND),A
        LD      (SUMCOUNT),A
        LD      DE,FCB
        LD      C,17

FILELP: CALL    BDOS                    ; filelp
        CP      0FFH
        JP      Z,FILECOLLECTED
        LD      (DINDEX),A
        LD      A,1
        LD      (FOUND),A
        LD      A,(DINDEX)
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,080H
        LD      L,A
        LD      H,0
        LD      (DIRENT),HL
        CALL    SUMEXTENT

FILENEXT:                               ; filenext
        LD      DE,FCB
        LD      C,18
        JP      FILELP

; -------------------------------------------------------------------------------
; Summary Output
; -------------------------------------------------------------------------------

FILECOLLECTED:                          ; filecollected
        LD      A,(FOUND)
        OR      A
        JR      NZ,FILEHAVE
        LD      DE,MNOTFOUND
        CALL    PRINT
        RET

FILEHAVE:                               ; filehave
        XOR     A
        LD      (SUMINDEX),A

FILEOUT:                                ; fileout
        LD      A,(SUMINDEX)
        LD      B,A
        LD      A,(SUMCOUNT)
        CP      B
        JP      Z,FILESPACE
        LD      A,B
        CALL    SUMPTR
        LD      (SUMCUR),HL
        LD      A,(OPTION)
        CP      0FFH
        JR      Z,FILEPRINT
        OR      A
        JR      Z,FILEPRINT
        CALL    SETATTR
        JP      FILEOUTNEXT

FILEPRINT:                              ; fileprint
        CALL    CRLF
        LD      A,(OPTION)
        OR      A
        JR      NZ,FPNOSIZE
        LD      HL,(SUMCUR)
        LD      DE,11
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        CALL    PWORD5
        LD      A,' '
        CALL    PCHAR

FPNOSIZE:                               ; fpnosize
        LD      HL,(SUMCUR)
        LD      DE,11
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        CALL    PWORD5
        LD      DE,MRECS
        CALL    PRINT
        LD      HL,(SUMCUR)
        LD      DE,13
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        CALL    PWORD5
        LD      DE,MKBYTES
        CALL    PRINT
        LD      HL,(SUMCUR)
        LD      DE,15
        ADD     HL,DE
        LD      L,(HL)
        LD      H,0
        CALL    PWORD4
        LD      DE,MEXTACC
        CALL    PRINT
        LD      HL,(SUMCUR)
        LD      DE,8
        ADD     HL,DE
        LD      A,(HL)
        AND     080H
        LD      A,'W'
        JR      Z,FACC
        LD      A,'O'

FACC:   CALL    PCHAR                   ; facc
        LD      A,' '
        CALL    PCHAR
        LD      C,25
        CALL    BDOS
        ADD     A,'A'
        CALL    PCHAR
        LD      A,':'
        CALL    PCHAR
        LD      HL,(SUMCUR)
        PUSH    HL
        LD      DE,9
        ADD     HL,DE
        LD      A,(HL)
        AND     080H
        LD      (ISSYS),A
        POP     HL
        JR      Z,FPNAME
        LD      A,'('
        CALL    PCHAR

FPNAME:                                 ; fpname
        CALL    PNAME
        LD      A,(ISSYS)
        OR      A
        JR      Z,FILEOUTNEXT
        LD      A,')'
        CALL    PCHAR

FILEOUTNEXT:                            ; fileoutnext
        LD      HL,SUMINDEX
        INC     (HL)
        JP      FILEOUT

FILESPACE:                              ; filespace
        LD      DE,MBYTES
        CALL    PRINT
        LD      C,25
        CALL    BDOS
        ADD     A,'A'
        CALL    PCHAR
        LD      DE,MCOLSP
        CALL    PRINT
        LD      HL,(FREEKB)
        CALL    PWORD
        LD      DE,MKCRLF
        JP      PRINT

  ; Find or create the summary matching the current DMA directory entry, then
  ; add its logical records, allocated KiB, and physical extent count.

; -------------------------------------------------------------------------------
; Extent Aggregation
; -------------------------------------------------------------------------------

SUMEXTENT:                              ; aggregate directory extent
        XOR     A
        LD      (SUMINDEX),A

SEFIND: LD      A,(SUMINDEX)            ; sefind
        LD      B,A
        LD      A,(SUMCOUNT)
        CP      B
        JR      Z,SENEW
        LD      A,B
        CALL    SUMPTR
        PUSH    HL
        LD      DE,(DIRENT)
        INC     DE
        LD      B,11

SECMP:  LD      A,(DE)                  ; secmp
        AND     07FH
        LD      C,A
        LD      A,(HL)
        AND     07FH
        CP      C
        JR      NZ,SENOMATCH
        INC     HL
        INC     DE
        DJNZ    SECMP
        POP     HL
        JR      SEADD

SENOMATCH:                              ; senomatch
        POP     HL
        LD      HL,SUMINDEX
        INC     (HL)
        JR      SEFIND

SENEW:  LD      A,(SUMCOUNT)            ; senew
        CP      64
        RET     NC
        CALL    SUMPTR
        PUSH    HL
        EX      DE,HL
        LD      HL,(DIRENT)
        INC     HL
        LD      BC,11
        LDIR
        XOR     A
        LD      B,5

SEZERO: LD      (DE),A                  ; sezero
        INC     DE
        DJNZ    SEZERO
        POP     HL
        LD      A,(SUMCOUNT)
        INC     A
        LD      (SUMCOUNT),A

SEADD:  LD      (SUMCUR),HL             ; seadd
        PUSH    HL
        LD      DE,11
        ADD     HL,DE
        EX      DE,HL                   ; DE -> summary record word
        LD      HL,(DIRENT)
        LD      BC,12
        ADD     HL,BC
        LD      A,(HL)                  ; logical extent number
        LD      C,A
        PUSH    DE
        LD      DE,(DPB)
        INC     DE
        INC     DE
        INC     DE
        INC     DE
        LD      A,(DE)                  ; EXM
        LD      B,A
        POP     DE
        LD      A,C
        AND     B
        LD      L,A
        LD      H,0
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        PUSH    HL
        LD      HL,(DIRENT)
        LD      BC,15
        ADD     HL,BC
        LD      C,(HL)
        LD      B,0
        POP     HL
        ADD     HL,BC
        LD      A,(DE)
        ADD     A,L
        LD      (DE),A
        INC     DE
        LD      A,(DE)
        ADC     A,H
        LD      (DE),A
        LD      HL,(DIRENT)
        CALL    COUNTBLOCKS
        EX      DE,HL                   ; DE = this extent's allocated KiB
        LD      HL,(SUMCUR)
        LD      BC,13
        ADD     HL,BC
        LD      A,(HL)
        ADD     A,E
        LD      (HL),A
        INC     HL
        LD      A,(HL)
        ADC     A,D
        LD      (HL),A
        INC     HL
        INC     (HL)
        POP     HL
        RET

  ; A summary index -> HL = 16-byte summary.

SUMPTR: ADD     A,A                     ; sumptr
        ADD     A,A
        ADD     A,A
        ADD     A,A
        LD      L,A
        LD      H,0
        LD      DE,SUMMARY
        ADD     HL,DE
        RET

; -------------------------------------------------------------------------------
; Allocated-Block Count
; -------------------------------------------------------------------------------

COUNTBLOCKS:                            ; countblocks
        PUSH    HL
        LD      DE,16
        ADD     HL,DE
        LD      DE,(DPB)
        LD      A,E
        ADD     A,6
        LD      E,A
        JR      NC,CBPTR
        INC     D

CBPTR:  LD      A,(DE)                  ; cbptr
        OR      A
        JR      NZ,CBWORD
        LD      B,16
        LD      DE,0

CBLP:   LD      A,(HL)                  ; cblp
        OR      A
        JR      Z,CBN
        INC     DE

CBN:    INC     HL                      ; cbn
        DJNZ    CBLP
        JR      CBDONE

CBWORD: LD      B,8                     ; cbword
        LD      DE,0

CBWLP:  LD      A,(HL)                  ; cbwlp
        INC     HL
        OR      (HL)
        JR      Z,CBWN
        INC     DE

CBWN:   INC     HL                      ; cbwn
        DJNZ    CBWLP

CBDONE:                                 ; cbdone
        EX      DE,HL
        LD      A,(KSHIFT)

CBSH:   OR      A                       ; cbsh
        JR      Z,CBOUT
        ADD     HL,HL
        DEC     A
        JR      CBSH

CBOUT:  POP     DE                      ; cbout
        RET

; ================================================================================
; =                            File Attribute Updates                            =
; =                                                                              =
; = Applies requested read-only/read-write, system, or directory attribute changes to =
; = matching files through the public CP/M interfaces.                           =
; ================================================================================
; -------------------------------------------------------------------------------
; Attribute Application
; -------------------------------------------------------------------------------

SETATTR:                                ; set matching file attributes
        LD      HL,(SUMCUR)
        LD      DE,FCB+1
        LD      BC,11
        LDIR
        LD      A,(OPTION)
        CP      1
        JR      Z,SARO
        CP      2
        JR      Z,SARW
        CP      3
        JR      Z,SASYS
        LD      HL,FCB+10
        RES     7,(HL)
        LD      DE,MDIR
        JR      SAAPPLY

SARO:   LD      HL,FCB+9                ; saro
        SET     7,(HL)
        LD      DE,MRO
        JR      SAAPPLY

SARW:   LD      HL,FCB+9                ; sarw
        RES     7,(HL)
        LD      DE,MRW
        JR      SAAPPLY

SASYS:  LD      HL,FCB+10               ; sasys
        SET     7,(HL)
        LD      DE,MSYS

SAAPPLY:PUSH    DE                      ; saapply
        LD      DE,FCB
        LD      C,30
        CALL    BDOS
        CALL    CRLF
        LD      HL,FCB+1
        CALL    PNAME
        LD      DE,MSETTO
        CALL    PRINT
        POP     DE
        JP      PRINT

; -------------------------------------------------------------------------------
; Filename Output
; -------------------------------------------------------------------------------

PNAME:  LD      B,8                     ; pname

PNLP:   LD      A,(HL)                  ; pnlp
        AND     07FH
        CALL    PCHAR
        INC     HL
        DJNZ    PNLP
        LD      A,'.'
        CALL    PCHAR
        LD      B,3

PNEXT:  LD      A,(HL)                  ; pnext
        AND     07FH
        CALL    PCHAR
        INC     HL
        DJNZ    PNEXT
        RET

  ; Stock logical-device query/assignment forms.

; ================================================================================
; =                     Logical Device Status and Assignment                     =
; =                                                                              =
; = Implements stock STAT logical-device query and assignment forms over the CP/M I/O =
; = byte, including device-name/value parsing and formatted status output.       =
; ================================================================================
; -------------------------------------------------------------------------------
; Device Assignment
; -------------------------------------------------------------------------------

DEVICEASSIGN:                           ; query or assign logical device
        LD      (ARGPTR),HL
        LD      A,B
        LD      (ARGLEN),A
        LD      DE,KCON
        LD      C,4
        CALL    PREFIX
        JR      Z,DACON
        LD      DE,KRDR
        LD      C,4
        CALL    PREFIX
        JR      Z,DARDR
        LD      DE,KPUN
        LD      C,4
        CALL    PREFIX
        JR      Z,DAPUN
        LD      DE,KLST
        LD      C,4
        CALL    PREFIX
        JR      Z,DALST
        OR      A
        RET

DACON:  LD      A,0                     ; dacon
        JR      DASEL

DARDR:  LD      A,1                     ; dardr
        JR      DASEL

DAPUN:  LD      A,2                     ; dapun
        JR      DASEL

DALST:  LD      A,3                     ; dalst

DASEL:  LD      (DEVNO),A               ; dasel
        LD      HL,(ARGPTR)
        LD      A,(ARGLEN)
        LD      B,A
        LD      DE,4
        ADD     HL,DE
        LD      A,B
        SUB     4
        LD      B,A
        CALL    TRIM
        LD      A,B
        OR      A
        JR      Z,DASHOW
        LD      A,(HL)
        CP      '='
        JR      NZ,DABAD
        INC     HL
        DEC     B
        CALL    TRIM
        CALL    DEVVALUE
        JR      C,DABAD
        CALL    SETIO

DASHOW: CALL    SHOWONE                 ; dashow
        SCF
        RET

DABAD:  LD      DE,MINVALIDASSIGN       ; dabad
        CALL    PRINT
        SCF
        RET

; -------------------------------------------------------------------------------
; Device Prefix Match
; -------------------------------------------------------------------------------

PREFIX: LD      A,B                     ; prefix
        CP      C
        RET     C
        PUSH    HL
        PUSH    BC

PRLP:   LD      A,(DE)                  ; prlp
        CP      (HL)
        JR      NZ,PRNO
        INC     DE
        INC     HL
        DEC     C
        JR      NZ,PRLP
        POP     BC
        POP     HL
        XOR     A
        RET

PRNO:   POP     BC                      ; prno
        POP     HL
        LD      A,1
        OR      A
        RET

; -------------------------------------------------------------------------------
; Device Value Parse
; -------------------------------------------------------------------------------

DEVVALUE:                               ; devvalue
        LD      A,B
        CP      4
        JR      C,DVBAD
        LD      A,(DEVNO)
        ADD     A,A
        ADD     A,A
        ADD     A,A
        ADD     A,A
        LD      E,A
        LD      D,0
        PUSH    HL
        LD      HL,DEVNAMES
        ADD     HL,DE
        EX      DE,HL
        POP     HL
        LD      C,0

DVLP:   PUSH    HL                      ; dvlp
        PUSH    BC
        LD      B,4

DVCMP:  LD      A,(DE)                  ; dvcmp
        CP      (HL)
        JR      NZ,DVNEXT
        INC     DE
        INC     HL
        DJNZ    DVCMP
        POP     BC
        POP     HL
        LD      A,C
        AND     3
        OR      A
        RET

DVNEXT: POP     BC                      ; dvnext
        POP     HL
        LD      A,C
        INC     A
        LD      C,A
        CP      4
        JR      NC,DVBAD
        LD      A,E
        ADD     A,4
        LD      E,A
        JR      NC,DVLP
        INC     D
        JR      DVLP

DVBAD:  SCF                             ; dvbad
        RET

; -------------------------------------------------------------------------------
; I/O Byte Update
; -------------------------------------------------------------------------------

SETIO:  LD      C,A                     ; setio
        LD      A,(0003H)
        LD      B,A
        LD      A,(DEVNO)
        OR      A
        JR      Z,SICON
        CP      1
        JR      Z,SIRDR
        CP      2
        JR      Z,SIPUN
        LD      A,B
        AND     03FH
        LD      B,A
        LD      A,C
        AND     3
        RRCA
        RRCA
        OR      B
        JR      SIOUT

SIPUN:  LD      A,B                     ; sipun
        AND     0CFH
        LD      B,A
        LD      A,C
        AND     3
        RLCA
        RLCA
        OR      B
        JR      SIOUT

SIRDR:  LD      A,B                     ; sirdr
        AND     0F3H
        LD      B,A
        LD      A,C
        AND     3
        RLCA
        RLCA
        OR      B
        JR      SIOUT

SICON:  LD      A,B                     ; sicon
        AND     0FCH
        LD      B,A
        LD      A,C
        AND     3
        OR      B

SIOUT:  LD      E,A                     ; siout
        LD      C,8
        JP      BDOS

; -------------------------------------------------------------------------------
; Device Status Output
; -------------------------------------------------------------------------------

SHOWONE:                                ; showone
        CALL    CRLF
        LD      A,(DEVNO)
        CALL    DEVKEYPTR
        CALL    PRINT4HL
        LD      DE,MIS
        CALL    PRINT
        LD      A,(0003H)
        LD      C,A
        LD      A,(DEVNO)
        OR      A
        JR      Z,SGOT

SSHF:   SRL     C                       ; sshf
        SRL     C
        DEC     A
        JR      NZ,SSHF

SGOT:   LD      A,C                     ; sgot
        AND     3
        LD      C,A
        LD      A,(DEVNO)
        ADD     A,A
        ADD     A,A
        ADD     A,C
        ADD     A,A
        ADD     A,A
        LD      E,A
        LD      D,0
        LD      HL,DEVNAMES
        ADD     HL,DE
        CALL    PRINT4HL
        RET

DEVKEYPTR:                              ; devkeyptr
        ADD     A,A
        ADD     A,A
        LD      E,A
        LD      D,0
        LD      HL,DEVKEYS
        ADD     HL,DE
        RET

PRINT4: EX      DE,HL                   ; print4

PRINT4HL:                               ; print4hl
        LD      B,4

P4LP:   LD      A,(HL)                  ; p4lp
        CALL    PCHAR
        INC     HL
        DJNZ    P4LP
        RET

DEVSTATUS:                              ; devstatus
        XOR     A

DEVSLP: LD      (DEVNO),A               ; devslp
        CALL    SHOWONE
        LD      A,(DEVNO)
        INC     A
        CP      4
        JR      NZ,DEVSLP
        JP      FINISH

VALUES:LD      DE,MVALUES1              ; values
        CALL    PRINT
        LD      A,'$'
        CALL    PCHAR
        LD      DE,MVALUES2
        CALL    PRINT
        LD      A,'$'
        CALL    PCHAR
        LD      DE,MVALUES3
        CALL    PRINT
        LD      A,'$'
        CALL    PCHAR
        LD      DE,MVALUES4
        CALL    PRINT
        LD      A,'$'
        CALL    PCHAR
        LD      DE,MVALUES5
        CALL    PRINT
        JP      FINISH

; ================================================================================
; =                                 User Status                                  =
; =                                                                              =
; = Reports active user areas and their file presence using temporary user selection and =
; = directory searches.                                                          =
; ================================================================================
; -------------------------------------------------------------------------------
; User-Area Scan
; -------------------------------------------------------------------------------

USERSTATUS:                             ; report active user areas
        LD      DE,MACTIVEUSER
        CALL    PRINT
        LD      E,0FFH
        LD      C,32
        CALL    BDOS
        LD      L,A
        LD      H,0
        CALL    PWORD
        LD      DE,MACTIVEFILES
        CALL    PRINT
        LD      HL,FCB
        LD      B,36
        XOR     A

USCLR:  LD      (HL),A                  ; usclr
        INC     HL
        DJNZ    USCLR
        LD      HL,FCB+1
        LD      B,11
        LD      A,'?'

USWILD: LD      (HL),A                  ; uswild
        INC     HL
        DJNZ    USWILD
        XOR     A
        LD      (USERNO),A

USLOOP: LD      A,(USERNO)              ; usloop
        LD      E,A
        LD      C,32
        CALL    BDOS
        LD      DE,FCB
        LD      C,17
        CALL    BDOS
        CP      0FFH
        JR      Z,USNEXT
        LD      A,' '
        CALL    PCHAR
        LD      A,(USERNO)
        LD      L,A
        LD      H,0
        CALL    PWORD

USNEXT: LD      HL,USERNO               ; usnext
        INC     (HL)
        LD      A,(HL)
        CP      32
        JR      NZ,USLOOP
        CALL    CRLF
        JP      FINISH

  ; BetterCP/M memory report. ECB fields are versioned and validated first.

; ================================================================================
; =                           BetterCP/M Memory Report                           =
; =                                                                              =
; = Validates the versioned ECB and combines its live movable boundaries with layout.inc =
; = fixed regions to print the current protected/transient memory map.           =
; ================================================================================
; -------------------------------------------------------------------------------
; ECB Validation and Map
; -------------------------------------------------------------------------------

MEMREPORT:                              ; report BetterCP/M memory map
        LD      HL,ECB
        LD      A,(HL)
        CP      'B'
        JP      NZ,MEMBAD
        INC     HL
        LD      A,(HL)
        CP      'M'
        JP      NZ,MEMBAD
        INC     HL
        LD      A,(HL)
        CP      1
        JP      NZ,MEMBAD
        LD      DE,MMEMHEAD
        CALL    PRINT
        LD      HL,LY_LIMIT
        LD      BC,0FFFFH
        LD      DE,MPLATFORM
        CALL    MAPLINE
        LD      HL,LY_BUF
        LD      BC,LY_LIMIT-1
        LD      DE,MBUFFERS
        CALL    MAPLINE
        LD      HL,LY_DIR
        LD      BC,LY_BUF-1
        LD      DE,MDIRBUF
        CALL    MAPLINE
        LD      HL,LY_RSTA
        LD      BC,LY_DIR-1
        LD      DE,MRSXTABLE
        CALL    MAPLINE
        LD      HL,LY_TAB
        LD      BC,LY_RSTA-1
        LD      DE,MDRIVETAB
        CALL    MAPLINE
        LD      HL,LY_FILE
        LD      BC,LY_TAB-1
        LD      DE,MFILESVC
        CALL    MAPLINE
        LD      HL,LY_BIOS
        LD      BC,LY_FILE-1
        LD      DE,MBIOS
        CALL    MAPLINE
        LD      HL,LY_DISK
        LD      BC,LY_BIOS-1
        LD      DE,MDISKSVC
        CALL    MAPLINE
        LD      HL,LY_EXT
        LD      BC,LY_DISK-1
        LD      DE,MEXTSVC
        CALL    MAPLINE
        LD      HL,LY_BDOS
        LD      BC,LY_EXT-1
        LD      DE,MBDOS
        CALL    MAPLINE
        LD      HL,LY_SYS
        LD      BC,LY_BDOS-1
        LD      DE,MSYSGATE
        CALL    MAPLINE
        LD      HL,LY_HIST
        LD      BC,LY_SYS-1
        LD      DE,MPDS
        CALL    MAPLINE
        LD      HL,(ECB+16)
        INC     HL
        INC     HL
        INC     HL
        LD      BC,LY_TPA-1
        LD      A,H
        CP      B
        JR      C,MRRSX
        JR      NZ,MRGATE
        LD      A,L
        CP      C
        JR      NC,MRGATE

MRRSX: LD      DE,MRSX                  ; mrrsx
        CALL    MAPLINE

MRGATE:LD      HL,(ECB+16)              ; mrgate
        PUSH    HL
        INC     HL
        INC     HL
        LD      B,H
        LD      C,L
        POP     HL
        LD      DE,MGATE
        CALL    MAPLINE
        LD      HL,(ECB+12)
        LD      DE,(ECB+14)
        ADD     HL,DE
        LD      (MAPCPX),HL
        LD      HL,(MAPCPX)
        LD      BC,(ECB+16)
        DEC     BC
        LD      A,H
        CP      B
        JR      C,MRCPX
        JR      NZ,MRTPA
        LD      A,L
        CP      C
        JR      Z,MRCPX
        JR      NC,MRTPA

MRCPX: LD      DE,MCPX                  ; mrcpx
        CALL    MAPLINE

MRTPA: LD      HL,(ECB+12)              ; mrtpa
        PUSH    HL
        LD      DE,(ECB+14)
        ADD     HL,DE
        DEC     HL
        LD      B,H
        LD      C,L
        POP     HL
        LD      DE,MCCP
        CALL    MAPLINE
        LD      HL,0100H
        LD      BC,(ECB+12)
        DEC     BC
        LD      DE,MTRANSIENT
        CALL    MAPLINE
        LD      HL,0000H
        LD      BC,00FFH
        LD      DE,MPAGEZERO
        CALL    MAPLINE
        CALL    CRLF
        LD      DE,MMAXCOM
        CALL    PRINT
        LD      HL,(0006H)
        LD      DE,0100H
        OR      A
        SBC     HL,DE
        LD      A,L
        AND     080H
        LD      L,A
        CALL    PWORD
        LD      DE,MBYTESUNIT
        CALL    PRINT
        JP      FINISH

MEMBAD: LD      DE,MMEMBAD              ; membad
        CALL    PRINT
        JP      FINISH
  ; Print one inclusive, non-overlapping range. HL=start, BC=end, DE=label.

; -------------------------------------------------------------------------------
; Memory Range Output
; -------------------------------------------------------------------------------

MAPLINE:                                ; print one memory-map range
        LD      (MAPSTART),HL
        LD      (MAPEND),BC
        LD      (MAPLABEL),DE
        CALL    CRLF
        LD      HL,(MAPEND)
        CALL    PHEXWORD
        LD      A,'-'
        CALL    PCHAR
        LD      HL,(MAPSTART)
        CALL    PHEXWORD
        LD      A,' '
        CALL    PCHAR
        LD      HL,(MAPEND)
        LD      DE,(MAPSTART)
        OR      A
        SBC     HL,DE
        INC     HL
        CALL    PWORD5
        LD      A,' '
        CALL    PCHAR
        LD      DE,(MAPLABEL)
        JP      PRINT

; ================================================================================
; =                         Formatting and Common Output                         =
; =                                                                              =
; = Provides hexadecimal/decimal numeric formatting, strings, characters, newlines, and =
; = common error/finish paths used throughout STAT.                              =
; ================================================================================
; -------------------------------------------------------------------------------
; Hexadecimal Output
; -------------------------------------------------------------------------------

PHEXWORD:                               ; print hexadecimal word
        LD      A,H
        CALL    PHEXBYTE
        LD      A,L

PHEXBYTE:                               ; phexbyte
        PUSH    AF
        RRCA
        RRCA
        RRCA
        RRCA
        CALL    PHEXNIB
        POP     AF

PHEXNIB:                                ; phexnib
        AND     00FH
        ADD     A,'0'
        CP      '9'+1
        JR      C,PHXDIGIT
        ADD     A,'A'-'9'-1

PHXDIGIT:                               ; phxdigit
        JP      PCHAR

  ; Decimal printers.

; -------------------------------------------------------------------------------
; Decimal Output
; -------------------------------------------------------------------------------

PWORD5: LD      C,1                     ; pword5
        JR      PWSTART

PWORD4: LD      C,2                     ; pword4
        JR      PWSTART

PWORD:  LD      C,0                     ; pword

PWSTART:LD      DE,10000                ; pwstart
        CALL    PWDIG
        LD      DE,1000
        CALL    PWDIG
        LD      DE,100
        CALL    PWDIG
        LD      DE,10
        CALL    PWDIG
        LD      DE,1
        LD      C,1

PWDIG:  LD      B,'0'                   ; pwdig

PWDLP:  OR      A                       ; pwdlp
        SBC     HL,DE
        JR      C,PWDONE
        INC     B
        JR      PWDLP

PWDONE: ADD     HL,DE                   ; pwdone
        LD      A,B
        CP      '0'
        JR      NZ,PWPRINT
        LD      A,C
        OR      A
        RET     Z
        LD      A,B

PWPRINT:CALL    PCHAR                   ; pwprint
        LD      C,1
        RET

; -------------------------------------------------------------------------------
; String and Character Output
; -------------------------------------------------------------------------------

PRINT:  LD      C,9                     ; print $-terminated string
        JP      BDOS

PCHAR:  PUSH    HL                      ; pchar
        PUSH    DE
        PUSH    BC
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     BC
        POP     DE
        POP     HL
        RET

CRLF:   LD      DE,MCRLF                ; crlf
        JR      PRINT

BADFORM:LD      DE,MBADFORM             ; badform
        CALL    PRINT

FINISH: LD      A,(SAVEDRV)             ; restore context and return
        LD      E,A
        LD      C,14
        CALL    BDOS
        LD      A,(SAVEUSR)
        LD      E,A
        LD      C,32
        CALL    BDOS
        LD      SP,(OLDSP)
        LD      C,0
        JP      BDOS

; ================================================================================
; =                       STAT Messages and Working State                        =
; =                                                                              =
; = Defines keywords, device tables, report strings, memory-map labels, parser state, =
; = disk/file summary buffers, FCBs, and the private transient stack.            =
; ================================================================================
; -------------------------------------------------------------------------------
; Keywords and Device Tables
; -------------------------------------------------------------------------------

KMEM:           DB 'MEM'                ; kmem
KVAL:           DB 'VAL:'               ; kval
KUSR:           DB 'USR:'               ; kusr
KDEV:           DB 'DEV:'               ; kdev
KDSK:           DB 'DSK:'               ; kdsk
KCON:           DB 'CON:'               ; kcon
KRDR:           DB 'RDR:'               ; krdr
KPUN:           DB 'PUN:'               ; kpun
KLST:           DB 'LST:'               ; klst
DEVKEYS:        DB 'CON:','RDR:','PUN:','LST:' ; devkeys
DEVNAMES:       DB 'TTY:','CRT:','BAT:','UC1:' ; devnames
                DB 'TTY:','PTR:','UR1:','UR2:'
                DB 'TTY:','PTP:','UP1:','UP2:'
                DB 'TTY:','CRT:','LPT:','UL1:'

; -------------------------------------------------------------------------------
; Messages and Memory Labels
; -------------------------------------------------------------------------------

MCRLF:          DB 13,10,'$'            ; mcrlf
MRSLASH:        DB ' R/$'               ; mrslash
MSPACE:         DB ', Space: $'         ; mspace
MKFREE:         DB 'K',13,10,'$'        ; mkfree
MBYTES:         DB 13,10,'Bytes Remaining On $' ; mbytes
MCOLSP:         DB ': $'                ; mcolsp
MKCRLF:         DB 'K',13,10,'$'        ; mkcrlf
MDRIVE:         DB ': Drive Characteristics$' ; mdrive
MSPT:           DB ': 128 Byte Records/Track$' ; mspt
MBLOCKCAP:      DB ': Allocation Blocks$' ; mblockcap
MDIRENTS:       DB ': 32 Byte Directory Entries$' ; mdirents
MRESERVED:      DB ': Reserved Tracks$' ; mreserved
MKREMAIN:       DB ': Kilobytes Remaining$' ; mkremain
MRECS:          DB ' Recs  $'           ; mrecs
MKBYTES:        DB 'K Bytes  $'         ; mkbytes
MEXTACC:        DB ' Ext R/$'           ; mextacc
MNOTFOUND:      DB 13,10,'File Not Found',13,10,'$' ; mnotfound
MSETTO:         DB ' set to $'          ; msetto
MRO:            DB 'R/O$'               ; mro
MRW:            DB 'R/W$'               ; mrw
MSYS:           DB 'SYS$'               ; msys
MDIR:           DB 'DIR$'               ; mdir
MIS:            DB ' is $'              ; mis
MINVALIDASSIGN: DB 13,10,'Invalid Assignment',13,10,'$' ; minvalidassign
MVALUES1:       DB 13,10,'Temp R/O Disk: d:=R/O',13,10 ; mvalues1
                DB 'Set Indicator: d:filename.typ $'

MVALUES2:       DB 'R/O $'              ; mvalues2
MVALUES3:       DB 'R/W $'              ; mvalues3
MVALUES4:       DB 'SYS $'              ; mvalues4
MVALUES5:       DB 'DIR',13,10,'Disk Status  : DSK: d:DSK:',13,10 ; mvalues5
                DB 'User Status  : USR:',13,10
                DB 'Memory Status: MEM',13,10
                DB 'Iobyte Assign: CON: RDR: PUN: LST:',13,10,'$'

MACTIVEUSER:    DB 13,10,'Active User : $' ; mactiveuser
MACTIVEFILES:   DB 13,10,'Active Files:$' ; mactivefiles
MMEMHEAD:       DB 13,10,'BetterCP/M Memory Map',13,10 ; mmemhead
                DB 'High-Low    Bytes Owner','$'

MPLATFORM:      DB 'Platform-reserved memory$' ; mplatform
MBUFFERS:       DB 'Shared physical/module buffers$' ; mbuffers
MDIRBUF:        DB 'Directory transfer buffer$' ; mdirbuf
MRSXTABLE:      DB 'Active RSX reconstruction table$' ; mrsxtable
MDRIVETAB:      DB 'Drive tables and disk workspace$' ; mdrivetab
MFILESVC:       DB 'Protected file services$' ; mfilesvc
MBIOS:          DB 'BIOS$'              ; mbios
MDISKSVC:       DB 'Disk and extension support$' ; mdisksvc
MEXTSVC:        DB 'Protected loader/extension services$' ; mextsvc
MBDOS:          DB 'BDOS and private state$' ; mbdos
MSYSGATE:       DB 'System gateway, ECB and CPX profile$' ; msysgate
MPDS:           DB 'PDS (command history)$' ; mpds
MRSX:           DB 'Loaded RSX allocation$' ; mrsx
MGATE:          DB 'Dynamic CP/M gateway$' ; mgate
MCPX:           DB 'Loaded CPX allocation$' ; mcpx
MCCP:           DB 'CCP image$'         ; mccp
MTRANSIENT:     DB 'Transient area below CCP$' ; mtransient
MPAGEZERO:      DB 'CP/M page zero$'    ; mpagezero
MMAXCOM:        DB 'Maximum loadable COM: $' ; mmaxcom
MBYTESUNIT:     DB ' bytes$'            ; mbytesunit
MMEMBAD:        DB 13,10,'STAT MEM requires BetterCP/M ECB version 1',13,10,'$' ; mmembad
MBADFORM:       DB 13,10,'Invalid STAT command',13,10,'$' ; mbadform

; -------------------------------------------------------------------------------
; Utility State and Buffers
; -------------------------------------------------------------------------------

OLDSP:          DW 0                    ; oldsp
SAVEDRV:        DB 0                    ; savedrv
SAVEUSR:        DB 0                    ; saveusr
NEWDRV:         DB 0                    ; newdrv
NEWUSR:         DB 0                    ; newusr
ARGPTR:         DW 0                    ; argptr
ARGLEN:         DB 0                    ; arglen
NAMECNT:        DB 0                    ; namecnt
OPTION:         DB 0                    ; option
MAPSTART:       DW 0                    ; mapstart
MAPEND:         DW 0                    ; mapend
MAPLABEL:       DW 0                    ; maplabel
MAPCPX:         DW 0                    ; mapcpx
LOGIN:          DW 0                    ; login
ROVEC:          DW 0                    ; rovec
DRIVE:          DB 0                    ; drive
DPB:            DW 0                    ; dpb
ALV:            DW 0                    ; alv
BLOCKS:         DW 0                    ; blocks
FREEKB:         DW 0                    ; freekb
KSHIFT:         DB 0                    ; kshift
FOUND:          DB 0                    ; found
DINDEX:         DB 0                    ; dindex
DIRENT:         DW 0                    ; dirent
DEVNO:          DB 0                    ; devno
USERNO:         DB 0                    ; userno
ISSYS:          DB 0                    ; issys
SUMCOUNT:       DB 0                    ; sumcount
SUMINDEX:       DB 0                    ; sumindex
SUMCUR:         DW 0                    ; sumcur
FCB:            DS 36                   ; fcb
SUMMARY:        DS 64*16                ; summary
STACK:          DS 128                  ; private STAT stack

STACKTOP:                               ; top of private STAT stack

        .DEPHASE
        END     START
