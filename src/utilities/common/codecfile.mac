; Shared CP/M 2.2 stream/file routines for standalone SQ and USQ.
; Definitions only; invoke each macro once at the desired code location.
; Caller supplies UC_* FCBs, flags, buffers, strings and stream context.
; These routines preserve IX/IY around BDOS; callbacks follow the codec ABI.
; No existing file may be passed to MAKE/DELETE as our temporary: the caller
; initializes flags/FCBs, and UC_MAKE_TEMP searches before creating a file.
; Single-task CP/M only: search + make/rename cannot be an atomic transaction.

CODEC_FILE_IO   MACRO
; BDOS adapter: preserve codec context, index registers and caller's loop
; registers, returning A/flags. CP/M/BIOS must preserve alternate registers.
UC_BDOS:
        PUSH    BC
        PUSH    DE
        PUSH    HL
        PUSH    IX
        PUSH    IY
        CALL    5
        POP     IY
        POP     IX
        POP     HL
        POP     DE
        POP     BC
        RET
UC_PRINT:
        LD      C,9
        JP      UC_BDOS

; Tokenize the bounded command tail in-place, using only its stated length.
; HL advances past token, DE=start, A=length; C if no token remains.
UC_TOKEN:
        LD      A,B
        OR      A
        JR      Z,UC_TOKEN_NONE
        LD      A,(HL)
        CP      ' '
        JR      Z,UC_TOKEN_SKIP
        CP      9
        JR      NZ,UC_TOKEN_START
UC_TOKEN_SKIP:
        INC     HL
        DEC     B
        JR      UC_TOKEN
UC_TOKEN_START:
        LD      D,H
        LD      E,L
        LD      C,0
UC_TOKEN_CHAR:
        LD      A,B
        OR      A
        JR      Z,UC_TOKEN_END
        LD      A,(HL)
        CP      ' '
        JR      Z,UC_TOKEN_END
        CP      9
        JR      Z,UC_TOKEN_END
        INC     HL
        DEC     B
        INC     C
        JR      UC_TOKEN_CHAR
UC_TOKEN_END:
        LD      A,C
        OR      A
        RET
UC_TOKEN_NONE:
        SCF
        RET

UC_PARSE:
        LD      A,(80H)
        CP      128
        JP      NC,UC_PARSE_BAD
        LD      B,A
        LD      HL,81H
        CALL    UC_TOKEN
        JP      C,UC_PARSE_BAD
        LD      (UC_ARG_LEN),A
        LD      (UC_ARG_PTR),DE
        CALL    UC_TOKEN
        JR      C,UC_PARSE_SOURCE
        CP      2
        JP      NZ,UC_PARSE_BAD
        LD      A,(DE)
        CALL    UC_UPPER
        SUB     'A'
        CP      16
        JP      NC,UC_PARSE_BAD
        INC     A
        LD      (UC_DEST),A
        INC     DE
        LD      A,(DE)
        CP      ':'
        JP      NZ,UC_PARSE_BAD
        CALL    UC_TOKEN
        JP      NC,UC_PARSE_BAD
UC_PARSE_SOURCE:
        LD      HL,(UC_ARG_PTR)
        LD      A,(UC_ARG_LEN)
        LD      B,A
        CP      2
        JR      C,UC_PARSE_NAME
        INC     HL
        LD      A,(HL)
        DEC     HL
        CP      ':'
        JR      NZ,UC_PARSE_NAME
        LD      A,(HL)
        CALL    UC_UPPER
        SUB     'A'
        CP      16
        JP      NC,UC_PARSE_BAD
        INC     A
        LD      (UC_DRIVE),A
        INC     HL
        INC     HL
        DEC     B
        DEC     B
UC_PARSE_NAME:
        LD      DE,UC_INPUT
        CALL    UC_NAME_FCB
        RET     C
        LD      A,(UC_DRIVE)
        LD      (UC_INPUT),A
        OR      A
        RET
UC_PARSE_BAD:
        SCF
        RET

UC_UPPER:
        CP      'a'
        RET     C
        CP      'z'+1
        RET     NC
        SUB     32
        RET

; HL=bounded filename, B=length, DE=36-byte FCB. Accept plain 8.3 only.
; Spaces, paths, drive/user prefixes, wildcard and high-bit bytes rejected.
UC_NAME_FCB:
        LD      A,B
        OR      A
        JP      Z,UC_PARSE_BAD
        PUSH    HL
        PUSH    BC
        LD      H,D
        LD      L,E
        LD      B,36
        XOR     A
UC_NAME_CLEAR:
        LD      (HL),A
        INC     HL
        DJNZ    UC_NAME_CLEAR
        LD      H,D
        LD      L,E
        INC     HL
        LD      B,11
        LD      A,' '
UC_NAME_SPACE:
        LD      (HL),A
        INC     HL
        DJNZ    UC_NAME_SPACE
        POP     BC
        POP     HL
        INC     DE
        LD      C,8
UC_NAME_BASE:
        LD      A,(HL)
        CP      '.'
        JR      Z,UC_NAME_DOT
        CALL    UC_NAME_CHAR
        RET     C
        LD      (DE),A
        INC     DE
        INC     HL
        DEC     C
        DEC     B
        JR      Z,UC_NAME_OK
        LD      A,C
        OR      A
        JR      NZ,UC_NAME_BASE
        LD      A,(HL)
        CP      '.'
        JP      NZ,UC_PARSE_BAD
UC_NAME_DOT:
        LD      A,C
        CP      8
        JP      Z,UC_PARSE_BAD          ; empty basename
        LD      A,E
        ADD     A,C
        LD      E,A
        JR      NC,UC_NAME_EXT_PTR
        INC     D
UC_NAME_EXT_PTR:
        INC     HL
        DEC     B
        JR      Z,UC_NAME_OK            ; trailing dot = no extension
        LD      C,3
UC_NAME_EXT:
        LD      A,(HL)
        CALL    UC_NAME_CHAR
        RET     C
        LD      (DE),A
        INC     DE
        INC     HL
        DEC     B
        JR      Z,UC_NAME_OK
        DEC     C
        JR      NZ,UC_NAME_EXT
        SCF
        RET
UC_NAME_OK:
        OR      A
        RET

; A=character -> uppercase A/NC, or carry for invalid filename character.
UC_NAME_CHAR:
        CALL    UC_UPPER
        CP      'A'
        JR      C,UC_NAME_DIGIT
        CP      'Z'+1
        JR      C,UC_NAME_OK
UC_NAME_DIGIT:
        CP      '0'
        JR      C,UC_NAME_PUNCT
        CP      '9'+1
        JR      C,UC_NAME_OK
UC_NAME_PUNCT:
        PUSH    HL
        PUSH    BC
        LD      HL,UC_LEGAL
        LD      B,UC_LEGAL_END-UC_LEGAL
UC_NAME_FIND:
        CP      (HL)
        JR      Z,UC_NAME_FOUND
        INC     HL
        DJNZ    UC_NAME_FIND
        POP     BC
        POP     HL
        SCF
        RET
UC_NAME_FOUND:
        POP     BC
        POP     HL
        OR      A
        RET

; Compare two explicit-drive 12-byte FCB names; return Z if identical.
UC_SAME_NAME:
        LD      B,12
UC_SAME_LOOP:
        LD      A,(DE)
        CP      (HL)
        RET     NZ
        INC     DE
        INC     HL
        DJNZ    UC_SAME_LOOP
        RET

; DE=target FCB; returns Z only if no matching directory entry exists.
UC_EXISTS:
        PUSH    DE
        LD      DE,UC_SEARCH_BUFFER
        LD      C,26
        CALL    UC_BDOS
        POP     HL
        LD      DE,UC_SEARCH
        LD      BC,12
        LDIR
        LD      C,17
        LD      DE,UC_SEARCH
        CALL    UC_BDOS
        CP      0FFH
        RET

UC_MAKE_TEMP:
        LD      A,(UC_DEST)
        LD      (UC_TEMP),A
UC_TEMP_TRY:
        LD      HL,UC_TEMP
        LD      DE,UC_FINAL
        CALL    UC_SAME_NAME
        JR      Z,UC_TEMP_NEXT
        LD      DE,UC_TEMP
        CALL    UC_EXISTS
        JR      NZ,UC_TEMP_NEXT
        LD      DE,UC_TEMP
        LD      C,22
        CALL    UC_BDOS
        CP      0FFH
        JR      Z,UC_TEMP_FAIL
        LD      A,1
        LD      (UC_TEMP_LIVE),A
        LD      (UC_TEMP_OPEN),A
        OR      A
        RET
UC_TEMP_NEXT:
        LD      HL,UC_TEMP+8
        LD      B,5
UC_TEMP_DIGIT:
        INC     (HL)
        LD      A,(HL)
        CP      '9'+1
        JR      C,UC_TEMP_TRY
        LD      (HL),'0'
        DEC     HL
        DJNZ    UC_TEMP_DIGIT
UC_TEMP_FAIL:
        LD      DE,UC_CREATE_MSG
        SCF
        RET

; Codec READ: NC/A=byte; C/A=0 physical EOF; C/A<>0 BDOS read error.
UC_READ:
        LD      A,(UC_IN_LEFT)
        OR      A
        JR      NZ,UC_READ_HAVE
        LD      DE,UC_IN_BUFFER
        LD      C,26
        CALL    UC_BDOS
        LD      DE,UC_INPUT
        LD      C,20
        CALL    UC_BDOS
        OR      A
        JR      Z,UC_READ_FILLED
        CP      1
        JR      NZ,UC_IO_ERROR
        XOR     A
        SCF
        RET
UC_READ_FILLED:
        LD      A,128
        LD      (UC_IN_LEFT),A
        LD      HL,UC_IN_BUFFER
        LD      (UC_IN_PTR),HL
UC_READ_HAVE:
        DEC     A
        LD      (UC_IN_LEFT),A
        LD      HL,(UC_IN_PTR)
        LD      A,(HL)
        INC     HL
        LD      (UC_IN_PTR),HL
        OR      A
        RET
UC_IO_ERROR:
        SCF
        RET

; Codec WRITE: A=byte, NC accepted; C/A=BDOS write failure.
UC_WRITE:
        LD      HL,(UC_OUT_PTR)
        LD      (HL),A
        INC     HL
        LD      (UC_OUT_PTR),HL
        LD      A,(UC_OUT_USED)
        INC     A
        LD      (UC_OUT_USED),A
        CP      128
        JP      Z,UC_FLUSH
        OR      A
        RET
UC_FLUSH:
        LD      DE,UC_OUT_BUFFER
        LD      C,26
        CALL    UC_BDOS
        LD      DE,UC_TEMP
        LD      C,21
        CALL    UC_BDOS
        OR      A
        JR      NZ,UC_IO_ERROR
        LD      (UC_OUT_USED),A
        LD      HL,UC_OUT_BUFFER
        LD      (UC_OUT_PTR),HL
        RET
UC_FINAL_RECORD:
        LD      A,(UC_OUT_USED)
        OR      A
        RET     Z
        LD      B,A
        LD      A,128
        SUB     B
        LD      B,A
        LD      HL,(UC_OUT_PTR)
        LD      A,1AH
UC_PAD:
        LD      (HL),A
        INC     HL
        DJNZ    UC_PAD
        JP      UC_FLUSH

        ENDM

CODEC_FILE_CLEANUP MACRO
UC_ERROR:
        CALL    UC_PRINT
        CALL    UC_CLEANUP
        LD      A,(UC_CLEAN_FAILED)
        OR      A
        JR      Z,UC_EXIT
        LD      DE,UC_CLEAN_MSG
        CALL    UC_PRINT
UC_EXIT:
        LD      DE,80H
        LD      C,26
        CALL    UC_BDOS
        LD      SP,(UC_OLDSP)
        RET

UC_CLEANUP:
        LD      A,(UC_TEMP_OPEN)
        OR      A
        JR      Z,UC_CLEAN_INPUT
        LD      DE,UC_TEMP
        LD      C,16
        CALL    UC_BDOS
        CP      0FFH
        CALL    Z,UC_CLEAN_WARN
        XOR     A
        LD      (UC_TEMP_OPEN),A
UC_CLEAN_INPUT:
        LD      A,(UC_INPUT_OPEN)
        OR      A
        JR      Z,UC_CLEAN_TEMP
        LD      DE,UC_INPUT
        LD      C,16
        CALL    UC_BDOS
        CP      0FFH
        CALL    Z,UC_CLEAN_WARN
        XOR     A
        LD      (UC_INPUT_OPEN),A
UC_CLEAN_TEMP:
        LD      A,(UC_TEMP_LIVE)
        OR      A
        RET     Z
        LD      DE,UC_TEMP
        LD      C,19
        CALL    UC_BDOS
        CP      0FFH
        CALL    Z,UC_CLEAN_WARN
        RET
UC_CLEAN_WARN:
        LD      A,1
        LD      (UC_CLEAN_FAILED),A
        RET

        ENDM
