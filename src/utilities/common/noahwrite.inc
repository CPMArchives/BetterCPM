 LD A,(NW_COMPACT)
 OR A
 LD DE,NW_REMOVE_ASK
 JR Z,NW_PAINT_ASK
 LD DE,NW_COMPACT_ASK
NW_PAINT_ASK:
 JP NH_PRINT
