; LBR write front end. Frozen inputs and accepted plans precede staging.
; The reusable writer never publishes files; the extraction transaction owns it.
NW_ADD_BATCH:
 LD HL,(NS_COUNT)
 LD A,H
 OR L
 JP Z,NW_NO_SOURCES
 LD A,(NC_REQUEST)
 OR A
 JR Z,NW_ADD_PREPARED
 LD HL,NW_TARGET
 LD A,(HL)
 LD (NH_DEST),A
 INC HL
 LD A,(HL)
 LD (NH_DUSER),A
 CALL NC_ADD_PREPARE
 JP C,NH_RETURN
 OR A
 JP Z,NW_NO_SOURCES
NW_ADD_PREPARED:
 LD HL,NW_TARGET
 LD (NS_CURRENT),HL
NW_ARCHIVE:
 XOR A
 LD (NS_ARC_FAILED),A
 LD (NW_PROMPT),A
 LD (NW_SOURCE_OPEN),A
 LD (NX_TEMP_OPEN),A
 LD (NX_VERIFY_OPEN),A
 LD (NX_LIVE),A
 LD (NX_KEEP),A
 LD (NX_ATTEMPTED),A
 LD (NX_PUBLICATION),A
 LD (NW_OLD_OPEN),A
 LD (NW_CONSIDERED),A
 LD HL,NX_FINAL
 LD DE,NX_FINAL+1
 LD BC,36*6-1
 LD (HL),0
 LDIR
 LD HL,NH_CONTEXT
 LD DE,NH_CONTEXT+1
 LD BC,AS_CONTEXT_SIZE+AP_SIZE-1
 LD (HL),0
 LDIR
 LD IX,NH_CONTEXT
 LD (IX+AS_ABI),AS_ABI_VERSION
 LD (IX+AS_SIZE),AS_CONTEXT_SIZE
 LD HL,NH_ADAPTER
 LD (IX+AS_USER),L
 LD (IX+AS_USER+1),H
 CALL NS_QUEUE_FCB
 LD HL,NH_ADAPTER
 LD DE,NX_FINAL
 LD BC,12
 LDIR
 LD HL,(NS_CURRENT)
 LD A,(HL)
 LD (NH_DEST),A
 INC HL
 LD A,(HL)
 LD (NH_DUSER),A
 CALL NW_TARGET_USER
 LD A,1
 LD (NW_ACTIVE),A
 CALL NO_AUTHORIZE
 JP C,NW_FAIL
 OR A
 JP Z,NW_UNCHANGED
 LD A,(NO_EXISTED)
 OR A
 JR Z,NW_NEW
 LD A,1
 LD (NW_OLD_OPEN),A
 CALL AC_OPEN
 JP C,NW_FAIL
 LD IY,NH_AUDIT
 CALL LBR_AUDIT
 JP C,NW_FAIL
 LD HL,NH_AUDIT+LA_UNCHECKED
 CALL NW_NONZERO
 JR Z,NW_INIT
 LD A,1
 LD (NS_WARNINGS),A
 LD DE,NH_CRC_MISSING
 CALL NH_PRINT
 JR NW_INIT
NW_NEW:
 LD A,(NH_MODE)
 CP 3
 JP NZ,NW_IO_ERROR
 LD A,(NW_FORMAT)
 OR A
 JR NZ,NW_INIT
 LD HL,NX_FINAL+9
 LD DE,NW_LBR_EXT
 LD B,3
NW_EXTENSION:
 LD A,(DE)
 CP (HL)
 JP NZ,NW_FORMAT_ERROR
 INC HL
 INC DE
 DJNZ NW_EXTENSION
NW_INIT:
 LD HL,NW_CONTEXT
 LD DE,NW_CONTEXT+1
 LD BC,LW_SIZE-1
 LD (HL),0
 LDIR
 LD IX,NW_CONTEXT
 LD (IX+LW_ABI),1
 LD HL,NW_IO
 LW_SET LW_IO
 LD HL,NW_BUFFER
 LW_SET LW_BUFF
 LD HL,NW_AUX
 LW_SET LW_AUX
 LD HL,NW_FIRST
 LW_SET LW_FIRST
 LD HL,NW_ENTRY
 LW_SET LW_ENTRY
 LD HL,NW_HEADER
 LW_SET LW_HEADER
 LD HL,NS_TABLE
 LD A,(NC_ADD_ACTIVE)
 OR A
 JR Z,NW_IDS_READY
 LD HL,NC_ADD_IDS
NW_IDS_READY:
 LW_SET LW_IDS
 LD HL,NW_PLANS
 LW_SET LW_PLANS
 LD HL,NS_MEMBER_FCB+1
 LW_SET LW_PATTERN
 LD A,(NW_COMPACT)
 OR A
 JR Z,NW_INIT_REMOVE
 SET 1,(IX+LW_FLAGS)
NW_INIT_REMOVE:
 LD A,(NH_MODE)
 CP 4
 JR NZ,NW_INIT_CAP
 SET 2,(IX+LW_FLAGS)
NW_INIT_CAP:
 LD A,(NW_CAP_SET)
 OR A
 JR Z,NW_INIT_OLD
 SET 3,(IX+LW_FLAGS)
 LD HL,NW_CAP
 LD DE,NW_CONTEXT+LW_CAP
 LD BC,4
 LDIR
NW_INIT_OLD:
 LD A,(NO_EXISTED)
 OR A
 JR NZ,NW_OLD_LENGTH
 SET 0,(IX+LW_FLAGS)
 JR NW_DISCOVERY
NW_OLD_LENGTH:
 LD HL,NH_CONTEXT+AS_FILE_SIZE
 LD DE,NW_CONTEXT+LW_OLDREC
 LD BC,3
 ; Convert physical bytes to records (32-bit >>7).
 LD HL,(NH_CONTEXT+AS_FILE_SIZE+2)
 LD DE,(NH_CONTEXT+AS_FILE_SIZE)
 LD B,7
NW_SIZE_SHIFT:
 SRL H
 RR L
 RR D
 RR E
 DJNZ NW_SIZE_SHIFT
 LD (IX+LW_OLDREC),E
 LD (IX+LW_OLDREC+1),D
 LD (IX+LW_OLDREC+2),L
NW_DISCOVERY:
 CALL LW_DISCOVER
 JP C,NW_FAIL
 LD A,(NO_EXISTED)
 OR A
 JR Z,NW_SOURCES
 CALL NW_HASH_OLD
 JP C,NW_FAIL
 LD HL,NW_CONTEXT+LW_DIGEST
 LD DE,NW_OLD_HASH
 LD BC,4
 LDIR
NW_SOURCES:
 LD A,(NH_MODE)
 CP 3
 JP NZ,NW_PLAN
 LD HL,(NS_COUNT)
 LW_SET LW_COUNT
 LD HL,NW_PLANS
 LD DE,NW_PLANS+1
 LD BC,512*LP_SIZE-1
 LD (HL),0
 LDIR
 LD HL,0
 LD (NW_INDEX),HL
NW_ACCEPT_LOOP:
 LD HL,(NW_INDEX)
 LW_SET LW_SOURCE
 CALL LW_PLAN_PTR
 JP C,NW_PLAN
 LD A,(NC_ADD_ACTIVE)
 OR A
 JR Z,NW_PREP_SOURCE
 CALL NC_ADD_VALID
 JP C,NW_FAIL
 OR A
 JP Z,NW_SKIP_SOURCE
NW_PREP_SOURCE:
 CALL NW_SOURCE_NAME
 LD A,(NS_QUIET)
 OR A
 CALL Z,NW_PRINT_SOURCE
 ; Do not archive the archive itself (exact resolved DU/name).
 CALL LW_ID_NAME
 DEC HL
 DEC HL
 LD DE,NW_TARGET
 LD B,13
NW_SELF_COMPARE:
 LD A,(DE)
 CP (HL)
 JR NZ,NW_CANDIDATE
 INC DE
 INC HL
 DJNZ NW_SELF_COMPARE
 LD A,(NS_QUIET)
 OR A
 CALL NZ,NW_PRINT_SOURCE
 LD DE,NW_SELF_TEXT
 CALL NH_PRINT
 JP NW_SKIP_SOURCE
NW_CANDIDATE:
 LD A,1
 LD (NW_CONSIDERED),A
 CALL NW_OPEN_SOURCE
 JR C,NW_SOURCE_FAILED
 CALL NW_HASH_SOURCE
 JR C,NW_SOURCE_HASH_DONE
 CALL NC_ADD_CHECK_DIGEST
NW_SOURCE_HASH_DONE:
 PUSH AF
 CALL NW_CLOSE_SOURCE
 JR C,NW_SOURCE_CLOSE_FAILED
 POP AF
 JR C,NW_SOURCE_FAILED
 CALL LW_PLAN_PTR
 LD HL,(NW_SOURCE_RECORDS)
 LD (IY+LP_RECORDS),L
 LD (IY+LP_RECORDS+1),H
 LD HL,(NW_CONTEXT+LW_CRC)
 LD (IY+LP_CRC),L
 LD (IY+LP_CRC+1),H
 PUSH IY
 POP DE
 LD HL,LP_DIGEST
 ADD HL,DE
 EX DE,HL
 LD HL,NW_CONTEXT+LW_DIGEST
 LD BC,4
 LDIR
 CALL NW_COLLISION
 JP C,NW_FAIL
 OR A
 JR Z,NW_SKIP_SOURCE
 CALL NW_DISPLACE_PRIOR
 LD HL,(NW_INDEX)
 LW_SET LW_SOURCE
 CALL LW_PLAN_PTR
 LD (IY+LP_STATUS),1
 JR NW_ACCEPT_NEXT
NW_SOURCE_CLOSE_FAILED:
 POP AF
 JP NW_IO_ERROR
NW_SOURCE_FAILED:
 LD A,(NS_QUIET)
 OR A
 CALL NZ,NW_PRINT_SOURCE
 LD DE,NW_SOURCE_ERROR_TEXT
 CALL NH_PRINT
 CALL NW_CLOSE_SOURCE
 JP C,NW_IO_ERROR
 LD A,(NH_ABORTED)
 OR A
 JP NZ,NW_CANCEL
 ; Compressed ADD reads an already verified aggregate here. Its metadata or
 ; payload failure abandons the transaction rather than accepting a new spool.
 LD A,(NC_ADD_ACTIVE)
 OR A
 JP NZ,NW_IO_ERROR
 CALL NI_FAILURE
 JP C,NW_CANCEL
 CP 'R'
 JP Z,NW_CANDIDATE
 LD DE,NW_SOURCE_SKIP_TEXT
 CALL NH_PRINT
NW_SKIP_SOURCE:
 LD A,1
 LD (NS_WARNINGS),A
 LD HL,(NW_INDEX)
 LW_SET LW_SOURCE
 CALL LW_PLAN_PTR
 LD (IY+LP_STATUS),0
NW_ACCEPT_NEXT:
 LD HL,(NW_INDEX)
 INC HL
 LD (NW_INDEX),HL
 JP NW_ACCEPT_LOOP
NW_PLAN:
 CALL NC_ADD_PADS
 JP C,NW_FAIL
 CALL LW_PLAN
 JP C,NW_FAIL
 LD A,(NH_MODE)
 CP 3
 JR NZ,NW_REMOVE_CHECK
 LD A,(NW_CONSIDERED)
 OR A
 JP Z,NW_UNCHANGED
 ; An absent old directory is not an implicit capacity-change request. If
 ; every candidate failed/skipped, no new archive is needed by default.
 LD HL,NW_CONTEXT+LW_ACCEPTED
 CALL NW_NONZERO
 JR NZ,NW_REMOVE_CHECK
 LD A,(NO_EXISTED)
 OR A
 JR NZ,NW_REMOVE_CHECK
 LD A,(NW_CAP_SET)
 OR A
 JP Z,NW_UNCHANGED
NW_REMOVE_CHECK:
 LD A,(NH_MODE)
 CP 4
 JR NZ,NW_COMPACT_CHECK
 LD HL,NW_CONTEXT+LW_MATCHED
 CALL NW_NONZERO
 JP Z,NW_NO_MEMBERS
 CALL NW_LIST_REMOVALS
 JP C,NW_FAIL
 LD A,2
 LD (NW_PROMPT),A
 CALL NW_DESTRUCTIVE
 JP C,NW_CANCEL
 OR A
 JP Z,NW_UNCHANGED
 JR NW_STAGE
NW_COMPACT_CHECK:
 LD A,(NW_COMPACT)
 OR A
 JR Z,NW_CHANGE_CHECK
 LD A,3
 LD (NW_PROMPT),A
 CALL NW_DESTRUCTIVE
 JP C,NW_CANCEL
 OR A
 JP Z,NW_UNCHANGED
 JR NW_STAGE
NW_CHANGE_CHECK:
 LD HL,NW_CONTEXT+LW_ACCEPTED
 CALL NW_NONZERO
 JR NZ,NW_STAGE
 LD HL,(NW_CONTEXT+LW_DIRECTORY)
 LD DE,(NW_CONTEXT+LW_OLDDIR)
 OR A
 SBC HL,DE
 JP Z,NW_UNCHANGED
NW_STAGE:
 XOR A
 LD (NW_PROMPT),A
 BIT 4,(IX+LW_FLAGS)
 JR Z,NW_STAGE_PAIR
 LD DE,NW_REBUILD_TEXT
 CALL NH_PRINT
 LD HL,(NW_CONTEXT+LW_OLDDIR)
 CALL NS_PRINT_WORD
 LD DE,NW_DIR_ARROW
 CALL NH_PRINT
 LD HL,(NW_CONTEXT+LW_DIRECTORY)
 CALL NS_PRINT_WORD
 LD DE,NH_NEWLINE
 CALL NH_PRINT
NW_STAGE_PAIR:
 LD A,(NS_QUIET)
 OR A
 JR NZ,NW_STAGE_FILES
 LD DE,NW_CAPACITY_TEXT
 CALL NH_PRINT
 LD HL,NW_CONTEXT+LW_CAPACITY
 CALL NH_PRINT_COUNT
 LD DE,NH_NEWLINE
 CALL NH_PRINT
NW_STAGE_FILES:
 CALL NX_TEMP_PAIR
 JP C,NW_FAIL
 LD A,1
 LD (NX_ATTEMPTED),A
 LD DE,NX_TEMP
 LD C,22
 CALL AC_BDOS
 CP 255
 JP Z,NW_IO_ERROR
 LD A,1
 LD (NX_LIVE),A
 LD (NX_TEMP_OPEN),A
 LD (IX+LW_VERIFY),0
 CALL LW_RUN
 JP C,NW_FAIL
 CALL NW_CLOSE_SOURCE
 JP C,NW_FAIL
 LD DE,NX_TEMP
 LD C,16
 CALL AC_BDOS
 CP 255
 JP Z,NW_CLOSE_ERROR
 XOR A
 LD (NX_TEMP_OPEN),A
 LD HL,NX_TEMP
 LD DE,NX_VERIFY
 LD BC,12
 LDIR
 LD DE,NX_VERIFY
 LD C,15
 CALL AC_BDOS
 CP 255
 JP Z,NW_IO_ERROR
 LD A,1
 LD (NX_VERIFY_OPEN),A
 LD (IX+LW_VERIFY),A
 CALL LW_RUN
 JP C,NW_FAIL
 CALL NW_CLOSE_SOURCE
 JP C,NW_FAIL
 ; Physical size must also agree: appended garbage is not verified output.
 LD DE,NX_VERIFY
 LD C,35
 CALL AC_BDOS
 LD HL,NX_VERIFY+33
 LD DE,NW_CONTEXT+LW_OUTREC
 LD B,3
NW_STAGE_SIZE:
 LD A,(DE)
 CP (HL)
 JP NZ,NW_VERIFY_ERROR
 INC HL
 INC DE
 DJNZ NW_STAGE_SIZE
 LD DE,NX_VERIFY
 LD C,16
 CALL AC_BDOS
 CP 255
 JP Z,NW_CLOSE_ERROR
 XOR A
 LD (NX_VERIFY_OPEN),A
 ; Final stability check includes empty sources and the entire original.
 LD A,(NO_EXISTED)
 OR A
 JR Z,NW_RECHECK_SOURCES
 LD DE,NH_ADAPTER
 LD C,35
 CALL AC_BDOS
 LD HL,NH_ADAPTER+33
 LD DE,NW_CONTEXT+LW_OLDREC
 LD B,3
NW_OLD_SIZE_CHECK:
 LD A,(DE)
 CP (HL)
 JP NZ,NW_VERIFY_ERROR
 INC HL
 INC DE
 DJNZ NW_OLD_SIZE_CHECK
 CALL NW_HASH_OLD
 JP C,NW_FAIL
 LD HL,NW_CONTEXT+LW_DIGEST
 LD DE,NW_OLD_HASH
 CALL NW_EQUAL4
 JP NZ,NW_VERIFY_ERROR
NW_RECHECK_SOURCES:
 LD HL,0
 LD (NW_INDEX),HL
NW_RECHECK_LOOP:
 LD HL,(NW_INDEX)
 LW_SET LW_SOURCE
 CALL LW_PLAN_PTR
 JR C,NW_PUBLISH
 LD A,(IY+LP_STATUS)
 OR A
 JR Z,NW_RECHECK_NEXT
 CALL NW_OPEN_SOURCE
 JP C,NW_FAIL
 CALL NW_HASH_SOURCE
 JP C,NW_FAIL
 CALL NW_COMPARE_SOURCE
 JP C,NW_FAIL
 CALL NW_CLOSE_SOURCE
 JP C,NW_FAIL
NW_RECHECK_NEXT:
 LD HL,(NW_INDEX)
 INC HL
 LD (NW_INDEX),HL
 JR NW_RECHECK_LOOP
NW_PUBLISH:
 CALL NC_ADD_RECHECK
 JP C,NW_FAIL
 CALL NW_CLOSE_OLD
 JP C,NW_FAIL
 CALL NX_POLL
 JP C,NW_CANCEL
 LD A,1
 LD (NX_KEEP),A
 CALL NO_PUBLISH
 JP C,NW_FAIL
 LD DE,NW_DONE_TEXT
 CALL NH_PROGRESS
 LD DE,NW_ACCEPTED_TEXT
 CALL NH_PRINT
 LD HL,NW_CONTEXT+LW_ACCEPTED
 CALL NH_PRINT_COUNT
 LD A,(NS_WARNINGS)
 OR A
 LD DE,NW_PARTIAL_TEXT
 CALL NZ,NH_PRINT
 LD DE,NH_NEWLINE
 CALL NH_PRINT
 JP NW_FINISH
NW_NO_SOURCES:
 LD DE,NW_NO_SOURCES_TEXT
 CALL NH_PRINT
 JP NH_RETURN
NW_NO_MEMBERS:
 LD DE,NS_NO_MEMBERS
 CALL NH_PRINT
 JP NW_FINISH
NW_UNCHANGED:
 LD DE,NW_UNCHANGED_TEXT
 CALL NH_PRINT
 JP NW_FINISH
NW_CANCEL:
 LD A,AS_CANCEL
 JR NW_FAIL
NW_FORMAT_ERROR:
 LD DE,NW_FORMAT_TEXT
 CALL NH_PRINT
 LD A,AS_UNSUPPORTED
 JR NW_FAIL
NW_CLOSE_ERROR:
 LD A,1
 LD (NX_KEEP),A
NW_IO_ERROR:
 LD A,AS_IO
 JR NW_FAIL
NW_VERIFY_ERROR:
 LD A,AS_FORMAT
NW_FAIL:
 LD (NH_ERROR),A
 LD HL,NX_FINAL
 CALL NX_PRINT_FCB
 LD DE,NH_NEWLINE
 CALL NH_PRINT
 LD A,1
 LD (NS_ARC_FAILED),A
 LD DE,NW_FAILED_TEXT
 CALL NH_PRINT
 LD A,(NH_ERROR)
 CALL NH_HEX
 LD DE,NH_NEWLINE
 CALL NH_PRINT
 ; Rebuild a whole uncompressed transaction, never a partial archive. The
 ; compressed aggregate remains outside this restart contract.
 LD A,(NX_ATTEMPTED)
 OR A
 JR Z,NW_FINISH
 LD A,(NC_ADD_ACTIVE)
 OR A
 JR NZ,NW_FINISH
 CALL NW_CLOSE_SOURCE
 JR C,NW_FINISH
 CALL NW_CLOSE_OLD
 JR C,NW_FINISH
 CALL NX_RETRY_CLEANUP
 JR C,NW_FINISH
 CALL NI_FAILURE
 JR C,NW_FINISH
 CP 'R'
 JP Z,NW_ARCHIVE
NW_FINISH:
 CALL NW_CLOSE_SOURCE
 JR NC,NW_FINISH_OLD
 LD A,1
 LD (NS_ARC_FAILED),A
 LD (NS_STOP),A
NW_FINISH_OLD:
 CALL NW_CLOSE_OLD
 JR NC,NW_FINISH_TEMP
 LD A,1
 LD (NS_ARC_FAILED),A
 LD (NS_STOP),A
NW_FINISH_TEMP:
 CALL NX_CLEANUP
 CALL NC_ADD_CLEANUP
 XOR A
 LD (NW_ACTIVE),A
 LD (NW_PROMPT),A
 LD A,(NH_MODE)
 CP 3
 JP Z,NH_RETURN
 JP NS_ARCHIVE_DONE
NW_CLOSE_OLD:
 LD A,(NW_OLD_OPEN)
 OR A
 RET Z
 LD IX,NH_CONTEXT
 CALL AC_CLOSE
 LD IX,NW_CONTEXT
 RET C
 XOR A
 LD (NW_OLD_OPEN),A
 RET
NW_TARGET_USER:
 LD A,(NH_DUSER)
 LD E,A
 LD C,32
 JP AC_BDOS
; Source open/cache owns its user; all returns restore target user.
NW_OPEN_SOURCE:
 LD A,(NW_SOURCE_OPEN)
 OR A
 JR Z,NW_OPEN_FRESH
 LD HL,(NW_CACHE)
 LD DE,(NW_CONTEXT+LW_SOURCE)
 OR A
 SBC HL,DE
 RET Z
 CALL NW_CLOSE_SOURCE
 RET C
NW_OPEN_FRESH:
 LD A,(NC_ADD_ACTIVE)
 OR A
 JP NZ,NC_ADD_OPEN_SOURCE
 CALL LW_ID_NAME
 DEC HL
 LD A,(HL)
 LD (NW_SOURCE_USER),A
 LD E,A
 LD C,32
 CALL AC_BDOS
 DEC HL
 LD A,(HL)
 INC A
 LD (NW_SOURCE),A
 INC HL
 INC HL
 LD DE,NW_SOURCE+1
 LD BC,11
 LDIR
 LD HL,NW_SOURCE+12
 LD DE,NW_SOURCE+13
 LD BC,23
 LD (HL),0
 LDIR
 LD DE,NW_SOURCE
 LD C,15
 CALL AC_BDOS
 CP 255
 JR Z,NW_OPEN_BAD
 LD A,1
 LD (NW_SOURCE_OPEN),A
 LD HL,(NW_CONTEXT+LW_SOURCE)
 LD (NW_CACHE),HL
 LD DE,NW_SOURCE
 LD C,35
 CALL AC_BDOS
 LD A,(NW_SOURCE+35)
 OR A
 JR NZ,NW_OPEN_RANGE
 LD HL,(NW_SOURCE+33)
 LD (NW_SOURCE_RECORDS),HL
 CALL NW_TARGET_USER
 OR A
 RET
NW_OPEN_RANGE:
 CALL NW_TARGET_USER
 LD A,AS_RANGE
 SCF
 RET
NW_OPEN_BAD:
 CALL NW_TARGET_USER
 LD A,AS_IO
 SCF
 RET
NW_CLOSE_SOURCE:
 LD A,(NW_SOURCE_OPEN)
 OR A
 RET Z
 LD A,(NW_SOURCE_USER)
 LD E,A
 LD C,32
 CALL AC_BDOS
 LD DE,NW_SOURCE
 LD C,16
 CALL AC_BDOS
 LD (NW_CLOSE_RESULT),A
 CALL NW_TARGET_USER
 LD A,(NW_CLOSE_RESULT)
 CP 255
 LD A,AS_IO
 SCF
 RET Z
 XOR A
 LD (NW_SOURCE_OPEN),A
 RET
NW_IO:
 PUSH IY
 CALL NW_IO_CORE
 POP IY
 RET
NW_IO_CORE:
 LD (NW_IO_KIND),A
 CALL NX_POLL
 RET C
 LD A,(NW_IO_KIND)
 OR A
 LD DE,NH_ADAPTER
 JR Z,NW_IO_FCB
 CP 1
 JR NZ,NW_IO_STAGE
 CALL NW_OPEN_SOURCE
 RET C
 CALL LW_PLAN_PTR
 LD HL,(NW_SOURCE_RECORDS)
 LD E,(IY+LP_RECORDS)
 LD D,(IY+LP_RECORDS+1)
 OR A
 SBC HL,DE
 JP NZ,LW_TRUNC
 LD A,(NW_SOURCE_USER)
 LD E,A
 LD C,32
 CALL AC_BDOS
 LD DE,NW_SOURCE
 JR NW_IO_FCB
NW_IO_STAGE:
 LD DE,NX_VERIFY
 CP 2
 JR Z,NW_IO_FCB
 LD DE,NX_TEMP
NW_IO_FCB:
 LD (NW_IO_FCB_PTR),DE
 LD HL,33
 ADD HL,DE
 LD A,(IX+LW_IOREC)
 LD (HL),A
 INC HL
 LD A,(IX+LW_IOREC+1)
 LD (HL),A
 INC HL
 LD A,(IX+LW_IOREC+2)
 LD (HL),A
 LD A,(NW_IO_KIND)
 CP 1
 JR NZ,NW_IO_RECORD_READY
 CALL NC_ADD_ADJUST
 RET C
NW_IO_RECORD_READY:
 LD E,(IX+LW_IOBUF)
 LD D,(IX+LW_IOBUF+1)
 LD C,26
 CALL AC_BDOS
 LD DE,(NW_IO_FCB_PTR)
 LD C,33
 LD A,(NW_IO_KIND)
 CP 3
 JR NZ,NW_IO_CALL
 LD C,34
NW_IO_CALL:
 CALL AC_BDOS
 LD (NW_IO_RESULT),A
 CALL NW_TARGET_USER
 LD A,(NW_IO_RESULT)
 OR A
 JR NZ,NW_IO_BAD
 LD (IX+LW_ACTUAL),128
 LD (IX+LW_ACTUAL+1),0
 RET
NW_IO_BAD:
 LD A,AS_IO
 SCF
 RET
; Hash routines use independent preflight bytes, not the staged output.
NW_HASH_SOURCE:
 CALL LW_HASH_BEGIN
 CALL LW_IO_ZERO
 LD HL,NW_BUFFER
 LW_SET LW_IOBUF
NW_HASH_SOURCE_LOOP:
 LW_GET LW_IOREC
 LD DE,(NW_SOURCE_RECORDS)
 OR A
 SBC HL,DE
 RET Z
 ; Preflight bypasses the still-uninitialized accepted plan length check.
 LD A,(NW_SOURCE_USER)
 LD E,A
 LD C,32
 CALL AC_BDOS
 LD HL,NW_CONTEXT+LW_IOREC
 LD DE,NW_SOURCE+33
 LD BC,3
 LDIR
 CALL NC_ADD_ADJUST
 RET C
 LD DE,NW_BUFFER
 LD C,26
 CALL AC_BDOS
 LD DE,NW_SOURCE
 LD C,33
 CALL AC_BDOS
 LD (NW_IO_RESULT),A
 CALL NW_TARGET_USER
 LD A,(NW_IO_RESULT)
 OR A
 JP NZ,NW_IO_BAD
 CALL LW_HASH_RECORD
 CALL NW_NEXT_RECORD
 CALL NX_POLL
 RET C
 JR NW_HASH_SOURCE_LOOP
NW_HASH_OLD:
 CALL LW_HASH_BEGIN
 CALL LW_IO_ZERO
 LD HL,NW_BUFFER
 LW_SET LW_IOBUF
NW_HASH_OLD_LOOP:
 LD HL,NW_CONTEXT+LW_IOREC
 LD DE,NW_CONTEXT+LW_OLDREC
 LD B,3
NW_HASH_OLD_COMPARE:
 LD A,(DE)
 CP (HL)
 JR NZ,NW_HASH_OLD_READ
 INC HL
 INC DE
 DJNZ NW_HASH_OLD_COMPARE
 OR A
 RET
NW_HASH_OLD_READ:
 XOR A
 CALL LW_CALL_IO
 RET C
 CALL LW_HASH_RECORD
 CALL NW_NEXT_RECORD
 JR NW_HASH_OLD_LOOP
NW_NEXT_RECORD:
 INC (IX+LW_IOREC)
 RET NZ
 INC (IX+LW_IOREC+1)
 RET NZ
 INC (IX+LW_IOREC+2)
 RET
NW_COMPARE_SOURCE:
 CALL LW_PLAN_PTR
 LD HL,(NW_SOURCE_RECORDS)
 LD E,(IY+LP_RECORDS)
 LD D,(IY+LP_RECORDS+1)
 OR A
 SBC HL,DE
 JP NZ,LW_TRUNC
 PUSH IY
 POP DE
 LD HL,LP_DIGEST
 ADD HL,DE
 EX DE,HL
 LD HL,NW_CONTEXT+LW_DIGEST
 CALL NW_EQUAL4
 JP NZ,LW_TRUNC
 OR A
 RET
NW_EQUAL4:
 LD B,4
NW_EQUAL4_LOOP:
 LD A,(DE)
 CP (HL)
 RET NZ
 INC HL
 INC DE
 DJNZ NW_EQUAL4_LOOP
 RET
NW_NONZERO:
 LD B,4
 XOR A
NW_NONZERO_LOOP:
 OR (HL)
 INC HL
 DJNZ NW_NONZERO_LOOP
 RET
NW_PRINT_SOURCE:
 CALL LW_ID_NAME
 DEC HL
 LD E,(HL)
 DEC HL
 LD D,(HL)
 CALL NS_PRINT_DU
 CALL LW_ID_NAME
 LD B,8
 CALL NH_PRINT_FIELD
 LD E,'.'
 LD C,2
 CALL AC_BDOS
 LD B,3
 CALL NH_PRINT_FIELD
 LD DE,NH_NEWLINE
 JP NH_PRINT
NW_SOURCE_NAME:
 CALL LW_ID_NAME
 LD DE,NW_ENTRY+1
 LD BC,11
 LDIR
 RET
; Find prior accepted same-name sources before consulting original directory.
NW_COLLISION:
 XOR A
 LD (NW_COLLIDED),A
 LD HL,0
 LW_SET LW_SOURCE
NW_COLLISION_LOOP:
 LW_GET LW_SOURCE
 LD DE,(NW_INDEX)
 OR A
 SBC HL,DE
 JR Z,NW_COLLISION_OLD
 CALL LW_PLAN_PTR
 LD A,(IY+LP_STATUS)
 OR A
 JR Z,NW_COLLISION_NEXT
 CALL LW_ID_NAME
 LD DE,NW_ENTRY+1
 CALL LW_NAME_EQUAL
 JR NZ,NW_COLLISION_NEXT
 LD A,1
 LD (NW_COLLIDED),A
NW_COLLISION_NEXT:
 CALL LW_NEXT_SOURCE
 JR NW_COLLISION_LOOP
NW_COLLISION_OLD:
 LD HL,(NW_INDEX)
 LW_SET LW_SOURCE
 CALL NW_SOURCE_NAME
 CALL LW_FIND
 RET C
 LD B,A
 LD A,(NW_COLLIDED)
 OR B
 JR Z,NW_COLLISION_ACCEPT
 LD A,(NS_YES)
 LD B,A
 LD A,(NS_ALL)
 OR B
 JR NZ,NW_COLLISION_ACCEPT
 LD A,1
 LD (NW_PROMPT),A
 XOR A
 CALL NI_ASK
 PUSH AF
 XOR A
 LD (NW_PROMPT),A
 POP AF
 RET
NW_COLLISION_ACCEPT:
 LD A,1
 OR A
 RET
NW_DISPLACE_PRIOR:
 LD HL,(NW_INDEX)
 LW_SET LW_SOURCE
 CALL NW_SOURCE_NAME
 LD HL,0
 LW_SET LW_SOURCE
NW_DISPLACE_LOOP:
 LW_GET LW_SOURCE
 LD DE,(NW_INDEX)
 OR A
 SBC HL,DE
 RET Z
 CALL LW_PLAN_PTR
 LD A,(IY+LP_STATUS)
 OR A
 JR Z,NW_DISPLACE_NEXT
 CALL LW_ID_NAME
 LD DE,NW_ENTRY+1
 CALL LW_NAME_EQUAL
 JR NZ,NW_DISPLACE_NEXT
 LD (IY+LP_STATUS),2
NW_DISPLACE_NEXT:
 CALL LW_NEXT_SOURCE
 JR NW_DISPLACE_LOOP
NW_LIST_REMOVALS:
 XOR A
 LD (NW_PAGE_ROWS),A
 LD IX,NH_CONTEXT
 CALL LBR_OPEN
 JR C,NW_REMOVAL_RETURN
NW_REMOVAL_LOOP:
 CALL LBR_NEXT
 JR C,NW_REMOVAL_END
 CALL NS_MEMBER_MATCH
 JR NZ,NW_REMOVAL_LOOP
 LD HL,NH_CONTEXT+AS_MEMBER
 LD B,8
 CALL NH_PRINT_FIELD
 LD E,'.'
 LD C,2
 CALL AC_BDOS
 LD HL,NH_CONTEXT+AS_MEMBER+8
 LD B,3
 CALL NH_PRINT_FIELD
 LD DE,NH_NEWLINE
 CALL NH_PRINT
 CALL NX_POLL
 JR C,NW_REMOVAL_RETURN
 LD A,(NS_YES)
 OR A
 JR NZ,NW_REMOVAL_LOOP
 LD HL,NW_PAGE_ROWS
 INC (HL)
 LD A,(HL)
 CP 20
 JR C,NW_REMOVAL_LOOP
 XOR A
 LD (HL),A
 LD DE,NW_MORE_TEXT
 CALL NH_PRINT
 LD A,1
 LD (NI_WAIT),A
 CALL NI_READ
 LD B,A
 XOR A
 LD (NI_WAIT),A
 LD A,B
 CP 3
 JR Z,NW_REMOVAL_CANCEL
 CP 27
 JR Z,NW_REMOVAL_CANCEL
 LD DE,NH_NEWLINE
 CALL NH_PRINT
 JR NW_REMOVAL_LOOP
NW_REMOVAL_CANCEL:
 CALL NX_POLL_STOP
 JR NW_REMOVAL_RETURN
NW_REMOVAL_END:
 CP AS_END
 JR NZ,NW_REMOVAL_ERROR
 OR A
 JR NW_REMOVAL_RETURN
NW_REMOVAL_ERROR:
 SCF
NW_REMOVAL_RETURN:
 LD IX,NW_CONTEXT
 RET
NW_DESTRUCTIVE:
 LD A,(NS_YES)
 OR A
 JR Z,NW_ASK_DESTRUCTIVE
 CALL NW_PAINT
 LD A,1
 OR A
 RET
NW_ASK_DESTRUCTIVE:
 LD A,4
 JP NI_ASK
NW_PAINT:
 LD HL,NX_FINAL
 CALL NX_PRINT_FCB
 LD A,(NW_PROMPT)
 CP 1
 JR NZ,NW_PAINT_DESTRUCTIVE
 LD DE,NW_REPLACE_TEXT
 CALL NH_PRINT
 LD HL,(NW_INDEX)
 LW_SET LW_SOURCE
 CALL LW_ID_NAME
 LD B,11
 CALL NH_PRINT_FIELD
 LD DE,NW_REPLACE_ASK
 JP NH_PRINT
