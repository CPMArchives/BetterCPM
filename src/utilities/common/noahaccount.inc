; Reporting only. Extraction folds validated per-archive final counters once.
; ADD keeps one two-bit final candidate state across codec/writer phases:
; 0 unprocessed, 1 accepted/prepared, 2 declined/excluded, 3 failed.
NA_INIT:
 XOR A
 LD HL,NA_DATA
 LD DE,NA_DATA+1
 LD BC,NA_END-NA_DATA-1
 LD (HL),A
 LDIR
 RET
NA_RESET_ADD:
 LD A,(NH_MODE)
 CP 3
 RET NZ
 XOR A
 LD (NA_PUBLISHED),A
 LD A,(NC_ADD_ACTIVE)
 OR A
 RET NZ
 LD HL,NA_STATES
 LD DE,NA_STATES+1
 LD BC,127
 LD (HL),0
 LDIR
 RET
; HL candidate index -> HL containing packed byte, B rotation count.
NA_ADDRESS:
 LD A,L
 AND 3
 LD B,A
 SRL H
 RR L
 SRL H
 RR L
 LD DE,NA_STATES
 ADD HL,DE
 RET
NA_GET:
 CALL NA_ADDRESS
 LD A,(HL)
 INC B
NA_GET_ROTATE:
 DEC B
 JR Z,NA_GET_DONE
 RRCA
 RRCA
 JR NA_GET_ROTATE
NA_GET_DONE:
 AND 3
 RET
; A status, HL candidate index. No file/plan contents are changed.
NA_SET:
 PUSH AF
 CALL NA_ADDRESS
 POP AF
 LD C,A
 LD A,3
 INC B
NA_SET_ROTATE:
 DEC B
 JR Z,NA_SET_DONE
 RLCA
 RLCA
 RLC C
 RLC C
 JR NA_SET_ROTATE
NA_SET_DONE:
 CPL
 AND (HL)
 OR C
 LD (HL),A
 RET
NA_WRITER_SET:
 LD HL,(NW_INDEX)
 JP NA_SET
NA_WRITER_SKIP:
 LD HL,(NW_INDEX)
 CALL NA_GET
 CP 3
 RET Z
 LD A,2
 JP NA_WRITER_SET
NA_EXTRACT:
 LD A,1
 LD (NA_MODE),A
 LD HL,NX_COMPLETED
 LD DE,NA_COUNTS
 LD C,4
NA_ADD_WORD:
 LD B,4
 OR A
NA_ADD_BYTE:
 LD A,(DE)
 ADC A,(HL)
 LD (DE),A
 INC HL
 INC DE
 DJNZ NA_ADD_BYTE
 DEC C
 JR NZ,NA_ADD_WORD
 RET
NA_FINISH:
 LD A,(NA_MODE)
 OR A
 RET Z
 CP 2
 CALL Z,NA_ADD_TOTALS
 LD HL,NA_COUNTS
 CALL NH_FILE_COUNT
 LD DE,NA_EXTRACT_SUM
 LD A,(NA_MODE)
 CP 2
 JR NZ,NA_SUM_ACTION
 LD DE,NA_ADD_SUM
NA_SUM_ACTION:
 CALL NH_PRINT
 LD HL,NA_COUNTS+4
 PUSH HL
 CALL NW_NONZERO
 POP HL
 JR Z,NA_SUM_FAILED
 CALL NH_FILE_COUNT
 LD DE,NA_SKIP_SUM
 CALL NH_PRINT
NA_SUM_FAILED:
 LD HL,NA_COUNTS+8
 PUSH HL
 CALL NW_NONZERO
 POP HL
 JR Z,NA_SUM_UNPROCESSED
 CALL NH_FILE_COUNT
 LD DE,NA_FAIL_SUM
 CALL NH_PRINT
NA_SUM_UNPROCESSED:
 LD HL,NA_COUNTS+12
 PUSH HL
 CALL NW_NONZERO
 POP HL
 RET Z
 CALL NH_FILE_COUNT
 LD DE,NA_UNPROCESSED_SUM
 JP NH_PRINT
NA_EXTRACT_SUM: DB ' extracted.',13,10,'$'
NA_ADD_SUM: DB ' added.',13,10,'$'
NA_SKIP_SUM: DB ' skipped.',13,10,'$'
NA_FAIL_SUM: DB ' failed.',13,10,'$'
NA_UNPROCESSED_SUM: DB ' unprocessed.',13,10,'$'
NA_ADD_TOTALS:
 LD HL,0
 LD (NA_INDEX),HL
NA_TOTAL_NEXT:
 LD HL,(NA_INDEX)
 LD DE,(NS_COUNT)
 OR A
 SBC HL,DE
 RET Z
 LD HL,(NA_INDEX)
 CALL NA_GET
 CP 1
 JR NZ,NA_NOT_ACCEPTED
 LD A,(NA_PUBLISHED)
 OR A
 JR Z,NA_PENDING
 LD HL,(NA_ACCEPTED)
 INC HL
 LD (NA_ACCEPTED),HL
 ; Publication follows a complete plan. Status 2 is a superseded version,
 ; not another completed active member (even if deleted payload is retained).
 LD A,(NH_ARK)
 OR A
 JR Z,NA_LBR_ACTIVE_PLAN
 LD HL,(NA_INDEX)
 CALL NW_ARC_ACTIVE
 LD A,2
 JR Z,NA_CATEGORY
 XOR A
 JR NA_CATEGORY
NA_LBR_ACTIVE_PLAN:
 LD HL,(NA_INDEX)
 LD D,H
 LD E,L
 ADD HL,HL
 ADD HL,DE
 ADD HL,HL
 ADD HL,HL
 LD DE,NW_PLANS
 ADD HL,DE
 LD A,(HL)
 CP 1
 LD A,2
 JR NZ,NA_CATEGORY
 XOR A
 JR NA_CATEGORY
NA_NOT_ACCEPTED:
 OR A
 JR NZ,NA_CATEGORY
NA_PENDING:
 LD A,(NS_DISPOSITION)
 CP 2
 JR NZ,NA_UNPROCESSED
 LD A,(NS_ARC_FAILED)
 LD HL,NH_ABORTED
 OR (HL)
 JR NZ,NA_UNPROCESSED
 LD A,2
 JR NA_CATEGORY
NA_UNPROCESSED:
 LD A,4
NA_CATEGORY:
 CP 2
 JR NZ,NA_CATEGORY_READY
 PUSH AF
 LD A,1
 LD (NS_WARNINGS),A
 POP AF
NA_CATEGORY_READY:
 ; 0=completed, 2=skipped, 3=failed, 4=unprocessed.
 OR A
 JR Z,NA_OFFSET
 DEC A
NA_OFFSET:
 ADD A,A
 ADD A,A
 LD E,A
 LD D,0
 LD HL,NA_COUNTS
 ADD HL,DE
 CALL NX_INC_COUNT
 LD HL,(NA_INDEX)
 INC HL
 LD (NA_INDEX),HL
 JP NA_TOTAL_NEXT
 ; LIST/TEST/EXTRACT never use ADD's packed candidate storage.
NA_CRC_CHECKED EQU NA_STATES
NA_CRC_UNCHECKED EQU NA_STATES+4
NA_NOT_SELECTED EQU NA_STATES+8
NA_LISTED EQU NA_STATES+12
NA_AUDIT:
 PUSH AF
 LD HL,NH_AUDIT+LA_CHECKED
 LD DE,NA_CRC_CHECKED
 LD C,2
 CALL NA_ADD_WORD
 LD HL,NH_AUDIT+LA_NOT_SELECTED
 LD DE,NA_NOT_SELECTED
 LD C,1
 CALL NA_ADD_WORD
 POP AF
 RET
NA_ENUMERATION:
 LD A,(NH_MODE)
 CP 2
 RET NC
 LD HL,NS_MATCHED
 LD DE,NA_LISTED
 LD C,1
 JP NA_ADD_WORD
NA_RESET_NAMES:
 LD A,(NA_REC_FLAGS)
 AND 0FCH
 LD (NA_REC_FLAGS),A
 RET
NA_REC_TEMP:
 LD A,1
 JR NA_REC_NAME
NA_REC_BACKUP:
 LD A,2
 JR NA_REC_NAME
NA_REC_SPOOL:
 LD A,4
 JR NA_REC_NAME
NA_REC_AGGREGATE:
 LD A,8
NA_REC_NAME:
 PUSH HL
 LD HL,NA_REC_FLAGS
 ; A is the role mask; the same owned/reported name may be diagnosed twice.
 PUSH AF
 AND (HL)
 JR NZ,NA_REC_SEEN
 POP AF
 OR (HL)
 LD (HL),A
 LD HL,NA_REC_TOTAL
 CALL NX_INC_COUNT
 POP HL
 RET
NA_REC_SEEN:
 POP AF
 POP HL
 RET
NA_COVER_REPORT:
 LD A,(NS_RESULT_ACTIVE)
 OR A
 RET Z
 LD A,(NS_FATAL)
 OR A
 JR NZ,NA_PRINT_RECOVERY
 LD A,(NH_MODE)
 CP 2
 JR Z,NA_COVER_LIMIT
 JR NC,NA_PRINT_RECOVERY
 LD HL,NA_LISTED
 CALL NH_FILE_COUNT
 LD DE,NA_LIST_SUM
 LD A,(NH_MODE)
 OR A
 JR NZ,NA_COVER_TEST
 LD A,(NS_ERRORS)
 OR A
 JR Z,NA_COVER_SUM
 LD DE,NA_LIST_PARTIAL
 JR NA_COVER_SUM
NA_COVER_TEST:
 LD DE,NA_TEST_SUM
NA_COVER_SUM:
 CALL NH_PRINT
 LD A,(NH_MODE)
 OR A
 JR Z,NA_PRINT_RECOVERY
NA_COVER_LIMIT:
 LD HL,NA_CRC_UNCHECKED
 PUSH HL
 CALL NW_NONZERO
 POP HL
 JR Z,NA_PRINT_RECOVERY
 LD DE,NA_CRC_LIMIT
 CALL NH_PRINT
 LD HL,NA_CRC_UNCHECKED
 CALL NH_PRINT_COUNT
 LD DE,NH_NEWLINE
 CALL NH_PRINT
NA_PRINT_RECOVERY:
 LD HL,NA_REC_TOTAL
 PUSH HL
 CALL NW_NONZERO
 POP HL
 RET Z
 LD DE,NA_REC_TEXT
 CALL NH_PRINT
 LD HL,NA_REC_TOTAL
 CALL NH_PRINT_COUNT
 LD DE,NH_NEWLINE
 JP NH_PRINT
NA_LIST_PARTIAL: DB ' listed before error.',13,10,'$'
NA_LIST_SUM: DB ' listed. Contents not tested.',13,10,'$'
NA_TEST_SUM: DB ' checked; see CRC results above.',13,10,'$'
NA_CRC_LIMIT: DB 'CRC coverage unavailable/ambiguous: ','$'
NA_LISTED_TEXT: DB 'Listed members : ','$'
NA_LIST_ONLY: DB 'LIST: contents not tested.',13,10,'$'
NA_CRC_TEXT: DB 'Known CRC regions : verified ','$'
NA_REC_TEXT: DB 'Recovery artifacts reported: ','$'
NA_MEMBER_TEXT: DB 'Known members : completed ','$'
NA_CANDIDATE_TEXT: DB 'ADD candidates : completed ','$'
NA_ACCEPTED_TEXT: DB 'Accepted candidates : ','$'
NOAH_ACCOUNT_DATA MACRO
NA_DATA:
NA_REC_FLAGS: DB 0
NA_REC_TOTAL: DS 4
NA_MODE: DB 0
NA_PUBLISHED: DB 0
NA_ACCEPTED: DW 0
NA_INDEX: DW 0
NA_COUNTS: DS 16
NA_STATES: DS 128
NA_END:
 ENDM
