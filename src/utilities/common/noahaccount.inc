; Reporting only. Extraction folds validated per-archive final counters once.
; ADD keeps one two-bit final candidate state across codec/writer phases:
; 0 unprocessed, 1 accepted/prepared, 2 declined/excluded, 3 failed.
NA_INIT:
 XOR A
 LD HL,NA_DATA
 LD DE,NA_DATA+1
 LD BC,NA_END-NA_DATA-1
 LD (HL),A
 LDIR
 RET
NA_RESET_ADD:
 LD A,(NH_MODE)
 CP 3
 RET NZ
 XOR A
 LD (NA_PUBLISHED),A
 LD A,(NC_ADD_ACTIVE)
 OR A
 RET NZ
 LD HL,NA_STATES
 LD DE,NA_STATES+1
 LD BC,127
 LD (HL),0
 LDIR
 RET
; HL candidate index -> HL containing packed byte, B rotation count.
NA_ADDRESS:
 LD A,L
 AND 3
 LD B,A
 SRL H
 RR L
 SRL H
 RR L
 LD DE,NA_STATES
 ADD HL,DE
 RET
NA_GET:
 CALL NA_ADDRESS
 LD A,(HL)
 INC B
NA_GET_ROTATE:
 DEC B
 JR Z,NA_GET_DONE
 RRCA
 RRCA
 JR NA_GET_ROTATE
NA_GET_DONE:
 AND 3
 RET
; A status, HL candidate index. No file/plan contents are changed.
NA_SET:
 PUSH AF
 CALL NA_ADDRESS
 POP AF
 LD C,A
 LD A,3
 INC B
NA_SET_ROTATE:
 DEC B
 JR Z,NA_SET_DONE
 RLCA
 RLCA
 RLC C
 RLC C
 JR NA_SET_ROTATE
NA_SET_DONE:
 CPL
 AND (HL)
 OR C
 LD (HL),A
 RET
NA_WRITER_SET:
 LD HL,(NW_INDEX)
 JP NA_SET
NA_WRITER_SKIP:
 LD HL,(NW_INDEX)
 CALL NA_GET
 CP 3
 RET Z
 LD A,2
 JP NA_WRITER_SET
NA_EXTRACT:
 LD A,1
 LD (NA_MODE),A
 LD HL,NX_COMPLETED
 LD DE,NA_COUNTS
 LD C,4
NA_ADD_WORD:
 LD B,4
 OR A
NA_ADD_BYTE:
 LD A,(DE)
 ADC A,(HL)
 LD (DE),A
 INC HL
 INC DE
 DJNZ NA_ADD_BYTE
 DEC C
 JR NZ,NA_ADD_WORD
 RET
NA_FINISH:
 LD A,(NA_MODE)
 OR A
 RET Z
 CP 2
 CALL Z,NA_ADD_TOTALS
 LD DE,NA_MEMBER_TEXT
 LD A,(NA_MODE)
 CP 2
 JR NZ,NA_PRINT
 LD DE,NA_CANDIDATE_TEXT
NA_PRINT:
 CALL NH_PRINT
 LD HL,NA_COUNTS
 CALL NH_PRINT_COUNT
 LD DE,NX_SKIP_TEXT
 CALL NH_PRINT
 LD HL,NA_COUNTS+4
 CALL NH_PRINT_COUNT
 LD DE,NX_FAIL_TEXT
 CALL NH_PRINT
 LD HL,NA_COUNTS+8
 CALL NH_PRINT_COUNT
 LD DE,NH_NEWLINE
 CALL NH_PRINT
 LD DE,NX_UNPROCESSED_TEXT
 CALL NH_PRINT
 LD HL,NA_COUNTS+12
 CALL NH_PRINT_COUNT
 LD DE,NH_NEWLINE
 CALL NH_PRINT
 LD A,(NA_MODE)
 CP 2
 RET NZ
 LD DE,NA_ACCEPTED_TEXT
 CALL NH_PRINT
 LD HL,(NA_ACCEPTED)
 CALL NS_PRINT_WORD
 LD DE,NH_NEWLINE
 JP NH_PRINT
NA_ADD_TOTALS:
 LD HL,0
 LD (NA_INDEX),HL
NA_TOTAL_NEXT:
 LD HL,(NA_INDEX)
 LD DE,(NS_COUNT)
 OR A
 SBC HL,DE
 RET Z
 LD HL,(NA_INDEX)
 CALL NA_GET
 CP 1
 JR NZ,NA_NOT_ACCEPTED
 LD A,(NA_PUBLISHED)
 OR A
 JR Z,NA_PENDING
 LD HL,(NA_ACCEPTED)
 INC HL
 LD (NA_ACCEPTED),HL
 ; Publication follows a complete plan. Status 2 is a superseded version,
 ; not another completed active member (even if deleted payload is retained).
 LD HL,(NA_INDEX)
 LD D,H
 LD E,L
 ADD HL,HL
 ADD HL,DE
 ADD HL,HL
 ADD HL,HL
 LD DE,NW_PLANS
 ADD HL,DE
 LD A,(HL)
 CP 1
 LD A,2
 JR NZ,NA_CATEGORY
 XOR A
 JR NA_CATEGORY
NA_NOT_ACCEPTED:
 OR A
 JR NZ,NA_CATEGORY
NA_PENDING:
 LD A,(NS_DISPOSITION)
 CP 2
 JR NZ,NA_UNPROCESSED
 LD A,(NS_ARC_FAILED)
 LD HL,NH_ABORTED
 OR (HL)
 JR NZ,NA_UNPROCESSED
 LD A,2
 JR NA_CATEGORY
NA_UNPROCESSED:
 LD A,4
NA_CATEGORY:
 CP 2
 JR NZ,NA_CATEGORY_READY
 PUSH AF
 LD A,1
 LD (NS_WARNINGS),A
 POP AF
NA_CATEGORY_READY:
 ; 0=completed, 2=skipped, 3=failed, 4=unprocessed.
 OR A
 JR Z,NA_OFFSET
 DEC A
NA_OFFSET:
 ADD A,A
 ADD A,A
 LD E,A
 LD D,0
 LD HL,NA_COUNTS
 ADD HL,DE
 CALL NX_INC_COUNT
 LD HL,(NA_INDEX)
 INC HL
 LD (NA_INDEX),HL
 JR NA_TOTAL_NEXT
NA_MEMBER_TEXT: DB 'Known members (hex): completed ','$'
NA_CANDIDATE_TEXT: DB 'ADD candidates (hex): completed ','$'
NA_ACCEPTED_TEXT: DB 'Accepted candidates (hex): ','$'
NOAH_ACCOUNT_DATA MACRO
NA_DATA:
NA_MODE: DB 0
NA_PUBLISHED: DB 0
NA_ACCEPTED: DW 0
NA_INDEX: DW 0
NA_COUNTS: DS 16
NA_STATES: DS 128
NA_END:
 ENDM
