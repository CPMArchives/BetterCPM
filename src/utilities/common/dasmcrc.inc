; CRC-32/ISO-HDLC: reflected EDB88320H, init/final xor FFFFFFFFH.
; D_CRC_BYTE preserves all registers; the four-byte state is little endian.
D_CRC_RESET:
 PUSH AF
 PUSH BC
 PUSH HL
 LD HL,D_CRC
 LD B,4
D_CRC_INIT:
 LD (HL),255
 INC HL
 DJNZ D_CRC_INIT
 POP HL
 POP BC
 POP AF
 RET
D_CRC_BYTE:
 PUSH AF
 PUSH BC
 PUSH HL
 LD HL,D_CRC
 XOR (HL)
 LD (HL),A
 LD B,8
D_CRC_BIT:
 LD HL,D_CRC+3
 SRL (HL)
 DEC HL
 RR (HL)
 DEC HL
 RR (HL)
 DEC HL
 RR (HL)
 JR NC,D_CRC_NEXT
 LD A,(HL)
 XOR 20H
 LD (HL),A
 INC HL
 LD A,(HL)
 XOR 83H
 LD (HL),A
 INC HL
 LD A,(HL)
 XOR 0B8H
 LD (HL),A
 INC HL
 LD A,(HL)
 XOR 0EDH
 LD (HL),A
D_CRC_NEXT:
 DJNZ D_CRC_BIT
 POP HL
 POP BC
 POP AF
 RET
D_CRC_FINISH:
 PUSH AF
 PUSH BC
 PUSH HL
 LD HL,D_CRC
 LD B,4
D_CRC_COMPLEMENT:
 LD A,(HL)
 CPL
 LD (HL),A
 INC HL
 DJNZ D_CRC_COMPLEMENT
 POP HL
 POP BC
 POP AF
 RET
D_CRC_BUFFER:
 LD A,B
 OR C
 RET Z
 LD A,(HL)
 CALL D_CRC_BYTE
 INC HL
 DEC BC
 JR D_CRC_BUFFER
D_CRC: DS 4
