; Symbol lookup, canonical ordering and staged duplicate validation.
; D_NAMECMP: DE/B=target, HL/C=current; flags from target-current.
; BC,DE,HL are preserved. Prefix ordering is ordinary ASCII lexical order.
D_NAMECMP:
 PUSH BC
 PUSH DE
 PUSH HL
D_NC_LOOP:
 LD A,B
 OR A
 JR Z,D_NC_TARGET_END
 LD A,C
 OR A
 JR Z,D_NC_CURRENT_END
 LD A,(DE)
 CP (HL)
 JR NZ,D_NC_RETURN
 INC DE
 INC HL
 DEC B
 DEC C
 JR D_NC_LOOP
D_NC_TARGET_END:
 LD A,C
 OR A
 JR Z,D_NC_RETURN
 LD A,1
 OR A
 SCF
 JR D_NC_RETURN
D_NC_CURRENT_END:
 LD A,1
 OR A
D_NC_RETURN:
 POP HL
 POP DE
 POP BC
 RET

D_PLCSYM:
 PUSH DE
 PUSH BC
 LD (D_LOOK_NAME),HL
 LD A,B
 LD (D_LOOK_LEN),A
 LD HL,SYMTAB
D_LOOK_LOOP:
 LD (SYMRKR),HL
 INC HL
 INC HL
 LD A,(HL)
 OR A
 JR Z,D_LOOK_MISSING
 LD C,A
 INC HL
 LD DE,(D_LOOK_NAME)
 LD A,(D_LOOK_LEN)
 LD B,A
 CALL D_NAMECMP
 JR C,D_LOOK_MISSING
 JR Z,D_LOOK_FOUND
 LD E,C
 LD D,0
 ADD HL,DE
 JR D_LOOK_LOOP
D_LOOK_MISSING:
 LD HL,(D_LOOK_NAME)
 POP BC
 POP DE
 SCF
 RET
D_LOOK_FOUND:
 LD HL,(SYMRKR)
 POP BC
 POP DE
 OR A
 RET

D_UPPER:
 CP 'a'
 JR C,D_UPPER_DONE
 CP 'z'+1
 JR NC,D_UPPER_DONE
 SUB 32
D_UPPER_DONE:
 OR A
 RET
D_IDENT_CHAR:
 CP '$'
 JR Z,D_IDENT_BAD
 JP D_NAME_VALID
D_IDENT_BAD:
 SCF
 RET
D_CONFLICT:
 LD DE,D_CONFLICT_MSG
 JP D_ERROR_MSG
D_RESERVED:
 LD DE,D_RESERVED_MSG
 JP D_ERROR_MSG

; Metadata record traversal, before the sentinel has been appended.
D_SNEXT:
 LD A,(D_KIND)
 CP 2
 JR NZ,D_SNEXT_TEXT
 INC HL
 INC HL
 INC HL
 RET
D_SNEXT_TEXT:
 PUSH DE
 INC HL
 INC HL
 LD E,(HL)
 LD D,0
 INC HL
 ADD HL,DE
 POP DE
 RET
D_SORT_SYMBOLS:
 XOR A
 LD (D_SORT_CHANGED),A
 LD HL,D_STAGE
 LD (D_SORT_P),HL
D_SORT_PAIR:
 LD HL,(D_SORT_P)
 LD DE,(D_META_PTR)
 OR A
 SBC HL,DE
 JP NC,D_SORT_PASS_END
 LD HL,(D_SORT_P)
 CALL D_SNEXT
 LD (D_SORT_Q),HL
 LD DE,(D_META_PTR)
 OR A
 SBC HL,DE
 JP NC,D_SORT_PASS_END
 LD A,(D_KIND)
 OR A
 JR NZ,D_SORT_ADDRESS
D_SORT_NAMES:
 LD HL,(D_SORT_P)
 INC HL
 INC HL
 LD C,(HL)
 INC HL
 LD DE,(D_SORT_Q)
 INC DE
 INC DE
 LD A,(DE)
 LD B,A
 INC DE
 CALL D_NAMECMP
 JR D_SORT_RESULT
D_SORT_ADDRESS:
 LD HL,(D_SORT_P)
 LD E,(HL)
 INC HL
 LD D,(HL)
 LD HL,(D_SORT_Q)
 LD A,(HL)
 INC HL
 LD H,(HL)
 LD L,A
 OR A
 SBC HL,DE
D_SORT_RESULT:
 JP C,D_SORT_SWAP
 JR Z,D_SORT_EQUAL
D_SORT_ADVANCE:
 LD HL,(D_SORT_P)
 CALL D_SNEXT
 LD (D_SORT_P),HL
 JR D_SORT_PAIR
D_SORT_EQUAL:
 LD A,(D_KIND)
 OR A
 JR NZ,D_SORT_EQUAL_META
 LD HL,(D_SORT_P)
 LD DE,(D_SORT_Q)
 LD A,(DE)
 CP (HL)
 JP NZ,D_CONFLICT
 INC HL
 INC DE
 LD A,(DE)
 CP (HL)
 JP NZ,D_CONFLICT
 JR D_SORT_REMOVE
D_SORT_EQUAL_META:
 LD HL,(D_SORT_P)
 LD DE,(D_SORT_Q)
 INC HL
 INC HL
 INC DE
 INC DE
 LD A,(D_KIND)
 CP 2
 JR NZ,D_SORT_EQUAL_COMMENT
 LD A,(DE)
 CP (HL)
 JP NZ,D_META_CONFLICT
 JR D_SORT_REMOVE
D_SORT_EQUAL_COMMENT:
 LD C,(HL)
 INC HL
 LD A,(DE)
 LD B,A
 INC DE
 CALL D_NAMECMP
 JP NZ,D_META_CONFLICT
D_SORT_REMOVE:
 ; Identical duplicate: remove Q without touching any live arena.
 LD HL,(D_SORT_Q)
 CALL D_SNEXT
 LD (D_SORT_TAIL),HL
 LD DE,(D_SORT_Q)
 OR A
 SBC HL,DE
 LD (D_SORT_SIZE),HL
 LD HL,(D_META_PTR)
 LD DE,(D_SORT_TAIL)
 OR A
 SBC HL,DE
 LD B,H
 LD C,L
 LD HL,(D_SORT_TAIL)
 LD DE,(D_SORT_Q)
 LD A,B
 OR C
 JR Z,D_SORT_NO_TAIL
 LDIR
D_SORT_NO_TAIL:
 LD HL,(D_META_PTR)
 LD DE,(D_SORT_SIZE)
 OR A
 SBC HL,DE
 LD (D_META_PTR),HL
 LD HL,(D_META_DUP)
 INC HL
 LD (D_META_DUP),HL
 LD A,1
 LD (D_SORT_CHANGED),A
 JP D_SORT_PAIR
D_SORT_SWAP:
 ; Copy P aside, move Q downward, then restore P after Q.
 LD HL,(D_SORT_P)
 CALL D_SNEXT
 LD DE,(D_SORT_P)
 OR A
 SBC HL,DE
 LD (D_SORT_SIZE),HL
 LD B,H
 LD C,L
 LD HL,(D_SORT_P)
 LD DE,D_SORT_BUFFER
 LDIR
 LD HL,(D_SORT_Q)
 CALL D_SNEXT
 LD DE,(D_SORT_Q)
 OR A
 SBC HL,DE
 LD B,H
 LD C,L
 LD HL,(D_SORT_Q)
 LD DE,(D_SORT_P)
 LDIR
 LD HL,(D_SORT_SIZE)
 LD B,H
 LD C,L
 LD HL,D_SORT_BUFFER
 LDIR
 LD A,1
 LD (D_SORT_CHANGED),A
 JP D_SORT_ADVANCE
D_SORT_PASS_END:
 LD A,(D_SORT_CHANGED)
 OR A
 JP NZ,D_SORT_SYMBOLS
 RET

D_META_CONFLICT:
 LD DE,D_MCON_MSG
 JP D_ERROR_MSG
D_MCON_MSG: DB 'DASM: conflicting metadata records; previous analysis retained.',13,10,'$'
D_CONFLICT_MSG: DB 'DASM: conflicting symbol name; previous analysis retained.',13,10,'$'
D_RESERVED_MSG: DB 'DASM: reserved ZSM4 symbol name.',13,10,'$'
D_LOOK_NAME: DW 0
D_LOOK_LEN: DB 0
D_SORT_CHANGED: DB 0
D_SORT_P: DW 0
D_SORT_Q: DW 0
D_SORT_TAIL: DW 0
D_SORT_SIZE: DW 0
D_META_DUP: DW 0
D_SORT_BUFFER: DS 83
 INCLUDE zsm4words.inc

D_TRAILING_SPACE:
 LD A,(HL)
 CP 13
 RET Z
 CP ' '
 JR Z,D_TRAILING_NEXT
 CP 9
 JP NZ,WHAT
D_TRAILING_NEXT:
 INC HL
 JR D_TRAILING_SPACE
D_CONTROL_CHECK:
 PUSH AF
 PUSH BC
 PUSH HL
 LD C,A
 LD HL,D_CONTROL_TYPES
 LD B,6
D_CONTROL_SCAN:
 LD A,(HL)
 CP C
 JR Z,D_CONTROL_OK
 INC HL
 DJNZ D_CONTROL_SCAN
 LD DE,D_CONTROL_BAD_MSG
 JP D_ERROR_MSG
D_CONTROL_OK:
 POP HL
 POP BC
 POP AF
 RET
D_CONTROL_TYPES: DB 'BEHISW'
D_CONTROL_BAD_MSG: DB 'DASM: invalid control type.',13,10,'$'
