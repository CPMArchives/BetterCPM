; Exact ZSM4 vocabulary guard. HL=name, B=length; CF=reserved.
; Preserves BC/DE/HL. Spellings are facts from the pinned ZSM4 tables.
RW_RESERVED:
 PUSH BC
 PUSH DE
 PUSH HL
 LD DE,RW_TABLE
RW_NEXT:
 LD A,(DE)
 OR A
 JR Z,RW_ALLOWED
 INC DE
 LD C,A
 CP B
 JR NZ,RW_SKIP
 PUSH BC
 PUSH DE
 PUSH HL
RW_COMPARE:
 LD A,(DE)
 CP (HL)
 JR NZ,RW_DIFFERENT
 INC DE
 INC HL
 DJNZ RW_COMPARE
 POP HL
 POP DE
 POP BC
 POP HL
 POP DE
 POP BC
 SCF
 RET
RW_DIFFERENT:
 POP HL
 POP DE
 POP BC
RW_SKIP:
 LD A,E
 ADD A,C
 LD E,A
 JR NC,RW_NEXT
 INC D
 JR RW_NEXT
RW_ALLOWED:
 POP HL
 POP DE
 POP BC
 OR A
 RET
