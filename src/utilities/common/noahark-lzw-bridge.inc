; Whole-member LZW phase. The decoder overwrites CLI/NHARK; only resident
; callbacks/stack are live, and NR_CODEC restores both before returning.
XL_TEST:
 XOR A
 JR XL_PHASE
XL_READ:
 LD A,(NX_VERIFY_OPEN)
 OR A
 LD A,1
 LD HL,NX_TEMP
 JR Z,XL_SINK
 INC A
 LD HL,NX_VERIFY
XL_SINK:
 LD (NR_OUTFCB),HL
XL_PHASE:
 LD (NR_SINK),A
 LD HL,NH_ADAPTER
 LD DE,NR_SOURCE
 LD BC,12
 LDIR
 LD A,(NH_ADAPTER+AP_OWNER)
 LD (NR_SOURCE_USER),A
 LD A,(NH_DUSER)
 LD (NR_DESTUSER),A
 LD HL,NH_CONTEXT+AS_MEMBER+AM_STORED
 LD DE,NR_LIMIT
 LD BC,4
 LDIR
 LD A,7
 CALL NR_CODEC
 PUSH AF
 LD A,(NR_INOPEN)
 OR A
 JR Z,XL_CLOSE_KNOWN
 LD A,1
 LD (NS_STOP),A
XL_CLOSE_KNOWN:
 POP AF
 JR NC,XL_PHASE_OK
 LD B,A
 LD A,(NH_ABORTED)
 OR A
 LD A,AS_CANCEL
 JP NZ,AR_FAIL
 LD A,B
 CP AS_END
 JR NZ,XL_ERROR_KIND
 LD A,(NR_SINK)
 OR A
 LD A,B
 JR Z,XL_ERROR_KIND
 LD A,AS_OUTPUT
XL_ERROR_KIND:
 CP AS_OUTPUT
 SCF
 RET Z
 JP AR_FAIL
XL_PHASE_OK:
 LD A,(NR_SINK)
 OR A
 RET Z
 LD BC,0
 LD A,AS_END
 SCF
 RET
