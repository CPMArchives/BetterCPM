; Type/length zero terminates a record table. FFFFH is an ordinary address.
D_ENTRY_END:
 INC HL
 INC HL
 LD A,(HL)
 OR A
 DEC HL
 DEC HL
 RET
D_CONTROL_FIND:
 LD HL,CTLTBL
D_CF_NEXT:
 CALL D_ENTRY_END
 SCF
 RET Z
 INC HL
 LD A,D
 CP (HL)
 DEC HL
 RET C
 JR NZ,D_CF_ADVANCE
 LD A,E
 CP (HL)
 RET Z
 RET C
D_CF_ADVANCE:
 INC HL
 INC HL
 INC HL
 JR D_CF_NEXT
D_CONTROL_TAIL:
 LD HL,CTLTBL
D_CT_NEXT:
 CALL D_ENTRY_END
 RET Z
 INC HL
 INC HL
 INC HL
 JR D_CT_NEXT

D_CONTROL_EDIT:
 CALL D_CONTROL_CHECK
 PUSH BC
 PUSH DE
 PUSH HL
 LD (D_C_TYPE),A
 LD (D_C_ADDR),DE
 CALL D_CONTROL_FIND
 LD (D_C_INSERT),HL
 JR C,D_C_ADD
 LD A,(D_C_TYPE)
 CP 'K'
 JR Z,D_C_DELETE
 INC HL
 INC HL
 LD (HL),A
 JR D_C_DONE
D_C_ADD:
 LD A,(D_C_TYPE)
 CP 'K'
 JP Z,WHAT
 CALL D_CONTROL_TAIL
 LD DE,6
 ADD HL,DE
 LD DE,SYMTAB
 OR A
 SBC HL,DE
 JR C,D_C_HAS_ROOM
 JP NZ,D_SPACE
D_C_HAS_ROOM:
 CALL D_CONTROL_TAIL
 INC HL
 INC HL
 LD D,H
 LD E,L
 INC DE
 INC DE
 INC DE
 PUSH HL
 INC HL
 LD BC,(D_C_INSERT)
 OR A
 SBC HL,BC
 LD B,H
 LD C,L
 POP HL
 LDDR
 LD HL,(D_C_INSERT)
 LD DE,(D_C_ADDR)
 LD (HL),E
 INC HL
 LD (HL),D
 INC HL
 LD A,(D_C_TYPE)
 LD (HL),A
 JR D_C_DONE
D_C_DELETE:
 CALL D_CONTROL_TAIL
 LD DE,(D_C_INSERT)
 OR A
 SBC HL,DE
 LD B,H
 LD C,L
 LD H,D
 LD L,E
 INC HL
 INC HL
 INC HL
 LDIR
D_C_DONE:
 POP HL
 POP DE
 POP BC
 RET

; Move a bounded suffix including its terminator. Never scan arbitrary bytes
; for FF FF, which could be a real address or occur across record fields.
D_DELETE_COMMENT:
 PUSH BC
 PUSH DE
 PUSH HL
 CALL D_ENTRY_END
 JR Z,D_DC_DONE
 LD (D_DC_START),HL
 CALL D_SNEXT_TEXT
 LD (D_DC_NEXT),HL
 LD DE,(D_DC_START)
 OR A
 SBC HL,DE
 LD (D_DC_SIZE),HL
 LD HL,(COMEND)
 LD DE,3
 ADD HL,DE
 LD DE,(D_DC_NEXT)
 OR A
 SBC HL,DE
 LD B,H
 LD C,L
 LD HL,(D_DC_NEXT)
 LD DE,(D_DC_START)
 LDIR
 LD HL,(COMEND)
 LD DE,(D_DC_SIZE)
 OR A
 SBC HL,DE
 LD (COMEND),HL
D_DC_DONE:
 POP HL
 POP DE
 POP BC
 RET
D_C_TYPE: DB 0
D_C_ADDR: DW 0
D_C_INSERT: DW 0
D_DC_START: DW 0
D_DC_NEXT: DW 0
D_DC_SIZE: DW 0

; Complete replacement size is checked before the old annotation is deleted.
D_COMMENT_ROOM:
 PUSH AF
 PUSH BC
 PUSH DE
 PUSH HL
 LD B,0
D_CR_LENGTH:
 LD A,(HL)
 CP 13
 JR Z,D_CR_COUNTED
 INC HL
 INC B
 JR D_CR_LENGTH
D_CR_COUNTED:
 LD A,B
 OR A
 JR Z,D_CR_DONE
 ADD A,3
 LD (D_CR_SIZE),A
 LD HL,(COMEND)
 LD (D_CR_END),HL
 CALL CMCHK
 JR C,D_CR_NEW
 LD (D_DC_START),HL
 CALL D_SNEXT_TEXT
 LD DE,(D_DC_START)
 OR A
 SBC HL,DE
 EX DE,HL
 LD HL,(D_CR_END)
 OR A
 SBC HL,DE
 LD (D_CR_END),HL
D_CR_NEW:
 LD A,(D_CR_SIZE)
 LD E,A
 LD D,0
 LD HL,(D_CR_END)
 ADD HL,DE
 LD DE,3
 ADD HL,DE
 LD DE,D_CMT_LIMIT
 OR A
 SBC HL,DE
 JP C,D_CR_DONE
 JP NZ,D_SPACE
D_CR_DONE:
 POP HL
 POP DE
 POP BC
 POP AF
 RET
D_CR_SIZE: DB 0
D_CR_END: DW 0
