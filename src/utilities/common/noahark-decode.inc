; Original ARC method-3/4 streaming decoder. No external codec source linked.
; Singleton state belongs to the supplemental module, not the reusable reader.
; RESET rewinds stored input and decoded length/CRC at each pass/retry.
NK_RESET:
 LD HL,NH_CONTEXT+AS_MEMBER+AM_OFFSET
 LD DE,NH_CONTEXT+AS_POSITION
 LD BC,4
 LDIR
 LD HL,NH_CONTEXT+AS_MEMBER+AM_STORED
 LD DE,NH_CONTEXT+AS_LEFT
 LD BC,4
 LDIR
 XOR A
 LD HL,ND_STATE
 LD DE,ND_STATE+1
 LD BC,ND_END-ND_STATE-1
 LD (HL),A
 LDIR
 XOR A
 LD (DH_READY),A
 LD (DH_DONE),A
 LD (DH_BITS),A
 RET
NK_TEST:
 LD A,(IX+AS_MEMBER+AM_METHOD)
 CP 3
 JP C,ARK_TEST_STORED
 CALL NK_RESET
ND_TEST_LOOP:
 CALL NX_POLL
 JP C,AR_FAIL
 LD DE,ND_CHECKBUF
 LD BC,128
 CALL NK_READ
 JR NC,ND_TEST_LOOP
 CP AS_END
 JR Z,ND_TEST_OK
 SCF
 RET
ND_TEST_OK:
 OR A
 RET
NK_READ:
 LD A,(IX+AS_PHASE)
 CP AS_FAILED
 JP Z,AR_STICKY
 CP AS_SELECTED
 JP NZ,AR_STATE
 LD A,(IX+AS_MEMBER+AM_METHOD)
 CP 3
 JP C,ARK_RAW
 CP 5
 JP NC,AR_STATE
 LD A,B
 OR C
 RET Z
 LD (ND_CAP),BC
 LD (ND_OUT),DE
 LD HL,0
 LD (ND_ACTUAL),HL
ND_READ_LOOP:
 CALL ND_DECODE
 JR C,ND_READ_END
 LD (ND_BYTE),A
 ; Check the decoded bound before placing another byte in caller memory.
 LD HL,ND_COUNT
 LD B,4
ND_COUNT_INC:
 INC (HL)
 JR NZ,ND_COUNT_COMPARE
 INC HL
 DJNZ ND_COUNT_INC
 JP AR_FORMAT
ND_COUNT_COMPARE:
 LD HL,ND_COUNT+3
 LD DE,NH_CONTEXT+AS_MEMBER+AM_LENGTH+3
 LD B,4
ND_LIMIT:
 LD A,(DE)
 CP (HL)
 JP C,AR_FORMAT
 JR NZ,ND_LIMIT_OK
 DEC HL
 DEC DE
 DJNZ ND_LIMIT
ND_LIMIT_OK:
 LD A,(ND_BYTE)
 LD HL,(ND_OUT)
 LD (HL),A
 INC HL
 LD (ND_OUT),HL
 CALL ND_CRC_BYTE
 LD HL,(ND_ACTUAL)
 INC HL
 LD (ND_ACTUAL),HL
 LD DE,(ND_CAP)
 OR A
 SBC HL,DE
 JR NZ,ND_READ_LOOP
ND_READ_OK:
 LD BC,(ND_ACTUAL)
 LD (IX+AS_ACTUAL),C
 LD (IX+AS_ACTUAL+1),B
 XOR A
 RET
ND_READ_END:
 CP AS_END
 JR Z,ND_FINISH
 SCF
 RET
ND_FINISH:
 ; Validate both exact decoded size and CRC before returning final bytes.
 LD HL,ND_COUNT
 LD DE,NH_CONTEXT+AS_MEMBER+AM_LENGTH
 LD B,4
ND_LENGTH_CHECK:
 LD A,(DE)
 CP (HL)
 JP NZ,AR_FORMAT
 INC HL
 INC DE
 DJNZ ND_LENGTH_CHECK
 LD HL,(ND_CRC)
 LD A,L
 CP (IX+AS_MEMBER+AM_CRC)
 JP NZ,AR_CHECK
 LD A,H
 CP (IX+AS_MEMBER+AM_CRC+1)
 JP NZ,AR_CHECK
 LD HL,(ND_ACTUAL)
 LD A,H
 OR L
 JR NZ,ND_READ_OK
 LD (IX+AS_ACTUAL),A
 LD (IX+AS_ACTUAL+1),A
 LD BC,0
 LD A,AS_END
 SCF
 RET
ND_DECODE:
 LD A,(ND_REPEAT)
 OR A
 JR Z,ND_TOKEN
 DEC A
 LD (ND_REPEAT),A
 LD A,(ND_PREVIOUS)
 OR A
 RET
ND_TOKEN:
 CALL ND_TOKEN_INPUT
 RET C
 CP 90H
 JR NZ,ND_LITERAL
 CALL ND_TOKEN_INPUT
 JR NC,ND_ESCAPE
 CP AS_END
 JP Z,AR_TRUNC
 SCF
 RET
ND_ESCAPE:
 OR A
 LD A,90H
 JR Z,ND_LITERAL
 LD A,(ND_HAVE)
 OR A
 JP Z,AR_FORMAT
 LD A,(ND_INPUT_BYTE)
 DEC A
 LD (ND_REPEAT),A
 JR ND_DECODE
ND_LITERAL:
 LD (ND_PREVIOUS),A
 PUSH AF
 LD A,1
 LD (ND_HAVE),A
 POP AF
 OR A
 RET
ND_TOKEN_INPUT:
 LD A,(IX+AS_MEMBER+AM_METHOD)
 CP 4
 JP NZ,ND_INPUT
 CALL DH_GET
 RET C
 LD (ND_INPUT_BYTE),A
 RET
ND_INPUT:
 LD A,(ND_USED)
 OR A
 JR NZ,ND_INPUT_READY
 LD DE,ND_INPUT_BUFFER
 LD BC,128
 CALL ARK_RAW
 RET C
 LD A,C
 LD (ND_USED),A
 LD HL,ND_INPUT_BUFFER
 LD (ND_PTR),HL
ND_INPUT_READY:
 LD HL,(ND_PTR)
 LD A,(HL)
 LD (ND_INPUT_BYTE),A
 INC HL
 LD (ND_PTR),HL
 LD HL,ND_USED
 DEC (HL)
 OR A
 RET
ND_CRC_BYTE:
 LD HL,ND_CRC
 XOR (HL)
 LD (HL),A
 LD B,8
ND_CRC_BIT:
 LD HL,ND_CRC+1
 SRL (HL)
 DEC HL
 RR (HL)
 JR NC,ND_CRC_NEXT
 LD A,(HL)
 XOR 1
 LD (HL),A
 INC HL
 LD A,(HL)
 XOR 0A0H
 LD (HL),A
ND_CRC_NEXT:
 DJNZ ND_CRC_BIT
 RET
ND_STATE:
ND_COUNT: DS 4
ND_CRC: DW 0
ND_REPEAT: DB 0
ND_PREVIOUS: DB 0
ND_HAVE: DB 0
ND_USED: DB 0
ND_PTR: DW 0
ND_END:
ND_BYTE: DB 0
ND_INPUT_BYTE: DB 0
ND_CAP: DW 0
ND_ACTUAL: DW 0
ND_OUT: DW 0
ND_INPUT_BUFFER: DS 128
ND_CHECKBUF: DS 128
