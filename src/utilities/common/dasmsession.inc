; Version-2 session descriptor, exactly one physical 128-byte record.
; 0: BCDS, version; 8: origin; 10: 32-bit length; 14: binary identity/user/CRC32;
; 31: three 19-byte component identities/user/record-count/physical CRC32;
; 88..123 reserved zero; 124 CRC32 of bytes 0..123.
; Unique components are published first; the descriptor is published last.
D_SESSION_SAVE:
 LD HL,(D_END)
 LD DE,D_BIN
 OR A
 SBC HL,DE
 JP C,D_RANGE
 JP Z,D_RANGE
 LD (D_SES_LENGTH),HL
 ; Preflight overwrite/read-only/alias policy and reserve descriptor scratch.
 CALL OPEN
 LD DE,FCB
 LD C,16
 CALL D_BDOS
 CP 255
 JP Z,D_IOFAIL
 LD HL,FCB
 LD DE,D_SES_FCB
 LD BC,36
 LDIR
 LD HL,D_OUTPUT
 LD DE,D_SES_FINAL
 LD BC,12
 LDIR
 LD HL,D_TEMP
 LD DE,D_SES_TEMP
 LD BC,12
 LDIR
 LD A,(D_REPLACE)
 LD (D_SES_REPLACE),A
 LD A,(D_TXUSER)
 LD (D_SES_USER),A
 XOR A
 LD (D_TXOPEN),A
 LD (D_TXLIVE),A
 LD (D_SES_INDEX),A
 LD HL,D_DESC
 LD DE,D_DESC+1
 LD BC,127
 LD (HL),0
 LDIR
 LD A,1
 LD (D_SES_ACTIVE),A
 LD HL,D_SES_MAGIC
 LD DE,D_DESC
 LD BC,5
 LDIR
 LD HL,(D_ORIGIN)
 LD (D_DESC+8),HL
 LD HL,(D_SES_LENGTH)
 LD (D_DESC+10),HL
 LD HL,D_INPUT_NAME
 LD DE,D_DESC+14
 LD BC,12
 LDIR
 LD A,(D_INPUT_USER)
 LD (D_DESC+26),A
 LD BC,(D_SES_LENGTH)
 LD HL,D_BIN
 CALL D_CRC_RESET
 CALL D_CRC_BUFFER
 CALL D_CRC_FINISH
 LD HL,D_CRC
 LD DE,D_DESC+27
 LD BC,4
 LDIR
D_SS_COMPONENT:
 CALL D_SES_COMPONENT
 LD HL,D_SES_NAME
 LD DE,FCB+1
 LD BC,11
 LDIR
 LD A,(D_SES_USER)
 LD (D_CURUSER),A
 LD A,(D_SES_FINAL)
 LD (FCB),A
 CALL D_SELECT_PARSED
 ; Give each role its own unused generation; no old component is replaced.
 CALL D_SES_EXTENSION
 CALL D_UNIQUE
 LD A,(D_SES_INDEX)
 OR A
 CALL Z,SYMSV
 LD A,(D_SES_INDEX)
 CP 1
 CALL Z,DOCSV
 LD A,(D_SES_INDEX)
 CP 2
 CALL Z,SVCTL0
 CALL D_SES_COMPONENT
 EX DE,HL
 LD HL,D_OUTPUT
 LD BC,12
 LDIR
 LD A,(D_SES_USER)
 LD (DE),A
 INC DE
 PUSH DE
 CALL D_HASH_FILE
 POP DE
 LD HL,(D_HASH_RECORDS)
 LD A,L
 LD (DE),A
 INC DE
 LD A,H
 LD (DE),A
 INC DE
 LD HL,D_CRC
 LD BC,4
 LDIR
 LD HL,D_SES_INDEX
 INC (HL)
 LD A,(HL)
 CP 3
 JP C,D_SS_COMPONENT
 LD HL,D_DESC
 LD BC,124
 CALL D_CRC_RESET
 CALL D_CRC_BUFFER
 CALL D_CRC_FINISH
 LD HL,D_CRC
 LD DE,D_DESC+124
 LD BC,4
 LDIR
 ; Reopen the reserved empty descriptor stage, restoring its own transaction.
 LD HL,D_SES_FCB
 LD DE,FCB
 LD BC,36
 LDIR
 LD HL,D_SES_FINAL
 LD DE,D_OUTPUT
 LD BC,12
 LDIR
 LD HL,D_SES_TEMP
 LD DE,D_TEMP
 LD BC,12
 LDIR
 XOR A
 LD (D_BACKUP),A
 LD (D_TXFAILED),A
 LD A,(D_SES_REPLACE)
 LD (D_REPLACE),A
 LD A,(D_SES_USER)
 LD (D_TXUSER),A
 CALL D_SELECT_OUTPUT
 LD DE,FCB
 LD C,15
 CALL D_BDOS
 CP 255
 JP Z,D_IOFAIL
 LD A,1
 LD (D_TXOPEN),A
 LD (D_TXLIVE),A
 LD HL,80H
 LD (DMAPTR),HL
 LD DE,80H
 LD C,26
 CALL D_BDOS
 LD HL,D_DESC
 LD B,128
D_SS_DESCRIPTOR:
 LD A,(HL)
 CALL WRTFILE
 INC HL
 DJNZ D_SS_DESCRIPTOR
 CALL D_FINAL
 XOR A
 LD (D_SES_ACTIVE),A
 LD DE,D_SES_SAVED
 JP D_ERROR_MSG

D_SESSION_LOAD:
 LD HL,FCB
 LD DE,D_SES_FINAL
 LD BC,12
 LDIR
 LD A,(D_CURUSER)
 LD (D_SES_USER),A
 CALL RDOPEN
 LD DE,D_DESC
 LD C,26
 CALL D_BDOS
 LD DE,FCB
 LD C,20
 CALL D_BDOS
 OR A
 JP NZ,D_SESSION_BAD
 LD DE,D_HASH_BUFFER
 LD C,26
 CALL D_BDOS
 LD DE,FCB
 LD C,20
 CALL D_BDOS
 CP 1
 JP NZ,D_SESSION_BAD
 CALL D_SES_CLOSE
 LD HL,D_DESC
 LD DE,D_SES_MAGIC
 LD B,5
D_SL_MAGIC:
 LD A,(DE)
 CP (HL)
 JP NZ,D_SESSION_BAD
 INC HL
 INC DE
 DJNZ D_SL_MAGIC
 LD HL,D_DESC+5
 LD B,3
 CALL D_SES_ZERO
 LD HL,D_DESC+12
 LD B,2
 CALL D_SES_ZERO ; high length word cannot fit this release
 LD HL,D_DESC+88
 LD B,36
 CALL D_SES_ZERO
 LD HL,D_DESC
 LD BC,124
 CALL D_CRC_RESET
 CALL D_CRC_BUFFER
 CALL D_CRC_FINISH
 LD HL,D_DESC+124
 CALL D_SES_CRC_MATCH
 LD HL,D_INPUT_NAME
 LD DE,D_DESC+14
 CALL D_SAME
 JP NZ,D_SESSION_BAD
 LD A,(D_INPUT_USER)
 LD B,A
 LD A,(D_DESC+26)
 CP B
 JP NZ,D_SESSION_BAD
 LD DE,(D_DESC+10)
 LD A,D
 OR E
 JP Z,D_SESSION_BAD
 LD HL,(D_LENGTH_BYTES)
 OR A
 SBC HL,DE
 JP C,D_SESSION_BAD
 LD HL,(D_DESC+8)
 CALL D_CHECK_SPAN
 LD BC,(D_DESC+10)
 LD HL,D_BIN
 CALL D_CRC_RESET
 CALL D_CRC_BUFFER
 CALL D_CRC_FINISH
 LD HL,D_DESC+27
 CALL D_SES_CRC_MATCH
 XOR A
 LD (D_SES_INDEX),A
D_SL_COMPONENT:
 CALL D_SES_COMPONENT
 LD (D_SES_RECORD),HL
 CALL D_SES_NAME_CHECK
 LD DE,FCB
 LD BC,12
 LDIR
 LD A,(HL)
 CP 32
 JP NC,D_SESSION_BAD
 LD (D_CURUSER),A
 LD A,(FCB)
 OR A
 JP Z,D_SESSION_BAD
 CP 17
 JP NC,D_SESSION_BAD
 ; Reject a component aliasing the binary or another role, even with a CRC.
 CALL D_SES_CHECK_IDS
 CALL D_HASH_FILE
 LD HL,(D_SES_RECORD)
 LD DE,13
 ADD HL,DE
 LD DE,(D_HASH_RECORDS)
 LD A,(HL)
 CP E
 JP NZ,D_SESSION_BAD
 INC HL
 LD A,(HL)
 CP D
 JP NZ,D_SESSION_BAD
 INC HL
 CALL D_SES_CRC_MATCH
 CALL D_SES_ARENA
 LD (D_META_BASE),HL
 ADD HL,DE
 LD (D_META_LIMIT),HL
 LD A,(D_SES_INDEX)
 LD (D_KIND),A
 LD A,1
 LD (D_STAGE_ONLY),A
 CALL D_IMPORT_CUSTOM
 LD A,(D_SES_INDEX)
 OR A
 JR NZ,D_SL_DOC_USED
 LD HL,(D_META_USED)
 LD (D_SES_SYM_USED),HL
D_SL_DOC_USED:
 CP 1
 JR NZ,D_SL_NEXT
 LD HL,(D_META_USED)
 LD (D_SES_DOC_USED),HL
D_SL_NEXT:
 LD HL,D_SES_INDEX
 INC (HL)
 LD A,(HL)
 CP 3
 JP C,D_SL_COMPONENT
 ; Every read, close, hash, syntax and capacity check succeeded. Commit now.
 LD HL,D_STAGE
 LD DE,SYMTAB
 LD BC,1000H
 LDIR
 LD HL,D_STAGE+1600H
 LD DE,COMTBL
 LD BC,0800H
 LDIR
 LD HL,D_STAGE+1000H
 LD DE,CTLTBL
 LD BC,0600H
 LDIR
 LD HL,SYMTAB
 LD DE,(D_SES_SYM_USED)
 ADD HL,DE
 LD (SYMEND),HL
 LD HL,COMTBL
 LD (COMST),HL
 LD DE,(D_SES_DOC_USED)
 ADD HL,DE
 LD (COMEND),HL
 LD HL,(D_DESC+8)
 LD (D_ORIGIN),HL
 LD (PC),HL
 EX DE,HL
 LD HL,D_BIN
 OR A
 SBC HL,DE
 LD (OFFSET),HL
 LD HL,D_BIN
 LD DE,(D_DESC+10)
 ADD HL,DE
 LD (D_END),HL
 CALL D_UPDATE_END
 XOR A
 LD (D_STAGE_ONLY),A
 LD DE,D_SES_LOADED
 JP D_ERROR_MSG

D_SES_ZERO:
 LD A,(HL)
 OR A
 JP NZ,D_SESSION_BAD
 INC HL
 DJNZ D_SES_ZERO
 RET
D_SES_CRC_MATCH:
 LD DE,D_CRC
 LD B,4
D_SES_CRC_BYTE:
 LD A,(DE)
 CP (HL)
 JP NZ,D_SESSION_BAD
 INC HL
 INC DE
 DJNZ D_SES_CRC_BYTE
 RET
D_SES_COMPONENT:
 LD HL,D_DESC+31
 LD A,(D_SES_INDEX)
 OR A
 RET Z
 LD DE,19
D_SES_RECORD_ADD:
 ADD HL,DE
 DEC A
 JR NZ,D_SES_RECORD_ADD
 RET
D_SES_EXTENSION:
 LD HL,D_SES_EXTS
 LD A,(D_SES_INDEX)
 ADD A,A
 LD B,A
 LD A,(D_SES_INDEX)
 ADD A,B
 LD E,A
 LD D,0
 ADD HL,DE
 LD DE,FCB+9
 LD BC,3
 LDIR
 RET
D_SES_ARENA:
 LD A,(D_SES_INDEX)
 OR A
 LD HL,D_STAGE
 LD DE,1000H
 RET Z
 DEC A
 LD HL,D_STAGE+1600H
 LD DE,0800H
 RET Z
 LD HL,D_STAGE+1000H
 LD DE,0600H
 RET
D_SES_CHECK_IDS:
 LD HL,D_SES_FINAL
 LD DE,FCB
 CALL D_SAME
 JR NZ,D_SI_BINARY
 LD A,(D_SES_USER)
 LD B,A
 LD A,(D_CURUSER)
 CP B
 JP Z,D_SESSION_BAD
D_SI_BINARY:
 LD HL,D_INPUT_NAME
 LD DE,FCB
 CALL D_SAME
 JR NZ,D_SI_COMPONENTS
 LD A,(D_INPUT_USER)
 LD B,A
 LD A,(D_CURUSER)
 CP B
 JP Z,D_SESSION_BAD
D_SI_COMPONENTS:
 LD HL,D_DESC+31
 LD A,(D_SES_INDEX)
 LD C,A
D_SI_NEXT:
 LD A,C
 OR A
 RET Z
 PUSH HL
 PUSH BC
 LD DE,FCB
 CALL D_SAME
 JR NZ,D_SI_DIFFERENT
 LD A,(HL)
 LD B,A
 LD A,(D_CURUSER)
 CP B
 JP Z,D_SESSION_BAD
D_SI_DIFFERENT:
 POP BC
 POP HL
 LD DE,19
 ADD HL,DE
 DEC C
 JR D_SI_NEXT

; Full physical-file CRC and record count, with checked open/read/close.
D_HASH_FILE:
 CALL RDOPEN
 CALL D_CRC_RESET
 LD HL,0
 LD (D_HASH_RECORDS),HL
 LD DE,D_HASH_BUFFER
 LD C,26
 CALL D_BDOS
D_HASH_RECORD:
 CALL BRKCHK
 LD DE,FCB
 LD C,20
 CALL D_BDOS
 OR A
 JR NZ,D_HASH_END
 LD HL,D_HASH_BUFFER
 LD BC,128
 CALL D_CRC_BUFFER
 LD HL,(D_HASH_RECORDS)
 INC HL
 LD A,H
 OR L
 JP Z,D_SESSION_BAD
 LD (D_HASH_RECORDS),HL
 JR D_HASH_RECORD
D_HASH_END:
 CP 1
 JP NZ,D_IOFAIL
 CALL D_SES_CLOSE
 CALL D_CRC_FINISH
 RET
D_SES_CLOSE:
 LD DE,FCB
 LD C,16
 CALL D_BDOS
 CP 255
 JP Z,D_IOFAIL
 XOR A
 LD (D_INOPEN),A
 LD DE,80H
 LD C,26
 CALL D_BDOS
 RET
D_SESSION_BAD:
 LD DE,D_SES_BAD
 JP D_ERROR_MSG
D_SES_MAGIC: DB 'BCDS',2
D_SES_EXTS: DB 'SYMDOCCTL'
D_SES_NAME: DB 'DSA00000SYM'
D_SES_SAVED: DB 'DASM: session saved; descriptor published last.',13,10,'$'
D_SES_LOADED: DB 'DASM: complete session validated and loaded.',13,10,'$'
D_SES_BAD: DB 'DASM: invalid or mismatched session; previous analysis retained.',13,10,'$'
D_SES_FCB: DS 36
D_SES_FINAL: DS 12
D_SES_TEMP: DS 12
D_SES_REPLACE: DB 0
D_SES_USER: DB 0
D_SES_INDEX: DB 0
D_SES_LENGTH: DW 0
D_SES_RECORD: DW 0
D_SES_SYM_USED: DW 0
D_SES_DOC_USED: DW 0
D_HASH_RECORDS: DW 0
D_HASH_BUFFER: DS 128
D_DESC EQU D_STAGE+1F00H

; Canonical exact FCB spelling, never a wildcard or an attribute-bearing name.
D_SES_NAME_CHECK:
 PUSH HL
 LD A,(HL)
 OR A
 JP Z,D_SESSION_BAD
 CP 17
 JP NC,D_SESSION_BAD
 INC HL
 LD A,(HL)
 CP ' '
 JP Z,D_SESSION_BAD
 LD B,8
 CALL D_SES_FIELD
 LD B,3
 CALL D_SES_FIELD
 LD A,(HL)
 CP 32
 JP NC,D_SESSION_BAD
 POP HL
 PUSH HL
 LD DE,9
 ADD HL,DE
 PUSH HL
 LD HL,D_SES_EXTS
 LD A,(D_SES_INDEX)
 ADD A,A
 LD C,A
 LD A,(D_SES_INDEX)
 ADD A,C
 LD E,A
 LD D,0
 ADD HL,DE
 EX DE,HL
 POP HL
 LD B,3
D_SNC_EXT:
 LD A,(DE)
 CP (HL)
 JP NZ,D_SESSION_BAD
 INC HL
 INC DE
 DJNZ D_SNC_EXT
 POP HL
 RET
D_SES_FIELD:
 LD C,0
D_SF_NEXT:
 LD A,(HL)
 CP ' '
 JR Z,D_SF_PADDING
 CP '!'
 JP C,D_SESSION_BAD
 CP 127
 JP NC,D_SESSION_BAD
 PUSH AF
 CALL D_UPPER
 LD E,A
 POP AF
 CP E
 JP NZ,D_SESSION_BAD
 CP '?'
 JP Z,D_SESSION_BAD
 CP '*'
 JP Z,D_SESSION_BAD
 CP '.'
 JP Z,D_SESSION_BAD
 CP ':'
 JP Z,D_SESSION_BAD
 CP '='
 JP Z,D_SESSION_BAD
 LD A,C
 OR A
 JP NZ,D_SESSION_BAD
 JR D_SF_ADVANCE
D_SF_PADDING:
 LD C,1
D_SF_ADVANCE:
 INC HL
 DJNZ D_SF_NEXT
 RET

; Retained descriptor scratch and any published orphan components are named
; explicitly on failure. No component from the old descriptor is removed.
D_SESSION_RECOVERY:
 LD A,(D_SES_ACTIVE)
 OR A
 RET Z
 XOR A
 LD (D_SES_ACTIVE),A
 LD A,(D_TXUSER)
 PUSH AF
 LD A,(D_SES_USER)
 LD (D_TXUSER),A
 LD DE,D_SES_RECOVERY
 LD C,9
 CALL D_BDOS
 LD HL,D_SES_TEMP
 CALL D_PRINT_NAME
 LD HL,D_DESC+31
 LD B,3
D_SR_COMPONENT:
 PUSH BC
 PUSH HL
 PUSH HL
 LD DE,12
 ADD HL,DE
 LD A,(HL)
 LD (D_TXUSER),A
 POP HL
 CALL D_PRINT_NAME
 POP HL
 LD DE,19
 ADD HL,DE
 POP BC
 DJNZ D_SR_COMPONENT
 POP AF
 LD (D_TXUSER),A
 RET
D_SES_RECOVERY: DB 'DASM: old session graph retained. New scratch/components may remain:',13,10,'$'
