; Strict pinned LINK 1.3 post-link report, followed by launcher completion.
; Unknown diagnostics cannot be mistaken for a success report. The map itself
; supplies final addresses; no relocation assumptions or SYM success inference.
SY_LOG_HEADER:
 LD DE,SY_WORD_LINK
 CALL SY_EXPECT
 LD DE,SY_WORD_VERSION
 JP SY_EXPECT
SY_PAIR:
 LD A,(SY_LOG_MODE)
 OR A
 JP Z,SY_TOKEN
 CALL SY_TOKEN
 JP C,SY_INVALID
 LD DE,SY_WORD_ABS
 CALL SY_IS_WORD
 JR Z,SY_LOG_TRAILER
 LD A,(SY_LENGTH)
 LD (SY_SAVED_LENGTH),A
 LD HL,SY_TOKENBUF
 LD DE,SY_SAVED_NAME
 LD BC,12
 LDIR
 CALL SY_TOKEN
 JP C,SY_INVALID
 OR A
 RET
SY_NAME_TOKEN:
 LD A,(SY_LOG_MODE)
 OR A
 JP Z,SY_TOKEN
 LD A,(SY_SAVED_LENGTH)
 LD (SY_LENGTH),A
 LD HL,SY_SAVED_NAME
 LD DE,SY_TOKENBUF
 LD BC,12
 LDIR
 OR A
 RET
SY_LOG_TRAILER:
 CALL SY_SECTION
 LD DE,SY_WORD_CODE
 CALL SY_EXPECT
 LD DE,SY_WORD_SIZE
 CALL SY_EXPECT
 CALL SY_SECTION
 LD DE,SY_WORD_DATA
 CALL SY_EXPECT
 LD DE,SY_WORD_SIZE
 CALL SY_EXPECT
 CALL SY_SECTION
 LD DE,SY_WORD_COMMON
 CALL SY_EXPECT
 LD DE,SY_WORD_SIZE
 CALL SY_EXPECT
 CALL SY_SECTION
 LD DE,SY_WORD_USE
 CALL SY_EXPECT
 LD DE,SY_WORD_FACTOR
 CALL SY_EXPECT
 CALL SY_TOKEN
 JP C,SY_INVALID
 LD A,(SY_LENGTH)
 CP 2
 JP NZ,SY_INVALID
 LD HL,SY_TOKENBUF
 LD B,2
 CALL SY_LOG_HEX
 LD DE,SY_WORD_DLINK
 CALL SY_EXPECT
 LD DE,SY_WORD_END
 CALL SY_EXPECT
 CALL SY_TOKEN
 JP NC,SY_INVALID
 SCF
 RET
SY_EXPECT:
 PUSH DE
 CALL SY_TOKEN
 POP DE
 JP C,SY_INVALID
 CALL SY_IS_WORD
 JP NZ,SY_INVALID
 RET
; Counted literals avoid NUL/12-byte token overreads.
SY_IS_WORD:
 LD A,(DE)
 LD B,A
 INC DE
 LD A,(SY_LENGTH)
 CP B
 RET NZ
 LD HL,SY_TOKENBUF
 JP SY_MATCH

; Section size followed by a range iff nonzero. Check the range arithmetic,
; including a full-64K range's 16-bit zero size representation (not emitted by
; this bounded toolchain workflow, so zero sizes must have no range).
SY_SECTION:
 CALL SY_TOKEN
 JP C,SY_INVALID
 LD A,(SY_LENGTH)
 CP 4
 JP NZ,SY_INVALID
 LD HL,SY_TOKENBUF
 LD B,4
 CALL SY_LOG_HEX
 LD (SY_SECTION_SIZE),DE
 LD A,D
 OR E
 RET Z
 CALL SY_TOKEN
 JP C,SY_INVALID
 LD A,(SY_LENGTH)
 CP 11
 JP NZ,SY_INVALID
 LD HL,SY_TOKENBUF
 LD A,(HL)
 CP '('
 JP NZ,SY_INVALID
 INC HL
 LD B,4
 CALL SY_LOG_HEX
 PUSH DE
 LD A,(HL)
 CP '-'
 JP NZ,SY_INVALID
 INC HL
 LD B,4
 CALL SY_LOG_HEX
 LD A,(HL)
 CP ')'
 JP NZ,SY_INVALID
 EX DE,HL
 POP DE
 OR A
 SBC HL,DE
 JP C,SY_INVALID
 INC HL
 LD DE,(SY_SECTION_SIZE)
 OR A
 SBC HL,DE
 JP NZ,SY_INVALID
 RET
SY_LOG_HEX:
 LD DE,0
SY_LH_DIGIT:
 LD A,(HL)
 SUB '0'
 CP 10
 JR C,SY_LH_VALUE
 SUB 7
 CP 10
 JP C,SY_INVALID
 CP 16
 JP NC,SY_INVALID
SY_LH_VALUE:
 EX DE,HL
 ADD HL,HL
 ADD HL,HL
 ADD HL,HL
 ADD HL,HL
 OR L
 LD L,A
 EX DE,HL
 INC HL
 DJNZ SY_LH_DIGIT
 RET
SY_WORD_LINK: DB 4,'LINK'
SY_WORD_VERSION: DB 3,'1.3'
SY_WORD_ABS: DB 8,'ABSOLUTE'
SY_WORD_CODE: DB 4,'CODE'
SY_WORD_DATA: DB 4,'DATA'
SY_WORD_COMMON: DB 6,'COMMON'
SY_WORD_SIZE: DB 4,'SIZE'
SY_WORD_USE: DB 3,'USE'
SY_WORD_FACTOR: DB 6,'FACTOR'
SY_WORD_DLINK: DB 5,'DLINK'
SY_WORD_END: DB 3,'END'
