; Logical origin and 17-bit end-exclusive bounds, independent of buffer bias.
D_SET_ORIGIN:
 LD HL,INBUF+3
 LD A,(HL)
 CP 13
 JR Z,D_SHOW_ORIGIN
 CALL CNVRT
 CALL D_TRAILING_SPACE
 LD A,(FOPEN)
 OR A
 JP NZ,CANT
 PUSH DE
 LD HL,(D_END)
 LD DE,D_BIN
 OR A
 SBC HL,DE
 JP C,D_RANGE
 JP Z,D_RANGE
 EX DE,HL
 POP HL
 PUSH HL
 CALL D_CHECK_SPAN
 POP HL
 LD (D_ORIGIN),HL
 LD (PC),HL
 EX DE,HL
 LD HL,D_BIN
 OR A
 SBC HL,DE
 LD (OFFSET),HL
 CALL D_UPDATE_END
D_SHOW_ORIGIN:
 CALL PSTRNG
 DB 'Logical origin = ',0
 LD HL,(D_ORIGIN)
 CALL PVALUE
 CALL CRLF
 JP GETCMD

; HL=origin, DE=positive length. Only an exact 10000H sum may carry.
D_CHECK_SPAN:
 ADD HL,DE
 RET NC
 LD A,H
 OR L
 RET Z
 JP D_RANGE
D_UPDATE_END:
 LD HL,(D_END)
 LD DE,D_BIN
 OR A
 SBC HL,DE
 LD DE,(D_ORIGIN)
 ADD HL,DE
 LD (D_LOG_END),HL
 LD A,0
 ADC A,0
 LD (D_END_TOP),A
 LD (D_LIST_TOP),A
 OR A
 JR Z,D_END_LOW
 LD HL,0FFFFH
D_END_LOW:
 LD (RELEND),HL
 LD (ENDLST),HL
 RET

; An end-only parser accepts 10000, while all address parsers stay 16-bit.
D_PARSE_END:
 XOR A
 LD (D_ARG_TOP),A
 PUSH HL
 LD DE,D_TOP_TOKEN
 LD B,5
D_TOP_COMPARE:
 LD A,(DE)
 CP (HL)
 JR NZ,D_END_ORDINARY
 INC DE
 INC HL
 DJNZ D_TOP_COMPARE
 LD A,(HL)
 CP 13
 JR Z,D_TOP_PARSED
 CP ','
 JR Z,D_TOP_PARSED
 CP ' '
 JR Z,D_TOP_PARSED
 CP 9
 JR NZ,D_END_ORDINARY
D_TOP_PARSED:
 POP DE
 LD DE,0
 PUSH AF
 LD A,1
 LD (D_ARG_TOP),A
 POP AF
 RET
D_END_ORDINARY:
 POP HL
 JP CNVRT
D_TOP_TOKEN: DB '10000'

; P bounds are staged first; no PC, output or live analysis changes on error.
D_CHECK_INTERVAL:
 LD HL,(D_P_START)
 LD DE,(OFFSET)
 ADD HL,DE
 CALL D_BYTE_CHECK
 LD (D_P_PHYS),HL
 LD A,(D_ARG_TOP)
 OR A
 JR Z,D_CHECK_LOW_END
 LD A,(D_END_TOP)
 OR A
 JP Z,D_RANGE
 JR D_CHECK_PHYSICAL
D_CHECK_LOW_END:
 LD HL,(D_P_END)
 LD DE,(D_P_START)
 OR A
 SBC HL,DE
 JP C,D_RANGE
 JP Z,D_RANGE
D_CHECK_PHYSICAL:
 LD HL,(D_P_END)
 LD DE,(OFFSET)
 ADD HL,DE
 PUSH HL
 LD DE,(D_END)
 OR A
 SBC HL,DE
 JR C,D_INTERVAL_UPPER
 JP NZ,D_RANGE
D_INTERVAL_UPPER:
 POP HL
 LD DE,(D_P_PHYS)
 OR A
 SBC HL,DE
 JP C,D_RANGE
 JP Z,D_RANGE
 RET

D_LIST_START:
 CALL CNVRT
 LD (D_P_START),DE
 CP 13
 JR Z,D_LIST_COUNTED
 CP ','
 JR Z,D_LIST_SECOND
 CP ' '
 JP NZ,WHAT
D_LIST_SECOND:
 INC HL
 CALL D_META_SKIP
 LD A,(HL)
 CP 13
 JP Z,WHAT
 CALL D_PARSE_END
 LD (D_P_END),DE
 CALL D_TRAILING_SPACE
 CALL D_CHECK_INTERVAL
 LD HL,(D_P_END)
 LD (ENDLST),HL
 LD A,(D_ARG_TOP)
 LD (D_LIST_TOP),A
 XOR A
 LD (CNTENAB),A
 JR D_LIST_COMMIT
D_LIST_COUNTED:
 LD HL,(D_P_START)
 LD DE,(OFFSET)
 ADD HL,DE
 CALL D_BYTE_CHECK
D_LIST_COMMIT:
 LD HL,(D_P_START)
 LD (PC),HL
 JP TENL

; At the top of the address space use byte literals for the final four bytes.
; This avoids all decoder and grouped-data arithmetic wrapping past FFFFH.
D_LAST_BYTES:
 LD A,(D_END_TOP)
 OR A
 RET Z
 LD HL,(PC)
 LD DE,0FFFCH
 OR A
 SBC HL,DE
 CCF
 RET
