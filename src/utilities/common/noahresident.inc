; Production NOAH phase loader. No call into the replaced controller is live
; during a codec phase. Mutable CLI/transaction data and stack are resident.
NR_START:
 LD (NR_CALLSP),SP
 LD (NR_CALLIX),IX
 LD (NR_CALLIY),IY
 LD SP,NH_STACK_TOP
 XOR A
 LD (NR_CAPTURED),A
 ; Forgiving exact VER/HELP queries never open the companion.
 LD HL,81H
 LD A,(80H)
 CP 128
 JP NC,NR_USAGE
 LD B,A
 LD DE,NH_VERSION
 LD (NR_QUERY_TEXT),DE
 XOR A
 LD (NR_QUERY_FOUND),A
NR_QUERY_NEXT:
 LD A,B
 OR A
 JP Z,NR_QUERY_DONE
 LD A,(HL)
 CP ' '
 JR Z,NR_QUERY_SKIP
 CP 9
 JR Z,NR_QUERY_SKIP
 LD DE,NR_QUERY_WORD
 LD C,0
NR_QUERY_COPY:
 LD A,B
 OR A
 JR Z,NR_QUERY_TOKEN
 LD A,(HL)
 CP ' '
 JR Z,NR_QUERY_TOKEN
 CP 9
 JR Z,NR_QUERY_TOKEN
 INC HL
 DEC B
 CALL NR_UPPER
 LD (DE),A
 INC DE
 INC C
 LD A,C
 CP 6
 JR C,NR_QUERY_COPY
NR_QUERY_LONG:
 LD A,B
 OR A
 JR Z,NR_QUERY_NEXT
 LD A,(HL)
 CP ' '
 JR Z,NR_QUERY_NEXT
 CP 9
 JR Z,NR_QUERY_NEXT
 INC HL
 DEC B
 JR NR_QUERY_LONG
NR_QUERY_TOKEN:
 LD A,C
 CP 4
 JR NZ,NR_QUERY_HELP
 LD DE,NR_QUERY_WORD
 LD IY,NR_VER_WORD
 CALL NR_QUERY_EQ
 JR NZ,NR_QUERY_NEXT
 LD A,1
 LD (NR_QUERY_FOUND),A
 JR NR_QUERY_NEXT
NR_QUERY_HELP:
 CP 5
 JR NZ,NR_QUERY_NEXT
 LD DE,NR_QUERY_WORD
 LD IY,NR_HELP_WORD
 CALL NR_QUERY_EQ
 JR NZ,NR_QUERY_NEXT
 LD DE,NH_HELP
 LD (NR_QUERY_TEXT),DE
 LD A,2
 LD (NR_QUERY_FOUND),A
 JR NR_QUERY_NEXT
NR_QUERY_SKIP:
 INC HL
 DEC B
 JR NR_QUERY_NEXT
NR_QUERY_EQ:
 PUSH HL
 PUSH BC
 LD B,C
NR_QUERY_EQ_LOOP:
 LD A,(DE)
 CP (IY+0)
 JR NZ,NR_QUERY_EQ_END
 INC DE
 INC IY
 DJNZ NR_QUERY_EQ_LOOP
NR_QUERY_EQ_END:
 POP BC
 POP HL
 RET
NR_QUERY_DONE:
 LD A,(NR_QUERY_FOUND)
 OR A
 JR Z,NR_NO_QUERY
 LD DE,(NR_QUERY_TEXT)
 CALL NR_PRINT
 JP NR_RETURN
NR_NO_QUERY:
 LD A,(80H)
 OR A
 JR Z,NR_USAGE
 LD C,25
 CALL NR_BDOS
 LD (NR_DRIVE),A
 LD E,255
 LD C,32
 CALL NR_BDOS
 LD (NR_USER),A
 LD A,1
 LD (NR_CAPTURED),A
 CALL NR_LOAD
 JP C,NR_FATAL
 LD SP,(NR_CALLSP)
 LD IX,(NR_CALLIX)
 LD IY,(NR_CALLIY)
 JP NR_WINDOW
NR_USAGE:
 LD DE,NH_USAGE
 CALL NR_PRINT
 JP NR_RETURN
NR_UPPER:
 CP 'a'
 RET C
 CP 'z'+1
 RET NC
 SUB 32
 RET
NR_BDOS:
 PUSH BC
 PUSH DE
 PUSH HL
 PUSH IX
 PUSH IY
 CALL 5
 POP IY
 POP IX
 POP HL
 POP DE
 POP BC
 RET
NR_PRINT:
 LD C,9
 JP NR_BDOS
NR_RESTORE:
 LD A,(NR_USER)
 LD E,A
 LD C,32
 CALL NR_BDOS
 LD A,(NR_DRIVE)
 LD E,A
 LD C,14
 CALL NR_BDOS
 LD DE,80H
 LD C,26
 JP NR_BDOS
NR_RETURN:
 LD A,(NR_CAPTURED)
 OR A
 CALL NZ,NR_RESTORE
 LD SP,(NR_CALLSP)
 LD IX,(NR_CALLIX)
 LD IY,(NR_CALLIY)
 RET
NR_FATAL:
 PUSH AF
 CALL NR_RECOVERY_CLOSE
 POP AF
 CP 7
 LD DE,NR_FAILURE_TEXT
 JR NZ,NR_FATAL_REPORT
 LD DE,NR_LOW_TEXT
NR_FATAL_REPORT:
 CALL NR_PRINT
 CALL NR_RECOVERY_NAMES
 JP NR_RETURN
NR_LOW_MEMORY:
 LD A,7
 SCF
 RET
; A module ID. Exact expected header binds signature, ABI, build identity,
; offsets, entries, capacities, record length and all reserved/index bytes.
; CRC32 covers the complete companion, including header with CRC field zero.
; Every load reopens/revalidates; the invocation DU wins over A0 fallback.
NR_LOAD:
 LD (NR_MODULE),A
 DEC A
 CP 7
 JP NC,NR_BAD
 LD L,A
 LD H,0
 ADD HL,HL
 LD E,L
 LD D,H
 ADD HL,HL
 ADD HL,DE
 ADD HL,HL
 LD DE,NR_EXPECT+24
 ADD HL,DE
 LD (NR_DESCRIPTOR),HL
 LD DE,8
 ADD HL,DE
 LD E,(HL)
 INC HL
 LD D,(HL)
 LD HL,NR_WINDOW
 ADD HL,DE
 JP C,NR_LOW_MEMORY
 EX DE,HL
 LD HL,(6)
 OR A
 SBC HL,DE
 JP C,NR_LOW_MEMORY
 XOR A
 LD (NR_OPENED),A
 LD HL,NR_FCB
 LD DE,NR_FCB+1
 LD BC,35
 LD (HL),0
 LDIR
 LD HL,NR_OVL_NAME
 LD DE,NR_FCB+1
 LD BC,11
 LDIR
 LD A,(NR_DRIVE)
 INC A
 LD (NR_FCB),A
 LD A,(NR_USER)
 LD (NR_OVL_USER),A
 LD E,A
 LD C,32
 CALL NR_BDOS
 LD DE,NR_FCB
 LD C,15
 CALL NR_BDOS
 CP 255
 JR NZ,NR_LOAD_OPEN
 XOR A
 LD (NR_FCB),A
 INC A
 LD (NR_FCB),A
 XOR A
 LD (NR_OVL_USER),A
 LD E,A
 LD C,32
 CALL NR_BDOS
 LD DE,NR_FCB
 LD C,15
 CALL NR_BDOS
 CP 255
 JP Z,NR_BAD_RESTORE
NR_LOAD_OPEN:
 LD A,1
 LD (NR_OPENED),A
 LD HL,0
 LD (NR_RECORD),HL
 LD HL,NR_CRC
 LD B,4
NR_CRC_INIT:
 LD (HL),255
 INC HL
 DJNZ NR_CRC_INIT
NR_LOAD_NEXT:
 LD DE,NR_DMA
 LD C,26
 CALL NR_BDOS
 LD DE,NR_FCB
 LD C,20
 CALL NR_BDOS
 OR A
 JP NZ,NR_LOAD_BAD
 LD HL,(NR_RECORD)
 LD A,H
 OR L
 JR NZ,NR_BODY
 LD HL,NR_DMA
 LD DE,NR_EXPECT
 LD B,128
NR_HEADER_CHECK:
 LD A,(DE)
 CP (HL)
 JP NZ,NR_LOAD_BAD
 INC HL
 INC DE
 DJNZ NR_HEADER_CHECK
 LD HL,NR_DMA+124
 LD B,4
 XOR A
NR_ZERO_CRC:
 LD (HL),A
 INC HL
 DJNZ NR_ZERO_CRC
NR_BODY:
 LD HL,NR_DMA
 LD B,128
NR_CRC_BYTES:
 LD A,(HL)
 PUSH HL
 PUSH BC
 CALL NR_CRC_BYTE
 POP BC
 POP HL
 INC HL
 DJNZ NR_CRC_BYTES
 LD HL,(NR_DESCRIPTOR)
 INC HL
 INC HL
 LD E,(HL)
 INC HL
 LD D,(HL)
 LD HL,(NR_RECORD)
 OR A
 SBC HL,DE
 JR C,NR_NOT_SELECTED
 PUSH HL
 LD HL,(NR_DESCRIPTOR)
 LD DE,4
 ADD HL,DE
 LD E,(HL)
 INC HL
 LD D,(HL)
 POP HL
 OR A
 SBC HL,DE
 JR NC,NR_NOT_SELECTED
 ADD HL,DE
 ADD HL,HL
 ADD HL,HL
 ADD HL,HL
 ADD HL,HL
 ADD HL,HL
 ADD HL,HL
 ADD HL,HL
 PUSH HL
 LD HL,(NR_DESCRIPTOR)
 LD DE,10
 ADD HL,DE
 LD E,(HL)
 INC HL
 LD D,(HL)
 POP HL
 ADD HL,DE
 EX DE,HL
 LD HL,NR_DMA
 LD BC,128
 LDIR
NR_NOT_SELECTED:
 LD HL,(NR_RECORD)
 INC HL
 LD (NR_RECORD),HL
 LD DE,(NR_EXPECT+16)
 OR A
 SBC HL,DE
 JP C,NR_LOAD_NEXT
 LD DE,NR_DMA
 LD C,26
 CALL NR_BDOS
 LD DE,NR_FCB
 LD C,20
 CALL NR_BDOS
 CP 1
 JR NZ,NR_LOAD_BAD
 LD HL,NR_CRC
 LD DE,NR_EXPECT+124
 LD B,4
NR_CRC_CHECK:
 LD A,(HL)
 CPL
 EX DE,HL
 CP (HL)
 EX DE,HL
 JR NZ,NR_LOAD_BAD
 INC HL
 INC DE
 DJNZ NR_CRC_CHECK
 CALL NR_CLOSE
 JR C,NR_BAD_RESTORE
 CALL NR_RESTORE
 OR A
 RET
NR_LOAD_BAD:
 CALL NR_CLOSE
NR_BAD_RESTORE:
 CALL NR_RESTORE
NR_BAD:
 LD A,13
 SCF
 RET
NR_CLOSE:
 LD A,(NR_OPENED)
 OR A
 RET Z
 LD E,255
 LD C,32
 CALL NR_BDOS
 LD (NR_OVL_RETURN),A
 LD A,(NR_OVL_USER)
 LD E,A
 LD C,32
 CALL NR_BDOS
 LD DE,NR_FCB
 LD C,16
 CALL NR_BDOS
 LD (NR_CLOSE_RESULT),A
 LD A,(NR_OVL_RETURN)
 LD E,A
 LD C,32
 CALL NR_BDOS
 LD A,(NR_CLOSE_RESULT)
 CP 255
 JP Z,NR_BAD
 XOR A
 LD (NR_OPENED),A
 RET
NR_CRC_BYTE:
 LD HL,NR_CRC
 XOR (HL)
 LD (HL),A
 LD B,8
NR_CRC_BIT:
 LD HL,NR_CRC+3
 SRL (HL)
 DEC HL
 RR (HL)
 DEC HL
 RR (HL)
 DEC HL
 RR (HL)
 JR NC,NR_CRC_ADVANCE
 LD A,(HL)
 XOR 20H
 LD (HL),A
 INC HL
 LD A,(HL)
 XOR 83H
 LD (HL),A
 INC HL
 LD A,(HL)
 XOR 0B8H
 LD (HL),A
 INC HL
 LD A,(HL)
 XOR 0EDH
 LD (HL),A
NR_CRC_ADVANCE:
 DJNZ NR_CRC_BIT
 RET
