; ARC method 4: explicit Squeeze tree, LSB-first symbols, then shared RLE.
; Owned implementation following the existing USQ validation strategy.
; Singleton storage stays inside NHARK's inactive writer arena.
DH_BYTE:
 PUSH BC
 PUSH DE
 PUSH HL
 CALL ND_INPUT
 POP HL
 POP DE
 POP BC
 RET NC
 CP AS_END
 JP Z,AR_TRUNC
 SCF
 RET
DH_WORD:
 CALL DH_BYTE
 RET C
 LD E,A
 CALL DH_BYTE
 RET C
 LD D,A
 OR A
 RET
DH_INIT:
 CALL DH_WORD
 RET C
 LD A,D
 OR A
 JR Z,DH_COUNT_OK
 CP 1
 JP NZ,AR_FORMAT
 LD A,E
 OR A
 JP NZ,AR_FORMAT
DH_COUNT_OK:
 LD (DH_NODES),DE
 LD H,D
 LD L,E
 ADD HL,HL
 ADD HL,HL
 LD B,H
 LD C,L
 LD HL,DH_TREE
DH_READ_TREE:
 LD A,B
 OR C
 JR Z,DH_VALIDATE
 CALL DH_BYTE
 RET C
 LD (HL),A
 INC HL
 DEC BC
 JR DH_READ_TREE
DH_VALIDATE:
 XOR A
 LD (DH_EOF_SEEN),A
 LD HL,DH_MARKS
 LD DE,DH_MARKS+1
 LD BC,255
 LD (HL),A
 LDIR
 LD HL,(DH_NODES)
 LD A,H
 OR L
 JR Z,DH_READY_SET
 LD A,1
 LD (DH_MARKS),A
DH_RESTART:
 CALL NX_POLL
 JP C,AR_FAIL
 LD BC,0
 LD HL,DH_MARKS
DH_SCAN:
 LD A,(HL)
 CP 1
 JR Z,DH_NODE
 INC HL
 INC BC
 LD DE,(DH_NODES)
 LD A,E
 CP C
 JR NZ,DH_SCAN
 LD A,D
 CP B
 JR NZ,DH_SCAN
 LD BC,(DH_NODES)
 LD HL,DH_MARKS
DH_ALL:
 LD A,(HL)
 CP 2
 JP NZ,AR_FORMAT
 INC HL
 DEC BC
 LD A,B
 OR C
 JR NZ,DH_ALL
 LD A,(DH_EOF_SEEN)
 OR A
 JP Z,AR_FORMAT
DH_READY_SET:
 LD A,1
 LD (DH_READY),A
 OR A
 RET
DH_NODE:
 LD (HL),2
 LD H,B
 LD L,C
 CALL DH_ADDRESS
 LD E,(HL)
 INC HL
 LD D,(HL)
 INC HL
 PUSH HL
 CALL DH_CHILD
 POP HL
 RET C
 LD E,(HL)
 INC HL
 LD D,(HL)
 CALL DH_CHILD
 RET C
 JR DH_RESTART
DH_ADDRESS:
 ADD HL,HL
 ADD HL,HL
 LD DE,DH_TREE
 ADD HL,DE
 RET
DH_CHILD:
 PUSH BC
 BIT 7,D
 JR Z,DH_INDEX
 LD A,D
 CP 0FFH
 JR Z,DH_CHILD_OK
 CP 0FEH
 JR NZ,DH_CHILD_BAD
 LD A,E
 CP 0FFH
 JR NZ,DH_CHILD_BAD
 LD A,1
 LD (DH_EOF_SEEN),A
DH_CHILD_OK:
 POP BC
 OR A
 RET
DH_INDEX:
 LD H,D
 LD L,E
 LD BC,(DH_NODES)
 OR A
 SBC HL,BC
 JR NC,DH_CHILD_BAD
 LD HL,DH_MARKS
 ADD HL,DE
 LD A,(HL)
 OR A
 JR NZ,DH_CHILD_BAD
 LD (HL),1
 JR DH_CHILD_OK
DH_CHILD_BAD:
 POP BC
 JP AR_FORMAT
DH_GET:
 LD A,(DH_DONE)
 OR A
 JR NZ,DH_END
 LD A,(DH_READY)
 OR A
 CALL Z,DH_INIT
 RET C
 LD HL,(DH_NODES)
 LD A,H
 OR L
 JR Z,DH_LOGICAL_END
 LD HL,0
DH_SYMBOL_NODE:
 CALL DH_ADDRESS
 LD A,(DH_BITS)
 OR A
 JR NZ,DH_BIT
 CALL DH_BYTE
 RET C
 LD (DH_BITBYTE),A
 LD A,8
 LD (DH_BITS),A
DH_BIT:
 LD A,(DH_BITS)
 DEC A
 LD (DH_BITS),A
 LD A,(DH_BITBYTE)
 RRCA
 LD (DH_BITBYTE),A
 JR NC,DH_LEFT
 INC HL
 INC HL
DH_LEFT:
 LD E,(HL)
 INC HL
 LD D,(HL)
 BIT 7,D
 JR NZ,DH_LEAF
 LD H,D
 LD L,E
 JR DH_SYMBOL_NODE
DH_LEAF:
 LD A,D
 CPL
 OR A
 JR NZ,DH_LOGICAL_END
 LD A,E
 CPL
 OR A
 RET
DH_LOGICAL_END:
 ; Only unused bits of the final byte are padding. Whole stored bytes after
 ; the Huffman end symbol are not silently accepted as compressed contents.
 LD A,(ND_USED)
 OR (IX+AS_LEFT)
 OR (IX+AS_LEFT+1)
 OR (IX+AS_LEFT+2)
 OR (IX+AS_LEFT+3)
 JP NZ,AR_FORMAT
 LD A,1
 LD (DH_DONE),A
DH_END:
 LD A,AS_END
 SCF
 RET
DH_NODES: DW 0
DH_READY: DB 0
DH_DONE: DB 0
DH_BITS: DB 0
DH_BITBYTE: DB 0
DH_EOF_SEEN: DB 0
DH_TREE: DS 1024
DH_MARKS: DS 256
