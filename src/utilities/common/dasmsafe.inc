; Read and validate metadata into staging; mutate live arenas only after close.
D_IMPORT:
 LD (D_KIND),A
 LD HL,D_STAGE
 LD (D_META_PTR),HL
 XOR A
 LD (D_TEXT_EOF),A
 CALL RDOPEN
D_IMPORT_LINE:
 CALL D_LINE
