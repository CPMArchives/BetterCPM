; BetterCP/M adaptation boundaries. Upstream credit remains in dasm.mac.
; BDOS returns only A; preserve every register used by the historical engine.
D_BDOS:
 PUSH BC
 PUSH DE
 PUSH HL
 PUSH IX
 PUSH IY
 CALL 5
 POP IY
 POP IX
 POP HL
 POP DE
 POP BC
 RET
D_START:
 LD HL,RELEND
 LD DE,RELEND+1
 LD BC,INBUF+IBUFLEN+2-RELEND-1
 LD (HL),0
 LDIR
 LD HL,D_STATE
 LD DE,D_STATE+1
 LD BC,D_STATE_END-D_STATE-1
 LD (HL),0
 LDIR
 LD C,25
 CALL D_BDOS
 INC A
 LD (D_DRIVE),A
 LD E,255
 LD C,32
 CALL D_BDOS
 LD (D_USER),A
 LD (D_CURUSER),A
 LD HL,(6)
 LD (D_TOP),HL
 LD DE,D_MEM_END+256
 OR A
 SBC HL,DE
 LD DE,D_MEMORY_MSG
 JP C,D_EXIT_MSG
 LD A,(80H)
 OR A
 RET Z
 LD B,A
 LD HL,81H
D_QUERY_SPACE:
 LD A,(HL)
 CP ' '
 JR NZ,D_QUERY_TOKEN
 INC HL
 DJNZ D_QUERY_SPACE
 RET
D_QUERY_TOKEN:
 CP '/'
 RET NZ
 LD A,B
 CP 4
 JR NZ,D_QUERY_BAD
 LD DE,D_QUERY_VER
 LD B,4
D_QUERY_COMPARE:
 LD A,(DE)
 CP (HL)
 JR NZ,D_QUERY_BAD
 INC HL
 INC DE
 DJNZ D_QUERY_COMPARE
 LD DE,D_VERSION_MSG
 JP D_EXIT_MSG
D_QUERY_BAD:
 LD DE,D_USAGE_MSG
 JP D_EXIT_MSG
D_QUERY_VER: DB '/VER'
D_USAGE_MSG: DB 'DASM [file.COM] / DASM /VER / DASM /HELP',13,10
 DB 'H lists interactive commands. G exits. Nhex selects logical length.',13,10,'$'
D_RESTORE:
 PUSH AF
 PUSH BC
 PUSH DE
 PUSH HL
 LD A,(D_USER)
 LD E,A
 LD C,32
 CALL D_BDOS
 LD DE,80H
 LD C,26
 CALL D_BDOS
 POP HL
 POP DE
 POP BC
 POP AF
 RET
D_EXIT:
 LD A,(FOPEN)
 OR A
 LD DE,D_PENDING_MSG
 JP NZ,D_ERROR_MSG
 CALL D_RESTORE
 LD SP,(D_OLDSP)
 RET
D_CANCEL:
 LD SP,OLDST
 XOR A
 LD (D_CAPTURE),A
 LD (WRTENAB),A
 LD (HUSH),A
 LD A,(D_TXLIVE)
 OR A
 JR Z,D_CANCEL_DONE
 LD DE,FCB
 LD C,16
 CALL D_BDOS
 CP 255
 JR NZ,D_CANCEL_CLOSED
 LD DE,D_IO_MSG
 LD C,9
 CALL D_BDOS
D_CANCEL_CLOSED:
 ; Even a failed close cannot authorize publishing this staged partial file.
 XOR A
 LD (D_TXLIVE),A
 LD (FOPEN),A
 LD DE,D_CANCEL_MSG
 LD C,9
 CALL D_BDOS
 LD HL,D_TEMP
 CALL D_PRINT_NAME
D_CANCEL_DONE:
 JP D_EXIT
D_CANCEL_MSG: DB 'DASM: cancelled; output not published. Retained stage:',13,10,'$'
D_EXIT_MSG:
 LD C,9
 CALL D_BDOS
 CALL D_RESTORE
 LD SP,(D_OLDSP)
 RET
D_ERROR_MSG:
 LD SP,OLDST
 XOR A
 LD (D_CAPTURE),A
 LD (WRTENAB),A
 LD (HUSH),A
 LD A,(D_TXLIVE)
 OR A
 JR Z,D_ERROR_PRINT
 LD A,1
 LD (D_TXFAILED),A
D_ERROR_PRINT:
 LD C,9
 CALL D_BDOS
 CALL D_CLOSE_INPUT
 JP GETCMD
D_CLOSE_INPUT:
 LD A,(D_INOPEN)
 OR A
 RET Z
 LD DE,FCB
 LD C,16
 CALL D_BDOS
 XOR A
 LD (D_INOPEN),A
 RET
D_RDOPEN:
 XOR A
 LD (D_PHYS_EOF),A
 PUSH HL
 LD HL,FCB+12
 LD DE,FCB+13
 LD BC,23
 LD (HL),0
 LDIR
 LD DE,80H
 LD C,26
 CALL D_BDOS
 LD HL,100H
 LD (DMAPTR),HL
 LD DE,FCB
 LD C,15
 CALL D_BDOS
 CP 255
 JP Z,D_IOFAIL
 LD A,1
 LD (D_INOPEN),A
 POP HL
 RET
D_SPACE:
 LD DE,D_SPACE_MSG
 JP D_ERROR_MSG
D_IOFAIL:
 ; An unsuccessful write/close is never published. Retain the staged copy.
 LD SP,OLDST
 XOR A
 LD (FOPEN),A
 LD (WRTENAB),A
 LD A,(D_TXLIVE)
 OR A
 JR Z,D_IOFAIL_MSG
 LD DE,FCB
 LD C,16
 CALL D_BDOS
 XOR A
 LD (D_TXLIVE),A
D_IOFAIL_MSG:
 LD DE,D_IO_MSG
 LD C,9
 CALL D_BDOS
 LD HL,D_TEMP
 CALL D_PRINT_NAME
 LD HL,D_BACKUP
 CALL D_PRINT_NAME
 LD DE,D_RECOVER_MSG
 JP D_ERROR_MSG
D_CTLROOM:
 PUSH AF
 PUSH BC
 PUSH DE
 PUSH HL
 LD HL,CTLTBL
D_CTL_SCAN:
 LD A,(HL)
 INC HL
 AND (HL)
 INC HL
 INC A
 JR Z,D_CTL_END
 INC HL
 JR D_CTL_SCAN
D_CTL_END:
 LD DE,SYMTAB-4
 OR A
 SBC HL,DE
 JP NC,D_SPACE
 POP HL
 POP DE
 POP BC
 POP AF
 RET
D_SYMROOM:
 PUSH AF
 PUSH BC
 PUSH DE
 PUSH HL
 LD HL,(SYMEND)
 LD E,B
 LD D,0
 ADD HL,DE
 LD DE,5
 ADD HL,DE
 LD DE,INITOFF
 OR A
 SBC HL,DE
 JP NC,D_SPACE
 POP HL
 POP DE
 POP BC
 POP AF
 RET
D_CMTROOM:
 PUSH AF
 PUSH BC
 PUSH DE
 PUSH HL
 LD HL,(COMEND)
 LD DE,86
 ADD HL,DE
 LD DE,D_CMT_LIMIT
 OR A
 SBC HL,DE
 JP NC,D_SPACE
 POP HL
 POP DE
 POP BC
 POP AF
 RET
D_UAREA:
 LD HL,INBUF+3
 CALL CNVRT
 CP 13
 JP NZ,WHAT
 LD HL,COMTBL
 OR A
 SBC HL,DE
 JP NZ,D_SPACE
 RET
; A physical pointer must be within the committed input interval.
D_BYTE_CHECK:
 PUSH AF
 PUSH DE
 PUSH HL
 LD DE,D_BIN
 OR A
 SBC HL,DE
 JP C,D_RANGE
 POP HL
 PUSH HL
 LD DE,(D_END)
 OR A
 SBC HL,DE
 JP NC,D_RANGE
 POP HL
 POP DE
 POP AF
 RET
D_CLAMP_CTL:
 PUSH DE
 EX DE,HL
 LD HL,(RELEND)
 OR A
 SBC HL,DE
 JR NC,D_CLAMP_END
 LD DE,(RELEND)
D_CLAMP_END:
 LD A,(CNTENAB)
 OR A
 JR NZ,D_CLAMP_DONE
 LD HL,(ENDLST)
 OR A
 SBC HL,DE
 JR NC,D_CLAMP_DONE
 LD DE,(ENDLST)
D_CLAMP_DONE:
 EX DE,HL
 POP DE
 RET
; Buffer decoder characters until its length and spelling are safe to emit.
D_DECODE:
 LD HL,(PC)
 LD (D_DECODE_PC),HL
 EX DE,HL
 LD HL,(RELEND)
 OR A
 SBC HL,DE
 LD A,H
 OR A
 JR NZ,D_DECODE_LOOK
 LD A,L
 CP 4
 JP C,D_LITERAL
D_DECODE_LOOK:
 LD HL,(OFFSET)
 ADD HL,DE
 LD A,(HL)
 CP 0EDH
 JR Z,D_ED
 CP 0DDH
 JR Z,D_INDEX
 CP 0FDH
 JR Z,D_INDEX
 CP 0CBH
 JR NZ,D_DECODE_RUN
 INC HL
 LD A,(HL)
 AND 0F8H
 CP 30H
 JP Z,D_LITERAL
 JR D_DECODE_RUN
D_ED:
 INC HL
 LD A,(HL)
 LD HL,D_ED_CODES
 LD B,D_ED_END-D_ED_CODES
 JR D_OPCODE_SCAN
D_INDEX:
 INC HL
 LD A,(HL)
 CP 0CBH
 JR NZ,D_INDEX_BASE
 INC HL
 INC HL
 LD A,(HL)
 AND 7
 CP 6
 JP NZ,D_LITERAL
 JR D_DECODE_RUN
D_INDEX_BASE:
 LD HL,D_IX_CODES
 LD B,D_IX_END-D_IX_CODES
D_OPCODE_SCAN:
 CP (HL)
 JR Z,D_DECODE_RUN
 INC HL
 DJNZ D_OPCODE_SCAN
 JP D_LITERAL
D_DECODE_RUN:
 LD HL,D_CAPTURE_BUF
 LD (D_CAPTURE_PTR),HL
 LD A,1
 LD (D_CAPTURE),A
 CALL DASM
 XOR A
 LD (D_CAPTURE),A
 LD HL,(PC)
 LD DE,(RELEND)
 OR A
 SBC HL,DE
 JR C,D_REPLAY
 JR Z,D_REPLAY
 LD HL,(D_DECODE_PC)
 LD (PC),HL
 JP D_LITERAL
D_REPLAY:
 LD HL,D_CAPTURE_BUF
D_REPLAY_LOOP:
 PUSH HL
 LD DE,(D_CAPTURE_PTR)
 OR A
 SBC HL,DE
 POP HL
 RET Z
 LD A,(HL)
 INC HL
 LD B,(HL)
 INC HL
 LD C,(HL)
 INC HL
 PUSH HL
 PUSH AF
 LD A,B
 LD (WRTENAB),A
 LD A,C
 LD (HUSH),A
 POP AF
 CALL COUT_REAL
 POP HL
 JR D_REPLAY_LOOP
D_COUT_GATE:
 PUSH AF
 LD A,(D_CAPTURE)
 OR A
 JR NZ,D_CAPTURE_CHAR
 POP AF
 JP COUT_REAL
D_CAPTURE_CHAR:
 POP AF
 PUSH AF
 PUSH BC
 PUSH DE
 PUSH HL
 LD B,A
 LD HL,(D_CAPTURE_PTR)
 PUSH HL
 LD DE,D_CAPTURE_END-3
 OR A
 SBC HL,DE
 JP NC,D_SPACE
 POP HL
 LD (HL),B
 INC HL
 LD A,(WRTENAB)
 LD (HL),A
 INC HL
 LD A,(HUSH)
 LD (HL),A
 INC HL
 LD (D_CAPTURE_PTR),HL
 POP HL
 POP DE
 POP BC
 POP AF
 RET
D_LITERAL:
 CALL HSYM
 CALL PSTG
 DB 'DB',9,0
 LD HL,(D_DECODE_PC)
 LD DE,(OFFSET)
 ADD HL,DE
 LD A,(HL)
 CALL PASHEX
 LD A,'H'
 CALL COUT
 CALL CRLF
 LD HL,(PC)
 INC HL
 LD (PC),HL
 RET
D_ED_CODES:
 DB 40H,41H,42H,43H,44H,45H,46H,47H,48H,49H,4AH,4BH,4DH,4FH
 DB 50H,51H,52H,53H,56H,57H,58H,59H,5AH,5BH,5EH,5FH
 DB 60H,61H,62H,67H,68H,69H,6AH,6FH,72H,73H,78H,79H,7AH,7BH
 DB 0A0H,0A1H,0A2H,0A3H,0A8H,0A9H,0AAH,0ABH
 DB 0B0H,0B1H,0B2H,0B3H,0B8H,0B9H,0BAH,0BBH
D_ED_END:
D_IX_CODES:
 DB 09H,19H,21H,22H,23H,29H,2AH,2BH,34H,35H,36H,39H
 DB 46H,4EH,56H,5EH,66H,6EH,70H,71H,72H,73H,74H,75H,77H,7EH
 DB 86H,8EH,96H,9EH,0A6H,0AEH,0B6H,0BEH,0E1H,0E3H,0E5H,0E9H,0F9H
D_IX_END:
D_PC_CHECK:
 PUSH AF
 PUSH DE
 PUSH HL
 LD HL,(PC)
 LD DE,(OFFSET)
 ADD HL,DE
 JP C,D_RANGE
 CALL D_BYTE_CHECK
 POP HL
 POP DE
 POP AF
 RET
D_DUMP_CHECK:
 CALL D_BYTE_CHECK
 RET
D_RANGE:
 LD DE,D_RANGE_MSG
 JP D_ERROR_MSG
D_LENGTH:
 LD HL,INBUF+3
 CALL CNVRT
 CP 13
 JP NZ,WHAT
 LD A,D
 OR E
 JP Z,WHAT
 LD HL,(D_LENGTH_BYTES)
 OR A
 SBC HL,DE
 JP C,D_RANGE
 LD HL,D_BIN
 ADD HL,DE
 LD (D_END),HL
 CALL TWOS
 LD (RELEND),HL
 JP GETCMD
; Load at most 8192 bytes into staging, close, then commit the binary.
D_COMRD:
 LD DE,FCB
 LD C,35
 CALL D_BDOS
 CP 255
 JP Z,D_IOFAIL
 XOR A
 LD (D_INOPEN),A
 LD A,(FCB+35)
 OR A
 JP NZ,D_SPACE
 LD HL,(FCB+33)
 LD DE,65
 OR A
 SBC HL,DE
 JP NC,D_SPACE
 CALL RDOPEN
 LD HL,D_STAGE
 LD (D_LOADPTR),HL
D_LOAD_RECORD:
 LD HL,(D_LOADPTR)
 LD DE,D_MEM_END-127
 OR A
 SBC HL,DE
 JR NC,D_LOAD_FULL
 LD DE,(D_LOADPTR)
 LD C,26
 CALL D_BDOS
 LD DE,FCB
 LD C,20
 CALL D_BDOS
 OR A
 JR NZ,D_LOAD_DONE
 LD HL,(D_LOADPTR)
 LD DE,128
 ADD HL,DE
 LD (D_LOADPTR),HL
 JR D_LOAD_RECORD
D_LOAD_FULL:
 ; Read one extra record into private DMA solely to distinguish exact fit.
 LD DE,80H
 LD C,26
 CALL D_BDOS
 LD DE,FCB
 LD C,20
 CALL D_BDOS
 OR A
 JP Z,D_SPACE
D_LOAD_DONE:
 CP 1
 JP NZ,D_IOFAIL
 LD DE,FCB
 LD C,16
 CALL D_BDOS
 CP 255
 JP Z,D_IOFAIL
 XOR A
 LD (D_INOPEN),A
 LD HL,(D_LOADPTR)
 LD DE,D_STAGE
 OR A
 SBC HL,DE
 LD A,H
 OR L
 JP Z,D_RANGE
 LD (D_LENGTH_BYTES),HL
 LD B,H
 LD C,L
 LD HL,D_STAGE
 LD DE,D_BIN
 LDIR
 LD (D_END),DE
 CALL INIT
 LD HL,FCB
 LD DE,D_INPUT_NAME
 LD BC,12
 LDIR
 LD A,(D_CURUSER)
 LD (D_INPUT_USER),A
 LD HL,(D_END)
 CALL TWOS
 LD (RELEND),HL
 LD DE,80H
 LD C,26
 CALL D_BDOS
 RET
; Stage a single output. The old destination remains until successful close.
D_OPEN:
 PUSH HL
 LD A,(D_TXLIVE)
 OR A
 JP NZ,D_IOFAIL
 LD A,(D_CURUSER)
 LD (D_TXUSER),A
 LD E,A
 LD C,32
 CALL D_BDOS
 LD HL,FCB
 LD DE,D_OUTPUT
 LD BC,12
 LDIR
 LD HL,D_INPUT_NAME
 LD DE,D_OUTPUT
 CALL D_SAME
 JR NZ,D_OPEN_CHECK
 LD A,(D_INPUT_USER)
 LD B,A
 LD A,(D_TXUSER)
 CP B
 LD DE,D_ALIAS_MSG
 JP Z,D_ERROR_MSG
D_OPEN_CHECK:
 LD DE,D_OUTPUT
 CALL D_EXISTS
 LD (D_REPLACE),A
 CP 255
 JR Z,D_OPEN_STAGE
 ; Attribute-bearing directory entries are not silently made writable.
 AND 3
 ADD A,A
 ADD A,A
 ADD A,A
 ADD A,A
 ADD A,A
 LD L,A
 LD H,0
 LD DE,89H
 ADD HL,DE
 BIT 7,(HL)
 LD DE,D_READONLY_MSG
 JP NZ,D_ERROR_MSG
 LD DE,D_REPLACE_MSG
 LD C,9
 CALL D_BDOS
 CALL CHIN
 CP 'Y'
 JP NZ,GETCMD
D_OPEN_STAGE:
 LD HL,D_STAGE_NAME
 LD DE,FCB+1
 LD BC,11
 LDIR
 LD A,(D_OUTPUT)
 LD (FCB),A
 CALL D_UNIQUE
 LD DE,FCB
 LD C,22
 CALL D_BDOS
 CP 255
 JP Z,D_IOFAIL
 LD HL,FCB
 LD DE,D_TEMP
 LD BC,12
 LDIR
 XOR A
 LD (D_TXFAILED),A
 LD A,1
 LD (D_TXLIVE),A
 LD HL,80H
 LD (DMAPTR),HL
 LD DE,80H
 LD C,26
 CALL D_BDOS
 POP HL
 RET
D_EXISTS:
 PUSH DE
 LD DE,80H
 LD C,26
 CALL D_BDOS
 POP DE
 LD C,17
 CALL D_BDOS
 RET
D_UNIQUE:
 XOR A
 LD HL,FCB+12
 LD DE,FCB+13
 LD BC,23
 LD (HL),A
 LDIR
D_UNIQUE_TRY:
 LD DE,FCB
 CALL D_EXISTS
 CP 255
 RET Z
 LD HL,FCB+8
 LD B,5
D_UNIQUE_DIGIT:
 INC (HL)
 LD A,(HL)
 CP '9'+1
 JR C,D_UNIQUE_TRY
 LD (HL),'0'
 DEC HL
 DJNZ D_UNIQUE_DIGIT
 JP D_IOFAIL
D_WRITE:
 PUSH AF
 PUSH BC
 PUSH DE
 PUSH HL
 LD B,A
 LD A,(D_TXLIVE)
 OR A
 JP Z,D_IOFAIL
 LD HL,(DMAPTR)
 LD (HL),B
 INC HL
 LD (DMAPTR),HL
 LD A,L
 OR A
 CALL Z,D_FLUSH
 POP HL
 POP DE
 POP BC
 POP AF
 RET
D_FLUSH:
 LD A,(D_TXUSER)
 LD E,A
 LD C,32
 CALL D_BDOS
 LD DE,80H
 LD C,26
 CALL D_BDOS
 LD DE,FCB
 LD C,21
 CALL D_BDOS
 OR A
 JP NZ,D_IOFAIL
 LD HL,80H
 LD (DMAPTR),HL
 RET
D_FINAL:
 LD A,(D_TXFAILED)
 OR A
 JP NZ,D_IOFAIL
 PUSH BC
 PUSH DE
 PUSH HL
 LD HL,(DMAPTR)
 LD A,L
 CP 80H
 JR Z,D_FINAL_CLOSE
D_FINAL_PAD:
 LD (HL),26
 INC L
 JR NZ,D_FINAL_PAD
 CALL D_FLUSH
D_FINAL_CLOSE:
 LD DE,FCB
 LD C,16
 CALL D_BDOS
 CP 255
 JP Z,D_IOFAIL
 ; Keep the staged identity independent of FCB's allocation state.
 LD HL,FCB
 LD DE,D_TEMP
 LD BC,12
 LDIR
 LD A,(D_REPLACE)
 CP 255
 JR Z,D_PUBLISH
 LD HL,D_BACK_NAME
 LD DE,FCB+1
 LD BC,11
 LDIR
 CALL D_UNIQUE
 LD HL,FCB
 LD DE,D_BACKUP
 LD BC,12
 LDIR
 LD HL,D_OUTPUT
 LD DE,D_REN
 LD BC,12
 LDIR
 LD HL,D_BACKUP
 LD DE,D_REN+16
 LD BC,12
 LDIR
 CALL D_RENAME
D_PUBLISH:
 LD HL,D_TEMP
 LD DE,D_REN
 LD BC,12
 LDIR
 LD HL,D_OUTPUT
 LD DE,D_REN+16
 LD BC,12
 LDIR
 ; Search again. Never allow CP/M RENAME to overwrite a late destination.
 LD DE,D_OUTPUT
 CALL D_EXISTS
 CP 255
 JP NZ,D_IOFAIL
 CALL D_RENAME
 XOR A
 LD (D_TXLIVE),A
 LD HL,D_OUTPUT
 LD DE,FCB
 LD BC,12
 LDIR
 POP HL
 POP DE
 POP BC
 RET
D_RENAME:
 LD DE,D_REN
 LD C,23
 CALL D_BDOS
 CP 255
 JP Z,D_IOFAIL
 RET
D_SAME:
 LD B,12
D_SAME_LOOP:
 LD A,(DE)
 CP (HL)
 RET NZ
 INC HL
 INC DE
 DJNZ D_SAME_LOOP
 RET
D_PRINT_NAME:
 LD A,(HL)
 OR A
 RET Z
 PUSH HL
 ADD A,'@'
 LD E,A
 LD C,2
 CALL D_BDOS
 LD A,(D_TXUSER)
 CP 10
 JR C,D_PRINT_USER
 SUB 10
 PUSH AF
 LD E,'1'
 LD C,2
 CALL D_BDOS
 POP AF
