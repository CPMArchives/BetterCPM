 ADD A,'0'
 LD E,A
 LD C,2
 CALL D_BDOS
 LD E,':'
 CALL D_BDOS
 POP HL
 INC HL
 LD B,8
D_PRINT_BASE:
 LD A,(HL)
 CP ' '
 CALL NZ,D_PRINT_CHAR
 INC HL
 DJNZ D_PRINT_BASE
 LD A,(HL)
 CP ' '
 JR Z,D_PRINT_EOL
 LD A,'.'
 CALL D_PRINT_CHAR
 LD B,3
D_PRINT_EXT:
 LD A,(HL)
 CP ' '
 CALL NZ,D_PRINT_CHAR
 INC HL
 DJNZ D_PRINT_EXT
D_PRINT_EOL:
 LD A,13
 CALL D_PRINT_CHAR
 LD A,10
D_PRINT_CHAR:
 LD E,A
 LD C,2
 JP D_BDOS
D_FILENAME:
 LD A,(FOPEN)
 OR A
 JP NZ,CANT
 LD HL,FCB
 LD DE,FCB+1
 LD BC,35
 LD (HL),0
 LDIR
 LD HL,FCB+1
 LD B,11
D_NAME_BLANK:
 LD (HL),' '
 INC HL
 DJNZ D_NAME_BLANK
 LD A,(D_DRIVE)
 LD (FCB),A
 LD A,(D_USER)
 LD (D_CURUSER),A
 LD HL,INBUF+3
D_NAME_SKIP:
 LD A,(HL)
 CP ' '
 JR NZ,D_NAME_PREFIX
 INC HL
 JR D_NAME_SKIP
D_NAME_PREFIX:
 LD (D_PARSE_PTR),HL
 LD A,(HL)
 CP 'A'
 JR C,D_NAME_BODY
 CP 'P'+1
 JR NC,D_NAME_BODY
 LD B,A
 INC HL
 LD A,(HL)
 CP ':'
 JR Z,D_NAME_DRIVE
 CP '0'
 JR C,D_NAME_BODY
 CP '9'+1
 JR NC,D_NAME_BODY
 SUB '0'
 LD C,A
 INC HL
 LD A,(HL)
 CP ':'
 JR Z,D_NAME_USER
 LD A,C
 CP 1
 JP NZ,WHAT
 LD A,(HL)
 SUB '0'
 CP 6
 JP NC,WHAT
 ADD A,10
 LD C,A
 INC HL
 LD A,(HL)
 CP ':'
 JP NZ,WHAT
D_NAME_USER:
 LD A,C
 LD (D_CURUSER),A
D_NAME_DRIVE:
 LD A,B
 SUB '@'
 LD (FCB),A
 INC HL
 LD (D_PARSE_PTR),HL
D_NAME_BODY:
 LD HL,(D_PARSE_PTR)
 LD DE,FCB+1
 LD B,8
 LD C,0
D_NAME_CHAR:
 LD A,(HL)
 CP 13
 JR Z,D_NAME_DONE
 CP '.'
 JR Z,D_NAME_DOT
 CALL D_NAME_VALID
 JP C,WHAT
 LD A,B
 OR A
 JP Z,WHAT
 LD A,(HL)
 LD (DE),A
 INC DE
 INC HL
 DEC B
 INC C
 JR D_NAME_CHAR
D_NAME_DOT:
 LD A,C
 OR A
 JP Z,WHAT
 LD A,E
 ADD A,B
 LD E,A
 JR NC,D_NAME_EXT
 INC D
D_NAME_EXT:
 LD B,3
 INC HL
D_EXT_CHAR:
 LD A,(HL)
 CP 13
 JR Z,D_NAME_DONE
 CALL D_NAME_VALID
 JP C,WHAT
 LD A,B
 OR A
 JP Z,WHAT
 LD A,(HL)
 LD (DE),A
 INC DE
 INC HL
 DEC B
 JR D_EXT_CHAR
D_NAME_DONE:
 LD A,C
 OR A
 JP Z,WHAT
 LD A,(D_CURUSER)
 LD E,A
 LD C,32
 CALL D_BDOS
 RET
D_NAME_VALID:
 CP '_'
 RET Z
 CP '$'
 RET Z
 CP '0'
 RET C
 CP '9'+1
 JR C,D_NAME_GOOD
 CP 'A'
 RET C
 CP 'Z'+1
 CCF
 RET
D_IDENT_FIRST:
 LD A,(HL)
 CP '_'
 RET Z
 CP 'A'
 RET C
 CP 'Z'+1
 CCF
 RET
D_NAME_GOOD:
 OR A
 RET
D_ENTER_CHECK:
 LD HL,INBUF+3
 CALL CNVRT
 INC HL
 LD A,(HL)
 CP '.'
 JP NZ,WHAT
 INC HL
 CALL D_IDENT_FIRST
 JP C,WHAT
 LD B,0
D_ENTER_LOOP:
 LD A,(HL)
 CP 13
 JR Z,D_ENTER_END
 CALL D_NAME_VALID
 JP C,WHAT
 INC HL
 INC B
 LD A,B
 CP 13
 JP NC,WHAT
 JR D_ENTER_LOOP
D_ENTER_END:
