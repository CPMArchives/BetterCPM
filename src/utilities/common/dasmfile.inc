; Exact, bounded shared DU/filespec parsing. Parsing performs no BDOS calls.
D_FILENAME:
 LD A,(FOPEN)
 OR A
 JP NZ,CANT
 LD A,(D_TXLIVE)
 OR A
 JP NZ,CANT
 LD HL,INBUF+3
 PUSH HL
 LD B,0
D_FILE_LENGTH:
 LD A,(HL)
 CP 13
 JR Z,D_FILE_BOUNDED
 INC HL
 INC B
 LD A,B
 CP 80
 JP NC,WHAT
 JR D_FILE_LENGTH
D_FILE_BOUNDED:
 POP HL
 JP D_PARSE_FILE

; HL/B is a single operand, possibly surrounded by horizontal whitespace.
D_PARSE_FILE:
 CALL D_TRIM_BOUNDS
 JP C,WHAT
 LD A,(D_DRIVE)
 DEC A
 LD D,A
 LD A,(D_USER)
 LD E,A
 CALL DU_PARSE
 JP C,WHAT
 PUSH HL
 PUSH BC
 LD BC,0
 CALL DU_NEXT
 JP C,WHAT
 LD A,D
 INC A
 LD (D_FILE_DRIVE),A
 LD A,E
 LD (D_FILE_USER),A
 CALL DU_NEXT
 JP NC,WHAT ; A file operation requires exactly one DU, not a scope.
 POP BC
 POP HL
 PUSH HL
 PUSH BC
 XOR A
 CALL FP_VALIDATE
 JP C,WHAT
 POP BC
 POP HL
 ; Build the FCB only after complete syntax/domain validation.
 PUSH HL
 PUSH BC
 LD HL,FCB
 LD DE,FCB+1
 LD BC,35
 LD (HL),0
 LDIR
 LD HL,FCB+1
 LD B,11
D_FILE_BLANK:
 LD (HL),' '
 INC HL
 DJNZ D_FILE_BLANK
 POP BC
 POP HL
 LD DE,FCB+1
D_FILE_COPY:
 LD A,(HL)
 CP '.'
 JR Z,D_FILE_EXTENSION
 CALL D_UPPER
 LD (DE),A
 INC DE
 JR D_FILE_COPIED
D_FILE_EXTENSION:
 LD DE,FCB+9
D_FILE_COPIED:
 INC HL
 DJNZ D_FILE_COPY
 LD A,(D_FILE_DRIVE)
 LD (FCB),A
 LD A,(D_FILE_USER)
 LD (D_CURUSER),A
 RET
D_FILE_DRIVE: DB 0
D_FILE_USER: DB 0
DU_MAP: DS 64
DU_WORK: DS 12
 INCLUDE duselect.inc
 INCLUDE filespec.inc

D_TRIM_BOUNDS:
 LD A,B
 OR A
 SCF
 RET Z
D_FILE_LEADING:
 LD A,(HL)
 CP ' '
 JR Z,D_FILE_SKIP
 CP 9
 JR NZ,D_FILE_TRIM
D_FILE_SKIP:
 INC HL
 DJNZ D_FILE_LEADING
 SCF
 RET
D_FILE_TRIM:
 PUSH HL
 LD E,B
 LD D,0
 ADD HL,DE
 DEC HL
D_FILE_TRAILING:
 LD A,(HL)
 CP ' '
 JR Z,D_FILE_REMOVE
 CP 9
 JR NZ,D_FILE_TRIMMED
D_FILE_REMOVE:
 DEC HL
 DJNZ D_FILE_TRAILING
 POP HL
 SCF
 RET
D_FILE_TRIMMED:
 POP HL
 OR A
 RET
