; Ithreshold,[+|-]magnitude. Validate every selected result before committing
; any value; the binary and the symbol names never move.
D_REBASE:
 LD HL,INBUF+3
 CALL CNVRT
 CP ','
 JR Z,D_R_DELTA
 CP ' '
 JP NZ,WHAT
D_R_DELTA:
 LD (D_R_THRESHOLD),DE
 INC HL
 CALL D_META_SKIP
 XOR A
 LD (D_R_NEGATIVE),A
 LD A,(HL)
 CP '-'
 JR NZ,D_R_PLUS
 LD A,1
 LD (D_R_NEGATIVE),A
 INC HL
 JR D_R_NUMBER
D_R_PLUS:
 CP '+'
 JR NZ,D_R_NUMBER
 INC HL
D_R_NUMBER:
 LD A,(HL)
 CP 13
 JP Z,WHAT
 CALL CNVRT
 LD (D_R_AMOUNT),DE
 CALL D_TRAILING_SPACE
 XOR A
 LD (D_R_COMMIT),A
 CALL D_R_SCAN
 LD A,1
 LD (D_R_COMMIT),A
 CALL D_R_SCAN
 JP GETCMD
D_R_SCAN:
 LD HL,SYMTAB
D_R_RECORD:
 LD (D_R_RECORDPTR),HL
 LD E,(HL)
 INC HL
 LD D,(HL)
 INC HL
 LD A,(HL)
 OR A
 RET Z
 LD HL,(D_R_THRESHOLD)
 OR A
 SBC HL,DE
 JR C,D_R_SELECTED
 JR Z,D_R_SELECTED
 JR D_R_NEXT
D_R_SELECTED:
 EX DE,HL
 LD DE,(D_R_AMOUNT)
 LD A,(D_R_NEGATIVE)
 OR A
 JR NZ,D_R_SUBTRACT
 ADD HL,DE
 JP C,D_R_OVERFLOW
 JR D_R_RESULT
D_R_SUBTRACT:
 OR A
 SBC HL,DE
 JP C,D_R_OVERFLOW
D_R_RESULT:
 LD A,(D_R_COMMIT)
 OR A
 JR Z,D_R_NEXT
 EX DE,HL
 LD HL,(D_R_RECORDPTR)
 LD (HL),E
 INC HL
 LD (HL),D
D_R_NEXT:
 LD HL,(D_R_RECORDPTR)
 CALL D_SNEXT_TEXT
 JR D_R_RECORD
D_R_OVERFLOW:
 LD DE,D_R_OVER_MSG
 JP D_ERROR_MSG
D_R_OVER_MSG: DB 'DASM: rebase crosses the address space; symbols unchanged.',13,10,'$'
D_R_THRESHOLD: DW 0
D_R_AMOUNT: DW 0
D_R_RECORDPTR: DW 0
D_R_NEGATIVE: DB 0
D_R_COMMIT: DB 0
