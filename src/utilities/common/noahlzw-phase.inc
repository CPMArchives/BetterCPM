; Original ARC LZW decoder, methods 5..9. Replaces CLI/NHARK temporarily.
; 24 KiB maximum dictionary; phrase paths reverse/restore in place, no stack.
 JP X_INIT
 JP X_HEAD
 JP X_RUN
X_TABLE EQU NR_WINDOW+4096
X_CHAIN EQU X_TABLE+12288
X_INIT:
 XOR A
 LD HL,X_DATA
 LD DE,X_DATA+1
 LD BC,X_DATA_END-X_DATA-1
 LD (HL),A
 LDIR
 LD A,(IX+AS_MEMBER+AM_METHOD)
 LD (X_METHOD),A
 CP 5
 JP C,X_BAD
 CP 10
 JP NC,X_BAD
 LD HL,4096
 LD (X_CAP),HL
 LD HL,X_TABLE+16384
 LD (X_SUFFIX),HL
 LD A,12
 LD (X_MAXBITS),A
 LD A,9
 LD (X_WIDTH),A
 LD HL,512
 LD (X_THRESHOLD),HL
 LD HL,257
 LD (X_NEXT),HL
 LD L,(IX+AS_MEMBER+AM_OFFSET)
 LD H,(IX+AS_MEMBER+AM_OFFSET+1)
 LD C,(IX+AS_MEMBER+AM_OFFSET+2)
 LD B,(IX+AS_MEMBER+AM_OFFSET+3)
 LD A,L
 AND 127
 LD (X_SKIP),A
 LD A,7
X_OFFSET_SHIFT:
 SRL B
 RR C
 RR H
 RR L
 DEC A
 JR NZ,X_OFFSET_SHIFT
 LD (NR_INREC),HL
 LD A,C
 LD (NR_INREC+2),A
 LD HL,NR_LIMIT
 LD A,(X_SKIP)
 ADD A,(HL)
 LD (HL),A
 LD B,3
X_LIMIT_CARRY:
 INC HL
 LD A,(HL)
 ADC A,0
 LD (HL),A
 DJNZ X_LIMIT_CARRY
 JP C,X_BAD
X_SKIP_LOOP:
 LD A,(X_SKIP)
 OR A
 JR Z,X_HEADER
 CALL X_INPUT
 RET C
 LD HL,X_SKIP
 DEC (HL)
 JR X_SKIP_LOOP
X_HEADER:
 LD A,(X_METHOD)
 CP 8
 JR C,X_STATIC_INIT
 JR NZ,X_SQUASH_INIT
 CALL X_INPUT
 JR NC,X_HEADER_CHECK
 CP AS_END
 JP Z,X_TRUNC
 SCF
 RET
X_HEADER_CHECK:
 CP 12
 JR Z,X_DYNAMIC_INIT
 LD A,AS_UNSUPPORTED
 SCF
 RET
X_SQUASH_INIT:
 LD A,13
 LD (X_MAXBITS),A
 LD HL,8192
 LD (X_CAP),HL
X_DYNAMIC_INIT:
 LD HL,0
X_LITERAL_INIT:
 LD (X_WORK),HL
 LD DE,0FFFFH
 CALL X_PREFIX_SET
 LD HL,(X_WORK)
 LD A,L
 CALL X_SUFFIX_SET
 LD HL,(X_WORK)
 INC HL
 LD A,H
 OR A
 JR Z,X_LITERAL_INIT
 XOR A
 RET
X_STATIC_INIT:
 LD A,12
 LD (X_WIDTH),A
 LD HL,X_TABLE+8192
 LD (X_SUFFIX),HL
 LD HL,X_TABLE
 LD BC,4096
X_CLEAR_TABLE:
 LD (HL),0FEH
 INC HL
 LD (HL),0FFH
 INC HL
 DEC BC
 LD A,B
 OR C
 JR NZ,X_CLEAR_TABLE
 LD HL,X_CHAIN
 LD DE,X_CHAIN+1
 LD BC,8191
 LD (HL),0
 LDIR
X_ROOT_INIT:
 LD HL,0FFFFH
 LD A,(X_ROOT_BYTE)
 CALL X_HASH_ADD
 RET C
 LD HL,X_ROOT_BYTE
 INC (HL)
 JR NZ,X_ROOT_INIT
 XOR A
 RET
X_HEAD:
 OR A
 RET
X_RUN:
 CALL X_CODE_GET
 JR NC,X_GOT_CODE
 CP AS_END
 JP Z,X_FINISH
 SCF
 RET
X_GOT_CODE:
 LD (X_INCODE),HL
 LD A,(X_METHOD)
 CP 8
 JR C,X_DATA_CODE
 LD DE,256
 OR A
 SBC HL,DE
 JR NZ,X_DATA_CODE
 LD A,9
 LD (X_WIDTH),A
 XOR A
 LD (X_HAVE),A
 LD (X_GROUP_LEFT),A
 LD (X_BITLEFT),A
 INC A
 LD (X_NEED),A
 LD HL,257
 LD (X_NEXT),HL
 LD HL,512
 LD (X_THRESHOLD),HL
 JR X_RUN
X_DATA_CODE:
 LD HL,(X_INCODE)
 CALL X_USED
 LD B,A
 LD A,(X_HAVE)
 OR A
 JR NZ,X_CONTINUE
 LD A,B
 OR A
 JP Z,X_BAD
 LD HL,(X_INCODE)
 CALL X_PREFIX_GET
 LD A,D
 AND E
 CP 0FFH
 JP NZ,X_BAD
 CALL X_EMIT_CODE
 RET C
 LD A,1
 LD (X_HAVE),A
 XOR A
 LD (X_NEED),A
 JR X_REMEMBER
X_CONTINUE:
 LD A,B
 OR A
 JR Z,X_UNKNOWN
 CALL X_EMIT_CODE
 RET C
 CALL X_ADD
 RET C
 JR X_REMEMBER
X_UNKNOWN:
 CALL X_ADD
 RET C
 LD HL,(X_ADDED)
 LD DE,(X_INCODE)
 OR A
 SBC HL,DE
 JP NZ,X_BAD
 CALL X_EMIT_CODE
 RET C
X_REMEMBER:
 LD HL,(X_INCODE)
 LD (X_OLD),HL
 LD A,(X_METHOD)
 CP 8
 JP C,X_RUN
 LD A,(X_WIDTH)
 LD B,A
 LD A,(X_MAXBITS)
 CP B
 JP Z,X_RUN
 LD HL,(X_NEXT)
 LD DE,(X_THRESHOLD)
 OR A
 SBC HL,DE
 JP NZ,X_RUN
 LD HL,X_WIDTH
 INC (HL)
 EX DE,HL
 ADD HL,HL
 LD (X_THRESHOLD),HL
 XOR A
 LD (X_GROUP_LEFT),A
 LD (X_BITLEFT),A
 JP X_RUN
X_FINISH:
 LD A,(X_NEED)
 LD HL,X_PENDING
 OR (HL)
 JP NZ,X_TRUNC
 LD HL,NR_TOTAL
 LD DE,NH_CONTEXT+AS_MEMBER+AM_LENGTH
 LD B,4
X_LENGTH_CHECK:
 LD A,(DE)
 CP (HL)
 JP NZ,X_BAD
 INC HL
 INC DE
 DJNZ X_LENGTH_CHECK
 LD HL,(X_CRC)
 LD A,L
 CP (IX+AS_MEMBER+AM_CRC)
 JP NZ,X_CHECK
 LD A,H
 CP (IX+AS_MEMBER+AM_CRC+1)
 JP NZ,X_CHECK
 XOR A
 RET
; Read compressed bytes through the resident bounded reader, preserving scratch.
X_INPUT:
 PUSH BC
 PUSH DE
 PUSH HL
 CALL NR_READ
 POP HL
 POP DE
 POP BC
 RET NC
 OR A
 LD A,AS_END
 SCF
 RET Z
 LD A,(NH_ABORTED)
 OR A
 LD A,AS_CANCEL
 SCF
 RET NZ
 LD A,AS_IO
 SCF
 RET
; UNIX compress groups contain eight equal-width LSB codes, or a final short
; group. CLEAR/width changes discard the rest of their allocated group.
X_GROUP_LOAD:
 LD HL,X_GROUP
 XOR A
 LD (X_GROUP_BYTES),A
X_GROUP_READ:
 CALL X_INPUT
 JR C,X_GROUP_END
 LD (HL),A
 INC HL
 LD A,(X_GROUP_BYTES)
 INC A
 LD (X_GROUP_BYTES),A
 LD B,A
 LD A,(X_WIDTH)
 CP B
 JR NZ,X_GROUP_READ
 JR X_GROUP_COUNT
X_GROUP_END:
 CP AS_END
 JR Z,X_GROUP_COUNT
 SCF
 RET
X_GROUP_COUNT:
 LD A,(X_GROUP_BYTES)
 OR A
 JR NZ,X_GROUP_NONEMPTY
 LD A,AS_END
 SCF
 RET
X_GROUP_NONEMPTY:
 ADD A,A
 ADD A,A
 ADD A,A
 LD B,0
 LD HL,X_WIDTH
X_GROUP_DIV:
 CP (HL)
 JR C,X_GROUP_REMAINDER
 SUB (HL)
 INC B
 JR X_GROUP_DIV
X_GROUP_REMAINDER:
 CP 8
 JP NC,X_TRUNC
 LD A,B
 OR A
 JP Z,X_TRUNC
 LD (X_GROUP_LEFT),A
 XOR A
 LD (X_BITLEFT),A
 LD HL,X_GROUP
 LD (X_GROUP_PTR),HL
 RET
X_CODE_GET:
 LD A,(X_METHOD)
 CP 8
 JR C,X_CODE_START
 LD A,(X_GROUP_LEFT)
 OR A
 CALL Z,X_GROUP_LOAD
 RET C
X_CODE_START:
 XOR A
 LD (X_CODE_BITS),A
 LD HL,0
 LD DE,1
 LD A,(X_WIDTH)
 LD B,A
X_CODE_BIT:
 LD A,(X_BITLEFT)
 OR A
 JR NZ,X_CODE_HAS_BYTE
 PUSH BC
 PUSH DE
 PUSH HL
 LD A,(X_METHOD)
 CP 8
 JR C,X_CODE_RAW
 LD HL,(X_GROUP_PTR)
 LD A,(HL)
 INC HL
 LD (X_GROUP_PTR),HL
 OR A
 JR X_CODE_BYTE
X_CODE_RAW:
 CALL X_INPUT
X_CODE_BYTE:
 POP HL
 POP DE
 POP BC
 JR C,X_CODE_EOF
 LD (X_BITBYTE),A
 LD A,8
 LD (X_BITLEFT),A
X_CODE_HAS_BYTE:
 LD A,(X_BITLEFT)
 DEC A
 LD (X_BITLEFT),A
 LD A,(X_METHOD)
 CP 8
 JR NC,X_CODE_LSB
 ADD HL,HL
 LD A,(X_BITBYTE)
 ADD A,A
 LD (X_BITBYTE),A
 JR NC,X_CODE_NEXT
 INC L
 JR X_CODE_NEXT
X_CODE_LSB:
 LD A,(X_BITBYTE)
 SRL A
 LD (X_BITBYTE),A
 JR NC,X_CODE_MASK_SHIFT
 LD A,L
 OR E
 LD L,A
 LD A,H
 OR D
 LD H,A
X_CODE_MASK_SHIFT:
 SLA E
 RL D
X_CODE_NEXT:
 LD A,(X_CODE_BITS)
 INC A
 LD (X_CODE_BITS),A
 DJNZ X_CODE_BIT
 LD A,(X_METHOD)
 CP 8
 JR C,X_CODE_OK
 LD A,(X_GROUP_LEFT)
 DEC A
 LD (X_GROUP_LEFT),A
X_CODE_OK:
 OR A
 RET
X_CODE_EOF:
 CP AS_END
 JR Z,X_CODE_TAIL
 SCF
 RET
X_CODE_TAIL:
 LD A,(X_CODE_BITS)
 CP 8
 JP NC,X_TRUNC
 LD A,AS_END
 SCF
 RET
X_PREFIX_GET:
 ADD HL,HL
 LD DE,X_TABLE
 ADD HL,DE
 LD E,(HL)
 INC HL
 LD D,(HL)
 RET
X_PREFIX_SET:
 PUSH DE
 ADD HL,HL
 LD DE,X_TABLE
 ADD HL,DE
 POP DE
 LD (HL),E
 INC HL
 LD (HL),D
 RET
X_SUFFIX_GET:
 LD DE,(X_SUFFIX)
 ADD HL,DE
 LD A,(HL)
 RET
X_SUFFIX_SET:
 LD DE,(X_SUFFIX)
 ADD HL,DE
 LD (HL),A
 RET
X_USED:
 LD (X_WORK),HL
 LD A,(X_METHOD)
 CP 8
 JR C,X_USED_HASH
 LD DE,(X_NEXT)
 OR A
 SBC HL,DE
 JR NC,X_NOT_USED
 LD A,1
 OR A
 RET
X_USED_HASH:
 CALL X_PREFIX_GET
 LD A,D
 CP 0FFH
 JR NZ,X_YES_USED
 LD A,E
 CP 0FEH
 JR Z,X_NOT_USED
X_YES_USED:
 LD A,1
 OR A
 RET
X_NOT_USED:
 XOR A
 RET
X_ADD:
 LD A,(X_METHOD)
 CP 8
 JR C,X_ADD_HASH
 LD HL,(X_NEXT)
 LD DE,(X_CAP)
 OR A
 SBC HL,DE
 JR NC,X_ADD_FULL
 LD HL,(X_NEXT)
 LD (X_ADDED),HL
 LD DE,(X_OLD)
 CALL X_PREFIX_SET
 LD HL,(X_NEXT)
 LD A,(X_FIRST)
 CALL X_SUFFIX_SET
 LD HL,(X_NEXT)
 INC HL
 LD (X_NEXT),HL
 OR A
 RET
X_ADD_FULL:
 LD HL,0FFFFH
 LD (X_ADDED),HL
 OR A
 RET
X_ADD_HASH:
 LD HL,(X_COUNT)
 LD DE,4096
 OR A
 SBC HL,DE
 JR NC,X_ADD_FULL
 LD HL,(X_OLD)
 LD A,(X_FIRST)
 JP X_HASH_ADD
; Validate then reverse a phrase path. Restore each prefix as its byte is
; emitted. A failed pass discards the dictionary with the whole phase.
X_EMIT_CODE:
 LD HL,(X_INCODE)
 LD (X_WALK),HL
 LD HL,(X_CAP)
 LD (X_BUDGET),HL
X_VALIDATE_PATH:
 LD HL,(X_BUDGET)
 DEC HL
 LD (X_BUDGET),HL
 LD A,H
 OR L
 JP Z,X_BAD
 LD HL,(X_WALK)
 CALL X_PREFIX_GET
 LD A,D
 AND E
 CP 0FFH
 JR Z,X_FOUND_ROOT
 LD A,D
 CP 0FFH
 JP Z,X_BAD
 EX DE,HL
 LD (X_WALK),HL
 LD DE,(X_CAP)
 OR A
 SBC HL,DE
 JP NC,X_BAD
 JR X_VALIDATE_PATH
X_FOUND_ROOT:
 LD HL,(X_WALK)
 LD (X_ROOT),HL
 CALL X_SUFFIX_GET
 LD (X_FIRST),A
 LD HL,(X_INCODE)
 LD (X_WALK),HL
 LD HL,0FFFFH
 LD (X_REVERSE),HL
X_REVERSE_PATH:
 LD HL,(X_WALK)
 LD DE,(X_ROOT)
 OR A
 SBC HL,DE
 JR Z,X_EMIT_ROOT
 LD HL,(X_WALK)
 CALL X_PREFIX_GET
 LD (X_UP),DE
 LD HL,(X_WALK)
 LD DE,(X_REVERSE)
 CALL X_PREFIX_SET
 LD HL,(X_WALK)
 LD (X_REVERSE),HL
 LD HL,(X_UP)
 LD (X_WALK),HL
 JR X_REVERSE_PATH
X_EMIT_ROOT:
 LD A,(X_FIRST)
 CALL X_TOKEN
 RET C
 LD HL,(X_ROOT)
 LD (X_PARENT),HL
X_RESTORE_PATH:
 LD HL,(X_REVERSE)
 LD A,H
 AND L
 CP 0FFH
 RET Z
 CALL X_PREFIX_GET
 LD (X_LINK),DE
 LD HL,(X_REVERSE)
 LD DE,(X_PARENT)
 CALL X_PREFIX_SET
 LD HL,(X_REVERSE)
 CALL X_SUFFIX_GET
 CALL X_TOKEN
 RET C
 LD HL,(X_REVERSE)
 LD (X_PARENT),HL
 LD HL,(X_LINK)
 LD (X_REVERSE),HL
 JR X_RESTORE_PATH
; Hash allocation: original squared middle bits (5/6), multiplier (7).
X_HASH_ADD:
 LD (X_NEW_PREFIX),HL
 LD (X_NEW_BYTE),A
 LD E,A
 LD D,0
 ADD HL,DE
 LD A,(X_METHOD)
 CP 7
 JR Z,X_NEW_HASH
 SET 3,H
 LD D,H
 LD E,L
 CALL X_MULTIPLY
 LD B,6
X_SQUARE_SHIFT:
 LD HL,X_PRODUCT+3
 SRL (HL)
 DEC HL
 RR (HL)
 DEC HL
 RR (HL)
 DEC HL
 RR (HL)
 DJNZ X_SQUARE_SHIFT
 JR X_HASH_RESULT
X_NEW_HASH:
 LD DE,15073
 CALL X_MULTIPLY
X_HASH_RESULT:
 LD HL,(X_PRODUCT)
 LD A,H
 AND 15
 LD H,A
 LD (X_SLOT),HL
 CALL X_PREFIX_GET
 LD A,D
 CP 0FFH
 JR NZ,X_COLLISION
 LD A,E
 CP 0FEH
 JR Z,X_HASH_STORE
X_COLLISION:
 LD HL,4096
 LD (X_BUDGET),HL
X_CHAIN_FOLLOW:
 LD HL,(X_BUDGET)
 DEC HL
 LD (X_BUDGET),HL
 LD A,H
 OR L
 JP Z,X_BAD
 LD HL,(X_SLOT)
 ADD HL,HL
 LD DE,X_CHAIN
 ADD HL,DE
 LD E,(HL)
 INC HL
 LD D,(HL)
 LD A,D
 OR E
 JR Z,X_CHAIN_END
 LD (X_SLOT),DE
 JR X_CHAIN_FOLLOW
X_CHAIN_END:
 LD HL,(X_SLOT)
 LD (X_TAIL),HL
 LD DE,101
 ADD HL,DE
X_PROBE:
 LD A,H
 AND 15
 LD H,A
 LD (X_SLOT),HL
 CALL X_PREFIX_GET
 LD A,D
 CP 0FFH
 JR NZ,X_PROBE_NEXT
 LD A,E
 CP 0FEH
 JR Z,X_CHAIN_APPEND
X_PROBE_NEXT:
 LD HL,(X_BUDGET)
 DEC HL
 LD (X_BUDGET),HL
 LD A,H
 OR L
 JP Z,X_BAD
 LD HL,(X_SLOT)
 INC HL
 JR X_PROBE
X_CHAIN_APPEND:
 LD HL,(X_TAIL)
 ADD HL,HL
 LD DE,X_CHAIN
 ADD HL,DE
 LD DE,(X_SLOT)
 LD (HL),E
 INC HL
 LD (HL),D
X_HASH_STORE:
 LD HL,(X_SLOT)
 LD (X_ADDED),HL
 LD DE,(X_NEW_PREFIX)
 CALL X_PREFIX_SET
 LD HL,(X_SLOT)
 LD A,(X_NEW_BYTE)
 CALL X_SUFFIX_SET
 LD HL,(X_SLOT)
 ADD HL,HL
 LD DE,X_CHAIN
 ADD HL,DE
 LD (HL),0
 INC HL
 LD (HL),0
 LD HL,(X_COUNT)
 INC HL
 LD (X_COUNT),HL
 OR A
 RET
X_MULTIPLY:
 LD (X_MULTIPLIER),DE
 LD (X_MULTIPLICAND),HL
 XOR A
 LD (X_MULTIPLICAND+2),A
 LD (X_MULTIPLICAND+3),A
 LD HL,X_PRODUCT
 LD (HL),A
 INC HL
 LD (HL),A
 INC HL
 LD (HL),A
 INC HL
 LD (HL),A
 LD B,16
X_MUL_LOOP:
 LD HL,X_MULTIPLIER+1
 SRL (HL)
 DEC HL
 RR (HL)
 JR NC,X_MUL_SHIFT
 PUSH BC
 LD HL,X_MULTIPLICAND
 LD DE,X_PRODUCT
 LD B,4
 OR A
X_MUL_ADD:
 LD A,(DE)
 ADC A,(HL)
 LD (DE),A
 INC DE
 INC HL
 DJNZ X_MUL_ADD
 POP BC
X_MUL_SHIFT:
 LD HL,X_MULTIPLICAND
 SLA (HL)
 INC HL
 RL (HL)
 INC HL
 RL (HL)
 INC HL
 RL (HL)
 DJNZ X_MUL_LOOP
 RET
; Optional RLE stage: methods 5/9 emit LZW bytes directly.
X_TOKEN:
 LD (X_TOKEN_BYTE),A
 LD A,(X_METHOD)
 CP 5
 JR Z,X_DIRECT
 CP 9
 JR Z,X_DIRECT
 LD A,(X_PENDING)
 OR A
 JR Z,X_RLE_NORMAL
 XOR A
 LD (X_PENDING),A
 LD A,(X_TOKEN_BYTE)
 OR A
 JR Z,X_RLE_ESCAPE
 LD HL,X_RLE_HAVE
 LD A,(HL)
 OR A
 JP Z,X_BAD
 LD A,(X_TOKEN_BYTE)
 DEC A
 LD (X_REPEAT),A
X_RLE_REPEAT:
 LD A,(X_REPEAT)
 OR A
 RET Z
 DEC A
 LD (X_REPEAT),A
 LD A,(X_LAST)
 CALL X_WRITE
 RET C
 JR X_RLE_REPEAT
X_RLE_ESCAPE:
 LD A,90H
 JR X_RLE_LITERAL
X_RLE_NORMAL:
 LD A,(X_TOKEN_BYTE)
 CP 90H
 JR NZ,X_RLE_LITERAL
 LD A,1
 LD (X_PENDING),A
 OR A
 RET
X_RLE_LITERAL:
 LD (X_LAST),A
 LD HL,X_RLE_HAVE
 LD (HL),1
 JP X_WRITE
X_DIRECT:
 LD A,(X_TOKEN_BYTE)
X_WRITE:
 PUSH BC
 PUSH DE
 PUSH HL
 LD (X_BYTE),A
 LD HL,NR_TOTAL
 LD DE,NH_CONTEXT+AS_MEMBER+AM_LENGTH
 LD B,4
X_OUTPUT_LIMIT:
 LD A,(DE)
 CP (HL)
 JR NZ,X_OUTPUT_ALLOWED
 INC HL
 INC DE
 DJNZ X_OUTPUT_LIMIT
 LD A,AS_FORMAT
 SCF
 JR X_WRITE_RETURN
X_OUTPUT_ALLOWED:
 LD A,(X_BYTE)
 LD HL,X_CRC
 XOR (HL)
 LD (HL),A
 LD B,8
X_CRC_BIT:
 LD HL,X_CRC+1
 SRL (HL)
 DEC HL
 RR (HL)
 JR NC,X_CRC_NEXT
 LD A,(HL)
 XOR 1
 LD (HL),A
 INC HL
 LD A,(HL)
 XOR 0A0H
 LD (HL),A
X_CRC_NEXT:
 DJNZ X_CRC_BIT
 LD A,(X_BYTE)
 CALL NR_WRITE
 JR NC,X_WRITE_RETURN
 LD A,(NH_ABORTED)
 OR A
 LD A,AS_CANCEL
 SCF
 JR NZ,X_WRITE_RETURN
 LD A,AS_OUTPUT
 SCF
X_WRITE_RETURN:
 POP HL
 POP DE
 POP BC
 RET
X_BAD:
 LD A,AS_FORMAT
 SCF
 RET
X_TRUNC:
 LD A,AS_TRUNC
 SCF
 RET
X_CHECK:
 LD A,AS_CHECK
 SCF
 RET
X_DATA:
X_METHOD: DB 0
X_MAXBITS: DB 0
X_WIDTH: DB 0
X_SKIP: DB 0
X_HAVE: DB 0
X_NEED: DB 0
X_FIRST: DB 0
X_ROOT_BYTE: DB 0
X_PENDING: DB 0
X_RLE_HAVE: DB 0
X_LAST: DB 0
X_REPEAT: DB 0
X_TOKEN_BYTE: DB 0
X_BYTE: DB 0
X_BITBYTE: DB 0
X_BITLEFT: DB 0
X_CODE_BITS: DB 0
X_GROUP_BYTES: DB 0
X_GROUP_LEFT: DB 0
X_GROUP_PTR: DW 0
X_GROUP: DS 13
X_SUFFIX: DW 0
X_CAP: DW 0
X_NEXT: DW 0
X_COUNT: DW 0
X_THRESHOLD: DW 0
X_INCODE: DW 0
X_OLD: DW 0
X_ADDED: DW 0
X_WORK: DW 0
X_WALK: DW 0
X_ROOT: DW 0
X_PARENT: DW 0
X_REVERSE: DW 0
X_UP: DW 0
X_LINK: DW 0
X_BUDGET: DW 0
X_NEW_PREFIX: DW 0
X_NEW_BYTE: DB 0
X_SLOT: DW 0
X_TAIL: DW 0
X_CRC: DW 0
X_MULTIPLIER: DW 0
X_MULTIPLICAND: DS 4
X_PRODUCT: DS 4
X_DATA_END:
