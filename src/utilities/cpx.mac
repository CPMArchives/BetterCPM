; BetterCP/M CPX transient manager, proof interface.

BDOS            EQU     0005H
CMDLEN          EQU     0080H
CMDDATA         EQU     0081H
CPXFUNC         EQU     200

        CSEG
        .PHASE  0103H

START:
        LD      A,(CMDLEN)
        LD      B,A
        LD      HL,CMDDATA
SKIPSPACE:
        LD      A,B
        OR      A
        JR      Z,USAGE
        LD      A,(HL)
        CP      ' '
        JR      NZ,HAVELEN
        INC     HL
        DEC     B
        JR      SKIPSPACE
HAVELEN:
        LD      A,B
        CP      4
        JR      Z,TRYLIST
        CP      10
        JR      Z,TRYLOAD
        CP      12
        JR      Z,TRYUNLOAD
USAGE:
        LD      DE,USEMSG
        CALL    PRINT
        JR      DONE
TRYLIST:
        LD      DE,KLIST
        LD      B,4
        CALL    EQUAL
        JR      NZ,USAGE
        LD      E,0
        LD      C,CPXFUNC
        CALL    BDOS
        OR      A
        JR      Z,LISTNONE
        CP      1
        JR      NZ,LISTBAD
        LD      DE,LISTBASIC
        CALL    PRINT
        JR      LISTTPA
LISTNONE:
        LD      DE,LISTEMPTY
        CALL    PRINT
LISTTPA:
        CALL    PRINTTPA
        JR      DONE
LISTBAD:
        LD      DE,LISTERROR
        CALL    PRINT
        JR      DONE
TRYLOAD:
        LD      DE,KLOAD
        LD      B,10
        CALL    EQUAL
        JR      NZ,USAGE
        LD      E,1
        JR      CHANGE
TRYUNLOAD:
        LD      DE,KUNLOAD
        LD      B,12
        CALL    EQUAL
        JR      NZ,USAGE
        LD      E,2
CHANGE:
        LD      C,CPXFUNC
        CALL    BDOS
        OR      A
        JR      NZ,LISTBAD
DONE:
        LD      C,0
        JP      BDOS

EQUAL:
        LD      A,(DE)
        CP      (HL)
        RET     NZ
        INC     DE
        INC     HL
        DJNZ    EQUAL
        RET
PRINT:
        LD      C,9
        JP      BDOS

; The word at 0006h is the exclusive top of the transient region. Report
; whole kilobytes available from the conventional 0100h program origin.
PRINTTPA:
        LD      HL,(0006H)
        LD      DE,0100H
        OR      A
        SBC     HL,DE
        LD      A,H             ; floor(HL / 1024) = high byte / 4
        RRCA
        RRCA
        AND     03FH
        LD      B,0
PT_DIV10:
        CP      10
        JR      C,PT_DIGITS
        SUB     10
        INC     B
        JR      PT_DIV10
PT_DIGITS:
        LD      (PT_UNITS),A
        LD      A,B
        LD      (PT_TENS),A
        LD      DE,TPAMSG
        CALL    PRINT
        LD      A,(PT_TENS)
        OR      A
        JR      Z,PT_UNIT
        ADD     A,'0'
        LD      E,A
        LD      C,2
        CALL    BDOS
PT_UNIT:
        LD      A,(PT_UNITS)
        ADD     A,'0'
        LD      E,A
        LD      C,2
        CALL    BDOS
        LD      DE,TPAEND
        JP      PRINT

KLIST:          DB      'LIST'
KLOAD:          DB      'LOAD BASIC'
KUNLOAD:        DB      'UNLOAD BASIC'
LISTBASIC:      DB      13,10,'BASIC : DIR, ERA, TYPE, REN',13,10,'$'
LISTEMPTY:      DB      13,10,'No CPXs loaded',13,10,'$'
LISTERROR:      DB      13,10,'CPX profile error',13,10,'$'
USEMSG:         DB      13,10,'CPX LIST | LOAD BASIC | UNLOAD BASIC',13,10,'$'
TPAMSG:         DB      'TPA available: $'
TPAEND:         DB      'K',13,10,'$'
PT_TENS:        DB      0
PT_UNITS:       DB      0

        .DEPHASE
        END     START
