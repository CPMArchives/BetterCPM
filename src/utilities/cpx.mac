; BetterCP/M CPX transient manager, proof interface.

BDOS            EQU     0005H
CMDLEN          EQU     0080H
CMDDATA         EQU     0081H
CPXFUNC         EQU     200

        CSEG
        .PHASE  0103H

START:
        LD      A,(CMDLEN)
        LD      B,A
        LD      HL,CMDDATA
SKIPSPACE:
        LD      A,B
        OR      A
        JR      Z,USAGE
        LD      A,(HL)
        CP      ' '
        JR      NZ,HAVELEN
        INC     HL
        DEC     B
        JR      SKIPSPACE
HAVELEN:
        LD      (ARGSTART),HL
        LD      A,B
        LD      (TOTLEN),A
        CP      4
        JR      Z,TRYLIST
        CP      10
        JR      Z,TRYLOAD
        CP      14
        JR      Z,TRYLOAD
        CP      12
        JP      Z,TRYUNLOAD
        CP      16
        JP      Z,TRYUNLOAD
USAGE:
        LD      DE,USEMSG
        CALL    PRINT
        JP      DONE
TRYLIST:
        LD      HL,(ARGSTART)
        LD      DE,KLIST
        LD      B,4
        CALL    EQUAL
        JP      NZ,USAGE
        XOR     A
        LD      (LIST_ANY),A
        LD      D,1
        LD      E,0
        LD      C,CPXFUNC
        CALL    BDOS
        CP      0FFH
        JR      Z,LISTBAD
        OR      A
        JR      Z,LSTHCHK
        LD      DE,LISTBASIC
        CALL    PRINT
        LD      A,1
        LD      (LIST_ANY),A
LSTHCHK:
        LD      D,2
        LD      E,0
        LD      C,CPXFUNC
        CALL    BDOS
        CP      0FFH
        JR      Z,LISTBAD
        OR      A
        JR      Z,LISTCHECK
        LD      DE,LSTHMSG
        CALL    PRINT
        LD      A,1
        LD      (LIST_ANY),A
LISTCHECK:
        LD      A,(LIST_ANY)
        OR      A
        JR      NZ,LISTTPA
LISTNONE:
        LD      DE,LISTEMPTY
        CALL    PRINT
LISTTPA:
        CALL    PRINTTPA
        JP      DONE
LISTBAD:
        LD      DE,LISTERROR
        CALL    PRINT
        JP      DONE
TRYLOAD:
        LD      HL,(ARGSTART)
        LD      DE,KLOADB
        LD      B,10
        CALL    EQUAL
        JR      Z,LOADBASIC
        LD      HL,(ARGSTART)
        LD      DE,KLOADH
        LD      B,10
        CALL    EQUAL
        JP      NZ,USAGE
        LD      A,2
        JR      LOADNAME
LOADBASIC:
        LD      A,1
LOADNAME:
        LD      (MODSEL),A
        LD      A,(TOTLEN)
        CP      10
        JR      Z,LOADREADY
        LD      HL,(ARGSTART)
        LD      BC,10
        ADD     HL,BC
        LD      DE,KCPX
        LD      B,4
        CALL    EQUAL
        JP      NZ,USAGE
LOADREADY:
        LD      A,(MODSEL)
        LD      D,A
        LD      E,1
        JR      CHANGE
TRYUNLOAD:
        LD      HL,(ARGSTART)
        LD      DE,KUNLOADB
        LD      B,12
        CALL    EQUAL
        JR      Z,UNLOADBASIC
        LD      HL,(ARGSTART)
        LD      DE,KUNLOADH
        LD      B,12
        CALL    EQUAL
        JP      NZ,USAGE
        LD      A,2
        JR      UNLOADNAME
UNLOADBASIC:
        LD      A,1
UNLOADNAME:
        LD      (MODSEL),A
        LD      A,(TOTLEN)
        CP      12
        JR      Z,UNLOADREADY
        LD      HL,(ARGSTART)
        LD      BC,12
        ADD     HL,BC
        LD      DE,KCPX
        LD      B,4
        CALL    EQUAL
        JP      NZ,USAGE
UNLOADREADY:
        LD      A,(MODSEL)
        LD      D,A
        LD      E,2
CHANGE:
        LD      C,CPXFUNC
        CALL    BDOS
        OR      A
        JP      NZ,LISTBAD
DONE:
        LD      C,0
        JP      BDOS

EQUAL:
        LD      A,(DE)
        CP      (HL)
        RET     NZ
        INC     DE
        INC     HL
        DJNZ    EQUAL
        RET
PRINT:
        LD      C,9
        JP      BDOS

; The word at 0006h is the exclusive top of the transient region. Report
; whole kilobytes available from the conventional 0100h program origin.
PRINTTPA:
        LD      HL,(0006H)
        LD      DE,0100H
        OR      A
        SBC     HL,DE
        LD      A,H             ; floor(HL / 1024) = high byte / 4
        RRCA
        RRCA
        AND     03FH
        LD      B,0
PT_DIV10:
        CP      10
        JR      C,PT_DIGITS
        SUB     10
        INC     B
        JR      PT_DIV10
PT_DIGITS:
        LD      (PT_UNITS),A
        LD      A,B
        LD      (PT_TENS),A
        LD      DE,TPAMSG
        CALL    PRINT
        LD      A,(PT_TENS)
        OR      A
        JR      Z,PT_UNIT
        ADD     A,'0'
        LD      E,A
        LD      C,2
        CALL    BDOS
PT_UNIT:
        LD      A,(PT_UNITS)
        ADD     A,'0'
        LD      E,A
        LD      C,2
        CALL    BDOS
        LD      DE,TPAEND
        JP      PRINT

KLIST:          DB      'LIST'
KLOADB:         DB      'LOAD BASIC'
KLOADH:         DB      'LOAD HELLO'
KUNLOADB:       DB      'UNLOAD BASIC'
KUNLOADH:       DB      'UNLOAD HELLO'
KCPX:           DB      '.CPX'
LISTBASIC:      DB      13,10,'BASIC : DIR, ERA, TYPE, REN, SAVE, USER, CLR, VER',13,10,'$'
LSTHMSG:        DB      'HELLO : HELLO',13,10,'$'
LISTEMPTY:      DB      13,10,'No CPXs loaded',13,10,'$'
LISTERROR:      DB      13,10,'CPX profile error',13,10,'$'
USEMSG:         DB      13,10,'CPX LIST | LOAD/UNLOAD BASIC/HELLO',13,10,'$'
TPAMSG:         DB      'TPA available: $'
TPAEND:         DB      'K',13,10,'$'
PT_TENS:        DB      0
PT_UNITS:       DB      0
ARGSTART:       DW      0
TOTLEN:         DB      0
MODSEL:         DB      0
LIST_ANY:       DB      0

        .DEPHASE
        END     START
