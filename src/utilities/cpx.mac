; ********************************************************************************
; *                        BetterCP/M CPX Utility                                *
; *                                                                              *
; * Transient proof manager for the command-processor extension profile. Parses  *
; * LIST, LOAD, UNLOAD, and version requests, invokes the protected CPX control  *
; * service, and reports the resulting transient-program-area size.              *
; ********************************************************************************


BDOS            EQU     0005H
CMDLEN          EQU     0080H
CMDDATA         EQU     0081H
CPXFUNC         EQU     176
FCB2            EQU     006CH

        CSEG
        .PHASE  0103H

; ================================================================================
; =                         Command Parsing and Dispatch                         =
; =                                                                              =
; = Parses the transient command tail, recognizes CPX manager operations, and    =
; = routes accepted commands to list, load, unload, or version handling.         =
; ================================================================================
; -------------------------------------------------------------------------------
; Command-Tail Parse
; -------------------------------------------------------------------------------

START:                                  ; enter CPX manager
        LD      A,(CMDLEN)
        LD      B,A
        LD      HL,CMDDATA

SKIPSPACE:                              ; skip leading command-tail spaces
        LD      A,B
        OR      A
        JR      Z,USAGE
        LD      A,(HL)
        CP      ' '
        JR      NZ,HAVELEN
        INC     HL
        DEC     B
        JR      SKIPSPACE

HAVELEN:                                ; dispatch parsed command
        LD      (ARGSTART),HL
        LD      A,B
        LD      (TOTLEN),A
        CP      2
        JR      Z,TRYVERS
        CP      4
        JR      Z,TRYLIST
        CP      6
        JR      C,USAGE
        LD      HL,(ARGSTART)
        LD      DE,KLOAD
        LD      B,5
        CALL    EQUAL
        JP      Z,TRYLOAD
        LD      A,(TOTLEN)
        CP      8
        JR      C,USAGE
        LD      HL,(ARGSTART)
        LD      DE,KUNLOAD
        LD      B,7
        CALL    EQUAL
        JP      Z,TRYUNLOAD

USAGE:                                  ; print CPX usage
        LD      DE,USEMSG
        CALL    PRINT
        JP      DONE

; -------------------------------------------------------------------------------
; Version Request
; -------------------------------------------------------------------------------

TRYVERS:                                ; try version command
        LD      A,(HL)
        CP      '/'
        JR      NZ,USAGE
        INC     HL
        LD      A,(HL)
        CP      'V'
        JR      NZ,USAGE
        LD      DE,CX_VERSION
        CALL    PRINT
        JP      DONE

; ================================================================================
; =                             CPX Profile Listing                              =
; =                                                                              =
; = Enumerates installed CPX names through Function 176 and prints the active    =
; = resulting TPA size.                                                          =
; ================================================================================
; -------------------------------------------------------------------------------
; Profile Query
; -------------------------------------------------------------------------------

TRYLIST:                                ; try list command
        LD      HL,(ARGSTART)
        LD      DE,KLIST
        LD      B,4
        CALL    EQUAL
        JP      NZ,USAGE
        LD      HL,REQUEST
        LD      (HL),1
        INC     HL
        XOR     A
        LD      (HL),A                  ; enumerate operation
        INC     HL
        LD      (HL),A                  ; first index
        LD      (LIST_ANY),A

LISTNEXT:                               ; request next ordered profile name
        LD      DE,REQUEST
        LD      C,CPXFUNC
        CALL    BDOS
        CP      0FFH
        JR      Z,LISTBAD
        OR      A
        JR      Z,LISTCHECK
        CALL    PRINTNAME
        LD      A,1
        LD      (LIST_ANY),A
        LD      HL,REQUEST+2
        INC     (HL)
        JR      LISTNEXT

; -------------------------------------------------------------------------------
; List Completion
; -------------------------------------------------------------------------------

LISTCHECK:                              ; finish CPX list query
        LD      A,(LIST_ANY)
        OR      A
        JR      NZ,LISTTPA

LISTNONE:                               ; report empty CPX profile
        LD      DE,LISTEMPTY
        CALL    PRINT

LISTTPA:                                ; report TPA after list
        CALL    PRINTTPA
        JP      DONE

LISTBAD:                                ; report CPX query failure
        LD      DE,LISTERROR
        CALL    PRINT
        JP      DONE

; ================================================================================
; =                                   CPX Load                                   =
; =                                                                              =
; = Validates the CCP-normalized second default FCB and submits a name-based CPX  =
; = profile-load operation.                                                      =
; ================================================================================
; -------------------------------------------------------------------------------
; Load Request
; -------------------------------------------------------------------------------

TRYLOAD:                                ; try load command
        LD      A,1
        JR      PREPCHANGE

; ================================================================================
; =                                  CPX Unload                                  =
; =                                                                              =
; = Validates the CCP-normalized second default FCB and submits a name-based CPX  =
; = profile-unload operation.                                                    =
; ================================================================================
; -------------------------------------------------------------------------------
; Unload Request
; -------------------------------------------------------------------------------

TRYUNLOAD:                              ; try unload command
        LD      A,2

PREPCHANGE:                             ; validate and construct mutation request
        LD      (REQUEST+1),A
        CALL    PREPNAME
        JP      C,USAGE

; -------------------------------------------------------------------------------
; Profile Change
; -------------------------------------------------------------------------------

CHANGE:                                 ; perform CPX profile change
        LD      DE,REQUEST
        LD      C,CPXFUNC
        CALL    BDOS
        OR      A
        JP      NZ,LISTBAD

DONE:                                   ; return to CCP
        LD      C,0
        JP      BDOS

; -------------------------------------------------------------------------------
; Normalized CPX Name
; -------------------------------------------------------------------------------

PREPNAME:                               ; validate second FCB and copy stem
        LD      A,(FCB2)
        OR      A                       ; persistent profiles are not drive-qualified
        JR      NZ,PN_BAD
        LD      HL,FCB2+1
        LD      DE,REQUEST+4
        LD      B,8
        LD      A,(HL)
        CP      ' '
        JR      Z,PN_BAD

PN_COPY:                                ; copy normalized non-wildcard stem
        LD      A,(HL)
        CP      '?'
        JR      Z,PN_BAD
        LD      (DE),A
        INC     HL
        INC     DE
        DJNZ    PN_COPY
        LD      HL,FCB2+9
        LD      A,(HL)
        CP      ' '
        JR      Z,PN_SPACE
        LD      DE,KEXT
        LD      B,3
        CALL    EQUAL
        JR      NZ,PN_BAD
        JR      PN_OK

PN_SPACE:                               ; require an entirely blank extension
        INC     HL
        LD      A,(HL)
        CP      ' '
        JR      NZ,PN_BAD
        INC     HL
        LD      A,(HL)
        CP      ' '
        JR      NZ,PN_BAD

PN_OK:                                  ; initialize remaining request fields
        LD      HL,REQUEST
        LD      (HL),1
        INC     HL
        INC     HL
        LD      (HL),0
        INC     HL
        LD      (HL),0
        OR      A                       ; clear carry
        RET

PN_BAD:                                 ; reject malformed default FCB
        SCF
        RET

; -------------------------------------------------------------------------------
; Keyword Match
; -------------------------------------------------------------------------------

EQUAL:                                  ; compare command keyword
        LD      A,(DE)
        CP      (HL)
        RET     NZ
        INC     DE
        INC     HL
        DJNZ    EQUAL
        RET

PRINT:                                  ; print $-terminated string
        LD      C,9
        JP      BDOS

PRINTNAME:                              ; print returned stem and CPX extension
        LD      HL,REQUEST+4
        LD      B,8

PNM_LOOP:                               ; print until stem padding
        LD      A,(HL)
        CP      ' '
        JR      Z,PNM_DONE
        PUSH    BC
        PUSH    HL
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     HL
        POP     BC
        INC     HL
        DJNZ    PNM_LOOP

PNM_DONE:                               ; append conventional extension
        LD      DE,CPXEND
        JP      PRINT

  ; The word at 0006h is the exclusive top of the transient region. Report
  ; whole kilobytes available from the conventional 0100h program origin.

; ================================================================================
; =                                TPA Reporting                                 =
; =                                                                              =
; = Reads the exclusive transient-region limit at 0006H and reports whole        =
; = kilobytes available above the conventional 0100H program origin.             =
; ================================================================================
; -------------------------------------------------------------------------------
; TPA Size Conversion
; -------------------------------------------------------------------------------

PRINTTPA:                               ; print current TPA size
        LD      HL,(0006H)
        LD      DE,0100H
        OR      A
        SBC     HL,DE
        LD      A,H                     ; floor(HL / 1024) = high byte / 4
        RRCA
        RRCA
        AND     03FH
        LD      B,0

PT_DIV10:                               ; convert TPA kilobytes to decimal
        CP      10
        JR      C,PT_DIGITS
        SUB     10
        INC     B
        JR      PT_DIV10

PT_DIGITS:                              ; emit decimal TPA digits
        LD      (PT_UNITS),A
        LD      A,B
        LD      (PT_TENS),A
        LD      DE,TPAMSG
        CALL    PRINT
        LD      A,(PT_TENS)
        OR      A
        JR      Z,PT_UNIT
        ADD     A,'0'
        LD      E,A
        LD      C,2
        CALL    BDOS

PT_UNIT:                                ; print kilobyte suffix
        LD      A,(PT_UNITS)
        ADD     A,'0'
        LD      E,A
        LD      C,2
        CALL    BDOS
        LD      DE,TPAEND
        JP      PRINT

; ================================================================================
; =                            Utility Data and State                            =
; =                                                                              =
; = Defines command keywords, messages, decimal-conversion scratch, and parsed   =
; = command state used by the transient CPX manager.                             =
; ================================================================================
; -------------------------------------------------------------------------------
; Keywords and Messages
; -------------------------------------------------------------------------------

KLIST:          DB      'LIST'          ; LIST keyword
KLOAD:          DB      'LOAD '         ; LOAD keyword and separator
KUNLOAD:        DB      'UNLOAD '       ; UNLOAD keyword and separator
KEXT:           DB      'CPX'           ; accepted explicit extension
CPXEND:         DB      '.CPX',13,10,'$' ; displayed profile suffix
LISTEMPTY:      DB      13,10,'No CPXs loaded',13,10,'$' ; empty-profile text
LISTERROR:      DB      13,10,'CPX profile error',13,10,'$' ; list-error message
USEMSG:         DB      13,10,'CPX LIST | LOAD/UNLOAD name[.CPX]',13,10,'$' ; usage message
TPAMSG:         DB      'TPA available: $' ; TPA prefix
TPAEND:         DB      'K',13,10,'$'   ; TPA suffix

; -------------------------------------------------------------------------------
; Working State
; -------------------------------------------------------------------------------

PT_TENS:        DB      0               ; decimal tens scratch
PT_UNITS:       DB      0               ; decimal units scratch
ARGSTART:       DW      0               ; command argument pointer
TOTLEN:         DB      0               ; command-tail length
LIST_ANY:       DB      0               ; profile-nonempty flag
REQUEST:        DB      1,0,0,0         ; Function-176 v1 request envelope
                DB      '        '      ; normalized CPX stem

        INCLUDE cpxvers.inc

        .DEPHASE
        END     START
