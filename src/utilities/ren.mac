; BetterCP/M transient REN: shared source selection and in-place templates.
; Initial core increment; richer prompt/reporting modes follow separately.
BDOS EQU 5
BC_DMA EQU 80H
        CSEG
        .PHASE  0103H
START:
        LD SP,R_STKTOP
        CALL UV_CHECK
        LD HL,81H
        LD A,(80H)
        LD B,A
        ; Normalize command text exactly as CCP normally does.
        PUSH HL
        PUSH BC
R_CASE:
        LD A,B
        OR A
        JR Z,R_CASEEND
        LD A,(HL)
        CP 'a'
        JR C,R_CASEADV
        CP 'z'+1
        JR NC,R_CASEADV
        AND 5FH
        LD (HL),A
R_CASEADV:
        INC HL
        DJNZ R_CASE
R_CASEEND:
        POP BC
        POP HL
        CALL RE_CAPTURE
        CALL R_OPTIONS
        JP C,BC_DBAD
        LD A,(R_QUIET)
        CP 2
        JR NZ,R_RUN
        LD A,(R_DRY)
        OR A
        JR NZ,R_RUN
        LD A,(R_YEXPLICIT)
        OR A
        JR NZ,R_RUN
        LD DE,R_QNOTICE
        PUSH HL
        PUSH BC
        LD C,9
        CALL BDOS
        POP BC
        POP HL
R_RUN:
        CALL BC_REN
        CALL R_SUMMARY
        JP 0
BC_DBAD:
        LD DE,R_BADMSG
        JP BC_RPRINT
BC_BDERR:
        LD DE,R_DUMSG
        JP BC_RPRINT
BC_DURST:
        LD A,(BC_DSAVE)
        LD E,A
        LD C,14
        CALL BDOS
        LD A,(BC_USAVE)
        LD E,A
        LD C,32
        JP BDOS
BC_PRINT:
        LD A,(R_QUIET)
        CP 2
        RET Z
        LD C,9
        JP BDOS
; @ren-selector@
; @utility-version REN@
BC_DSAVE: DB 0
BC_USAVE: DB 0
BC_DIREP: DW 0
BC_ALL: DB '*.*'
BC_INPTR: DW 0
BC_INLEN: DB 0
BC_FCBPTR: DW 0
BC_REXMSG: DB 13,10,'FILE EXISTS',13,10,'$'
BC_NOFILE: DB 13,10,'NO FILE',13,10,'$'
R_BADMSG: DB 13,10,'Invalid filespec.',13,10,'$'
R_DUMSG: DB 13,10,'Invalid drive.',13,10,'$'
; @ren-workflow@
        DS 128
R_STKTOP:
R_HEAP:
        .DEPHASE
        END START
