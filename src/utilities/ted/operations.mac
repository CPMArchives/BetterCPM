 call TW_LOAD
 jp c,OP_APPEND_LOAD_FAILED
 ld hl,TW_DOC
 ld de,OP_APPEND_CONTEXT
 ld bc,187
 ldir
 call OP_RESTORE_CONTEXT
 ld hl,OP_APPEND_CONTEXT
 ld de,TW_INPUT
 call OP_COPY37
 ld hl,TW_INPUT
 call TS_CAPTURE
 jp c,OP_APPEND_CLEAN_FAILURE
 ld hl,TS_LAST
 ld de,TW_INPUT_TAG
 ld bc,22
 ldir
 ld a,1
 ld (TW_INPUT_BOUND),a
 ld hl,(OP_APPEND_CONTEXT+37+15)
 inc hl
 ld (TW_INPUT_REC),hl
 ld hl,OP_APPEND_CONTEXT+37+12
 ld de,TW_INPUT_LEN
 call TC_COPY3
