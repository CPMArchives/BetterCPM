 ; Regenerated append output must never read a target renamed during S5/S6.
 ld hl,TS_TARGET
 ld de,OP_APPEND_TARGET
 call OP_COPY37
 ld a,(TS_REPLACE)
 ld (OP_APPEND_FLAGS),a
 ld a,(TS_PROTECT)
 ld (OP_APPEND_FLAGS+1),a
 ld hl,TW_DOC
 ld de,OP_DOC_CONTEXT
 ld bc,187
 ldir
 ld a,(TW_OWN)
 ld (OP_DOC_OWN),a
 xor a
 ld (TW_OWN),a
 ld hl,OP_APPEND_TARGET
 ld de,TW_INPUT
