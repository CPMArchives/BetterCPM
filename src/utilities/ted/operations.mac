 ld de,TW_DOC
 ld bc,187
 ldir
 ld a,1
 ld (TW_OWN),a
 call TW_RELEASE
 push af
 call OP_RESTORE_CONTEXT
 pop af
 ret

OP_LINE_BELOW:
 call TC_COLUMN
 ret c
