 ld a,(OP_PARTIAL)
 or a
 jp nz,OP_EXPORT
 ld hl,TS_TARGET
 ld de,TW_META+22
 ld b,12
OP_W_SAME:
 ld a,(de)
 cp (hl)
 jp nz,TW_EXPORT
 inc hl
 inc de
 djnz OP_W_SAME
 ld a,(TS_TARGET+36)
 ld b,a
 ld a,(TW_META+58)
 cp b
 jp z,TW_SAVE
 jp TW_EXPORT
OP_EXPORT:
 call OP_OUTPUT_SEGMENT
 jp TW_WRITE_BLOCK
OP_OUTPUT_SEGMENT:
 ld hl,TW_SEGMENTS
 ld (hl),1
 inc hl
 ld de,OP_SOURCE_BEGIN
 ex de,hl
 call TC_COPY3
 ld hl,OP_SOURCE_END
 ld de,TW_SEGMENTS+4
 call TC_COPY3
 ld hl,TW_SEGMENTS+4
 ld de,OP_SOURCE_BEGIN
 call TC_SUB3
 ld a,1
 ld (TW_SEGCOUNT),a
 ret
OP_APPEND_WRITE:
 ld a,(TS_REPLACE)
 or a
 jp nz,OP_APPEND_EXISTING
 ld a,(OP_PARTIAL)
 or a
 jp z,TW_EXPORT
 jp OP_EXPORT
OP_APPEND_EXISTING:
 ld hl,OP_SOURCE_END
 ld de,OP_SOURCE_LENGTH
 call TC_COPY3
 ld hl,OP_SOURCE_LENGTH
 ld de,OP_SOURCE_BEGIN
 call TC_SUB3
 ld hl,OP_SOURCE_LENGTH
 ld a,(hl)
 inc hl
 or (hl)
 inc hl
 or (hl)
 ret z
