OP_RESTORE_CONTEXT:
 ld hl,OP_DOC_CONTEXT
 ld de,TW_DOC
 ld bc,187
 ldir
 ld a,(OP_DOC_OWN)
 ld (TW_OWN),a
 ld hl,TW_META+22
 ld de,TW_NAME
 call OP_COPY37
 xor a
 ld (TW_CACHE_VALID),a
 ret
OP_APPEND_RELEASE:
