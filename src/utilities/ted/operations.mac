 ld hl,OP_SOURCE_LENGTH
 ld de,OP_SOURCE_BEGIN
 call TC_SUB3
 ld hl,TC_LENGTH
 ld de,OP_REMAIN
 call TC_COPY3
 ld hl,OP_REMAIN
 ld de,OP_INSERT_AT
 call TC_SUB3
 ld a,(TW_META+20)
 call TL_INIT
 ld hl,OP_ZERO
 ld de,OP_INSERT_AT
 ld a,1
 call TL_ADD
 ret c
 ld hl,OP_SOURCE_BEGIN
 ld de,OP_SOURCE_LENGTH
 ld a,3
 call TL_ADD
 ret c
 ld hl,OP_INSERT_AT
 ld de,OP_REMAIN
 ld a,1
 call TL_ADD
 ret c
 ld hl,TW_INPUT
 ld de,TW_NAME
 call OP_COPY37
 call TW_EDIT_NAMED
 ret c
 ; Keep the cursor on the destination line, as TED's R setup does.
 ld hl,OP_INSERT_AT
 ld de,TC_SCAN
 call TC_COPY3
 ld hl,OP_INSERT_AT
 ld de,OP_ZERO
 call TC_CMP3
 jp z,OP_READ_CURSOR
 call TC_PREV
 ret c
 call TC_START
 ret c
OP_READ_CURSOR:
 call OP_SCAN_TO_POS
 jp TC_SYNC

OP_WRITE_PROMPT:
 ld hl,OP_WLABEL
 call OP_PROMPT_PTR
 ret c
 jp OP_WRITE_ARGS
OP_WRITE_ARGS:
 ld (OP_ARGPTR),hl
 xor a
 ld (OP_PARTIAL),a
 ld (OP_APPEND),a
 ld hl,OP_ZERO
 ld de,OP_SOURCE_BEGIN
 call TC_COPY3
 ld hl,TC_LENGTH
 ld de,OP_SOURCE_END
 call TC_COPY3
 ld hl,(OP_ARGPTR)
 call OP_SKIP
 push hl
 call OP_NUMBER
 jp c,OP_W_NO_RANGE
 ld (OP_FIRST),bc
 ld (OP_LAST),bc
 call OP_SKIP
 push hl
 call OP_NUMBER
 jp c,OP_W_ONE_RANGE
 pop de
 ld (OP_LAST),bc
 jp OP_W_HAVE_RANGE
OP_W_ONE_RANGE:
 pop hl
OP_W_HAVE_RANGE:
 pop de
 ld (OP_ARGPTR),hl
 call OP_CHECK_RANGE
 ret c
 call OP_RANGE
 ret c
 ld hl,TC_BEGIN
 ld de,OP_SOURCE_BEGIN
 call TC_COPY3
 ld hl,TC_END
 ld de,OP_SOURCE_END
 call TC_COPY3
 call OP_CLEAR_MARKS
 ld a,1
 ld (OP_PARTIAL),a
 ld hl,(OP_ARGPTR)
 jp OP_W_TARGET
OP_W_NO_RANGE:
 pop hl
OP_W_TARGET:
 call OP_SKIP
 or a
 jp z,OP_W_DEFAULT
 cp '$'
 jp z,OP_W_DEFAULT
 cp '0'
 jp z,OP_W_DEFAULT
 call OP_FILE_TOKEN
 ret c
 jp OP_W_APPEND_ARG
OP_W_DEFAULT:
 push hl
 ld hl,TW_META+22
 ld de,TE_FILE
 call OP_COPY37
 pop hl
OP_W_APPEND_ARG:
 call OP_SKIP
 or a
 jp z,OP_W_FINISH_ARGS
 cp '$'
 jp z,OP_W_APPEND
 cp '0'
 jp nz,OP_BAD
 inc hl
 jp OP_W_EXTRA
