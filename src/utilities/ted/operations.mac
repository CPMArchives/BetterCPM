 ld hl,TW_INPUT_LEN
 ld de,OP_APPEND_COUNT
 call TC_COPY3
 ld a,(OP_APPEND_CONTEXT+37+20)
 call TL_INIT
 ld hl,OP_APPEND_START
 ld de,OP_APPEND_COUNT
 ld a,3
 call TL_ADD
 jp c,OP_APPEND_CLEAN_FAILURE
 ld hl,OP_SOURCE_BEGIN
 ld de,OP_SOURCE_LENGTH
 ld a,1
 call TL_ADD
 jp c,OP_APPEND_CLEAN_FAILURE
 ld hl,OP_APPEND_TARGET
 ld de,TS_TARGET
 call OP_COPY37
 ld a,(OP_APPEND_FLAGS)
 ld (TS_REPLACE),a
 ld a,(OP_APPEND_FLAGS+1)
 ld (TS_PROTECT),a
 call TW_WRITE_BLOCK
 push af
 call OP_APPEND_RELEASE
 pop af
 ret
OP_APPEND_LOAD_FAILED:
 push af
 call OP_RESTORE_CONTEXT
 pop af
 ret
OP_APPEND_CLEAN_FAILURE:
 call OP_APPEND_RELEASE
 scf
