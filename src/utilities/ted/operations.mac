 xor a
 ld (OP_SUBMODE),a
 ld bc,0
 ld (OP_SUBCOUNT),bc
 call OP_SKIP
 cp 'M'
 jp z,OP_SUB_CONFIRM
 cp 'm'
 jp z,OP_SUB_CONFIRM
 cp '0'
 jp c,OP_SUB_STRINGS
 cp '9'+1
 jp nc,OP_SUB_STRINGS
 call OP_NUMBER
 ret c
 ld a,b
 or c
 jp z,OP_BAD
 ld (OP_SUBCOUNT),bc
 call OP_SKIP
 jp OP_SUB_STRINGS
OP_SUB_CONFIRM:
 inc hl
 ld a,1
 ld (OP_SUBMODE),a
 call OP_SKIP
OP_SUB_STRINGS:
 call OP_GET_SEARCH
 ret c
 ld de,TF_REPL
 ld b,0
OP_REPLACE_STRING:
 ld a,(hl)
 or a
 jp z,OP_BAD
 ld c,a
 ld a,(OP_DELIMITER)
 cp c
 jp z,OP_REPLACE_END
 ld a,b
 cp 95
 jp nc,OP_BAD
 ld a,c
 ld (de),a
 inc de
 inc hl
 inc b
 jp OP_REPLACE_STRING
OP_REPLACE_END:
 ld a,b
 ld (TF_RLEN),a
 inc hl
 call OP_SEARCH_RANGE
 ret c
 call OP_END
 ret c
OP_SUB_LOOP:
 call TF_FIND
 jp c,OP_SUB_END
 ld hl,TC_POS
 ld de,OP_SEARCH_BOUND
 call TC_CMP3
 jp nc,OP_OK
 ld a,(OP_SUBMODE)
 or a
 jp z,OP_SUB_APPLY
 call TE_RENDER
 ld hl,OP_REPLACELABEL
 call TE_PROMPT
 ret c
 ld a,(TE_FIELD)
 call OP_UPPER
 cp 'Y'
 jp z,OP_SUB_APPLY
 call TF_SKIP
 ret c
 jp OP_SUB_NEXT
OP_SUB_APPLY:
 call TF_APPLY
 ret c
 ld a,(TF_LEN)
 ld (OP_DELTA),a
 xor a
 ld (OP_DELTA+1),a
 ld (OP_DELTA+2),a
 ld hl,OP_SEARCH_BOUND
 ld de,OP_DELTA
 call TC_SUB3
 ld a,(TF_RLEN)
 ld (OP_DELTA),a
 ld hl,OP_SEARCH_BOUND
 ld de,OP_DELTA
 call TC_ADD3
 ld hl,OP_SEARCH_BOUND
 ld de,TF_LIMIT
 call TC_COPY3
OP_SUB_NEXT:
 ld hl,(OP_SUBCOUNT)
 ld a,h
 or l
 jp z,OP_SUB_LOOP
 dec hl
 ld (OP_SUBCOUNT),hl
 ld a,h
 or l
 jp nz,OP_SUB_LOOP
 or a
 ret
OP_SUB_END:
 ld a,(TF_ERROR)
 cp 1
 jp z,OP_OK
 scf
 ret
 dseg
