 ld hl,TTX_LINES
 ld (OP_LINE_OVERRIDE),hl
 ld hl,(OP_ARGPTR)
 call OP_SKIP
 or a
 ret z
 cp '('
 jp nz,OP_BAD
 inc hl
 call OP_NUMBER
 ret c
 ld (OP_FIRST),bc
 call OP_WS
 cp ','
 jp nz,OP_BAD
 inc hl
 call OP_NUMBER
 ret c
 ld (OP_LAST),bc
 call OP_SKIP
 cp ')'
 jp nz,OP_BAD
 inc hl
 ld (OP_ARGPTR),hl
 call OP_CHECK_RANGE
 ret c
 ld bc,(OP_FIRST)
 call OP_RAW_LINE
 ret c
 ld hl,OP_RAW_POS
 ld de,OP_SOURCE_BEGIN
 call TC_COPY3
 ld bc,(OP_LAST)
 inc bc
 ld a,b
 or c
 jp z,OP_BAD
 call OP_RAW_LINE
 ret c
 ld hl,OP_RAW_POS
 ld de,OP_SOURCE_END
 call TC_COPY3
 ld hl,(OP_ARGPTR)
 or a
 ret
OP_RAW_LINE:
 push bc
 ld hl,OP_ZERO
 ld de,OP_RAW_POS
 call TC_COPY3
 pop bc
 ld a,b
 or c
 jp z,OP_BAD
 dec bc
OP_RAW_LOOP:
 ld a,b
 or c
 ret z
 push bc
OP_RAW_BYTE:
 call OP_RAW_FETCH
 jp c,OP_RAW_END
 cp 13
 jp z,OP_RAW_CR
 cp 10
 jp z,OP_RAW_LF
 ld hl,OP_RAW_POS
 call TC_INC3
 jp OP_RAW_BYTE
OP_RAW_CR:
 ld hl,OP_RAW_POS
 call TC_INC3
 call OP_RAW_FETCH
 jp c,OP_RAW_END
 cp 10
 jp nz,OP_RAW_NEXT
OP_RAW_LF:
