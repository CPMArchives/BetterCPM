; TED command/storage compatibility adapter. GPL-2.0-or-later.
; Existing line-oriented operation semantics over the preserving workspace.
; No command path can bypass TS_RUN; fields commit only after validation.
 .Z80
 public OP_TEXT_DIAGNOSTIC
 public OP_END
 public OP_DISPATCH,OP_ACTION,OP_PARSE_FILE,OP_LINE_BELOW,OP_DUPLICATE
 public OP_LINE_POS,OP_RANGE,OP_WRITE,OP_READ,OP_FIND,OP_SUBSTITUTE
 extrn TL_INIT,TL_ADD,TL_TOTAL,TL_TRANSFER
 extrn WL_FLUSH
 extrn TE_FIELD,TE_FIELDLEN,TE_FILE,TE_CALLER,TE_MODE,TE_PROMPT,TE_CONFIRM
 extrn TE_FORMAT_FILE
 extrn TE_SCREEN
 extrn TE_MESSAGE,TE_RENDER,TE_READ,TE_BUSY_POLL
 extrn TC_INIT,TC_SYNC,TC_POS,TC_TOP,TC_SCAN,TC_LENGTH,TC_COPY3,TC_CMP3
 extrn TC_ADD3,TC_SUB3,TC_INC3,TC_DEC3,TC_NEXT,TC_PREV,TC_FETCH,TC_START,TC_EOL
 extrn TC_BEGIN,TC_END,TC_BSET,TC_ESET,TC_COPY_BLOCK,TC_MOVE_BLOCK,TC_DEL_BLOCK
 extrn TC_EDIT_BEGIN,TC_EDIT_END,TC_INCOUNT,TC_ADVANCE,TC_DO_EDIT,TC_ACTION,TC_VIRTUAL,TC_COLUMN,TC_PREF,TC_PREFERRED
 extrn TW_DIAG_PTR
 extrn TW_INPUT_TAG,TW_INPUT_BOUND
 extrn TW_META,TW_NAME,TW_DOC,TW_DOC_TAG,TW_OWN,TW_CACHE_VALID,TW_AREA
 extrn TW_INPUT,TW_INPUT_LEN,TW_INPUT_REC,TW_SCAN_INPUT,TW_LOAD,TW_NEW,TW_EDIT,TW_EDIT_NAMED
 extrn TW_SEGMENTS,TW_SEGCOUNT,TW_INSERT,TW_SAVE,TW_EXPORT,TW_WRITE_BLOCK,TW_RELEASE
 extrn TW_FETCH,TW_POS,TW_KIND
 extrn TTX_LINES,TTX_ERROR,TTX_BADLINE,TTX_BADPOS
 extrn TW_RECOVER,TW_INSPECT_REC
 extrn TS_TARGET,TS_REPLACE,TS_PROTECT,TS_CAPTURE,TS_LAST,TS_VALIDATE
 extrn TF_FIND,TF_APPLY,TF_SKIP,TF_TEXT,TF_LEN,TF_REPL,TF_RLEN,TF_CASE,TF_BACK
 extrn TF_POLL_PTR,TF_ERROR,TF_LIMIT
 cseg
OP_BDOS:
 push bc
 push de
 push hl
 call 5
 pop hl
 pop de
 pop bc
 ret
OP_BAD:
 scf
 ret
OP_OK:
 or a
 ret
OP_COPY37:
 ld bc,37
 ldir
 ret
OP_UPPER:
 cp 'a'
 ret c
 cp 'z'+1
 ret nc
 sub 32
 ret
OP_WS:
 ld a,(hl)
 cp ' '
 jp z,OP_WS_ONE
 cp 9
 ret nz
OP_WS_ONE:
 inc hl
 jp OP_WS
OP_SKIP:
 ld a,(hl)
 cp ' '
 jp z,OP_SKIP_ONE
 cp 9
 jp z,OP_SKIP_ONE
 cp ','
 ret nz
OP_SKIP_ONE:
 inc hl
 jp OP_SKIP
OP_END:
 call OP_SKIP
 or a
 ret z
 scf
 ret
OP_PROMPT_PTR:
 call TE_PROMPT
 ret c
 ld hl,TE_FIELD
 or a
 ret
OP_DISPATCH:
 ld hl,0
 ld (OP_LINE_OVERRIDE),hl
 ld (OP_INDEX_BASE),hl
 ld hl,TE_FIELD
 ld de,OP_COMMAND
 ld bc,96
 ldir
 ld hl,OP_COMMAND
 call OP_SKIP
 or a
 jp z,OP_SCREEN
 call OP_UPPER
 cp 'E'
 jp z,OP_EXIT_COMMAND
 cp 'S'
 jp z,OP_S_COMMAND
 cp 'M'
 jp z,OP_M_COMMAND
 cp 'D'
 jp z,OP_D_COMMAND
 cp 'R'
 jp z,OP_R_COMMAND
 cp 'W'
 jp z,OP_W_COMMAND
 cp 'C'
 jp z,OP_CLEAR_COMMAND
 cp 'F'
 jp z,OP_F_COMMAND
 cp 'P'
 jp z,OP_P_COMMAND
 ; Delimited search is an existing TED command, not a ^Q interface.
 cp '/'
 jp z,OP_FIND
 cp '!'
 jp z,OP_FIND
 cp '?'
 jp z,OP_FIND
 cp '"'
 jp z,OP_FIND
 cp '%'
 jp z,OP_FIND
 cp '&'
 jp z,OP_FIND
 cp 39
 jp z,OP_FIND
 cp '='
 jp z,OP_FIND
 cp ':'
 jp z,OP_FIND
 cp 92
 jp z,OP_FIND
 cp '<'
 jp z,OP_FIND
 cp '>'
 jp z,OP_FIND
 jp OP_BAD
OP_SCREEN:
 ld a,1
 ld (TE_MODE),a
 or a
 ret
OP_EXIT_COMMAND:
 inc hl
 ld a,(hl)
 call OP_UPPER
 cp 'X'
 jp nz,OP_BAD
 inc hl
 call OP_END
 ret c
 jp OP_EXIT
OP_S_COMMAND:
 inc hl
 ld a,(hl)
 call OP_UPPER
 cp 'U'
 jp z,OP_SU_COMMAND
 call OP_SKIP
 or a
 jp z,OP_SCREEN
 call OP_SET_POSITION
 ret c
 jp OP_SCREEN
OP_SU_COMMAND:
 inc hl
 jp OP_SUBSTITUTE
OP_M_COMMAND:
 inc hl
 xor a
 ld (OP_MOVE),a
 ld a,(hl)
 call OP_UPPER
 cp 'D'
 jp nz,OP_M_ARGS
 inc hl
 ld a,1
 ld (OP_MOVE),a
OP_M_ARGS:
 call OP_RANGE_ARGS
 ret c
 ld de,0
 ld (OP_INDEX_BASE),de
 call OP_INDEX
 ret c
 ld (OP_DESTLINE),bc
 call OP_END
 ret c
 jp OP_COPY_MOVE
OP_D_COMMAND:
 inc hl
 call OP_RANGE_ARGS
 ret c
 call OP_END
 ret c
 jp OP_DELETE_RANGE
OP_R_COMMAND:
 inc hl
 ld a,(hl)
 call OP_UPPER
 cp 'E'
 jp z,OP_RECOVER_COMMAND
 jp OP_READ_ARGS
OP_W_COMMAND:
 inc hl
 ld a,(hl)
 call OP_UPPER
 cp 'O'
 jp z,OP_WORK_COMMAND
 ld a,(hl)
 call OP_UPPER
 cp 'U'
 jp nz,OP_WRITE_ARGS
 inc hl
 jp OP_WRITE_ARGS
OP_CLEAR_COMMAND:
 inc hl
 ld a,(hl)
 call OP_UPPER
 cp 'L'
 jp nz,OP_BAD
 inc hl
 call OP_END
 ret c
 call OP_ABANDON
 ret c
 ld hl,TW_META+22
 ld de,TW_NAME
 call OP_COPY37
 call TW_NEW
 ret c
 call TC_INIT
 or a
 ret
OP_F_COMMAND:
 inc hl
 call OP_SKIP
 or a
 jp z,OP_FILENAME
 call OP_UPPER
 cp 'R'
 jp nz,OP_BAD
 inc hl
 call OP_END
 ret c
 ld hl,(6)
 ld de,TED_END
 or a
 sbc hl,de
 ld (OP_NUMBER_VALUE),hl
 xor a
 ld (OP_NUMBER_VALUE+2),a
 ld de,OP_INFOBUF
 ld hl,OP_MEMORYMSG
 call OP_TEXT_APPEND
 ld hl,OP_NUMBER_VALUE
 call OP_DEC24
 xor a
 ld (de),a
 ld hl,OP_INFOBUF
 jp TE_MESSAGE
OP_FILENAME:
 ld hl,TW_META+22
 ld de,OP_INFOBUF
 call TE_FORMAT_FILE
 ld hl,OP_INFOBUF
 jp TE_MESSAGE
OP_P_COMMAND:
 inc hl
 ld a,(hl)
 call OP_UPPER
 cp 'R'
 jp z,OP_PRINT_RANGE
 call OP_SKIP
 or a
 jp z,OP_POSITION_REPORT
 call OP_SET_POSITION
 ret c
 jp OP_POSITION_REPORT
OP_POSITION_REPORT:
 ld hl,OP_ZERO
 ld de,TC_SCAN
 call TC_COPY3
 ld hl,OP_ZERO
 ld de,OP_NUMBER_VALUE
 call TC_COPY3
 ld hl,OP_NUMBER_VALUE
 call TC_INC3
OP_POSITION_SCAN:
 ld hl,TC_SCAN
 ld de,TC_POS
 call TC_CMP3
 jp nc,OP_POSITION_READY
 call TC_FETCH
 ret c
 cp 13
 jp z,OP_POSITION_NEWLINE
 cp 10
 jp nz,OP_POSITION_NEXT
OP_POSITION_NEWLINE:
 ld hl,OP_NUMBER_VALUE
 call TC_INC3
OP_POSITION_NEXT:
 call TC_NEXT
 ret c
 jp OP_POSITION_SCAN
OP_POSITION_READY:
 ld de,OP_INFOBUF
 ld hl,OP_POSITIONMSG
 call OP_TEXT_APPEND
 ld hl,OP_NUMBER_VALUE
 call OP_DEC24
 push de
 call TC_COLUMN
 ld (OP_NUMBER_VALUE),hl
 xor a
 ld (OP_NUMBER_VALUE+2),a
 pop de
 ld hl,OP_COLUMNMSG
 call OP_TEXT_APPEND
 ld hl,OP_NUMBER_VALUE
 call OP_DEC24
 xor a
 ld (de),a
 ld hl,OP_INFOBUF
 jp TE_MESSAGE
OP_PRINT_RANGE:
 inc hl
 call OP_RANGE_ARGS
 ret c
 call OP_END
 ret c
 call OP_RANGE
 ret c
 ld hl,TC_BEGIN
 ld de,TC_SCAN
 call TC_COPY3
 ; Re-synchronize routed console state before using ordinary print output.
 ld hl,(1)
 ld de,63
 add hl,de
 ld a,4
 call OP_CONSOLE
OP_PRINT_BYTE:
 ld hl,TC_SCAN
 ld de,TC_END
 call TC_CMP3
 jp nc,OP_CLEAR_MARKS
 call TE_BUSY_POLL
 ret c
 call TC_FETCH
 ret c
 ld e,a
 ld c,2
 call OP_BDOS
 ld hl,TC_SCAN
 call TC_INC3
 jp OP_PRINT_BYTE
OP_CONSOLE:
 jp (hl)

OP_TEXT_DIAGNOSTIC:
 ld de,OP_INFOBUF
 ld hl,OP_TEXTERRMSG
 call OP_TEXT_APPEND
 ld a,(TTX_ERROR)
 add a,'0'
 ld (de),a
 inc de
 ld hl,OP_LINEMSG
 call OP_TEXT_APPEND
 ld hl,TTX_BADLINE
 call OP_DEC24
 ld hl,OP_OFFSETMSG
 call OP_TEXT_APPEND
 ld hl,TTX_BADPOS
 call OP_DEC24
 ld hl,OP_INMSG
 call OP_TEXT_APPEND
 ld hl,(TW_DIAG_PTR)
 call TE_FORMAT_FILE
 ld hl,OP_INFOBUF
 jp TE_MESSAGE
OP_RECOVER_COMMAND:
 ld de,OP_RECOVER_WORD
 call OP_KEYWORD
 ret c
 call OP_FILE_TOKEN
 ret c
 call OP_END
 ret c
 ld hl,TE_FILE
 ld de,TW_INPUT
 call OP_COPY37
 call TW_INSPECT_REC
 ret c
 ld hl,OP_RECOVERLABEL
 call TE_CONFIRM
 ret c
 call TW_RECOVER
 ret c
 jp TC_INIT
OP_WORK_COMMAND:
 ld de,OP_WORK_WORD
 call OP_KEYWORD
 ret c
 call OP_SKIP
 ; Parse exact DU by attaching an internal harmless canonical filename.
 ld de,OP_DUBUF
 ld b,5
OP_WORK_COPY:
 ld a,(hl)
 or a
 jp z,OP_BAD
 ld (de),a
 inc de
 inc hl
 cp ':'
 jp z,OP_WORK_TAIL
 djnz OP_WORK_COPY
 jp OP_BAD
OP_WORK_TAIL:
 call OP_END
 ret c
 ld hl,OP_WORK_NAME
 call OP_TEXT_APPEND
 ld hl,OP_DUBUF
 call OP_PARSE_FILE
 ret c
 ld hl,TE_FILE
 ld de,TW_AREA
 call OP_COPY37
 or a
 ret
OP_KEYWORD:
 ld a,(de)
 or a
 jp z,OP_KEYWORD_END
 ld b,a
 ld a,(hl)
 call OP_UPPER
 cp b
 jp nz,OP_BAD
 inc hl
 inc de
 jp OP_KEYWORD
OP_KEYWORD_END:
 ld a,(hl)
 cp ' '
 ret z
 cp 9
 ret z
 jp OP_BAD
OP_TEXT_APPEND:
 ld a,(hl)
 ld (de),a
 or a
 ret z
 inc hl
 inc de
 jp OP_TEXT_APPEND
; Bounded decimal formatting for existing P/FR reporting; no document buffer.
OP_DEC24:
 ld (OP_OUTPTR),de
 ld de,OP_NUMBER_WORK
 call TC_COPY3
 ld hl,OP_POWERS
 ld (OP_POWERPTR),hl
 xor a
 ld (OP_DEC_STARTED),a
 ld a,8
 ld (OP_DEC_LEFT),a
OP_DEC_POWER:
 xor a
 ld (OP_DEC_DIGIT),a
OP_DEC_SUBTRACT:
 ld hl,OP_NUMBER_WORK
 ld de,(OP_POWERPTR)
 call TC_CMP3
 jp c,OP_DEC_WRITE
 ld hl,OP_NUMBER_WORK
 ld de,(OP_POWERPTR)
 call TC_SUB3
 ld hl,OP_DEC_DIGIT
 inc (hl)
 jp OP_DEC_SUBTRACT
OP_DEC_WRITE:
 ld a,(OP_DEC_DIGIT)
 or a
 jp nz,OP_DEC_EMIT
 ld a,(OP_DEC_STARTED)
 or a
 jp nz,OP_DEC_EMIT
 ld a,(OP_DEC_LEFT)
 cp 1
 jp nz,OP_DEC_ADVANCE
OP_DEC_EMIT:
 ld a,1
 ld (OP_DEC_STARTED),a
 ld a,(OP_DEC_DIGIT)
 add a,'0'
 ld de,(OP_OUTPTR)
 ld (de),a
 inc de
 ld (OP_OUTPTR),de
OP_DEC_ADVANCE:
 ld hl,(OP_POWERPTR)
 inc hl
 inc hl
 inc hl
 ld (OP_POWERPTR),hl
 ld hl,OP_DEC_LEFT
 dec (hl)
 jp nz,OP_DEC_POWER
 ld de,(OP_OUTPTR)
 xor a
 ld (de),a
 ret

; Inclusive source lines, with omitted last line meaning first line.
OP_RANGE_ARGS:
 call OP_INDEX
 ret c
 ld a,b
 or c
 jp z,OP_BAD
 ld (OP_FIRST),bc
 ld (OP_LAST),bc
 ld (OP_INDEX_BASE),bc
 call OP_SKIP
 or a
 ret z
 push hl
 call OP_INDEX
 jp c,OP_RANGE_NOSECOND
 ld (OP_LAST),bc
 pop de
 jp OP_CHECK_RANGE
OP_RANGE_NOSECOND:
 pop hl
 or a
 ret
OP_CHECK_RANGE:
 push hl
 ld hl,(OP_LAST)
 ld de,(OP_FIRST)
 or a
 sbc hl,de
 pop hl
 ret
OP_SET_POSITION:
 call OP_INDEX
 ret c
 ld (OP_ARGPTR),hl
 push bc
 ld hl,(OP_INDEX_COLUMN)
 ld (TC_PREF),hl
 pop bc
 call OP_LINE_POS
 ret c
 ld hl,(OP_ARGPTR)
 call OP_SKIP
 or a
 jp z,OP_SET_CURSOR
 call OP_NUMBER
 ret c
 ld (TC_PREF),bc
 call OP_END
 ret c
OP_SET_CURSOR:
 ; P/S char positions are visual columns, including TED virtual columns.
 call TC_PREFERRED
 ret c
 ld hl,TC_POS
 ld de,TC_TOP
 call TC_COPY3
 ret
OP_INDEX:
 ld de,0
 ld (OP_INDEX_COLUMN),de
 call OP_SKIP
 cp '0'
 jp c,OP_INDEX_NONNUM
 cp '9'+1
 jp c,OP_NUMBER
 cp '$'
 jp z,OP_NUMBER
OP_INDEX_NONNUM:
 cp '+'
 jp z,OP_INDEX_RELATIVE
 cp '-'
 jp z,OP_INDEX_RELATIVE
 ; Existing TED text-index delimiters; the parser never accepts arbitrary
 ; letters as a search delimiter or consumes a subsequent command argument.
 ld de,OP_DELIMITERS
 ld c,a
OP_INDEX_DELIM:
 ld a,(de)
 or a
 jp z,OP_BAD
 cp c
 jp z,OP_INDEX_SEARCH
 inc de
 jp OP_INDEX_DELIM
OP_INDEX_SEARCH:
 call OP_GET_SEARCH
 ret c
 call OP_SEARCH_RANGE
 ret c
 ld (OP_INDEX_ENDPTR),hl
 call TF_FIND
 ret c
 call TC_COLUMN
 ret c
 ld (OP_INDEX_COLUMN),hl
 call OP_CURRENT_LINE
 ret c
 ld hl,(OP_INDEX_ENDPTR)
 or a
 ret
OP_INDEX_RELATIVE:
 ld (OP_REL_SIGN),a
 inc hl
 call OP_NUMBER
 ret c
 ld (OP_REL_VALUE),bc
 ld (OP_INDEX_ENDPTR),hl
 ld bc,(OP_INDEX_BASE)
 ld a,b
 or c
 jp nz,OP_INDEX_BASE_READY
 call OP_CURRENT_LINE
 ret c
OP_INDEX_BASE_READY:
 ld h,b
 ld l,c
 ld de,(OP_REL_VALUE)
 ld a,(OP_REL_SIGN)
 cp '-'
 jp z,OP_INDEX_SUB
 add hl,de
 jp c,OP_BAD
 jp OP_INDEX_RESULT
OP_INDEX_SUB:
 or a
 sbc hl,de
 jp c,OP_BAD
OP_INDEX_RESULT:
 ld b,h
 ld c,l
 ld hl,(OP_INDEX_ENDPTR)
 or a
 ret
OP_CURRENT_LINE:
 ld hl,OP_ZERO
 ld de,TC_SCAN
 call TC_COPY3
 ld bc,1
OP_CURRENT_SCAN:
 push bc
 ld hl,TC_SCAN
 ld de,TC_POS
 call TC_CMP3
 jp nc,OP_CURRENT_FOUND
 call TC_FETCH
 jp c,OP_CURRENT_BAD
 cp 13
 jp z,OP_CURRENT_NEWLINE
 cp 10
 jp z,OP_CURRENT_NEWLINE
 call TC_NEXT
 jp c,OP_CURRENT_BAD
 pop bc
 jp OP_CURRENT_SCAN
OP_CURRENT_NEWLINE:
 call TC_NEXT
 jp c,OP_CURRENT_BAD
 pop bc
 inc bc
 ld a,b
 or c
 jp z,OP_BAD
 jp OP_CURRENT_SCAN
OP_CURRENT_FOUND:
 pop bc
 or a
 ret
OP_CURRENT_BAD:
 pop bc
 scf
 ret

; Numeric line expressions: decimal, $, and +/- decimal offsets.
OP_NUMBER:
 call OP_ATOM
 ret c
OP_EXPRESSION:
 ld a,(hl)
 cp '+'
 jp z,OP_EXPRESSION_MORE
 cp '-'
 jp z,OP_EXPRESSION_MORE
 or a
 ret
OP_EXPRESSION_MORE:
 ld (OP_SIGN),a
 inc hl
 push bc
 call OP_ATOM
 jp c,OP_EXPRESSION_BAD
 ex (sp),hl
 ld d,b
 ld e,c
 ld a,(OP_SIGN)
 cp '-'
 jp z,OP_EXPRESSION_SUB
 add hl,de
 jp OP_EXPRESSION_VALUE
OP_EXPRESSION_SUB:
 or a
 sbc hl,de
OP_EXPRESSION_VALUE:
 ld b,h
 ld c,l
 pop hl
 ret c
 jp OP_EXPRESSION
OP_EXPRESSION_BAD:
 pop bc
 scf
 ret
OP_ATOM:
 call OP_SKIP
 ld bc,0
 ld a,(hl)
 cp '$'
 jp z,OP_NUMBER_LAST
 cp '0'
 jp c,OP_BAD
 cp '9'+1
 jp nc,OP_BAD
OP_NUMBER_DIGIT:
 sub '0'
 ld (OP_DIGIT),a
 push hl
 ld h,b
 ld l,c
 add hl,hl
 jp c,OP_NUMBER_OVERFLOW
 ld d,h
 ld e,l
 add hl,hl
 jp c,OP_NUMBER_OVERFLOW
 add hl,hl
 jp c,OP_NUMBER_OVERFLOW
 add hl,de
 jp c,OP_NUMBER_OVERFLOW
 ld a,(OP_DIGIT)
 ld e,a
 ld d,0
 add hl,de
 jp c,OP_NUMBER_OVERFLOW
 ld b,h
 ld c,l
 pop hl
 inc hl
 ld a,(hl)
 cp '0'
 jp c,OP_NUMBER_DONE
 cp '9'+1
 jp c,OP_NUMBER_DIGIT
OP_NUMBER_DONE:
 or a
 ret
OP_NUMBER_OVERFLOW:
 pop hl
 scf
 ret
OP_NUMBER_LAST:
 inc hl
 push hl
 ld hl,(OP_LINE_OVERRIDE)
 ld a,h
 or l
 jp nz,OP_LAST_PTR
 ld hl,TW_META+17
OP_LAST_PTR:
 ld c,(hl)
 inc hl
 ld b,(hl)
 inc hl
 ld a,(hl)
 or a
 jp nz,OP_NUMBER_OVERFLOW
 pop hl
 or a
 ret

; BC line number -> TC_SCAN at its beginning, clamped at document end.
; Line zero denotes before the first line, usable only as insertion target.
OP_LINE_POS:
 push bc
 ld hl,OP_ZERO
 ld de,TC_SCAN
 call TC_COPY3
 pop bc
 ld a,b
 or c
 ret z
 dec bc
OP_LINE_LOOP:
 ld a,b
 or c
 ret z
 push bc
 call TC_EOL
 jp c,OP_LINE_FAIL
 call TC_NEXT
 jp c,OP_LINE_EDGE
 pop bc
 dec bc
 jp OP_LINE_LOOP
OP_LINE_EDGE:
 ld hl,TC_SCAN
 ld de,TC_LENGTH
 call TC_CMP3
 jp nz,OP_LINE_FAIL
 pop bc
 or a
 ret
OP_LINE_FAIL:
 pop bc
 scf
 ret
OP_AFTER_LINE:
 push bc
 call OP_LINE_POS
 pop bc
 ret c
 ld a,b
 or c
 ret z
 call TC_EOL
 ret c
 call TC_NEXT
 ret nc
 ld hl,TC_SCAN
 ld de,TC_LENGTH
 call TC_CMP3
 ret
OP_SCAN_TO_POS:
 ld hl,TC_SCAN
 ld de,TC_POS
 call TC_COPY3
 ld hl,TC_SCAN
 ld de,TC_TOP
 call TC_COPY3
 xor a
 ld (TC_PREFVALID),a
 ld (TC_VIRTUAL),a
 ld (TC_VIRTUAL+1),a
 ret
OP_RANGE:
 ld bc,(OP_FIRST)
 call OP_LINE_POS
 ret c
 ld hl,TC_SCAN
 ld de,TC_BEGIN
 call TC_COPY3
 ld bc,(OP_LAST)
 call OP_AFTER_LINE
 ret c
 ld hl,TC_SCAN
 ld de,TC_END
 call TC_COPY3
 ld a,1
 ld (TC_BSET),a
 ld (TC_ESET),a
 or a
 ret
OP_DELETE_RANGE:
 call OP_RANGE
 ret c
 call TC_DEL_BLOCK
 jp OP_CLEAR_MARKS
OP_COPY_MOVE:
 ; Original TED rejects a destination line within the inclusive source range.
 ld hl,(OP_DESTLINE)
 ld de,(OP_FIRST)
 or a
 sbc hl,de
 jp c,OP_TRANSFER_READY
 ld hl,(OP_LAST)
 ld de,(OP_DESTLINE)
 or a
 sbc hl,de
 jp nc,OP_BAD
OP_TRANSFER_READY:
 call OP_RANGE
 ret c
 ld bc,(OP_DESTLINE)
 call OP_AFTER_LINE
 ret c
 ld hl,TC_SCAN
 ld de,TC_POS
 call TC_COPY3
 ld a,(OP_MOVE)
 call TL_TRANSFER
 jp OP_CLEAR_MARKS
OP_CLEAR_MARKS:
 push af
 xor a
 ld (TC_BSET),a
 ld (TC_ESET),a
 pop af
 ret

; Bindings collect TED arguments, then invoke the same command adapters.
OP_ACTION:
 cp 1
 jp z,OP_SAVE
 cp 3
 jp z,OP_SAVE_EXIT
 cp 4
 jp z,OP_EXIT
 cp 5
 jp z,OP_READ_PROMPT
 cp 6
 jp z,OP_WRITE_PROMPT
 cp 18
 jp z,OP_COPY_PROMPT
 cp 19
 jp z,OP_MOVE_PROMPT
 cp 20
 jp z,OP_DELETE_PROMPT
 jp OP_BAD
OP_ASK_RANGE:
 ld hl,OP_FIRSTLABEL
 call OP_PROMPT_PTR
 ret c
 call OP_NUMBER
 ret c
 ld a,b
 or c
 jp z,OP_BAD
 ld (OP_FIRST),bc
 ld hl,OP_LASTLABEL
 call OP_PROMPT_PTR
 ret c
 call OP_NUMBER
 ret c
 ld (OP_LAST),bc
 jp OP_CHECK_RANGE
OP_COPY_PROMPT:
 xor a
 ld (OP_MOVE),a
 jp OP_TRANSFER_PROMPT
OP_MOVE_PROMPT:
 ld a,1
 ld (OP_MOVE),a
OP_TRANSFER_PROMPT:
 call OP_ASK_RANGE
 ret c
 ld hl,OP_DESTLABEL
 call OP_PROMPT_PTR
 ret c
 call OP_NUMBER
 ret c
 ld (OP_DESTLINE),bc
 jp OP_COPY_MOVE
OP_DELETE_PROMPT:
 call OP_ASK_RANGE
 ret c
 jp OP_DELETE_RANGE
OP_ABANDON:
 ld a,(TW_META+21)
 or a
 ret z
 ld hl,OP_ABANDONLABEL
 jp TE_CONFIRM
OP_EXIT:
 call OP_ABANDON
 ret c
 ld a,2
 ld (TE_MODE),a
 or a
 ret
OP_SAVE_EXIT:
 call OP_SAVE
 ret c
 ld a,2
 ld (TE_MODE),a
 or a
 ret
OP_SAVE:
 call WL_FLUSH
 ret c
 ld hl,TW_META+22
 ld de,TE_FILE
 call OP_COPY37
 ld a,(TE_FILE+1)
 cp ' '
 jp nz,OP_SAVE_NAMED
 ld hl,OP_FILELABEL
 call OP_PROMPT_PTR
 ret c
 call OP_PARSE_FILE
 ret c
 call OP_END
 ret c
 ; Establish a default only for an unnamed document, after successful save.
OP_SAVE_NAMED:
 ld hl,TE_FILE
 ld de,TS_TARGET
 call OP_COPY37
 call OP_AUTHORIZE
 ret c
 call TW_SAVE
 ret c
 ld hl,OP_SAVEDMSG
 jp TE_MESSAGE
OP_AUTHORIZE:
 xor a
 ld (TS_REPLACE),a
 ld (TS_PROTECT),a
 ld hl,TS_TARGET
 call TS_CAPTURE
 ret c
 ld a,(TS_LAST)
 or a
 ret z
 ld hl,OP_OVERWRITELABEL
 call OP_TARGET_CONFIRM
 ret c
 ld a,1
 ld (TS_REPLACE),a
 ld a,(TS_LAST+9)
 ld b,a
 ld a,(TS_LAST+10)
 or b
 and 128
 ret z
 ld hl,OP_PROTECTLABEL
 call OP_TARGET_CONFIRM
 ret c
 ld a,1
 ld (TS_PROTECT),a
 or a
 ret

OP_TARGET_CONFIRM:
 push hl
 ld hl,TS_TARGET
 ld de,OP_CONFIRMBUF
 call TE_FORMAT_FILE
 pop hl
OP_CONFIRM_COPY:
 ld a,(hl)
 ld (de),a
 or a
 jp z,OP_CONFIRM_READY
 inc hl
 inc de
 jp OP_CONFIRM_COPY
OP_CONFIRM_READY:
 ld hl,OP_CONFIRMBUF
 jp TE_CONFIRM

; Exact DU:8.3 parser. HL points to NUL-terminated token. No wildcards,
; compound selectors, implicit truncation or range/user wrap.
OP_PARSE_FILE:
 ld (OP_PARSEPTR),hl
 ld a,(TE_CALLER)
 ld (TE_FILE),a
 ld a,(TE_CALLER+36)
 ld (TE_FILE+36),a
 ld hl,TE_FILE+1
 ld de,TE_FILE+2
 ld bc,10
 ld (hl),' '
 ldir
 ld hl,TE_FILE+12
 ld de,TE_FILE+13
 ld bc,23
 ld (hl),0
 ldir
 ld hl,(OP_PARSEPTR)
 call OP_SKIP
 ld (OP_PARSEPTR),hl
OP_COLON_SCAN:
 ld a,(hl)
 or a
 jp z,OP_NO_DU
 cp ':'
 jp z,OP_HAVE_DU
 cp ' '
 jp z,OP_NO_DU
 cp 9
 jp z,OP_NO_DU
 inc hl
 jp OP_COLON_SCAN
OP_HAVE_DU:
 ld (OP_COLON),hl
 ld hl,(OP_PARSEPTR)
 ld a,(hl)
 call OP_UPPER
 cp 'A'
 jp c,OP_DU_USER
 cp 'P'+1
 jp nc,OP_BAD
 sub 'A'-1
 ld (TE_FILE),a
 inc hl
OP_DU_USER:
 ld de,(OP_COLON)
 push hl
 or a
 sbc hl,de
 pop hl
 jp z,OP_DU_DONE
 ld a,(hl)
 cp '0'
 jp c,OP_BAD
 cp '9'+1
 jp nc,OP_BAD
 call OP_ATOM
 ret c
 ld a,b
 or a
 jp nz,OP_BAD
 ld a,c
 cp 32
 jp nc,OP_BAD
 ld (TE_FILE+36),a
 ld de,(OP_COLON)
 push hl
 or a
 sbc hl,de
 pop hl
 jp nz,OP_BAD
OP_DU_DONE:
 inc hl
 ld (OP_PARSEPTR),hl
OP_NO_DU:
 ld hl,(OP_PARSEPTR)
 ld de,TE_FILE+1
 ld b,8
 xor a
 ld (OP_EXT),a
OP_NAME_LOOP:
 ld a,(hl)
 or a
 jp z,OP_NAME_END
 cp ' '
 jp z,OP_NAME_END
 cp 9
 jp z,OP_NAME_END
 cp ','
 jp z,OP_NAME_END
 cp '.'
 jp z,OP_NAME_DOT
 ld c,a
 ld a,b
 or a
 jp z,OP_BAD
 ld a,c
 call OP_UPPER
 ld (de),a
 inc de
 inc hl
 dec b
 jp OP_NAME_LOOP
OP_NAME_DOT:
 ld a,(OP_EXT)
 or a
 jp nz,OP_BAD
 inc a
 ld (OP_EXT),a
 inc hl
 ld de,TE_FILE+9
 ld b,3
 jp OP_NAME_LOOP
OP_NAME_END:
 ld (OP_PARSEPTR),hl
 push hl
 ld hl,TE_FILE
 call TS_VALIDATE
 pop hl
 ret
OP_FILE_TOKEN:
 call OP_PARSE_FILE
 ret c
 ld hl,(OP_PARSEPTR)
 or a
 ret

OP_READ_PROMPT:
 ld hl,OP_RLABEL
 call OP_PROMPT_PTR
 ret c
 jp OP_READ_ARGS
OP_READ_ARGS:
 ld de,0
 ld (OP_INDEX_BASE),de
 ; Original syntax R [(P)] FILE [(N1,N2)]. Omitted P appends.
 ld bc,0ffffh
 ld (OP_INSERTLINE),bc
