 call TC_INC3
OP_RAW_NEXT:
 pop bc
 dec bc
 jp OP_RAW_LOOP
OP_RAW_END:
 ld hl,OP_RAW_POS
 ld de,TW_INPUT_LEN
 call TC_CMP3
 pop bc
 ret
OP_RAW_FETCH:
 ld hl,OP_RAW_POS
 ld de,TW_INPUT_LEN
 call TC_CMP3
 jp nc,OP_BAD
 ld hl,OP_RAW_POS
 ld de,TW_POS
 call TC_COPY3
 ld a,3
 ld (TW_KIND),a
 jp TW_FETCH
OP_READ:
 call WL_FLUSH
 ret c
 ld bc,(OP_INSERTLINE)
 ld a,b
 and c
 inc a
 jp nz,OP_READ_POSITION
