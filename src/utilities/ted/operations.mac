 ld a,1
 ld (OP_APPEND),a
OP_W_EXTRA:
 call OP_END
 ret c
OP_W_FINISH_ARGS:
 ld hl,TE_FILE
 ld de,TS_TARGET
 call OP_COPY37
 ld hl,TE_FILE
 call TS_VALIDATE
 ret c
 jp OP_WRITE
OP_WRITE:
 call WL_FLUSH
 ret c
 call OP_AUTHORIZE
 ret c
 ld a,(OP_APPEND)
 or a
 jp nz,OP_APPEND_WRITE
