 ld hl,TE_FILE
 ld de,TW_INPUT
 call OP_COPY37
 call TW_SCAN_INPUT
 ret c
 ld hl,(OP_ARGPTR)
 call OP_SOURCE_RANGE
 ret c
 call OP_END
 ret c
 jp OP_READ
OP_SOURCE_RANGE:
 ld hl,OP_ZERO
 ld de,OP_SOURCE_BEGIN
 call TC_COPY3
 ld hl,TW_INPUT_LEN
 ld de,OP_SOURCE_END
