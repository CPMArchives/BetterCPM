; ********************************************************************************
; *                    BetterCP/M Native System Build Script                     *
; *                                                                              *
; * Rebuilds the protected BetterCP/M system from native Z80 source products,    *
; * constructs the resident payload and relocatable CCP, then composes the final *
; * SYSTEM.SYS package.                                                         *
; ********************************************************************************

C:

; -------------------------------------------------------------------------------
; Remove Previous Build Products
; -------------------------------------------------------------------------------
ERA *.BIN
ERA *.RLM
ERA *.REL
ERA SYSTEM.SYS

; ================================================================================
; =                         Resident System Components                          =
; =                                                                              =
; = Assemble and link the fixed resident modules, rename each absolute COM image =
; = to its native build-product filename, and discard intermediate REL files.    =
; ================================================================================
B:ZSM4 BOOT=B:BOOT
B:LINK BOOT[A]
REN BOOT.BIN=BOOT.COM
ERA BOOT.REL
B:ZSM4 STAGE1=B:STAGE1
B:LINK STAGE1[A]
REN STAGE1.BIN=STAGE1.COM
ERA STAGE1.REL
B:ZSM4 GATEWAY=B:GATEWAY
B:LINK GATEWAY[A]
REN GATEWAY.BIN=GATEWAY.COM
ERA GATEWAY.REL
B:ZSM4 BDOS=B:BDOS
B:LINK BDOS[A]
REN BDOS.BIN=BDOS.COM
ERA BDOS.REL
B:ZSM4 EXTENS=B:EXTENS
B:LINK EXTENS[A]
REN EXTENS.BIN=EXTENS.COM
ERA EXTENS.REL
B:ZSM4 DISK=B:DISK
B:LINK DISK[A]
REN DISK.BIN=DISK.COM
ERA DISK.REL
B:ZSM4 BIOS=B:BIOS
B:LINK BIOS[A]
REN BIOS.BIN=BIOS.COM
ERA BIOS.REL
B:ZSM4 FILELOAD=B:FILELOAD
B:LINK FILELOAD[A]
REN FILELOAD.BIN=FILELOAD.COM
ERA FILELOAD.REL
B:ZSM4 TABLES=B:TABLES
B:LINK TABLES[A]
REN TABLES.BIN=TABLES.COM
ERA TABLES.REL

; -------------------------------------------------------------------------------
; Pack Resident Payload
; -------------------------------------------------------------------------------
B:RESPACK

; ================================================================================
; =                    Reloadable System and RSX Components                    =
; =                                                                              =
; = Build the command reloader, RSX selector, configuration overlay, and RSX     =
; = transaction-entry and resolver carriers used during reconstruction.         =
; ================================================================================
B:ZSM4 CCPRELOD=B:CCPRELOD
B:LINK CCPRELOD[A]
REN CCPRELOD.BIN=CCPRELOD.COM
ERA CCPRELOD.REL
B:ZSM4 RSXSEL=B:RSXSEL
B:LINK RSXSEL[A]
REN RSXSEL.BIN=RSXSEL.COM
ERA RSXSEL.REL
B:ZSM4 CONFIG=B:CONFIG
B:LINK CONFIG[A]
REN CONFIG.BIN=CONFIG.COM
ERA CONFIG.REL
B:ZSM4 RSXLOAD=B:RSXLOAD
B:LINK RSXLOAD[A]
REN RSXLOAD.BIN=RSXLOAD.COM
ERA RSXLOAD.REL
B:ZSM4 RSXRESOL=B:RSXRESOL
B:LINK RSXRESOL[A]
REN RSXRESOL.BIN=RSXRESOL.COM
ERA RSXRESOL.REL

; ================================================================================
; =                        Relocatable Command Processor                        =
; =                                                                              =
; = Link the CCP at three independent origins, then derive CCP.RLM from the      =
; = three-origin relocation proof.                                               =
; ================================================================================
B:ZSM4 CCP=B:CCP
B:LINK CCP[A]
REN CCPBASE.BIN=CCP.COM
ERA CCP.REL
B:ZSM4 CCPALT=B:CCPALT
B:LINK CCPALT[A]
REN CCPALT.BIN=CCPALT.COM
ERA CCPALT.REL
B:ZSM4 CCPCHK=B:CCPCHK
B:LINK CCPCHK[A]
REN CCPCHK.BIN=CCPCHK.COM
ERA CCPCHK.REL
B:RLMBUILD

; -------------------------------------------------------------------------------
; Compose SYSTEM.SYS
; -------------------------------------------------------------------------------
B:SYSBUILD
