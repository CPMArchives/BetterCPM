; ********************************************************************************
; *                    BetterCP/M Resident-Service Test                          *
; *                                                                              *
; * Qualifies the public Function 182 service-lookup gateway, resolves the       *
; * TEST.RSX callable service, invokes the returned entry point, and reports     *
; * lookup or invocation failure.                                                *
; ********************************************************************************

BDOS            EQU     0005H

        CSEG
        .PHASE  0103H

; ================================================================================
; =                    Service Lookup and Invocation                           =
; =                                                                              =
; = Submits an ABI-1 Function-182 lookup request and validates the returned      =
; = callable address.                                                           =
; = service, invokes it, and reports the qualification result.                   =
; ================================================================================

START:                                  ; enter resident-service lookup test
        LD      DE,REQUEST
        LD      C,182
        CALL    BDOS
        OR      A
        JR      NZ,FAILED
        LD      DE,PASSLOOK
        LD      C,9
        CALL    BDOS
        LD      HL,(REQUEST+12)
        LD      DE,SVCRET
        PUSH    DE
        JP      (HL)

SVCRET:                                 ; handle returned service call
        LD      A,H
        CP      052H
        JR      NZ,FAILED
        LD      A,L
        CP      053H
        JR      NZ,FAILED
        LD      DE,PASSCALL
        JR      PRINT

FAILED:                                 ; select failure message
        LD      DE,FAILMSG

PRINT:                                  ; print test result
        LD      C,9
        CALL    BDOS
        LD      C,0
        JP      BDOS

; -------------------------------------------------------------------------------
; Lookup Request and Result Messages
; -------------------------------------------------------------------------------

REQUEST: DB     1,20,0,0,'T','E','S','T',1,0 ; Function-182 lookup request
         DW     0,0
         DB     0,0
         DW     0
         DB     0,0

PASSLOOK: DB    'Function 182 found TEST',13,10,'$' ; lookup-success message
PASSCALL: DB    'TEST service returned 5253h',13,10,'$' ; service-call success message
FAILMSG: DB     'Function 182 TEST failed',13,10,'$' ; qualification failure message
        .DEPHASE
        END     START
