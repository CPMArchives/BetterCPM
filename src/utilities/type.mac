; ********************************************************************************
; *                         BetterCP/M TYPE Utility                              *
; *                                                                              *
; * Portable transient text-file display utility with optional page-at-a-time   *
; * output. Accepts one exact filename plus optional /P, reads through public    *
; * CP/M file services, and permits console abort while displaying or paused.    *
; ********************************************************************************


BDOS    EQU     0005H
FCB     EQU     005CH
DMA     EQU     0080H

        CSEG
        .PHASE  0103H

; ================================================================================
; =                              TYPE File Display                               =
; =                                                                              =
; = Validates the exact input filespec, opens the file, reads sequential records, and =
; = displays text until CP/M EOF, console abort, or read failure.                =
; ================================================================================
; -------------------------------------------------------------------------------
; Open and Sequential Read
; -------------------------------------------------------------------------------

START:                                  ; enter TYPE utility
        CALL    OPTIONS
        JP      Z,SYNTAX
        LD      HL,FCB+1
        CALL    NOQUEST
        JP      Z,SYNTAX
        LD      DE,FCB
        LD      C,15
        CALL    BDOS
        INC     A
        JP      Z,SYNTAX
        LD      DE,DMA
        LD      C,26
        CALL    BDOS
        XOR     A
        LD      (LINES),A
        LD      DE,NEWLINE
        LD      C,9
        CALL    BDOS

READ:                                   ; read next file record
        LD      DE,FCB
        LD      C,20
        CALL    BDOS
        OR      A
        JR      Z,BLOCK
        CP      1
        JR      Z,DONE
        LD      DE,READERR
        JR      ERROR

; ================================================================================
; =                         Character Output and Paging                          =
; =                                                                              =
; = Processes each character, tracks displayed lines, pauses at page boundaries when /P =
; = is active, and handles console abort during output or pause.                 =
; ================================================================================
; -------------------------------------------------------------------------------
; Record Display
; -------------------------------------------------------------------------------

BLOCK:                                  ; display current input record
        LD      HL,DMA
        LD      B,128

CHAR:                                   ; process next file character
        LD      A,(HL)
        CP      01AH
        JR      Z,DONE
        PUSH    HL
        PUSH    BC
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     BC
        POP     HL
        LD      A,(HL)
        CP      10
        JR      NZ,NEXT
        PUSH    HL
        CALL    LINE
        POP     HL

NEXT:                                   ; advance display pointer
        INC     HL
        DJNZ    CHAR
        JR      READ

; -------------------------------------------------------------------------------
; Line Counting and Pause
; -------------------------------------------------------------------------------

LINE:                                   ; count displayed line
        LD      A,(PAGED)
        OR      A
        RET     Z
        LD      HL,LINES
        INC     (HL)
        LD      A,(HL)
        CP      23
        RET     C
        XOR     A
        LD      (HL),A
        PUSH    BC
        PUSH    DE
        LD      DE,MORE
        LD      C,9
        CALL    BDOS

; -------------------------------------------------------------------------------
; Paged Pause
; -------------------------------------------------------------------------------

WAIT:                                   ; pause paged output
        LD      E,0FFH
        LD      C,6
        CALL    BDOS
        OR      A
        JR      Z,WAIT
        CP      3
        JR      Z,ABORT
        CP      ' '
        JR      NZ,WAIT
        LD      DE,ERASE
        LD      C,9
        CALL    BDOS
        POP     DE
        POP     BC
        RET

ABORT:                                  ; abort TYPE display
        LD      C,0
        JP      BDOS

DONE:                                   ; return to CCP
        LD      C,0
        JP      BDOS

SYNTAX:                                 ; report TYPE syntax error
        LD      DE,QMARK

ERROR:                                  ; report file read error
        LD      C,9
        CALL    BDOS
        JR      DONE

  ; Validate one filename followed by either nothing or the exact option /P.

; ================================================================================
; =                           Command-Line Validation                            =
; =                                                                              =
; = Requires one filename followed by either nothing or the exact /P option and rejects =
; = trailing operands or wildcard filespecs.                                     =
; ================================================================================
; -------------------------------------------------------------------------------
; Filename and /P Parse
; -------------------------------------------------------------------------------

OPTIONS:                                ; validate TYPE command tail
        XOR     A
        LD      (PAGED),A
        LD      A,(DMA)
        LD      B,A
        LD      HL,DMA+1

OSKIP:                                  ; skip leading option spaces
        LD      A,B
        OR      A
        RET     Z
        LD      A,(HL)
        CP      ' '
        JR      NZ,ONAME
        INC     HL
        DEC     B
        JR      OSKIP

ONAME:                                  ; scan filename operand
        LD      A,(HL)
        CP      ' '
        JR      Z,OAFTER
        INC     HL
        DJNZ    ONAME
        LD      A,1
        OR      A
        RET

OAFTER:                                 ; scan text after filename
        INC     HL
        DEC     B
        JR      Z,OGOOD
        LD      A,(HL)
        CP      ' '
        JR      Z,OAFTER
        CP      '/'
        JR      NZ,OBAD
        INC     HL
        DEC     B
        JR      Z,OBAD
        LD      A,(HL)
        CP      'P'
        JR      NZ,OBAD
        INC     HL
        DEC     B

OTRAIL:                                 ; validate trailing text
        LD      A,B
        OR      A
        JR      Z,OPAGE
        LD      A,(HL)
        CP      ' '
        JR      NZ,OBAD
        INC     HL
        DEC     B
        JR      OTRAIL

OPAGE:                                  ; enable paged output
        LD      A,1
        LD      (PAGED),A

OGOOD:                                  ; accept TYPE syntax
        LD      A,1
        OR      A
        RET

OBAD:                                   ; reject invalid TYPE syntax
        XOR     A
        RET

; -------------------------------------------------------------------------------
; Wildcard Rejection
; -------------------------------------------------------------------------------

NOQUEST:                                ; reject wildcard filespec
        LD      B,11

NQLOOP:                                 ; scan FCB for wildcards
        LD      A,(HL)
        CP      '?'
        RET     Z
        INC     HL
        DJNZ    NQLOOP
        LD      A,1
        OR      A
        RET

; ================================================================================
; =                           TYPE Messages and State                            =
; =                                                                              =
; = Defines output/paging messages and the flags/counters retained by the transient utility. =
; ================================================================================
; -------------------------------------------------------------------------------
; Messages and State
; -------------------------------------------------------------------------------

NEWLINE: DB    13,10,'$'                ; newline string
READERR: DB    13,10,'READ ERROR',13,10,'$' ; read-error message
QMARK:   DB    13,10,'?',13,10,'$'      ; syntax-error marker
MORE:    DB    '--More--$'              ; paging prompt
ERASE:   DB    8,' ',8,8,' ',8,8,' ',8,8,' ',8 ; paging-prompt erase text
         DB    8,' ',8,8,' ',8,8,' ',8,8,' ',8,'$'

PAGED:   DB    0                        ; paging-enabled flag
LINES:   DB    0                        ; displayed-line count

        .DEPHASE
        END     START
