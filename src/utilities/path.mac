BDOS EQU 5
; Numeric transient command-search policy. Parse into a private candidate.
; No BDOS calls or recoverable errors occur during publication.
        INCLUDE layout.inc
        ASEG
        ORG 0100H
        CALL    UV_CHECK
        LD      A,(0080H)
        CP      128
        JP      NC,BADDU
        LD      B,A
        LD      HL,0081H
        LD      DE,TAIL
        OR      A
        JR      Z,READY
FOLD:   LD      A,(HL)
        CP      ' '
        JP      C,BADDU
        CP      'a'
        JR      C,FNEXT
        CP      'z'+1
        JR      NC,FNEXT
        AND     05FH
FNEXT:  LD      (DE),A
        INC     DE
        INC     HL
        DJNZ    FOLD
READY:  XOR     A
        LD      (DE),A
        LD      HL,TAIL
        CALL    SPACES
        PUSH    HL
        CALL    LOCATE
        JP      NZ,NOSYS
        POP     HL
        LD      A,(HL)
        OR      A
        JP      Z,DISPLAY
        PUSH    HL
        LD      DE,DEFKEY
        CALL    EXACT
        POP     HL
        JP      NZ,OPTIONS
        XOR     A
        LD      (LY_PATH),A
        JP      DISPLAY
; Incremental edits stage the effective list, including the implicit default.
OPTIONS:LD      A,(HL)
        CP      '/'
        JP      NZ,PARSE
        INC     HL
        LD      A,(HL)
        INC     HL
        CP      'A'
        JR      Z,OPTADD
        CP      'D'
        JP      NZ,BADOPT
        LD      A,2
        LD      (MODE),A
        LD      DE,DELKEY
        JR      OPTTAIL
OPTADD: LD      A,1
        LD      (MODE),A
        LD      DE,ADDKEY
OPTTAIL:LD      A,(HL)
        CP      ' '
        JR      Z,OPARG
        OR      A
        JP      Z,BADOPT
OPLONG: LD      A,(DE)
        OR      A
        JR      Z,OPBOUND
        CP      (HL)
        JP      NZ,BADOPT
        INC     HL
        INC     DE
        JR      OPLONG
OPBOUND:LD      A,(HL)
        CP      ' '
        JP      NZ,BADOPT
        JR      OPARG
OPARG:  CALL    SPACES
        OR      A
        JP      Z,BADOPT
        PUSH    HL
        LD      HL,LY_PATH
        LD      A,(HL)
        OR      A
        JR      NZ,STLIVE
        LD      HL,DEFAULT
        LD      A,2
STLIVE: CP      PATHMAX+1
        JP      NC,BADLIVE
        LD      DE,CNT
        LD      C,1+2*PATHMAX
        LD      B,0
        LDIR
        POP     HL
PARSE:  CALL    ENTRY                   ; DE = drive (0=current) and user (FF=current)
        LD      A,(CNT)
        LD      B,A
        LD      A,(HL)
        OR      A
        JR      Z,DELIM
        CP      ' '
        JP      NZ,BADDU
DELIM:  LD      A,(MODE)
        OR      A
        JR      Z,STAGE
        PUSH    HL
        CALL    SPACES
        OR      A
        JP      NZ,BADOPT
        POP     HL
        LD      A,(MODE)
        CP      2
        JP      Z,REMOVE
STAGE:  PUSH    HL
        LD      HL,ITEMS
        LD      A,B
        OR      A
        JR      Z,APPEND
CHECK:  LD      A,(HL)
        INC     HL
        CP      D
        LD      A,(HL)
        INC     HL
        JR      NZ,NXITEM
        CP      E
        JP      Z,DUPERR
NXITEM: DJNZ    CHECK
APPEND: LD      A,(CNT)
        CP      PATHMAX
        JP      NC,FULL
        INC     A
        LD      (CNT),A
        LD      (HL),D
        INC     HL
        LD      (HL),E
        POP     HL
        CALL    SPACES
        OR      A
        JR      NZ,PARSE
PUBLISH:LD      HL,CNT
        LD      DE,LY_PATH
        LD      BC,1+2*PATHMAX
        LDIR
        JP      DISPLAY
REMOVE: LD      HL,ITEMS
RMNEXT: LD      A,(HL)
        INC     HL
        CP      D
        LD      A,(HL)
        INC     HL
        JR      NZ,RMNO
        CP      E
        JR      Z,RMFOUND
RMNO:   DJNZ    RMNEXT
        LD      DE,MMISSING
        JP      FINISH
RMFOUND:LD      A,(CNT)
        CP      1
        JP      Z,LASTERR
        DEC     A
        LD      (CNT),A
        DEC     B
        LD      A,B
        OR      A
        JP      Z,PUBLISH
        ADD     A,A
        LD      C,A
        LD      B,0
        LD      D,H
        LD      E,L
        DEC     DE
        DEC     DE
        LDIR
        JP      PUBLISH
DISPLAY:
        LD      A,80
        LD      (SHWIDTH),A
        CALL    T2_OPEN
        JR      NZ,SHSTART
        LD      DE,5
        ADD     HL,DE
        LD      A,(HL)
        OR      A
        JR      Z,SHSTART
        LD      (SHWIDTH),A
SHSTART:
        LD      DE,TITLE
        CALL    PUTS
        LD      A,5
        LD      (SHCOLUMN),A
        LD      HL,LY_PATH
        LD      B,(HL)
        INC     HL
        LD      A,B
        OR      A
        JR      NZ,SHOW
        LD      HL,DEFAULT+1
        LD      B,2
        JR      SHNEXT
SHOW:   CP      PATHMAX+1
        JP      NC,BADLIVE
SHNEXT: PUSH    BC
        PUSH    HL
        CALL    SHTEXT
        CALL    SHEMIT
        POP     HL
        POP     BC
        INC     HL
        INC     HL
        DJNZ    SHNEXT
        LD      DE,EOL
FINISH: CALL    PUTS
        JP      0

; Build one complete entry before deciding whether it fits on this line.
SHTEXT: LD      DE,SHBUFFER
        LD      (SHEND),DE
        LD      D,(HL)
        INC     HL
        LD      E,(HL)
        LD      (SHDU),DE
        LD      A,D
        OR      A
        JR      NZ,SHFIX
        LD      A,24H                  ; dollar in drive position
        CALL    SHCHAR
        JR      SHUSER
SHFIX:  ADD     A,'A'-1
        CALL    SHCHAR
SHUSER: LD      A,(SHDU)
        CP      0FFH
        JR      NZ,SHNUM
        LD      A,24H
        CALL    SHCHAR
        JR      SHCOL
SHNUM:  LD      D,'0'
TENS:   CP      10
        JR      C,UNITS
        SUB     10
        INC     D
        JR      TENS
UNITS:  LD      E,A
        LD      A,D
        CP      '0'
        CALL    NZ,SHCHAR
        LD      A,E
        ADD     A,'0'
        CALL    SHCHAR
SHCOL:  LD      A,':'
        CALL    SHCHAR
        LD      DE,(SHDU)
        LD      A,D
        OR      A
        JR      Z,SHDONE
        LD      A,E
        CP      0FFH
        JR      Z,SHDONE
        CALL    CN_LOOK
        JR      NZ,SHDONE
        LD      DE,(SHDU)
        LD      A,1
        CALL    CN_CALL
        OR      A
        JR      NZ,SHDONE
        ; Copy the borrowed eight-byte name before any further BDOS calls.
        LD      A,'['
        CALL    SHCHAR
        LD      B,8
SHNAME: LD      A,(HL)
        CP      ' '
        JR      Z,SHCLOSE
        CALL    SHCHAR
        INC     HL
        DJNZ    SHNAME
SHCLOSE:LD      A,']'
        CALL    SHCHAR
SHDONE: XOR     A
        JP      SHCHAR
SHCHAR: PUSH    HL
        LD      HL,(SHEND)
        LD      (HL),A
        INC     HL
        LD      (SHEND),HL
        POP     HL
        RET

SHEMIT: LD      HL,(SHEND)
        LD      DE,SHBUFFER+1
        OR      A
        SBC     HL,DE
        LD      A,L
        LD      (SHLENGTH),A
        LD      C,A
        LD      A,(SHCOLUMN)
        CP      5
        JR      Z,SHFIRST
        ADD     A,3
        JR      C,SHWRAP
        ADD     A,C
        JR      C,SHWRAP
        LD      HL,SHWIDTH
        CP      (HL)
        JR      NC,SHWRAP
        LD      DE,SHSEP
        CALL    PUTS
        LD      A,(SHCOLUMN)
        ADD     A,3
        JR      SHPRINT
SHWRAP: LD      DE,SHCONT
        CALL    PUTS
        LD      A,6
        JR      SHPRINT
SHFIRST:LD      A,' '
        CALL    PUTCH
        LD      A,6
SHPRINT:LD      HL,SHLENGTH
        ADD     A,(HL)
        LD      (SHCOLUMN),A
        LD      HL,SHBUFFER
SHOUT:  LD      A,(HL)
        OR      A
        RET     Z
        CALL    PUTCH
        INC     HL
        JR      SHOUT

; Validate the live layout before using the profile's protected address.
LOCATE: LD      HL,(1)
        LD      DE,LY_BIOS+3
        OR      A
        SBC     HL,DE
        RET     NZ
        LD      HL,(LY_PDSD)
        LD      DE,04D42H               ; BM, ECB version 1 plus symbolic PATH capability
        OR      A
        SBC     HL,DE
        RET     NZ
        LD      A,(LY_PDSD+2)
        CP      1
        RET     NZ
        LD      A,(LY_PDSD+3)
        AND     4
        CP      4
        RET

ENTRY:  PUSH HL
        PUSH BC
        LD B,127
        ; Bound the named-prefix scan at the first space or NUL.
        CALL CN_PREFIX
        POP BC
        JR NC,ENNUMERIC
        POP BC
        RET
ENNUMERIC:
        POP HL
        LD      A,(HL)
        INC     HL
        LD      DE,0
        CP      24H
        JR      Z,ENUSER
        SUB     'A'
        CP      16
        JP      NC,BADDU
        INC     A
        LD      D,A
ENUSER: LD      A,(HL)
        CP      24H
        JR      NZ,ENUM
        INC     HL
        LD      E,0FFH
        JR      ENEND
ENUM:   SUB     '0'
        CP      10
        JP      NC,BADUSER
        LD      E,A
        INC     HL
        LD      A,(HL)
        CP      ':'
        JR      Z,COLON
        CP      ' '
        RET     Z
        OR      A
        RET     Z
        SUB     '0'
        CP      10
        JP      NC,BADUSER
        LD      C,A
        LD      A,E
        ADD     A,A
        ADD     A,A
        ADD     A,E
        ADD     A,A
        ADD     A,C
        CP      32
        JP      NC,BADUSER
        LD      E,A
        INC     HL
ENEND:  LD      A,(HL)
        CP      ':'
        JR      Z,COLON
        CP      ' '
        RET     Z
        OR      A
        RET     Z
        JP      BADUSER
COLON:  INC     HL
        RET
SPACES: LD      A,(HL)
        CP      ' '
        RET     NZ
        INC     HL
        JR      SPACES
EXACT:  LD      A,(DE)
        OR      A
        JR      Z,EXEND
        CP      (HL)
        RET     NZ
        INC     HL
        INC     DE
        JR      EXACT
EXEND:  CALL    SPACES
        OR      A
        RET
PUTS:   LD      C,9
        JP      5
PUTCH:  PUSH    HL
        PUSH    DE
        PUSH    BC
        LD      E,A
        LD      C,2
        CALL    5
        POP     BC
        POP     DE
        POP     HL
        RET
BADOPT: LD      DE,MOPT
        JP      FINISH
LASTERR:LD      DE,MLAST
        JP      FINISH
BADDU:  LD      DE,MDU
        JR      FINISH2
BADUSER:LD      DE,MUSER
        JR      FINISH2
DUPERR: LD      DE,MDUP
        JR      FINISH2
FULL:   LD      DE,MFULL
        JR      FINISH2
NOSYS:  LD      DE,MSYS
        JR      FINISH2
BADLIVE:LD      DE,MLIVE
        JR      FINISH2
FINISH2:JP      FINISH
DEFKEY: DB '/DEFAULT',0
ADDKEY: DB 'DD',0
DELKEY: DB 'EL',0
DEFAULT:DB 2,0,0FFH,1,0
        DS 8
MOPT:   DB 'Use PATH /A /ADD location or /D /DEL location.',13,10,'$'
MMISSING:DB 'PATH entry not found.',13,10,'$'
MLAST:  DB 'Cannot delete the last PATH entry.',13,10,'$'
TITLE:  DB 'PATH:$'
EOL:    DB 13,10,'$'
SHSEP:  DB ' | $'
SHCONT: DB 13,10,'    | $'
MDU:    DB 'Invalid PATH entry. Use a Z-System DU entry.',13,10,'$'
MUSER:  DB 'Invalid PATH user. Use 0 through 31 or a dollar.',13,10,'$'
MDUP:   DB 'Duplicate PATH entry.',13,10,'$'
MFULL:  DB 'PATH accepts up to six entries.',13,10,'$'
MSYS:   DB 'PATH requires a matching BetterCP/M numeric PATH system.',13,10,'$'
MLIVE:  DB 'Invalid live PATH. Use A0:PATH /DEFAULT.',13,10,'$'
; @utility-version PATH@
MODE:   DB 0
CNT:    DB 0
ITEMS:  DS 2*PATHMAX
TAIL:   DS 128
SHDU:   DW 0
SHEND:  DW 0
SHWIDTH:DB 80
SHCOLUMN:DB 0
SHLENGTH:DB 0
SHBUFFER:DS 15
; @ndr-client@
; @path-tcap@
        END
