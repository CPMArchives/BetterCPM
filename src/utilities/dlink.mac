; BetterCP/M checked launcher/capture for unchanged DRI LINK 1.3.
; The complete captured final-address report is validated separately by DSYM.
 ASEG
 ORG 100H
 LD HL,(6)
 LD DE,DL_RES_END+256
 OR A
 SBC HL,DE
 JR C,DL_LOW_RAM
 LD HL,DL_PACKED
 LD DE,DL_RES_START
 LD BC,DL_RES_END-DL_RES_START
 LDIR
 JP DL_BEGIN
DL_LOW_RAM:
 LD DE,DL_LOW_MSG
 LD C,9
 CALL 5
 RET
DL_LOW_MSG: DB 'DLINK: insufficient active TPA.',13,10,'$'
DL_PACKED:
 .PHASE 0A000H
DL_RES_START:
 JP DL_HOOK
DL_BEGIN:
 LD (DL_OLDSP),SP
 LD SP,DL_MAIN_TOP
 LD HL,(6)
 LD (DL_OLD_BDOS),HL
 LD (DL_CHAIN+1),HL
 LD HL,DL_STATE
 LD DE,DL_STATE+1
 LD BC,DL_STATE_END-DL_STATE-1
 LD (HL),0
 LDIR
 LD C,25
 CALL DL_BDOS
 INC A
 LD (DL_OLD_DRIVE),A
 LD (DL_CHILD_DRIVE),A
 LD E,255
 LD C,32
 CALL DL_BDOS
 LD (DL_OLD_USER),A
 LD (DL_CHILD_USER),A
 LD HL,80H
 LD (DL_CHILD_DMA),HL
 LD A,(80H)
 CP 128
 LD DE,DL_USAGE
 JP NC,DL_FAIL
 LD B,A
 LD HL,81H
 CALL DL_TOKEN
 JP C,DL_USAGE_FAIL
 PUSH HL
 PUSH BC
 EX DE,HL
 LD B,A
 CALL DL_PARSE
 LD DE,DL_USAGE
 JP C,DL_FAIL
 LD A,(DL_PARSE_USER)
 LD (DL_OUT_USER),A
 LD HL,DL_FCB
 LD DE,DL_OUT_COM
 LD BC,12
 LDIR
 LD A,(DL_OUT_COM+9)
 CP ' '
 LD DE,DL_USAGE
 JP NZ,DL_FAIL
 LD HL,DL_EXT_COM
 LD DE,DL_OUT_COM+9
 LD BC,3
 LDIR
 LD HL,DL_OUT_COM
 LD DE,DL_OUT_SYM
 LD BC,12
 LDIR
 LD HL,DL_EXT_SYM
 LD DE,DL_OUT_SYM+9
 LD BC,3
 LDIR
 LD HL,DL_OUT_COM
 LD DE,DL_OUT_LOG
 LD BC,12
 LDIR
 LD HL,DL_EXT_LOG
 LD DE,DL_OUT_LOG+9
 LD BC,3
 LDIR
 LD HL,DL_COMMAND
 LD (DL_CMD_PTR),HL
 LD A,' '
 CALL DL_APPEND
 LD HL,DL_OUT_COM
 CALL DL_RENDER
 LD A,'='
 CALL DL_APPEND
 POP BC
 POP HL
 CALL DL_TOKEN
 JR NC,DL_MODULE
 XOR A
 LD (DL_CMD_LEN),A
 LD HL,DL_COMMAND
 LD (DL_CMD_PTR),HL
 LD A,' '
 CALL DL_APPEND
 LD HL,DL_OUT_COM
 CALL DL_RENDER
 JR DL_MODULES_DONE
DL_MODULE:
 PUSH HL
 PUSH BC
 EX DE,HL
 LD B,A
 CALL DL_PARSE
 LD DE,DL_USAGE
 JP C,DL_FAIL
 LD A,(DL_PARSE_USER)
 LD C,A
 LD A,(DL_OUT_USER)
 CP C
 LD DE,DL_USERS_MSG
 JP NZ,DL_FAIL
 LD A,(DL_FCB+9)
 CP ' '
 JR Z,DL_MODULE_VALID
 LD HL,DL_FCB+9
 LD DE,DL_EXT_REL
 LD B,3
 CALL DL_COMPARE
 LD DE,DL_USAGE
 JP NZ,DL_FAIL
DL_MODULE_VALID:
 LD HL,DL_FCB
 CALL DL_RENDER
 POP BC
 POP HL
 CALL DL_TOKEN
 JR C,DL_MODULES_DONE
 PUSH AF
 LD A,','
 CALL DL_APPEND
 POP AF
 JR DL_MODULE
DL_MODULES_DONE:
 ; No A option: the pinned linker's legacy disk scratch path is not enabled.
 LD HL,DL_OUT_COM
 CALL DL_ABSENT
 LD HL,DL_OUT_SYM
 CALL DL_ABSENT
 LD HL,DL_OUT_LOG
 CALL DL_ABSENT
 CALL DL_LOAD_LINK
 CALL DL_MAKE_LOG
 LD HL,0
 LD DE,DL_OLD_ZERO
 LD BC,3
 LDIR
 LD A,0C3H
 LD (0),A
 LD HL,DL_CHILD_DONE
 LD (1),HL
 LD HL,DL_RES_START
 LD (6),HL
 LD A,1
 LD (DL_INSTALLED),A
 LD A,(DL_CMD_LEN)
 LD (80H),A
 LD C,A
 LD B,0
 LD HL,DL_COMMAND
 LD DE,81H
 LDIR
 XOR A
 LD (DE),A
 LD SP,DL_CHILD_TOP
 LD HL,DL_CHILD_DONE
 PUSH HL
 JP 100H

DL_CHILD_DONE:
 LD SP,DL_MAIN_TOP
 CALL DL_UNHOOK
 LD A,(DL_IO_ERROR)
 OR A
 LD DE,DL_IO_MSG
 JP NZ,DL_FAIL
 LD HL,DL_END_MARK
DL_MARK_BYTE:
 LD A,(HL)
 OR A
 JR Z,DL_LOG_FINISH
 CALL DL_LOG_CHAR
 INC HL
 JR DL_MARK_BYTE
DL_LOG_FINISH:
 LD A,26
 CALL DL_LOG_CHAR
 LD A,(DL_USED)
 OR A
 JR Z,DL_LOG_CLOSE
DL_LOG_PAD:
 LD A,26
 CALL DL_LOG_CHAR
 LD A,(DL_USED)
 OR A
 JR NZ,DL_LOG_PAD
DL_LOG_CLOSE:
 LD A,(DL_IO_ERROR)
 OR A
 LD DE,DL_IO_MSG
 JP NZ,DL_FAIL
 CALL DL_SELECT_OUT
 LD DE,DL_LOG_FCB
 LD C,16
 CALL DL_BDOS
 CP 255
 LD DE,DL_CLOSE_MSG
 JP Z,DL_FAIL
 XOR A
 LD (DL_LOG_OPEN),A
 LD HL,DL_OUT_LOG
 CALL DL_ABSENT
 LD HL,DL_LOG_FCB
 LD DE,DL_RENAME
 LD BC,12
 LDIR
 LD HL,DL_OUT_LOG
 LD DE,DL_RENAME+16
 LD BC,12
 LDIR
 LD DE,DL_RENAME
 LD C,23
 CALL DL_BDOS
 CP 255
 LD DE,DL_RENAME_MSG
 JP Z,DL_FAIL
 XOR A
 LD (DL_LOG_LIVE),A
 LD DE,DL_DONE_MSG
 JP DL_FAIL

DL_BDOS:
 PUSH BC
 PUSH DE
 PUSH HL
 PUSH IX
 PUSH IY
 CALL DL_CHAIN
 POP IY
 POP IX
 POP HL
 POP DE
 POP BC
 RET
DL_CHAIN: JP 0
DL_SELECT_OUT:
 LD A,(DL_OUT_USER)
 LD E,A
 LD C,32
 JP DL_BDOS
DL_RESTORE_IO:
 LD A,(DL_CHILD_USER)
 LD E,A
 LD C,32
 CALL DL_BDOS
 LD DE,(DL_CHILD_DMA)
 LD C,26
 JP DL_BDOS
DL_UNHOOK:
 LD A,(DL_INSTALLED)
 OR A
 RET Z
 LD HL,(DL_OLD_BDOS)
 LD (6),HL
 LD HL,DL_OLD_ZERO
 LD DE,0
 LD BC,3
 LDIR
 XOR A
 LD (DL_INSTALLED),A
 RET
DL_USAGE_FAIL:
 LD DE,DL_USAGE
DL_FAIL:
 LD SP,DL_MAIN_TOP
 PUSH DE
 CALL DL_UNHOOK
 LD A,(DL_LOG_OPEN)
 OR A
 JR Z,DL_FAIL_PRINT
 CALL DL_SELECT_OUT
 LD DE,DL_LOG_FCB
 LD C,16
 CALL DL_BDOS
 CP 255
 JR NZ,DL_FAIL_CLOSED
 LD DE,DL_CLOSE_MSG
 LD C,9
 CALL DL_BDOS
DL_FAIL_CLOSED:
 XOR A
 LD (DL_LOG_OPEN),A
DL_FAIL_PRINT:
 POP DE
 LD C,9
 CALL DL_BDOS
 LD A,(DL_LOG_LIVE)
 OR A
 JR Z,DL_RESTORE
 LD DE,DL_RETAIN_MSG
 LD C,9
 CALL DL_BDOS
 LD HL,DL_LOG_FCB
 CALL DL_PRINT_FILE
DL_RESTORE:
 LD A,(DL_OLD_USER)
 LD E,A
 LD C,32
 CALL DL_BDOS
 LD A,(DL_OLD_DRIVE)
 DEC A
 LD E,A
 LD C,14
 CALL DL_BDOS
 LD DE,80H
 LD C,26
 CALL DL_BDOS
 LD SP,(DL_OLDSP)
 RET
DL_PRINT_FILE:
 LD A,(HL)
 ADD A,'@'
 CALL DL_CHAR
 LD A,(DL_OUT_USER)
 LD H,0
 LD L,A
 CALL PN_U16
 LD A,':'
 CALL DL_CHAR
 LD HL,DL_LOG_FCB+1
 LD B,8
DL_PF_BASE:
 LD A,(HL)
 CP ' '
 CALL NZ,DL_CHAR
 INC HL
 DJNZ DL_PF_BASE
 LD A,'.'
 CALL DL_CHAR
 LD B,3
DL_PF_EXT:
 LD A,(HL)
 CALL DL_CHAR
 INC HL
 DJNZ DL_PF_EXT
 LD A,13
 CALL DL_CHAR
 LD A,10
 JP DL_CHAR
PN_CHAR:
DL_CHAR:
 PUSH BC
 PUSH DE
 PUSH HL
 LD E,A
 LD C,2
 CALL DL_BDOS
 POP HL
 POP DE
 POP BC
 RET

; Function-10 is never synthesized. Only the pinned child's console output,
; file status and orderly exit are observed; all real I/O still uses BDOS.
DL_HOOK:
 LD A,C
 OR A
 JP Z,DL_CHILD_DONE
 CP 26
 JR NZ,DL_HOOK_USER
 LD (DL_CHILD_DMA),DE
 JP DL_CHAIN
DL_HOOK_USER:
 CP 32
 JR NZ,DL_HOOK_DRIVE
 LD A,E
 CP 255
 JP Z,DL_CHAIN
 LD (DL_CHILD_USER),A
 JP DL_CHAIN
DL_HOOK_DRIVE:
 CP 14
 JR NZ,DL_HOOK_CON
 LD A,E
 INC A
 LD (DL_CHILD_DRIVE),A
 JP DL_CHAIN
DL_HOOK_CON:
 LD A,C
 CP 2
 JR Z,DL_HOOK_CHAR
 CP 6
 JR NZ,DL_HOOK_STRING
 LD A,E
 CP 255
 JP Z,DL_CHAIN
DL_HOOK_CHAR:
 PUSH AF
 PUSH BC
 PUSH DE
 PUSH HL
 PUSH IX
 PUSH IY
 LD A,E
 CALL DL_LOG_CHAR
 POP IY
 POP IX
 POP HL
 POP DE
 POP BC
 POP AF
 JP DL_CHAIN
DL_HOOK_STRING:
 CP 9
 JR NZ,DL_HOOK_FILE
 PUSH BC
 PUSH DE
 PUSH HL
 PUSH IX
 PUSH IY
 EX DE,HL
DL_HS_BYTE:
 LD A,(HL)
 CP '$'
 JR Z,DL_HS_END
 CALL DL_LOG_CHAR
 INC HL
 JR DL_HS_BYTE
DL_HS_END:
 POP IY
 POP IX
 POP HL
 POP DE
 POP BC
 JP DL_CHAIN
DL_HOOK_FILE:
 LD A,C
 CP 15
 JP C,DL_CHAIN
 CP 24
 JR C,DL_FILE
 CP 33
 JP C,DL_CHAIN
 CP 41
 JP NC,DL_CHAIN
DL_FILE:
 PUSH BC
 PUSH DE
 PUSH HL
 PUSH IX
 PUSH IY
 LD (DL_FUNCTION),A
 LD (DL_CHILD_FCB),DE
 ; All writes/deletes are confined to the two new preflighted outputs.
 CP 19
 JR Z,DL_GUARD_WRITE
 CP 21
 JR Z,DL_GUARD_WRITE
 CP 22
 JR Z,DL_GUARD_WRITE
 CP 23
 JP Z,DL_FILE_DENY
 CP 34
 JR Z,DL_GUARD_WRITE
 CP 40
 JR NZ,DL_FILE_CALL
DL_GUARD_WRITE:
 CALL DL_OUTPUT_MATCH
 JP C,DL_FILE_DENY
 LD (DL_FILE_KIND),A
 LD E,A
 LD D,0
 LD HL,DL_OWN_COM
 ADD HL,DE
 LD A,(DL_FUNCTION)
 CP 19
 JR NZ,DL_GUARD_OWN
 LD A,(HL)
 OR A
 JR NZ,DL_FILE_CALL
 LD A,255
 JP DL_FILE_RETURN
DL_GUARD_OWN:
 CP 22
 JR Z,DL_GUARD_MAKE
 LD A,(HL)
 OR A
 JP Z,DL_FILE_DENY
 JR DL_FILE_CALL
DL_GUARD_MAKE:
 LD A,(DL_FUNCTION)
 CP 22
 JR NZ,DL_FILE_CALL
 ; Recheck absence before each destructive MAKE, using private search DMA.
 CALL DL_SELECT_OUT
 LD DE,DL_IO_BUFFER
 LD C,26
 CALL DL_BDOS
 LD DE,(DL_CHILD_FCB)
 LD C,17
 CALL DL_BDOS
 CP 255
 JP NZ,DL_FILE_DENY
DL_FILE_CALL:
 CALL DL_SELECT_OUT
 LD DE,(DL_CHILD_DMA)
 LD C,26
 CALL DL_BDOS
 LD DE,(DL_CHILD_FCB)
 LD A,(DL_FUNCTION)
 LD C,A
 CALL DL_BDOS
 PUSH AF
 LD B,A
 LD A,(DL_FUNCTION)
 CP 19
 JR Z,DL_ERASE_STATUS
 CP 20
 JR Z,DL_READ_STATUS
 CP 33
 JR Z,DL_READ_STATUS
 CP 21
 JR Z,DL_WRITE_STATUS
 CP 34
 JR Z,DL_WRITE_STATUS
 CP 40
 JR Z,DL_WRITE_STATUS
 CP 15
 JR Z,DL_FF_STATUS
 CP 16
 JR Z,DL_FF_STATUS
 CP 22
 JR NZ,DL_FILE_STATUS
 LD A,B
 CP 255
 JR Z,DL_STATUS_BAD
 LD A,1
 CALL DL_SET_OWN
 JR DL_FILE_STATUS
DL_ERASE_STATUS:
 LD A,B
 CP 255
 JR Z,DL_FILE_STATUS
 XOR A
 CALL DL_SET_OWN
 JR DL_FILE_STATUS
DL_FF_STATUS:
 LD A,B
 CP 255
 JR Z,DL_STATUS_BAD
 JR DL_FILE_STATUS
DL_READ_STATUS:
 LD A,B
 CP 2
 JR NC,DL_STATUS_BAD
 JR DL_FILE_STATUS
DL_WRITE_STATUS:
 LD A,B
 OR A
 JR Z,DL_FILE_STATUS
DL_STATUS_BAD:
 LD A,1
 LD (DL_IO_ERROR),A
DL_FILE_STATUS:
 CALL DL_RESTORE_IO
 POP AF
 JR DL_FILE_RETURN
DL_FILE_DENY:
 LD A,1
 LD (DL_IO_ERROR),A
 CALL DL_RESTORE_IO
 LD A,255
DL_FILE_RETURN:
 POP IY
 POP IX
 POP HL
 POP DE
 POP BC
 RET
DL_SET_OWN:
 PUSH AF
 LD A,(DL_FILE_KIND)
 LD E,A
 LD D,0
 LD HL,DL_OWN_COM
 ADD HL,DE
 POP AF
 LD (HL),A
 RET
DL_OUTPUT_MATCH:
 PUSH DE
 LD HL,DL_OUT_COM
 CALL DL_MATCH_FCB
 POP DE
 JR Z,DL_MATCH_COM
 LD HL,DL_OUT_SYM
 CALL DL_MATCH_FCB
 JR Z,DL_MATCH_SYM
 SCF
 RET
DL_MATCH_COM:
 XOR A
 RET
DL_MATCH_SYM:
 LD A,1
 OR A
 RET
DL_MATCH_FCB:
 LD A,(DE)
 OR A
 JR NZ,DL_MATCH_DRIVE
 LD A,(DL_CHILD_DRIVE)
DL_MATCH_DRIVE:
 CP (HL)
 RET NZ
 INC HL
 INC DE
 LD B,11
DL_MATCH_NAME:
 LD A,(DE)
 AND 127
 CP (HL)
 RET NZ
 INC HL
 INC DE
 DJNZ DL_MATCH_NAME
 XOR A
 RET

; Private log DMA/user selection is restored before returning to LINK.
DL_LOG_CHAR:
 PUSH AF
 PUSH BC
 PUSH DE
 PUSH HL
 LD B,A
 LD A,(DL_IO_ERROR)
 OR A
 JR NZ,DL_LOG_RETURN
 LD A,(DL_USED)
 LD E,A
 LD D,0
 LD HL,DL_LOG_BUFFER
 ADD HL,DE
 LD (HL),B
 INC A
 LD (DL_USED),A
 CP 128
 JR NZ,DL_LOG_RETURN
 XOR A
 LD (DL_USED),A
 CALL DL_SELECT_OUT
 LD DE,DL_LOG_BUFFER
 LD C,26
 CALL DL_BDOS
 LD DE,DL_LOG_FCB
 LD C,21
 CALL DL_BDOS
 OR A
 JR Z,DL_LOG_RESTORE
 LD A,1
 LD (DL_IO_ERROR),A
DL_LOG_RESTORE:
 CALL DL_RESTORE_IO
DL_LOG_RETURN:
 POP HL
 POP DE
 POP BC
 POP AF
 RET
DL_ABSENT:
 PUSH HL
 LD DE,DL_SEARCH
 LD BC,12
 LDIR
 CALL DL_SELECT_OUT
 LD DE,DL_IO_BUFFER
 LD C,26
 CALL DL_BDOS
 LD DE,DL_SEARCH
 LD C,17
 CALL DL_BDOS
 CP 255
 LD DE,DL_EXISTS_MSG
 JP NZ,DL_FAIL
 POP HL
 RET
DL_MAKE_LOG:
 LD HL,DL_OUT_LOG
 LD DE,DL_LOG_FCB
 LD BC,12
 LDIR
 LD HL,DL_TEMP_NAME
 LD DE,DL_LOG_FCB+1
 LD BC,11
 LDIR
 CALL DL_SELECT_OUT
DL_TEMP_TRY:
 LD DE,DL_IO_BUFFER
 LD C,26
 CALL DL_BDOS
 LD DE,DL_LOG_FCB
 LD C,17
 CALL DL_BDOS
 CP 255
 JR Z,DL_TEMP_NEW
 LD HL,DL_LOG_FCB+8
 LD B,5
DL_TEMP_DIGIT:
 INC (HL)
 LD A,(HL)
 CP '9'+1
 JR C,DL_TEMP_TRY
 LD (HL),'0'
 DEC HL
 DJNZ DL_TEMP_DIGIT
 LD DE,DL_CREATE_MSG
 JP DL_FAIL
DL_TEMP_NEW:
 LD DE,DL_LOG_FCB
 LD C,22
 CALL DL_BDOS
 CP 255
 LD DE,DL_CREATE_MSG
 JP Z,DL_FAIL
 LD A,1
 LD (DL_LOG_OPEN),A
 LD (DL_LOG_LIVE),A
 JP DL_RESTORE_IO

DL_LOAD_LINK:
 LD HL,DL_LINK_FCB+12
 LD DE,DL_LINK_FCB+13
 LD BC,23
 LD (HL),0
 LDIR
 LD E,0
 LD C,32
 CALL DL_BDOS
 LD DE,DL_LINK_FCB
 LD C,15
 CALL DL_BDOS
 CP 255
 LD DE,DL_LINK_MSG
 JP Z,DL_FAIL
 CALL D_CRC_RESET
 LD HL,100H
 LD (DL_LOAD_PTR),HL
 LD A,122
 LD (DL_LOAD_LEFT),A
DL_LOAD_RECORD:
 LD DE,(DL_LOAD_PTR)
 LD C,26
 CALL DL_BDOS
 LD DE,DL_LINK_FCB
 LD C,20
 CALL DL_BDOS
 OR A
 LD DE,DL_LINK_MSG
 JP NZ,DL_LOAD_BAD
 LD HL,(DL_LOAD_PTR)
 LD BC,128
 CALL D_CRC_BUFFER
 LD (DL_LOAD_PTR),HL
 LD HL,DL_LOAD_LEFT
 DEC (HL)
 JR NZ,DL_LOAD_RECORD
 LD DE,DL_IO_BUFFER
 LD C,26
 CALL DL_BDOS
 LD DE,DL_LINK_FCB
 LD C,20
 CALL DL_BDOS
 CP 1
 LD DE,DL_LINK_MSG
 JR NZ,DL_LOAD_BAD
 CALL D_CRC_FINISH
 LD HL,D_CRC
 LD DE,DL_LINK_CRC
 LD B,4
 CALL DL_COMPARE
 LD DE,DL_LINK_MSG
 JR NZ,DL_LOAD_BAD
 LD DE,DL_LINK_FCB
 LD C,16
 CALL DL_BDOS
 CP 255
 LD DE,DL_LINK_MSG
 JP Z,DL_FAIL
 JP DL_RESTORE_IO
DL_LOAD_BAD:
 PUSH DE
 LD DE,DL_LINK_FCB
 LD C,16
 CALL DL_BDOS
 POP DE
 JP DL_FAIL

; Bounded command parser. Original DU is the default; compound scopes fail.
DL_TOKEN:
 LD A,B
 OR A
 SCF
 RET Z
 LD A,(HL)
 CP ' '
 JR Z,DL_SKIP
 CP 9
 JR NZ,DL_TOKEN_START
DL_SKIP:
 INC HL
 DJNZ DL_TOKEN
 SCF
 RET
DL_TOKEN_START:
 LD D,H
 LD E,L
 LD C,0
DL_TOKEN_BYTE:
 LD A,(HL)
 CP ' '
 JR Z,DL_TOKEN_END
 CP 9
 JR Z,DL_TOKEN_END
 INC HL
 INC C
 DJNZ DL_TOKEN_BYTE
DL_TOKEN_END:
 LD A,C
 OR A
 RET
DL_PARSE:
 LD A,(DL_OLD_DRIVE)
 DEC A
 LD D,A
 LD A,(DL_OLD_USER)
 LD E,A
 CALL DU_PARSE
 RET C
 PUSH HL
 PUSH BC
 LD BC,0
 CALL DU_NEXT
 JR C,DL_PARSE_BAD
 LD A,D
 INC A
 LD (DL_PARSE_DRIVE),A
 LD A,E
 LD (DL_PARSE_USER),A
 CALL DU_NEXT
 JR NC,DL_PARSE_BAD
 POP BC
 POP HL
 PUSH HL
 PUSH BC
 XOR A
 CALL FP_VALIDATE
 POP BC
 POP HL
 RET C
 PUSH HL
 PUSH BC
 LD HL,DL_FCB
 LD DE,DL_FCB+1
 LD BC,35
 LD (HL),0
 LDIR
 LD HL,DL_FCB+1
 LD B,11
DL_PARSE_BLANK:
 LD (HL),' '
 INC HL
 DJNZ DL_PARSE_BLANK
 POP BC
 POP HL
 LD DE,DL_FCB+1
DL_PARSE_COPY:
 LD A,(HL)
 CP '.'
 JR Z,DL_PARSE_EXT
 CALL DL_UPPER
 LD (DE),A
 INC DE
 JR DL_PARSE_NEXT
DL_PARSE_EXT:
 LD DE,DL_FCB+9
DL_PARSE_NEXT:
 INC HL
 DJNZ DL_PARSE_COPY
 LD A,(DL_PARSE_DRIVE)
 LD (DL_FCB),A
 OR A
 RET
DL_PARSE_BAD:
 POP BC
 POP HL
 SCF
 RET
DL_UPPER:
 CP 'a'
 RET C
 CP 'z'+1
 RET NC
 SUB 32
 RET
DL_RENDER:
 PUSH AF
 PUSH BC
 PUSH DE
 PUSH HL
 LD A,(HL)
 ADD A,'@'
 CALL DL_APPEND
 LD A,':'
 CALL DL_APPEND
 INC HL
 LD B,8
DL_RENDER_BYTE:
 LD A,(HL)
 CP ' '
 JR Z,DL_RENDER_DONE
 CALL DL_APPEND
 INC HL
 DJNZ DL_RENDER_BYTE
DL_RENDER_DONE:
 POP HL
 POP DE
 POP BC
 POP AF
 RET
DL_APPEND:
 PUSH HL
 PUSH DE
 PUSH AF
 LD A,(DL_CMD_LEN)
 CP 125
 LD DE,DL_USAGE
 JP NC,DL_FAIL
 INC A
 LD (DL_CMD_LEN),A
 POP AF
 LD HL,(DL_CMD_PTR)
 LD (HL),A
 INC HL
 LD (DL_CMD_PTR),HL
 POP DE
 POP HL
 RET
DL_COMPARE:
 LD A,(DE)
 CP (HL)
 RET NZ
 INC HL
 INC DE
 DJNZ DL_COMPARE
 RET
 INCLUDE duselect.inc
 INCLUDE filespec.inc
 INCLUDE dasmcrc.inc
 INCLUDE printnum.inc
DL_USAGE: DB 'Usage: DLINK [DU:]base [[DU:]module[.REL] ...]',13,10
 DB 'New COM/SYM/LOG only; modules must use the output user.',13,10,'$'
DL_USERS_MSG: DB 'DLINK: modules and output must use the same user.',13,10,'$'
DL_EXISTS_MSG: DB 'DLINK: COM, SYM or LOG exists; nothing replaced.',13,10,'$'
DL_LINK_MSG: DB 'DLINK: cannot load the pinned B0:LINK.COM 1.3.',13,10,'$'
DL_CREATE_MSG: DB 'DLINK: cannot reserve report scratch.',13,10,'$'
DL_CLOSE_MSG: DB 'DLINK: close failed; report not published.',13,10,'$'
DL_RENAME_MSG: DB 'DLINK: report publication failed.',13,10,'$'
DL_IO_MSG: DB 'DLINK: child/capture I/O failed; outputs unverified.',13,10,'$'
DL_DONE_MSG: DB 'DLINK: report captured; use DSYM base.LOG to validate its map.',13,10,'$'
DL_RETAIN_MSG: DB 'Unverified outputs may remain. Retain report stage: $'
DL_END_MARK: DB 13,10,'DLINK END',13,10,0
DL_TEMP_NAME: DB 'DLG00000$$$'
DL_EXT_COM: DB 'COM'
DL_EXT_SYM: DB 'SYM'
DL_EXT_LOG: DB 'LOG'
DL_EXT_REL: DB 'REL'
DL_LINK_CRC: DB 0EDH,0FH,35H,0D6H
DL_LINK_FCB: DB 2,'LINK    COM'
 DS 24
DL_OLDSP: DW 0
DL_OLD_BDOS: DW 0
DL_STATE:
DL_OLD_USER: DB 0
DL_OLD_DRIVE: DB 0
DL_CHILD_USER: DB 0
DL_CHILD_DRIVE: DB 0
DL_CHILD_DMA: DW 80H
DL_CHILD_FCB: DW 0
DL_OLD_ZERO: DS 3
DL_INSTALLED: DB 0
DL_FUNCTION: DB 0
DL_FILE_KIND: DB 0
DL_OWN_COM: DB 0
DL_OWN_SYM: DB 0
DL_OUT_USER: DB 0
DL_PARSE_USER: DB 0
DL_PARSE_DRIVE: DB 0
DL_IO_ERROR: DB 0
DL_LOG_OPEN: DB 0
DL_LOG_LIVE: DB 0
DL_USED: DB 0
DL_LOAD_PTR: DW 0
DL_LOAD_LEFT: DB 0
DL_CMD_PTR: DW 0
DL_CMD_LEN: DB 0
DL_COMMAND: DS 128
DL_FCB: DS 36
DL_OUT_COM: DS 36
DL_OUT_SYM: DS 36
DL_OUT_LOG: DS 36
DL_LOG_FCB: DS 36
DL_SEARCH: DS 36
DL_RENAME: DS 36
DU_MAP: DS 64
DU_WORK: DS 12
PN_STARTED: DB 0
DL_STATE_END:
DL_LOG_BUFFER: DS 128
DL_IO_BUFFER: DS 128
DL_MAIN_STACK: DS 256
DL_MAIN_TOP:
DL_CHILD_STACK: DS 512
DL_CHILD_TOP:
DL_RES_END:
 .DEPHASE
 END
