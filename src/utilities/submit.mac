; ********************************************************************************
; *                       BetterCP/M SUBMIT Utility                              *
; *                                                                              *
; * CP/M 2.2 positional command-file processor. Retains DRI's public $$$.SUB     *
; * format: counted command records are written in reverse order so the CCP and  *
; * XSUB-compatible input provider need no private pointers surviving in the TPA.*
; ********************************************************************************


BDOS            EQU     0005H

        CSEG
        .PHASE  0100H

; ================================================================================
; =                        Command Tail and Source Setup                         =
; =                                                                              =
; = Preserves the complete command tail before disk I/O replaces DMA, prepares the =
; = source FCB, and establishes positional parameters using stock CP/M semantics. =
; ================================================================================
; -------------------------------------------------------------------------------
; Argument Preservation and FCB Setup
; -------------------------------------------------------------------------------

SU_START:                               ; enter SUBMIT utility
        LD      SP,SU_STACK
        XOR     A
        LD      (SU_OUTLIVE),A
        LD      (SU_SLEFT),A
        LD      HL,SU_RBUF
        LD      (SU_RBP),HL
        LD      HL,SU_LINE
        LD      (HL),'0'
        INC     HL
        LD      (HL),'0'
        INC     HL
        LD      (HL),'1'

  ; Preserve the complete command tail before the first disk read replaces DMA.
  ; Parameter zero is the SUB filename, parameter one the next blank-delimited
  ; word, exactly as in the original utility.
        LD      A,(0080H)
        LD      C,A
        LD      B,0
        LD      HL,0081H
        LD      DE,SU_ARGS
        LD      A,C
        OR      A
        JR      Z,SU_ARGEND
        LDIR

SU_ARGEND:                              ; finish command-tail capture
        XOR     A
        LD      (DE),A

  ; Use the CCP-prepared first default FCB and force the conventional SUB type.
        LD      HL,005CH
        LD      DE,SU_SRCFCB
        LD      BC,36
        LDIR
        LD      HL,SU_SUBTYPE
        LD      DE,SU_SRCFCB+9
        LD      BC,3
        LDIR
        XOR     A
        LD      (SU_SRCFCB+12),A
        LD      (SU_SRCFCB+13),A
        LD      (SU_SRCFCB+14),A
        LD      (SU_SRCFCB+32),A
        LD      DE,SU_IOBUF
        LD      C,26
        CALL    BDOS
        LD      DE,SU_SRCFCB
        LD      C,15
        CALL    BDOS
        INC     A
        JR      NZ,SU_PARSE
        LD      DE,SU_NOSUB
        JP      SU_ERROR

; ================================================================================
; =                           Source Command Expansion                           =
; =                                                                              =
; = Parses source lines, expands $0..$9 positional parameters and caret control escapes, =
; = and accumulates bounded counted commands for later reverse output.           =
; ================================================================================
; -------------------------------------------------------------------------------
; Command-Line Expansion
; -------------------------------------------------------------------------------

SU_PARSE:                               ; parse next source command
        XOR     A
        LD      (SU_RLEN),A

SU_NEXTCH:                              ; process next source character
        CALL    SU_GETSOURCE
        CP      01AH
        JR      Z,SU_EOF
        CP      13
        JR      Z,SU_EOL
        CP      10                      ; CR/LF files count CR as the line terminator
        JR      Z,SU_NEXTCH
        CP      '$'
        JR      Z,SU_DOLLAR
        CP      '^'
        JR      Z,SU_CARET
        CALL    SU_PUTCHAR
        JR      SU_NEXTCH

; -------------------------------------------------------------------------------
; Parameter Expansion
; -------------------------------------------------------------------------------

SU_DOLLAR:                              ; expand positional parameter
        CALL    SU_GETSOURCE
        CP      '$'
        JR      Z,SU_LITERAL
        CP      '0'
        JR      C,SU_PARMERR
        CP      '9'+1
        JR      NC,SU_PARMERR
        SUB     '0'
        CALL    SU_COPYARG
        JR      SU_NEXTCH

SU_LITERAL:                             ; append literal source character
        CALL    SU_PUTCHAR
        JR      SU_NEXTCH

SU_PARMERR:                             ; report invalid parameter reference
        LD      DE,SU_BADPARM
        JP      SU_ERROR

; -------------------------------------------------------------------------------
; Control Escape
; -------------------------------------------------------------------------------

SU_CARET:                               ; expand control-character escape
        CALL    SU_GETSOURCE
        CP      'A'
        JR      C,SU_CTLERR
        CP      'Z'+1
        JR      NC,SU_CTLERR
        SUB     'A'-1
        CALL    SU_PUTCHAR
        JR      SU_NEXTCH

SU_CTLERR:                              ; report invalid control escape
        LD      DE,SU_BADCTL
        JP      SU_ERROR

SU_EOL:                                 ; finish source command line
        CALL    SU_STASHLINE
        CALL    SU_INCLINE
        JR      SU_PARSE

SU_EOF:                                 ; finish source file
        CALL    SU_STASHLINE
        JP      SU_MAKEFILE

  ; Add one command byte.  The stock limit leaves room for count, NUL and '$'
  ; in its 128-byte record.  Aggregate expansion remains bounded at two KiB.

; -------------------------------------------------------------------------------
; Command Buffering
; -------------------------------------------------------------------------------

SU_PUTCHAR:                             ; append command byte
        PUSH    AF
        LD      A,(SU_RLEN)
        CP      125
        JR      NC,SU_TOOLONG
        INC     A
        LD      (SU_RLEN),A
        POP     AF
        CALL    SU_PUTAGG
        RET

SU_TOOLONG:                             ; report overlong command
        POP     AF
        LD      DE,SU_LONGMSG
        JP      SU_ERROR

SU_PUTAGG:                              ; append byte to aggregate buffer
        PUSH    AF
        LD      HL,(SU_RBP)
        LD      DE,SU_RBUFEND
        OR      A
        SBC     HL,DE
        JR      NC,SU_OVERFLOW
        LD      HL,(SU_RBP)
        POP     AF
        LD      (HL),A
        INC     HL
        LD      (SU_RBP),HL
        RET

SU_OVERFLOW:                            ; report aggregate overflow
        POP     AF
        LD      DE,SU_OVRMSG
        JP      SU_ERROR

  ; Empty source lines have no CCP command and consume no $$$.SUB record.

; -------------------------------------------------------------------------------
; Completed Command Storage
; -------------------------------------------------------------------------------

SU_STASHLINE:                           ; store completed command record
        LD      A,(SU_RLEN)
        OR      A
        RET     Z
        CALL    SU_PUTAGG               ; packed representation is text followed by len
        XOR     A
        LD      (SU_RLEN),A
        RET

  ; A selects $0..$9.  Arguments are deliberately blank-delimited: CP/M 2.2
  ; SUBMIT has no quoting language, defaults, or named variables.

; ================================================================================
; =                          Positional Argument Lookup                          =
; =                                                                              =
; = Locates blank-delimited command-tail arguments and copies the selected positional =
; = parameter into the current expanded command.                                 =
; ================================================================================
; -------------------------------------------------------------------------------
; Argument Selection
; -------------------------------------------------------------------------------

SU_COPYARG:                             ; copy positional argument
        LD      B,A
        LD      HL,SU_ARGS
        CALL    SU_ARGSKIP

SU_ARGNTH:                              ; locate requested argument
        LD      A,B
        OR      A
        JR      Z,SU_ARGCOPY

SU_ARGWORD:                             ; scan argument word
        LD      A,(HL)
        OR      A
        RET     Z
        CP      ' '
        JR      Z,SU_ARGNEXT
        INC     HL
        JR      SU_ARGWORD

SU_ARGNEXT:                             ; advance argument scan
        CALL    SU_ARGSKIP
        DJNZ    SU_ARGNTH

SU_ARGCOPY:                             ; copy argument bytes
        LD      A,(HL)
        OR      A
        RET     Z
        CP      ' '
        RET     Z
        INC     HL
        PUSH    HL
        CALL    SU_PUTCHAR
        POP     HL
        JR      SU_ARGCOPY

SU_ARGSKIP:                             ; skip preceding arguments
        LD      A,(HL)
        CP      ' '
        RET     NZ
        INC     HL
        JR      SU_ARGSKIP

  ; Return the next upper-case source byte in A.  EOF, including CP/M's 1Ah text
  ; marker, is 1Ah.  A physical error is reported rather than mistaken for EOF.

; ================================================================================
; =                              Source File Input                               =
; =                                                                              =
; = Provides uppercase buffered source input, recognizes CP/M text EOF, distinguishes =
; = physical read errors, and tracks source line numbers.                        =
; ================================================================================
; -------------------------------------------------------------------------------
; Buffered Source Input
; -------------------------------------------------------------------------------

SU_GETSOURCE:                           ; read next source character
        LD      A,(SU_SLEFT)
        OR      A
        JR      NZ,SU_SGET
        LD      DE,SU_SRCFCB
        LD      C,20
        CALL    BDOS
        OR      A
        JR      Z,SU_SFILL
        DEC     A
        JR      Z,SU_SEOF
        LD      DE,SU_READMSG
        JP      SU_ERROR

SU_SFILL:                               ; fill source input buffer
        LD      HL,SU_IOBUF
        LD      (SU_SPTR),HL
        LD      A,128
        LD      (SU_SLEFT),A

SU_SGET:                                ; return buffered source byte
        LD      HL,(SU_SPTR)
        LD      A,(HL)
        INC     HL
        LD      (SU_SPTR),HL
        LD      HL,SU_SLEFT
        DEC     (HL)
        CP      01AH
        RET     Z
        CP      'a'
        RET     C
        CP      'z'+1
        RET     NC
        AND     05FH
        RET

SU_SEOF:                                ; return source EOF
        LD      A,01AH
        RET

SU_INCLINE:                             ; increment source line count
        LD      HL,SU_LINE+2
        INC     (HL)
        LD      A,(HL)
        CP      '9'+1
        RET     C
        LD      (HL),'0'
        DEC     HL
        INC     (HL)
        LD      A,(HL)
        CP      '9'+1
        RET     C
        LD      (HL),'0'
        DEC     HL
        INC     (HL)
        RET

; ================================================================================
; =                             $$$.SUB Construction                             =
; =                                                                              =
; = Creates the conventional command file and walks the packed command aggregate backward =
; = to write the on-disk stack consumed by the CCP/XSUB path.                    =
; ================================================================================
; -------------------------------------------------------------------------------
; Output File Creation
; -------------------------------------------------------------------------------

SU_MAKEFILE:                            ; create $$$.SUB output
        LD      DE,SU_OUTFCB
        LD      C,19
        CALL    BDOS
        XOR     A
        LD      (SU_OUTFCB+12),A
        LD      (SU_OUTFCB+13),A
        LD      (SU_OUTFCB+14),A
        LD      (SU_OUTFCB+15),A
        LD      (SU_OUTFCB+32),A
        LD      DE,SU_OUTFCB
        LD      C,22
        CALL    BDOS
        INC     A
        JR      NZ,SU_MADE
        LD      DE,SU_DIRMSG
        JP      SU_ERROR

SU_MADE:                                ; begin reverse record output
        LD      A,1
        LD      (SU_OUTLIVE),A
        LD      DE,SU_IOBUF
        LD      C,26
        CALL    BDOS

  ; Walk the packed commands backward.  This produces the on-disk stack consumed
  ; by both the stock CCP and BetterCP/M's compatible command acquisition path.

; -------------------------------------------------------------------------------
; Reverse Record Write
; -------------------------------------------------------------------------------

SU_WRITELOOP:                           ; write next submitted record
        LD      HL,(SU_RBP)
        LD      DE,SU_RBUF
        LD      A,H
        CP      D
        JR      NZ,SU_HAVEREC
        LD      A,L
        CP      E
        JR      Z,SU_CLOSE

SU_HAVEREC:                             ; prepare current record
        DEC     HL
        LD      A,(HL)
        LD      (SU_WLEN),A
        LD      B,A

SU_BACKUP:                              ; walk aggregate backward
        LD      A,B
        OR      A
        JR      Z,SU_BACKDONE
        DEC     HL
        DJNZ    SU_BACKUP

SU_BACKDONE:                            ; finish reverse record copy
        LD      (SU_WPTR),HL
        LD      A,(SU_WLEN)
        LD      (SU_IOBUF),A
        LD      C,A
        LD      B,0
        LD      DE,SU_IOBUF+1
        LD      A,C
        OR      A
        JR      Z,SU_WTERM
        LDIR

SU_WTERM:                               ; terminate submitted command record
        XOR     A
        LD      (DE),A
        INC     DE
        LD      A,'$'
        LD      (DE),A
        LD      DE,SU_OUTFCB
        LD      C,21
        CALL    BDOS
        OR      A
        JR      Z,SU_WNEXT
        LD      DE,SU_WRERR
        JP      SU_ERROR

SU_WNEXT:                               ; advance output record
        LD      HL,(SU_WPTR)
        LD      (SU_RBP),HL
        JR      SU_WRITELOOP

; -------------------------------------------------------------------------------
; Output Close
; -------------------------------------------------------------------------------

SU_CLOSE:                               ; close $$$.SUB
        LD      DE,SU_OUTFCB
        LD      C,16
        CALL    BDOS
        INC     A
        JR      NZ,SU_SUCCESS
        LD      DE,SU_CLERR
        JP      SU_ERROR

SU_SUCCESS:                             ; finish successful submission
        XOR     A
        LD      (SU_OUTLIVE),A
        LD      C,0
        JP      BDOS

  ; All failures return through WBOOT with no partially generated command file.

; ================================================================================
; =                        Completion and Error Handling                         =
; =                                                                              =
; = Closes successful output or reports failures through the common WBOOT path without =
; = leaving a partially generated command file.                                  =
; ================================================================================
; -------------------------------------------------------------------------------
; Failure Reporting
; -------------------------------------------------------------------------------

SU_ERROR:                               ; handle SUBMIT failure
        LD      (SU_ERRPTR),DE
        LD      A,(SU_OUTLIVE)
        OR      A
        JR      Z,SU_ERRPRINT
        LD      DE,SU_OUTFCB
        LD      C,19
        CALL    BDOS
        XOR     A
        LD      (SU_OUTLIVE),A

SU_ERRPRINT:                            ; print SUBMIT error
        LD      DE,SU_ERRHEAD
        LD      C,9
        CALL    BDOS
        LD      DE,SU_LINE
        LD      C,9
        CALL    BDOS
        LD      DE,(SU_ERRPTR)
        LD      C,9
        CALL    BDOS
        LD      C,0
        JP      BDOS

; ================================================================================
; =                        SUBMIT Data and Working State                         =
; =                                                                              =
; = Defines messages, FCBs, saved arguments, disk/source buffers, aggregate pointers, =
; = line/output state, and the utility's private stack.                          =
; ================================================================================
; -------------------------------------------------------------------------------
; Messages and File State
; -------------------------------------------------------------------------------

SU_SUBTYPE:     DB      'SUB'           ; SUB file extension
SU_ERRHEAD:     DB      13,10,'Error On Line ','$' ; error-message prefix
SU_LINE:        DB      '001 ','$'      ; line-number label
SU_NOSUB:       DB      'No ''SUB'' File Present','$' ; source-file missing message
SU_BADPARM:     DB      'Parameter Error','$' ; bad-parameter message
SU_BADCTL:      DB      'Invalid Control Character','$' ; bad-control message
SU_LONGMSG:     DB      'Command Too Long','$' ; command-too-long message
SU_OVRMSG:      DB      'Command Buffer Overflow','$' ; aggregate-overflow message
SU_READMSG:     DB      'Disk Read Error','$' ; source-read error message
SU_WRERR:       DB      'Disk Write Error','$' ; output-write error message
SU_DIRMSG:      DB      'Directory Full','$' ; directory-full message
SU_CLERR:       DB      'Cannot Close, Read/Only?','$' ; output-close error message

SU_SRCFCB:                              ; source command-file FCB
                REPT    36
                DB      0
                ENDM

SU_OUTFCB:      DB      0,'$$$     ','SUB',0,0,0,0 ; $$$.SUB output FCB
                REPT    16
                DB      0
                ENDM
                DB      0,0,0,0

; -------------------------------------------------------------------------------
; Buffers and Parser State
; -------------------------------------------------------------------------------

SU_ARGS:                                ; saved command-tail arguments
                REPT    128
                DB      0
                ENDM

SU_IOBUF:                               ; disk I/O buffer
                REPT    128
                DB      01AH
                ENDM

SU_RBUF:                                ; source read buffer
                REPT    2047            ; DRI rbuff(0) is its reverse-walk sentinel
                DB      0
                ENDM

SU_RBUFEND:                             ; end of source read buffer
                DB      0               ; preserve the original 2K storage footprint

SU_RBP:         DW      0               ; source-buffer pointer
SU_SPTR:        DW      0               ; aggregate command pointer
SU_SLEFT:       DB      0               ; aggregate bytes remaining
SU_RLEN:        DB      0               ; current source-record length
SU_WLEN:        DB      0               ; current output-record length
SU_WPTR:        DW      0               ; current output pointer
SU_ERRPTR:      DW      0               ; current error-message pointer
SU_OUTLIVE:     DB      0               ; output-file live flag
                REPT    32
                DW      0
                ENDM

SU_STACK:                               ; private SUBMIT stack
        .DEPHASE
        END
