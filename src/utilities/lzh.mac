; BetterCP/M standalone LZH, Z80 / CP/M 2.2.
; Usage: LZH [drive:]file [destination-drive:]; destination defaults to logged
; drive, current user. Exact plain 8.3 names only. ABC -> AYC, AYC -> AYY, AYY -> YYY; no extension -> YYY.
; .YYY is refused even with a different destination drive.
; Single pass reads every CP/M record byte, including 1Ah. Header embeds
; original stem, dot and three extension slots (including trailing spaces).
; Only successful encoding, flush and both closes can publish the output.
; LZU00000.$$$ ... LZU99999.$$$ candidates are searched before MAKE.
; Existing files are preserved. Single-task CP/M is assumed: BDOS provides
; no exclusive MAKE/RENAME. Fatal aborts/power loss may leave a temporary.
; Build: python3 tools/build_lzh.py; included on the Utilities disk.

        ORG     100H
        JP      UC_START
        INCLUDE codec.inc
        INCLUDE codec.mac
        INCLUDE lzh.inc
        INCLUDE lzh.mac
        INCLUDE codecfile.mac
        INCLUDE codecver.inc

UC_START:
        LD      (UC_OLDSP),SP
        LD      SP,UC_STACK_TOP
        CALL    UC_VERSION
        JR      NC,UC_START_FILES
        LD      SP,(UC_OLDSP)
        RET
UC_START_FILES:
        XOR     A
        LD      (UC_INPUT_OPEN),A
        LD      (UC_TEMP_OPEN),A
        LD      (UC_TEMP_LIVE),A
        LD      (UC_CLEAN_FAILED),A
        LD      (UC_IN_LEFT),A
        LD      (UC_OUT_USED),A
        ; DS reserves bytes but the assembler need not fill them with zero.
        ; CP/M MAKE preserves EX and LZH: initialize every FCB explicitly.
        LD      HL,UC_INPUT
        LD      DE,UC_INPUT+1
        LD      BC,36*5-1
        LD      (HL),0
        LDIR
        LD      HL,UC_TEMP_NAME
        LD      DE,UC_TEMP+1
        LD      BC,11
        LDIR
        LD      C,25
        CALL    UC_BDOS
        INC     A
        LD      (UC_DRIVE),A
        LD      (UC_DEST),A
        CALL    UC_PARSE
        LD      DE,UC_USAGE
        JP      C,UC_ERROR
        ; Save the canonical name before OPEN changes FCB allocation/state.
        LD      HL,UC_INPUT
        LD      DE,UC_ORIGINAL
        LD      BC,12
        LDIR
        LD      HL,UC_INPUT
        LD      DE,UC_FINAL
        LD      BC,12
        LDIR
        LD      A,(UC_DEST)
        LD      (UC_FINAL),A
        LD      A,(UC_FINAL+9)
        CP      ' '
        JR      Z,UC_FORCE_YYY
        LD      A,(UC_FINAL+10)
        CP      'Y'
        JR      NZ,UC_EXTENSION
        LD      A,(UC_FINAL+11)
        CP      'Y'
        JR      NZ,UC_LAST_Y
        LD      A,(UC_FINAL+9)
        CP      'Y'
        LD      DE,UC_ALREADY_MSG
        JP      Z,UC_ERROR
UC_FORCE_YYY:
        LD      A,'Y'
        LD      (UC_FINAL+9),A
        LD      (UC_FINAL+10),A
UC_LAST_Y:
        LD      A,'Y'
        LD      (UC_FINAL+11),A
        JR      UC_NAMED
UC_EXTENSION:
        LD      A,'Y'
        LD      (UC_FINAL+10),A
UC_NAMED:
        LD      HL,UC_INPUT
        LD      DE,UC_FINAL
        CALL    UC_SAME_NAME
        LD      DE,UC_SAME_INPUT
        JP      Z,UC_ERROR
        LD      DE,UC_FINAL
        CALL    UC_EXISTS
        LD      DE,UC_EXISTS_MSG
        JP      NZ,UC_ERROR
        ; Form the embedded original stem; the extension below keeps its padding.
        LD      HL,UC_ORIGINAL+1
        LD      DE,UC_CONTEXT+LZH_NAME
        LD      B,8
UC_BASE_NAME:
        LD      A,(HL)
        CP      ' '
        JR      Z,UC_BASE_SKIP
        LD      (DE),A
        INC     DE
UC_BASE_SKIP:
        INC     HL
        DJNZ    UC_BASE_NAME
        ; Historical OUTFIL writes dot + all three extension slots,
        ; including spaces for a short or absent extension.
        LD      A,'.'
        LD      (DE),A
        INC     DE
        LD      BC,3
        LDIR
UC_NAME_DONE:
        XOR     A
        LD      (DE),A
        LD      DE,UC_INPUT
        LD      C,15
        CALL    UC_BDOS
        CP      0FFH
        LD      DE,UC_NO_INPUT
        JP      Z,UC_ERROR
        LD      A,1
        LD      (UC_INPUT_OPEN),A
        LD      IX,UC_CONTEXT
        CALL    LZH_INIT
        JP      C,UC_CODEC_ERROR
        CALL    UC_MAKE_TEMP
        JP      C,UC_ERROR
        LD      HL,UC_OUT_BUFFER
        LD      (UC_OUT_PTR),HL
        CALL    LZH_RUN
        JP      C,UC_CODEC_ERROR
        CALL    UC_FINAL_RECORD
        LD      DE,UC_WRITE_MSG
        JP      C,UC_ERROR
        LD      DE,UC_TEMP
        LD      C,16
        CALL    UC_BDOS
        CP      0FFH
        LD      DE,UC_CLOSE_MSG
        JP      Z,UC_ERROR
        XOR     A
        LD      (UC_TEMP_OPEN),A
        LD      DE,UC_INPUT
        LD      C,16
        CALL    UC_BDOS
        CP      0FFH
        LD      DE,UC_CLOSE_MSG
        JP      Z,UC_ERROR
        XOR     A
        LD      (UC_INPUT_OPEN),A
        ; Search can alter DMA; all buffered I/O is already finished.
        LD      DE,UC_FINAL
        CALL    UC_EXISTS
        LD      DE,UC_EXISTS_MSG
        JP      NZ,UC_ERROR
        LD      HL,UC_TEMP
        LD      DE,UC_RENAME
        LD      BC,12
        LDIR
        LD      HL,UC_FINAL
        LD      DE,UC_RENAME+16
        LD      BC,12
        LDIR
        LD      DE,UC_RENAME
        LD      C,23
        CALL    UC_BDOS
        CP      0FFH
        LD      DE,UC_RENAME_MSG
        JP      Z,UC_ERROR
        XOR     A
        LD      (UC_TEMP_LIVE),A
        LD      DE,UC_SUCCESS
        CALL    UC_PRINT
        JP      UC_EXIT

        CODEC_FILE_IO

UC_CODEC_ERROR:
        ; Status is saved in context; cleanup may clobber ordinary registers.
        LD      DE,UC_CODEC_MSG
        CP      CS_READ
        JR      NZ,UC_CODEC_WRITE
        LD      DE,UC_READ_MSG
        JR      UC_ERROR
UC_CODEC_WRITE:
        CP      CS_WRITE
        JR      NZ,UC_ERROR
        LD      DE,UC_WRITE_MSG
        CODEC_FILE_CLEANUP

        CODEC_VERSION_CODE

UC_USAGE:       DB 'Usage: LZH [drive:]file [destination-drive:]',13,10,'$'
UC_SUCCESS:     DB 'LZH: complete.',13,10,'$'
UC_NO_INPUT:    DB 'LZH: cannot open input.',13,10,'$'
UC_ALREADY_MSG: DB 'LZH: cannot compress .YYY names.',13,10,'$'
UC_SAME_INPUT:  DB 'LZH: output would replace input.',13,10,'$'
UC_EXISTS_MSG:  DB 'LZH: output exists; nothing replaced.',13,10,'$'
UC_CREATE_MSG:  DB 'LZH: cannot create temporary output.',13,10,'$'
UC_READ_MSG:    DB 'LZH: input read failed.',13,10,'$'
UC_WRITE_MSG:   DB 'LZH: output write failed.',13,10,'$'
UC_CLOSE_MSG:   DB 'LZH: file close failed.',13,10,'$'
UC_RENAME_MSG:  DB 'LZH: cannot finalize output.',13,10,'$'
UC_CODEC_MSG:   DB 'LZH: encoding failed.',13,10,'$'
UC_CLEAN_MSG:   DB 'LZH: cleanup failed; check temporary files.',13,10,'$'
UC_LEGAL:       DB '!#$%&',27H,'()-@^_{}~'
UC_LEGAL_END:
UC_TEMP_NAME:   DB 'LZU00000$$$'

        CODEC_CODE
        LZH_CODE

UC_OLDSP:       DW 0
UC_DRIVE:       DB 0
UC_DEST:        DB 0
UC_INPUT_OPEN:  DB 0
UC_TEMP_OPEN:   DB 0
UC_TEMP_LIVE:   DB 0
UC_CLEAN_FAILED: DB 0
UC_ARG_PTR:     DW 0
UC_ARG_LEN:     DB 0
UC_IN_PTR:      DW 0
UC_IN_LEFT:     DB 0
UC_OUT_PTR:     DW 0
UC_OUT_USED:    DB 0
UC_INPUT:       DS 36
UC_FINAL:       DS 36
UC_SEARCH:      DS 36
UC_RENAME:      DS 36
UC_TEMP:        DS 36
UC_ORIGINAL:    DS 12
UC_CONTEXT:     DB CX_ABI_VERSION,0,CP_RESET,CS_OK,0,0
                DW UC_READ,UC_WRITE,0,0,LZH_CONTEXT_SIZE
                DS LZH_CONTEXT_SIZE-CX_PREFIX_SIZE
UC_SEARCH_BUFFER: DS 128
UC_IN_BUFFER:   DS 128
UC_OUT_BUFFER:  DS 128
UC_STACK:       DS 256
UC_STACK_TOP:
        END
