; ********************************************************************************
; *                         BetterCP/M WARM Utility                              *
; *                                                                              *
; * Transient warm-boot command for scripts and explicit workflows. Interactive *
; * users normally request the same operation with Control-C at the CCP prompt.  *
; ********************************************************************************


BDOS    EQU     0005H

        CSEG
        .PHASE  0103H

; ================================================================================
; =                            Warm-Boot Request                                =
; =                                                                              =
; = Enters through the normal transient-program path and requests a CP/M warm    =
; = boot through the public page-zero gateway.                                   =
; ================================================================================

START:                                  ; request warm boot
        CALL    UV_CHECK
        LD      C,0
        JP      BDOS

; @utility-version WARM@

        .DEPHASE
        END     START
