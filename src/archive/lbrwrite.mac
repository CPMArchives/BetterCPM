; Staged LBR construction/replay. Emit LBR_WRITE_CODE once, LBR_CRC16 available.
; The caller owns plan authorization and file lifecycle; this owns the format.
LBR_WRITE_CODE MACRO
LW_DISCOVER:
 PUSH IY
 CALL LW_DISCOVER_CORE
 POP IY
 RET
LW_DISCOVER_CORE:
 LD A,(IX+LW_ABI)
 CP 1
 JP NZ,LW_CONFIG
 LW_GET LW_IO
 LD A,H
 OR L
 JP Z,LW_CONFIG
 LW_GET LW_COUNT
 LD DE,513
 OR A
 SBC HL,DE
 JP NC,LW_RANGE
 LD A,(IX+LW_FLAGS)
 AND LF_NEW
 JR Z,LW_DISCOVER_OLD
 LW_GET LW_HEADER
 LD B,32
 XOR A
LW_EMPTY_HEADER:
 LD (HL),A
 INC HL
 DJNZ LW_EMPTY_HEADER
 LW_GET LW_HEADER
 INC HL
 LD B,11
 LD A,' '
LW_EMPTY_NAME:
 LD (HL),A
 INC HL
 DJNZ LW_EMPTY_NAME
 LD (IX+LW_OLDDIR),0
 LD (IX+LW_OLDDIR+1),0
 RET
LW_DISCOVER_OLD:
 CALL LW_IO_ZERO
 LW_GET LW_AUX
 LW_SET LW_IOBUF
 XOR A
 CALL LW_CALL_IO
 RET C
 LW_GET LW_HEADER
 EX DE,HL
 LW_GET LW_AUX
 LD BC,32
 LDIR
 LW_GET LW_HEADER
 LD DE,14
 ADD HL,DE
 LD E,(HL)
 INC HL
 LD D,(HL)
 EX DE,HL
 LW_SET LW_OLDDIR
 CALL LW_SCAN_RESET
LW_DISCOVER_LOOP:
 CALL LW_NEXT_OLD
 JR C,LW_DISCOVER_END
 LD DE,LW_OCCUPIED
 CALL LW_INC32
 JR LW_DISCOVER_LOOP
LW_DISCOVER_END:
 CP AS_END
 JP NZ,LW_ERROR_RESULT
 OR A
 RET

; Canonical name at ENTRY+1; preserve it while scanning original raw entries.
LW_FIND:
 PUSH IY
 LW_GET LW_ENTRY
 INC HL
 PUSH HL
 LW_GET LW_FIRST
 EX DE,HL
 POP HL
 LD BC,11
 LDIR
 CALL LW_SCAN_RESET
LW_FIND_LOOP:
 CALL LW_NEXT_OLD
 JR C,LW_FIND_END
 LW_GET LW_ENTRY
 LD A,(HL)
 OR A
 JR NZ,LW_FIND_LOOP
 INC HL
 LW_GET LW_FIRST
 EX DE,HL
 LW_GET LW_ENTRY
 INC HL
 CALL LW_NAME_EQUAL
 JR NZ,LW_FIND_LOOP
 LD A,1
 OR A
 POP IY
 RET
LW_FIND_END:
 CP AS_END
 JR NZ,LW_FIND_ERROR
 XOR A
 POP IY
 RET
LW_FIND_ERROR:
 SCF
 POP IY
 RET

LW_PLAN:
 PUSH IY
 CALL LW_PLAN_CORE
 POP IY
 RET
LW_PLAN_CORE:
 ; Reset invocation/result counters; discovery's occupied count is retained.
 PUSH IX
 POP HL
 LD DE,LW_KEEP
 ADD HL,DE
 LD B,16
 XOR A
LW_PLAN_CLEAR:
 LD (HL),A
 INC HL
 DJNZ LW_PLAN_CLEAR
 CALL LW_SCAN_RESET
LW_PLAN_OLD:
 CALL LW_NEXT_OLD
 JR C,LW_PLAN_SOURCES
 LW_GET LW_ENTRY
 LD A,(HL)
 OR A
 JR NZ,LW_PLAN_OLD
 CALL LW_DISPLACED
 RET C
 OR A
 JR Z,LW_PLAN_KEEP
 LD DE,LW_MATCHED
 CALL LW_INC32
 JR LW_PLAN_OLD
LW_PLAN_KEEP:
 LD DE,LW_KEEP
 CALL LW_INC32
 JR LW_PLAN_OLD
LW_PLAN_SOURCES:
 CP AS_END
 JP NZ,LW_ERROR_RESULT
 LD HL,0
 LW_SET LW_SOURCE
LW_COUNT_SOURCES:
 CALL LW_PLAN_PTR
 JR C,LW_SIZE_CHOICE
 LD A,(IY+LP_STATUS)
 OR A
 JR Z,LW_COUNT_NEXT
 LD DE,LW_ACCEPTED
 CALL LW_INC32
 LD A,(IY+LP_STATUS)
 CP 1
 JR NZ,LW_COUNT_NEXT
 LD DE,LW_ACTIVE
 CALL LW_INC32
LW_COUNT_NEXT:
 CALL LW_NEXT_SOURCE
 JR LW_COUNT_SOURCES
LW_SIZE_CHOICE:
 ; Actual old capacity = 4*N-1, all arithmetic is 32-bit.
 LW_GET LW_OLDDIR
 LD C,0
 LD B,0
 ADD HL,HL
 RL C
 ADD HL,HL
 RL C
 LD DE,1
 OR A
 SBC HL,DE
 JR NC,LW_OLD_CAP
 DEC C
LW_OLD_CAP:
 LD DE,LW_CAPACITY
 CALL LW_STORE32
 LD A,(IX+LW_FLAGS)
 AND LF_NEW+LF_COMPACT
 JR NZ,LW_REQUIRE_REBUILD
 LD DE,LW_OCCUPIED
 LD BC,LW_ACCEPTED
 CALL LW_ADD_FIELDS
 JR LW_PROPOSED_READY
LW_REQUIRE_REBUILD:
 SET 4,(IX+LW_FLAGS)
 LD DE,LW_KEEP
 LD BC,LW_ACTIVE
 CALL LW_ADD_FIELDS
LW_PROPOSED_READY:
 ; BC:HL now occupied entries required by selected preservation policy.
 LD DE,LW_TEMP
 CALL LW_STORE32
 BIT 3,(IX+LW_FLAGS)
 JR Z,LW_DEFAULT_CHOICE
 LD DE,LW_CAP
 CALL LW_COMPARE_FIELD
 JP C,LW_RANGE
 LD DE,LW_CAP
 CALL LW_LOAD32
 CALL LW_CAP_TO_DIR
 RET C
 JR LW_CHOOSE_DIR
LW_DEFAULT_CHOICE:
 BIT 4,(IX+LW_FLAGS)
 JR NZ,LW_DEFAULT_REBUILD
 LD DE,LW_CAPACITY
 CALL LW_COMPARE_FIELD
 JR NC,LW_KEEP_DIRECTORY
 SET 4,(IX+LW_FLAGS)
LW_DEFAULT_REBUILD:
 BIT 0,(IX+LW_FLAGS)
 JR NZ,LW_DEFAULT_ACTIVE
 BIT 1,(IX+LW_FLAGS)
 JR NZ,LW_KEEP_DIRECTORY
LW_DEFAULT_ACTIVE:
 ; Recompute from final active result. Earlier accepted displaced versions
 ; are preserved only without a layout rebuild.
 LD DE,LW_KEEP
 LD BC,LW_ACTIVE
 CALL LW_ADD_FIELDS
 CALL LW_DEFAULT_DIR
 RET C
 JR LW_CHOOSE_DIR
LW_KEEP_DIRECTORY:
 LW_GET LW_OLDDIR
LW_CHOOSE_DIR:
 LW_SET LW_DIRECTORY
 LD E,(IX+LW_OLDDIR)
 LD D,(IX+LW_OLDDIR+1)
 OR A
 SBC HL,DE
 JR Z,LW_DIR_CHOSEN
 SET 4,(IX+LW_FLAGS)
LW_DIR_CHOSEN:
 LW_GET LW_DIRECTORY
 LD A,H
 OR L
 JP Z,LW_RANGE
 ; Report actual rounded capacity, not an unrounded invocation limit.
 LD BC,0
 ADD HL,HL
 RL C
 ADD HL,HL
 RL C
 LD DE,1
 OR A
 SBC HL,DE
 LD DE,LW_CAPACITY
 JP LW_STORE32

; BC:HL=C ordinary entries, ceil((C+1)/4) = (C+4)/4.
LW_CAP_TO_DIR:
 LD DE,4
 ADD HL,DE
 JR NC,LW_CAP_SHIFT
 INC BC
LW_CAP_SHIFT:
 SRL B
 RR C
 RR H
 RR L
 SRL B
 RR C
 RR H
 RR L
 LD A,B
 OR C
 JP NZ,LW_RANGE
 LD A,H
 OR L
 JP Z,LW_RANGE
 RET
; BC:HL=F. S=max(4,ceil(F/4)); directory ceil((F+S+1)/4).
LW_DEFAULT_DIR:
 PUSH BC
 PUSH HL
 LD DE,3
 ADD HL,DE
 JR NC,LW_SPARE_SHIFT
 INC BC
LW_SPARE_SHIFT:
 SRL B
 RR C
 RR H
 RR L
 SRL B
 RR C
 RR H
 RR L
 LD A,B
 OR C
 JR NZ,LW_SPARE_READY
 LD DE,4
 OR A
 SBC HL,DE
 ADD HL,DE
 JR NC,LW_SPARE_READY
 LD HL,4
LW_SPARE_READY:
 EX DE,HL
 POP HL
 ADD HL,DE
 EX DE,HL
 POP HL
 ADC HL,BC
 LD B,H
 LD C,L
 EX DE,HL
 JP LW_CAP_TO_DIR

; ENTRY active raw name -> A!=0 when removed/replaced. No prompting here.
LW_DISPLACED:
 BIT 2,(IX+LW_FLAGS)
 JR Z,LW_DISPLACED_SOURCES
 LW_GET LW_PATTERN
 EX DE,HL
 LW_GET LW_ENTRY
 INC HL
 LD B,11
LW_PATTERN_LOOP:
 LD A,(DE)
 CP '?'
 JR Z,LW_PATTERN_NEXT
 LD C,A
 LD A,(HL)
 CALL LW_UPPER
 CP C
 JR NZ,LW_NOT_DISPLACED
LW_PATTERN_NEXT:
 INC HL
 INC DE
 DJNZ LW_PATTERN_LOOP
 LD A,1
 OR A
 RET
LW_DISPLACED_SOURCES:
 LW_GET LW_SOURCE
 PUSH HL
 LD HL,0
 LW_SET LW_SOURCE
LW_DISPLACED_LOOP:
 CALL LW_PLAN_PTR
 JR C,LW_DISPLACED_NONE
 LD A,(IY+LP_STATUS)
 OR A
 JR Z,LW_DISPLACED_NEXT
 CALL LW_ID_NAME
 EX DE,HL
 LW_GET LW_ENTRY
 INC HL
 CALL LW_NAME_EQUAL
 JR Z,LW_DISPLACED_FOUND
LW_DISPLACED_NEXT:
 CALL LW_NEXT_SOURCE
 JR LW_DISPLACED_LOOP
LW_DISPLACED_FOUND:
 POP HL
 LW_SET LW_SOURCE
 LD A,1
 OR A
 RET
LW_DISPLACED_NONE:
 POP HL
 LW_SET LW_SOURCE
LW_NOT_DISPLACED:
 XOR A
 RET
LW_NAME_EQUAL:
 LD B,11
LW_NAME_LOOP:
 LD A,(HL)
 CALL LW_UPPER
 LD C,A
 LD A,(DE)
 CP C
 RET NZ
 INC HL
 INC DE
 DJNZ LW_NAME_LOOP
 RET
LW_UPPER:
 CP 'a'
 RET C
 CP 'z'+1
 RET NC
 SUB 32
 RET

LW_SCAN_RESET:
 LD (IX+LW_SCANREC),0
 LD (IX+LW_SCANREC+1),0
 LD (IX+LW_SLOT),1
 RET
LW_NEXT_OLD:
 LW_GET LW_SCANREC
 LD E,(IX+LW_OLDDIR)
 LD D,(IX+LW_OLDDIR+1)
 OR A
 SBC HL,DE
 JR NC,LW_ENTRY_END
 LW_GET LW_SCANREC
 LW_SET LW_IOREC
 LD (IX+LW_IOREC+2),0
 LW_GET LW_AUX
 LW_SET LW_IOBUF
 XOR A
 CALL LW_CALL_IO
 RET C
 LD A,(IX+LW_SLOT)
 LD L,A
 LD H,0
 ADD HL,HL
 ADD HL,HL
 ADD HL,HL
 ADD HL,HL
 ADD HL,HL
 LD E,(IX+LW_AUX)
 LD D,(IX+LW_AUX+1)
 ADD HL,DE
 LD E,(IX+LW_ENTRY)
 LD D,(IX+LW_ENTRY+1)
 LD BC,32
 LDIR
 INC (IX+LW_SLOT)
 LD A,(IX+LW_SLOT)
 CP 4
 JR NZ,LW_OLD_GOT
 LD (IX+LW_SLOT),0
 LW_GET LW_SCANREC
 INC HL
 LW_SET LW_SCANREC
LW_OLD_GOT:
 LW_GET LW_ENTRY
 LD A,(HL)
 CP 255
 JR Z,LW_ENTRY_END
 OR A
 RET
LW_ENTRY_END:
 LD A,AS_END
 SCF
 RET
LW_PLAN_PTR:
 LW_GET LW_SOURCE
 LD E,(IX+LW_COUNT)
 LD D,(IX+LW_COUNT+1)
 OR A
 SBC HL,DE
 JR C,LW_PLAN_IN_RANGE
 SCF
 RET
LW_PLAN_IN_RANGE:
 LW_GET LW_SOURCE
 ADD HL,HL
 ADD HL,HL
 LD D,H
 LD E,L
 ADD HL,HL
 ADD HL,DE
 LD E,(IX+LW_PLANS)
 LD D,(IX+LW_PLANS+1)
 ADD HL,DE
 PUSH HL
 POP IY
 OR A
 RET
LW_ID_NAME:
 LW_GET LW_SOURCE
 LD D,H
 LD E,L
 ADD HL,HL
 ADD HL,DE
 ADD HL,HL
 ADD HL,HL
 ADD HL,DE
 LD E,(IX+LW_IDS)
 LD D,(IX+LW_IDS+1)
 ADD HL,DE
 INC HL
 INC HL
 RET
LW_NEXT_SOURCE:
 LW_GET LW_SOURCE
 INC HL
 LW_SET LW_SOURCE
 RET
LW_IO_ZERO:
 LD (IX+LW_IOREC),0
 LD (IX+LW_IOREC+1),0
 LD (IX+LW_IOREC+2),0
 RET
LW_CALL_IO:
 LD (IX+LW_ACTUAL),0
 LD (IX+LW_ACTUAL+1),0
 PUSH AF
 LW_GET LW_IO
 POP AF
 CALL LB_INDIRECT
 RET C
 LD A,(IX+LW_ACTUAL+1)
 OR A
 JP NZ,LW_TRUNC
 LD A,(IX+LW_ACTUAL)
 CP 128
 RET Z
LW_TRUNC:
 LD A,AS_TRUNC
 SCF
 RET
LW_RANGE:
 LD A,AS_RANGE
 SCF
 RET
LW_CONFIG:
 LD A,AS_CONFIG
 SCF
 RET
; Field operations on 32-bit little endian counts, no wrap accepted.
LW_INC32:
 PUSH IX
 POP HL
 ADD HL,DE
 LD B,4
LW_INC_BYTE:
 INC (HL)
 RET NZ
 INC HL
 DJNZ LW_INC_BYTE
 JP LW_RANGE
LW_STORE32:
 JP LB_STORE32
LW_LOAD32:
 PUSH IX
 POP HL
 ADD HL,DE
 LD E,(HL)
 INC HL
 LD D,(HL)
 INC HL
 LD C,(HL)
 INC HL
 LD B,(HL)
 EX DE,HL
 RET
; Field - BC:HL comparison: C when field is smaller, Z equal.
LW_COMPARE_FIELD:
 JP LB_COMPARE32
; DE=first field offset, BC=second -> BC:HL sum.
LW_ADD_FIELDS:
 PUSH BC
 CALL LW_LOAD32
 POP DE
 PUSH BC
 PUSH HL
 CALL LW_LOAD32
 POP DE
 ADD HL,DE
 POP DE
 PUSH HL
 LD H,B
 LD L,C
 ADC HL,DE
 LD B,H
 LD C,L
 POP HL
 RET
 INCLUDE lbrwrite-render.inc
 ENDM
