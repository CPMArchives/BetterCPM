; Included inside LBR_WRITE_CODE. Deterministic construction/readback replay.
LW_RUN:
 PUSH IY
 CALL LW_RUN_CORE
 POP IY
 RET
LW_RUN_CORE:
 LD (IX+LW_OUTREC),0
 LD (IX+LW_OUTREC+1),0
 LD (IX+LW_OUTREC+2),0
 LD (IX+LW_TEMP),0
 LD (IX+LW_TEMP+1),0
 LD (IX+LW_PHASE),0
 LD HL,0
 LW_SET LW_SOURCE
 CALL LW_SCAN_RESET
 BIT 4,(IX+LW_FLAGS)
 JR NZ,LW_DATA_REBUILD
 LD E,(IX+LW_OLDREC)
 LD D,(IX+LW_OLDREC+1)
 LD A,(IX+LW_OLDREC+2)
 JR LW_DATA_START
LW_DATA_REBUILD:
 LD E,(IX+LW_DIRECTORY)
 LD D,(IX+LW_DIRECTORY+1)
 XOR A
LW_DATA_START:
 LD (IX+LW_DATAREC),E
 LD (IX+LW_DATAREC+1),D
 LD (IX+LW_DATAREC+2),A
LW_DIRECTORY_LOOP:
 LW_GET LW_OUTREC
 LD E,(IX+LW_DIRECTORY)
 LD D,(IX+LW_DIRECTORY+1)
 OR A
 SBC HL,DE
 JP Z,LW_DIRECTORY_DONE
 BIT 4,(IX+LW_FLAGS)
 JR NZ,LW_BLANK_RECORD
 CALL LW_OUTPUT_POSITION
 LW_GET LW_BUFF
 LW_SET LW_IOBUF
 XOR A
 CALL LW_CALL_IO
 RET C
 JR LW_DIR_ROWS
LW_BLANK_RECORD:
 LW_GET LW_BUFF
 LD B,128
 XOR A
LW_ZERO_RECORD:
 LD (HL),A
 INC HL
 DJNZ LW_ZERO_RECORD
 LW_GET LW_BUFF
 LD DE,32
 LD B,4
LW_UNUSED_STATUSES:
 LD (HL),255
 ADD HL,DE
 DJNZ LW_UNUSED_STATUSES
LW_DIR_ROWS:
 LD (IX+LW_ROW),0
LW_DIRECTORY_ROW:
 CALL LW_ROW_PTR
 LD A,(IX+LW_OUTREC)
 OR (IX+LW_OUTREC+1)
 OR (IX+LW_ROW)
 JR NZ,LW_ORDINARY_ROW
 EX DE,HL
 LW_GET LW_HEADER
 LD BC,32
 LDIR
 CALL LW_ROW_PTR
 LD DE,14
 ADD HL,DE
 LD A,(IX+LW_DIRECTORY)
 LD (HL),A
 INC HL
 LD A,(IX+LW_DIRECTORY+1)
 LD (HL),A
 INC HL
 LD (HL),0
 INC HL
 LD (HL),0
 JR LW_ROW_FINISHED
LW_ORDINARY_ROW:
 BIT 4,(IX+LW_FLAGS)
 JR NZ,LW_REBUILD_ROW
 EX DE,HL
 LW_GET LW_ENTRY
 EX DE,HL
 LD BC,32
 LDIR
 LW_GET LW_ENTRY
 LD A,(HL)
 CP 255
 JR Z,LW_APPEND_ROW
 OR A
 JR NZ,LW_ROW_FINISHED
 CALL LW_DISPLACED
 RET C
 OR A
 JR Z,LW_ROW_FINISHED
 LW_GET LW_ENTRY
 LD (HL),0FEH
 JR LW_PUT_ROW
LW_APPEND_ROW:
 CALL LW_NEXT_NEW
 JR NC,LW_PUT_ROW
 CP AS_END
 JP NZ,LW_ERROR_RESULT
 JR LW_ROW_FINISHED
LW_REBUILD_ROW:
 CALL LW_REBUILD_ENTRY
 JR NC,LW_PUT_ROW
 CP AS_END
 JP NZ,LW_ERROR_RESULT
 JR LW_ROW_FINISHED
LW_PUT_ROW:
 CALL LW_ROW_PTR
 EX DE,HL
 LW_GET LW_ENTRY
 LD BC,32
 LDIR
LW_ROW_FINISHED:
 INC (IX+LW_ROW)
 LD A,(IX+LW_ROW)
 CP 4
 JP NZ,LW_DIRECTORY_ROW
 ; Directory CRC always sees zero in the header's own CRC word.
 LW_GET LW_BUFF
 LD E,(IX+LW_TEMP)
 LD D,(IX+LW_TEMP+1)
 LD BC,128
 CALL LBR_CRC16
 LD (IX+LW_TEMP),E
 LD (IX+LW_TEMP+1),D
 LD A,(IX+LW_OUTREC)
 OR (IX+LW_OUTREC+1)
 JR NZ,LW_DIRECTORY_EMIT
 LD A,(IX+LW_VERIFY)
 OR A
 JR Z,LW_SAVE_FIRST
 LW_GET LW_BUFF
 LD DE,16
 ADD HL,DE
 LD A,(IX+LW_DIRCRC)
 LD (HL),A
 INC HL
 LD A,(IX+LW_DIRCRC+1)
 LD (HL),A
 JR LW_DIRECTORY_EMIT
LW_SAVE_FIRST:
 LW_GET LW_FIRST
 EX DE,HL
 LW_GET LW_BUFF
 LD BC,128
 LDIR
LW_DIRECTORY_EMIT:
 CALL LW_EMIT
 RET C
 JP LW_DIRECTORY_LOOP
LW_DIRECTORY_DONE:
 LD A,(IX+LW_VERIFY)
 OR A
 JR Z,LW_PATCH_HEADER
 LW_GET LW_TEMP
 LD E,(IX+LW_DIRCRC)
 LD D,(IX+LW_DIRCRC+1)
 OR A
 SBC HL,DE
 JP NZ,LW_CHECK
 JR LW_PAYLOAD_START
LW_PATCH_HEADER:
 LD A,(IX+LW_TEMP)
 LD (IX+LW_DIRCRC),A
 LD A,(IX+LW_TEMP+1)
 LD (IX+LW_DIRCRC+1),A
 LW_GET LW_FIRST
 LD DE,16
 ADD HL,DE
 LD A,(IX+LW_DIRCRC)
 LD (HL),A
 INC HL
 LD A,(IX+LW_DIRCRC+1)
 LD (HL),A
 CALL LW_IO_ZERO
 LW_GET LW_FIRST
 LW_SET LW_IOBUF
 LD A,3
 CALL LW_CALL_IO
 RET C
LW_PAYLOAD_START:
 BIT 4,(IX+LW_FLAGS)
 JP NZ,LW_REBUILT_PAYLOAD
 LW_GET LW_OLDDIR
 LW_SET LW_POSITION
 LD (IX+LW_POSITION+2),0
LW_PRESERVE_PAYLOAD:
 LD DE,LW_POSITION
 LD BC,LW_OLDREC
 CALL LW_COMPARE3
 JP Z,LW_NEW_PAYLOAD
 CALL LW_READ_POSITION
 RET C
 CALL LW_EMIT
 RET C
 LD DE,LW_POSITION
 CALL LW_INC3
 RET C
 JR LW_PRESERVE_PAYLOAD
LW_REBUILT_PAYLOAD:
 CALL LW_SCAN_RESET
LW_REBUILT_NEXT:
 CALL LW_NEXT_OLD
 JR C,LW_REBUILT_END
 LW_GET LW_ENTRY
 LD A,(HL)
 OR A
 JR NZ,LW_REBUILT_NEXT
 CALL LW_DISPLACED
 RET C
 OR A
 JR NZ,LW_REBUILT_NEXT
 CALL LW_ENTRY_REGION
LW_REBUILT_COPY:
 LD A,(IX+LW_LEFT)
 OR (IX+LW_LEFT+1)
 JR Z,LW_REBUILT_NEXT
 CALL LW_READ_POSITION
 RET C
 CALL LW_EMIT
 RET C
 CALL LW_ADVANCE_REGION
 JR LW_REBUILT_COPY
LW_REBUILT_END:
 CP AS_END
 JP NZ,LW_ERROR_RESULT
LW_NEW_PAYLOAD:
 LD HL,0
 LW_SET LW_SOURCE
LW_NEW_FILE:
 CALL LW_PLAN_PTR
 JP C,LW_RENDER_DONE
 LD A,(IY+LP_STATUS)
 OR A
 JR Z,LW_NEW_FILE_NEXT
 BIT 4,(IX+LW_FLAGS)
 JR Z,LW_NEW_FILE_ACCEPTED
 CP 1
 JR NZ,LW_NEW_FILE_NEXT
LW_NEW_FILE_ACCEPTED:
 LD A,(IY+LP_RECORDS)
 LD (IX+LW_LEFT),A
 LD A,(IY+LP_RECORDS+1)
 LD (IX+LW_LEFT+1),A
 LD (IX+LW_POSITION),0
 LD (IX+LW_POSITION+1),0
 LD (IX+LW_POSITION+2),0
 CALL LW_HASH_BEGIN
LW_NEW_RECORD:
 LD A,(IX+LW_LEFT)
 OR (IX+LW_LEFT+1)
 JR Z,LW_NEW_DIGEST
 CALL LW_POSITION_IO
 LW_GET LW_BUFF
 LW_SET LW_IOBUF
 LD A,1
 CALL LW_CALL_IO
 RET C
 CALL LW_HASH_RECORD
 CALL LW_EMIT
 RET C
 CALL LW_ADVANCE_REGION
 JR LW_NEW_RECORD
LW_NEW_DIGEST:
 CALL LW_PLAN_PTR
 LD A,(IY+LP_CRC)
 CP (IX+LW_CRC)
 JP NZ,LW_CHECK
 LD A,(IY+LP_CRC+1)
 CP (IX+LW_CRC+1)
 JP NZ,LW_CHECK
 PUSH IY
 POP HL
 LD DE,LP_DIGEST
 ADD HL,DE
 PUSH HL
 PUSH IX
 POP HL
 LD DE,LW_DIGEST
 ADD HL,DE
 POP DE
 LD B,4
LW_DIGEST_COMPARE:
 LD A,(DE)
 CP (HL)
 JP NZ,LW_CHECK
 INC HL
 INC DE
 DJNZ LW_DIGEST_COMPARE
LW_NEW_FILE_NEXT:
 CALL LW_NEXT_SOURCE
 JP LW_NEW_FILE
LW_RENDER_DONE:
 ; Allocated positions and emitted physical length must agree.
 LD DE,LW_OUTREC
 LD BC,LW_DATAREC
 CALL LW_COMPARE3
 JP NZ,LW_CHECK
 OR A
 RET

LW_REBUILD_ENTRY:
 LD A,(IX+LW_PHASE)
 OR A
 JP NZ,LW_NEXT_NEW
LW_REBUILD_SCAN:
 CALL LW_NEXT_OLD
 JR C,LW_REBUILD_OLD_END
 LW_GET LW_ENTRY
 LD A,(HL)
 OR A
 JR NZ,LW_REBUILD_SCAN
 CALL LW_DISPLACED
 RET C
 OR A
 JR NZ,LW_REBUILD_SCAN
 ; Recompute CRC over exactly the physical stored records, including padding.
 CALL LW_ENTRY_REGION
 LD (IX+LW_CRC),0
 LD (IX+LW_CRC+1),0
LW_OLD_CRC_RECORD:
 LD A,(IX+LW_LEFT)
 OR (IX+LW_LEFT+1)
 JR Z,LW_OLD_CRC_DONE
 CALL LW_POSITION_IO
 LW_GET LW_AUX
 LW_SET LW_IOBUF
 XOR A
 CALL LW_CALL_IO
 RET C
 LW_GET LW_AUX
 LD E,(IX+LW_CRC)
 LD D,(IX+LW_CRC+1)
 LD BC,128
 CALL LBR_CRC16
 LD (IX+LW_CRC),E
 LD (IX+LW_CRC+1),D
 CALL LW_ADVANCE_REGION
 JR LW_OLD_CRC_RECORD
LW_OLD_CRC_DONE:
 LW_GET LW_ENTRY
 LD DE,16
 ADD HL,DE
 LD A,(IX+LW_CRC)
 LD (HL),A
 INC HL
 LD A,(IX+LW_CRC+1)
 LD (HL),A
 JP LW_ASSIGN_REGION
LW_REBUILD_OLD_END:
 CP AS_END
 JP NZ,LW_ERROR_RESULT
 LD (IX+LW_PHASE),1
 JP LW_NEXT_NEW

LW_NEXT_NEW:
 CALL LW_PLAN_PTR
 JP C,LW_ENTRY_END
 LD A,(IY+LP_STATUS)
 OR A
 JR Z,LW_NEXT_NEW_SKIP
 BIT 4,(IX+LW_FLAGS)
 JR Z,LW_NEW_ENTRY_READY
 CP 1
 JR Z,LW_NEW_ENTRY_READY
LW_NEXT_NEW_SKIP:
 CALL LW_NEXT_SOURCE
 JR LW_NEXT_NEW
LW_NEW_ENTRY_READY:
 LW_GET LW_ENTRY
 LD B,32
 XOR A
LW_CLEAR_ENTRY:
 LD (HL),A
 INC HL
 DJNZ LW_CLEAR_ENTRY
 LW_GET LW_ENTRY
 LD A,(IY+LP_STATUS)
 CP 1
 JR Z,LW_NEW_ACTIVE
 LD (HL),0FEH
LW_NEW_ACTIVE:
 CALL LW_ID_NAME
 PUSH HL
 LW_GET LW_ENTRY
 INC HL
 EX DE,HL
 POP HL
 LD BC,11
 LDIR
 LW_GET LW_ENTRY
 LD DE,14
 ADD HL,DE
 LD A,(IY+LP_RECORDS)
 LD (HL),A
 INC HL
 LD A,(IY+LP_RECORDS+1)
 LD (HL),A
 INC HL
 LD A,(IY+LP_CRC)
 LD (HL),A
 INC HL
 LD A,(IY+LP_CRC+1)
 LD (HL),A
 LW_GET LW_ENTRY
 LD DE,26
 ADD HL,DE
 LD A,(IY+LP_PAD)
 CP 128
 JP NC,LW_RANGE
 LD (HL),A
 CALL LW_NEXT_SOURCE
LW_ASSIGN_REGION:
 LW_GET LW_ENTRY
 LD DE,14
 ADD HL,DE
 LD E,(HL)
 INC HL
 LD D,(HL)
 LD A,D
 OR E
 JR Z,LW_EMPTY_REGION
 LD A,(IX+LW_DATAREC+2)
 OR A
 JP NZ,LW_RANGE
 LW_GET LW_DATAREC
 PUSH HL
 ADD HL,DE
 LW_SET LW_DATAREC
 JR NC,LW_REGION_ADVANCED
 INC (IX+LW_DATAREC+2)
LW_REGION_ADVANCED:
 POP DE
 JR LW_REGION_STORE
LW_EMPTY_REGION:
 LD DE,0
LW_REGION_STORE:
 LW_GET LW_ENTRY
 LD BC,12
 ADD HL,BC
 LD (HL),E
 INC HL
 LD (HL),D
 OR A
 RET
LW_ENTRY_REGION:
 LW_GET LW_ENTRY
 LD DE,12
 ADD HL,DE
 LD A,(HL)
 LD (IX+LW_POSITION),A
 INC HL
 LD A,(HL)
 LD (IX+LW_POSITION+1),A
 LD (IX+LW_POSITION+2),0
 INC HL
 LD A,(HL)
 LD (IX+LW_LEFT),A
 INC HL
 LD A,(HL)
 LD (IX+LW_LEFT+1),A
 RET
LW_ADVANCE_REGION:
 LW_GET LW_LEFT
 DEC HL
 LW_SET LW_LEFT
 LD DE,LW_POSITION
 JP LW_INC3
LW_READ_POSITION:
 CALL LW_POSITION_IO
 LW_GET LW_BUFF
 LW_SET LW_IOBUF
 XOR A
 JP LW_CALL_IO
LW_POSITION_IO:
 LD A,(IX+LW_POSITION)
 LD (IX+LW_IOREC),A
 LD A,(IX+LW_POSITION+1)
 LD (IX+LW_IOREC+1),A
 LD A,(IX+LW_POSITION+2)
 LD (IX+LW_IOREC+2),A
 RET
LW_OUTPUT_POSITION:
 LD A,(IX+LW_OUTREC)
 LD (IX+LW_IOREC),A
 LD A,(IX+LW_OUTREC+1)
 LD (IX+LW_IOREC+1),A
 LD A,(IX+LW_OUTREC+2)
 LD (IX+LW_IOREC+2),A
 RET
LW_ROW_PTR:
 LD A,(IX+LW_ROW)
 LD L,A
 LD H,0
 ADD HL,HL
 ADD HL,HL
 ADD HL,HL
 ADD HL,HL
 ADD HL,HL
 LD E,(IX+LW_BUFF)
 LD D,(IX+LW_BUFF+1)
 ADD HL,DE
 RET
LW_EMIT:
 CALL LW_OUTPUT_POSITION
 LD A,(IX+LW_VERIFY)
 OR A
 JR NZ,LW_VERIFY_RECORD
 LW_GET LW_BUFF
 LW_SET LW_IOBUF
 LD A,3
 CALL LW_CALL_IO
 RET C
 JR LW_EMITTED
LW_VERIFY_RECORD:
 LW_GET LW_AUX
 LW_SET LW_IOBUF
 LD A,2
 CALL LW_CALL_IO
 RET C
 LW_GET LW_BUFF
 LD E,(IX+LW_AUX)
 LD D,(IX+LW_AUX+1)
 LD B,128
LW_VERIFY_BYTE:
 LD A,(DE)
 CP (HL)
 JP NZ,LW_CHECK
 INC DE
 INC HL
 DJNZ LW_VERIFY_BYTE
LW_EMITTED:
 LD DE,LW_OUTREC
 JP LW_INC3
LW_CHECK:
 LD A,AS_CHECK
LW_ERROR_RESULT:
 SCF
 RET
LW_INC3:
 PUSH IX
 POP HL
 ADD HL,DE
 INC (HL)
 RET NZ
 INC HL
 INC (HL)
 RET NZ
 INC HL
 INC (HL)
 RET NZ
 JP LW_RANGE
; Compare two context 24-bit fields. Z equal; C first < second.
LW_COMPARE3:
 PUSH IX
 POP HL
 ADD HL,BC
 PUSH HL
 PUSH IX
 POP HL
 ADD HL,DE
 POP DE
 INC HL
 INC HL
 INC DE
 INC DE
 LD B,3
LW_CMP3_BYTE:
 LD A,(DE)
 LD C,A
 LD A,(HL)
 CP C
 RET NZ
 DEC HL
 DEC DE
 DJNZ LW_CMP3_BYTE
 RET
LW_HASH_BEGIN:
 LD (IX+LW_DIGEST),255
 LD (IX+LW_DIGEST+1),255
 LD (IX+LW_DIGEST+2),255
 LD (IX+LW_DIGEST+3),255
 LD (IX+LW_CRC),0
 LD (IX+LW_CRC+1),0
 RET
LW_HASH_RECORD:
 LW_GET LW_BUFF
 LD E,(IX+LW_CRC)
 LD D,(IX+LW_CRC+1)
 LD BC,128
 CALL LBR_CRC16
 LD (IX+LW_CRC),E
 LD (IX+LW_CRC+1),D
 LW_GET LW_BUFF
 LD C,128
LW_HASH_BYTE:
 LD A,(IX+LW_DIGEST)
 XOR (HL)
 LD (IX+LW_DIGEST),A
 LD B,8
LW_HASH_BIT:
 SRL (IX+LW_DIGEST+3)
 RR (IX+LW_DIGEST+2)
 RR (IX+LW_DIGEST+1)
 RR (IX+LW_DIGEST)
 JR NC,LW_HASH_NEXT_BIT
 LD A,(IX+LW_DIGEST)
 XOR 20H
 LD (IX+LW_DIGEST),A
 LD A,(IX+LW_DIGEST+1)
 XOR 83H
 LD (IX+LW_DIGEST+1),A
 LD A,(IX+LW_DIGEST+2)
 XOR 0B8H
 LD (IX+LW_DIGEST+2),A
 LD A,(IX+LW_DIGEST+3)
 XOR 0EDH
 LD (IX+LW_DIGEST+3),A
LW_HASH_NEXT_BIT:
 DJNZ LW_HASH_BIT
 INC HL
 DEC C
 JR NZ,LW_HASH_BYTE
 RET
