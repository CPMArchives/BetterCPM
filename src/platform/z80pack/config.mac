        INCLUDE layout.inc
        INCLUDE bioslinks.inc
        INCLUDE cpxlinks.inc
; Z80PACK RAW-DISK CONFIGURATION OVERLAY
;
; Vector ABI shared with the common disk service.  cpmsim has no physical
; formatter.  The format vector initializes every mapped raw record to E5 for
; uniform formats; physical and logical definitions are runtime-settable.

        ASEG
        ORG LY_CFG

        JP ZC_PHYS
        JP ZC_LOG
        JP ZC_FORMAT
        JP BF_CPXCTL
        JP ZC_GETPH
        JP ZC_GETLOG
        JP ZC_UNSUP

; IX=request.  Byte 0 is the physical-drive number; bytes 1..6 are the
; six-byte BetterCP/M physical descriptor.
ZC_PHYS:
        LD A,(IX+0)
        CP 4
        JP NC,ZC_INVALID
        LD (ZC_DRIVE),A
        LD A,(IX+2)
        OR A
        JP Z,ZC_INVALID
        LD A,(IX+3)
        DEC A
        CP 2
        JP NC,ZC_INVALID

        LD A,(ZC_DRIVE)
        CALL ZC_PHY
        EX DE,HL
        PUSH IX
        POP HL
        INC HL
        LD BC,6
        LDIR
        JP ZC_OK

; IX=request. Byte 0 is logical drive; bytes 1..64 are the normalized
; logical binding used at LY_TAB+16.
ZC_LOG:
        LD A,(IX+0)
        CP 4
        JP NC,ZC_INVALID
        OR A
        JP Z,ZC_UNSUP          ; A: remains the fixed bootstrap filesystem
        LD (ZC_DRIVE),A

        LD A,(IX+1)
        CP 0FFH
        JP NZ,ZC_ATTACH
        LD A,(ZC_DRIVE)
        CALL ZC_DPH
        LD DE,16
        ADD HL,DE
        LD (HL),0FFH
        JP ZC_OK

; IX=request: logical drive, cylinder, side, stream length, stream address.
; A raw image has no WD track structure to generate.  Formatting therefore
; writes an E5-filled physical sector through the resident mapper for every
; logical record which belongs to the requested surface.  Repeated records in
; a multi-record physical sector are harmless and keep this overlay compact.
; Optional FDF conventions and explicit mixed-size maps are rejected because
; their mapper may require a recursive BDOS service call.
ZC_FORMAT:
        PUSH IY
        LD A,(IX+0)
        OR A
        JP Z,ZCF_UNSUP
        CP 4
        JP NC,ZCF_INVALID
        CALL ZC_DPH
        LD DE,16
        ADD HL,DE
        PUSH HL
        POP IY
        LD A,(IY+19)
        AND 00FH
        JP NZ,ZCF_UNSUP
        LD A,(IY+52)
        OR A
        JP NZ,ZCF_UNSUP
        LD A,(IX+1)
        CP (IY+16)
        JP NC,ZCF_INVALID
        LD (ZCF_CYL),A
        LD A,(IX+2)
        CP 2
        JP NC,ZCF_INVALID
        LD (ZCF_SIDE),A

; Validate and fill the caller's first 1K of track workspace.
        LD L,(IX+5)
        LD H,(IX+6)
        LD A,H
        OR A
        JP Z,ZCF_INVALID
        PUSH HL
        LD DE,1024
        ADD HL,DE
        LD DE,LY_TPA
        OR A
        SBC HL,DE
        POP HL
        JP NC,ZCF_INVALID
        LD (HL),0E5H
        LD D,H
        LD E,L
        INC DE
        LD BC,1023
        LDIR
        LD L,(IX+5)
        LD H,(IX+6)
        LD (ZCF_BUFFER),HL

; Derive the logical track and record interval for this physical surface.
        LD A,(ZCF_CYL)
        LD (ZCF_TRACK),A
        LD HL,0
        LD (ZCF_FIRST),HL
        LD L,(IY+1)
        LD H,(IY+2)
        LD A,(IY+19)
        BIT 5,A
        JR NZ,ZCF_CYLINDER
        BIT 6,A
        JR Z,ZCF_SINGLE
        LD A,(ZCF_TRACK)
        ADD A,A
        LD B,A
        LD A,(ZCF_SIDE)
        ADD A,B
        LD (ZCF_TRACK),A
        JR ZCF_RANGE
ZCF_SINGLE:
        LD A,(ZCF_SIDE)
        OR A
        JR NZ,ZCF_INVALID
        JR ZCF_RANGE
ZCF_CYLINDER:
        SRL H
        RR L
        LD A,(ZCF_SIDE)
        OR A
        JR Z,ZCF_RANGE
        LD (ZCF_FIRST),HL
ZCF_RANGE:
        LD DE,(ZCF_FIRST)
        ADD HL,DE
        LD (ZCF_LIMIT),HL

        LD A,(IX+0)
        LD (BIO_DRIVE),A
        LD A,(ZCF_TRACK)
        LD (BIO_TRACK),A
        XOR A
        LD (BIO_TRACK+1),A
        LD HL,(ZCF_FIRST)
ZCF_RECORD:
        LD (BIO_SECTOR),HL
        PUSH HL
        CALL LY_DISK+3
        POP DE
        OR A
        JR NZ,ZCF_IOERR
        PUSH DE
        LD HL,(ZCF_BUFFER)
        CALL LY_DISK+12
        POP HL
        OR A
        JR NZ,ZCF_IOERR
        INC HL
        LD DE,(ZCF_LIMIT)
        OR A
        SBC HL,DE
        ADD HL,DE
        JR C,ZCF_RECORD
        POP IY
        JP ZC_OK

ZCF_IOERR:
        LD L,A
        LD H,0
        POP IY
        POP IX
        OR A
        RET
ZCF_INVALID:
        POP IY
        JP ZC_INVALID
ZCF_UNSUP:
        POP IY
        JP ZC_UNSUP

ZC_ATTACH:
        CP 4
        JP NC,ZC_INVALID
        CALL ZC_PHY
        LD (ZC_PHYPTR),HL

; Logical track/cylinder count must fit the selected virtual drive.
        LD A,(IX+17)
        OR A
        JP Z,ZC_INVALID
        LD HL,(ZC_PHYPTR)
        INC HL
        LD A,(HL)
        CP (IX+17)
        JP C,ZC_UNSUP
        INC HL

; Standard and cylinder-track double-sided definitions need two surfaces.
        LD A,(IX+20)
        AND 060H
        JR Z,ZC_SIDEOK
        LD A,(HL)
        CP 2
        JP NZ,ZC_UNSUP
ZC_SIDEOK:

; Optional FDF conventions require the mapper RSX.
        LD A,(IX+20)
        AND 00FH
        JR Z,ZC_FDFOK
        PUSH IX
        LD BC,000D1H
        CALL 5
        POP IX
        LD DE,04644H
        OR A
        SBC HL,DE
        JP NZ,ZC_UNSUP
ZC_FDFOK:

        LD A,(IX+18)
        OR A
        JP Z,ZC_INVALID
        CP 33
        JP NC,ZC_UNSUP
        LD A,(IX+19)
        CP 4
        JP NC,ZC_UNSUP

; Uniform geometry needs no size map.  Anything else is validated and,
; where applicable, normalized by FDF.RSX operation 2.
        LD L,(IX+18)
        LD H,0
        LD A,(IX+19)
        OR A
        JR Z,ZC_SPTDONE
ZC_SPTSHIFT:
        ADD HL,HL
        DEC A
        JR NZ,ZC_SPTSHIFT
ZC_SPTDONE:
        LD A,(IX+3)
        CP H
        JR NZ,ZC_MIXED
        LD A,(IX+2)
        CP L
        JR NZ,ZC_MIXED
        LD (IX+53),0
        JR ZC_GEOMOK
ZC_MIXED:
        PUSH IX
        LD BC,002D1H
        CALL 5
        POP IX
        LD DE,04644H
        OR A
        SBC HL,DE
        JP NZ,ZC_INVALID
ZC_GEOMOK:

; Operation 2 may normalize a cylinder-track format by setting bit 5.
        LD A,(IX+20)
        AND 060H
        JR Z,ZC_NORMOK
        LD A,(IX+1)
        CALL ZC_PHY
        INC HL
        INC HL
        LD A,(HL)
        CP 2
        JP NZ,ZC_UNSUP
ZC_NORMOK:

; BSH/BLM and DSM must be structurally plausible for CP/M 2.2.
        LD A,(IX+4)
        CP 3
        JP C,ZC_INVALID
        CP 8
        JP NC,ZC_INVALID
        LD B,A
        LD A,1
ZC_BLMSH:
        ADD A,A
        DJNZ ZC_BLMSH
        DEC A
        CP (IX+5)
        JP NZ,ZC_INVALID
        LD A,(IX+10)
        CP 2
        JP NC,ZC_UNSUP
        LD A,(IX+14)
        OR A
        JP NZ,ZC_INVALID

; Sector IDs in one physical track must be unique.
        PUSH IX
        POP HL
        LD DE,21
        ADD HL,DE
        LD B,(IX+18)
ZC_SKEW:
        LD A,(HL)
        PUSH BC
        PUSH HL
        INC HL
        DEC B
        JR Z,ZC_SKDONE
ZC_SKCMP:
        CP (HL)
        JR Z,ZC_SKBAD
        INC HL
        DJNZ ZC_SKCMP
ZC_SKDONE:
        POP HL
        POP BC
        INC HL
        DJNZ ZC_SKEW

; Install the complete normalized 64-byte binding.
        LD A,(ZC_DRIVE)
        CALL ZC_DPH
        LD DE,16
        ADD HL,DE
        EX DE,HL
        PUSH IX
        POP HL
        INC HL
        LD BC,64
        LDIR
        JP ZC_OK

ZC_SKBAD:
        POP HL
        POP BC
        JP ZC_INVALID

; These getters are present because the overlay ABI reserves the vectors,
; although z80pack's resident disk service normally handles operations 1/3.
ZC_GETPH:
        LD A,(IX+0)
        CP 4
        JP NC,ZC_INVALID
        CALL ZC_PHY
        LD BC,6
        JR ZC_COPY

ZC_GETLOG:
        LD A,(IX+0)
        CP 4
        JP NC,ZC_INVALID
        CALL ZC_DPH
        LD DE,16
        ADD HL,DE
        LD BC,64
ZC_COPY:
        PUSH IX
        POP DE
        INC DE
        LDIR
ZC_OK:
        XOR A
        JR ZC_RESULT
ZC_INVALID:
        LD A,1
        JR ZC_RESULT
ZC_UNSUP:
        LD A,2
ZC_RESULT:
        LD L,A
        LD H,0
        POP IX
        RET

; A=physical drive 0..3 -> HL six-byte descriptor.
ZC_PHY:
        LD E,A
        ADD A,A
        ADD A,A
        ADD A,E
        ADD A,E
        LD E,A
        LD D,0
        LD HL,ZP_PHYSICAL
        ADD HL,DE
        RET

; A=logical drive 0..3 -> HL 80-byte DPH record.
ZC_DPH:
        LD HL,LY_TAB
        LD DE,80
        OR A
        RET Z
ZC_DPHLP:
        ADD HL,DE
        DEC A
        JR NZ,ZC_DPHLP
        RET

; Replaced by tools/build_z80pack_image.py with the resident symbol address.
ZP_PHYSICAL EQU 0FFFFH

ZC_DRIVE:  DB 0
ZC_PHYPTR: DW 0
ZCF_BUFFER:DW 0
ZCF_FIRST: DW 0
ZCF_LIMIT: DW 0
ZCF_TRACK: DB 0
ZCF_CYL:   DB 0
ZCF_SIDE:  DB 0
