        INCLUDE layout.inc
        INCLUDE romlinks.inc

; ********************************************************************************
; *                    z80pack ROM Cold Initialization                           *
; *                                                                              *
; * Copies the accepted RAM template, publishes the live BDOS gateway, and       *
; * invalidates persistent history and loader recovery on true cold entry.     *
; ********************************************************************************

  ; Entry contract:
  ;   HL = immutable RAM-template address
  ;   IX = immutable BDOS entry address
  ;   SP = valid stack outside LY_TPA through LY_TPA+RI_BYTES-1
  ; The routine is position independent. It changes only the accepted RAM image,
  ; the page-zero loader recovery flag, and ordinary register/flag state.

        ASEG
        ORG     RI_ORIGIN

; ================================================================================
; =                         Cold RAM Instantiation                               =
; =                                                                              =
; = Copies immutable defaults, publishes the gateway, and invalidates cold-only   =
; = history and interrupted-lookup state absent from the template.                =
; ================================================================================

RI_INIT:                                ; instantiate the complete live RAM image
        LD      DE,LY_TPA
        LD      BC,RI_BYTES
        LDIR

        LD      A,0C3H                  ; publish JP immutable-BDOS-entry
        LD      (LY_TPA),A
        LD      (LY_TPA+1),IX

        XOR     A                       ; history owner sees an invalid signature
        LD      (LY_HIST),A
  ; Cold RAM has no interrupted lookup to recover. CL_ABORT runs during
  ; reconstruction before the CCP can initialize this page-zero workspace.
  ; A random active bit otherwise restores an uninitialized saved user.
  ; Warm entry deliberately preserves the flag for genuine loader aborts.
        LD      (0048H),A
        RET

        END
