; cpmsim-only exit utility. Query dispatch precedes all input and port I/O.
        ASEG
        ORG 0100H
        LD (OLDSP),SP
        LD SP,STACKTOP
        PUSH IX
        PUSH IY
        LD A,(0080H)
        CP 128
        JP NC,BADARGS
        LD B,A
        LD HL,0081H
        LD DE,HELPTEXT
        CALL UH_QUERY
        JP C,DONE
        LD DE,VERTEXT
        CALL UV_QUERY
        JP C,DONE
; Validate the entire tail before acting on /Y. Space/TAB delimiters only.
        LD A,(0080H)
        LD B,A
        LD HL,0081H
        XOR A
        LD (YESFLAG),A
SCAN:   LD A,B
        OR A
        JR Z,PARSED
        LD A,(HL)
        CP ' '
        JR Z,SPACE
        CP 9
        JR Z,SPACE
        CP '/'
        JR NZ,BADARGS
        INC HL
        DEC B
        JR Z,BADARGS
        LD A,(HL)
        AND 0DFH
        CP 'Y'
        JR NZ,BADARGS
        INC HL
        DEC B
        LD A,1
        LD (YESFLAG),A
        LD A,B
        OR A
        JR Z,PARSED
        LD A,(HL)
        CP ' '
        JR Z,SPACE
        CP 9
        JR NZ,BADARGS
SPACE:  INC HL
        DEC B
        JR SCAN
PARSED: LD A,(YESFLAG)
        OR A
        JR NZ,SHUTDOWN
ASK:    CALL UC_RUN
        CP UI_SEND
        JR Z,BY_VALUE
        CP UI_DEF
        JR NZ,CANCEL
BY_VALUE:
        LD A,(UC_VALUE)
        CP 'Y'
        JR NZ,CANCEL
CONFIRM:
        LD DE,YESLINE
        CALL PRINT
SHUTDOWN:
        LD A,0AAH
        OUT (0A0H),A
        LD A,080H
        OUT (0A0H),A
        DI
        HALT
        JR DONE
CANCEL: LD DE,NOLINE
        CALL PRINT
        JR DONE
BADARGS:
        LD DE,USAGE
        CALL PRINT
DONE:   POP IY
        POP IX
        LD SP,(OLDSP)
        RET
PRINT:  LD C,9
        JP 00005H
PROMPT: DB 'Exit cpmsim? (Y/N) [N]: $'
YESLINE:DB 'Y',13,10,'$'
NOLINE: DB 'N',13,10,'$'
NEWLINE:DB 13,10,'$'
USAGE:  DB 'Usage: BYE [/Y]',13,10,'Use BYE /HELP for help.',13,10,'$'
; Existing raw-key policy: CR/LF selects No, ESC/^C cancels, any other
; invalid key repaints the question. No typeahead purge or text editor.
UIREAD:
        LD C,6
        LD E,0FFH
        CALL 00005H
        OR A
        JR Z,UIREAD
        CP 10
        JR NZ,BY_FOLD
        LD A,13
        RET
BY_FOLD:
        CP 13
        RET Z
        CP 27
        RET Z
        CP 3
        RET Z
        AND 0DFH
        CP 'Y'
        RET Z
        CP 'N'
        RET Z
        XOR A
        RET
UC_PAINT:
        LD A,(BY_PAINTED)
        OR A
        JR Z,BY_QUESTION
        LD DE,NEWLINE
        CALL PRINT
BY_QUESTION:
        LD A,1
        LD (BY_PAINTED),A
        LD DE,PROMPT
        JP PRINT
UI_VALID:
        OR A
        RET
UI_CLOSE:
UC_ERROR:
        RET
BY_CHOICES: DB 'YN'
BY_PAINTED: DB 0
UC_LIST: DW BY_CHOICES
UC_COUNT: DB 2
UC_DEF: DB 'N'
UC_VALUE: DB 0
; @bye-choice@
; @bye-text@
; @bye-queries@
OLDSP:  DS 2
YESFLAG:DS 1
STACK:  DS 256
STACKTOP:
        END
