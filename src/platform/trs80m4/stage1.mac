        INCLUDE layout.inc

; ********************************************************************************
; *                BetterCP/M TRS-80 Model 4 Resident-System Loader              *
; *                                                                              *
; * Stage-one loader that reads the protected resident system image from its      *
; * generated physical-sector table into the shared production memory map, then  *
; * enters BIOS BOOT to initialize the portable operating-system environment.     *
; ********************************************************************************

        INCLUDE hardware.inc

SYSIMAGE        EQU     LY_SYS
SYSBOOT         EQU     LY_BIOS+0       ; enter BIOS BOOT, which initializes the console
SYSSECTORS      EQU     LY_SECTS

        CSEG
        .PHASE  STAGE1BASE

; ================================================================================
; =                         Resident System Load                                =
; =                                                                              =
; = Walks the generated physical-sector table, loads each resident-system sector =
; = into its final memory location, and transfers control to BIOS BOOT.           =
; ================================================================================

STAGE1:                                 ; enter resident-system loader
        DI
        LD      SP,STAGE1STACK
        LD      HL,SYSTABLE
        LD      (SYSTABP),HL
        LD      HL,SYSIMAGE
        LD      (SYSDEST),HL
        LD      A,SYSSECTORS
        LD      (SYSLEFT),A

SYSLOAD:                                ; load next resident-system sector
        LD      HL,(SYSTABP)
        LD      A,(HL)
        INC     HL
        LD      B,(HL)
        INC     HL
        LD      C,(HL)
        INC     HL
        LD      (SYSTABP),HL
        LD      HL,(SYSDEST)
        CALL    M4_READ
        JR      NZ,SYSERROR
        LD      (SYSDEST),HL
        LD      A,(SYSLEFT)
        DEC     A
        LD      (SYSLEFT),A
        JR      NZ,SYSLOAD
        JP      SYSBOOT

SYSERROR:                               ; halt after system-load failure
        JR      SYSERROR

; -------------------------------------------------------------------------------
; Sector Table and Loader State
; -------------------------------------------------------------------------------

SYSTABLE:                               ; resident-system sector table
  ; @resident-sector-table@

SYSTABP:                                ; current sector-table pointer
        DW      0

SYSDEST:                                ; current system-image destination
        DW      SYSIMAGE

SYSLEFT:                                ; resident sectors remaining
        DB      SYSSECTORS

; -------------------------------------------------------------------------------
; Minimal Disk Binding
; -------------------------------------------------------------------------------

B_PDrive:                               ; system-image physical drive
        DB      1                       ; stage one always loads the system from A:

M4_READ_ONLY    EQU     1
M4_MULTI_DRIVE  EQU     1
        INCLUDE m4disk.inc

        .DEPHASE
        END
