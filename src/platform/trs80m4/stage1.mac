        INCLUDE layout.inc
; BetterCP/M TRS-80 Model 4 resident-system loader

        INCLUDE hardware.inc

SYSIMAGE        EQU     LY_SYS
SYSBOOT         EQU     LY_BIOS+0  ; enter BIOS BOOT, which initializes the console
SYSSECTORS      EQU     LY_SECTS

        CSEG
        .PHASE  STAGE1BASE

STAGE1:
        DI
        LD      SP,STAGE1STACK
        LD      HL,SYSTABLE
        LD      (SYSTABP),HL
        LD      HL,SYSIMAGE
        LD      (SYSDEST),HL
        LD      A,SYSSECTORS
        LD      (SYSLEFT),A
SYSLOAD:
        LD      HL,(SYSTABP)
        LD      A,(HL)
        INC     HL
        LD      B,(HL)
        INC     HL
        LD      C,(HL)
        INC     HL
        LD      (SYSTABP),HL
        LD      HL,(SYSDEST)
        CALL    M4_READ
        JR      NZ,SYSERROR
        LD      (SYSDEST),HL
        LD      A,(SYSLEFT)
        DEC     A
        LD      (SYSLEFT),A
        JR      NZ,SYSLOAD
        JP      SYSBOOT
SYSERROR:
        JR      SYSERROR

SYSTABLE:
; @resident-sector-table@

SYSTABP:
        DW      0
SYSDEST:
        DW      SYSIMAGE
SYSLEFT:
        DB      SYSSECTORS
B_PDrive:
        DB      1               ; stage one always loads the system from A:

M4_READ_ONLY    EQU     1
M4_MULTI_DRIVE  EQU     1
        INCLUDE m4disk.inc

        .DEPHASE
        END
