; ********************************************************************************
; *                    Historical BetterCP/M CCP Reloader                        *
; *                                                                              *
; * Superseded CCP-only relocatable command-image reloader retained as patch     *
; * history. Production builds use ccprelod.mac to reconstruct ordered CPXs *
; * and the calculated CCP. Do not add new behavior to this source.              *
; ********************************************************************************


RELOADBASE      EQU     0E900H
BIOPHREAD       EQU     0EF33H
SYS_WBOOT       EQU     0C023H
ECB_CCPBASE     EQU     0C08CH
ECB_CCPSIZE     EQU     0C08EH
ECB_TPATOP      EQU     0C090H
ECB_GENERATION  EQU     0C092H
CPX_RECON_COUNT EQU     0C094H
MODBUF          EQU     0ED00H
MOD_LINK        EQU     MODBUF+6
MOD_SIZE        EQU     MODBUF+8
MOD_ALLOC       EQU     MODBUF+10
MOD_ENTRY       EQU     MODBUF+12
MOD_RELOCS      EQU     MODBUF+14
MOD_TABLE       EQU     MODBUF+16

        CSEG
        .PHASE  RELOADBASE

; ================================================================================
; =                       Command Image Reconstruction                          =
; =                                                                              =
; = Validates the system-track command image, calculates the movable CCP base,   =
; = and loads its payload downward from the compatibility gateway.               =
; ================================================================================

CRSTART:                                ; enter historical CCP reloader
        LD      SP,CRSTKTOP
        LD      HL,MODBUF
        LD      C,1                     ; track 1, side 1, sector 1: module header
        CALL    CRREAD
        JP      NZ,CRFAIL
        LD      HL,MODBUF
        LD      DE,CRMAGIC
        LD      B,6

CRMAGLP:                                ; validate command-image header magic
        LD      A,(DE)
        CP      (HL)
        JP      NZ,CRFAIL
        INC     DE
        INC     HL
        DJNZ    CRMAGLP
  ; CPX-aware reconstruction begins with the persistent ordered table.  The
  ; first implementation accepts the real empty profile; non-empty profiles are
  ; rejected rather than silently booting without their requested commands.
  ; The table and loop remain the next module-loading boundary, while CCP size
  ; and placement are already fully calculated rather than fixed at BB00h.
        LD      A,(CPX_RECON_COUNT)
        OR      A
        JP      NZ,CRFAIL
        LD      HL,(MOD_SIZE)
        LD      A,H
        OR      L
        JP      Z,CRFAIL
        LD      DE,(MOD_ALLOC)
        OR      A
        SBC     HL,DE                   ; payload must fit its page allocation
        JP      C,CRSZOK
        JP      Z,CRSZOK
        JP      CRFAIL

CRSZOK:                                 ; accept validated CCP size
        LD      HL,(MOD_ALLOC)
        LD      A,L                     ; allocation must be a nonzero page multiple
        OR      A
        JP      NZ,CRFAIL
        LD      A,H
        OR      A
        JP      Z,CRFAIL
        LD      HL,(MOD_RELOCS)
        LD      A,H
        OR      A
        JP      NZ,CRFAIL
        LD      A,L
        CP      249                     ; at most 248 words fit after header byte 16
        JP      NC,CRFAIL
  ; Allocate the CCP downward from the movable compatibility gateway.  There is
  ; no arbitrary CCP slot: the module's rounded allocation determines its base.
        LD      HL,(ECB_TPATOP)
        LD      DE,(MOD_ALLOC)
        OR      A
        SBC     HL,DE
        JP      C,CRFAIL
        LD      A,H
        OR      A
        JP      Z,CRFAIL                ; never overlap page zero/0100h origin
        LD      (ECB_CCPBASE),HL
        LD      HL,(MOD_ALLOC)
        LD      (ECB_CCPSIZE),HL
        LD      HL,(ECB_GENERATION)
        INC     HL
        LD      (ECB_GENERATION),HL
        LD      HL,(MOD_SIZE)
        LD      (CRLEFT),HL
        LD      HL,(ECB_CCPBASE)
        LD      (CRDEST),HL
        LD      HL,CRSECTS
        LD      (CRSECTP),HL

CRPAY:                                  ; load next CCP payload sector
        LD      HL,(CRLEFT)
        LD      A,H
        OR      L
        JR      Z,CRRELOC
        LD      A,H
        CP      2
        JR      C,CRLAST
        LD      HL,(CRDEST)
        CALL    CRNEXT
        JP      NZ,CRFAIL
        LD      (CRDEST),HL
        LD      HL,(CRLEFT)
        LD      DE,0200H
        OR      A
        SBC     HL,DE
        LD      (CRLEFT),HL
        JR      CRPAY

CRLAST:                                 ; handle final partial payload sector
        LD      HL,MODBUF
        CALL    CRNEXT
        JP      NZ,CRFAIL
        LD      HL,MODBUF
        LD      DE,(CRDEST)
        LD      BC,(CRLEFT)
        LDIR
        LD      HL,0
        LD      (CRLEFT),HL
        JR      CRPAY

  ; Re-read the header because the final partial payload used the shared buffer.

; ================================================================================
; =                             CCP Relocation                                   =
; =                                                                              =
; = Re-reads the relocation directory and adjusts the loaded CCP image from its  =
; = link origin to the calculated runtime base.                                  =
; ================================================================================

CRRELOC:                                ; begin CCP relocation
        LD      HL,MODBUF
        LD      C,1
        CALL    CRREAD
        JP      NZ,CRFAIL
        LD      HL,(ECB_CCPBASE)
        LD      DE,(MOD_LINK)
        OR      A
        SBC     HL,DE
        LD      (CRDELTA),HL
        LD      BC,(MOD_RELOCS)
        LD      HL,MOD_TABLE

CRRLOOP:                                ; apply next relocation entry
        LD      A,B
        OR      C
        JR      Z,CRDONE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     HL
        PUSH    HL
        PUSH    BC
        LD      HL,(MOD_SIZE)
        DEC     HL                      ; relocation word must begin below size-1
        OR      A
        SBC     HL,DE
        JP      C,CRFAIL
        JP      Z,CRFAIL
        LD      HL,(ECB_CCPBASE)
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        LD      BC,(CRDELTA)
        ADD     HL,BC
        EX      DE,HL
        LD      (HL),D
        DEC     HL
        LD      (HL),E
        POP     BC
        POP     HL
        LD      A,C
        SUB     1
        LD      C,A
        JR      NC,CRRLOOP
        DEC     B
        JR      CRRLOOP

CRDONE:                                 ; complete CCP reconstruction
        JP      SYS_WBOOT

CRFAIL:                                 ; halt after reload failure
        JR      CRFAIL

; -------------------------------------------------------------------------------
; System-Track Sector Input
; -------------------------------------------------------------------------------

CRNEXT:                                 ; advance system-track sector
        PUSH    HL
        LD      HL,(CRSECTP)
        LD      C,(HL)
        INC     HL
        LD      (CRSECTP),HL
        POP     HL

CRREAD:                                 ; read current system-track sector
        LD      A,1                     ; cylinder 1
        LD      B,1                     ; side 1; BIOPHREAD forces system drive A
        JP      BIOPHREAD

; -------------------------------------------------------------------------------
; Reloader State
; -------------------------------------------------------------------------------

CRMAGIC:                                ; command-image magic signature
        DB      'B','C','M','1',1,1

CRSECTS:                                ; remaining payload sectors
        DB      3,5,7

CRSECTP:                                ; current system-track sector
        DW      0

CRDEST:                                 ; current payload destination
        DW      0

CRLEFT:                                 ; remaining payload bytes
        DW      0

CRDELTA:                                ; CCP relocation delta
        DW      0

CRSTACK:                                ; reloader stack storage
        REPT    16
        DB      0
        ENDM

CRSTKTOP:                               ; top of reloader stack

        .DEPHASE
        END
