; ********************************************************************************
; *                Model 4 Physical Write/Readback Diagnostic                    *
; *                                                                              *
; * Standalone BetterCP/M hardware test for Model 4 physical-sector writes.      *
; * Writes a known test signature, reads the sector back, verifies the returned  *
; * bytes, and reports success or failure through Model 4 video memory.           *
; ********************************************************************************

        INCLUDE hardware.inc
        CSEG
        .PHASE  STAGE1BASE

; ================================================================================
; =                      Physical Write/Readback Test                           =
; =                                                                              =
; = Reads the test sector, writes a known signature, clears the buffer, reads    =
; = the sector again, verifies the signature, and displays the result.           =
; ================================================================================

START:                                  ; run physical write/readback diagnostic
        DI
        LD      SP,STAGE1STACK
        LD      A,2
        LD      B,1
        LD      C,10
        LD      HL,DISKBUFFER
        CALL    M4_READ
        JR      NZ,FAILED
        LD      HL,NEWSIG
        LD      DE,DISKBUFFER
        LD      BC,SIGLEN
        LDIR
        LD      A,2
        LD      B,1
        LD      C,10
        LD      HL,DISKBUFFER
        CALL    M4_WRITE
        JR      NZ,FAILED
        LD      HL,DISKBUFFER
        LD      B,SIGLEN

CLEAR:                                  ; clear test-sector buffer
        LD      (HL),0
        INC     HL
        DJNZ    CLEAR
        LD      A,2
        LD      B,1
        LD      C,10
        LD      HL,DISKBUFFER
        CALL    M4_READ
        JR      NZ,FAILED
        LD      HL,DISKBUFFER
        LD      DE,NEWSIG
        LD      B,SIGLEN

CHECK:                                  ; compare readback signature
        LD      A,(DE)
        CP      (HL)
        JR      NZ,FAILED
        INC     DE
        INC     HL
        DJNZ    CHECK
        LD      HL,PASSMSG
        LD      BC,PASSLEN
        JR      SHOW

FAILED:                                 ; select failure message
        LD      HL,FAILMSG
        LD      BC,FAILLEN

SHOW:                                   ; display diagnostic result
        LD      A,08EH
        OUT     (OPTREG),A
        LD      DE,VIDEOBASE
        LDIR

STOP:                                   ; halt in diagnostic loop
        JR      STOP

; -------------------------------------------------------------------------------
; Diagnostic Data and Messages
; -------------------------------------------------------------------------------

NEWSIG:                                 ; test-sector signature
        DB      'BetterCP/M physical write'
SIGLEN  EQU     $-NEWSIG

PASSMSG:                                ; write/readback success message
        DB      'BIOS physical write verified'
PASSLEN EQU     $-PASSMSG

FAILMSG:                                ; write/readback failure message
        DB      'BIOS physical write failed'
FAILLEN EQU     $-FAILMSG

; -------------------------------------------------------------------------------
; Minimal Disk Binding
; -------------------------------------------------------------------------------

B_PDrive:                               ; diagnostic physical drive
        DB      1                       ; standalone diagnostic targets drive 0
M4_READ_ONLY   EQU     0
M4_MULTI_DRIVE EQU     0
        INCLUDE m4disk.inc
        .DEPHASE
        END
