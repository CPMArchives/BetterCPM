        INCLUDE layout.inc

; ********************************************************************************
; *                         BetterCP/M RSX Selector                              *
; *                                                                              *
; * Transient selector stored in the unused tail of the command-reloader block.  *
; * Selects the RSX rebuilder, validator, publisher, or resolver and may safely  *
; * overwrite itself only after the platform fetch operation has returned.       *
; ********************************************************************************


BIOPHREAD      EQU     LY_BIOS+51

        CSEG
        .PHASE  LY_CFG+0380H

; ================================================================================
; =                            RSX Utility Selection                            =
; =                                                                              =
; = Uses the selector in A to locate the requested RSX utility image, fetch it   =
; = through the platform loader, and copy it into its execution area.            =
; ================================================================================

RS_SELECT:                              ; select and load RSX utility
        LD      E,A
        LD      D,0
        LD      H,D
        LD      L,E
        ADD     HL,HL
        ADD     HL,DE
        ADD     HL,HL
        LD      DE,RS_TABLE
        ADD     HL,DE
        EX      DE,HL
        LD      HL,LY_RSX
        CALL    RS_READ
        RET     NZ
        INC     DE
        INC     DE
        INC     DE
        LD      HL,LY_BUF
        CALL    RS_READ                 ; stage the sector containing the stack
        RET     NZ
        LD      HL,LY_BUF
        LD      DE,LY_RSX+0200H
        LD      BC,01F4H
        LDIR                            ; preserve the nine-byte return frame
        LD      HL,LY_BUF+01FDH
        LD      DE,LY_RSX+03FDH
        LD      BC,3
        LDIR                            ; install the fixed BDOS gateway
        RET

RS_READ:                                ; read one physical overlay sector
        PUSH    DE
        EX      DE,HL
        LD      A,(HL)
        INC     HL
        LD      C,(HL)
        INC     HL
        LD      H,(HL)
        LD      B,C
        LD      C,H
        EX      DE,HL
        CALL    BIOPHREAD
        POP     DE
        RET

; -------------------------------------------------------------------------------
; RSX Utility Sector Table
; -------------------------------------------------------------------------------

RS_TABLE:                               ; RSX utility sector table
  ; @rsx-sector-table@
  ; @rsx-validator-sector-table@
  ; @rsx-publisher-sector-table@
  ; @rsx-resolver-sector-table@
        .DEPHASE
        END
