; BetterCP/M TRS-80 Model 4 command-environment reloader.
; Persistent CPX records are eight-character, space-padded filename stems.
; The protected loader supplies .CPX and reads them through directory services.
RELOADBASE      EQU     0E900H
HISTBASE        EQU     0BE00H
BASEGATE        EQU     HISTBASE-3
BIOPHREAD       EQU     0EF33H
DIRLOGIN        EQU     0D60CH
FLOPEN          EQU     0D000H
FLNEXT          EQU     0D003H
FLRESET         EQU     0D006H
SYS_WBOOT       EQU     0C023H
ECB_CPXHEAD     EQU     0C086H
ECB_RSXHEAD     EQU     0C084H
ECB_RSXLOW      EQU     0C088H
ECB_CCPBASE     EQU     0C08CH
ECB_CCPSIZE     EQU     0C08EH
ECB_TPATOP      EQU     0C090H
ECB_GENERATION  EQU     0C092H
CPTCOUNT        EQU     0C094H
CPTABLE         EQU     0C096H
MODBUF          EQU     0ED00H
MOD_LINK        EQU     MODBUF+10
MOD_SIZE        EQU     MODBUF+12
MOD_ALLOC       EQU     MODBUF+14
MOD_ENTRY       EQU     MODBUF+16
MOD_RELOCS      EQU     MODBUF+22
MOD_HEADERSZ    EQU     MODBUF+24
MOD_PAYLOAD     EQU     MODBUF+26
MOD_RELTABLE    EQU     MODBUF+28
; The directory path is substantially deeper than the old raw-sector reader.
; Grow its private stack downward through the unused fixed-core gap.
CRSTKTOP        EQU     0D4F0H

        CSEG
        .PHASE  RELOADBASE
CRSTART:
        JP      CRBODY
RXENTRY:
        JP      RXCONTROL
CRBODY:
        LD      SP,CRSTKTOP
        LD      C,0
        CALL    DIRLOGIN        ; protected file services precede CCP/CPX load
        JP      NZ,CRFAIL
        LD      HL,(ECB_TPATOP)
        LD      (CRBOUND),HL
        XOR     A
        LD      (ECB_CPXHEAD),A
        LD      (ECB_CPXHEAD+1),A
        LD      (CRPREV),A
        LD      (CRPREV+1),A
        LD      A,(CPTCOUNT)
        CP      9
        JP      NC,CRFAIL
        LD      (CRCOUNT),A
        LD      HL,CPTABLE
        LD      (CRTPTR),HL
CRCPXLP:
        LD      A,(CRCOUNT)
        OR      A
        JR      Z,CRCCP
        LD      HL,(CRTPTR)
        XOR     A               ; filename extension is CPX
        CALL    FLOPEN
        JP      NZ,CRFAIL
        LD      A,1
        LD      (CRFILE),A
        LD      HL,(CRTPTR)
        LD      DE,8
        ADD     HL,DE
        LD      (CRTPTR),HL
        LD      HL,CRCPXMAG
        LD      (CRMAGPTR),HL
        CALL    CRLOAD
        JP      NZ,CRFAIL
        LD      HL,(CRBASE)
        LD      (HL),0
        INC     HL
        LD      (HL),0
        LD      HL,(CRPREV)
        LD      A,H
        OR      L
        JR      NZ,CRLINK
        LD      HL,(CRBASE)
        LD      (ECB_CPXHEAD),HL
        JR      CRLINKD
CRLINK:
        LD      DE,(CRBASE)
        LD      (HL),E
        INC     HL
        LD      (HL),D
CRLINKD:
        LD      HL,(CRBASE)
        LD      (CRPREV),HL
        LD      A,(CRCOUNT)
        DEC     A
        LD      (CRCOUNT),A
        JR      CRCPXLP
CRCCP:
        XOR     A
        LD      (CRFILE),A
        LD      (CRSLOT),A
        LD      HL,CRCCPMAG
        LD      (CRMAGPTR),HL
        CALL    CRLOAD
        JP      NZ,CRFAIL
        LD      HL,(CRBASE)
        LD      (ECB_CCPBASE),HL
        LD      HL,(CRMALLOC)
        LD      (ECB_CCPSIZE),HL
        LD      HL,(ECB_GENERATION)
        INC     HL
        LD      (ECB_GENERATION),HL
        JP      SYS_WBOOT

; Provisional one-module RSX control. E=0 query, E=1 load HELLO.RSX as an
; ordinary file, E=2 unload. A runtime change is completed by the
; caller's following WBOOT, which reconstructs CPXs/CCP below ECB_TPATOP.
RXCONTROL:
        LD      A,E
        OR      A
        JR      Z,RXQUERY
        CP      1
        JR      Z,RXLOAD
        CP      2
        JR      Z,RXUNLOAD
        LD      A,0FFH
        RET
RXQUERY:
        LD      HL,(ECB_RSXHEAD)
        LD      A,H
        OR      L
        RET     Z
        LD      A,1
        RET
RXUNLOAD:
        LD      HL,0
        LD      (ECB_RSXHEAD),HL
        LD      HL,HISTBASE
        LD      (ECB_RSXLOW),HL
        LD      HL,BASEGATE
        LD      (ECB_TPATOP),HL
        XOR     A
        RET
RXLOAD:
        LD      HL,(ECB_RSXHEAD)
        LD      A,H
        OR      L
        JP      NZ,RXOK
        LD      HL,RXHELLO
        LD      A,1             ; filename extension is RSX
        CALL    FLOPEN
        RET     NZ
        LD      A,1
        LD      (CRFILE),A
        LD      HL,MODBUF
        CALL    CRNEXT
        RET     NZ
        LD      HL,MODBUF
        LD      DE,RXMAGIC
        LD      B,4
RXMAGLP:
        LD      A,(DE)
        CP      (HL)
        JR      NZ,RXBAD
        INC     DE
        INC     HL
        DJNZ    RXMAGLP
        LD      HL,(MODBUF+8)   ; allocation must be whole pages, nonzero
        LD      A,L
        OR      A
        JR      NZ,RXBAD
        LD      A,H
        OR      A
        JR      Z,RXBAD
        LD      DE,HISTBASE
        EX      DE,HL
        OR      A
        SBC     HL,DE
        JR      C,RXBAD
        LD      (CRBASE),HL
        LD      (ECB_RSXHEAD),HL
        LD      (ECB_RSXLOW),HL
        DEC     HL
        DEC     HL
        DEC     HL
        LD      (ECB_TPATOP),HL
        LD      HL,(MODBUF+12)  ; payload offset within compact carrier
        LD      DE,MODBUF
        ADD     HL,DE
        LD      DE,(CRBASE)
        LD      BC,(MODBUF+6)
        LDIR
        LD      HL,(CRBASE)
        LD      DE,(MODBUF+4)
        OR      A
        SBC     HL,DE
        LD      (CRDELTA),HL
        LD      BC,(MODBUF+10)
        LD      HL,MODBUF+16
RXRLOOP:
        LD      A,B
        OR      C
        JR      Z,RXLINK
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     HL
        PUSH    HL
        PUSH    BC
        LD      HL,(CRBASE)
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        LD      BC,(CRDELTA)
        ADD     HL,BC
        EX      DE,HL
        LD      (HL),D
        DEC     HL
        LD      (HL),E
        POP     BC
        POP     HL
        DEC     BC
        JR      RXRLOOP
RXLINK:
        LD      HL,(CRBASE)
        LD      (HL),000H
        INC     HL
        LD      (HL),0C1H       ; fixed core BDOS at C100h
RXOK:
        XOR     A
        RET
RXBAD:
        LD      HL,0
        LD      (ECB_RSXHEAD),HL
        LD      A,0FFH
        RET

; Load one BCM1/BCPX module below CRBOUND, then relocate it at CRBASE.
CRLOAD:
        LD      A,(CRSLOT)
        LD      (CRFIRST),A     ; retained for the fixed-slot CCP image
        LD      HL,MODBUF
        CALL    CRNEXT
        RET     NZ
        LD      HL,MODBUF
        LD      DE,(CRMAGPTR)
        LD      B,6
CRMAGLP:
        LD      A,(DE)
        CP      (HL)
        RET     NZ
        INC     DE
        INC     HL
        DJNZ    CRMAGLP
        LD      A,(MODBUF+2)
        CP      'P'
        JR      Z,CRNCPX
; Preserve the established BCM1 command-module carrier while normalizing its
; fields into the same private descriptor used by BCPX.  This explicit split
; replaces the former accidental assumption that both formats shared offsets.
        XOR     A
        LD      (CRISCPX),A
        LD      HL,(MODBUF+6)
        LD      (CRMLINK),HL
        LD      HL,(MODBUF+8)
        LD      (CRMSIZE),HL
        LD      HL,(MODBUF+10)
        LD      (CRMALLOC),HL
        LD      HL,(MODBUF+14)
        LD      (CRMRELOCS),HL
        LD      HL,0200H
        LD      (CRMHEADSZ),HL
        LD      (CRMPAYLOAD),HL
        LD      HL,16
        LD      (CRMRELTABLE),HL
        JR      CRNORMED
CRNCPX:
        LD      HL,(MODBUF+6)   ; L=ABI major, H=ABI minor
        DEC     HL
        LD      A,H
        OR      L               ; ABI 1.0 is the only accepted v1 contract
        JP      NZ,CRBAD
        LD      HL,(MODBUF+8)
        LD      A,H
        OR      L               ; v1 defines no nonzero flag bits
        JP      NZ,CRBAD
        LD      A,1
        LD      (CRISCPX),A
        LD      HL,(MOD_LINK)
        LD      (CRMLINK),HL
        LD      HL,(MOD_SIZE)
        LD      (CRMSIZE),HL
        LD      HL,(MOD_ALLOC)
        LD      (CRMALLOC),HL
        LD      HL,(MOD_ENTRY)
        LD      (CRMENTRY),HL
        LD      HL,(MOD_RELOCS)
        LD      (CRMRELOCS),HL
        LD      HL,(MOD_HEADERSZ)
        LD      (CRMHEADSZ),HL
        LD      HL,(MOD_PAYLOAD)
        LD      (CRMPAYLOAD),HL
        LD      HL,(MOD_RELTABLE)
        LD      (CRMRELTABLE),HL
CRNORMED:
        LD      HL,(CRMSIZE)
        LD      A,H
        OR      L
        JP      Z,CRBAD
        LD      DE,(CRMALLOC)
        OR      A
        SBC     HL,DE
        JR      C,CRSZOK
        JR      Z,CRSZOK
        JP      CRBAD
CRSZOK:
        LD      HL,(CRMALLOC)
        LD      A,L
        OR      A
        JP      NZ,CRBAD
        LD      A,H
        OR      A
        JP      Z,CRBAD
        LD      HL,(CRMPAYLOAD)
        LD      DE,(CRMHEADSZ)
        OR      A
        SBC     HL,DE
        JP      NZ,CRBAD        ; v1 payload immediately follows its header
        LD      HL,(CRMPAYLOAD)
        LD      DE,0200H
        OR      A
        SBC     HL,DE
        JP      C,CRBAD
        LD      A,L
        OR      A
        JP      NZ,CRBAD        ; carrier sections are physical-record aligned
        LD      (CRSKIP),HL
        LD      HL,(CRMRELOCS)
        LD      A,H
        OR      A
        JP      NZ,CRBAD
        LD      E,249           ; BCM1's established maximum is 248
        LD      A,(CRISCPX)
        OR      A
        JR      Z,CRRCMAX
        LD      E,233           ; BCPX record 0 holds at most 232 entries
CRRCMAX:
        LD      A,L
        CP      E
        JP      NC,CRBAD
        LD      HL,(CRBOUND)
        LD      DE,(CRMALLOC)
        OR      A
        SBC     HL,DE
        JP      C,CRBAD
        LD      A,H
        OR      A
        JP      Z,CRBAD
        LD      (CRBASE),HL
        LD      (CRBOUND),HL
        LD      (CRDEST),HL
        LD      HL,(CRMSIZE)
        LD      (CRLEFT),HL
CRHSKIP:
        LD      HL,(CRSKIP)
        LD      A,H
        OR      L
        JR      Z,CRPAY
        LD      HL,MODBUF
        CALL    CRNEXT
        RET     NZ
        LD      HL,(CRSKIP)
        LD      DE,0200H
        OR      A
        SBC     HL,DE
        LD      (CRSKIP),HL
        JR      CRHSKIP
CRPAY:
        LD      HL,(CRLEFT)
        LD      A,H
        OR      L
        JR      Z,CRRELOC
        LD      A,H
        CP      2
        JR      C,CRLAST
        LD      HL,(CRDEST)
        CALL    CRNEXT
        RET     NZ
        LD      (CRDEST),HL
        LD      HL,(CRLEFT)
        LD      DE,0200H
        OR      A
        SBC     HL,DE
        LD      (CRLEFT),HL
        JR      CRPAY
CRLAST:
        LD      HL,MODBUF
        CALL    CRNEXT
        RET     NZ
        LD      HL,MODBUF
        LD      DE,(CRDEST)
        LD      BC,(CRLEFT)
        LDIR
        LD      HL,0
        LD      (CRLEFT),HL
        JR      CRPAY
CRRELOC:
        CALL    CRRESET
        RET     NZ
        LD      HL,MODBUF
        CALL    CRNEXT
        RET     NZ
        LD      HL,(CRBASE)
        LD      DE,(CRMLINK)
        OR      A
        SBC     HL,DE
        LD      (CRDELTA),HL
        LD      BC,(CRMRELOCS)
        LD      HL,(CRMRELTABLE)
        LD      DE,0200H
        OR      A
        SBC     HL,DE
        JP      NC,CRBAD        ; v1 relocation directory resides in record 0
        LD      HL,(CRMRELTABLE)
        LD      DE,MODBUF
        ADD     HL,DE
CRRLOOP:
        LD      A,B
        OR      C
        JR      Z,CRENTRY
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     HL
        PUSH    HL
        PUSH    BC
        LD      HL,(CRMSIZE)
        DEC     HL
        OR      A
        SBC     HL,DE
        JR      C,CRRLBAD
        JR      Z,CRRLBAD
        LD      HL,(CRBASE)
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        EX      DE,HL
        LD      BC,(CRDELTA)
        ADD     HL,BC
        EX      DE,HL
        LD      (HL),D
        DEC     HL
        LD      (HL),E
        POP     BC
        POP     HL
        LD      A,C
        SUB     1
        LD      C,A
        JR      NC,CRRLOOP
        DEC     B
        JR      CRRLOOP
CRRLBAD:
        POP     BC
        POP     HL
CRBAD:
        LD      A,1
        OR      A
        RET
CRENTRY:
        LD      A,(CRISCPX)
        OR      A
        JR      Z,CRGOOD
        LD      DE,(CRMENTRY)
        LD      HL,(CRMSIZE)
        OR      A
        SBC     HL,DE
        JR      C,CRBAD
        JR      Z,CRBAD
        LD      HL,(CRBASE)
        ADD     HL,DE
        EX      DE,HL
        LD      HL,(CRBASE)
        INC     HL
        INC     HL
        LD      (HL),E
        INC     HL
        LD      (HL),D           ; publish validated command entry
CRGOOD:
        XOR     A
        RET
; Restart a module stream so its relocation directory can be reread.
CRRESET:
        LD      A,(CRFILE)
        OR      A
        JP      NZ,FLRESET
        LD      A,(CRFIRST)
        LD      (CRSLOT),A
        XOR     A
        RET

CRNEXT:
        LD      A,(CRFILE)
        OR      A
        JP      NZ,FLNEXT
        LD      A,(CRSLOT)
        CP      10
        JR      NC,CRBAD
        PUSH    HL
        LD      E,A
        LD      D,0
        LD      HL,CRSECTS
        ADD     HL,DE
        LD      C,(HL)
        INC     A
        LD      (CRSLOT),A
        POP     HL
        LD      A,1
        LD      B,1
        JP      BIOPHREAD

CRFAIL:
        JR      CRFAIL

CRCCPMAG:      DB      'B','C','M','1',1,1
CRCPXMAG:      DB      'B','C','P','X',1,1
RXMAGIC:       DB      'B','R','X','1'
RXHELLO:       DB      'HELLO   '
CRSECTS:       DB      1,3,5,7,9,2,4,6,8,10
CRMAGPTR:      DW      0
CRTPTR:        DW      0
CRBOUND:       DW      0
CRBASE:        DW      0
CRPREV:        DW      0
CRDEST:        DW      0
CRLEFT:        DW      0
CRSKIP:        DW      0
CRMLINK:       DW      0
CRMSIZE:       DW      0
CRMALLOC:      DW      0
CRMENTRY:      DW      0
CRMRELOCS:     DW      0
CRMHEADSZ:     DW      0
CRMPAYLOAD:    DW      0
CRMRELTABLE:   DW      0
CRISCPX:       DB      0
CRDELTA:       DW      0
CRCOUNT:       DB      0
CRSLOT:        DB      0
CRFIRST:       DB      0
CRFILE:        DB      0
        .DEPHASE
        END
