; Native VT52 monitor on a byte-stream console connected to a VT52 endpoint.
; No ANSI translation or platform video-memory access. The current MCON
; carrier still binds to the cpmsim backend; portable backend selection remains
; a separate ABI gate. Buffer incomplete addressing before emitting any bytes.
BASE EQU 08000H
        CSEG
        .PHASE BASE
VT_NEXT: DW 5
VT_DISP: DW VT_CHAIN
        DB 0,0
        DW 0
VT_CHAIN:
        LD HL,(VT_NEXT)
        JP (HL)
VT_ENTRY:
        OR A
        JP Z,VT_OUT
        CP 1
        JP Z,VQ_STAT
        CP 2
        JP Z,VQ_INPUT
        CP 4
        JP Z,VT_CLEAR
        CP 5
        JP Z,VT_RESET
VT_RAW:
        LD HL,(1)
        LD DE,66
        ADD HL,DE
        JP (HL)
VT_EMIT:
        PUSH BC
        PUSH DE
        PUSH HL
        XOR A
        CALL VT_RAW
        POP HL
        POP DE
        POP BC
        RET
VT_STR:
        LD C,(HL)
        INC HL
        LD A,C
        OR A
        RET Z
        CALL VT_EMIT
        JR VT_STR
VT_RESET:
        XOR A
        LD (VT_STATE),A
        RET
VT_CLEAR:
        CALL VT_RESET
        XOR A
        LD (VT_ROW),A
        LD (VT_COL),A
        LD HL,VT_CLS
        JP VT_STR
VT_OUT:
        LD A,(VT_STATE)
        OR A
        JP Z,VT_NORM
        CP 1
        JP Z,VT_ESC
        CP 2
        JR Z,VT_GOTR
        LD A,C
        CP 32
        JR C,VT_DONE
        SUB 32
        CP 80
        JR C,VT_SETCL
        LD A,79
VT_SETCL:
        LD (VT_COL),A
VT_DONE:
        LD A,(VT_PEND)
        LD (VT_ROW),A
        CALL VT_RESET
        JP VT_POS
VT_GOTR:
        LD A,C
        CP 32
        JR C,VT_KEEP
        SUB 32
        CP 24
        JR NC,VT_KEEP
        LD (VT_PEND),A
VT_KEEP:
        LD A,3
        LD (VT_STATE),A
        RET
VT_NORM:
        LD A,C
        CP 27
        JR Z,VT_BEGIN
        CP 127
        RET Z
        CP 32
        JP NC,VT_PRINT
        CP 7
        JP Z,VT_EMIT
        CP 8
        JP Z,VT_LEFT
        CP 9
        JP Z,VT_TAB
        CP 10
        JP Z,VT_LF
        CP 13
        JR Z,VT_CR
        RET
VT_BEGIN:
        LD A,1
        LD (VT_STATE),A
        RET
VT_CR:
        XOR A
        LD (VT_COL),A
        JP VT_POS
VT_PRINT:
        CALL VT_EMIT
        LD A,(VT_COL)
        CP 79
        JP Z,VT_POS                     ; retain the native VT52 right margin
        INC A
        LD (VT_COL),A
        RET
VT_ESC:
        CALL VT_RESET
        LD A,C
        CP 'Z'
        JP Z,VQ_IDENT
        CP 'Y'
        JR Z,VT_ADDR
        CP 'H'
        JR Z,VT_HOME
        CP 'A'
        JP Z,VT_UP
        CP 'B'
        JP Z,VT_DOWN
        CP 'C'
        JP Z,VT_RIGHT
        CP 'D'
        JP Z,VT_LEFT
        CP 'I'
        JP Z,VT_RLF
        CP 'J'
        JR Z,VT_EOS
        CP 'K'
        JR Z,VT_EOL
        RET                             ; development containment, not historical qualification
VT_ADDR:
        LD A,(VT_ROW)
        LD (VT_PEND),A
        LD A,2
        LD (VT_STATE),A
        RET
VT_HOME:
        XOR A
        LD (VT_ROW),A
        LD (VT_COL),A
        JP VT_POS
VT_EOS:
        LD HL,VT_SJ
        JP VT_STR
VT_EOL:
        LD HL,VT_SK
        JP VT_STR
VT_UP:
        LD A,(VT_ROW)
        OR A
        RET Z
        DEC A
        LD (VT_ROW),A
        JP VT_POS
VT_DOWN:
        LD A,(VT_ROW)
        CP 23
        RET Z
        INC A
        LD (VT_ROW),A
        JP VT_POS
VT_LEFT:
        LD A,(VT_COL)
        OR A
        RET Z
        DEC A
        LD (VT_COL),A
        JP VT_POS
VT_RIGHT:
        LD A,(VT_COL)
        CP 79
        RET Z
        INC A
        LD (VT_COL),A
        JP VT_POS
VT_TAB:
        LD A,(VT_COL)
        CP 72
        JP NC,VT_RIGHT
        AND 0F8H
        ADD A,8
        LD (VT_COL),A
        JP VT_POS
VT_LF:
        LD A,(VT_ROW)
        CP 23
        JR Z,VT_BLF
        CALL VT_EMIT
        LD A,(VT_ROW)
        INC A
        LD (VT_ROW),A
        RET
VT_BLF:
        ; A native VT52 scrolls on LF at its bottom row and retains column.
        LD C,10
        JP VT_EMIT
VT_RLF:
        LD A,(VT_ROW)
        OR A
        JP NZ,VT_UP
        LD HL,VT_RI
        JP VT_STR
VT_POS:
        ; Native address: ESC Y, row+32, column+32. No CSI/decimal output.
        LD C,27
        CALL VT_EMIT
        LD C,'Y'
        CALL VT_EMIT
        LD A,(VT_ROW)
        ADD A,32
        LD C,A
        CALL VT_EMIT
        LD A,(VT_COL)
        ADD A,32
        LD C,A
        JP VT_EMIT
VQ_STAT:
        LD A,(VQ_COUNT)
        OR A
        JR NZ,VQ_READY
        ; Observing a raw key enqueues it without consuming logical input.
        LD A,1
        CALL VT_RAW
        OR A
        RET Z
        LD A,2
        CALL VT_RAW
        LD C,A
        CALL VQ_PUT
VQ_READY:
        LD A,0FFH
        RET
VQ_INPUT:
        LD A,(VQ_COUNT)
        OR A
        JR NZ,VQ_GET
        LD A,2
        JP VT_RAW
VQ_GET:
        LD A,(VQ_HEAD)
        LD E,A
        LD D,0
        LD HL,VQ_DATA
        ADD HL,DE
        LD C,(HL)
        INC A
        AND 15
        LD (VQ_HEAD),A
        LD HL,VQ_COUNT
        DEC (HL)
        LD A,C
        RET
VQ_IDENT:
        ; Reserve all three bytes before touching the ring. Newest reply loses
        ; on overflow; queued keyboard/replies and their order remain intact.
        LD A,(VQ_COUNT)
        CP 14
        RET NC
        LD C,27
        CALL VQ_PUT
        LD C,'/'
        CALL VQ_PUT
        LD C,'K'
VQ_PUT:
        LD A,(VQ_TAIL)
        LD E,A
        LD D,0
        LD HL,VQ_DATA
        ADD HL,DE
        LD (HL),C
        INC A
        AND 15
        LD (VQ_TAIL),A
        LD HL,VQ_COUNT
        INC (HL)
        RET
VQ_HEAD: DB 0
VQ_TAIL: DB 0
VQ_COUNT: DB 0
VQ_DATA: DS 16
VT_CLS: DB 27,'H',27,'J',0
VT_SJ: DB 27,'J',0
VT_SK: DB 27,'K',0
VT_RI: DB 27,'I',0
VT_STATE: DB 0
VT_ROW: DB 0
VT_PEND: DB 0
VT_COL: DB 0
        .DEPHASE
        END
