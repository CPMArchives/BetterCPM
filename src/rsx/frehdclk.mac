; ********************************************************************************
; *                      BetterCP/M FreHD TIME RSX                               *
; *                                                                              *
; * FreHD real-time-clock provider for BetterCP/M TIME ABI 1.0. Function 208     *
; * discovery is supplied by the central BRSX-v2 registry walker; this module    *
; * implements the provider service and FreHD-specific clock access.              *
; ********************************************************************************


RSXBASE         EQU     08000H
BDOS            EQU     00005H
DATA2           EQU     0C2H
SIZE2           EQU     0C3H
COMMAND2        EQU     0C4H
STATUS          EQU     0CFH
MODLATCH        EQU     0ECH

        CSEG
        .PHASE  RSXBASE

; ================================================================================
; =                         RSX Entry and TIME Dispatch                          =
; =                                                                              =
; = Defines the BRSX entry metadata and dispatches supported TIME ABI 1.0 service =
; = requests while chaining unrelated BDOS calls through the RSX stack.          =
; ================================================================================
; -------------------------------------------------------------------------------
; RSX Header and Dispatch
; -------------------------------------------------------------------------------

FT_NEXT:        DW      BDOS            ; next RSX descriptor pointer
FT_ENTRY:       DW      FT_DISPATCH     ; RSX entry pointer
FT_CALLS:       DB      0,0             ; TIME service-call count
                DW      0

FT_DISPATCH:                            ; dispatch RSX request
        LD      HL,(FT_NEXT)
        JP      (HL)

  ; TIME ABI 1.0 service dispatcher.

; -------------------------------------------------------------------------------
; TIME ABI Services
; -------------------------------------------------------------------------------

FT_SERVICE:                             ; dispatch TIME ABI service
        PUSH    DE
        LD      A,(DE)
        CP      1
        JR      NZ,FT_TVER
        INC     DE
        LD      A,(DE)
        CP      10
        JR      NZ,FT_TLEN
        INC     DE
        LD      A,(DE)
        OR      A
        JR      Z,FT_GET
        CP      1
        JP      Z,FT_TSET
        LD      A,3
        JR      FT_TFAIL

; ================================================================================
; =                         FreHD Real-Time Clock Access                         =
; =                                                                              =
; = Requests the current clock sample from FreHD, waits with a bounded poll, and =
; = returns ABI-formatted time data or an appropriate provider status.           =
; ================================================================================
; -------------------------------------------------------------------------------
; Clock Read
; -------------------------------------------------------------------------------

FT_GET:                                 ; read FreHD real-time clock
        INC     DE
        LD      A,(DE)
        OR      A
        JR      NZ,FT_TFLAGS
        PUSH    DE
        LD      HL,6
        ADD     HL,DE                   ; request byte +9 is reserved and must be zero
        LD      A,(HL)
        POP     DE
        OR      A
        JR      NZ,FT_TFLAGS
        LD      A,50H                   ; preserve map 1 while enabling EXTIO
        OUT     (MODLATCH),A
        LD      A,1
        OUT     (COMMAND2),A
        CALL    FT_WAIT
        JR      NZ,FT_HFAIL
        IN      A,(SIZE2)
        CP      6
        JR      NZ,FT_HFAIL
        LD      HL,FT_SAMPLE
        LD      BC,6*256+DATA2
        INIR
        LD      A,40H                   ; restore normal Model 4 map and I/O state
        OUT     (MODLATCH),A
        CALL    FT_VALIDATE
        JR      NZ,FT_TINVALID
        CALL    FT_DAYCOUNT
        POP     DE
        PUSH    DE
        PUSH    HL
        EX      DE,HL
        LD      BC,4
        ADD     HL,BC
        POP     BC
        LD      (HL),C
        INC     HL
        LD      (HL),B
        INC     HL
        LD      A,(FT_SAMPLE+2)
        CALL    FT_BINBCD
        LD      (HL),A
        INC     HL
        LD      A,(FT_SAMPLE+1)
        CALL    FT_BINBCD
        LD      (HL),A
        INC     HL
        LD      A,(FT_SAMPLE)
        CALL    FT_BINBCD
        LD      (HL),A
        POP     DE
        PUSH    DE
        LD      HL,4
        ADD     HL,DE
        POP     DE
        XOR     A
        RET

FT_HFAIL:                               ; handle FreHD hardware failure
        LD      A,40H
        OUT     (MODLATCH),A
        JR      FT_TUNAV

FT_TVER:       LD      A,1              ; TIME ABI version result
        JR      FT_TFAIL

FT_TLEN:       LD      A,2              ; TIME record-length result
        JR      FT_TFAIL

FT_TFLAGS:     LD      A,4              ; TIME capability flags result
        JR      FT_TFAIL

FT_TUNAV:      LD      A,5              ; TIME unavailable result
        JR      FT_TFAIL

FT_TINVALID:   LD      A,6              ; TIME invalid-request result
        JR      FT_TFAIL

FT_TSET:       LD      A,8              ; TIME set-service entry

FT_TFAIL:                               ; TIME set-service failure
        POP     DE
        LD      HL,0
        RET

  ; Return Z on a ready, error-free FreHD response. Never wait forever.

; -------------------------------------------------------------------------------
; Bounded FreHD Wait
; -------------------------------------------------------------------------------

FT_WAIT:                                ; wait for FreHD response
        LD      BC,0

FT_WLOOP:                               ; poll FreHD response
        IN      A,(STATUS)
        CP      0FFH
        JR      Z,FT_WBAD
        BIT     7,A
        JR      Z,FT_WDONE
        DEC     BC
        LD      A,B
        OR      C
        JR      NZ,FT_WLOOP

FT_WBAD:                                ; return FreHD error
        LD      A,1
        OR      A
        RET

FT_WDONE:                               ; return FreHD ready status
        AND     1
        RET

  ; Validate binary sec,min,hour,year,day,month from FreHD.

; ================================================================================
; =                       Clock Validation and Conversion                        =
; =                                                                              =
; = Validates the binary RTC fields, converts the calendar date to the CP/M day  =
; = count, and converts time components to packed BCD for the TIME ABI record.   =
; ================================================================================
; -------------------------------------------------------------------------------
; RTC Field Validation
; -------------------------------------------------------------------------------

FT_VALIDATE:                            ; validate RTC fields
        LD      A,(FT_SAMPLE)
        CP      60
        RET     NC
        LD      A,(FT_SAMPLE+1)
        CP      60
        RET     NC
        LD      A,(FT_SAMPLE+2)
        CP      24
        RET     NC
        LD      A,(FT_SAMPLE+5)
        DEC     A
        CP      12
        RET     NC
        LD      E,A
        LD      D,0
        LD      HL,FT_MTAB
        ADD     HL,DE
        LD      B,(HL)
        LD      A,E
        CP      1
        JR      NZ,FT_VDAY
        LD      A,(FT_SAMPLE+3)
        AND     3
        JR      NZ,FT_VDAY
        INC     B

FT_VDAY:                                ; validate day of month
        LD      A,(FT_SAMPLE+4)
        OR      A
        JR      Z,FT_VBAD
        CP      B
        JR      Z,FT_VOK
        RET     NC

FT_VOK:                                 ; accept RTC fields
        XOR     A
        RET

FT_VBAD:                                ; reject invalid RTC fields
        LD      A,1
        OR      A
        RET

  ; Convert 2000..2099 calendar date to CP/M day count in HL.

; -------------------------------------------------------------------------------
; CP/M Day-Count Conversion
; -------------------------------------------------------------------------------

FT_DAYCOUNT:                            ; convert date to CP/M day count
        LD      HL,8036
        LD      A,(FT_SAMPLE+3)
        LD      B,A
        XOR     A
        LD      C,A                     ; current two-digit year

FT_YLOOP:                               ; accumulate prior years
        LD      A,B
        OR      A
        JR      Z,FT_MADD
        LD      DE,365
        ADD     HL,DE
        LD      A,C
        AND     3
        JR      NZ,FT_YNEXT
        INC     HL

FT_YNEXT:                               ; advance year count
        INC     C
        DEC     B
        JR      FT_YLOOP

FT_MADD:                                ; accumulate prior months
        LD      A,(FT_SAMPLE+5)
        DEC     A
        LD      B,A
        LD      DE,FT_MTAB

FT_MLOOP:                               ; add month length
        LD      A,B
        OR      A
        JR      Z,FT_DAYADD
        LD      A,(DE)
        INC     DE
        LD      C,A
        LD      A,(FT_SAMPLE+5)
        SUB     B
        CP      2                       ; month being added is February
        JR      NZ,FT_MNORMAL
        LD      A,(FT_SAMPLE+3)
        AND     3
        JR      NZ,FT_MNORMAL
        INC     C

FT_MNORMAL:                             ; handle non-leap February
        LD      A,L
        ADD     A,C
        LD      L,A
        JR      NC,FT_MNEXT
        INC     H

FT_MNEXT:                               ; advance month count
        DEC     B
        JR      FT_MLOOP

FT_DAYADD:                              ; add current day offset
        LD      A,(FT_SAMPLE+4)
        DEC     A
        ADD     A,L
        LD      L,A
        RET     NC
        INC     H
        RET

; -------------------------------------------------------------------------------
; Binary-to-BCD Conversion
; -------------------------------------------------------------------------------

FT_BINBCD:                              ; convert binary byte to packed BCD
        LD      B,0

FT_BLOOP:                               ; accumulate BCD tens
        CP      10
        JR      C,FT_BDONE
        SUB     10
        INC     B
        JR      FT_BLOOP

FT_BDONE:                               ; finish BCD conversion
        LD      C,A
        LD      A,B
        RLCA
        RLCA
        RLCA
        RLCA
        OR      C
        RET

; ================================================================================
; =                              TIME Provider Data                              =
; =                                                                              =
; = Defines calendar lookup data and the provider's TIME sample buffer.          =
; ================================================================================
; -------------------------------------------------------------------------------
; Calendar and Sample Data
; -------------------------------------------------------------------------------

FT_MTAB:       DB      31,28,31,30,31,30,31,31,30,31,30,31 ; month-length table
FT_SAMPLE:     DS      6                ; TIME sample buffer

        .DEPHASE
        END
