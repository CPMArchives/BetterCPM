        INCLUDE backend.inc
; MM-style ADM-3A provider foundation. Unqualified personality controls remain
; outside this first stage; do not ship as a completed terminal implementation.
RSXBASE         EQU     08000H
        CSEG
        .PHASE RSXBASE
AM_NEXT: DW 5
AM_DISPATCH_WORD: DW AM_CHAIN
        DB 0,0
        DW 0
AM_CHAIN:
        LD HL,(AM_NEXT)
        JP (HL)
AM_ENTRY:
        OR A
        JP Z,AM_OUTPUT
        CP 3
        JR Z,AM_CURSOR
        CP 4
        JR Z,AM_CLEAR
        CP 5
        JR Z,AM_RESET
AM_RAW:
        LD HL,(1)
        LD DE,66                        ; MONRAW = WBOOT+66
        ADD HL,DE
        JP (HL)
AM_CURSOR:
        LD A,(AM_VISIBLE)
        OR A
        RET Z
        LD A,3
        JP AM_RAW
AM_CLEAR:
        XOR A
        LD (AM_STATE),A
        LD HL,0F800H
        LD DE,0F801H
        LD BC,1919
        LD (HL),020H
        LDIR
        LD HL,0F800H
        LD (M4CURSOR),HL
        XOR A
        LD (M4COLUMN),A                 ; clear video without resetting keyboard state
        RET
AM_RESET:
        XOR A
        LD (AM_STATE),A
        RET
AM_OUTPUT:
        LD A,(AM_STATE)
        OR A
        JR Z,AM_NORMAL
        CP 1
        JR Z,AM_ESCAPE
        CP 2
        JR Z,AM_ROW
        LD A,C
        SUB 32
        CP 80
        JR C,AM_COLUMN_OK
        LD A,79
AM_COLUMN_OK:
        LD (M4COLUMN),A
        LD B,A
        LD A,(AM_PENDING_ROW)
        LD L,A
        LD H,0
        ; row*80 = row*16 + row*64; all addresses are external video memory.
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        LD D,H
        LD E,L
        ADD HL,HL
        ADD HL,HL
        ADD HL,DE
        LD E,B
        LD D,0
        ADD HL,DE
        LD DE,0F800H
        ADD HL,DE
        LD (M4CURSOR),HL
        JP AM_RESET
AM_ROW:
        LD A,C
        SUB 32
        CP 24
        JR C,AM_ROW_OK
        LD A,23
AM_ROW_OK:
        LD (AM_PENDING_ROW),A
        LD A,3
        LD (AM_STATE),A
        RET
AM_ESCAPE:
        CALL AM_RESET
        LD A,C
        CP '='
        JR Z,AM_ADDRESS
        CP '0'
        JR Z,AM_HIDE
        CP '1'
        RET NZ                         ; unknown selector consumed
        LD A,1
        LD (AM_VISIBLE),A
        RET
AM_HIDE:
        XOR A
        LD (AM_VISIBLE),A
        RET
AM_ADDRESS:
        LD A,2
        LD (AM_STATE),A
        RET
AM_NORMAL:
        LD A,C
        CP 27
        JR Z,AM_BEGIN
        CP 26
        JP Z,AM_CLEAR
        ; Ordinary output uses the basic renderer during the foundation stage.
        ; The full MM movement/erase/reverse/line renderer is the next stage.
        XOR A
        JP AM_RAW
AM_BEGIN:
        LD A,1
        LD (AM_STATE),A
        RET
AM_STATE: DB 0
AM_PENDING_ROW: DB 0
AM_VISIBLE: DB 1
        .DEPHASE
        END
