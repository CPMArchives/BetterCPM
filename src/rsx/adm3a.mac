        INCLUDE backend.inc
; MM-style ADM-3A development provider. Movement/erase/scroll are implemented;
; 0Fh and line-operation semantics remain gates. Do not ship as complete.
RSXBASE         EQU     08000H
        CSEG
        .PHASE RSXBASE
AM_NEXT: DW 5
AM_DISPATCH_WORD: DW AM_CHAIN
        DB 0,0
        DW 0
AM_CHAIN:
        LD HL,(AM_NEXT)
        JP (HL)
AM_ENTRY:
        OR A
        JP Z,AM_OUTPUT
        CP 3
        JR Z,AM_CURSOR
        CP 4
        JP Z,AM_CLEAR
        CP 5
        JP Z,AM_RESET
AM_RAW:
        LD HL,(1)
        LD DE,66                        ; MONRAW = WBOOT+66
        ADD HL,DE
        JP (HL)
AM_CURSOR:
        LD A,(AM_VISIBLE)
        OR A
        RET Z
        LD A,3
        JP AM_RAW
AM_CLEAR:
        CALL AM_RESET
        CALL AM_HOME
        JP AM_EOS                      ; share mode-aware erase; no keyboard reset
AM_RESET:
        XOR A
        LD (AM_STATE),A
        RET
AM_OUTPUT:
        LD A,(AM_STATE)
        OR A
        JR Z,AM_NORMAL
        CP 1
        JR Z,AM_ESCAPE
        CP 2
        JR Z,AM_ROW
        LD A,C
        SUB 32
        CP 80
        JR C,AM_COLUMN_OK
        LD A,79
AM_COLUMN_OK:
        LD (M4COLUMN),A
        LD B,A
        LD A,(AM_PENDING_ROW)
        LD L,A
        LD H,0
        ; row*80 = row*16 + row*64; all addresses are external video memory.
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        LD D,H
        LD E,L
        ADD HL,HL
        ADD HL,HL
        ADD HL,DE
        LD E,B
        LD D,0
        ADD HL,DE
        LD DE,0F800H
        ADD HL,DE
        LD (M4CURSOR),HL
        JP AM_RESET
AM_ROW:
        LD A,C
        SUB 32
        CP 24
        JR C,AM_ROW_OK
        LD A,23
AM_ROW_OK:
        LD (AM_PENDING_ROW),A
        LD A,3
        LD (AM_STATE),A
        RET
AM_ESCAPE:
        CALL AM_RESET
        LD A,C
        CP '='
        JR Z,AM_ADDRESS
        CP '0'
        JR Z,AM_HIDE
        CP '1'
        RET NZ                         ; unknown selector consumed
        LD A,1
        LD (AM_VISIBLE),A
        RET
AM_HIDE:
        XOR A
        LD (AM_VISIBLE),A
        RET
AM_ADDRESS:
        LD A,2
        LD (AM_STATE),A
        RET
AM_NORMAL:
        LD A,C
        CP 32
        JP NC,AM_PRINT
        CP 27
        JP Z,AM_BEGIN
        CP 26
        JP Z,AM_CLEAR
        CP 7
        JP Z,AM_BELL
        CP 14
        JP Z,AM_REV_OFF
        CP 22
        JP Z,AM_REV_TOGGLE
        CP 8
        JP Z,AM_LEFT
        CP 9
        JP Z,AM_TAB
        CP 10
        JP Z,AM_DOWN
        CP 11
        JP Z,AM_UP
        CP 12
        JP Z,AM_RIGHT
        CP 13
        JP Z,AM_CR
        CP 21
        JP Z,AM_EOL
        CP 24
        JP Z,AM_EOL
        CP 23
        JP Z,AM_EOS
        CP 25
        JP Z,AM_EOS
        CP 30
        JP Z,AM_HOME
        ; Unsupported and not-yet-qualified controls are consumed. In particular
        ; 1Ch must not reach the basic renderer, where it means clear screen.
        RET
AM_PRINT:
        LD HL,(M4CURSOR)
        LD A,(AM_REVERSE)
        OR C
        LD (HL),A
AM_RIGHT:
        LD HL,(M4CURSOR)
        INC HL
        LD A,(M4COLUMN)
        INC A
        CP 80
        JR C,AM_SETCOL
        XOR A
        LD (M4COLUMN),A
        JP AM_SCROLL
AM_SETCOL:
        LD (M4COLUMN),A
AM_STORE:
        LD (M4CURSOR),HL
        RET
AM_LEFT:
        LD HL,(M4CURSOR)
        LD DE,0F800H
        OR A
        SBC HL,DE
        RET Z
        ADD HL,DE
        DEC HL
        LD A,(M4COLUMN)
        OR A
        JR NZ,AM_LEFT_COLUMN
        LD A,80
AM_LEFT_COLUMN:
        DEC A
        JR AM_SETCOL
AM_TAB:
        ; Cursor movement only; tab does not overwrite intervening cells.
        CALL AM_RIGHT
        LD A,(M4COLUMN)
        AND 7
        JR NZ,AM_TAB
        RET
AM_DOWN:
        LD HL,(M4CURSOR)
        LD DE,80
        ADD HL,DE
AM_SCROLL:
        LD DE,0FF80H
        OR A
        SBC HL,DE
        JR C,AM_WITHIN_SCREEN
        ADD HL,DE
        LD DE,80
        OR A
        SBC HL,DE
        LD (M4CURSOR),HL
        ; Move rows 1..23 up and clear the newly exposed bottom row.
        LD HL,0F850H
        LD DE,0F800H
        LD BC,1840
        LDIR
        LD HL,0FF30H
        LD BC,80
        JP AM_FILL
AM_WITHIN_SCREEN:
        ADD HL,DE
        JR AM_STORE
AM_UP:
        LD HL,(M4CURSOR)
        LD DE,0F850H
        OR A
        SBC HL,DE
        RET C
        LD DE,0F800H
        ADD HL,DE
        JR AM_STORE
AM_CR:
        LD HL,(M4CURSOR)
        LD A,(M4COLUMN)
        LD E,A
        LD D,0
        OR A
        SBC HL,DE
        XOR A
        JR AM_SETCOL
AM_HOME:
        LD HL,0F800H
        XOR A
        JP AM_SETCOL
AM_EOL:
        LD A,(M4COLUMN)
        LD B,A
        LD A,80
        SUB B
        LD C,A
        LD B,0
        LD HL,(M4CURSOR)
        JR AM_FILL
AM_EOS:
        LD HL,0FF80H
        LD DE,(M4CURSOR)
        OR A
        SBC HL,DE
        LD B,H
        LD C,L
        EX DE,HL
AM_FILL:
        ; Erasures and scroll fill use the current MM reverse-video mode.
        LD A,(AM_REVERSE)
        OR 32
        LD D,A
AM_FILL_NEXT:
        LD (HL),D
        INC HL
        DEC BC
        LD A,B
        OR C
        JR NZ,AM_FILL_NEXT
        RET
AM_REV_OFF:
        XOR A
        LD (AM_REVERSE),A
        RET
AM_REV_TOGGLE:
        LD A,(AM_REVERSE)
        XOR 080H
        LD (AM_REVERSE),A
        RET
AM_BELL:
        ; Model 4 sound port: bounded 256 cycles, each half held for 100 writes.
        ; No BDOS, keyboard polling or mutation of display/parser state.
        LD C,0
AM_TONE:
        LD A,1
        LD B,100
AM_HIGH:
        OUT (090H),A
        DJNZ AM_HIGH
        XOR A
        LD B,100
AM_LOW:
        OUT (090H),A
        DJNZ AM_LOW
        DEC C
        JR NZ,AM_TONE
        RET
AM_BEGIN:
        LD A,1
        LD (AM_STATE),A
        RET
AM_STATE: DB 0
AM_PENDING_ROW: DB 0
AM_VISIBLE: DB 1
AM_REVERSE: DB 0
        .DEPHASE
        END
