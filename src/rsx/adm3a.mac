; Portable MM-style ADM-3A personality; rendering uses the bound SCRN service.
RSXBASE         EQU     08000H
        CSEG
        .PHASE RSXBASE
AM_NEXT: DW 5
AM_DISPATCH_WORD: DW AM_CHAIN
        DB 0,0
        DW 0
AM_CHAIN:
        LD HL,(AM_NEXT)
        JP (HL)
AM_BACKEND: DW 0                       ; manager-owned MCON 1.1 word at +12
AM_ENTRY:
        OR A
        JP Z,AM_OUTPUT
        CP 1
        JP Z,AM_RAW
        CP 2
        JP Z,AM_RAW
        CP 3
        JR Z,AM_CURSOR
        CP 4
        JP Z,AM_CLEAR
        CP 5
        JP Z,AM_RESET
        LD A,255
        RET
AM_RAW:
        LD HL,(AM_BACKEND)
        JP (HL)
AM_CURSOR:
        LD A,(AM_VISIBLE)
        OR A
        RET Z
        LD A,C
        OR A
        LD A,1
        RET Z                          ; logical MM cursor visibility query
        LD A,C
        OR 128
        LD C,A
        PUSH DE                        ; BF_CURSOR inspects original E after return
        CALL AM_PRINT
        POP DE
        LD A,1
        RET
AM_CLEAR:
        CALL AM_RESET
        CALL AM_HOME
        JP AM_EOS                      ; share mode-aware erase; no keyboard reset
AM_RESET:
        XOR A
        LD (AM_STATE),A
        RET
AM_OUTPUT:
        LD A,(AM_STATE)
        OR A
        JR Z,AM_NORMAL
        CP 1
        JR Z,AM_ESCAPE
        CP 2
        JR Z,AM_ROW
        LD A,C
        SUB 32
        CP 80
        JR C,AM_COLUMN_OK
        LD A,79
AM_COLUMN_OK:
        LD (AM_COLPOS),A
        LD A,(AM_PENDING_ROW)
        LD (AM_ROWPOS),A
        CALL AM_RESET
        JP AM_POSITION
AM_ROW:
        LD A,C
        SUB 32
        CP 24
        JR C,AM_ROW_OK
        LD A,23
AM_ROW_OK:
        LD (AM_PENDING_ROW),A
        LD A,3
        LD (AM_STATE),A
        RET
AM_ESCAPE:
        CALL AM_RESET
        LD A,C
        CP '='
        JR Z,AM_ADDRESS
        CP '0'
        JR Z,AM_HIDE
        CP '1'
        RET NZ                         ; unknown selector consumed
        LD A,1
        LD (AM_VISIBLE),A
        LD C,A
        LD A,15
        JP AM_RAW
AM_HIDE:
        XOR A
        LD (AM_VISIBLE),A
        LD C,A
        LD A,15
        JP AM_RAW
AM_ADDRESS:
        LD A,2
        LD (AM_STATE),A
        RET
AM_NORMAL:
        LD A,C
        CP 32
        JP NC,AM_PRINT
        CP 27
        JP Z,AM_BEGIN
        CP 26
        JP Z,AM_CLEAR
        CP 7
        JP Z,AM_BELL
        CP 15
        JP Z,AM_ON
        CP 28
        JP Z,AM_INSERT
        CP 29
        JP Z,AM_DELETE
        CP 14
        JP Z,AM_OFF
        CP 22
        JP Z,AM_REV_TOGGLE
        CP 8
        JP Z,AM_LEFT
        CP 9
        JP Z,AM_TAB
        CP 10
        JP Z,AM_DOWN
        CP 11
        JP Z,AM_UP
        CP 12
        JP Z,AM_RIGHT
        CP 13
        JP Z,AM_CR
        CP 21
        JP Z,AM_EOL
        CP 24
        JP Z,AM_EOL
        CP 23
        JP Z,AM_EOS
        CP 25
        JP Z,AM_EOS
        CP 30
        JP Z,AM_HOME
        ; Unassigned MM control bytes are consumed, never sent to the basic
        ; renderer with its different control meanings.
        RET
AM_PRINT:
        LD A,(AM_REVERSE)
        OR C
        LD C,A
        LD A,7
        CALL AM_RAW
        LD A,(AM_COLPOS)
        CP 79
        JR Z,AM_RIGHT                  ; MM wraps; backend primitive clamps
        INC A
        LD (AM_COLPOS),A
        RET
AM_RIGHT:
        LD A,(AM_COLPOS)
        INC A
        CP 80
        JR C,AM_SETCOL
        XOR A
        LD (AM_COLPOS),A
        JP AM_DOWN
AM_SETCOL:
        LD (AM_COLPOS),A
        JP AM_POSITION
AM_LEFT:
        LD A,(AM_COLPOS)
        OR A
        JR NZ,AM_LEFT_COLUMN
        LD A,(AM_ROWPOS)
        OR A
        RET Z
        DEC A
        LD (AM_ROWPOS),A
        LD A,80
AM_LEFT_COLUMN:
        DEC A
        JR AM_SETCOL
AM_TAB:
        CALL AM_RIGHT
        LD A,(AM_COLPOS)
        AND 7
        JR NZ,AM_TAB
        RET
AM_DOWN:
        LD A,(AM_ROWPOS)
        CP 23
        JR Z,AM_SCROLL
        INC A
        LD (AM_ROWPOS),A
        JR AM_POSITION
AM_SCROLL:
        CALL AM_FILL_VALUE
        LD A,10
        CALL AM_RAW
        JR AM_POSITION
AM_UP:
        LD A,(AM_ROWPOS)
        OR A
        RET Z
        DEC A
        LD (AM_ROWPOS),A
        JR AM_POSITION
AM_CR:
        XOR A
        JR AM_SETCOL
AM_HOME:
        XOR A
        LD (AM_ROWPOS),A
        JR AM_SETCOL
AM_POSITION:
        LD A,(AM_ROWPOS)
        LD B,A
        LD A,(AM_COLPOS)
        LD C,A
        LD A,6
        JP AM_RAW
AM_FILL_VALUE:
        LD A,(AM_REVERSE)
        OR 32
        LD C,A
        RET
AM_EOL:
        CALL AM_FILL_VALUE
        LD A,8
        JP AM_RAW
AM_EOS:
        CALL AM_FILL_VALUE
        LD A,9
        JP AM_RAW
AM_INSERT:
        CALL AM_FILL_VALUE
        LD A,13
        JP AM_RAW
AM_DELETE:
        CALL AM_FILL_VALUE
        LD A,14
        JP AM_RAW
AM_ON:
        ; Original MM 2.32 dispatch reaches an unconditional reverse-ON path.
        LD A,080H
        LD (AM_REVERSE),A
        RET
AM_OFF:
        XOR A
        LD (AM_REVERSE),A
        RET
AM_REV_TOGGLE:
        LD A,(AM_REVERSE)
        XOR 080H
        LD (AM_REVERSE),A
        RET
AM_BELL:
        LD C,7
        XOR A
        JP AM_RAW
AM_BEGIN:
        LD A,1
        LD (AM_STATE),A
        RET
AM_ROWPOS: DB 0
AM_COLPOS: DB 0
AM_STATE: DB 0
AM_PENDING_ROW: DB 0
AM_VISIBLE: DB 1
AM_REVERSE: DB 0
        .DEPHASE
        END
