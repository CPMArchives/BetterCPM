        INCLUDE layout.inc

; ********************************************************************************
; *                          BetterCP/M ECHO RSX                                *
; *                                                                              *
; * Second protected-RSX proof module. Provides a distinct test service to verify*
; * that a later extension chains correctly to an earlier RSX instead of         *
; * replacing it.                                                                *
; ********************************************************************************

RSXBASE         EQU     08000H
BDOS            EQU     00005H

        CSEG
        .PHASE  RSXBASE

ER_NEXT:        DW      BDOS            ; next RSX descriptor pointer
ER_ENTRY:       DW      ER_DISPATCH     ; RSX entry pointer
ER_SVCOUNT:     DB      0               ; callable-service count
ER_RESERVED:    DB      0               ; reserved service metadata
ER_SVOFF:       DW      0               ; resident-service entry offset

; ================================================================================
; =                           Echo Proof Service                                =
; =                                                                              =
; = Intercepts its private proof request, returns the module-specific response,  =
; = and chains every other call to the next RSX or fixed BDOS.                   =
; ================================================================================

ER_DISPATCH:                            ; intercept echo service call
        LD      A,C
        CP      199
        JR      NZ,ER_CHAIN
        LD      DE,ER_MESSAGE
        LD      C,9
        CALL    BDOS
        LD      HL,04543H               ; "EC" proof signature
        LD      A,L
        RET

ER_CHAIN:                               ; chain unhandled call to lower layer
        LD      HL,(ER_NEXT)
        JP      (HL)

; -------------------------------------------------------------------------------
; Proof-Service Data
; -------------------------------------------------------------------------------

ER_MESSAGE:     DB      13,10,'Hello from ECHO.RSX',13,10,'$' ; echo proof-service message

        .DEPHASE
        END
