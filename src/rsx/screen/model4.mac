; Build-matched Model 4 hardware backend. No terminal grammar lives here.
        INCLUDE backend.inc
BASE EQU 08000H
        ASEG
        ORG BASE
S_NEXT: DW 5
S_DISP: DW S_CHAIN
        DW 0,0
S_CHAIN:
        LD HL,(S_NEXT)
        JP (HL)
S_ENTRY:
        CP 16
        JP NC,SX_ENTRY
        CP 6
        JR NC,S_SWITCH
        OR A
        JR NZ,S_RAW
        LD A,C
        CP 7
        JP Z,S_BELL
        XOR A
S_RAW:
        LD HL,(1)
        LD DE,66
        ADD HL,DE
        JP (HL)
S_SWITCH:
        SUB 6
        CP 10
        JP NC,S_BAD
        PUSH AF
        CP 2
        JR C,S_ARGOK
        CP 6
        JR Z,S_ARGOK
        CP 9
        JR NC,S_ARGOK
        LD A,C
        AND 127
        CP 32
        JR Z,S_ARGOK
        POP AF
        JP S_BAD
S_ARGOK:
        POP AF
        ADD A,A
        LD E,A
        LD D,0
        LD HL,S_TABLE
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        EX DE,HL
        JP (HL)
S_BAD:
        LD A,255
        RET
S_TABLE:
        DW S_POS,S_PUT,S_EOL,S_EOS,S_UP,S_DOWN,S_QUERY,S_INSERT,S_DELETE,S_VIS
S_QUERY:
        LD HL,S_DESC
        RET
S_DESC: DB 'SCR',1,0,24,80
        DW 0FFFFH
S_POS:
        LD A,B
        CP 24
        JR NC,S_BAD
        LD A,C
        CP 80
        JR NC,S_BAD
        XOR A
        LD (SX_PEND),A                ; explicit positioning cancels delayed wrap
        LD L,B
        LD H,0
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        LD D,H
        LD E,L
        ADD HL,HL
        ADD HL,HL
        ADD HL,DE
        LD E,C
        LD D,0
        ADD HL,DE
        LD DE,0F800H
        ADD HL,DE
        LD (M4CURSOR),HL
        LD A,C
        LD (M4COLUMN),A
        RET
S_PUT:
        ; A cell is a literal display byte. Preserve MM's complete video-byte
        ; repertoire; controls are interpreted only by the personality.
        LD HL,(M4CURSOR)
        LD (HL),C
        LD A,(M4COLUMN)
        CP 79
        RET Z
        INC A
        LD (M4COLUMN),A
        INC HL
        LD (M4CURSOR),HL
        RET
S_EOL:
        LD A,C
        LD (S_FILLBYTE),A
        LD A,(M4COLUMN)
        LD B,A
        LD A,80
        SUB B
        LD C,A
        LD B,0
        LD HL,(M4CURSOR)
        JP S_FILL
S_EOS:
        LD A,C
        LD (S_FILLBYTE),A
        LD HL,0FF80H
        LD DE,(M4CURSOR)
        OR A
        SBC HL,DE
        LD B,H
        LD C,L
        EX DE,HL
        JP S_FILL
S_UP:
        LD A,C
        LD (S_FILLBYTE),A
        LD HL,0F850H
        LD DE,0F800H
        LD BC,1840
        LDIR
        LD HL,0FF30H
        JP S_BLANK
S_DOWN:
        LD A,C
        LD (S_FILLBYTE),A
        LD HL,0FF2FH
        LD DE,0FF7FH
        LD BC,1840
        LDDR
        LD HL,0F800H
S_BLANK:
        LD BC,80
S_FILL:
        LD A,(S_FILLBYTE)
        LD D,A
S_LOOP:
        LD (HL),D
        INC HL
        DEC BC
        LD A,B
        OR C
        JR NZ,S_LOOP
        RET
S_LINE:
        LD A,C
        LD (S_FILLBYTE),A
        LD HL,(M4CURSOR)
        LD A,(M4COLUMN)
        LD E,A
        LD D,0
        OR A
        SBC HL,DE
        EX DE,HL
        LD HL,0FF30H
        OR A
        SBC HL,DE
        LD B,H
        LD C,L
        EX DE,HL
        RET
S_INSERT:
        CALL S_LINE
        JR Z,S_LAST
        PUSH HL
        LD HL,0FF2FH
        LD DE,0FF7FH
        LDDR
        POP HL
        JP S_BLANK
S_DELETE:
        CALL S_LINE
        JR Z,S_LAST
        PUSH HL
        LD DE,80
        ADD HL,DE
        POP DE
        LDIR
S_LAST:
        LD HL,0FF30H
        JP S_BLANK
S_VIS:
        LD A,C
        CP 2
        JP NC,S_BAD
        ; Model 4 cursor presentation is drawn by the MCON private operation.
        ; The personality owns visibility and must gate that operation.
        RET
S_BELL:
        LD C,0
S_TONE:
        LD A,1
        LD B,100
S_HIGH:
        OUT (090H),A
        DJNZ S_HIGH
        XOR A
        LD B,100
S_LOW:
        OUT (090H),A
        DJNZ S_LOW
        DEC C
        JR NZ,S_TONE
        RET
S_FILLBYTE: DB 32
; Optional SCX controls; leave the original fixed-cell interface unchanged.
SX_ENTRY:
        CP 16
        JP Z,SX_QUERY
        CP 17
        JP Z,SX_MOVE
        CP 19
        JP Z,SE_ENTRY
        CP 22
        JP Z,SM_SET
        CP 23
        JP Z,SS_ENTRY
        CP 24
        JP Z,SI_ENTRY
        CP 20
        JP Z,SX_STYLE
        CP 21
        JP Z,SX_GLYPH
        CP 18
        JP NZ,S_BAD
        LD A,H
        OR A
        LD A,23
        JR NZ,SX_ROWOK
        LD A,L
        OR A
        JR Z,SX_ROWOK
        DEC A
        CP 24
        JR C,SX_ROWOK
        LD A,23
SX_ROWOK:
        LD B,A
        LD A,D
        OR A
        LD A,79
        JR NZ,SX_COLOK
        LD A,E
        OR A
        JR Z,SX_COLOK
        DEC A
        CP 80
        JR C,SX_COLOK
        LD A,79
SX_COLOK:
        LD C,A
SX_APPLY:
        CALL S_POS
        XOR A
        RET
SX_QUERY:
        LD HL,SX_DESC
        XOR A
        RET
SX_DESC: DB 'SCX',1,0,12,24,80
        DW 0FFH
        DB 060H,0                    ; reverse + conceal, no physical color
SX_MOVE:
        LD A,B
        CP 4
        JP NC,S_BAD
        LD (SX_DIR),A
        LD A,H
        OR A
        LD A,255
        JR NZ,SX_COUNT
        LD A,L
        OR A
        JR NZ,SX_COUNT
        INC A
SX_COUNT:
        LD (SX_STEP),A
        LD HL,(M4CURSOR)
        LD DE,0F800H
        OR A
        SBC HL,DE
        LD DE,80
        LD B,0
SX_ROW:
        OR A
        SBC HL,DE
        JR C,SX_FOUND
        INC B
        JR SX_ROW
SX_FOUND:
        ADD HL,DE
        LD C,L
        LD A,(SX_STEP)
        LD E,A
        LD A,(SX_DIR)
        OR A
        JR Z,SX_UP
        CP 1
        JR Z,SX_DOWN
        CP 2
        JR Z,SX_RIGHT
        LD A,C
        SUB E
        JR NC,SX_LEFT
        XOR A
SX_LEFT:
        LD C,A
        JR SX_APPLY
SX_RIGHT:
        LD A,C
        ADD A,E
        JR C,SX_RMAX
        CP 80
        JR C,SX_LEFT
SX_RMAX:
        LD A,79
        JR SX_LEFT
SX_UP:
        LD A,B
        SUB E
        JR NC,SX_YSET
        XOR A
        JR SX_YSET
SX_DOWN:
        LD A,B
        ADD A,E
        JR C,SX_DMAX
        CP 24
        JR C,SX_YSET
SX_DMAX:
        LD A,23
SX_YSET:
        LD B,A
        JP SX_APPLY
SX_DIR: DB 0
SX_STEP: DB 0
; Canonical rendition: flags, foreground kind/RGB, background kind/RGB.
; Unsupported physical attributes/colors remain in state but have no effect.
SX_STYLE:
        PUSH HL
        INC HL
        LD A,(HL)
        CP 3
        JR NC,SX_SBAD
        LD DE,4
        ADD HL,DE
        LD A,(HL)
        CP 3
        JR NC,SX_SBAD
        POP HL
        LD DE,SX_ATTR
        LD BC,9
        LDIR
        XOR A
        RET
SX_SBAD:
        POP HL
        JP S_BAD
SX_GLYPH:
        LD A,C
        CP 32
        JP C,S_BAD
        CP 127
        JP NC,S_BAD
        PUSH BC
        LD A,(SX_PEND)
        OR A
        CALL NZ,SX_WNEXT
        POP BC
        LD A,(SX_ATTR)
        AND 64
        JR Z,SX_VCHAR
        LD C,32
SX_VCHAR:
        LD A,(SX_ATTR)
        AND 32
        JR Z,SX_NCHAR
        LD A,C
        OR 128
        LD C,A
SX_NCHAR:
        LD A,(M4COLUMN)
        CP 79
        JR Z,SX_MARK
        CALL S_PUT
        XOR A
        RET
SX_MARK:
        CALL S_PUT
        LD A,1
        LD (SX_PEND),A                ; ANSI wrap is deferred until the next glyph
        XOR A
        RET
SX_WNEXT:
        LD B,1                        ; wrap is index plus carriage return
        JP SI_ENTRY
SX_PEND: DB 0
SX_ATTR: DB 0,0,0,0,0,0,0,0,0

; SCX 19: B=0 line / 1 screen, C=0 suffix / 1 prefix / 2 all.
; Inclusive endpoints; preserve physical cursor and delayed-wrap state.
SE_ENTRY:
        LD A,B
        CP 2
        JP NC,S_BAD
        LD A,C
        CP 3
        JP NC,S_BAD
        LD (SE_MODE),A
        LD HL,0F800H
        LD DE,0FF80H
        LD A,B
        OR A
        JR NZ,SE_RANGE
        LD HL,(M4CURSOR)
        LD A,(M4COLUMN)
        LD C,A
        LD B,0
        OR A
        SBC HL,BC
        LD D,H
        LD E,L
        PUSH HL
        LD HL,80
        ADD HL,DE
        EX DE,HL
        POP HL
SE_RANGE:
        LD A,(SE_MODE)
        OR A
        JR Z,SE_FROM
        CP 1
        JR NZ,SE_COUNT
        LD DE,(M4CURSOR)
        INC DE
        JR SE_COUNT
SE_FROM:
        LD HL,(M4CURSOR)
        LD A,(SX_PEND)
        OR A
        JR Z,SE_COUNT
        INC HL                       ; pending wrap is logically past the cell
SE_COUNT:
        PUSH HL
        EX DE,HL
        OR A
        SBC HL,DE
        LD B,H
        LD C,L
        POP HL
        LD A,B
        OR C
        RET Z                        ; suffix at pending line end is empty
        LD A,(SX_ATTR)
        AND 32
        RLCA
        RLCA
        OR 32
        LD (S_FILLBYTE),A
        CALL S_FILL
        XOR A
        RET
SE_MODE: DB 0

; SCX 22: HL/DE are one-based top/bottom, zero means screen default.
; Reject invalid margins before mutation; setting margins homes the cursor.
SM_SET:
        LD A,H
        OR D
        JP NZ,S_BAD
        LD A,L
        OR A
        JR NZ,SM_TOP
        INC A
SM_TOP:
        DEC A
        CP 24
        JP NC,S_BAD
        LD B,A
        LD A,E
        OR A
        JR NZ,SM_BOT
        LD A,24
SM_BOT:
        DEC A
        CP 24
        JP NC,S_BAD
        CP B
        JP C,S_BAD
        JP Z,S_BAD
        LD (SM_BOTTOM),A
        LD A,B
        LD (SM_TOPROW),A
        LD BC,0
        JP SX_APPLY
SM_TOPROW: DB 0
SM_BOTTOM: DB 23
; Current physical row/column. Do not change the cursor or wrap latch.
SM_CUR:
        LD HL,(M4CURSOR)
        LD DE,0F800H
        OR A
        SBC HL,DE
        LD DE,80
        LD B,0
SM_DIV:
        OR A
        SBC HL,DE
        JR C,SM_FOUND
        INC B
        JR SM_DIV
SM_FOUND:
        ADD HL,DE
        LD C,L
        RET
; SCX 24: B=0 index, 1 next line, 2 reverse index.
SI_ENTRY:
        LD A,B
        CP 3
        JP NC,S_BAD
        LD (SI_KIND),A
        CALL SM_CUR
        LD A,(SI_KIND)
        CP 1
        JR NZ,SI_COLUMN
        LD C,0
SI_COLUMN:
        LD A,(SI_KIND)
        CP 2
        JR Z,SI_REVERSE
        LD A,(SM_BOTTOM)
        CP B
        JR Z,SI_UP
        LD A,B
        CP 23
        JR Z,SI_APPLY
        INC B
        JR SI_APPLY
SI_REVERSE:
        LD A,(SM_TOPROW)
        CP B
        JR Z,SI_DOWN
        LD A,B
        OR A
        JR Z,SI_APPLY
        DEC B
SI_APPLY:
        JP SX_APPLY
SI_UP:
        XOR A
        JR SI_SCROLL
SI_DOWN:
        LD A,1
SI_SCROLL:
        PUSH BC
        PUSH AF
        LD A,(SX_ATTR)
        AND 32
        RLCA
        RLCA
        OR 32
        LD E,A
        LD A,(SM_TOPROW)
        LD B,A
        LD A,(SM_BOTTOM)
        LD C,A
        POP AF
        CALL RG_ENTRY
        POP BC
        JR SI_APPLY
SI_KIND: DB 0
RG_ENTRY:
        CP 2
        JP NC,RG_BAD
        LD (RG_DIR),A
        LD A,E
        AND 127
        CP 32
        JP NZ,RG_BAD
        LD A,C
        CP 24
        JP NC,RG_BAD
        CP B
        JP C,RG_BAD
        LD A,E
        LD (RG_FILL),A
        LD A,B
        CALL RG_ADDR
        LD (RG_TOP),HL
        LD A,C
        CALL RG_ADDR
        LD (RG_BOT),HL
        LD A,C
        SUB B
        LD L,A
        LD H,0
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        LD D,H
        LD E,L
        ADD HL,HL
        ADD HL,HL
        ADD HL,DE                     ; (bottom-top)*80 bytes
        LD B,H
        LD C,L
        LD A,B
        OR C
        JR Z,RG_SINGLE
        LD A,(RG_DIR)
        OR A
        JR NZ,RG_DOWN
        LD DE,(RG_TOP)
        LD HL,80
        ADD HL,DE
        LDIR
        LD HL,(RG_BOT)
        JR RG_BLANK
RG_DOWN:
        LD HL,(RG_BOT)
        LD DE,79
        ADD HL,DE
        EX DE,HL                      ; end of destination
        LD HL,(RG_BOT)
        DEC HL                        ; end of source
        LDDR
RG_SINGLE:
        LD HL,(RG_TOP)
RG_BLANK:
        LD A,(RG_FILL)
        LD B,80
RG_PAINT:
        LD (HL),A
        INC HL
        DJNZ RG_PAINT
        XOR A
        RET
RG_BAD:
        LD A,255
        RET
RG_ADDR:
        PUSH BC
        LD L,A
        LD H,0
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        LD D,H
        LD E,L
        ADD HL,HL
        ADD HL,HL
        ADD HL,DE
        LD DE,0F800H
        ADD HL,DE
        POP BC
        RET
RG_TOP: DW 0
RG_BOT: DW 0
RG_FILL: DB 32
RG_DIR: DB 0

; SCX 23: B=0 replace the single save slot; B=1 restore it.
; Restore before save is rejected atomically. Margins are not saved.
; Restoration is explicit positioning and cancels pending wrapping.
SS_ENTRY:
        LD A,B
        OR A
        JR Z,SS_SAVE
        CP 1
        JP NZ,S_BAD
        LD A,(SS_VALID)
        OR A
        JP Z,S_BAD
        LD HL,(SS_CURSOR)
        LD (M4CURSOR),HL
        LD A,(SS_COLUMN)
        LD (M4COLUMN),A
        LD HL,SS_ATTR
        LD DE,SX_ATTR
        LD BC,9
        LDIR
        XOR A
        LD (SX_PEND),A
        RET
SS_SAVE:
        LD HL,(M4CURSOR)
        LD (SS_CURSOR),HL
        LD A,(M4COLUMN)
        LD (SS_COLUMN),A
        LD HL,SX_ATTR
        LD DE,SS_ATTR
        LD BC,9
        LDIR
        LD A,1
        LD (SS_VALID),A
        XOR A
        RET
SS_VALID: DB 0
SS_CURSOR: DW 0
SS_COLUMN: DB 0
SS_ATTR: DB 0,0,0,0,0,0,0,0,0
        END
