; Production screen primitives to an ANSI-capable 80x24 host endpoint.
; The hardware/transport choice is in this module, never in a personality.
        ASEG
        ORG 08000H
B_NEXT: DW 5
B_DISP: DW B_CHAIN
        DW 0,0
B_CHAIN:
        LD HL,(B_NEXT)
        JP (HL)
SB_ENTRY:
        CP 16
        JP NC,BX_ENTRY
        CP 6
        JP C,B_RAW
        SUB 6
        CP 10
        JR NC,B_BAD
        PUSH AF
        CP 2
        JR C,B_ARGOK
        CP 6
        JR Z,B_ARGOK
        CP 9
        JR NC,B_ARGOK
        LD A,C
        AND 127
        CP 32
        JR Z,B_ARGOK
        POP AF
        JP B_BAD
B_ARGOK:
        POP AF
        ADD A,A
        LD E,A
        LD D,0
        LD HL,B_TABLE
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        EX DE,HL
        JP (HL)
B_BAD:
        LD A,255
        RET
B_RAW:
        LD HL,(1)
        LD DE,66
        ADD HL,DE
        JP (HL)
B_EMIT:
        PUSH BC
        PUSH DE
        PUSH HL
        XOR A
        CALL B_RAW
        POP HL
        POP DE
        POP BC
        RET
B_STR:
        LD C,(HL)
        INC HL
        LD A,C
        OR A
        RET Z
        CALL B_EMIT
        JR B_STR
B_TABLE:
        DW B_POS,B_PUT,B_EOL,B_EOS,B_UP,B_DOWN,B_QUERY,B_INSERT,B_DELETE,B_VIS
B_QUERY:
        LD HL,B_DESC
        RET
B_DESC: DB 'SCR',1,0,24,80
        DW 0FFFFH
B_POS:
        LD A,B
        CP 24
        JR NC,B_BAD
        LD A,C
        CP 80
        JR NC,B_BAD
        LD (B_COL),A
        LD A,B
        LD (B_ROW),A
B_POSITION:
        LD HL,B_CSI
        CALL B_STR
        LD A,(B_ROW)
        INC A
        CALL B_DEC
        LD C,';'
        CALL B_EMIT
        LD A,(B_COL)
        INC A
        CALL B_DEC
        LD C,'H'
        JP B_EMIT
B_DEC:
        LD B,0
B_TENS:
        CP 10
        JR C,B_UNIT
        SUB 10
        INC B
        JR B_TENS
B_UNIT:
        PUSH AF
        LD A,B
        OR A
        JR Z,B_LAST
        ADD A,'0'
        LD C,A
        CALL B_EMIT
B_LAST:
        POP AF
        ADD A,'0'
        LD C,A
        JP B_EMIT
B_PUT:
        LD A,C
        AND 127
        CP 32
        JR C,B_GLYPH
        CP 127
        JR C,B_PRINT
B_GLYPH:
        ; No portable ASCII glyph exists for these display codes. Render one
        ; visible cell without allowing a literal control byte onto the wire.
        LD A,C
        AND 128
        OR '?'
        LD C,A
B_PRINT:
        CALL B_ATTR
        LD A,C
        AND 127
        LD C,A
        CALL B_EMIT
        LD A,(B_COL)
        CP 79
        JP Z,B_POSITION                ; cancel ANSI delayed wrap only at edge
        INC A
        LD (B_COL),A
        RET
B_ATTR:
        XOR A
        LD (BH_MODE),A               ; legacy rendition supersedes styled mode
        LD A,C
        AND 128
        LD B,A
        LD A,(B_STYLE)
        CP B
        RET Z
        LD A,B
        LD (B_STYLE),A
        PUSH BC
        LD HL,B_NORMAL
        OR A
        JR Z,B_SETATTR
        LD HL,B_REVERSE
B_SETATTR:
        CALL B_STR
        POP BC
        RET
B_EOL:
        LD A,C
        LD (B_FILL),A
        CALL B_ATTR
        LD A,(B_FILL)
        AND 128
        JR NZ,B_REOL
        LD HL,B_K
        JP B_STR
B_REOL:
        CALL B_TAIL
        JP B_POSITION
B_TAIL:
        LD A,(B_COL)
        LD B,A
        LD A,80
        SUB B
        LD B,A
        JP B_SPACES
B_EOS:
        LD A,C
        LD (B_FILL),A
        CALL B_ATTR
        LD A,(B_FILL)
        AND 128
        JR NZ,B_REOS
        LD HL,B_J
        JP B_STR
B_REOS:
        CALL B_TAIL
        LD A,(B_ROW)
        INC A
        LD (B_SCAN),A
B_ELOOP:
        LD A,(B_SCAN)
        CP 24
        JP NC,B_POSITION
        LD HL,B_CSI
        CALL B_STR
        LD A,(B_SCAN)
        INC A
        CALL B_DEC
        LD HL,B_COLONE
        CALL B_STR
        CALL B_BLANK
        LD A,(B_SCAN)
        INC A
        LD (B_SCAN),A
        JR B_ELOOP
B_SCAN: DB 0
B_COLONE: DB ';1H',0
B_UP:
        LD A,C
        LD (B_FILL),A
        CALL B_ATTR
        CALL B_AREA
        LD HL,B_BOTTOM
        CALL B_STR
        LD C,10
        CALL B_EMIT
        CALL B_BLANK
        JR B_RESTORE
B_DOWN:
        LD A,C
        LD (B_FILL),A
        CALL B_ATTR
        CALL B_AREA
        LD HL,B_HOME
        CALL B_STR
        LD HL,B_RI
        CALL B_STR
        CALL B_BLANK
B_RESTORE:
        LD HL,B_ALL
        CALL B_STR
        JP B_POSITION
B_AREA:
        LD HL,B_MARGIN
        CALL B_STR
        JP B_POSITION
B_INSERT:
        LD A,C
        LD (B_FILL),A
        CALL B_ATTR
        CALL B_AREA
        LD HL,B_IL
        CALL B_STR
        CALL B_BLANK
        JP B_RESTORE
B_DELETE:
        LD A,C
        LD (B_FILL),A
        CALL B_ATTR
        CALL B_AREA
        LD HL,B_DL
        CALL B_STR
        LD HL,B_BOTTOM
        CALL B_STR
        CALL B_BLANK
        JP B_RESTORE
; Paint a full newly inserted line, independent of host erase rendition.
; Address column zero on the current physical row, without changing saved cursor.
B_BLANK:
        LD C,13
        CALL B_EMIT
        LD B,80
B_SPACES:
B_BLLOOP:
        LD A,(B_FILL)
        LD C,A
        PUSH BC
        CALL B_ATTR
        LD C,32
        CALL B_EMIT
        POP BC
        DJNZ B_BLLOOP
        RET
B_FILL: DB 32
B_VIS:
        LD A,C
        CP 2
        JP NC,B_BAD
        LD A,C
        OR A
        LD HL,B_HIDE
        JP Z,B_STR
        LD HL,B_SHOW
        JP B_STR
B_IL: DB 27,'[L',0
B_DL: DB 27,'[M',0
B_HIDE: DB 27,'[?25l',0
B_SHOW: DB 27,'[?25h',0
B_BOTTOM: DB 27,'[24;1H',0
B_HOME: DB 27,'[H',0
B_STYLE: DB 255
B_CSI: DB 27,'[',0
B_NORMAL: DB 27,'[0m',0
B_REVERSE: DB 27,'[7m',0
B_K: DB 27,'[0K',0
B_J: DB 27,'[0J',0
B_RI: DB 27,'M',0
B_MARGIN: DB 27,'[1;24r',0
B_ALL: DB 27,'[r',0
B_ROW: DB 0
B_COL: DB 0
; Optional SCX 1.0 controls. The SCRN 1.0 descriptor and operations stay fixed.
BX_ENTRY:
        CP 16
        JR Z,BX_QUERY
        CP 17
        JR Z,BX_MOVE
        CP 20
        JP Z,BH_STYLE
        CP 21
        JP Z,BH_GLYPH
        CP 18
        JP NZ,B_BAD
        LD A,4
        JP HM_ENTRY
BX_MOVE:
        LD A,B
        CP 4
        JP NC,B_BAD
        JP HM_ENTRY
BX_QUERY:
        LD HL,BX_DESC
        XOR A
        RET
BX_DESC: DB 'SCX',1,0,12,0,0
        DW 01BH                      ; motion, position, rendition, styled glyph
        DB 0FFH,7                    ; all flags, indexed and RGB color
HM_ENTRY:
        CP 5
        JP NC,HM_BAD
        LD (HM_OP),A
        LD (HM_ARG),HL
        LD (HM_COL),DE
        LD C,27
        CALL HM_EMIT
        LD C,'['
        CALL HM_EMIT
        LD HL,(HM_ARG)
        CALL HM_DEC
        LD A,(HM_OP)
        CP 4
        JR NZ,HM_FINAL
        LD C,';'
        CALL HM_EMIT
        LD HL,(HM_COL)
        CALL HM_DEC
HM_FINAL:
        LD A,(HM_OP)
        LD E,A
        LD D,0
        LD HL,HM_CODES
        ADD HL,DE
        LD C,(HL)
        CALL HM_EMIT
        XOR A
        RET
HM_BAD:
        LD A,255
        RET
HM_DEC:
        LD DE,10000
        XOR A
        LD (HM_SEEN),A
        CALL HM_DIGIT
        LD DE,1000
        CALL HM_DIGIT
        LD DE,100
        CALL HM_DIGIT
        LD DE,10
        CALL HM_DIGIT
        LD A,L
        ADD A,'0'
        LD C,A
        JP HM_EMIT
HM_DIGIT:
        LD B,0
HM_SUB:
        OR A
        SBC HL,DE
        JR C,HM_END
        INC B
        JR HM_SUB
HM_END:
        ADD HL,DE
        LD A,B
        OR A
        JR NZ,HM_NONZ
        LD A,(HM_SEEN)
        OR A
        RET Z
HM_NONZ:
        LD A,1
        LD (HM_SEEN),A
        LD A,B
        ADD A,'0'
        LD C,A
HM_EMIT:
        PUSH BC
        PUSH DE
        PUSH HL
        LD HL,(1)
        LD DE,66
        ADD HL,DE
        XOR A
        CALL HM_JUMP
        POP HL
        POP DE
        POP BC
        RET
HM_JUMP:
        JP (HL)
HM_CODES: DB 'ABCDH'
HM_OP: DB 0
HM_SEEN: DB 0
HM_ARG: DW 0
HM_COL: DW 0
; Validate the complete canonical record before changing output or state.
BH_STYLE:
        PUSH HL
        INC HL
        LD A,(HL)
        CP 3
        JR NC,BH_BAD
        LD DE,4
        ADD HL,DE
        LD A,(HL)
        CP 3
        JR NC,BH_BAD
        POP HL
        LD DE,BH_ATTR
        LD BC,9
        LDIR
        XOR A
        LD (BH_MODE),A
        CALL BH_APPLY
        XOR A
        RET
BH_BAD:
        POP HL
        JP B_BAD
BH_GLYPH:
        LD A,C
        CP 32
        JP C,B_BAD
        CP 127
        JP NC,B_BAD
        PUSH BC
        CALL BH_APPLY
        POP BC
        CALL B_EMIT                  ; native host wrapping, no fixed-cell tracker
        XOR A
        RET
BH_APPLY:
        LD A,(BH_MODE)
        OR A
        RET NZ
        LD HL,B_NORMAL
        CALL B_STR
        LD HL,BH_FLAGS
        LD B,8
        LD C,1
BH_BITS:
        LD A,(BH_ATTR)
        AND C
        JR Z,BH_NEXT
        PUSH HL
        PUSH BC
        LD A,(HL)
        CALL BH_CODE
        POP BC
        POP HL
BH_NEXT:
        INC HL
        SLA C
        DJNZ BH_BITS
        LD HL,BH_ATTR+1
        LD A,38
        CALL BH_COLOR
        LD HL,BH_ATTR+5
        LD A,48
        CALL BH_COLOR
        LD A,1
        LD (BH_MODE),A
        LD A,255
        LD (B_STYLE),A               ; force legacy writes to restore their mode
        RET
BH_CODE:
        PUSH AF
        LD HL,B_CSI
        CALL B_STR
        POP AF
        CALL BH_NUMBER
        LD C,'m'
        JP B_EMIT
BH_NUMBER:
        LD L,A
        LD H,0
        JP HM_DEC
BH_COLOR:
        LD (BH_KIND),A
        LD A,(HL)
        OR A
        RET Z
        LD (BH_TYPE),A
        INC HL
        LD (BH_PTR),HL
        LD HL,B_CSI
        CALL B_STR
        LD A,(BH_KIND)
        CALL BH_NUMBER
        LD C,';'
        CALL B_EMIT
        LD A,(BH_TYPE)
        CP 1
        LD C,'5'
        LD B,1
        JR Z,BH_CMODE
        LD C,'2'
        LD B,3
BH_CMODE:
        CALL B_EMIT
BH_PART:
        LD C,';'
        CALL B_EMIT
        LD HL,(BH_PTR)
        LD A,(HL)
        INC HL
        LD (BH_PTR),HL
        PUSH BC
        CALL BH_NUMBER
        POP BC
        DJNZ BH_PART
        LD HL,0
        LD (BH_PTR),HL               ; no runtime internal pointer survives a call
        LD C,'m'
        JP B_EMIT
BH_FLAGS: DB 1,2,3,4,5,7,8,9
BH_ATTR: DB 0,0,0,0,0,0,0,0,0
BH_MODE: DB 0
BH_KIND: DB 0
BH_TYPE: DB 0
BH_PTR: DW 0
        END
