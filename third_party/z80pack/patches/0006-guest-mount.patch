 };*/
 
+#include "mount.inc"
+
 /* REPLACEMENT TABLE FOR BETTERCP/M */
 dskdef_t disks[16] = {
 	{ "drivea.dsk", &drivea,  77,    26, 128 },
@@ -461,6 +463,7 @@ out_func_t *const port_out[256] = {
 	[ 50] = nets1_out,
 	[ 51] = netd1_out,
