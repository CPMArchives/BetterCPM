 };
 
@@ -2146,6 +2149,10 @@ static void fdco_out(BYTE data)
 		status = 1;
 		return;
 	}
+	if (!mount_current(drive, path, sizeof(path))) {
+        status = data == 0 ? 5 : 6;
+        return;
+    }
 	fd = open(path, data == 0 ? O_RDONLY : O_RDWR);
 	if (fd < 0) {
 		status = data == 0 ? 5 : 6;
diff --git a/cpmtools/Makefile b/cpmtools/Makefile
