diff --git a/cpmtools/mount.asm b/cpmtools/mount.asm
new file mode 100644
index 00000000..9f0ebf36
--- /dev/null
+++ b/cpmtools/mount.asm
@@ -0,0 +1,62 @@
+        org 100h
+        lxi h,0
+        dad sp
+        shld savedsp
+        lxi sp,stacktop
+        mvi a,255
+        sta 1fffh
+        xra a
+        out 162
+        lda 1fffh
+        cpi 255
+        jz unsupported
+        cpi 2
+        jnz output
+        lxi d,warning
+        mvi c,9
+        call 5
+        mvi c,1
+        call 5
+        ani 0dfh
+        cpi 'Y'
+        jnz cancelled
+        mvi a,1
+        out 162
+output: lxi h,2000h
+next:   mov a,m
+        ora a
+        jz refresh
+        push h
+        mov e,a
+        mvi c,2
+        call 5
+        pop h
+        inx h
+        jmp next
+refresh:
+        lhld 1ffdh
+        mov a,h
+        ora l
+        jz finish
+        xchg
+        mvi c,37
+        call 5
+finish: lhld savedsp
+        sphl
+        ret
+cancelled:
+        lxi d,cancel
+        jmp message
+unsupported:
+        lxi d,missing
+message:mvi c,9
+        call 5
+        jmp finish
+warning:db '** WARNING: Changing A: while the system is running may cause',13,10
+        db 'disk errors or loss of unsaved data. Continue? [y/N] $'
+cancel: db 13,10,'Operation cancelled. No changes made.',13,10,'$'
+missing:db 'MOUNT requires a compatible cpmsim emulator.',13,10,'$'
+savedsp:dw 0
+        ds 128
+stacktop:
+        end
