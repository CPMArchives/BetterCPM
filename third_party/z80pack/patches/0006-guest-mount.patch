diff --git a/cpmsim/srcsim/mount.inc b/cpmsim/srcsim/mount.inc
new file mode 100644
index 00000000..45ebc086
--- /dev/null
+++ b/cpmsim/srcsim/mount.inc
@@ -0,0 +1,152 @@
+/* cpmsim-only MOUNT service. No guest OS changes or open-file tracking.
+ * OUT 162: 0=request, 1=confirmed request. Tail at 80h; result at 1fffh
+ * (0=done, 1=error, 2=confirm A:). NUL output at 2000h; reset mask at 1ffdh.
+ * Media overrides last for this emulator session, preserving launcher links.
+ */
+#include <stdio.h>
+#include <stdarg.h>
+#include <ctype.h>
+static char mount_path[16][4096];
+static unsigned char mount_override[16];
+static char mount_output[8192];
+static size_t mount_used;
+static void mount_say(const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    if (mount_used < sizeof mount_output - 1) {
+        int n = vsnprintf(mount_output + mount_used,
+                          sizeof mount_output - mount_used, fmt, ap);
+        if (n > 0) mount_used += (size_t)n < sizeof mount_output - mount_used ?
+            (size_t)n : sizeof mount_output - mount_used - 1;
+    }
+    va_end(ap);
+}
+static int mount_current(int d, char *path, size_t size)
+{
+    struct stat st;
+    const char *dir = diskdir != NULL ? diskd :
+        (stat("./disks", &st) == 0 && S_ISDIR(st.st_mode) ? "./disks" : DISKSDIR);
+    if (mount_override[d]) {
+        snprintf(path, size, "%s", mount_path[d]);
+        return path[0] != 0;
+    }
+    return snprintf(path, size, "%s/%s", dir, disks[d].fn) < (int)size;
+}
+static int mount_supported(int d)
+{
+    return d >= 0 && d < 16 && disks[d].fd;
+}
+static void mount_command(BYTE confirmed)
+{
+    char tail[128], *tokens[5], *p, *selector = NULL, *image = NULL;
+    char resolved[4096], other[4096];
+    unsigned mask = 0, changed = 0;
+    int count = 0, operation = 0, result = 1, i, d, fd;
+    struct stat st, old;
+    mount_used = 0; mount_output[0] = 0;
+    if (dma_read(0x80) > 127) goto syntax;
+    for (i = 0; i < dma_read(0x80); ++i) tail[i] = dma_read(0x81+i);
+    tail[i] = 0; p = tail;
+    while (*p) {
+        while (*p == ' ' || *p == '\t') ++p;
+        if (!*p) break;
+        if (count == 5) goto syntax;
+        if (*p == '"') {
+            tokens[count++] = ++p;
+            while (*p && *p != '"') ++p;
+            if (!*p) goto syntax;
+            *p++ = 0;
+            if (*p && *p != ' ' && *p != '\t') goto syntax;
+        } else {
+            tokens[count++] = p;
+            while (*p && *p != ' ' && *p != '\t') ++p;
+            if (*p) *p++ = 0;
+        }
+    }
+    for (i = 0; i < count; ++i) {
+        p = tokens[i];
+        int op = !strcasecmp(p,"/U") || !strcasecmp(p,"/UNMOUNT") ? 2 :
+                 !strcasecmp(p,"/L") || !strcasecmp(p,"/LIST") ? 1 :
+                 !strcasecmp(p,"/VER") ? 3 :
+                 !strcasecmp(p,"/H") || !strcasecmp(p,"/HELP") ? 4 : 0;
+        if (op) { if (operation) goto syntax; operation = op; }
+        else if (!selector) selector = p;
+        else if (!image) image = p;
+        else goto syntax;
+    }
+    if (operation >= 3) {
+        if (selector || image) goto syntax;
+        mount_say("MOUNT 1.0 (001-dev)\r\n");
+        if (operation == 4) mount_say("MOUNT X: \"host image path\"\r\nMOUNT /U|/UNMOUNT X:|[B,C,D]:\r\nMOUNT /L|/LIST [X:|[B,C,D]:]\r\nMOUNT /VER  /H  /HELP\r\nBare MOUNT lists all supported drives. Paths resolve from emulator working directory.\r\nChanging A: requires confirmation; it does not boot the replacement OS.\r\n");
+        result = 0; goto done;
+    }
+    if (selector) {
+        p = selector;
+        if (*p == '[') {
+            ++p;
+            for (;;) {
+                d = toupper((unsigned char)*p++) - 'A';
+                if (!mount_supported(d) || (mask & (1u << d))) goto syntax;
+                mask |= 1u << d;
+                if (*p != ',') break;
+                ++p;
+            }
+            if (*p++ != ']') goto syntax;
+        } else {
+            d = toupper((unsigned char)*p++) - 'A';
+            if (!mount_supported(d)) goto syntax;
+            mask = 1u << d;
+        }
+        if (*p++ != ':' || *p) goto syntax;
+    }
+    if (!operation) operation = image ? 5 : 1;
+    if (operation == 1) {
+        if (image) goto syntax;
+        for (d = 0; d < 16; ++d) if (mount_supported(d) && (!mask || (mask & (1u<<d)))) {
+            if (!mount_current(d, other, sizeof other) || !realpath(other, resolved) || stat(resolved,&st))
+                mount_say("%c: empty\r\n", 'A'+d);
+            else {
+                fd = open(resolved,O_RDWR);
+                mount_say("%c: %s  raw  %s\r\n", 'A'+d,resolved,fd < 0 ? "RO" : "RW");
+                if (fd >= 0) close(fd);
+            }
+        }
+        result = 0; goto done;
+    }
+    if (!mask || (operation == 2 && image)) goto syntax;
+    if (operation == 5) {
+        if ((mask & (mask-1)) || selector[0] == '[' || !image || !*image) goto syntax;
+        if (!realpath(image,resolved)) goto badimage;
+        fd = open(resolved,O_RDONLY);
+        if (fd < 0) goto badimage;
+        i = fstat(fd,&st); close(fd);
+        if (i || !S_ISREG(st.st_mode) || st.st_size <= 0) goto badimage;
+        for (d = 0; d < 16; ++d) if (mount_supported(d)) {
+            /* BetterCP/M selects raw track layout through the BIOS on access.
+             * The legacy table is not a file-size limit (nor a format oracle).
+             * In particular a 360K FDF image is valid on a legacy 256K slot.
+             */
+            if (!(mask & (1u<<d)) && mount_current(d,other,sizeof other) && !stat(other,&old) &&
+                       st.st_dev == old.st_dev && st.st_ino == old.st_ino) {
+                mount_say("Image already mounted at %c:.\r\n",'A'+d); goto done;
+            }
+        }
+    }
+    if ((mask & 1) && confirmed != 1) { result = 2; goto done; }
+    for (d = 0; d < 16; ++d) if (mask & (1u<<d)) {
+        mount_override[d] = 1;
+        snprintf(mount_path[d],sizeof mount_path[d],"%s",operation == 2 ? "" : resolved);
+        changed |= 1u<<d;
+        mount_say("%c: %s\r\n",'A'+d,operation == 2 ? "unmounted" : resolved);
+    }
+    result = 0; goto done;
+syntax:
+    mount_say("MOUNT: Invalid syntax or unsupported drive. Use /HELP.\r\n"); goto done;
+badimage:
+    mount_say("MOUNT: Cannot open a nonempty regular image. No changes made.\r\n");
+done:
+    dma_write(0x1fff,result);
+    dma_write(0x1ffd,changed & 255); dma_write(0x1ffe,changed >> 8);
+    for (i = 0; i <= (int)mount_used; ++i) dma_write(0x2000+i,mount_output[i]);
+}
