+        db '   Changing A: requires confirmation; no reboot is performed.',13,10
+        db '$'
 warning:db '** WARNING: Changing A: while the system is running may cause',13,10
         db 'disk errors or loss of unsaved data. Continue? [y/N] $'
 cancel: db 13,10,'Operation cancelled. No changes made.',13,10,'$'
