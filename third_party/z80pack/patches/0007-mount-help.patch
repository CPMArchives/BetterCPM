@@ -3,6 +3,7 @@
         dad sp
         shld savedsp
         lxi sp,stacktop
+        call query
         mvi a,255
         sta 1fffh
         xra a
@@ -52,6 +53,98 @@
 message:mvi c,9
         call 5
         jmp finish
