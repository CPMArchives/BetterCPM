@@ -2138,2 +2118,50 @@ static void fdco_out(BYTE data)
 
+/* Resolve removable media once per synchronous command. A link change
+ * during a command cannot redirect that command to another image.
+ * Guest software must still reset/re-log the disk after a media change.
+ */
+static void fdco_out(BYTE data)
+{
+	char path[MAX_LFN];
+	const char *directory;
+	struct stat sbuf;
+	int fd, length;
+
+	if (drive >= 16 || disks[drive].fd == NULL) {
+		status = 1;
+		return;
+	}
+	if (data > 1) {
+		status = 7;
+		return;
+	}
+	if (diskdir != NULL)
+		directory = diskd;
+	else if (stat("./disks", &sbuf) == 0 && S_ISDIR(sbuf.st_mode))
+		directory = "./disks";
+	else
+		directory = DISKSDIR;
+	length = snprintf(path, sizeof(path), "%s/%s", directory, disks[drive].fn);
+	if (length < 0 || (size_t) length >= sizeof(path)) {
+		status = 1;
+		return;
+	}
+	fd = open(path, data == 0 ? O_RDONLY : O_RDWR);
+	if (fd < 0) {
+		status = data == 0 ? 5 : 6;
+		return;
+	}
+	if (fstat(fd, &sbuf) < 0 || !S_ISREG(sbuf.st_mode)) {
+		close(fd);
+		status = data == 0 ? 5 : 6;
+		return;
+	}
+	/* No full-image size requirement: historical images may omit unused tails. */
+	*disks[drive].fd = fd;
+	fdco_transfer(data);
+	if (close(fd) < 0 && status == 0)
+		status = data == 0 ? 5 : 6;
+	*disks[drive].fd = -1;
+}
