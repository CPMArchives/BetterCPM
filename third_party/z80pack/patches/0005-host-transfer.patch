--- /dev/null
+++ b/tests/test_host_transfer.py
@@ -0,0 +1,70 @@
+"""Focused host-service regression checks; no guest disks are modified."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+source = (Path(__file__).resolve().parents[1] / 'iodevices/simbdos.c').read_text()
+source = '\n'.join(line for line in source.splitlines() if not line.startswith('#include "'))
+prelude = r'''
+#include <stdbool.h>
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+typedef unsigned char BYTE;
+typedef unsigned short WORD;
+static BYTE A,C,D,E,mem[65536];
+static BYTE dma_read(WORD a) { return mem[a]; }
+static void dma_write(WORD a, BYTE b) { mem[a]=b; }
+static int fail_read, fail_close;
+static size_t test_read(void *p,size_t s,size_t n,FILE *f) {
+ return fail_read ? 0 : fread(p,s,n,f);
+}
+static int test_error(FILE *f) { return fail_read || ferror(f); }
+static int test_close(FILE *f) { int r=fclose(f); return fail_close ? EOF : r; }
+#define fread test_read
+#define ferror test_error
+#define fclose test_close
+'''
+checks = r'''
+#undef fread
+#undef ferror
+#undef fclose
+static void command(int c) { C=c; D=2; E=0; host_bdos_out((BYTE)~C); }
+static void name(const char *s) { memset(mem+0x200,0,36); memcpy(mem+0x201,s,11); }
+int main(void) {
+ FILE *f; char b[256]; size_t n;
+ name("TEST    TXT"); command(MAKEF); assert(A==0);
+ memset(mem+0x80,'a',128); mem[0x83]=26; command(WRITEF); assert(A==0);
+ memset(mem+0x80,'b',128); command(WRITEF); assert(A==0);
+ command(CLOSEF); assert(A==0 && fp==NULL);
+ command(CLOSEF); assert(A==0);
+ command(WRITEF); assert(A==255);
+ f=fopen("TEST.TXT","rb"); n=fread(b,1,256,f); fclose(f);
+ assert(n==3 && memcmp(b,"aaa",3)==0);
+ command(MAKEF);
+#ifdef SIMBDOS_NO_OVERWRITE
+ assert(A==255 && fp==NULL);
+#else
+ assert(A==0); command(CLOSEF);
+#endif
+ name("DATA    BIN"); command(MAKEF); assert(A==0);
+ memset(mem+0x80,26,128); command(WRITEF); assert(A==0);
+ command(CLOSEF); assert(A==0);
+ f=fopen("DATA.BIN","rb"); assert(fread(b,1,256,f)==128); fclose(f);
+ f=fopen("SHORT.BIN","wb"); fputs("abc",f); fclose(f);
+ name("SHORT   BIN"); command(OPENF); assert(A==0);
+ command(READF); assert(A==0 && mem[0x80]=='a' && mem[0x83]==26);
+ command(READF); assert(A==1);
+ fail_read=1; command(READF); assert(A==255); fail_read=0;
+ fail_close=1; command(CLOSEF); assert(A==255 && fp==NULL); fail_close=0;
+ name("MISSING BIN"); command(OPENF); assert(A==255 && fp==NULL);
+ command(READF); assert(A==255);
+ puts("host transfer checks passed");
+}
+'''
+for protected in (False, True):
+    with tempfile.TemporaryDirectory() as tmp:
+        p = Path(tmp)
+        (p/'test.c').write_text(prelude+source+checks)
+        subprocess.run(['cc','-std=c99','-D_POSIX_C_SOURCE=200809L','-Wall','-Wextra','-Werror',*(['-DSIMBDOS_NO_OVERWRITE'] if protected else []),str(p/'test.c'),'-o',str(p/'test')],check=True)
+        subprocess.run([str(p/'test')],cwd=tmp,check=True)
