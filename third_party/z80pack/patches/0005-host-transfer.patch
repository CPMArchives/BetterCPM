+; Parse the bounded command tail, independent of the CCP's default FCBs.
+; Host names are flat 8.3 names; only the guest operand accepts DU:.
+vfyFcb lxi h,81h
+        lda 80h
+        cpi 128
+        jnc syntaxErr
+        mov b,a
+        lxi d,token1
+        call getToken
+        lda token1
+        ora a
+        jz qUsage
+        lxi d,token2
+        call getToken
+        lxi d,token3
+        call getToken
+        lda token3
+        ora a
+        jnz syntaxErr
+        lxi h,guestFcb
+        call initFcb
+        lxi h,inFcb
+        call initFcb
+        mvi e,255
+        mvi c,32
+        call BDOS
+        sta oldUser
+        sta targetUser
+        lxi h,token1
+        lxi d,inFcb
+        xra a
+        call spec
+        lxi h,token2
+        lxi d,guestFcb
+        mvi a,1
+        call spec
+
+        ; An empty destination name inherits the source's name and extension.
+        lda guestFcb+1
+        cpi ' '
+        jnz parsed
+        lxi h,inFcb+1
+        lxi d,guestFcb+1
+        mvi b,11
+inherit mov a,m
+        call upper
+        stax d
+        inx h
+        inx d
+        dcr b
+        jnz inherit
+parsed  mvi a,1
+        sta restoreUser
+        lda targetUser
+        mov e,a
+        mvi c,32
+        call BDOS
+        ret
+
+; HL/B input span; DE output ASCIIZ token. Preserve remaining input span.
+getToken mov a,b
+        ora a
+        jz tokenEnd
+        mov a,m
+        cpi ' '
+        jz tokenSpace
+        cpi 9
+        jnz tokenCopy
+tokenSpace inx h
+        dcr b
+        jmp getToken
+tokenCopy mov a,b
+        ora a
+        jz tokenEnd
+        mov a,m
+        cpi ' '
+        jz tokenEnd
+        cpi 9
+        jz tokenEnd
+        stax d
+        inx d
+        inx h
+        dcr b
+        jmp tokenCopy
+tokenEnd xra a
+        stax d
+        ret
+
+; Initialize a complete, private guestFcb.
+initFcb push h
+        mvi b,36
+        xra a
+clearFcb mov m,a
+        inx h
+        dcr b
+        jnz clearFcb
+        pop h
+        inx h
+        mvi b,11
+        mvi a,' '
+blankFcb mov m,a
+        inx h
+        dcr b
+        jnz blankFcb
+        ret
+
+; HL token, DE guestFcb, A=1 guest / 0 host. Empty token is allowed for destination.
+spec    sta guestFlag
+        xchg
+        shld parseFcb
+        xchg
+        mov a,m
+        ora a
+        rz
+        push h
+scanColon mov a,m
+        ora a
+        jz noPrefix
+        cpi ':'
+        jz prefix
+        inx h
+        jmp scanColon
+noPrefix pop h
+        jmp filename
+prefix  lda guestFlag
+        ora a
+        jz syntaxErr
+        pop h
+        mov a,m
+        call upper
+        sui 'A'
+        cpi 16
+        jnc syntaxErr
+        inr a
+        stax d
+        inx h
+        mov a,m
+        cpi ':'
+        jz afterColon
+        mvi c,0
+userDigits mov a,m
+        cpi '0'
+        jc syntaxErr
+        cpi '9'+1
+        jnc syntaxErr
+        sui '0'
+        mov b,a
+        mov a,c
+        add a
+        add a
+        add c
+        add a
+        add b
+        cpi 16
+        jnc syntaxErr
+        mov c,a
+        inx h
+        mov a,m
+        cpi ':'
+        jnz userDigits
+        mov a,c
+        sta targetUser
+afterColon inx h
+filename xchg
+        lhld parseFcb
+        inx h
+        xchg
+        mvi c,8
+        mvi b,0
+nameLoop mov a,m
+        ora a
+        jz nameEnd
+        cpi '.'
+        jz extension
+        call putChar
+        inx h
+        jmp nameLoop
+extension mov a,b
+        ora a
+        jz syntaxErr
+        inx h
+        push h
+        lhld parseFcb
+        lxi d,9
+        dad d
+        xchg
+        pop h
+        mvi c,3
+extLoop mov a,m
+        ora a
+        rz
+        call putChar
+        inx h
+        jmp extLoop
+nameEnd mov a,b
+        ora a
+        rnz
+        ; Only a destination may omit its filename; checked by the caller.
+        ret
+putChar push psw
+        lda guestFlag
+        ora a
+        jz hostChar
+        pop psw
+        call upper
+        jmp validateChar
+hostChar pop psw
+validateChar
+        ; Conservative CP/M filename characters; no paths, wildcards or options.
+        push psw
+        call upper
+        cpi 'A'
+        jc charDigit
+        cpi 'Z'+1
+        jc charOK
+charDigit cpi '0'
+        jc charSymbol
+        cpi '9'+1
+        jc charOK
+charSymbol push h
+        lxi h,allowed
+        mov b,a
+symbolLoop mov a,m
+        ora a
+        jz syntaxErr
+        cmp b
+        jz symbolOK
+        inx h
+        jmp symbolLoop
+symbolOK mov a,b
+        pop h
+charOK  pop psw
+        push psw
+        mov a,c
+        ora a
+        jz syntaxErr
+        pop psw
+        stax d
+        inx d
+        dcr c
+        mvi b,1
+        ret
