+closeOKC
 
 exitM1F	push	d		;save message pointer
 	lxi	d,inFcb		;DE->source file FCB
 	mvi	c,CLOSEF	;C=close file command
 	call	pcBdos		;close source file
 	pop	d		;DE->exit message
+	ora	a
+	jz	closeOKH
+	lxi	d,mCloseErr
