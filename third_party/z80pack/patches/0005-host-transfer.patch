-;-----------------------------------------------------------------------------
-;  String Constants
-;-----------------------------------------------------------------------------
-mHelp	db	CR,LF
- 	db	'R.COM v1.0 - Read file from host PC into CP/M',CR,LF
-	db	LF
- 	db	'Usage: R <filename>',CR,LF,'$'
+mHelp db CR,LF
+        db 'R 1.0 (003-dev)',CR,LF
+        db '  - - -',CR,LF
+        db ' | Host File Import',CR,LF
+        db ' |',CR,LF
+        db ' |   Usage: R hostfile [[DU:]destfile | DU:] [options]',CR,LF
+        db CR,LF
+        db '   Options:',CR,LF
+        db '     /H /HELP   Display this help.',CR,LF
+        db '     /VER       Display utility identification.',CR,LF
+        db CR,LF
+        db '   Host names preserve case in the emulator working directory.',CR,LF
+        db '   One file per command; wildcards are not supported.',CR,LF
+        db '   DU: means drive A-P and optional user 0-15 (e.g. B3:).',CR,LF
+        db '   Omitted destination name retains the source name.',CR,LF
+        db '   Default CP/M location is the current drive and user.',CR,LF
+        db '   Existing destination files are overwritten.',CR,LF
+        db '$'
+
+mVersion db CR,LF
+        db 'R 1.0 (003-dev)',CR,LF
+        db '  - - -',CR,LF
+        db ' | BetterCP/M Utilities',CR,LF
+        db ' | Host File Import',CR,LF
+        db '$'
 
 mNoWild	db	CR,LF,'Wildcards not supported',CR,LF,'$'
 
-mFile	db	CR,LF,'File '
-mFName	ds	16
+mSyntax db CR,LF,'Invalid syntax; use /HELP',CR,LF,'$'
 
 mNoFile	db	' not found',CR,LF,'$'
 mMakErr	db	' - cannot create file',CR,LF,'$'
 mWrtErr	db	' - write error, disk full?',CR,LF,'$'
+mReadErr db CR,LF,'Read error - transfer incomplete',CR,LF,'$'
+mCloseErr db CR,LF,'Close error - transfer incomplete',CR,LF,'$'
+
 mDone	db	' read from host, written to CP/M',CR,LF,'$'
 
 ;-----------------------------------------------------------------------------
 ;  Data Area
 ;-----------------------------------------------------------------------------
+guestFcb ds 36
 inFcb	dw	0,0,0,0,0,0,0,0,0	;36 byte FCB
 	dw	0,0,0,0,0,0,0,0,0
 	
+; Exact, case-insensitive query tokens; /VER takes precedence.
+; Queries are handled before opening either host or CP/M files.
+queries lxi d,qVer
+        call qFind
+        jnz qVersion
+        lxi d,qHelp
+        call qFind
+        jnz qUsage
+        lxi d,qShort
+        call qFind
+        jnz qUsage
+        ret
+qVersion lxi d,mVersion
+        jmp exitMsg
+qUsage  lxi d,mHelp
+        jmp exitMsg
+
+; DE -> zero-terminated query. Return A=1 if an exact token matches.
+qFind   xchg
+        shld qPointer
+        lxi h,81h
+        lda 80h
+        mov b,a
+qNext   mov a,b
+        ora a
+        jz qAbsent
+        mov a,m
+        cpi ' '
+        jz qSpace
+        cpi 9
+        jz qSpace
+        push h
+        push b
+        xchg
+        lhld qPointer
+        xchg
+qMatch  mov a,b
+        ora a
+        jz qAtEnd
+        ldax d
+        ora a
+        jz qBoundary
+        mov c,a
+        cpi '/'
+        mov a,m
+        jz qCompare
+        ani 0dfh
+qCompare cmp c
+        jnz qMiss
+        inx d
+        inx h
+        dcr b
+        jmp qMatch
+qAtEnd  ldax d
+        ora a
+        jz qFound
+        jmp qMiss
+qBoundary mov a,m
+        cpi ' '
+        jz qFound
+        cpi 9
+        jz qFound
+qMiss   pop b
+        pop h
+qSkip   mov a,b
+        ora a
+        jz qAbsent
+        mov a,m
+        cpi ' '
+        jz qSpace
+        cpi 9
+        jz qSpace
+        inx h
+        dcr b
+        jmp qSkip
+qSpace  inx h
+        dcr b
+        jmp qNext
+qFound  pop b
+        pop h
+        mvi a,1
+        ora a
+        ret
+qAbsent xra a
+        ret
+qPointer dw 0
+qVer    db '/VER',0
+qHelp   db '/HELP',0
+qShort  db '/H',0
+
+        ds 128
+stackTop
 	end
