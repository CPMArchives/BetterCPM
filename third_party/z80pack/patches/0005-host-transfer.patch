+        rc
+        cpi 'z'+1
+        rnc
+        sui 32
+        ret
+syntaxErr lxi d,mSyntax
+        jmp exitMsg
+allowed db '!#$%&()+-@^_`{}~',39,0
+parseFcb dw 0
+guestFlag db 0
+oldUser db 0
+targetUser db 0
+restoreUser db 0
+token1 ds 128
