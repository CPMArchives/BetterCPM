From 9bf3c8ac0ee3cf9bdc8748b0bec5bdc7670f79f9 Mon Sep 17 00:00:00 2001
From: Nathanael <nathanael@NathanaeldeMacBook-Air.local>
Date: Sun, 13 Sep 2026 14:02:47 +0800
Subject: [PATCH] WIP preserve BetterCPM raw FDF backend work

---
 cpmsim/srcsim/simio.c | 136 +++++++++++++++++++++++++++++++++---------
 cpmsim/srcsim/simio.h |   2 +-
 2 files changed, 110 insertions(+), 28 deletions(-)

diff --git a/cpmsim/srcsim/simio.c b/cpmsim/srcsim/simio.c
index d27a6990..2ec57db2 100644
--- a/cpmsim/srcsim/simio.c
+++ b/cpmsim/srcsim/simio.c
@@ -163,7 +163,7 @@ static const char *TAG = "IO";
  * Port 18 selects a geometry register.
  * Port 19 reads/writes that register for the currently selected drive.
  */
-#define FDC_GEOM_PORT_VERSION	1
+#define FDC_GEOM_PORT_VERSION	2
 
 #define FDC_GEOM_TRACKS_LO	0x00
 #define FDC_GEOM_TRACKS_HI	0x01
@@ -171,6 +171,13 @@ static const char *TAG = "IO";
 #define FDC_GEOM_SECTORS_HI	0x03
 #define FDC_GEOM_SECSIZE_LO	0x04
 #define FDC_GEOM_SECSIZE_HI	0x05
+#define FDC_GEOM_TRACKBYTES_LO	0x06
+#define FDC_GEOM_TRACKBYTES_HI	0x07
+#define FDC_GEOM_SECOFF_LO	0x08
+#define FDC_GEOM_SECOFF_HI	0x09
+#define FDC_GEOM_XFERSIZE_LO	0x0a
+#define FDC_GEOM_XFERSIZE_HI	0x0b
+#define FDC_GEOM_RAWMODE	0x0c
 #define FDC_GEOM_VERSION	0x7f
 
 #define FDC_MIN_SECTOR_SIZE	128
@@ -183,6 +190,10 @@ static unsigned int sector;	/* current sector (0..65535) */
 static BYTE status;		/* status of last I/O operation on FDC */
 
 static BYTE fdc_geom_reg;       /* selected disk geometry register - ADDED FOR BETTERCP/M */
+static unsigned int fdc_track_bytes[16];
+static unsigned int fdc_sector_offset[16];
+static unsigned int fdc_transfer_size[16];
+static BYTE fdc_raw_mode[16];
 
 static BYTE dmadl;		/* current DMA address destination low */
 static BYTE dmadh;		/* current DMA address destination high */
@@ -724,6 +735,7 @@ void reset_system(void)
 
 	/* reset hardware */
 	time_out(0);			/* stop timer */
+	memset(fdc_raw_mode, 0, sizeof(fdc_raw_mode));
 
 	for (i = 1; i < MAXSEG; i++) {	/* reset MMU */
 		if (memory[i] != NULL) {
@@ -1816,6 +1828,27 @@ static BYTE fdcv_in(void)
 	case FDC_GEOM_SECSIZE_HI:
 		return (BYTE) ((disks[drive].sector_size >> 8) & 0xff);
 
+	case FDC_GEOM_TRACKBYTES_LO:
+		return (BYTE) (fdc_track_bytes[drive] & 0xff);
+
+	case FDC_GEOM_TRACKBYTES_HI:
+		return (BYTE) ((fdc_track_bytes[drive] >> 8) & 0xff);
+
+	case FDC_GEOM_SECOFF_LO:
+		return (BYTE) (fdc_sector_offset[drive] & 0xff);
+
+	case FDC_GEOM_SECOFF_HI:
+		return (BYTE) ((fdc_sector_offset[drive] >> 8) & 0xff);
+
+	case FDC_GEOM_XFERSIZE_LO:
+		return (BYTE) (fdc_transfer_size[drive] & 0xff);
+
+	case FDC_GEOM_XFERSIZE_HI:
+		return (BYTE) ((fdc_transfer_size[drive] >> 8) & 0xff);
+
+	case FDC_GEOM_RAWMODE:
+		return fdc_raw_mode[drive];
+
 	case FDC_GEOM_VERSION:
 		return (BYTE) FDC_GEOM_PORT_VERSION;
 
@@ -1877,6 +1910,43 @@ static void fdcv_out(BYTE data)
 			disks[drive].sector_size = value;
 		break;
 
+	case FDC_GEOM_TRACKBYTES_LO:
+		fdc_track_bytes[drive] =
+		    (fdc_track_bytes[drive] & 0xff00U) | data;
+		break;
+
+	case FDC_GEOM_TRACKBYTES_HI:
+		fdc_track_bytes[drive] =
+		    (fdc_track_bytes[drive] & 0x00ffU) |
+		    ((unsigned int) data << 8);
+		break;
+
+	case FDC_GEOM_SECOFF_LO:
+		fdc_sector_offset[drive] =
+		    (fdc_sector_offset[drive] & 0xff00U) | data;
+		break;
+
+	case FDC_GEOM_SECOFF_HI:
+		fdc_sector_offset[drive] =
+		    (fdc_sector_offset[drive] & 0x00ffU) |
+		    ((unsigned int) data << 8);
+		break;
+
+	case FDC_GEOM_XFERSIZE_LO:
+		fdc_transfer_size[drive] =
+		    (fdc_transfer_size[drive] & 0xff00U) | data;
+		break;
+
+	case FDC_GEOM_XFERSIZE_HI:
+		fdc_transfer_size[drive] =
+		    (fdc_transfer_size[drive] & 0x00ffU) |
+		    ((unsigned int) data << 8);
+		break;
+
+	case FDC_GEOM_RAWMODE:
+		fdc_raw_mode[drive] = data ? 1 : 0;
+		break;
+
 	case FDC_GEOM_VERSION:
 		/* read only */
 		break;
@@ -1956,34 +2026,41 @@ static void fdco_out(BYTE data)
 		return;
 	}
 
-	sector_size = disks[drive].sector_size;
-
-	/*
-	 * This raw backend currently supports conventional power-of-two
-	 * physical sector sizes from 128 through 1024 bytes.
-	 */
-	if ((disks[drive].tracks == 0) ||
-	    (disks[drive].sectors == 0) ||
-	    ((sector_size != 128) &&
-	     (sector_size != 256) &&
-	     (sector_size != 512) &&
-	     (sector_size != 1024))) {
-		status = 9;
-		return;
+	if (fdc_raw_mode[drive]) {
+		sector_size = fdc_transfer_size[drive];
+		if ((fdc_track_bytes[drive] == 0) ||
+		    ((sector_size != 128) &&
+		     (sector_size != 256) &&
+		     (sector_size != 512) &&
+		     (sector_size != 1024)) ||
+		    (fdc_sector_offset[drive] + sector_size >
+		     fdc_track_bytes[drive])) {
+			status = 9;
+			return;
+		}
+	} else {
+		sector_size = disks[drive].sector_size;
+		if ((disks[drive].tracks == 0) ||
+		    (disks[drive].sectors == 0) ||
+		    ((sector_size != 128) &&
+		     (sector_size != 256) &&
+		     (sector_size != 512) &&
+		     (sector_size != 1024))) {
+			status = 9;
+			return;
+		}
 	}
 
-	/*
-	 * tracks is a count, so valid tracks are 0 through tracks - 1.
-	 */
-	if ((unsigned int) track >= disks[drive].tracks) {
+	/* Legacy mode retains stock cpmsim's geometry bounds.  Direct raw mode
+	 * uses the 8-bit track port as its complete linear-track address. */
+	if (!fdc_raw_mode[drive] &&
+	    ((unsigned int) track >= disks[drive].tracks)) {
 		status = 2;
 		return;
 	}
 
-	/*
-	 * Keep stock cpmsim's 1-based physical-sector interface.
-	 */
-        if ((sector == 0) || (sector > disks[drive].sectors)) {
+	if (!fdc_raw_mode[drive] &&
+	    ((sector == 0) || (sector > disks[drive].sectors))) {
 		status = 3;
 		return;
 	}
@@ -2011,10 +2088,15 @@ static void fdco_out(BYTE data)
 	 * BetterCP/M converts DISK.FDF side/order/skew semantics into
 	 * the linear track and physical-sector ordinal used here.
 	 */
-	pos =
-	    ((((off_t) track) * (off_t) disks[drive].sectors) +
-	     ((off_t) sector - 1)) *
-	    (off_t) sector_size;
+	if (fdc_raw_mode[drive]) {
+		pos = ((off_t) track * (off_t) fdc_track_bytes[drive]) +
+		    (off_t) fdc_sector_offset[drive];
+	} else {
+		pos =
+		    ((((off_t) track) * (off_t) disks[drive].sectors) +
+		     ((off_t) sector - 1)) *
+		    (off_t) sector_size;
+	}
 
 	if (lseek(*disks[drive].fd, pos, SEEK_SET) == (off_t) -1) {
 		status = 4;
diff --git a/cpmsim/srcsim/simio.h b/cpmsim/srcsim/simio.h
index 1c903b5a..bb09bae0 100644
--- a/cpmsim/srcsim/simio.h
+++ b/cpmsim/srcsim/simio.h
@@ -21,7 +21,7 @@ typedef struct dskdef {
 	int *fd;			/* file descriptor */
 	unsigned int tracks;		/* number of linear tracks */
 	unsigned int sectors;		/* physical sectors per track */
-	unsigned int sector_size;	/* bytes per physical sector */
+	unsigned int sector_size;	/* bytes per physical sector (legacy geometry mode) */
 } dskdef_t;
 
 extern dskdef_t disks[16];
-- 
2.54.0 (Apple Git-157)

