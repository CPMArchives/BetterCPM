; SPDX-License-Identifier: GPL-2.0-or-later
;
;***********************************************************************
;*                                                                     *
;*                  D I S K E D I T   --   DEV2                       *
;*                                                                     *
;*             READ-ONLY LOGICAL SECTOR BROWSER                       *
;*                                                                     *
;***********************************************************************
;
; Version 0.1.0-dev2, 31 August 2026
;
; Assemble with ZSM4 and Digital Research LINK:
;
;       ZSM4 DISKEDIT=DISKEDIT
;       LINK DISKEDIT[A]
;
; The optional drive may be written in the usual CP/M fashion:
;
;       DISKEDIT             browse the default drive
;       DISKEDIT B:          browse drive B
;
; DISKEDIT reads logical sectors through the standard BIOS but never writes
; one.  It begins at track zero and permits forward, backward and return-to-
; directory navigation before restoring the original drive on exit.
;
; Revision history:
;   dev1    read-only logical-sector display and keyboard navigation
;   dev2    allocation-block ownership from active directory entries
;
; Programmer's notebook:
;   This program deliberately uses only the 8080 instruction set although
;   ZSM4 notation is used.  It should consequently run on an 8080 CP/M as
;   well as on the Z80 machines for which it was first assembled.
;
;   SELDSK is the ninth entry following BOOT in the standard BIOS jump
;   table.  The WBOOT vector at 0001H points to BIOS+3, hence adding 24 to
;   its target produces the SELDSK entry address.  BIOSJMP is filled in once
;   at start-up; this is the customary CP/M method of making an indirect
;   subroutine call without relying on a Z80-only instruction.  The disk
;   access and number-printing routines began in DISKINFO dev3; keeping their
;   calling conventions alike is the first step toward a common library.
;
;***********************************************************************

	.z80                    ; Zilog spelling, 8080 opcodes only
	cseg

BDOS    EQU     0005H
;
; dev1 - patch page-zero warm boot vector address
;
;WBOOTV EQU     0002H          ; first cut began one byte too late
WBOOTV  EQU     0001H          ; operand of page-zero JMP at 0000H

; BDOS function numbers used here.
FPRINT  EQU     9
FSELDSK EQU     14
FCURDSK EQU     25
FGETALV EQU     27
FGETDPB EQU     31
OWNMAX  EQU     1024            ; dev2 ownership-map capacity

START:  LD      SP,STACKTOP     ; CCP stack contents are not an interface
        LD      C,FCURDSK
        CALL    BDOS
        LD      (OLDDRV),A
        LD      (NEWDRV),A
        CALL    GETARGS
        JP      C,BADDRV
        LD      A,(MODE)
        CP      5
        JP      Z,SHOWHELP
        CP      6
        JP      Z,SHOWINFO
        CP      7
        JP      Z,SHOWVER
        LD      A,(NEWDRV)
        LD      E,A
        LD      C,FSELDSK
        CALL    BDOS            ; log drive and make its DPB current

        LD      C,FGETDPB
        CALL    BDOS
        LD      (DPBPTR),HL
        LD      A,H
        OR      L
        JP      Z,NODRIVE

        CALL    GETDPH
        LD      (DPHPTR),HL
        LD      A,H
        OR      L
        JP      Z,NODRIVE
        CALL    SAVEDPH
        CALL    SAVEDPB
        CALL    CALCULATE
        CALL    SETBIOS
        CALL    BUILDOWN
        CALL    REPORT
        JP      EXIT

; Copy and fold each command-tail word, then classify it exactly.  A report
; selector and drive may appear in either order.  Abbreviations and repeated
; operands are rejected; old CCPs differed too much to trust their FCB here.
GETARGS:XOR     A
        LD      (MODE),A
        LD      (DRVSET),A
        LD      A,(0080H)
        LD      B,A
        LD      HL,0081H
GANEXT:LD      A,B
        OR      A
        JP      Z,GADONE
        LD      A,(HL)
        INC     HL
        DEC     B
        CP      ' '
        JP      Z,GANEXT
        LD      DE,ARGBUF
        LD      C,0
GACOPY:CP      'a'
        JP      C,GASTORE
        CP      'z'+1
        JP      NC,GASTORE
        SUB     20H
GASTORE:LD     (DE),A
        INC     DE
        INC     C
        LD      A,C
        CP      15
        JP      NC,GABAD
        LD      A,B
        OR      A
        JP      Z,GAWORD
        LD      A,(HL)
        CP      ' '
        JP      Z,GAWORD
        INC     HL
        DEC     B
        JP      GACOPY
GAWORD:XOR     A
        LD      (DE),A
        CALL    ARGWORD
        JP      C,GABAD
        JP      GANEXT
GADONE:LD      A,(MODE)        ; informational selectors stand alone
        CP      5
        JP      C,GAGOOD
        LD      A,(DRVSET)
        OR      A
        JP      NZ,GABAD
GAGOOD:OR      A
        RET
GABAD: SCF
        RET

ARGWORD:
        LD      A,(ARGBUF)
        CP      '/'
        JP      Z,GAOPTION
        LD      A,(DRVSET)
        OR      A
        JP      NZ,GABAD
        LD      A,(ARGBUF+1)
        CP      ':'
        JP      NZ,GABAD
        LD      A,(ARGBUF+2)
        OR      A
        JP      NZ,GABAD
        LD      A,(ARGBUF)
        CP      'A'
        JP      C,GABAD
        CP      'P'+1
        JP      NC,GABAD
        SUB     'A'
        LD      (NEWDRV),A
        LD      A,1
        LD      (DRVSET),A
        OR      A
        RET
GAOPTION:
        LD      A,(MODE)
        OR      A
        JP      NZ,GABAD
        LD      DE,SH
        CALL    ARGIS
        LD      A,5
        JP      Z,GASET
        LD      DE,SHELP
        CALL    ARGIS
        LD      A,5
        JP      Z,GASET
        LD      DE,SINFO
        CALL    ARGIS
        LD      A,6
        JP      Z,GASET
        LD      DE,SVER
        CALL    ARGIS
        LD      A,7
        JP      Z,GASET
        LD      DE,SVERSION
        CALL    ARGIS
        LD      A,7
        JP      NZ,GABAD
GASET: LD      (MODE),A
        OR      A
        RET

; Compare the copied argument with the zero-terminated selector at DE.
ARGIS: PUSH    HL
        PUSH    DE
        LD      HL,ARGBUF
GACMP: LD      A,(DE)
        CP      (HL)
        JP      NZ,GACMPNO
        OR      A
        JP      Z,GACMPYES
        INC     DE
        INC     HL
        JP      GACMP
GACMPNO:
        POP     DE
        POP     HL
        OR      1               ; return not equal
        RET
GACMPYES:
        POP     DE
        POP     HL
        XOR     A               ; return equal
        RET

; Construct and call the standard BIOS SELDSK entry.  E=0 requests an
; ordinary selection rather than the CP/M 3 first-select convention.
GETDPH:LD      HL,(WBOOTV)
        LD      DE,24
        ADD     HL,DE
        LD      (BIOSJMP+1),HL
        LD      A,(NEWDRV)
        LD      C,A
        LD      E,0
        CALL    BIOSJMP
        RET
BIOSJMP:
        JP      0000H           ; operand supplied by GETDPH

; Save the documented DPH words before another system call can disturb the
; three scratch words in the middle of the header.
SAVEDPH:
        LD      DE,DPHBUF
        LD      BC,16
SDLOOP:LD      A,(HL)
        LD      (DE),A
        INC     HL
        INC     DE
        DEC     BC
        LD      A,B
        OR      C
        JP      NZ,SDLOOP
        RET

; The CP/M 2.2 DPB is fifteen bytes long.  Keep a private copy so the report
; remains stable while BDOS is used for console output.
SAVEDPB:
        LD      HL,(DPBPTR)
        LD      DE,DPBBUF
        LD      BC,15
SPLOOP:LD      A,(HL)
        LD      (DE),A
        INC     HL
        INC     DE
        DEC     BC
        LD      A,B
        OR      C
        JP      NZ,SPLOOP
        RET

; Work out the values most often wanted at the console.  Sizes are retained
; in KiB; a normal CP/M 2.2 disk fits comfortably in sixteen bits.
CALCULATE:
        LD      A,(DPBBUF+2)    ; BSH: block bytes = 128 shl BSH
        CP      3
        JP      C,CALBAD
        SUB     3               ; KiB per block = 1 shl (BSH-3)
        LD      B,A
        LD      HL,1
CBKLP: LD      A,B
        OR      A
        JP      Z,CBKDONE
        ADD     HL,HL
        DEC     B
        JP      CBKLP
CBKDONE:
        LD      (BLKKB),HL

        LD      HL,(DPBBUF+5)   ; DSM is highest allocation block number
        INC     HL
        LD      (TOTBLK),HL
        CALL    MULBLK
        LD      (TOTKB),HL

        CALL    DIRCOUNT        ; directory reservation from AL0 and AL1
        LD      (DIRBLK),HL
        LD      A,(DPBBUF+2)    ; records reserved = blocks shl BSH
        LD      B,A
CDRLP: LD      A,B
        OR      A
        JP      Z,CDRDONE
        ADD     HL,HL
        DEC     B
        JP      CDRLP
CDRDONE:
        LD      (DIRRECS),HL
        LD      HL,(DIRBLK)
        CALL    MULBLK
        LD      (DIRKB),HL
;
; dev2 - patch subtract directory blocks, not directory K-bytes
;
;       EX      DE,HL           ; dev1 worked only with 1K blocks
        LD      HL,(DIRBLK)
        EX      DE,HL
        LD      HL,(TOTBLK)
        CALL    SUBDE
        LD      (DATBLK),HL

        LD      HL,(DPBBUF+7)   ; DRM is highest directory entry number
        INC     HL
        LD      (DIRENT),HL
        LD      DE,3
        ADD     HL,DE
        OR      A
        LD      A,H
        RRA
        LD      H,A
        LD      A,L
        RRA
        LD      L,A
        OR      A
        LD      A,H
        RRA
        LD      H,A
        LD      A,L
        RRA
        LD      L,A
        LD      (DIRECS),HL

        LD      A,(DPBBUF+4)    ; one directory extent holds EXM+1 extents
        INC     A
        LD      L,A
        LD      H,0
        LD      (EXTPER),HL
        ADD     HL,HL           ; multiply by 16 KiB
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        LD      (EXTKB),HL

        CALL    COUNTALV
        RET
CALBAD:LD      HL,0
        LD      (BLKKB),HL
        LD      (TOTKB),HL
        LD      (DIRKB),HL
        RET

; Multiply HL by the power-of-two allocation block size in KiB.
MULBLK:PUSH    BC
        LD      A,(DPBBUF+2)
        SUB     3
        LD      B,A
MBLOOP:LD      A,B
        OR      A
        JP      Z,MBDONE
        ADD     HL,HL
        DEC     B
        JP      MBLOOP
MBDONE:POP     BC
        RET

; Count the one bits in AL0/AL1.  CP/M records directory blocks from the
; high bit of AL0 toward the low bit of AL1.
DIRCOUNT:
        LD      DE,0
        LD      HL,DPBBUF+9
        LD      B,2
DCBYTE:LD      A,(HL)
        LD      C,8
DCBIT: RLCA
        JP      NC,DCNEXT
        INC     DE
DCNEXT:DEC     C
        JP      NZ,DCBIT
        INC     HL
        DEC     B
        JP      NZ,DCBYTE
        EX      DE,HL
        RET

; Count meaningful bits in the allocation vector.  Padding beyond DSM is
; ignored.  The returned totals include directory blocks, as BDOS does.
COUNTALV:
        LD      HL,(DPHBUF+14)
        LD      A,H
        OR      L
        JP      Z,ALVNONE
        LD      HL,(TOTBLK)
        EX      DE,HL
        LD      HL,(DPHBUF+14)
        LD      BC,0
        LD      A,80H
        LD      (BITMSK),A
ALVLOOP:
        LD      A,D
        OR      E
        JP      Z,ALVDONE
        LD      A,(BITMSK)
        LD      (BITTMP),A
        LD      A,(HL)
        PUSH    HL
        LD      HL,BITTMP
        AND     (HL)
        POP     HL
        JP      Z,ALVFREE
        INC     BC
ALVFREE:
        DEC     DE
        LD      A,(BITMSK)
        RRCA
        LD      (BITMSK),A
        CP      80H
        JP      NZ,ALVLOOP
        INC     HL
        JP      ALVLOOP
ALVDONE:
        PUSH    BC
        POP     HL
        LD      (USEDBLK),HL
        EX      DE,HL
        LD      HL,(TOTBLK)
        CALL    SUBDE
        LD      (FREEBLK),HL
        LD      A,1
        LD      (ALVOK),A
        RET
ALVNONE:
        XOR     A
        LD      (ALVOK),A
        RET

; Build a byte-per-block ownership map from active directory entries.  Zero
; means unclaimed, FFH means conflicting filenames, and 1..128 identifies
; the directory slot whose normalized user/name/type is stored in OWNERS.
; Any second allocation-list claim for a block is a conflict, including a
; repeated block within another extent of the same file.
BUILDOWN:
        XOR     A
        LD      (OWNOK),A
        LD      HL,(TOTBLK)
        LD      DE,OWNMAX+1
        CALL    CMPLT
        RET     NC              ; map is deliberately bounded in dev2
        LD      HL,OWNMAP
        LD      BC,OWNMAX
BOCLR: LD      (HL),0
        INC     HL
        DEC     BC
        LD      A,B
        OR      C
        JP      NZ,BOCLR
        LD      HL,(DPBBUF+13)
        LD      (CURTRK),HL
        LD      HL,0
        LD      (CURSEC),HL
        LD      HL,(DIRECS)
        LD      (DIRLEFT),HL
        LD      HL,OWNERS
        LD      (OWNPTR),HL
        XOR     A
        LD      (ENTNUM),A
BOREAD:LD      HL,(DIRLEFT)
        LD      A,H
        OR      L
        JP      Z,BODONE
        CALL    READCUR
        OR      A
        RET     NZ
        LD      HL,SECBUF
        LD      B,4
BOENT: PUSH    BC
        LD      (ENTPTR),HL
        PUSH    HL
        LD      HL,(OWNPTR)
        EX      DE,HL
        POP     HL
        LD      A,(HL)          ; normalized owner identity is 12 bytes
        LD      (DE),A
        INC     HL
        INC     DE
        LD      C,11
BOCOPY:LD      A,(HL)
        AND     7FH             ; ignore CP/M attribute bits in filetype
        LD      (DE),A
        INC     HL
        INC     DE
        DEC     C
        JP      NZ,BOCOPY
        LD      HL,(ENTPTR)
        LD      A,(HL)
        CP      16
        CALL    C,BOALLOC
        LD      HL,(OWNPTR)
        LD      DE,12
        ADD     HL,DE
        LD      (OWNPTR),HL
        LD      A,(ENTNUM)
        INC     A
        LD      (ENTNUM),A
        LD      HL,(ENTPTR)
        LD      DE,32
        ADD     HL,DE
        POP     BC
        DEC     B
        JP      NZ,BOENT
        LD      HL,(DIRLEFT)
        DEC     HL
        LD      (DIRLEFT),HL
        CALL    BONEXT
        JP      BOREAD
BODONE:LD      A,1
        LD      (OWNOK),A
        RET

; Step the directory scan by one logical record without wrapping past the
; selected format's SPT boundary.
BONEXT:LD      HL,(CURSEC)
        INC     HL
        EX      DE,HL
        LD      HL,(DPBBUF)
        LD      A,D
        CP      H
        JP      NZ,BONKEEP
        LD      A,E
        CP      L
        JP      C,BONKEEP
        LD      HL,(CURTRK)
        INC     HL
        LD      (CURTRK),HL
        LD      DE,0
BONKEEP:
        EX      DE,HL
        LD      (CURSEC),HL
        RET

; Examine the allocation list at ENTPTR.  Small disks have sixteen byte
; entries; disks with DSM above 255 have eight little-endian word entries.
BOALLOC:
        LD      DE,16
        ADD     HL,DE
        LD      A,(DPBBUF+6)
        OR      A
        JP      NZ,BOA16
        LD      B,16
BOA8:  LD      A,(HL)
        INC     HL
        OR      A
        JP      Z,BOA8N
        PUSH    HL
        LD      L,A
        LD      H,0
        CALL    BOCLAIM
        POP     HL
BOA8N: DEC     B
        JP      NZ,BOA8
        RET
BOA16: LD      B,8
BOA16L:LD      E,(HL)
        INC     HL
        LD      D,(HL)
        INC     HL
        LD      A,D
        OR      E
        JP      Z,BOA16N
        PUSH    HL
        EX      DE,HL
        CALL    BOCLAIM
        POP     HL
BOA16N:DEC     B
        JP      NZ,BOA16L
        RET

BOCLAIM:
        PUSH    HL
        LD      HL,(TOTBLK)
        EX      DE,HL
        POP     HL
        PUSH    HL
        CALL    CMPLT
        POP     HL
        RET     NC
        LD      DE,OWNMAP
        ADD     HL,DE
        LD      A,(HL)
        OR      A
        JP      Z,BOCNEW
        CP      0FFH
        RET     Z
        LD      (HL),0FFH
        RET
BOCNEW:LD      A,(ENTNUM)
        INC     A
        LD      (HL),A
        RET

; Sixteen-bit subtraction written as two 8080 byte operations.  A direct
; SBC HL,DE was used in the first desk calculation, but that instruction is
; Z80-only and DISKEDIT has no need to exclude an otherwise serviceable 8080.
; Entry: HL=minuend, DE=subtrahend.  Exit: HL=difference.
SUBDE:  LD      A,L
        SUB     E
        LD      L,A
        LD      A,H
        SBC     A,D
        LD      H,A
        RET

REPORT:LD      DE,TITLE
        CALL    PRINT
        LD      A,(NEWDRV)
        ADD     A,'A'
        CALL    PCHAR
        LD      DE,COLON
        CALL    PRINT
        CALL    SETBIOS
        LD      HL,0             ; a disk editor begins at the disk's start
        LD      (CURTRK),HL
        LD      HL,0
        LD      (CURSEC),HL
BROWSE:CALL    READCUR
        OR      A
        JP      NZ,BREADERR
        CALL    SHOWHEAD
        CALL    DUMPBUF
        LD      DE,PROMPT
        CALL    PRINT
        LD      C,1
        CALL    BDOS
        CP      'a'
        JP      C,BCMD
        CP      'z'+1
        JP      NC,BCMD
        AND     5FH
BCMD:  PUSH    AF
        CALL    PCRLF
        POP     AF
        CP      'Q'
        RET     Z
        CP      'N'
        JP      Z,BNEXT
        CP      'P'
        JP      Z,BPREV
        CP      'D'
        JP      Z,BDIR
        CP      'S'
        JP      Z,BSYSTEM
        CP      'T'
        JP      Z,BDATA
        LD      DE,BADCMD
        CALL    PRINT
        JP      BROWSE
BNEXT: LD      HL,(CURSEC)
        INC     HL
        EX      DE,HL
        LD      HL,(DPBBUF)
        LD      A,D
        CP      H
        JP      NZ,BNKEEP
        LD      A,E
        CP      L
        JP      C,BNKEEP
        LD      HL,(CURTRK)
        INC     HL
        LD      (CURTRK),HL
        LD      DE,0
BNKEEP:EX      DE,HL
        LD      (CURSEC),HL
        JP      BROWSE
BPREV: LD      HL,(CURSEC)
        LD      A,H
        OR      L
        JP      NZ,BPDEC
        LD      HL,(CURTRK)
        LD      A,H
        OR      L
        JP      Z,BROWSE
        DEC     HL
        LD      (CURTRK),HL
        LD      HL,(DPBBUF)
        DEC     HL
        LD      (CURSEC),HL
        JP      BROWSE
BPDEC:  DEC     HL
        LD      (CURSEC),HL
        JP      BROWSE
BDIR:   LD      HL,(DPBBUF+13)
        LD      (CURTRK),HL
        LD      HL,0
        LD      (CURSEC),HL
        JP      BROWSE
BSYSTEM:
        LD      HL,(DPBBUF+13)
        LD      A,H
        OR      L
        JP      Z,BNOSYS
        LD      HL,0
        LD      (CURTRK),HL
        LD      (CURSEC),HL
        JP      BROWSE
BNOSYS: LD      DE,NOSYS
        CALL    PRINT
        JP      BROWSE
; The first data record follows every block reserved by AL0/AL1.  Convert
; that record displacement into a track and logical-sector pair.
BDATA:  LD      HL,(DPBBUF+13)
        LD      (CURTRK),HL
        LD      HL,(DIRRECS)
BTLOOP:PUSH    HL
        LD      HL,(DPBBUF)
        EX      DE,HL
        POP     HL
        CALL    CMPLT
        JP      C,BTDONE
        CALL    SUBDE
        PUSH    HL
        LD      HL,(CURTRK)
        INC     HL
        LD      (CURTRK),HL
        POP     HL
        JP      BTLOOP
BTDONE:LD      (CURSEC),HL
        JP      BROWSE
BREADERR:
        LD      DE,READERR
        JP      PRINT

SETBIOS:LD     HL,(WBOOTV)
        LD      DE,27
        ADD     HL,DE
        LD      (JTRK+1),HL
        LD      HL,(WBOOTV)
        LD      DE,30
        ADD     HL,DE
        LD      (JSEC+1),HL
        LD      HL,(WBOOTV)
        LD      DE,33
        ADD     HL,DE
        LD      (JDMA+1),HL
        LD      HL,(WBOOTV)
        LD      DE,36
        ADD     HL,DE
        LD      (JREAD+1),HL
        LD      HL,(WBOOTV)
        LD      DE,45
        ADD     HL,DE
        LD      (JXLT+1),HL
        RET
JTRK:  JP      0000H
JSEC:  JP      0000H
JDMA:  JP      0000H
JREAD: JP      0000H
JXLT:  JP      0000H

READCUR:LD     HL,(CURTRK)
        LD      B,H
        LD      C,L
        CALL    JTRK
        LD      HL,(CURSEC)
        LD      B,H
        LD      C,L
        LD      HL,(DPHBUF)
        EX      DE,HL
        CALL    JXLT
        LD      (PHYSEC),HL
        LD      B,H
        LD      C,L
        CALL    JSEC
        LD      BC,SECBUF
        CALL    JDMA
        CALL    JREAD
        RET

SHOWHEAD:
        LD      DE,HTRACK
        CALL    PRINT
        LD      HL,(CURTRK)
        CALL    PDEC16
        LD      DE,HLOGSEC
        CALL    PRINT
        LD      HL,(CURSEC)
        CALL    PDEC16
        LD      DE,HPHYSEC
        CALL    PRINT
        LD      HL,(PHYSEC)
        CALL    PDEC16
        LD      DE,HREGION
        CALL    PRINT
        LD      HL,(DPBBUF+13)
        EX      DE,HL
        LD      HL,(CURTRK)
        CALL    CMPLT
        LD      DE,RRES
        JP      C,SHREG
        LD      HL,(DPBBUF+13)
        EX      DE,HL
        LD      HL,(CURTRK)
        CALL    SUBDE
        LD      B,H
        LD      C,L
        LD      HL,(DPBBUF)
        EX      DE,HL
        LD      HL,0
SHMUL: LD      A,B
        OR      C
        JP      Z,SHMULD
        ADD     HL,DE
        DEC     BC
        JP      SHMUL
SHMULD:EX      DE,HL
        LD      HL,(CURSEC)
        ADD     HL,DE
        LD      (TMPBLK),HL
        LD      HL,(DIRRECS)
        EX      DE,HL
        LD      HL,(TMPBLK)
        CALL    CMPLT
        LD      DE,RDIR
        JP      C,SHREG
        LD      DE,RDATA
        CALL    PRINT
        LD      HL,(TMPBLK)
        LD      A,(DPBBUF+2)
        LD      B,A
SHDIV: LD      A,B
        OR      A
        JP      Z,SHDIVD
        OR      A
        LD      A,H
        RRA
        LD      H,A
        LD      A,L
        RRA
        LD      L,A
        DEC     B
        JP      SHDIV
SHDIVD:LD      (CURBLOCK),HL
        LD      DE,HBLK
        CALL    PRINT
        LD      HL,(CURBLOCK)
        CALL    PDEC16
        LD      DE,HOWN
        CALL    PRINT
        CALL    SHOWOWN
        JP      PCRLF
SHREG:  JP      PRINT

SHOWOWN:
        LD      A,(OWNOK)
        OR      A
        LD      DE,OUNKNOWN
        JP      Z,PRINT
        LD      HL,(CURBLOCK)
        LD      DE,OWNMAP
        ADD     HL,DE
        LD      A,(HL)
        OR      A
        LD      DE,OFREE
        JP      Z,PRINT
        CP      0FFH
        LD      DE,OCONFLICT
        JP      Z,PRINT
        DEC     A
        LD      L,A
        LD      H,0
        ADD     HL,HL
        ADD     HL,HL
        PUSH    HL
        ADD     HL,HL
        POP     DE
        ADD     HL,DE
        LD      DE,OWNERS
        ADD     HL,DE
        LD      A,(HL)
        INC     HL
        PUSH    HL
        LD      L,A
        LD      H,0
        CALL    PDEC16
        LD      A,':'
        CALL    PCHAR
        POP     HL
        LD      B,8
SOBASE:LD      A,(HL)
        CP      ' '
        CALL    NZ,POCHAR
        INC     HL
        DEC     B
        JP      NZ,SOBASE
        PUSH    HL
        LD      B,3
SOEXCK:LD      A,(HL)
        CP      ' '
        JP      NZ,SOEXYES
        INC     HL
        DEC     B
        JP      NZ,SOEXCK
        POP     HL
        RET
SOEXYES:
        POP     HL
        LD      A,'.'
        CALL    POCHAR
        LD      B,3
SOEXT: LD      A,(HL)
        CP      ' '
        CALL    NZ,POCHAR
        INC     HL
        DEC     B
        JP      NZ,SOEXT
        RET
POCHAR:PUSH    HL
        CALL    PCHAR
        POP     HL
        RET

; Eight rows of sixteen bytes fit an ordinary 80-column console.
DUMPBUF:LD     HL,SECBUF
        LD      DE,0
        LD      (CURADDR),DE
        LD      B,8
DBROW: PUSH    BC
        PUSH    HL
        LD      HL,(CURADDR)
        CALL    PHEX16
        LD      A,':'
        CALL    PCHAR
        LD      A,' '
        CALL    PCHAR
        POP     HL
        LD      (LINEPTR),HL
        LD      C,16
DBHEX: LD      A,(HL)
        PUSH    HL
        CALL    PHEX8
        LD      A,' '
        CALL    PCHAR
        POP     HL
        INC     HL
        DEC     C
        JP      NZ,DBHEX
        LD      A,' '
        CALL    PCHAR
        LD      HL,(LINEPTR)
        LD      C,16
DBASC: LD      A,(HL)
        CP      32
        JP      C,DBDOT
        CP      127
        JP      C,DBOUT
DBDOT: LD      A,'.'
DBOUT: PUSH    HL
        CALL    PCHAR
        POP     HL
        INC     HL
        DEC     C
        JP      NZ,DBASC
        CALL    PCRLF
        LD      HL,(LINEPTR)
        LD      DE,16
        ADD     HL,DE
        PUSH    HL
        LD      HL,(CURADDR)
        ADD     HL,DE
        LD      (CURADDR),HL
        POP     HL
        POP     BC
        DEC     B
        JP      NZ,DBROW
        RET

CMPLT: LD      A,H
        CP      D
        RET     C
        RET     NZ
        LD      A,L
        CP      E
        RET

; Print labelled numeric fields.  Word fields are shown in hex and decimal;
; byte fields use two hex digits and an unsigned decimal value.
;
; dev1 - patch preserve the word while function 9 prints its label
;
;PWORD: CALL    PRINT           ; first cut trusted BDOS to preserve HL
PWORD:  PUSH    HL
        CALL    PRINT
        POP     HL
        PUSH    HL
        CALL    PHEX16
        LD      DE,HEXEQL
        CALL    PRINT
        POP     HL
        CALL    PDEC16
        JP      PNUMEND
PBYTE:  PUSH    AF
        CALL    PRINT
        POP     AF
        PUSH    AF
        CALL    PHEX8
        LD      DE,HEXEQL
        CALL    PRINT
        POP     AF
        LD      L,A
        LD      H,0
        CALL    PDEC16
        JP      PNUMEND
PDECVAL:
        PUSH    HL
        CALL    PRINT
        POP     HL
        CALL    PDEC16
        JP      PCRLF

; A null pointer is printed as NONE, otherwise merely terminate the line.
PNONE:  LD      A,H
        OR      L
        JP      NZ,PCRLF
        LD      DE,NONE
        JP      PRINT

PRINT:  LD      C,FPRINT
        JP      BDOS
PCHAR:  PUSH    BC
        PUSH    DE
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     DE
        POP     BC
        RET
PCRLF: LD      DE,CRLF
        JP      PRINT
PNUMEND:
        LD      DE,NUMEND
        JP      PRINT

PHEX16:PUSH    HL
        LD      A,H
        CALL    PHEX8
        POP     HL
        PUSH    HL
        LD      A,L
        CALL    PHEX8
        POP     HL
        RET
PHEX8:  PUSH    AF
        RRCA
        RRCA
        RRCA
        RRCA
        AND     0FH
        CALL    PHNIB
        POP     AF
        AND     0FH
        CALL    PHNIB
        RET
PHNIB: ADD     A,'0'
        CP      '9'+1
        JP      C,PCHAR
        ADD     A,7
        JP      PCHAR

; Decimal conversion by decimal places.  At most nine subtractions are made
; for each digit, which was found quicker on a small 4 MHz machine than the
; general divide routine used in an early notebook version.
PDEC16:XOR     A
        LD      (DIGSEEN),A
        LD      BC,10000
        CALL    PDIGIT
        LD      BC,1000
        CALL    PDIGIT
        LD      BC,100
        CALL    PDIGIT
        LD      BC,10
        CALL    PDIGIT
        LD      A,L
        ADD     A,'0'
        JP      PCHAR
PDIGIT:LD      D,'0'
PDLOOP:LD      A,L
        SUB     C
        LD      L,A
        LD      A,H
        SBC     A,B
        LD      H,A
        JP      C,PDDONE
        INC     D
        JP      PDLOOP
PDDONE:ADD     HL,BC
        LD      A,D
        CP      '0'
        JP      NZ,PDOUT
        LD      A,(DIGSEEN)
        OR      A
        RET     Z
        LD      A,D
PDOUT:  PUSH    HL
        CALL    PCHAR
        POP     HL
        LD      A,1
        LD      (DIGSEEN),A
        RET

SHOWHELP:
        LD      DE,HELPMSG
        CALL    PRINT
        JP      EXIT
SHOWINFO:
        LD      DE,INFOMSG
        CALL    PRINT
        JP      EXIT
SHOWVER:
        LD      DE,VERMSG
        CALL    PRINT
        JP      EXIT
BADDRV:LD      DE,BADMSG
        CALL    PRINT
        JP      EXIT
NODRIVE:
        LD      DE,NODMSG
        CALL    PRINT
EXIT:   LD      A,(OLDDRV)
        LD      E,A
        LD      C,FSELDSK
        CALL    BDOS
        JP      0000H

TITLE:  DB      13,10,'DISKEDIT 0.1.0-dev2  Drive $'
COLON:  DB      ':',13,10,'$'
HEXEQL: DB      'H  ($'
NUMEND: DB      ')',13,10,'$'
CRLF:   DB      13,10,'$'
NONE:   DB      '  NONE',13,10,'$'
HTRACK: DB      13,10,'Trk $'
HLOGSEC:DB      '  Log $'
HPHYSEC:DB      '  Xlt $'
HREGION:DB      '  Reg $'
HBLK:   DB      '  Blk $'
HOWN:   DB      '  Own $'
RRES:   DB      'SYSTEM',13,10,'$'
RDIR:   DB      'DIRECTORY',13,10,'$'
RDATA:  DB      'DATA$'
OFREE:  DB      'FREE$'
OCONFLICT:DB   'CONFLICT$'
OUNKNOWN:DB    'UNKNOWN$'
PROMPT: DB      13,10,'N-next  P-previous  S-system  D-directory  T-data  Q-quit: $'
BADCMD: DB      'Use N, P, S, D, T or Q.',13,10,'$'
NOSYS:  DB      'No SYSTEM area on this disk.',13,10,'$'
READERR:DB      'DISKEDIT: BIOS sector read failed',13,10,'$'
HELPMSG:DB      13,10,'DISKEDIT 0.1.0-dev2',13,10,13,10
        DB      '  DISKEDIT [drive:]           Browse logical sectors',13,10
        DB      '  DISKEDIT /H                   Command help (also /HELP)',13,10
        DB      '  DISKEDIT /INFO                Show build information',13,10
        DB      '  DISKEDIT /VER                 Show version (also /VERSION)',13,10,'$'
INFOMSG:DB      13,10,'DISKEDIT 0.1.0-dev2',13,10
        DB      'Read-only CP/M 2.2 filesystem-aware sector browser.',13,10
        DB      'Built with ZSM4 and Digital Research LINK.',13,10
        DB      '8080-compatible code; source revision 31 August 2026.',13,10,'$'
VERMSG:DB      13,10,'DISKEDIT 0.1.0-dev2',13,10,'$'
BADMSG: DB      13,10,'DISKEDIT: unknown option. Use DISKEDIT /HELP.',13,10,'$'
NODMSG: DB      13,10,'DISKEDIT: selected drive is not available',13,10,'$'

SH:     DB      '/H',0
SHELP:  DB      '/HELP',0
SINFO:  DB      '/INFO',0
SVER:   DB      '/VER',0
SVERSION:DB    '/VERSION',0

OLDDRV: DB      0
NEWDRV: DB      0
MODE:   DB      0
DRVSET: DB      0
ARGBUF: DS      16
DPHPTR: DW      0
DPBPTR: DW      0
DPHBUF: DS      16
DPBBUF: DS      15
BLKKB:  DW      0
TOTBLK: DW      0
TOTKB:  DW      0
DIRBLK: DW      0
DIRKB:  DW      0
DATBLK: DW      0
DIRENT: DW      0
EXTPER: DW      0
EXTKB:  DW      0
USEDBLK:DW      0
FREEBLK:DW      0
ALVOK:  DB      0
BITMSK: DB      0
BITTMP: DB      0
DIGSEEN:DB      0
CURTRK: DW      0
CURSEC: DW      0
PHYSEC: DW      0
DIRECS: DW      0
DIRRECS:DW      0
TMPBLK: DW      0
LINEPTR:DW      0
CURADDR:DW      0
OWNOK:  DB      0
ENTNUM: DB      0
DIRLEFT:DW      0
OWNPTR: DW      0
ENTPTR: DW      0
CURBLOCK:DW     0
OWNMAP: DS      OWNMAX
OWNERS: DS      1536            ; 128 normalized user/name/type identities
SECBUF: DS      128
        DS      128
STACKTOP:
        END
