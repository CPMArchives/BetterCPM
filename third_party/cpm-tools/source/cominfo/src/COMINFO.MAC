; SPDX-License-Identifier: GPL-2.0-or-later
;
;***********************************************************************
;*                                                                     *
;*                    C O M I N F O   --   DEV2                       *
;*                                                                     *
;*              CP/M TRANSIENT PROGRAM INSPECTOR                      *
;*                                                                     *
;***********************************************************************
;
; Version 0.1.0-dev2, 31 August 2026
;
;       ZSM4 COMINFO=COMINFO
;       LINK COMINFO[A]
;
; Usage:
;
;       COMINFO file.COM
;       COMINFO file.COM /V
;
; COMINFO reads a file sequentially through BDOS.  Dev2 reports its CP/M
; logical length, 0100H load range, direct CALL 0005H and JMP 0000H
; references, other direct references into page zero, Z80 prefix bytes, and
; immediate BDOS function-selection idioms with common DE arguments.
; Prefix-byte results are explicitly heuristic: a static byte scan cannot
; prove that an apparent opcode is executable rather than data.
;
; Revision history:
;   dev1    logical size, load range and conservative reference scan
;   dev2    immediate BDOS function and common DE argument recognition
;
; Programmer's notebook:
;   CP/M 2.2 records file length in 128-byte records, not bytes.  The byte
;   count printed here is consequently the exact logical CP/M length and may
;   include a final record's application padding.  Files too large to fit at
;   0100H are reported rather than silently wrapping the address calculation.
;
;   dev1 - patch keep bytes from the preceding DMA record
;   The first scanner discarded a three-byte instruction when it crossed a
;   128-byte boundary.  The rolling PREV history makes the stream continuous.
;
;***********************************************************************

	.z80                    ; Zilog spelling, 8080 opcodes only
	cseg

BDOS    EQU     0005H
FCB     EQU     005CH
FPRINT  EQU     9
FOPEN   EQU     15
FCLOSE  EQU     16
FREAD   EQU     20
FSETDMA EQU     26

START:  LD      SP,STACKTOP
        CALL    GETARGS
        JP      C,BADARGS
        LD      A,(MODE)
        CP      5
        JP      Z,SHOWHELP
        CP      6
        JP      Z,SHOWINFO
        CP      7
        JP      Z,SHOWVER
        LD      A,(FILESEEN)
        OR      A
        JP      Z,NOFILE
        CALL    OPENFILE
        JP      C,OPENERR
        CALL    SCANFILE
        CALL    CLOSEFILE
        CALL    REPORT
        JP      0000H

; Parse command-tail words exactly.  The CCP prepares the default FCB from
; the first non-option operand; retaining it avoids making assumptions about
; old CCP filename parsing beyond the documented interface.
GETARGS:XOR     A
        LD      (MODE),A
        LD      (FILESEEN),A
        LD      A,(0080H)
        LD      B,A
        LD      HL,0081H
GANEXT:LD      A,B
        OR      A
        JP      Z,GADONE
        LD      A,(HL)
        INC     HL
        DEC     B
        CP      ' '
        JP      Z,GANEXT
        LD      DE,TOKBUF
        LD      C,0
GACOPY:CP      'a'
        JP      C,GASTORE
        CP      'z'+1
        JP      NC,GASTORE
        SUB     20H
GASTORE:LD     (DE),A
        INC     DE
        INC     C
        LD      A,C
        CP      19
        JP      NC,GABAD
        LD      A,B
        OR      A
        JP      Z,GAWORD
        LD      A,(HL)
        CP      ' '
        JP      Z,GAWORD
        INC     HL
        DEC     B
        JP      GACOPY
GAWORD:XOR     A
        LD      (DE),A
        CALL    ARGWORD
        JP      C,GABAD
        JP      GANEXT
GADONE:LD      A,(MODE)
        CP      5
        JP      C,GAGOOD
        LD      A,(FILESEEN)
        OR      A
        JP      NZ,GABAD
GAGOOD:OR      A
        RET
GABAD: SCF
        RET

ARGWORD:
        LD      A,(TOKBUF)
        CP      '/'
        JP      Z,GAOPTION
        LD      A,(FILESEEN)
        OR      A
        JP      NZ,GABAD
        LD      A,1
        LD      (FILESEEN),A
        OR      A
        RET
GAOPTION:
        LD      A,(MODE)
        OR      A
        JP      NZ,GABAD
        LD      DE,SV
        CALL    ARGIS
        LD      A,1
        JP      Z,GASET
        LD      DE,SVERBOSE
        CALL    ARGIS
        LD      A,1
        JP      Z,GASET
        LD      DE,SH
        CALL    ARGIS
        LD      A,5
        JP      Z,GASET
        LD      DE,SHELP
        CALL    ARGIS
        LD      A,5
        JP      Z,GASET
        LD      DE,SINFO
        CALL    ARGIS
        LD      A,6
        JP      Z,GASET
        LD      DE,SVER
        CALL    ARGIS
        LD      A,7
        JP      Z,GASET
        LD      DE,SVERSION
        CALL    ARGIS
        LD      A,7
        JP      NZ,GABAD
GASET: LD      (MODE),A
        OR      A
        RET

ARGIS: LD      HL,TOKBUF
ARGIL: LD      A,(DE)
        CP      (HL)
        RET     NZ
        OR      A
        RET     Z
        INC     DE
        INC     HL
        JP      ARGIL

OPENFILE:
        LD      DE,FCB
        LD      C,FOPEN
        CALL    BDOS
        INC     A
        JP      Z,OFERR
        OR      A
        RET
OFERR: SCF
        RET
CLOSEFILE:
        LD      DE,FCB
        LD      C,FCLOSE
        CALL    BDOS
        RET

SCANFILE:
        LD      HL,0
        LD      (RECORDS),HL
        LD      (BYTEOFF),HL
        LD      (CBDOS),HL
        LD      (CWBOOT),HL
        LD      (CPAGE0),HL
        LD      (CZ80),HL
        LD      (CBFUNC),HL
        LD      (CBUNK),HL
        XOR     A
        LD      (WINCOUNT),A
        LD      HL,FCOUNTS
        LD      B,41
SFFCLR:LD      (HL),0
        INC     HL
        DEC     B
        JP      NZ,SFFCLR
        XOR     A
        LD      (PREV1),A
        LD      (PREV2),A
        LD      (PREV3),A
        LD      (PREV4),A
        LD      (PREV5),A
        LD      (PREV6),A
        LD      (PREV7),A
        LD      DE,DMABUF
        LD      C,FSETDMA
        CALL    BDOS
SFREAD:LD      DE,FCB
        LD      C,FREAD
        CALL    BDOS
        OR      A
        JP      NZ,SFDONE
        LD      HL,(RECORDS)
        INC     HL
        LD      (RECORDS),HL
        LD      HL,DMABUF
        LD      B,128
SFBYTE:LD      A,(HL)
        PUSH    HL
        PUSH    BC
        CALL    SCANBYTE
        POP     BC
        POP     HL
        INC     HL
        DEC     B
        JP      NZ,SFBYTE
        JP      SFREAD
SFDONE:RET

SCANBYTE:
        LD      (CURBYTE),A
        CP      0CBH
        JP      Z,SBZ80
        CP      0DDH
        JP      Z,SBZ80
        CP      0EDH
        JP      Z,SBZ80
        CP      0FDH
        JP      NZ,SBNPFX
SBZ80: LD      HL,(CZ80)
        INC     HL
        LD      (CZ80),HL
        LD      A,(MODE)
        CP      1
        CALL    Z,VZ80
SBNPFX:LD      A,(WINCOUNT)
        CP      2
        JP      NC,SBWINDOW
        INC     A
        LD      (WINCOUNT),A
        JP      SBSHIFT
SBWINDOW:
        CALL    CHECKWIN
SBSHIFT:
        LD      A,(PREV6)
        LD      (PREV7),A
        LD      A,(PREV5)
        LD      (PREV6),A
        LD      A,(PREV4)
        LD      (PREV5),A
        LD      A,(PREV3)
        LD      (PREV4),A
        LD      A,(PREV2)
        LD      (PREV3),A
        LD      A,(PREV1)
        LD      (PREV2),A
        LD      A,(CURBYTE)
        LD      (PREV1),A
SBOFF: LD      HL,(BYTEOFF)
        INC     HL
        LD      (BYTEOFF),HL
        RET

CHECKWIN:
        LD      A,(PREV2)
        CP      0CDH
        JP      NZ,CWWARM
        LD      A,(PREV1)
        CP      05H
        JP      NZ,CWPAGE
        LD      A,(CURBYTE)
        OR      A
        JP      NZ,CWPAGE
        LD      HL,(CBDOS)
        INC     HL
        LD      (CBDOS),HL
        CALL    ANALYZEBDOS
        RET
CWWARM:LD      A,(PREV2)
        CP      0C3H
        JP      NZ,CWPAGE
        LD      A,(PREV1)
        OR      A
        JP      NZ,CWPAGE
        LD      A,(CURBYTE)
        OR      A
        JP      NZ,CWPAGE
        LD      HL,(CWBOOT)
        INC     HL
        LD      (CWBOOT),HL
        LD      DE,VWBOOTMSG
        CALL    VERBOSE
        RET
CWPAGE:LD      A,(CURBYTE)
        OR      A
        RET     NZ              ; high operand byte must be zero
        LD      A,(PREV1)
        OR      A
        JP      Z,CWZERO
        CP      5
        RET     Z               ; counted above if CALL 0005H
CWZERO:LD      A,(PREV2)
        CALL    ISADDR
        RET     NZ
        LD      HL,(CPAGE0)
        INC     HL
        LD      (CPAGE0),HL
        LD      DE,VPAGE0MSG
        CALL    VERBOSE
        RET

; Recognize the three short idioms most often emitted by 8080 assemblers:
;
;       MVI C,fn / CALL 5
;       LXI D,arg / MVI C,fn / CALL 5
;       MVI C,fn / LXI D,arg / CALL 5
;
; These establish C unambiguously if the byte sequence is executed.  Other
; CALL 5 sites remain dynamic/unknown rather than being guessed from a stale
; register load farther back in the file.
ANALYZEBDOS:
        XOR     A
        LD      (BFKNOWN),A
        LD      (BFARG),A
        LD      A,(PREV4)
        CP      00EH            ; MVI C immediately before CALL
        JP      NZ,ABALT
        LD      A,(PREV3)
        LD      (BFUNC),A
        LD      A,1
        LD      (BFKNOWN),A
        LD      A,(PREV7)
        CP      011H            ; optional preceding LXI D,arg
        JP      NZ,ABKNOWN
        LD      A,(PREV6)
        LD      (BFARGLO),A
        LD      A,(PREV5)
        LD      (BFARGHI),A
        LD      A,1
        LD      (BFARG),A
        JP      ABKNOWN
ABALT: LD      A,(PREV7)
        CP      00EH            ; MVI C,fn then LXI D,arg
        JP      NZ,ABUNKNOWN
        LD      A,(PREV5)
        CP      011H
        JP      NZ,ABUNKNOWN
        LD      A,(PREV6)
        LD      (BFUNC),A
        LD      A,(PREV4)
        LD      (BFARGLO),A
        LD      A,(PREV3)
        LD      (BFARGHI),A
        LD      A,1
        LD      (BFKNOWN),A
        LD      (BFARG),A
ABKNOWN:
        LD      HL,(CBFUNC)
        INC     HL
        LD      (CBFUNC),HL
        LD      A,(BFUNC)
        CP      41
        JP      NC,ABVERB
        LD      L,A
        LD      H,0
        LD      DE,FCOUNTS
        ADD     HL,DE
        INC     (HL)
        JP      ABVERB
ABUNKNOWN:
        LD      HL,(CBUNK)
        INC     HL
        LD      (CBUNK),HL
ABVERB:LD      A,(MODE)
        CP      1
        RET     NZ
        LD      DE,VOFF
        CALL    PRINT
        LD      HL,(BYTEOFF)
        DEC     HL
        DEC     HL
        CALL    PHEX16
        LD      DE,VBDOSHEAD
        CALL    PRINT
        LD      A,(BFKNOWN)
        OR      A
        JP      Z,ABVUNK
        LD      A,(BFUNC)
        LD      L,A
        LD      H,0
        CALL    PDEC16
        LD      A,' '
        CALL    PCHAR
        LD      A,(BFUNC)
        CALL    FNLOOK
        CALL    PRINT
        LD      DE,VIMM
        CALL    PRINT
        LD      A,(BFARG)
        OR      A
        JP      Z,ABVEND
        LD      DE,VDE
        CALL    PRINT
        LD      A,(BFARGHI)
        LD      H,A
        LD      A,(BFARGLO)
        LD      L,A
        CALL    PHEX16
        LD      A,'H'
        CALL    PCHAR
        JP      ABVEND
ABVUNK:LD      DE,VUNKNOWN
        CALL    PRINT
ABVEND:JP      PCRLF

; Return the printable name for function A in DE.  Entries 38 and 39 are
; deliberately labelled unassigned for a plain CP/M 2.2 interpretation.
FNLOOK:CP      41
        LD      DE,BFOTHER
        RET     NC
        LD      L,A
        LD      H,0
        ADD     HL,HL
        LD      DE,BFNTAB
        ADD     HL,DE
        LD      E,(HL)
        INC     HL
        LD      D,(HL)
        RET

; Direct 16-bit address operands in the 8080 instruction set.
ISADDR:CP      022H
        RET     Z
        CP      02AH
        RET     Z
        CP      032H
        RET     Z
        CP      03AH
        RET     Z
        CP      0C2H
        RET     Z
        CP      0C3H
        RET     Z
        CP      0C4H
        RET     Z
        CP      0CAH
        RET     Z
        CP      0CCH
        RET     Z
        CP      0CDH
        RET     Z
        CP      0D2H
        RET     Z
        CP      0D4H
        RET     Z
        CP      0DAH
        RET     Z
        CP      0DCH
        RET     Z
        CP      0E2H
        RET     Z
        CP      0E4H
        RET     Z
        CP      0EAH
        RET     Z
        CP      0ECH
        RET     Z
        CP      0F2H
        RET     Z
        CP      0F4H
        RET     Z
        CP      0FAH
        RET     Z
        CP      0FCH
        RET

VERBOSE:
        LD      A,(MODE)
        CP      1
        RET     NZ
        PUSH    DE
        LD      DE,VOFF
        CALL    PRINT
        LD      HL,(BYTEOFF)
        DEC     HL
        DEC     HL
        CALL    PHEX16
        POP     DE
        JP      PRINT
VZ80:  LD      DE,VOFF
        CALL    PRINT
        LD      HL,(BYTEOFF)
        CALL    PHEX16
        LD      DE,VZ80MSG
        JP      PRINT

REPORT:LD      DE,TITLE
        CALL    PRINT
        CALL    PFILENAME
        CALL    PCRLF
        LD      DE,MRECORDS
        LD      HL,(RECORDS)
        CALL    PDECVAL
        LD      HL,(RECORDS)
        LD      A,H
        CP      2
        JP      NC,ROVER
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        LD      (FILEBYTES),HL
        LD      DE,MBYTES
        CALL    PDECVAL
        LD      DE,MLOAD
        CALL    PRINT
        LD      HL,(FILEBYTES)
        LD      A,H
        OR      L
        JP      Z,REMPTY
        LD      HL,0100H
        CALL    PHEX16
        LD      DE,MDASH
        CALL    PRINT
        LD      HL,(FILEBYTES)
        LD      DE,00FFH
        ADD     HL,DE
        CALL    PHEX16
        CALL    PCRLF
        JP      RCOUNTS
REMPTY: LD      DE,MEMPTY
        CALL    PRINT
        JP      RCOUNTS
ROVER: LD      DE,MBYTES
        CALL    PRINT
        LD      DE,MOVER
        CALL    PRINT
        LD      DE,MLOAD
        CALL    PRINT
        LD      DE,MOVER
        CALL    PRINT
RCOUNTS:
        LD      DE,MBDOS
        LD      HL,(CBDOS)
        CALL    PDECVAL
        LD      DE,MBFUNC
        LD      HL,(CBFUNC)
        CALL    PDECVAL
        LD      DE,MBUNK
        LD      HL,(CBUNK)
        CALL    PDECVAL
        LD      DE,MWBOOT
        LD      HL,(CWBOOT)
        CALL    PDECVAL
        LD      DE,MPAGE0
        LD      HL,(CPAGE0)
        CALL    PDECVAL
        LD      DE,MZ80
        LD      HL,(CZ80)
        CALL    PDECVAL
        CALL    PRINTFLIST
        LD      DE,MNOTE
        JP      PRINT

PRINTFLIST:
        LD      HL,(CBFUNC)
        LD      A,H
        OR      L
        RET     Z
        LD      DE,MFHEAD
        CALL    PRINT
        XOR     A
        LD      (FLINDEX),A
PFLNEXT:
        LD      A,(FLINDEX)
        CP      41
        RET     Z
        LD      L,A
        LD      H,0
        LD      DE,FCOUNTS
        ADD     HL,DE
        LD      A,(HL)
        OR      A
        JP      Z,PFLINC
        LD      (FLCOUNT),A
        LD      DE,MFROW
        CALL    PRINT
        LD      A,(FLINDEX)
        LD      L,A
        LD      H,0
        CALL    PDEC16
        LD      A,' '
        CALL    PCHAR
        LD      A,(FLINDEX)
        CALL    FNLOOK
        CALL    PRINT
        LD      DE,MFCOUNT
        CALL    PRINT
        LD      A,(FLCOUNT)
        LD      L,A
        LD      H,0
        CALL    PDEC16
        CALL    PCRLF
PFLINC:LD      A,(FLINDEX)
        INC     A
        LD      (FLINDEX),A
        JP      PFLNEXT

PFILENAME:
        LD      HL,FCB+1
        LD      B,8
PFN1:  LD      A,(HL)
        AND     7FH
        CP      ' '
        CALL    NZ,PCHAR
        INC     HL
        DEC     B
        JP      NZ,PFN1
        LD      A,'.'
        CALL    PCHAR
        LD      B,3
PFN2:  LD      A,(HL)
        AND     7FH
        CP      ' '
        CALL    NZ,PCHAR
        INC     HL
        DEC     B
        JP      NZ,PFN2
        RET

PRINT: LD      C,FPRINT
        JP      BDOS
PCHAR: PUSH    BC
        PUSH    DE
        PUSH    HL
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     HL
        POP     DE
        POP     BC
        RET
PCRLF: LD      DE,CRLF
        JP      PRINT
PDECVAL:
        PUSH    HL
        CALL    PRINT
        POP     HL
        CALL    PDEC16
        JP      PCRLF
PDEC16:XOR     A
        LD      (DIGSEEN),A
        LD      BC,10000
        CALL    PDIGIT
        LD      BC,1000
        CALL    PDIGIT
        LD      BC,100
        CALL    PDIGIT
        LD      BC,10
        CALL    PDIGIT
        LD      A,L
        ADD     A,'0'
        JP      PCHAR
PDIGIT:LD      D,'0'
PDLOOP:LD      A,L
        SUB     C
        LD      L,A
        LD      A,H
        SBC     A,B
        LD      H,A
        JP      C,PDDONE
        INC     D
        JP      PDLOOP
PDDONE:ADD     HL,BC
        LD      A,D
        CP      '0'
        JP      NZ,PDOUT
        LD      A,(DIGSEEN)
        OR      A
        RET     Z
        LD      A,D
PDOUT:  PUSH    HL
        CALL    PCHAR
        POP     HL
        LD      A,1
        LD      (DIGSEEN),A
        RET
SUBDE: LD      A,L
        SUB     E
        LD      L,A
        LD      A,H
        SBC     A,D
        LD      H,A
        RET
PHEX16:PUSH    HL
        LD      A,H
        CALL    PHEX8
        POP     HL
        LD      A,L
PHEX8: PUSH    AF
        RRCA
        RRCA
        RRCA
        RRCA
        CALL    PHEXN
        POP     AF
PHEXN: AND     0FH
        ADD     A,'0'
        CP      '9'+1
        JP      C,PCHAR
        ADD     A,7
        JP      PCHAR

SHOWHELP:
        LD      DE,HELPMSG
        JP      PRINTEXIT
SHOWINFO:
        LD      DE,INFOMSG
        JP      PRINTEXIT
SHOWVER:
        LD      DE,VERMSG
        JP      PRINTEXIT
BADARGS:
        LD      DE,BADMSG
        JP      PRINTEXIT
NOFILE:LD      DE,NOFILEMSG
        JP      PRINTEXIT
OPENERR:
        LD      DE,OPENMSG
PRINTEXIT:
        CALL    PRINT
        JP      0000H

TITLE:  DB      13,10,'COMINFO 0.1.0-dev2  File $'
CRLF:   DB      13,10,'$'
MRECORDS:DB    13,10,'Logical records:       $'
MBYTES: DB      'Logical bytes:         $'
MLOAD:  DB      'Load range:            $'
MDASH:  DB      '-$'
MEMPTY: DB      'EMPTY',13,10,'$'
MOVER:  DB      'INVALID (exceeds FFFFH)',13,10,'$'
MBDOS:  DB      'Definite CALL 0005H:   $'
MBFUNC: DB      'Immediate BDOS func:   $'
MBUNK:  DB      'Dynamic/unknown calls: $'
MWBOOT: DB      'Definite JMP 0000H:    $'
MPAGE0: DB      'Other page-zero refs:  $'
MZ80:   DB      'Z80 prefix bytes:      $'
MFHEAD: DB      13,10,'Recognized BDOS functions:',13,10,'$'
MFROW:  DB      '  $'
MFCOUNT:DB      '  count $'
MNOTE:  DB      13,10,'Static findings describe byte patterns, not proven execution.',13,10,'$'
VOFF:   DB      '  Offset $'
VBDOSHEAD:DB   '  BDOS $'
VIMM:   DB      '  function immediate$'
VDE:    DB      '  DE=$'
VUNKNOWN:DB    '?  function dynamic/unknown$'
VWBOOTMSG:DB   '  definite JMP 0000H',13,10,'$'
VPAGE0MSG:DB   '  direct page-zero reference',13,10,'$'
VZ80MSG:DB     '  heuristic Z80 prefix byte',13,10,'$'
HELPMSG:DB      13,10,'COMINFO 0.1.0-dev2',13,10,13,10
        DB      '  COMINFO file.COM           Analyze a transient program',13,10
        DB      '  COMINFO file.COM /V        Detailed findings (also /VERBOSE)',13,10
        DB      '  COMINFO /H                 Command help (also /HELP)',13,10
        DB      '  COMINFO /INFO              Show build information',13,10
        DB      '  COMINFO /VER               Show version (also /VERSION)',13,10,'$'
INFOMSG:DB      13,10,'COMINFO 0.1.0-dev2',13,10
        DB      'Read-only CP/M transient-program inspector.',13,10
        DB      'Built with ZSM4 and Digital Research LINK.',13,10
        DB      '8080-compatible analyzer; source revision 31 August 2026.',13,10,'$'
VERMSG:DB       13,10,'COMINFO 0.1.0-dev2',13,10,'$'
BADMSG: DB      13,10,'COMINFO: invalid command. Use COMINFO /HELP.',13,10,'$'
NOFILEMSG:DB    13,10,'COMINFO: a COM filename is required.',13,10,'$'
OPENMSG:DB      13,10,'COMINFO: file not found.',13,10,'$'

SV:     DB      '/V',0
SVERBOSE:DB    '/VERBOSE',0
SH:     DB      '/H',0
SHELP:  DB      '/HELP',0
SINFO:  DB      '/INFO',0
SVER:   DB      '/VER',0
SVERSION:DB    '/VERSION',0

BFNTAB:DW      BF0,BF1,BF2,BF3,BF4,BF5,BF6,BF7,BF8,BF9
        DW      BF10,BF11,BF12,BF13,BF14,BF15,BF16,BF17,BF18,BF19
        DW      BF20,BF21,BF22,BF23,BF24,BF25,BF26,BF27,BF28,BF29
        DW      BF30,BF31,BF32,BF33,BF34,BF35,BF36,BF37,BF38,BF39
        DW      BF40
BF0:    DB      'SYSTEM RESET$'
BF1:    DB      'CONSOLE INPUT$'
BF2:    DB      'CONSOLE OUTPUT$'
BF3:    DB      'READER INPUT$'
BF4:    DB      'PUNCH OUTPUT$'
BF5:    DB      'LIST OUTPUT$'
BF6:    DB      'DIRECT CONSOLE I/O$'
BF7:    DB      'GET I/O BYTE$'
BF8:    DB      'SET I/O BYTE$'
BF9:    DB      'PRINT STRING$'
BF10:   DB      'READ CONSOLE BUFFER$'
BF11:   DB      'CONSOLE STATUS$'
BF12:   DB      'RETURN VERSION$'
BF13:   DB      'RESET DISK SYSTEM$'
BF14:   DB      'SELECT DISK$'
BF15:   DB      'OPEN FILE$'
BF16:   DB      'CLOSE FILE$'
BF17:   DB      'SEARCH FIRST$'
BF18:   DB      'SEARCH NEXT$'
BF19:   DB      'DELETE FILE$'
BF20:   DB      'READ SEQUENTIAL$'
BF21:   DB      'WRITE SEQUENTIAL$'
BF22:   DB      'MAKE FILE$'
BF23:   DB      'RENAME FILE$'
BF24:   DB      'RETURN LOGIN VECTOR$'
BF25:   DB      'RETURN CURRENT DISK$'
BF26:   DB      'SET DMA ADDRESS$'
BF27:   DB      'GET ALLOCATION ADDRESS$'
BF28:   DB      'WRITE PROTECT DISK$'
BF29:   DB      'GET READ-ONLY VECTOR$'
BF30:   DB      'SET FILE ATTRIBUTES$'
BF31:   DB      'GET DPB ADDRESS$'
BF32:   DB      'GET/SET USER CODE$'
BF33:   DB      'READ RANDOM$'
