; SPDX-License-Identifier: GPL-2.0-or-later
;
;***********************************************************************
;*                                                                     *
;*                   D P B C H K   --   DEV2                          *
;*                                                                     *
;*            DISK PARAMETER VALIDATOR FOR CP/M 2.2                    *
;*                                                                     *
;***********************************************************************
;
; Version 0.1.0-dev2, 31 August 2026
;
; Assemble with ZSM4 and Digital Research LINK:
;
;       ZSM4 DPBCHK=DPBCHK
;       LINK DPBCHK[A]
;
; The optional drive may be written in the usual CP/M fashion:
;
;       DPBCHK             check the default drive
;       DPBCHK B:          check drive B
;
; DPBCHK does not read or write a disk sector.  It asks BDOS to log the
; named drive, obtains the public DPB and allocation vector, then calls the
; standard BIOS SELDSK entry to find the DPH.  The drive which was current
; on entry is selected again before return to the CCP.
;
; Revision history:
;   dev2    clarify exact long aliases on the command help screen
;   dev1    initial checks for block, extent, directory and vector geometry
;
; Programmer's notebook:
;   This program deliberately uses only the 8080 instruction set although
;   ZSM4 notation is used.  It should consequently run on an 8080 CP/M as
;   well as on the Z80 machines for which it was first assembled.
;
;   SELDSK is the ninth entry following BOOT in the standard BIOS jump
;   table.  The WBOOT vector at 0001H points to BIOS+3, hence adding 24 to
;   its target produces the SELDSK entry address.  BIOSJMP is filled in once
;   at start-up; this is the customary CP/M method of making an indirect
;   subroutine call without relying on a Z80-only instruction.  The disk
;   access and number-printing routines began in DISKINFO dev3; keeping their
;   calling conventions alike is the first step toward a common library.
;
;***********************************************************************

	.z80                    ; Zilog spelling, 8080 opcodes only
	cseg

BDOS    EQU     0005H
;
; dev1 - patch page-zero warm boot vector address
;
;WBOOTV EQU     0002H          ; first cut began one byte too late
WBOOTV  EQU     0001H          ; operand of page-zero JMP at 0000H

; BDOS function numbers used here.
FPRINT  EQU     9
FSELDSK EQU     14
FCURDSK EQU     25
FGETALV EQU     27
FGETDPB EQU     31

START:  LD      SP,STACKTOP     ; CCP stack contents are not an interface
        LD      C,FCURDSK
        CALL    BDOS
        LD      (OLDDRV),A
        LD      (NEWDRV),A
        CALL    GETARGS
        JP      C,BADDRV
        LD      A,(MODE)
        CP      5
        JP      Z,SHOWHELP
        CP      6
        JP      Z,SHOWINFO
        CP      7
        JP      Z,SHOWVER
        LD      A,(NEWDRV)
        LD      E,A
        LD      C,FSELDSK
        CALL    BDOS            ; log drive and make its DPB current

        LD      C,FGETDPB
        CALL    BDOS
        LD      (DPBPTR),HL
        LD      A,H
        OR      L
        JP      Z,NODRIVE

        CALL    GETDPH
        LD      (DPHPTR),HL
        LD      A,H
        OR      L
        JP      Z,NODRIVE
        CALL    SAVEDPH
        CALL    SAVEDPB
        CALL    CALCULATE
        CALL    REPORT
        JP      EXIT

; Copy and fold each command-tail word, then classify it exactly.  A report
; selector and drive may appear in either order.  Abbreviations and repeated
; operands are rejected; old CCPs differed too much to trust their FCB here.
GETARGS:XOR     A
        LD      (MODE),A
        LD      (DRVSET),A
        LD      A,(0080H)
        LD      B,A
        LD      HL,0081H
GANEXT:LD      A,B
        OR      A
        JP      Z,GADONE
        LD      A,(HL)
        INC     HL
        DEC     B
        CP      ' '
        JP      Z,GANEXT
        LD      DE,ARGBUF
        LD      C,0
GACOPY:CP      'a'
        JP      C,GASTORE
        CP      'z'+1
        JP      NC,GASTORE
        SUB     20H
GASTORE:LD     (DE),A
        INC     DE
        INC     C
        LD      A,C
        CP      15
        JP      NC,GABAD
        LD      A,B
        OR      A
        JP      Z,GAWORD
        LD      A,(HL)
        CP      ' '
        JP      Z,GAWORD
        INC     HL
        DEC     B
        JP      GACOPY
GAWORD:XOR     A
        LD      (DE),A
        CALL    ARGWORD
        JP      C,GABAD
        JP      GANEXT
GADONE:LD      A,(MODE)        ; informational selectors stand alone
        CP      5
        JP      C,GAGOOD
        LD      A,(DRVSET)
        OR      A
        JP      NZ,GABAD
GAGOOD:OR      A
        RET
GABAD: SCF
        RET

ARGWORD:
        LD      A,(ARGBUF)
        CP      '/'
        JP      Z,GAOPTION
        LD      A,(DRVSET)
        OR      A
        JP      NZ,GABAD
        LD      A,(ARGBUF+1)
        CP      ':'
        JP      NZ,GABAD
        LD      A,(ARGBUF+2)
        OR      A
        JP      NZ,GABAD
        LD      A,(ARGBUF)
        CP      'A'
        JP      C,GABAD
        CP      'P'+1
        JP      NC,GABAD
        SUB     'A'
        LD      (NEWDRV),A
        LD      A,1
        LD      (DRVSET),A
        OR      A
        RET
GAOPTION:
        LD      A,(MODE)
        OR      A
        JP      NZ,GABAD
        LD      DE,SH
        CALL    ARGIS
        LD      A,5
        JP      Z,GASET
        LD      DE,SHELP
        CALL    ARGIS
        LD      A,5
        JP      Z,GASET
        LD      DE,SINFO
        CALL    ARGIS
        LD      A,6
        JP      Z,GASET
        LD      DE,SVER
        CALL    ARGIS
        LD      A,7
        JP      Z,GASET
        LD      DE,SVERSION
        CALL    ARGIS
        LD      A,7
        JP      NZ,GABAD
GASET: LD      (MODE),A
        OR      A
        RET

; Compare the copied argument with the zero-terminated selector at DE.
ARGIS: PUSH    HL
        PUSH    DE
        LD      HL,ARGBUF
GACMP: LD      A,(DE)
        CP      (HL)
        JP      NZ,GACMPNO
        OR      A
        JP      Z,GACMPYES
        INC     DE
        INC     HL
        JP      GACMP
GACMPNO:
        POP     DE
        POP     HL
        OR      1               ; return not equal
        RET
GACMPYES:
        POP     DE
        POP     HL
        XOR     A               ; return equal
        RET

; Construct and call the standard BIOS SELDSK entry.  E=0 requests an
; ordinary selection rather than the CP/M 3 first-select convention.
GETDPH:LD      HL,(WBOOTV)
        LD      DE,24
        ADD     HL,DE
        LD      (BIOSJMP+1),HL
        LD      A,(NEWDRV)
        LD      C,A
        LD      E,0
        CALL    BIOSJMP
        RET
BIOSJMP:
        JP      0000H           ; operand supplied by GETDPH

; Save the documented DPH words before another system call can disturb the
; three scratch words in the middle of the header.
SAVEDPH:
        LD      DE,DPHBUF
        LD      BC,16
SDLOOP:LD      A,(HL)
        LD      (DE),A
        INC     HL
        INC     DE
        DEC     BC
        LD      A,B
        OR      C
        JP      NZ,SDLOOP
        RET

; The CP/M 2.2 DPB is fifteen bytes long.  Keep a private copy so the report
; remains stable while BDOS is used for console output.
SAVEDPB:
        LD      HL,(DPBPTR)
        LD      DE,DPBBUF
        LD      BC,15
SPLOOP:LD      A,(HL)
        LD      (DE),A
        INC     HL
        INC     DE
        DEC     BC
        LD      A,B
        OR      C
        JP      NZ,SPLOOP
        RET

; Work out the values most often wanted at the console.  Sizes are retained
; in KiB; a normal CP/M 2.2 disk fits comfortably in sixteen bits.
CALCULATE:
        LD      A,(DPBBUF+2)    ; BSH: block bytes = 128 shl BSH
        CP      3
        JP      C,CALBAD
        SUB     3               ; KiB per block = 1 shl (BSH-3)
        LD      B,A
        LD      HL,1
CBKLP: LD      A,B
        OR      A
        JP      Z,CBKDONE
        ADD     HL,HL
        DEC     B
        JP      CBKLP
CBKDONE:
        LD      (BLKKB),HL

        LD      HL,(DPBBUF+5)   ; DSM is highest allocation block number
        INC     HL
        LD      (TOTBLK),HL
        CALL    MULBLK
        LD      (TOTKB),HL

        CALL    DIRCOUNT        ; directory reservation from AL0 and AL1
        LD      (DIRBLK),HL
        CALL    MULBLK
        LD      (DIRKB),HL
;
; dev2 - patch subtract directory blocks, not directory K-bytes
;
;       EX      DE,HL           ; dev1 worked only with 1K blocks
        LD      HL,(DIRBLK)
        EX      DE,HL
        LD      HL,(TOTBLK)
        CALL    SUBDE
        LD      (DATBLK),HL

        LD      HL,(DPBBUF+7)   ; DRM is highest directory entry number
        INC     HL
        LD      (DIRENT),HL

        LD      A,(DPBBUF+4)    ; one directory extent holds EXM+1 extents
        INC     A
        LD      L,A
        LD      H,0
        LD      (EXTPER),HL
        ADD     HL,HL           ; multiply by 16 KiB
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        LD      (EXTKB),HL

        CALL    COUNTALV
        RET
CALBAD:LD      HL,0
        LD      (BLKKB),HL
        LD      (TOTKB),HL
        LD      (DIRKB),HL
        RET

; Multiply HL by the power-of-two allocation block size in KiB.
MULBLK:PUSH    BC
        LD      A,(DPBBUF+2)
        SUB     3
        LD      B,A
MBLOOP:LD      A,B
        OR      A
        JP      Z,MBDONE
        ADD     HL,HL
        DEC     B
        JP      MBLOOP
MBDONE:POP     BC
        RET

; Count the one bits in AL0/AL1.  CP/M records directory blocks from the
; high bit of AL0 toward the low bit of AL1.
DIRCOUNT:
        LD      DE,0
        LD      HL,DPBBUF+9
        LD      B,2
DCBYTE:LD      A,(HL)
        LD      C,8
DCBIT: RLCA
        JP      NC,DCNEXT
        INC     DE
DCNEXT:DEC     C
        JP      NZ,DCBIT
        INC     HL
        DEC     B
        JP      NZ,DCBYTE
        EX      DE,HL
        RET

; Count meaningful bits in the allocation vector.  Padding beyond DSM is
; ignored.  The returned totals include directory blocks, as BDOS does.
COUNTALV:
        LD      HL,(DPHBUF+14)
        LD      A,H
        OR      L
        JP      Z,ALVNONE
        LD      HL,(TOTBLK)
        EX      DE,HL
        LD      HL,(DPHBUF+14)
        LD      BC,0
        LD      A,80H
        LD      (BITMSK),A
ALVLOOP:
        LD      A,D
        OR      E
        JP      Z,ALVDONE
        LD      A,(BITMSK)
        LD      (BITTMP),A
        LD      A,(HL)
        PUSH    HL
        LD      HL,BITTMP
        AND     (HL)
        POP     HL
        JP      Z,ALVFREE
        INC     BC
ALVFREE:
        DEC     DE
        LD      A,(BITMSK)
        RRCA
        LD      (BITMSK),A
        CP      80H
        JP      NZ,ALVLOOP
        INC     HL
        JP      ALVLOOP
ALVDONE:
        PUSH    BC
        POP     HL
        LD      (USEDBLK),HL
        EX      DE,HL
        LD      HL,(TOTBLK)
        CALL    SUBDE
        LD      (FREEBLK),HL
        LD      A,1
        LD      (ALVOK),A
        RET
ALVNONE:
        XOR     A
        LD      (ALVOK),A
        RET

; Sixteen-bit subtraction written as two 8080 byte operations.  A direct
; SBC HL,DE was used in the first desk calculation, but that instruction is
; Z80-only and DPBCHK has no need to exclude an otherwise serviceable 8080.
; Entry: HL=minuend, DE=subtrahend.  Exit: HL=difference.
SUBDE:  LD      A,L
        SUB     E
        LD      L,A
        LD      A,H
        SBC     A,D
        LD      H,A
        RET

REPORT:LD      DE,TITLE
        CALL    PRINT
        LD      A,(NEWDRV)
        ADD     A,'A'
        CALL    PCHAR
        LD      DE,COLON
        CALL    PRINT
        XOR     A
        LD      (PASSCT),A
        LD      (WARNCT),A
        LD      (FAILCT),A
        LD      DE,TABLEHD
        CALL    PRINT
        CALL    CHKBSH
        CALL    CHKBLM
        CALL    CHKEXM
        CALL    CHKDSM
        CALL    CHKDIR
        CALL    CHKCKS
        CALL    CHKPTR
        LD      DE,SUMMARY
        CALL    PRINT
        LD      A,(PASSCT)
        CALL    PDEC8
        LD      DE,SWARN
        CALL    PRINT
        LD      A,(WARNCT)
        CALL    PDEC8
        LD      DE,SFAIL
        CALL    PRINT
        LD      A,(FAILCT)
        CALL    PDEC8
        LD      DE,EFAIL
        JP      PRINT

; BSH must describe one of the ordinary CP/M 2.2 allocation blocks from
; one through sixteen K-bytes.  Larger values overflow the calculations
; used by a transient program even where a private BIOS happens to allow one.
CHKBSH:LD      A,(DPBBUF+2)
        CP      3
        JP      C,BSHBAD
        CP      8
        JP      NC,BSHBAD
        LD      DE,BSHOK
        JP      CKPASS
BSHBAD:LD      DE,BSHBADMSG
        JP      CKFAIL

; BLM is the low-order record mask and must be exactly 2^BSH minus one.
CHKBLM:LD      A,(DPBBUF+2)
        CP      3
        JP      C,BLMBAD
        CP      8
        JP      NC,BLMBAD
        LD      B,A
        LD      A,1
BLMSHF:ADD     A,A
        DEC     B
        JP      NZ,BLMSHF
        DEC     A
        LD      B,A
        LD      A,(DPBBUF+3)
        CP      B
        JP      NZ,BLMBAD
        LD      DE,BLMOK
        JP      CKPASS
BLMBAD:LD      DE,BLMBADMSG
        JP      CKFAIL

; EXM is BLM divided by eight for an eight-bit allocation list, or by
; sixteen for a sixteen-bit list.  Shifts are written out for the 8080.
CHKEXM:LD      A,(DPBBUF+3)
        RRCA
        RRCA
        RRCA
        AND     1FH
        LD      B,A
        LD      A,(DPBBUF+6)
        OR      A
        JP      Z,EXMCMP
        LD      A,B
        RRCA
        AND     0FH
        LD      B,A
EXMCMP:LD      A,(DPBBUF+4)
        CP      B
        JP      NZ,EXMBAD
        LD      DE,EXMOK
        JP      CKPASS
EXMBAD:LD      DE,EXMBADMSG
        JP      CKFAIL

; Standard CP/M 2.2 allocation numbers cover at most 2048 blocks.
CHKDSM:LD      A,(DPBBUF+6)
        CP      8
        JP      NC,DSMBAD
        LD      DE,DSMOK
        JP      CKPASS
DSMBAD:LD      DE,DSMBADMSG
        JP      CKFAIL

; The AL0/AL1 one bits must reserve enough blocks for every 32-byte entry.
; ENTPER is 4 shifted left BSH, the number of entries in one block.
CHKDIR:LD      A,(DPBBUF+2)
        CP      3
        JP      C,DIRBAD
        CP      8
        JP      NC,DIRBAD
        LD      B,A
        LD      HL,4
DERSHF:ADD     HL,HL
        DEC     B
        JP      NZ,DERSHF
        EX      DE,HL           ; DE=directory entries per block
        LD      HL,(DIRENT)
        LD      B,0
DERLOOP:LD     A,H
        OR      L
        JP      Z,DERDONE
        INC     B
        CALL    SUBDE
        JP      NC,DERLOOP
        LD      HL,0
        JP      DERLOOP
DERDONE:LD     HL,(DIRBLK)
        LD      A,H
        OR      A
        JP      NZ,DIROK
        LD      A,L
        CP      B
        JP      C,DIRBAD
DIROK:  LD      DE,DIROKMSG
        JP      CKPASS
DIRBAD:LD      DE,DIRBADMSG
        JP      CKFAIL

; CKS may be zero for a fixed disk.  A checked removable disk normally
; carries one checksum byte for each four directory entries.
CHKCKS:LD      HL,(DPBBUF+11)
        LD      A,H
        OR      L
        JP      Z,CKSFIX
        LD      HL,(DIRENT)
        OR      A
        LD      A,H
        RRA
        LD      H,A
        LD      A,L
        RRA
        LD      L,A
        OR      A
        LD      A,H
        RRA
        LD      H,A
        LD      A,L
        RRA
        LD      L,A
        EX      DE,HL
        LD      HL,(DPBBUF+11)
        LD      A,H
        CP      D
        JP      NZ,CKSWARN
        LD      A,L
        CP      E
        JP      NZ,CKSWARN
        LD      DE,CKSOK
        JP      CKPASS
CKSFIX: LD      DE,CKSFIXMSG
        JP      CKPASS
CKSWARN:LD     DE,CKSWARNMSG
        JP      CKWARN

; The DPH, DPB, directory buffer and ALV are required for the operations
; described by this report.  XLT and CSV are permitted to be zero.
CHKPTR: LD      HL,(DPHPTR)
        LD      A,H
        OR      L
        JP      Z,PTRBAD
        LD      HL,(DPHBUF+8)
        LD      A,H
        OR      L
        JP      Z,PTRBAD
        LD      HL,(DPHBUF+10)
        LD      A,H
        OR      L
        JP      Z,PTRBAD
        EX      DE,HL
        LD      HL,(DPBPTR)
        LD      A,H
        CP      D
        JP      NZ,PTRBAD
        LD      A,L
        CP      E
        JP      NZ,PTRBAD
        LD      HL,(DPHBUF+14)
        LD      A,H
        OR      L
        JP      Z,PTRBAD
        LD      DE,PTROK
        JP      CKPASS
PTRBAD: LD      DE,PTRBADMSG
        JP      CKFAIL

CKPASS:PUSH    DE
        LD      A,(PASSCT)
        INC     A
        LD      (PASSCT),A
        POP     DE
        JP      PRINT
CKWARN:PUSH    DE
        LD      A,(WARNCT)
        INC     A
        LD      (WARNCT),A
        POP     DE
        JP      PRINT
CKFAIL:PUSH    DE
        LD      A,(FAILCT)
        INC     A
        LD      (FAILCT),A
        POP     DE
        JP      PRINT

PDEC8: LD      L,A
        LD      H,0
        JP      PDEC16

; Print labelled numeric fields.  Word fields are shown in hex and decimal;
; byte fields use two hex digits and an unsigned decimal value.
;
; dev1 - patch preserve the word while function 9 prints its label
;
;PWORD: CALL    PRINT           ; first cut trusted BDOS to preserve HL
PWORD:  PUSH    HL
        CALL    PRINT
        POP     HL
        PUSH    HL
        CALL    PHEX16
        LD      DE,HEXEQL
        CALL    PRINT
        POP     HL
        CALL    PDEC16
        JP      PNUMEND
PBYTE:  PUSH    AF
        CALL    PRINT
        POP     AF
        PUSH    AF
        CALL    PHEX8
        LD      DE,HEXEQL
        CALL    PRINT
        POP     AF
        LD      L,A
        LD      H,0
        CALL    PDEC16
        JP      PNUMEND
PDECVAL:
        PUSH    HL
        CALL    PRINT
        POP     HL
        CALL    PDEC16
        JP      PCRLF

; A null pointer is printed as NONE, otherwise merely terminate the line.
PNONE:  LD      A,H
        OR      L
        JP      NZ,PCRLF
        LD      DE,NONE
        JP      PRINT

PRINT:  LD      C,FPRINT
        JP      BDOS
PCHAR:  PUSH    BC
        PUSH    DE
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     DE
        POP     BC
        RET
PCRLF: LD      DE,CRLF
        JP      PRINT
PNUMEND:
        LD      DE,NUMEND
        JP      PRINT

PHEX16:PUSH    HL
        LD      A,H
        CALL    PHEX8
        POP     HL
        PUSH    HL
        LD      A,L
        CALL    PHEX8
        POP     HL
        RET
PHEX8:  PUSH    AF
        RRCA
        RRCA
        RRCA
        RRCA
        AND     0FH
        CALL    PHNIB
        POP     AF
        AND     0FH
        CALL    PHNIB
        RET
PHNIB: ADD     A,'0'
        CP      '9'+1
        JP      C,PCHAR
        ADD     A,7
        JP      PCHAR

; Decimal conversion by decimal places.  At most nine subtractions are made
; for each digit, which was found quicker on a small 4 MHz machine than the
; general divide routine used in an early notebook version.
PDEC16:XOR     A
        LD      (DIGSEEN),A
        LD      BC,10000
        CALL    PDIGIT
        LD      BC,1000
        CALL    PDIGIT
        LD      BC,100
        CALL    PDIGIT
        LD      BC,10
        CALL    PDIGIT
        LD      A,L
        ADD     A,'0'
        JP      PCHAR
PDIGIT:LD      D,'0'
PDLOOP:LD      A,L
        SUB     C
        LD      L,A
        LD      A,H
        SBC     A,B
        LD      H,A
        JP      C,PDDONE
        INC     D
        JP      PDLOOP
PDDONE:ADD     HL,BC
        LD      A,D
        CP      '0'
        JP      NZ,PDOUT
        LD      A,(DIGSEEN)
        OR      A
        RET     Z
        LD      A,D
PDOUT:  PUSH    HL
        CALL    PCHAR
        POP     HL
        LD      A,1
        LD      (DIGSEEN),A
        RET

SHOWHELP:
        LD      DE,HELPMSG
        CALL    PRINT
        JP      EXIT
SHOWINFO:
        LD      DE,INFOMSG
        CALL    PRINT
        JP      EXIT
SHOWVER:
        LD      DE,VERMSG
        CALL    PRINT
        JP      EXIT
BADDRV:LD      DE,BADMSG
        CALL    PRINT
        JP      EXIT
NODRIVE:
        LD      DE,NODMSG
        CALL    PRINT
EXIT:   LD      A,(OLDDRV)
        LD      E,A
        LD      C,FSELDSK
        CALL    BDOS
        JP      0000H

TITLE:  DB      13,10,'DPBCHK 0.1.0-dev2  Drive $'
COLON:  DB      ':',13,10,'$'
HEXEQL: DB      'H  ($'
NUMEND: DB      ')',13,10,'$'
CRLF:   DB      13,10,'$'
NONE:   DB      '  NONE',13,10,'$'
TABLEHD:DB      13,10,'CHECK    RESULT  DESCRIPTION',13,10,'$'
BSHOK:  DB      'BSH      PASS    Allocation block size is supported',13,10,'$'
BSHBADMSG:DB    'BSH      FAIL    Allocation block size is invalid',13,10,'$'
BLMOK:  DB      'BLM      PASS    BLM agrees with BSH',13,10,'$'
BLMBADMSG:DB    'BLM      FAIL    BLM does not agree with BSH',13,10,'$'
EXMOK:  DB      'EXM      PASS    Extent mask agrees with block geometry',13,10,'$'
EXMBADMSG:DB    'EXM      FAIL    Extent mask is inconsistent',13,10,'$'
DSMOK:  DB      'DSM      PASS    Allocation block range is representable',13,10,'$'
DSMBADMSG:DB    'DSM      FAIL    Allocation block range exceeds CP/M 2.2',13,10,'$'
DIROKMSG:DB     'DIR      PASS    Directory reservation is sufficient',13,10,'$'
DIRBADMSG:DB    'DIR      FAIL    Directory reservation is too small',13,10,'$'
CKSOK:  DB      'CKS      PASS    Check vector agrees with directory size',13,10,'$'
CKSFIXMSG:DB    'CKS      PASS    Zero check vector denotes a fixed disk',13,10,'$'
CKSWARNMSG:DB   'CKS      WARN    Nonstandard check-vector size',13,10,'$'
PTROK:  DB      'POINTERS PASS    Required DPH pointers agree',13,10,'$'
PTRBADMSG:DB    'POINTERS FAIL    Required DPH pointers are invalid',13,10,'$'
SUMMARY:DB      13,10,'Summary: $'
SWARN:  DB      ' pass, $'
SFAIL:  DB      ' warn, $'
EFAIL:  DB      ' fail',13,10,'$'
HELPMSG:DB      13,10,'DPBCHK 0.1.0-dev2',13,10,13,10
        DB      '  DPBCHK [drive:]           Check disk parameters',13,10
        DB      '  DPBCHK /H                 Command help (also /HELP)',13,10
        DB      '  DPBCHK /INFO              Show build information',13,10
        DB      '  DPBCHK /VER               Show version (also /VERSION)',13,10,'$'
INFOMSG:DB      13,10,'DPBCHK 0.1.0-dev2',13,10
        DB      'Read-only CP/M 2.2 disk parameter validator.',13,10
        DB      'Built with ZSM4 and Digital Research LINK.',13,10
        DB      '8080-compatible code; source revision 31 August 2026.',13,10,'$'
VERMSG:DB      13,10,'DPBCHK 0.1.0-dev2',13,10,'$'
BADMSG: DB      13,10,'DPBCHK: unknown option. Use DPBCHK /HELP.',13,10,'$'
NODMSG: DB      13,10,'DPBCHK: selected drive is not available',13,10,'$'

