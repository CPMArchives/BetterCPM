; SPDX-License-Identifier: GPL-2.0-or-later
;
;***********************************************************************
;*                                                                     *
;*                 D I S K I N F O   --   DEV4                        *
;*                                                                     *
;*          DISK PARAMETER AND ALLOCATION REPORT FOR CP/M 2.2          *
;*                                                                     *
;***********************************************************************
;
; Version 0.1.0-dev4, 31 August 2026
;
; Assemble with ZSM4 and Digital Research LINK:
;
;       ZSM4 DISKINFO=DISKINFO
;       LINK DISKINFO[A]
;
; The optional drive may be written in the usual CP/M fashion:
;
;       DISKINFO           report the default drive
;       DISKINFO B:        report drive B
;
; DISKINFO does not read or write a disk sector.  It asks BDOS to log the
; named drive, obtains the public DPB and allocation vector, then calls the
; standard BIOS SELDSK entry to find the DPH.  The drive which was current
; on entry is selected again before return to the CCP.
;
; Revision history:
;   dev4    clarify exact long aliases on the command help screen
;   dev3    add the common command interface and separate report selectors
;   dev2    correct usable block count where allocation blocks exceed 1K
;   dev1    first separate disk report; DPH, DPB, geometry and allocation
;
; Programmer's notebook:
;   This program deliberately uses only the 8080 instruction set although
;   ZSM4 notation is used.  It should consequently run on an 8080 CP/M as
;   well as on the Z80 machines for which it was first assembled.
;
;   SELDSK is the ninth entry following BOOT in the standard BIOS jump
;   table.  The WBOOT vector at 0001H points to BIOS+3, hence adding 24 to
;   its target produces the SELDSK entry address.  BIOSJMP is filled in once
;   at start-up; this is the customary CP/M method of making an indirect
;   subroutine call without relying on a Z80-only instruction.
;
;***********************************************************************

	.z80                    ; Zilog spelling, 8080 opcodes only
	cseg

BDOS    EQU     0005H
;
; dev1 - patch page-zero warm boot vector address
;
;WBOOTV EQU     0002H          ; first cut began one byte too late
WBOOTV  EQU     0001H          ; operand of page-zero JMP at 0000H

; BDOS function numbers used here.
FPRINT  EQU     9
FSELDSK EQU     14
FCURDSK EQU     25
FGETALV EQU     27
FGETDPB EQU     31

START:  LD      SP,STACKTOP     ; CCP stack contents are not an interface
        LD      C,FCURDSK
        CALL    BDOS
        LD      (OLDDRV),A
        LD      (NEWDRV),A
        CALL    GETARGS
        JP      C,BADDRV
        LD      A,(MODE)
        CP      5
        JP      Z,SHOWHELP
        CP      6
        JP      Z,SHOWINFO
        CP      7
        JP      Z,SHOWVER
        LD      A,(NEWDRV)
        LD      E,A
        LD      C,FSELDSK
        CALL    BDOS            ; log drive and make its DPB current

        LD      C,FGETDPB
        CALL    BDOS
        LD      (DPBPTR),HL
        LD      A,H
        OR      L
        JP      Z,NODRIVE

        CALL    GETDPH
        LD      (DPHPTR),HL
        LD      A,H
        OR      L
        JP      Z,NODRIVE
        CALL    SAVEDPH
        CALL    SAVEDPB
        CALL    CALCULATE
        CALL    REPORT
        JP      EXIT

; Copy and fold each command-tail word, then classify it exactly.  A report
; selector and drive may appear in either order.  Abbreviations and repeated
; operands are rejected; old CCPs differed too much to trust their FCB here.
GETARGS:XOR     A
        LD      (MODE),A
        LD      (DRVSET),A
        LD      A,(0080H)
        LD      B,A
        LD      HL,0081H
GANEXT:LD      A,B
        OR      A
        JP      Z,GADONE
        LD      A,(HL)
        INC     HL
        DEC     B
        CP      ' '
        JP      Z,GANEXT
        LD      DE,ARGBUF
        LD      C,0
GACOPY:CP      'a'
        JP      C,GASTORE
        CP      'z'+1
        JP      NC,GASTORE
        SUB     20H
GASTORE:LD     (DE),A
        INC     DE
        INC     C
        LD      A,C
        CP      15
        JP      NC,GABAD
        LD      A,B
        OR      A
        JP      Z,GAWORD
        LD      A,(HL)
        CP      ' '
        JP      Z,GAWORD
        INC     HL
        DEC     B
        JP      GACOPY
GAWORD:XOR     A
        LD      (DE),A
        CALL    ARGWORD
        JP      C,GABAD
        JP      GANEXT
GADONE:LD      A,(MODE)        ; informational selectors stand alone
        CP      5
        JP      C,GAGOOD
        LD      A,(DRVSET)
        OR      A
        JP      NZ,GABAD
GAGOOD:OR      A
        RET
GABAD: SCF
        RET

ARGWORD:
        LD      A,(ARGBUF)
        CP      '/'
        JP      Z,GAOPTION
        LD      A,(DRVSET)
        OR      A
        JP      NZ,GABAD
        LD      A,(ARGBUF+1)
        CP      ':'
        JP      NZ,GABAD
        LD      A,(ARGBUF+2)
        OR      A
        JP      NZ,GABAD
        LD      A,(ARGBUF)
        CP      'A'
        JP      C,GABAD
        CP      'P'+1
        JP      NC,GABAD
        SUB     'A'
        LD      (NEWDRV),A
        LD      A,1
        LD      (DRVSET),A
        OR      A
        RET
GAOPTION:
        LD      A,(MODE)
        OR      A
        JP      NZ,GABAD
        LD      DE,SDPH
        CALL    ARGIS
        LD      A,1
        JP      Z,GASET
        LD      DE,SDPB
        CALL    ARGIS
        LD      A,2
        JP      Z,GASET
        LD      DE,SGEO
        CALL    ARGIS
        LD      A,3
        JP      Z,GASET
        LD      DE,SALLOC
        CALL    ARGIS
        LD      A,4
        JP      Z,GASET
        LD      DE,SH
        CALL    ARGIS
        LD      A,5
        JP      Z,GASET
        LD      DE,SHELP
        CALL    ARGIS
        LD      A,5
        JP      Z,GASET
        LD      DE,SINFO
        CALL    ARGIS
        LD      A,6
        JP      Z,GASET
        LD      DE,SVER
        CALL    ARGIS
        LD      A,7
        JP      Z,GASET
        LD      DE,SVERSION
        CALL    ARGIS
        LD      A,7
        JP      NZ,GABAD
GASET: LD      (MODE),A
        OR      A
        RET

; Compare the copied argument with the zero-terminated selector at DE.
ARGIS: PUSH    HL
        PUSH    DE
        LD      HL,ARGBUF
GACMP: LD      A,(DE)
        CP      (HL)
        JP      NZ,GACMPNO
        OR      A
        JP      Z,GACMPYES
        INC     DE
        INC     HL
        JP      GACMP
GACMPNO:
        POP     DE
        POP     HL
        OR      1               ; return not equal
        RET
GACMPYES:
        POP     DE
        POP     HL
        XOR     A               ; return equal
        RET

; Construct and call the standard BIOS SELDSK entry.  E=0 requests an
; ordinary selection rather than the CP/M 3 first-select convention.
GETDPH:LD      HL,(WBOOTV)
        LD      DE,24
        ADD     HL,DE
        LD      (BIOSJMP+1),HL
        LD      A,(NEWDRV)
        LD      C,A
        LD      E,0
        CALL    BIOSJMP
        RET
BIOSJMP:
        JP      0000H           ; operand supplied by GETDPH

; Save the documented DPH words before another system call can disturb the
; three scratch words in the middle of the header.
SAVEDPH:
        LD      DE,DPHBUF
        LD      BC,16
SDLOOP:LD      A,(HL)
        LD      (DE),A
        INC     HL
        INC     DE
        DEC     BC
        LD      A,B
        OR      C
        JP      NZ,SDLOOP
        RET

; The CP/M 2.2 DPB is fifteen bytes long.  Keep a private copy so the report
; remains stable while BDOS is used for console output.
SAVEDPB:
        LD      HL,(DPBPTR)
        LD      DE,DPBBUF
        LD      BC,15
SPLOOP:LD      A,(HL)
        LD      (DE),A
        INC     HL
        INC     DE
        DEC     BC
        LD      A,B
        OR      C
        JP      NZ,SPLOOP
        RET

; Work out the values most often wanted at the console.  Sizes are retained
; in KiB; a normal CP/M 2.2 disk fits comfortably in sixteen bits.
CALCULATE:
        LD      A,(DPBBUF+2)    ; BSH: block bytes = 128 shl BSH
        CP      3
        JP      C,CALBAD
        SUB     3               ; KiB per block = 1 shl (BSH-3)
        LD      B,A
        LD      HL,1
CBKLP: LD      A,B
        OR      A
        JP      Z,CBKDONE
        ADD     HL,HL
        DEC     B
        JP      CBKLP
CBKDONE:
        LD      (BLKKB),HL

        LD      HL,(DPBBUF+5)   ; DSM is highest allocation block number
        INC     HL
        LD      (TOTBLK),HL
        CALL    MULBLK
        LD      (TOTKB),HL

        CALL    DIRCOUNT        ; directory reservation from AL0 and AL1
        LD      (DIRBLK),HL
        CALL    MULBLK
        LD      (DIRKB),HL
;
; dev2 - patch subtract directory blocks, not directory K-bytes
;
;       EX      DE,HL           ; dev1 worked only with 1K blocks
        LD      HL,(DIRBLK)
        EX      DE,HL
        LD      HL,(TOTBLK)
        CALL    SUBDE
        LD      (DATBLK),HL

        LD      HL,(DPBBUF+7)   ; DRM is highest directory entry number
        INC     HL
        LD      (DIRENT),HL

        LD      A,(DPBBUF+4)    ; one directory extent holds EXM+1 extents
        INC     A
        LD      L,A
        LD      H,0
        LD      (EXTPER),HL
        ADD     HL,HL           ; multiply by 16 KiB
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        LD      (EXTKB),HL

        CALL    COUNTALV
        RET
CALBAD:LD      HL,0
        LD      (BLKKB),HL
        LD      (TOTKB),HL
        LD      (DIRKB),HL
        RET

; Multiply HL by the power-of-two allocation block size in KiB.
MULBLK:PUSH    BC
        LD      A,(DPBBUF+2)
        SUB     3
        LD      B,A
MBLOOP:LD      A,B
        OR      A
        JP      Z,MBDONE
        ADD     HL,HL
        DEC     B
        JP      MBLOOP
MBDONE:POP     BC
        RET

; Count the one bits in AL0/AL1.  CP/M records directory blocks from the
; high bit of AL0 toward the low bit of AL1.
DIRCOUNT:
        LD      DE,0
        LD      HL,DPBBUF+9
        LD      B,2
DCBYTE:LD      A,(HL)
        LD      C,8
DCBIT: RLCA
        JP      NC,DCNEXT
        INC     DE
DCNEXT:DEC     C
        JP      NZ,DCBIT
        INC     HL
        DEC     B
        JP      NZ,DCBYTE
        EX      DE,HL
        RET

; Count meaningful bits in the allocation vector.  Padding beyond DSM is
; ignored.  The returned totals include directory blocks, as BDOS does.
COUNTALV:
        LD      HL,(DPHBUF+14)
        LD      A,H
        OR      L
        JP      Z,ALVNONE
        LD      HL,(TOTBLK)
        EX      DE,HL
        LD      HL,(DPHBUF+14)
        LD      BC,0
        LD      A,80H
        LD      (BITMSK),A
ALVLOOP:
        LD      A,D
        OR      E
        JP      Z,ALVDONE
        LD      A,(BITMSK)
        LD      (BITTMP),A
        LD      A,(HL)
        PUSH    HL
        LD      HL,BITTMP
        AND     (HL)
        POP     HL
        JP      Z,ALVFREE
        INC     BC
ALVFREE:
        DEC     DE
        LD      A,(BITMSK)
        RRCA
        LD      (BITMSK),A
        CP      80H
        JP      NZ,ALVLOOP
        INC     HL
        JP      ALVLOOP
ALVDONE:
        PUSH    BC
        POP     HL
        LD      (USEDBLK),HL
        EX      DE,HL
        LD      HL,(TOTBLK)
        CALL    SUBDE
        LD      (FREEBLK),HL
        LD      A,1
        LD      (ALVOK),A
        RET
ALVNONE:
        XOR     A
        LD      (ALVOK),A
        RET

; Sixteen-bit subtraction written as two 8080 byte operations.  A direct
; SBC HL,DE was used in the first desk calculation, but that instruction is
; Z80-only and DISKINFO has no need to exclude an otherwise serviceable 8080.
; Entry: HL=minuend, DE=subtrahend.  Exit: HL=difference.
SUBDE:  LD      A,L
        SUB     E
        LD      L,A
        LD      A,H
        SBC     A,D
        LD      H,A
        RET

REPORT:LD      DE,TITLE
        CALL    PRINT
        LD      A,(NEWDRV)
        ADD     A,'A'
        CALL    PCHAR
        LD      DE,COLON
        CALL    PRINT

        LD      A,(MODE)
        OR      A
        JP      Z,RALL
        CP      1
        JP      Z,RDPH
        CP      2
        JP      Z,RDPB
        CP      3
        JP      Z,RGEO
        JP      RALLOC
RALL:   CALL    RDPH
        CALL    RDPB
        CALL    RGEO
        JP      RALLOC

RDPH:  LD      DE,HDPH
        CALL    PRINT
        LD      HL,(DPHPTR)
        CALL    PHEX16
        CALL    PCRLF
        LD      DE,HXLT
        CALL    PRINT
        LD      HL,(DPHBUF)
        CALL    PHEX16
        CALL    PNONE
        LD      DE,HDIRBUF
        CALL    PRINT
        LD      HL,(DPHBUF+8)
        CALL    PHEX16
        CALL    PCRLF
        LD      DE,HDPBP
        CALL    PRINT
        LD      HL,(DPHBUF+10)
        CALL    PHEX16
        CALL    PCRLF
        LD      DE,HCSV
        CALL    PRINT
        LD      HL,(DPHBUF+12)
        CALL    PHEX16
        CALL    PNONE
        LD      DE,HALV
        CALL    PRINT
        LD      HL,(DPHBUF+14)
        CALL    PHEX16
        CALL    PNONE
        RET

RDPB:  LD      DE,HDPB
        CALL    PRINT
        LD      DE,FSPT
        LD      HL,(DPBBUF)
        CALL    PWORD
        LD      DE,FBSH
        LD      A,(DPBBUF+2)
        CALL    PBYTE
        LD      DE,FBLM
        LD      A,(DPBBUF+3)
        CALL    PBYTE
        LD      DE,FEXM
        LD      A,(DPBBUF+4)
        CALL    PBYTE
        LD      DE,FDSM
        LD      HL,(DPBBUF+5)
        CALL    PWORD
        LD      DE,FDRM
        LD      HL,(DPBBUF+7)
        CALL    PWORD
        LD      DE,FAL0
        LD      A,(DPBBUF+9)
        CALL    PBYTE
        LD      DE,FAL1
        LD      A,(DPBBUF+10)
        CALL    PBYTE
        LD      DE,FCKS
        LD      HL,(DPBBUF+11)
        CALL    PWORD
        LD      DE,FOFF
        LD      HL,(DPBBUF+13)
        CALL    PWORD
        RET

RGEO:  LD      DE,HGEOM
        CALL    PRINT
        LD      DE,GBLKSZ
        LD      HL,(BLKKB)
        CALL    PDECVAL
        LD      DE,GTOT
        LD      HL,(TOTKB)
        CALL    PDECVAL
        LD      DE,GDIR
        LD      HL,(DIRKB)
        CALL    PDECVAL
        LD      DE,GDATA
        LD      HL,(DATBLK)
        CALL    PDECVAL
        LD      DE,GENTS
        LD      HL,(DIRENT)
        CALL    PDECVAL
        LD      DE,GEXT
        LD      HL,(EXTKB)
        CALL    PDECVAL
        LD      DE,GWIDTH
        CALL    PRINT
        LD      HL,(DPBBUF+5)
        LD      A,H
        OR      A
        LD      DE,W16
        JP      NZ,RGW
        LD      DE,W8
RGW:    CALL    PRINT
        RET

RALLOC:LD      DE,HALLOC
        CALL    PRINT
        LD      A,(ALVOK)
        OR      A
        JP      Z,RNOALV
        LD      DE,AUSED
        LD      HL,(USEDBLK)
        CALL    PDECVAL
        LD      DE,AFREE
        LD      HL,(FREEBLK)
        CALL    PDECVAL
        RET
RNOALV:LD      DE,ANOALV
        JP      PRINT

; Print labelled numeric fields.  Word fields are shown in hex and decimal;
; byte fields use two hex digits and an unsigned decimal value.
;
; dev1 - patch preserve the word while function 9 prints its label
;
;PWORD: CALL    PRINT           ; first cut trusted BDOS to preserve HL
PWORD:  PUSH    HL
        CALL    PRINT
        POP     HL
        PUSH    HL
        CALL    PHEX16
        LD      DE,HEXEQL
        CALL    PRINT
        POP     HL
        CALL    PDEC16
        JP      PNUMEND
PBYTE:  PUSH    AF
        CALL    PRINT
        POP     AF
        PUSH    AF
        CALL    PHEX8
        LD      DE,HEXEQL
        CALL    PRINT
        POP     AF
        LD      L,A
        LD      H,0
        CALL    PDEC16
        JP      PNUMEND
PDECVAL:
        PUSH    HL
        CALL    PRINT
        POP     HL
        CALL    PDEC16
        JP      PCRLF

; A null pointer is printed as NONE, otherwise merely terminate the line.
PNONE:  LD      A,H
        OR      L
        JP      NZ,PCRLF
        LD      DE,NONE
        JP      PRINT

PRINT:  LD      C,FPRINT
        JP      BDOS
PCHAR:  PUSH    BC
        PUSH    DE
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     DE
        POP     BC
        RET
PCRLF: LD      DE,CRLF
        JP      PRINT
PNUMEND:
        LD      DE,NUMEND
        JP      PRINT

PHEX16:PUSH    HL
        LD      A,H
        CALL    PHEX8
        POP     HL
        PUSH    HL
        LD      A,L
        CALL    PHEX8
        POP     HL
        RET
PHEX8:  PUSH    AF
        RRCA
        RRCA
        RRCA
        RRCA
        AND     0FH
        CALL    PHNIB
        POP     AF
        AND     0FH
        CALL    PHNIB
        RET
PHNIB: ADD     A,'0'
        CP      '9'+1
        JP      C,PCHAR
        ADD     A,7
        JP      PCHAR

; Decimal conversion by decimal places.  At most nine subtractions are made
; for each digit, which was found quicker on a small 4 MHz machine than the
; general divide routine used in an early notebook version.
PDEC16:XOR     A
        LD      (DIGSEEN),A
        LD      BC,10000
        CALL    PDIGIT
        LD      BC,1000
        CALL    PDIGIT
        LD      BC,100
        CALL    PDIGIT
        LD      BC,10
        CALL    PDIGIT
        LD      A,L
        ADD     A,'0'
        JP      PCHAR
PDIGIT:LD      D,'0'
PDLOOP:LD      A,L
        SUB     C
        LD      L,A
        LD      A,H
        SBC     A,B
        LD      H,A
        JP      C,PDDONE
        INC     D
        JP      PDLOOP
PDDONE:ADD     HL,BC
        LD      A,D
        CP      '0'
        JP      NZ,PDOUT
        LD      A,(DIGSEEN)
        OR      A
        RET     Z
        LD      A,D
PDOUT:  PUSH    HL
        CALL    PCHAR
        POP     HL
        LD      A,1
        LD      (DIGSEEN),A
        RET

SHOWHELP:
        LD      DE,HELPMSG
        CALL    PRINT
        JP      EXIT
SHOWINFO:
        LD      DE,INFOMSG
        CALL    PRINT
        JP      EXIT
SHOWVER:
        LD      DE,VERMSG
        CALL    PRINT
        JP      EXIT
BADDRV:LD      DE,BADMSG
        CALL    PRINT
        JP      EXIT
NODRIVE:
        LD      DE,NODMSG
        CALL    PRINT
EXIT:   LD      A,(OLDDRV)
        LD      E,A
        LD      C,FSELDSK
        CALL    BDOS
        JP      0000H

TITLE:  DB      13,10,'DISKINFO 0.1.0-dev4  Drive $'
COLON:  DB      ':',13,10,'$'
HDPH:   DB      13,10,'Disk Parameter Header',13,10
        DB      '  DPH address:              $'
HXLT:   DB      '  Translation table (XLT): $'
HDIRBUF:DB      '  Directory buffer:        $'
HDPBP:  DB      '  DPB pointer:             $'
HCSV:   DB      '  Check vector (CSV):      $'
HALV:   DB      '  Allocation vector (ALV): $'
HDPB:   DB      13,10,'Disk Parameter Block',13,10,'$'
FSPT:   DB      '  SPT:  $'
FBSH:   DB      '  BSH:    $'
FBLM:   DB      '  BLM:    $'
FEXM:   DB      '  EXM:    $'
FDSM:   DB      '  DSM:  $'
FDRM:   DB      '  DRM:  $'
FAL0:   DB      '  AL0:    $'
FAL1:   DB      '  AL1:    $'
FCKS:   DB      '  CKS:  $'
FOFF:   DB      '  OFF:  $'
HEXEQL: DB      'H  ($'
NUMEND: DB      ')',13,10,'$'
CRLF:   DB      13,10,'$'
NONE:   DB      '  NONE',13,10,'$'
HGEOM:  DB      13,10,'Derived Geometry',13,10,'$'
GBLKSZ: DB      '  Allocation block KiB:    $'
GTOT:   DB      '  Total capacity KiB:      $'
GDIR:   DB      '  Directory reserve KiB:  $'
GDATA:  DB      '  Usable data blocks:     $'
GENTS:  DB      '  Directory entries:      $'
GEXT:   DB      '  Capacity per entry KiB: $'
GWIDTH: DB      '  Allocation numbers:     $'
W8:     DB      '8-bit',13,10,'$'
W16:    DB      '16-bit',13,10,'$'
HALLOC: DB      13,10,'Current Allocation',13,10,'$'
AUSED:  DB      '  Allocated blocks:       $'
AFREE:  DB      '  Free blocks:            $'
ANOALV: DB      '  Allocation vector unavailable',13,10,'$'
HELPMSG:DB      13,10,'DISKINFO 0.1.0-dev4',13,10,13,10
        DB      '  DISKINFO [drive:]         Show the complete disk report',13,10
        DB      '  DISKINFO [drive:] /DPH    Show Disk Parameter Header',13,10
        DB      '  DISKINFO [drive:] /DPB    Show Disk Parameter Block',13,10
        DB      '  DISKINFO [drive:] /GEO    Show derived disk geometry',13,10
        DB      '  DISKINFO [drive:] /ALLOC  Show current allocation',13,10
        DB      '  DISKINFO /H               Command help (also /HELP)',13,10
        DB      '  DISKINFO /INFO            Show build information',13,10
        DB      '  DISKINFO /VER             Show version (also /VERSION)',13,10,'$'
INFOMSG:DB      13,10,'DISKINFO 0.1.0-dev4',13,10
        DB      'Read-only CP/M 2.2 disk parameter and allocation report.',13,10
        DB      'Built with ZSM4 and Digital Research LINK.',13,10
        DB      '8080-compatible code; source revision 31 August 2026.',13,10,'$'
VERMSG:DB      13,10,'DISKINFO 0.1.0-dev4',13,10,'$'
BADMSG: DB      13,10,'DISKINFO: unknown option. Use DISKINFO /HELP.',13,10,'$'
NODMSG: DB      13,10,'DISKINFO: selected drive is not available',13,10,'$'

SDPH:   DB      '/DPH',0
SDPB:   DB      '/DPB',0
SGEO:   DB      '/GEO',0
SALLOC: DB      '/ALLOC',0
SH:     DB      '/H',0
SHELP:  DB      '/HELP',0
SINFO:  DB      '/INFO',0
SVER:   DB      '/VER',0
SVERSION:DB    '/VERSION',0

OLDDRV: DB      0
NEWDRV: DB      0
MODE:   DB      0
DRVSET: DB      0
ARGBUF: DS      16
DPHPTR: DW      0
DPBPTR: DW      0
DPHBUF: DS      16
DPBBUF: DS      15
BLKKB:  DW      0
TOTBLK: DW      0
TOTKB:  DW      0
DIRBLK: DW      0
DIRKB:  DW      0
DATBLK: DW      0
DIRENT: DW      0
EXTPER: DW      0
EXTKB:  DW      0
USEDBLK:DW      0
FREEBLK:DW      0
ALVOK:  DB      0
BITMSK: DB      0
BITTMP: DB      0
DIGSEEN:DB      0
        DS      128
STACKTOP:
        END
