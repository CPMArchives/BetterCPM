; Independent public-state witness after repeated transient termination.
        ORG 100H
        LD DE,DM
        CALL PRINT
        LD C,25
        CALL 5
        CALL HEX
        LD DE,UM
        CALL PRINT
        LD E,0FFH
        LD C,32
        CALL 5
        CALL HEX
        LD DE,TM
        CALL PRINT
        LD HL,(6)
        PUSH HL
        LD A,H
        CALL HEX
        POP HL
        LD A,L
        CALL HEX
        LD DE,NL
        CALL PRINT
        RET
PRINT:  LD C,9
        JP 5
HEX:    PUSH AF
        RRCA
        RRCA
        RRCA
        RRCA
        CALL NIB
        POP AF
NIB:    AND 0FH
        ADD A,'0'
        CP '9'+1
        JR C,OUT
        ADD A,7
OUT:    LD E,A
        LD C,2
        JP 5
DM:     DB 'STATE D=','$'
UM:     DB ' U=','$'
TM:     DB ' TOP=','$'
NL:     DB 13,10,'$'
        END
