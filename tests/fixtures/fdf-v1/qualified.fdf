# Uniform default, mixed-sector SUPER, and cylinder-track qualification fixtures.
FDF_VERSION 1

FORMAT
ID CCS40DS
DESCRIPTION "CCS 40T DS DD 332K"
SPT 36
BSH 4
DSM 165
DRM 63
AL0 0x80
AL1 0
CKS 16
OFF 6
PSECTORS 18
SECSIZE 256
CYLINDERS 40
SIDES 2
ENCODING MFM
SECTOR_IDS 1,5,9,13,17,3,7,11,15,2,6,10,14,18,4,8,12,16
END

FORMAT
ID MMSUPER
DESCRIPTION "MM SUPER mixed-sector fixture"
SPT 44
BSH 4
DSM 103
DRM 63
AL0 0x80
AL1 0
CKS 16
OFF 2
PSECTORS 6
SECSIZE 1024
SECTOR_SIZES 1024,1024,1024,1024,1024,512
CYLINDERS 40
SIDES 1
ENCODING MFM
SECTOR_IDS 1,3,5,2,4,6
END

FORMAT
ID CYLTEST
DESCRIPTION "Cylinder-track fixture"
SPT 64
BSH 4
DSM 151
DRM 63
AL0 0x80
AL1 0
CKS 16
OFF 2
PSECTORS 8
SECSIZE 512
CYLINDERS 40
SIDES 2
ENCODING MFM
LOGICAL_TRACK CYLINDER
SECTOR_IDS 1,2,3,4,5,6,7,8
END
