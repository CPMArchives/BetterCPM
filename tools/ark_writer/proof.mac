; Isolated ARC stored-member writer CP/M qualification. Not a shipping utility.
 ORG 100H
 JP START
; @definitions@
START:
 LD HL,(6)
 LD DE,IMAGE_END
 OR A
 SBC HL,DE
 JP C,LOW_MEMORY
 LD (OLDSP),SP
 LD SP,STACK_TOP
 LD HL,CONTEXT
 LD DE,CONTEXT+1
 LD BC,AS_CONTEXT_SIZE-1
 LD (HL),0
 LDIR
 LD IX,CONTEXT
 LD (IX+AS_ABI),AS_ABI_VERSION
 LD (IX+AS_SIZE),AS_CONTEXT_SIZE
 LD HL,READ_CB
 LD (IX+AS_READ),L
 LD (IX+AS_READ+1),H
 LD HL,BUFFER
 LD (IX+AS_BUFFER),L
 LD (IX+AS_BUFFER+1),H
 LD HL,MEMBER
 LD (IX+AS_ENTRY),L
 LD (IX+AS_ENTRY+1),H
 LD HL,WRITE_CB
 LD (IX+AS_MEMBER+AM_WRITE_CB),L
 LD (IX+AS_MEMBER+AM_WRITE_CB+1),H
 LD HL,NAME
 LD DE,CONTEXT+AS_MEMBER+AM_NAME
 LD BC,11
 LDIR
 LD IX,CONTEXT
 LD A,10
 LD (IX+AS_MEMBER+AM_STORED),A
 LD (IX+AS_MEMBER+AM_LENGTH),A
 LD A,2
 LD (IX+AS_MEMBER+AM_STORED+1),A
 LD (IX+AS_MEMBER+AM_LENGTH+1),A
 LD A,(CRC_VALUE)
 LD (IX+AS_MEMBER+AM_CRC),A
 LD A,(CRC_VALUE+1)
 LD (IX+AS_MEMBER+AM_CRC+1),A
 LD A,2
 LD (IX+AS_MEMBER+AM_METHOD),A
 LD HL,OUTPUT
 LD DE,OUTPUT+1
 LD BC,639
 LD (HL),26
 LDIR
 LD A,1
 LD (FAIL_STAGE),A
 CALL ARK_WRITE_MEMBER
 JP C,FAIL
 LD A,2
 LD (FAIL_STAGE),A
 CALL ARK_WRITE_END
 JP C,FAIL
 LD A,3
 LD (FAIL_STAGE),A
 LD HL,OUT_FCB+12
 LD DE,OUT_FCB+13
 LD BC,23
 LD (HL),0
 LDIR
 LD DE,OUT_FCB
 LD C,22
 CALL 5
 CP 255
 JP Z,FAIL
 LD HL,OUTPUT
 LD (DMA_PTR),HL
 LD A,5
 LD (RECORDS_LEFT),A
WRITE_LOOP:
 LD DE,(DMA_PTR)
 LD C,26
 CALL 5
 LD DE,OUT_FCB
 LD A,4
 LD (FAIL_STAGE),A
 LD C,21
 CALL 5
 OR A
 JP NZ,FAIL
 LD HL,(DMA_PTR)
 LD DE,128
 ADD HL,DE
 LD (DMA_PTR),HL
 LD A,(RECORDS_LEFT)
 DEC A
 LD (RECORDS_LEFT),A
 JR NZ,WRITE_LOOP
 LD A,5
 LD (FAIL_STAGE),A
 LD DE,OUT_FCB
 LD C,16
 CALL 5
 CP 255
 JP Z,FAIL
 LD DE,PASS_TEXT
 LD C,9
 CALL 5
 JR RETURN
FAIL:
 LD (FAIL_STATUS),A
 LD DE,FAIL_TEXT
 LD C,9
 CALL 5
 LD A,(FAIL_STAGE)
 CALL HEX
 LD A,(FAIL_STATUS)
 CALL HEX
 LD DE,NL
 LD C,9
 CALL 5
RETURN:
 LD DE,80H
 LD C,26
 CALL 5
 LD SP,(OLDSP)
 RET
LOW_MEMORY:
 LD DE,LOW_TEXT
 LD C,9
 JP 5

; Read exactly AS_COUNT bytes from the deterministic in-image source.
READ_CB:
 PUSH IX
 PUSH IY
 PUSH BC
 PUSH DE
 PUSH HL
 LD HL,(READ_POS)
 LD DE,PAYLOAD
 ADD HL,DE
 LD E,(IX+AS_BUFFER)
 LD D,(IX+AS_BUFFER+1)
 LD C,(IX+AS_COUNT)
 LD B,(IX+AS_COUNT+1)
 PUSH BC
 LDIR
 POP BC
 LD (IX+AS_ACTUAL),C
 LD (IX+AS_ACTUAL+1),B
 LD HL,(READ_POS)
 ADD HL,BC
 LD (READ_POS),HL
 POP HL
 POP DE
 POP BC
 POP IY
 POP IX
 OR A
 RET

; Append the callback byte range at the writer-supplied output offset.
WRITE_CB:
 PUSH IX
 PUSH IY
 PUSH BC
 PUSH DE
 PUSH HL
 LD L,(IX+AS_MEMBER+AM_OUTPUT_OFFSET)
 LD H,(IX+AS_MEMBER+AM_OUTPUT_OFFSET+1)
 LD DE,OUTPUT
 ADD HL,DE
 EX DE,HL
 LD L,(IX+AS_BUFFER)
 LD H,(IX+AS_BUFFER+1)
 LD C,(IX+AS_COUNT)
 LD B,(IX+AS_COUNT+1)
 PUSH BC
 LDIR
 POP BC
 LD (IX+AS_ACTUAL),C
 LD (IX+AS_ACTUAL+1),B
 POP HL
 POP DE
 POP BC
 POP IY
 POP IX
 OR A
 RET

HEX:
 PUSH AF
 RRCA
 RRCA
 RRCA
 RRCA
 CALL NIBBLE
 POP AF
NIBBLE:
 AND 15
 ADD A,'0'
 CP '9'+1
 JR C,DIGIT
 ADD A,7
DIGIT:
 LD E,A
 LD C,2
 JP 5

; @code@
PASS_TEXT: DB 'ARK WRITER PASS',13,10,'$'
FAIL_TEXT: DB 'ARK WRITER FAIL ','$'
LOW_TEXT: DB 'ARK WRITER LOW MEMORY',13,10,'$'
NL: DB 13,10,'$'
NAME: DB 'STREAM  BIN'
OUT_FCB: DB 0,'OUT     ','ARC'
 DS 24
CRC_VALUE: DW @CRC@
FAIL_STAGE: DB 0
FAIL_STATUS: DB 0
RECORDS_LEFT: DB 0
READ_POS: DW 0
DMA_PTR: DW 0
OLDSP: DW 0
CONTEXT: DS AS_CONTEXT_SIZE
MEMBER: DS 32
BUFFER: DS 128
PAYLOAD:
@PAYLOAD@
OUTPUT: DS 640
STACK: DS 512
STACK_TOP:
IMAGE_END:
 END
