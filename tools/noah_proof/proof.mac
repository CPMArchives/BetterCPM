; Development-only feasibility executable. No NOAH command integration.
; The generator supplies layout, matching header, entries and binary fixture.
 ORG 100H
 JP START
 INCLUDE archive.inc
 INCLUDE codec.inc
 INCLUDE uncr.inc
 INCLUDE proof.inc
 INCLUDE layout.inc
START:
 ; Do not touch private stack/workspace until the complete range fits.
 LD HL,(6)
 LD DE,PROOF_END
 OR A
 SBC HL,DE
 JP C,LOW
 LD (OLDSP),SP
 LD SP,STACK_TOP
 LD HL,STACK_LOW
 LD DE,STACK_LOW+1
 LD BC,STACK_TOP-STACK_LOW-1
 LD (HL),0A5H
 LDIR
 LD C,25
 CALL BDOS
 INC A
 LD (FCB),A
 LD E,255
 LD C,32
 CALL BDOS
 LD (USER),A
 ; First exact invocation DU, then A0 only when open reports absent.
 CALL OPEN
 CP 255
 JR NZ,OPENED
 LD E,0
 LD C,32
 CALL BDOS
 LD A,1
 LD (FCB),A
 CALL OPEN
 CP 255
 JP Z,BAD
OPENED:
 LD HL,OVERLAY
 LD (DEST),HL
 LD A,OVL_RECORDS
 LD (LEFT),A
LOAD:
 LD DE,(DEST)
 LD C,26
 CALL BDOS
 LD DE,FCB
 LD C,20
 CALL BDOS
 OR A
 JP NZ,LOAD_BAD
 LD HL,(DEST)
 LD DE,128
 ADD HL,DE
 LD (DEST),HL
 LD HL,LEFT
 DEC (HL)
 JR NZ,LOAD
 ; Require EOF at the exact recorded physical size, using resident DMA.
 LD DE,DMA
 LD C,26
 CALL BDOS
 LD DE,FCB
 LD C,20
 CALL BDOS
 CP 1
 JP NZ,LOAD_BAD
 CALL CLOSE
 OR A
 JP NZ,BAD
 LD HL,OVERLAY
 LD DE,EXPECTED_HEADER
 LD B,NP_CRC
HEADER_CHECK:
 LD A,(DE)
 CP (HL)
 JP NZ,BAD
 INC HL
 INC DE
 DJNZ HEADER_CHECK
 ; Save CRC then zero its field for checksum coverage.
 LD DE,SAVED_CRC
 LD BC,4
 LDIR
 LD HL,OVERLAY+NP_CRC
 LD B,4
CRC_ZERO:
 LD (HL),0
 INC HL
 DJNZ CRC_ZERO
 LD HL,CRC_STATE
 LD B,4
CRC_INIT:
 LD (HL),255
 INC HL
 DJNZ CRC_INIT
 LD HL,OVERLAY
 LD BC,OVL_BYTES
CRC_BYTE:
 LD A,(CRC_STATE)
 XOR (HL)
 LD (CRC_STATE),A
 PUSH BC
 PUSH HL
 LD B,8
CRC_BIT:
 LD HL,CRC_STATE+3
 SRL (HL)
 DEC HL
 RR (HL)
 DEC HL
 RR (HL)
 DEC HL
 RR (HL)
 JR NC,CRC_NEXT
 LD A,(HL)
 XOR 20H
 LD (HL),A
 INC HL
 LD A,(HL)
 XOR 83H
 LD (HL),A
 INC HL
 LD A,(HL)
 XOR 0B8H
 LD (HL),A
 INC HL
 LD A,(HL)
 XOR 0EDH
 LD (HL),A
CRC_NEXT:
 DJNZ CRC_BIT
 POP HL
 POP BC
 INC HL
 DEC BC
 LD A,B
 OR C
 JR NZ,CRC_BYTE
 LD HL,CRC_STATE
 LD DE,SAVED_CRC
 LD B,4
CRC_COMPARE:
 LD A,(HL)
 CPL
 EX DE,HL
 CP (HL)
 EX DE,HL
 JP NZ,BAD
 INC HL
 INC DE
 DJNZ CRC_COMPARE
 ; Guard contexts; initialize only public configuration prefixes.
 LD HL,ARCHIVE_CONTEXT-1
 LD DE,ARCHIVE_CONTEXT
 LD BC,PROOF_END-ARCHIVE_CONTEXT
 LD (HL),0A5H
 LDIR
 LD HL,ARCHIVE_CONTEXT
 LD DE,ARCHIVE_CONTEXT+1
 LD BC,AS_CONTEXT_SIZE-1
 LD (HL),0
 LDIR
 LD IX,ARCHIVE_CONTEXT
 LD (IX+AS_ABI),AS_ABI_VERSION
 LD (IX+AS_SIZE),AS_CONTEXT_SIZE
 LD HL,READ_ARCHIVE
 LD (IX+AS_READ),L
 LD (IX+AS_READ+1),H
 LD HL,FIXTURE_BYTES
 LD (IX+AS_FILE_SIZE),L
 LD (IX+AS_FILE_SIZE+1),H
 CALL HANDLER_OPEN
 JP C,BAD
 CALL HANDLER_NEXT
 JP C,BAD
 ; Zero capacity performs no callback even with wrapping destination.
 LD BC,0
 LD DE,0FFFFH
 CALL HANDLER_READ
 JP C,BAD
 LD HL,CODEC_CONTEXT
 LD DE,CODEC_CONTEXT+1
 LD BC,CX_PREFIX_SIZE-1
 LD (HL),0
 LDIR
 LD IX,CODEC_CONTEXT
 LD (IX+CX_ABI),CX_ABI_VERSION
 LD HL,UCN_CONTEXT_SIZE
 LD (IX+CX_SIZE),L
 LD (IX+CX_SIZE+1),H
 LD HL,READ_MEMBER
 LD (IX+CX_READ),L
 LD (IX+CX_READ+1),H
 LD HL,WRITE_BYTE
 LD (IX+CX_WRITE),L
 LD (IX+CX_WRITE+1),H
 LD HL,0
 LD (COUNT),HL
 CALL CODEC_INIT
 JP C,BAD
 CALL CODEC_HEAD
 JP C,BAD
 CALL CODEC_RUN
 JP C,BAD
 LD HL,(COUNT)
 LD DE,DECODED_BYTES
 OR A
 SBC HL,DE
 JP NZ,BAD
 LD A,(ARCHIVE_CONTEXT-1)
 CP 0A5H
 JP NZ,BAD
 LD A,(CODEC_CONTEXT-1)
 CP 0A5H
 JP NZ,BAD
 LD A,(PROOF_END-1)
 CP 0A5H
 JP NZ,BAD
 ; Bottom 64 bytes of the 512-byte stack reservation must be untouched.
 LD HL,STACK_LOW
 LD B,64
STACK_CHECK:
 LD A,(HL)
 CP 0A5H
 JP NZ,BAD
 INC HL
 DJNZ STACK_CHECK
 LD DE,PASS_MSG
 JR REPORT
LOAD_BAD:
 CALL CLOSE
BAD:
 LD DE,BAD_MSG
REPORT:
 PUSH DE
 LD A,(USER)
 LD E,A
 LD C,32
 CALL BDOS
 LD DE,80H
 LD C,26
 CALL BDOS
 CALL MEASURE
 POP DE
 LD C,9
 CALL BDOS
 LD SP,(OLDSP)
 RET
LOW:
 CALL MEASURE
 LD DE,LOW_MSG
 LD C,9
 JP 5
OPEN:
 LD HL,FCB+12
 LD DE,FCB+13
 LD BC,23
 LD (HL),0
 LDIR
 LD DE,FCB
 LD C,15
 JP BDOS
MEASURE:
 LD DE,TPA_MSG
 LD C,9
 CALL BDOS
 LD HL,(6)
 CALL HEX_WORD
 LD DE,NEED_MSG
 LD C,9
 CALL BDOS
 LD HL,PROOF_END
 CALL HEX_WORD
 LD DE,NEWLINE
 LD C,9
 JP BDOS
HEX_WORD:
 LD A,H
 CALL HEX_BYTE
 LD A,L
HEX_BYTE:
 PUSH AF
 RRCA
 RRCA
 RRCA
 RRCA
 CALL HEX_DIGIT
 POP AF
HEX_DIGIT:
 AND 15
 ADD A,'0'
 CP '9'+1
 JR C,HEX_OUT
 ADD A,7
HEX_OUT:
 LD E,A
 LD C,2
 JP BDOS
CLOSE:
 LD DE,FCB
 LD C,16
 CALL BDOS
 CP 255
 RET Z
 XOR A
 RET
BDOS:
 PUSH BC
 PUSH DE
 PUSH HL
 PUSH IX
 PUSH IY
 CALL 5
 POP IY
 POP IX
 POP HL
 POP DE
 POP BC
 RET
READ_ARCHIVE:
 ; Alternate memory byte source, checked 32-bit offset and short reads.
 LD A,(IX+AS_OFFSET+2)
 OR (IX+AS_OFFSET+3)
 JR NZ,READ_ERROR
 LD L,(IX+AS_OFFSET)
 LD H,(IX+AS_OFFSET+1)
 LD C,(IX+AS_COUNT)
 LD B,(IX+AS_COUNT+1)
 PUSH HL
 ADD HL,BC
 JR C,READ_RANGE_POP
 LD DE,FIXTURE_BYTES
 OR A
 SBC HL,DE
 JR C,READ_RANGE_OK
 JR NZ,READ_RANGE_POP
READ_RANGE_OK:
 POP HL
 LD DE,FIXTURE
 ADD HL,DE
 LD E,(IX+AS_BUFFER)
 LD D,(IX+AS_BUFFER+1)
 LD (IX+AS_ACTUAL),C
 LD (IX+AS_ACTUAL+1),B
 LDIR
 ; Deliberately clobber ordinary callback registers.
 LD BC,0DEADH
 LD DE,0BEEFH
 LD HL,01234H
 OR A
 RET
READ_RANGE_POP:
 POP HL
READ_ERROR:
 LD A,AS_RANGE
 SCF
 RET
READ_MEMBER:
 PUSH IX
 LD IX,ARCHIVE_CONTEXT
 LD BC,1
 LD DE,ONE_BYTE
 CALL HANDLER_READ
 POP IX
 JR C,MEMBER_END
 LD A,(ONE_BYTE)
 OR A
 RET
MEMBER_END:
 CP AS_END
 JR NZ,MEMBER_ERROR
 XOR A
 SCF
 RET
MEMBER_ERROR:
 LD A,1
 SCF
 RET
WRITE_BYTE:
 LD HL,(COUNT)
 CP L
 JR NZ,MEMBER_ERROR
 INC HL
 LD (COUNT),HL
 OR A
 RET
OLDSP: DW 0
USER: DB 0
DEST: DW 0
LEFT: DB 0
COUNT: DW 0
ONE_BYTE: DB 0
CRC_STATE: DS 4
SAVED_CRC: DS 4
FCB: DB 0,'NOAH    OVL'
 DS 24
DMA: DS 128
PASS_MSG: DB 'NOAH PROOF PASS',13,10,'$'
BAD_MSG: DB 'NOAH PROOF INVALID',13,10,'$'
LOW_MSG: DB 'NOAH PROOF LOW TPA',13,10,'$'
TPA_MSG: DB 'NOAH PROOF TPA ', '$'
NEED_MSG: DB ' NEED ', '$'
NEWLINE: DB 13,10,'$'
 INCLUDE generated.inc
STACK_LOW: DS 512
STACK_TOP:
PROOF_CODE_END:
 ; Reserve the *entire* current NOAH image in addition to this proof's code,
 ; fixture, DMA and stack. Includes 512x13 selection and publication state.
 DS BASELINE_BYTES
RESIDENT_END:
 END
