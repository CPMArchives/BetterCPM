; Qualification-only COM: remove STATEFUL's cache, prove a failed set change
; preserves the live service, then restore the original file. Never distributed.
        INCLUDE layout.inc
        ASEG
        ORG 0100H
START:  LD (OLDSP),SP
        LD SP,07800H
        CALL RESETFCB
        LD HL,(LY_SYS+084H)
        LD (HEAD),HL
        LD A,(LY_RSTA)
        LD B,A
        LD IX,LY_RSTA+1
FIND:   PUSH BC
        PUSH HL
        PUSH IX
        POP HL
        LD DE,STEM
        LD B,8
MATCH:  LD A,(DE)
        CP (HL)
        JP NZ,NEXT
        INC DE
        INC HL
        DJNZ MATCH
        LD A,'A'
        LD (STEP),A
        POP HL
        POP BC
        PUSH HL
        LD DE,6
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        POP HL
        ADD HL,DE
        DEC HL
        DEC HL
        LD A,(HL)
        ADD A,'0'
        LD (FCB+7),A
        LD C,15
        CALL DISK
        CP 4
        JP NC,FAIL
        LD A,'1'
        LD (STEP),A
        LD HL,DATA
        LD (PTR),HL
        XOR A
        LD (COUNT),A
READ:   LD DE,(PTR)
        LD C,26
        CALL 5
        LD C,20
        CALL DISK
        CP 1
        JR Z,READEOF
        OR A
        JP NZ,FAIL
        LD HL,(PTR)
        LD DE,128
        ADD HL,DE
        LD (PTR),HL
        LD HL,COUNT
        INC (HL)
        LD A,(HL)
        CP 16
        JR C,READ
        JP FAIL
READEOF:
        LD C,16
        CALL DISK
        CP 4
        JP NC,FAIL
        LD A,'2'
        LD (STEP),A
        LD C,19
        CALL DISK
        CP 255
        JP Z,FAIL
        LD A,'3'
        LD (STEP),A
        LD DE,REQUEST
        LD C,177
        CALL 5
        CP 255
        JP NZ,RESTFAIL
        LD A,'4'
        LD (STEP),A
        LD HL,(LY_SYS+084H)
        LD DE,(HEAD)
        OR A
        SBC HL,DE
        JP NZ,RESTFAIL
        LD A,'5'
        LD (STEP),A
        LD DE,LOOKUP
        LD C,182
        CALL 5
        OR A
        JP NZ,RESTFAIL
        LD A,'6'
        LD (STEP),A
        LD HL,(LOOKUP+12)
        LD DE,STATREQ
        LD BC,SRETURN
        PUSH BC
        JP (HL)
SRETURN:
        CP 0A4H
        JP NZ,RESTFAIL
        XOR A
        LD (RESULT),A
        JR RESTORE
RESTFAIL:
        LD A,1
        LD (RESULT),A
RESTORE:
        CALL RESETFCB
        LD C,22
        CALL DISK
        CP 4
        JP NC,FAIL
        LD HL,DATA
        LD (PTR),HL
WRITE:  LD DE,(PTR)
        LD C,26
        CALL 5
        LD C,21
        CALL DISK
        OR A
        JP NZ,FAIL
        LD HL,(PTR)
        LD DE,128
        ADD HL,DE
        LD (PTR),HL
        LD HL,COUNT
        DEC (HL)
        JR NZ,WRITE
        LD C,16
        CALL DISK
        CP 4
        JP NC,FAIL
        LD A,(RESULT)
        OR A
        JP NZ,FAIL
        LD DE,PASSMSG
        JR PRINT
NEXT:   POP HL
        POP BC
        LD E,(HL)
        INC HL
        LD D,(HL)
        EX DE,HL
        LD DE,8
        OR A
        SBC HL,DE
        PUSH BC
        LD BC,8
        ADD IX,BC
        POP BC
        DEC B
        JP NZ,FIND
FAIL:   LD DE,FAILMSG
PRINT:  LD C,9
        CALL 5
        LD DE,0080H
        LD C,26
        CALL 5
        LD SP,(OLDSP)
        RET
RESETFCB:
        LD HL,FCB+12
        LD DE,FCB+13
        LD BC,23
        LD (HL),0
        LDIR
        RET
DISK:   LD DE,FCB
        JP 5
OLDSP: DW 0
HEAD: DW 0
PTR: DW 0
COUNT: DB 0
RESULT: DB 1
STEM: DB 'STATEFUL'
FCB: DB 1,'$$RSX00 RSC'
        DS 24
LOOKUP: DB 1,20,0,0,'STAT',1,0
        DW 0,0
        DB 0,0
        DW 0
        DB 0,0
STATREQ: DB 1,16,2,0
        DS 12
PASSMSG: DB 'CACHE ERROR CHAIN PASS',13,10,'$'
FAILMSG: DB 'CACHE ERROR CHAIN FAILED stage '
STEP: DB '0',13,10,'$'
REQUEST: DB 2,2,0,0,'HELLO   ',0,0
        DW WORK,07000H
DATA:   DS 2048
WORK:
        END
