; Isolated development proof, never a shipping utility or NOAH command.
 ORG 100H
 JP START
; @definitions@
START:
 LD HL,(6)
 LD DE,IMAGE_END
 OR A
 SBC HL,DE
 JP C,LOW_MEMORY
 LD (OLDSP),SP
 LD SP,STACK_TOP
 PUSH IX
 PUSH IY
 LD HL,CONTEXT
 LD DE,CONTEXT+1
 LD BC,AS_CONTEXT_SIZE+AP_SIZE-1
 LD (HL),0
 LDIR
 LD HL,5CH
 LD DE,FCB
 LD BC,12
 LDIR
 LD IX,CONTEXT
 LD (IX+AS_ABI),1
 LD (IX+AS_SIZE),AS_CONTEXT_SIZE
 LD HL,FCB
 LD (IX+AS_USER),L
 LD (IX+AS_USER+1),H
 LD HL,0
 LD (VERIFIED),HL
 LD (OPAQUE),HL
 LD DE,TPA_TEXT
 CALL PRINT
 LD HL,(6)
 CALL WORD_HEX
 LD DE,NEED_TEXT
 CALL PRINT
 LD HL,IMAGE_END
 CALL WORD_HEX
 LD DE,NL
 CALL PRINT
 CALL AC_OPEN
 JR C,FAILED
NEXT:
 CALL ARK_NEXT
 JR C,ENDED
 LD A,(IX+AS_MEMBER+AM_METHOD)
 CP 3
 JR NC,OPAQUE_MEMBER
 CALL ARK_TEST_STORED
 JR C,FAILED
 LD HL,(VERIFIED)
 INC HL
 LD (VERIFIED),HL
 JR NEXT
OPAQUE_MEMBER:
 LD HL,(OPAQUE)
 INC HL
 LD (OPAQUE),HL
 JR NEXT
ENDED:
 CP AS_END
 JR NZ,FAILED
 CALL AC_CLOSE
 JR C,FAILED
 LD DE,PASS_TEXT
 CALL PRINT
 LD HL,(VERIFIED)
 CALL WORD_HEX
 LD DE,OPAQUE_TEXT
 CALL PRINT
 LD HL,(OPAQUE)
 CALL WORD_HEX
 LD DE,TRAILER_TEXT
 CALL PRINT
 LD A,(CONTEXT+AS_UNUSED_SEEN)
 CALL HEX
 LD DE,NL
 CALL PRINT
 JR RETURN
FAILED:
 PUSH AF
 CALL AC_CLOSE
 POP AF
 PUSH AF
 LD DE,FAIL_TEXT
 CALL PRINT
 POP AF
 CALL HEX
 LD DE,NL
 CALL PRINT
RETURN:
 LD A,(GUARD_LOW)
 CP 0A5H
 JR NZ,STACK_ERROR
 LD A,(STACK_TOP)
 CP 0A5H
 JR Z,RESTORE
STACK_ERROR:
 LD DE,STACK_TEXT
 CALL PRINT
RESTORE:
 LD DE,80H
 LD C,26
 CALL AC_BDOS
 POP IY
 POP IX
 LD SP,(OLDSP)
 RET
LOW_MEMORY:
 LD DE,LOW_TEXT
 LD C,9
 JP 5
PRINT:
 LD C,9
 JP AC_BDOS
WORD_HEX:
 LD A,H
 CALL HEX
 LD A,L
 JP HEX
HEX:
 PUSH AF
 RRCA
 RRCA
 RRCA
 RRCA
 CALL NIBBLE
 POP AF
NIBBLE:
 AND 15
 ADD A,'0'
 CP '9'+1
 JR C,DIGIT
 ADD A,7
DIGIT:
 LD E,A
 LD C,2
 JP AC_BDOS
; @code@
TPA_TEXT: DB 'ARK READER TPA ','$'
NEED_TEXT: DB ' NEED ','$'
PASS_TEXT: DB 'ARK READER PASS V=','$'
OPAQUE_TEXT: DB ' O=','$'
TRAILER_TEXT: DB ' T=','$'
FAIL_TEXT: DB 'ARK READER FAIL ','$'
LOW_TEXT: DB 'ARK READER LOW TPA',13,10,'$'
STACK_TEXT: DB 'ARK READER STACK ERROR',13,10,'$'
NL: DB 13,10,'$'
OLDSP: DW 0
VERIFIED: DW 0
OPAQUE: DW 0
CONTEXT: DS AS_CONTEXT_SIZE
FCB: DS AP_SIZE
GUARD_LOW: DB 0A5H
STACK_LOW: DS 512
STACK_TOP: DB 0A5H
IMAGE_END:
 END
