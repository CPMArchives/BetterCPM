 	if ((addr >= segsize) && (wp_common != 0)) {
 		wp_common |= 0x80;
+#ifdef BETTERCPM_ROM_QUALIFY
+		if (rom_qualification)
+			rom_qualification_write(addr, data, "CPU");
+#endif
 #ifndef EXCLUDE_Z80
 		if (wp_common & 0x40)
 			int_nmi = true;
@@ -125,6 +135,10 @@ static inline void dma_write(WORD addr, BYTE data)
 {
 	if ((addr >= segsize) && (wp_common != 0)) {
 		wp_common |= 0x80;
+#ifdef BETTERCPM_ROM_QUALIFY
+		if (rom_qualification)
+			rom_qualification_write(addr, data, "DMA");
+#endif
 		return;
 	}
 
